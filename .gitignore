# O35（2026-09-30 全面审查 P3）：`.coverage` 只匹配精确名——pytest-cov 并行
# 模式（-n auto / COVERAGE_FILE 带后缀）产出的 .coverage.<host>.<pid> 与
# coverage html 单文件报告此前均不在忽略名单，可被误提交。
.coverage
.coverage.*
coverage.xml
coverage.json
coverage.html
htmlcov/

# LLM 文件缓存（本地优化产物，避免重复提交）
src/cache/

# 失败诊断追踪快照（--dump-trace-on-failure 运行时产物，不提交）。
# O35：*.trace.jsonl / *_failed_trace.jsonl 通配覆盖自定义
# AITESTER_TRACE_DIR=<repo 内目录> 的落盘产物（此前只有 tmp_trace/ 整目录
# 被忽略，改了 trace 目录名就可能把含代码/输出的追踪文件提交上去）。
tmp_trace/
*.trace.jsonl
*_failed_trace.jsonl

# O35：本地敏感配置备份（*.bak / *.template.bak 通配，防 .env.local 含
# 真实 API Key 的改名副本被 git add -A 收进版本库）
.env.local.bak
.env.local.template.bak

# RAG 持久化检索库（实验数据，本地生成，不提交）
rag_data/

# pytest 专用 TMPDIR 沙箱（WorkBuddy shim 对已存在目录 mkdir 转 PermissionError，
# 用 TMPDIR=$(mktemp -d) 兜底产物目录，纯本地可再生，不提交）
.pytest_tmp/
# basetemp 变体目录（--basetemp=<新目录名> 每次全量回归的沙箱规避产物；
# 精确模式 .pytest_tmp/ 不覆盖带后缀变体，2026-10-12 补）
.pytest_tmp*/
# 全量回归日志与 TMPDIR 实验目录（本地一次性产物）
.pytest_full_*.log
.tmp_run/
# basetemp 的另一种写法：`.tmp_pytest/`（CX 轮 2026-10-26 实测被误提交 12 个
# pytest 临时文件——含 .lock 与 pytest-current 符号链接，随 v1.0.0 一同发布）。
# `.pytest_tmp*/` 的模式不覆盖它，故必须单独登记。
.tmp_pytest/

# WorkBuddy 沙箱工具的工作记忆目录（第三方工具运行时产物，非项目内容，
# 历史上曾误入库 2026-10-08 一份；目录整体不入库，避免再次污染 git status）
.workbuddy/

