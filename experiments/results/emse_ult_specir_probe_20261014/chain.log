ration2 -> 'during'.\"\"\"\n        # is1 >= is2 and ie1 <= ie2\n        assert get_allen_relation((3, 5), (1, 10)) == 'during'\n\n    def test_get_allen_relation_contains(self):\n        \"\"\"duration1 fully contains duration2 -> 'contains'.\"\"\"\n        # is1 <= is2 and ie1 >= ie2\n        assert get_allen_relation((1, 10), (3, 5)) == 'contains'\n\n    def test_get_allen_relation_starts(self):\n        \"\"\"Same start, duration1 ends earlier -> 'starts'.\"\"\"\n        # is1 == is2 and ie1 < ie2\n        assert get_allen_relation((1, 5), (1, 10)) == 'starts'\n\n    def test_get_allen_relation_started_by(self):\n        \"\"\"Same start, duration1 ends later -> 'started_by'.\"\"\"\n        # is1 == is2 and ie1 > ie2\n        assert get_allen_relation((1, 10), (1, 5)) == 'started_by'\n\n    def test_get_allen_relation_finishes(self):\n        \"\"\"Same end, duration1 starts later -> 'finishes'.\"\"\"\n        # ie1 == ie2 and is2 < is1\n        assert get_allen_relation((5, 10), (1, 10)) == 'finishes'\n\n    def test_get_allen_relation_finished_by(self):\n        \"\"\"Same end, duration1 starts earlier -> 'finished_by'.\"\"\"\n        # ie1 == ie2 and is2 > is1\n        assert get_allen_relation((1, 10), (5, 10)) == 'finished_by'\n\n    def test_get_allen_relation_returns_string(self):\n        \"\"\"Return value is always a string for valid interval inputs.\"\"\"\n        result = get_allen_relation((1, 5), (1, 5))\n        assert isinstance(result, str)\n\n    def test_get_allen_relation_unpacking_error_on_invalid_input(self):\n        \"\"\"Passing a non-iterable raises TypeError during unpacking.\"\"\"\n        with pytest.raises(TypeError):\n            get_allen_relation(1, (1, 5))\n\n    def test_get_allen_relation_unpacking_error_on_wrong_length(self):\n        \"\"\"Passing a tuple of wrong length raises ValueError during unpacking.\"\"\"\n        with pytest.raises(ValueError):\n            get_allen_relation((1, 2, 3), (1, 5))",
