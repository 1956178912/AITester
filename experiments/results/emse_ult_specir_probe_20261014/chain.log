          "patch": "python\ndef point_box_relation(u, vbox):\n    uy, ux = u\n    vy0, vx0, vy1, vx1 = vbox\n\n    # 退化矩形：零面积，仅当点与矩形点重合时视为 inside\n    if vx0 == vx1 and vy0 == vy1:\n        if ux == vx0 and uy == vy0:\n            return 4  # 'inside'\n        # 否则按相对位置判断\n        if ux < vx0 and uy < vy0:\n            return 0  # 'left-above'\n        if ux > vx1 and uy < vy0:\n            return 8  # 'right-above'\n        if ux > vx1 and uy > vy1:\n            return 9  # 'right-below'\n        if ux < vx0 and uy > vy1:\n            return 1  # 'left-below'\n        if ux < vx0 and vy0 <= uy <= vy1:\n            return 2  # 'left-of'\n        if ux > vx1 and vy0 <= uy <= vy1:\n            return 7  # 'right-of'\n        if uy < vy0 and vx0 <= ux <= vx1:\n            return 3  # 'above'\n        if uy > vy1 and vx0 <= ux <= vx1:\n            return 6  # 'below'\n        return None\n\n    # 内部\n    if vx0 < ux < vx1 and vy0 < uy < vy1:\n        return 4  # 'inside'\n\n    # 四条边（含端点）\n    if ux == vx0 and vy0 <= uy <= vy1:\n        return 2  # 'left-of'\n    if ux == vx1 and vy0 <= uy <= vy1:\n        return 7  # 'right-of'\n    if uy == vy0 and vx0 <= ux <= vx1:\n        return 3  # 'above'\n    if uy == vy1 and vx0 <= ux <= vx1:\n        return 6  # 'below'\n\n    # 四个角\n    if ux == vx0 and uy == vy0:\n        return 0  # 'left-above'\n    if ux == vx1 and uy == vy0:\n        return 8  # 'right-above'\n    if ux == vx1 and uy == vy1:\n        return 9  # 'right-below'\n    if ux == vx0 and uy == vy1:\n        return 1  # 'left-below'\n\n    # 外部区域\n    if ux < vx0 and uy < vy0:\n        return 0  # 'left-above'\n    if ux > vx1 and uy < vy0:\n        return 8  # 'right-above'\n    if ux > vx1 and uy > vy1:\n        return 9  # 'right-below'\n    if ux < vx0 and uy > vy1:\n        return 1  # 'left-below'\n    if ux < vx0 and vy0 <= uy <= vy1:\n        return 2  # 'left-of'\n    if ux > vx1 and vy0 <= uy <= vy1:\n        return 7  # 'right-of'\n    if uy < vy0 and vx0 <= ux <= vx1:\n        return 3  # 'above'\n    if uy > vy1 and vx0 <= ux <= vx1:\n        return 6  # 'below'\n\n    # 对角空隙（gap）\n    return None\n",
