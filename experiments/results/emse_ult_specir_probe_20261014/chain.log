          "rag_stats": null,
          "patch": "python\ndef windows_k_distinct(x, k):\n    dist, i, j = 0, 0, 0                # dist = |{x[i], ..., x[j-1]}|\n    occ = {xi: 0 for xi in x}           # number of occurrences in x[i:j]\n    while j < len(x):\n        while dist == k and i < j:      # move start of interval\n            occ[x[i]] -= 1              # update counters\n            if occ[x[i]] == 0:\n                dist -= 1\n            i += 1\n        while j < len(x) and (dist < k or occ[x[j]]):\n            if occ[x[j]] == 0:          # update counters\n                dist += 1\n            occ[x[j]] += 1\n            j += 1                      # move end of interval\n        if dist == k and i < j:\n            yield (i, j)                # one interval found\n",
          "generated_test": "import pytest\n\nfrom windows_k_distinct import windows_k_distinct\n\n\ndef _collect(x, k):\n    \"\"\"辅助函数：将生成器结果收集为列表。\"\"\"\n    return list(windows_k_distinct(x, k))\n\n\ndef _distinct_count(seq):\n    \"\"\"辅助函数：计算序列中不同元素个数。\"\"\"\n    return len(set(seq))\n\n\n# ---------------------------------------------------------------------------\n# 正常用例\n# ---------------------------------------------------------------------------\n\ndef test_windows_k_distinct_normal_k1_all_same():\n    \"\"\"k=1 且所有元素相同，应产出覆盖整个序列的单个区间 [0,3)。\n\n    期望值来源：规约边界情况 \"k == 1：产出所有由相同元素构成的极大连续区间\"。\n    \"\"\"\n    result = _collect([1, 1, 1], 1)\n    assert result == [(0, 3)]\n\n\ndef test_windows_k_distinct_normal_k2_mixed_postconditions():\n    \"\"\"k=2 的混合序列：期望值未在规约中给出具体区间列表，\n    仅断言后置条件与不变量（探索性，需人工确认具体区间）。\n\n    期望值来源不明，需人工确认。\n    \"\"\"\n    x = [1, 2, 1, 3]\n    k = 2\n    result = _collect(x, k)\n\n    # 后置条件：每个产出 (i, j) 满足 0 <= i < j <= len(x)\n    for i, j in result:\n        assert 0 <= i\n        assert i < j\n        assert j <= len(x)\n\n    # 后置条件：每个窗口内不同元素个数恰好等于 k\n    for i, j in result:\n        assert _distinct_count(x[i:j]) == k\n\n\ndef test_windows_k_distinct_normal_k_equals_distinct():\n    \"\"\"k 等于序列不同元素总数，应产出整个序列 [0,3)。\n\n    期望值来源：规约后置条件与边界情况（k 等于不同元素总数时窗口可覆盖全序列）。\n    \"\"\"\n    result = _collect([1, 2, 3], 3)\n    assert result == [(0, 3)]\n\n\n# ---------------------------------------------------------------------------\n# 边界用例\n# ---------------------------------------------------------------------------\n\ndef test_windows_k_distinct_boundary_empty_x():\n    \"\"\"空序列：无任何产出。\n\n    期望值来源：规约边界情况 \"x 为空序列：无产出\"。\n    \"\"\"\n    result = _collect([], 1)\n    assert result == []\n\n\ndef test_windows_k_distinct_boundary_k_zero():\n    \"\"\"k=0：无产出。\n\n    期望值来源：规约后置条件 \"当 k <= 0 时不产出任何区间\"。\n    \"\"\"\n    result = _collect([1, 2, 3], 0)\n    assert result == []\n\n\ndef test_windows_k_distinct_boundary_k_negative():\n    \"\"\"k 为负数：无产出。\n\n    期望值来源：规约后置条件 \"当 k <= 0 时不产出任何区间\"。\n    \"\"\"\n    result = _collect([1, 2, 3], -1)\n    assert result == []\n\n\ndef test_windows_k_distinct_boundary_k_greater_than_distinct():\n    \"\"\"k 大于序列不同元素总数：无产出。\n\n    期望值来源：规约后置条件 \"当 k > 序列中不同元素总数时不产出任何区间\"。\n    \"\"\"\n    result = _collect([1, 2, 3], 5)\n    assert result == []\n\n\ndef test_windows_k_distinct_boundary_single_element():\n    \"\"\"单元素序列且 k=1，应产出 [0,1)。\n\n    期望值来源：规约后置条件（窗口内不同元素数恰好为 k）与边界情况。\n    \"\"\"\n    result = _collect([7], 1)\n    assert result == [(0, 1)]\n\n\ndef test_windows_k_distinct_boundary_all_distinct_postconditions():\n    \"\"\"所有元素互不相同，k=2：期望值未在规约中给出具体区间列表，\n    仅断言后置条件与不变量（探索性，需人工确认具体区间）。\n\n    期望值来源不明，需人工确认。\n    \"\"\"\n    x = [1, 2, 3, 4]\n    k = 2\n    result = _collect(x, k)\n\n    for i, j in result:\n        assert 0 <= i\n        assert i < j\n        assert j <= len(x)\n        assert _distinct_count(x[i:j]) == k\n\n\n# ---------------------------------------------------------------------------\n# 错误用例\n# ---------------------------------------------------------------------------\n\ndef test_windows_k_distinct_error_non_hashable_element():\n    \"\"\"元素为列表（不可哈希），构建 occ 字典时抛出 TypeError。\n\n    期望值来源：规约前置条件 \"x 的元素可哈希\"；违反前件应走异常路径。\n    \"\"\"\n    with pytest.raises(TypeError):\n        _collect([[1], [2]], 1)\n\n\ndef test_windows_k_distinct_error_k_not_int():\n    \"\"\"k 为非整数（字符串）：规约指出 \"非整数时 dist == k 恒不成立，无产出\"。\n\n    期望值来源：规约前置条件 \"k 为整数（代码未做类型校验，非整数时 dist == k 恒不成立）\"。\n    因此此处断言无产出（探索性，需人工确认）。\n    \"\"\"\n    result = _collect([1, 2, 3], \"2\")\n    assert result == []",
