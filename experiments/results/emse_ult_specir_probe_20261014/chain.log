  assert \"aaaa\"[x:x + l] == \"aaaa\"[y:y + l]\n        assert 0 <= x < n\n        assert y > x\n\n\n# ---------------------------------------------------------------------------\n# 正常用例：极大性过滤（无产出）\n# ---------------------------------------------------------------------------\n\ndef test_maximal_matching_pairs_simple_non_maximal_filtered():\n    \"\"\"'abcabc'：x=0,l=3,y=3 时 y==x+l 触发 not consecutive；其余组合无匹配。\n\n    期望值来源：测试计划描述，依据规约\"y >= x + l（两段不重叠且不连续）\"。\n    \"\"\"\n    assert _collect(\"abcabc\") == []\n\n\ndef test_maximal_matching_pairs_left_extension_filtered():\n    \"\"\"'xabcxabc'：左扩展过滤，无产出。\n\n    期望值来源：测试计划描述，依据规约\"不存在左扩展使其变大\"。\n    \"\"\"\n    assert _collect(\"xabcxabc\") == []\n\n\ndef test_maximal_matching_pairs_right_extension_filtered():\n    \"\"\"'abcxabcx'：右扩展过滤，无产出。\n\n    期望值来源：测试计划描述，依据规约\"不存在右扩展使其变大\"。\n    \"\"\"\n    assert _collect(\"abcxabcx\") == []\n\n\ndef test_maximal_matching_pairs_internal_extension_filtered():\n    \"\"\"'ababab'：内部扩展过滤，无产出。\n\n    期望值来源：测试计划描述，依据规约\"不存在内部扩展使其变大\"。\n    \"\"\"\n    assert _collect(\"ababab\") == []\n\n\ndef test_maximal_matching_pairs_external_extension_filtered():\n    \"\"\"'aabaaab'：外部扩展过滤，无产出。\n\n    期望值来源：测试计划描述，依据规约\"不存在外部扩展使其变大\"。\n    \"\"\"\n    assert _collect(\"aabaaab\") == []\n\n\n# ---------------------------------------------------------------------------\n# 正常用例：极大对产出\n# ---------------------------------------------------------------------------\n\ndef test_maximal_matching_pairs_single_maximal_pair():\n    \"\"\"'abcXabc'：应产出 (0, 4, 3)。\n\n    期望值来源：测试计划描述，依据规约\"产出的对均为极大对\"。\n    \"\"\"\n    assert _collect(\"abcXabc\") == [(0, 4, 3)]\n\n\ndef test_maximal_matching_pairs_multiple_maximal_pairs():\n    \"\"\"'abcXabcYabc'：三段相同子串两两构成极大对。\n\n    期望值来源：测试计划描述，依据规约\"产出的对均为极大对\"。\n    \"\"\"\n    assert _collect(\"abcXabcYabc\") == [(0, 4, 3), (0, 8, 3), (4, 8, 3)]\n\n\n# ---------------------------------------------------------------------------\n# 后置条件 / 不变量：对产出结果做通用校验\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\"string\", [\n    \"abcXabc\",\n    \"abcXabcYabc\",\n    \"aaaa\",\n    \"aabaaab\",\n    \"abcxabcx\",\n])\ndef test_maximal_matching_pairs_postconditions_hold(string):\n    \"\"\"对任意产出三元组，验证规约中的后置条件与不变量。\n\n    期望值来源：可执行规约后置/不变量子句。\n    \"\"\"\n    n = len(string)\n    result = _collect(string)\n    for (x, y, l) in result:\n        assert x >= 0\n        assert l >= 1\n        assert y >= x + l\n        assert y + l <= n\n        assert string[x:x + l] == string[y:y + l]\n        assert 0 <= x < n\n        assert y > x\n\n\n# ---------------------------------------------------------------------------\n# 错误用例：非序列输入\n# ---------------------------------------------------------------------------\n\ndef test_maximal_matching_pairs_none_input_raises():\n    \"\"\"string=None：len(None) 抛 TypeError。\n\n    期望值来源：规约前置条件\"string 为可索引、可切片、支持 find 的序列\"，\n    None 不满足前置条件，故走异常路径。\n    \"\"\"\n    with pytest.raises(TypeError):\n        _collect(None)\n\n\ndef test_maximal_matching_pairs_int_input_raises():\n    \"\"\"string=12345：len(int) 抛 TypeError。\n\n    期望值来源：规约前置条件\"string 为可索引、可切片、支持 find 的序列\"，\n    int 不满足前置条件，故走异常路径。\n    \"\"\"\n    with pytest.raises(TypeError):\n        _collect(12345)",
