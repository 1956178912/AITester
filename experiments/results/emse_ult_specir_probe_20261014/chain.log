          "rag_stats": null,
          "patch": "python\ndef knapsack_indv(n, c, w, W):\n    # Validate inputs: negative capacity or item count is invalid\n    if n < 0:\n        raise ValueError(\"n must be non-negative\")\n    if W < 0:\n        raise ValueError(\"W must be non-negative\")\n\n    # Initialize solution matrix\n    S = [[0 for i in range(W + 1)] for i in range(n + 1)]\n\n    # Iterate through possible times / weights\n    for v in range(1, (W + 1)):\n        # Iterate through each Reminder\n        for j in range(1, (n + 1)):\n            S[j][v] = S[j - 1][v]\n            w_j = int(w[j - 1])\n            c_j = c[j - 1]\n            # Only consider item if it fits in current capacity\n            if w_j <= v:\n                new_val = (S[j - 1][v - w_j] + c_j)\n                cur_val = S[j][v]\n                # If added value greater than current, include it\n                if new_val > cur_val:\n                    S[j][v] = round(new_val, 2)\n\n    # Display the Solution matrix\n    for i in range(0, (n + 1)):\n        print(S[i])\n\n    # List of indices to be returned\n    inds = []\n    # Vars for traversing back through S\n    rev_W = W\n    # Traverse back through S to find included Reminders\n    for i in range(n, 0, -1):\n        # Get weight and value of given Reminder\n        w_n = int(w[i - 1])\n        c_n = c[i - 1]\n        # If weight of given item is greater than remaining capacity, skip it\n        if rev_W < w_n:\n            continue\n        prev_cost = S[i - 1][rev_W - w_n] + c_n\n        if prev_cost >= S[i - 1][rev_W]:\n            inds = [i] + inds\n            rev_W -= w_n\n\n    return inds\n",
          "generated_test": "import pytest\n\nfrom knapsack_indv import knapsack_indv\n\n\n# ---------------------------------------------------------------------------\n# 辅助断言：仅依据规约中可判定的后置条件\n# ---------------------------------------------------------------------------\ndef _assert_postconditions(result, n):\n    \"\"\"校验规约中声明的后置条件。\"\"\"\n    assert isinstance(result, list)\n    assert all(1 <= i <= n for i in result)\n    assert result == sorted(result)\n\n\n# ---------------------------------------------------------------------------\n# 正常用例\n# ---------------------------------------------------------------------------\ndef test_knapsack_indv_typical_case_postconditions():\n    \"\"\"\n    典型 0/1 背包：n=3, c=[60,100,120], w=[10,20,30], W=50。\n\n    期望值来源：规约仅约束返回值类型、索引范围与升序，未给出具体最优解，\n    因此仅断言后置条件，并记录实际返回值供人工确认。\n    \"\"\"\n    n, c, w, W = 3, [60, 100, 120], [10, 20, 30], 50\n    result = knapsack_indv(n, c, w, W)\n    _assert_postconditions(result, n)\n    # 期望值来源不明，需人工确认：记录实际行为\n    assert isinstance(result, list)\n\n\ndef test_knapsack_indv_single_item_fits():\n    \"\"\"\n    单个物品重量 5 <= 容量 10，应被选中。\n\n    期望值来源：规约边界情况\"单个物品恰好等于 W\"的推广（可放入即选中），\n    以及后置条件约束。\n    \"\"\"\n    n, c, w, W = 1, [10], [5], 10\n    result = knapsack_indv(n, c, w, W)\n    _assert_postconditions(result, n)\n    assert result == [1]\n\n\ndef test_knapsack_indv_single_item_exact_capacity():\n    \"\"\"\n    单个物品重量恰好等于容量 W=50，应被选中。\n\n    期望值来源：规约边界情况\"单个物品恰好等于 W\"。\n    \"\"\"\n    n, c, w, W = 1, [50], [50], 50\n    result = knapsack_indv(n, c, w, W)\n    _assert_postconditions(result, n)\n    assert result == [1]\n\n\n# ---------------------------------------------------------------------------\n# 边界用例\n# ---------------------------------------------------------------------------\ndef test_knapsack_indv_single_item_overweight():\n    \"\"\"\n    单个物品重量 20 > 容量 10，无法放入，返回空列表。\n\n    期望值来源：规约边界情况\"w 中某物品重量大于 W（无法放入）\"。\n    \"\"\"\n    n, c, w, W = 1, [10], [20], 10\n    result = knapsack_indv(n, c, w, W)\n    _assert_postconditions(result, n)\n    assert result == []\n\n\ndef test_knapsack_indv_zero_capacity():\n    \"\"\"\n    W=0，容量为 0，返回空列表。\n\n    期望值来源：规约边界情况\"W=0（容量为 0，循环 range(1,1) 不执行，返回空列表）\"。\n    \"\"\"\n    n, c, w, W = 2, [10, 20], [1, 2], 0\n    result = knapsack_indv(n, c, w, W)\n    _assert_postconditions(result, n)\n    assert result == []\n\n\ndef test_knapsack_indv_zero_items():\n    \"\"\"\n    n=0，无物品，返回空列表。\n\n    期望值来源：规约边界情况\"n=0（无物品，返回空列表）\"。\n    \"\"\"\n    n, c, w, W = 0, [], [], 10\n    result = knapsack_indv(n, c, w, W)\n    _assert_postconditions(result, n)\n    assert result == []\n\n\ndef test_knapsack_indv_all_items_overweight():\n    \"\"\"\n    所有物品重量均大于容量 50，返回空列表。\n\n    期望值来源：规约边界情况\"所有物品重量都大于 W（返回空列表）\"。\n    \"\"\"\n    n, c, w, W = 3, [5, 10, 15], [100, 200, 300], 50\n    result = knapsack_indv(n, c, w, W)\n    _assert_postconditions(result, n)\n    assert result == []\n\n\ndef test_knapsack_indv_zero_value_item():\n    \"\"\"\n    物品 1 价值为 0，物品 2 价值为 10，容量 10。\n\n    期望值来源：规约边界情况\"物品价值为 0 或负数\"。\n    规约未明确价值为 0 的物品是否被选中，因此仅断言后置条件，\n    并记录实际返回值供人工确认。\n    \"\"\"\n    n, c, w, W = 2, [0, 10], [5, 10], 10\n    result = knapsack_indv(n, c, w, W)\n    _assert_postconditions(result, n)\n    # 期望值来源不明，需人工确认：记录实际行为\n    assert isinstance(result, list)\n\n\n# ---------------------------------------------------------------------------\n# 前置条件不满足 / 异常路径\n# ---------------------------------------------------------------------------\ndef test_knapsack_indv_float_string_weights_raises():\n    \"\"\"\n    w 元素为浮点字符串 \"5.0\"，int(\"5.0\") 会抛出 ValueError。\n\n    期望值来源：规约边界情况\"w 中元素为浮点数字符串（int() 转换）\"，\n    以及前置条件\"w 中元素可转换为 int\"被违反。\n    \"\"\"\n    n, c, w, W = 2, [10, 20], [\"5.0\", \"10.0\"], 15\n    with pytest.raises(ValueError):\n        knapsack_indv(n, c, w, W)\n\n\ndef test_knapsack_indv_n_exceeds_list_length_raises():\n    \"\"\"\n    n=5 但 c 和 w 长度仅为 1，违反前置条件 len(c) >= n 与 len(w) >= n，\n    访问越界索引会抛出 IndexError。\n\n    期望值来源：规约边界情况\"c 或 w 为空列表但 n>0（索引越界）\"。\n    \"\"\"\n    n, c, w, W = 5, [10], [5], 10\n    with pytest.raises(IndexError):\n        knapsack_indv(n, c, w, W)\n\n\ndef test_knapsack_indv_negative_capacity_raises():\n    \"\"\"\n    W=-1，违反前置条件 W >= 0。\n\n    期望值来源：规约前置条件\"W 为非负整数\"被违反。\n    规约未明确异常类型，仅断言抛出异常。\n    \"\"\"\n    n, c, w, W = 1, [10], [5], -1\n    with pytest.raises(Exception):\n        knapsack_indv(n, c, w, W)\n\n\ndef test_knapsack_indv_negative_n_raises():\n    \"\"\"\n    n=-1，违反前置条件 n >= 0。\n\n    期望值来源：规约前置条件\"n 为非负整数\"被违反。\n    规约未明确异常类型，仅断言抛出异常。\n    \"\"\"\n    n, c, w, W = -1, [], [], 10\n    with pytest.raises(Exception):\n        knapsack_indv(n, c, w, W)",
