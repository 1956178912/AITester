ion_x0e_inside_x1e_beyond():\n    \"\"\"x0e 在区间内 → x0=0；x1e>x1o → x1=x1o-x0e。\n    期望值来源：规约边界情况。\"\"\"\n    result = x0x1_after_extraction(0, 10, 5, 20)\n    _assert_postconditions(result)\n    assert result == (0, 5)\n\n\ndef test_x0x1_after_extraction_x0e_before_x1e_beyond():\n    \"\"\"x0e<=x0o → x0=x0o-x0e；x1e>x1o → x1=x1o-x0e。\n    期望值来源：规约边界情况。\"\"\"\n    result = x0x1_after_extraction(5, 10, 2, 20)\n    _assert_postconditions(result)\n    assert result == (3, 8)\n\n\n# ---------------------------------------------------------------------------\n# 边界用例\n# ---------------------------------------------------------------------------\ndef test_x0x1_after_extraction_x0e_equals_x0o():\n    \"\"\"x0e==x0o 同时满足第一与第二分支，规约规定取第一分支 → x0=0；\n    x1e 在区间内 → x1=x1e-x0e。期望值来源：规约边界情况。\"\"\"\n    result = x0x1_after_extraction(5, 10, 5, 8)\n    _assert_postconditions(result)\n    assert result == (0, 3)\n\n\ndef test_x0x1_after_extraction_x0e_equals_x1o():\n    \"\"\"x0e=x1o 在区间内 → x0=0；x1e=x1o 在区间内 → x1=0；x0==x1 → (None,None)。\n    期望值来源：规约边界情况（x0==x1 → (None,None)）。\"\"\"\n    result = x0x1_after_extraction(0, 10, 10, 10)\n    _assert_postconditions(result)\n    assert result == (None, None)\n\n\ndef test_x0x1_after_extraction_x1e_equals_x0o():\n    \"\"\"x0=x0o-x0e；x1e=x0o 在区间内 → x1=x1e-x0e；x0==x1 → (None,None)。\n    期望值来源：规约边界情况（x0==x1 → (None,None)）。\"\"\"\n    result = x0x1_after_extraction(5, 10, 2, 5)\n    _assert_postconditions(result)\n    assert result == (None, None)\n\n\ndef test_x0x1_after_extraction_zero_interval():\n    \"\"\"零区间提取：x0e=x1e=x0o=x1o=0 → x0=0,x1=0 → x0==x1 → (None,None)。\n    期望值来源：规约边界情况（x0==x1 → (None,None)）。\"\"\"\n    result = x0x1_after_extraction(0, 0, 0, 0)\n    _assert_postconditions(result)\n    assert result == (None, None)\n\n\n# ---------------------------------------------------------------------------\n# 错误 / 无效结果用例\n# ---------------------------------------------------------------------------\ndef test_x0x1_after_extraction_x0e_beyon