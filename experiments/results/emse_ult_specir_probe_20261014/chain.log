            "test_cases": "from create_three_random_v_indices import create_three_random_v_indices\ndef test_1():\n    assert create_three_random_v_indices(5, 10) == (0, 1, 2)\n\ndef test_2():\n    assert create_three_random_v_indices(0, 10) == (1, 2, 3)\n\ndef test_3():\n    assert create_three_random_v_indices(0, 5) == (1, 2, 3)\n\ndef test_4():\n    assert create_three_random_v_indices(3, 5) == (0, 1, 2)\n\ndef test_5():\n    assert create_three_random_v_indices(9, 10) == (0, 1, 2)\n\n",
            "fixed": "def create_three_random_v_indices(current_vector_index, numOfPop):\r\n    while True:\r\n        v_index_1 = random.randint(0,numOfPop)\r\n        if (v_index_1 != current_vector_index):\r\n            break\r\n    \"\"\"Get vector index 2\"\"\"\r\n    while True:\r\n        v_index_2 = random.randint(0, numOfPop)\r\n        if (v_index_2 != v_index_1 and v_index_2 != current_vector_index):\r\n            break\r\n    \"\"\"Get vector index 3\"\"\"\r\n    while True:\r\n        v_index_3 = random.randint(0, numOfPop)\r\n        if (v_index_3 != v_index_1 and v_index_3 != v_index_2 and v_index_3 != current_vector_index):\r\n            break\r\n    #print \"v_index_1 = \" + str(v_index_1) + \"\\nv_index_2 = \" + str(v_index_2) + \"\\nv_index_3 = \" + str(v_index_3) + \"\\ncurrent_vector_index = \" + str(current_vector_index)\r\n    return v_index_1, v_index_2, v_index_3",
