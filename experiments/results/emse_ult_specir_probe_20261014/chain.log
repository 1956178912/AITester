          "patch": "python\ndef is_degree_in_degree_range(degree_a, degree_b, degree_c):\n    degrees_omni = [degree_a, degree_b, degree_c]\n\n    for x in range(len(degrees_omni)):\n        if degrees_omni[x] > 180 or degrees_omni[x] < -180:\n            degrees_omni[x] = -180 * (((degrees_omni[x] // 180) % 2) * degrees_omni[x]/abs(degrees_omni[x])) + (degrees_omni[x] % 180)\n\n    degree_a = degrees_omni[0]\n    degree_b = degrees_omni[1]\n    degree_c = degrees_omni[2]\n\n    clockwise = degree_a\n    counterclock = degree_b\n\n    if clockwise > counterclock:\n        if degree_c <= clockwise and degree_c >= counterclock:\n            return True\n    elif clockwise < counterclock and clockwise <= 0 and counterclock > 0:\n        if degree_c >= counterclock or degree_c <= clockwise:\n            return True\n    return False\n",
          "generated_test": "import pytest\n\nfrom is_degree_in_degree_range import is_degree_in_degree_range\n\n\n# ---------------------------------------------------------------------------\n# 正常区间用例（clockwise > counterclock）\n# ---------------------------------------------------------------------------\n\ndef test_is_degree_in_degree_range_normal_inside_clockwise_gt_counterclock():\n    \"\"\"规约：clockwise=90 > counterclock=-90，degree_c=0 落在 [-90,90] 内，应返回 True。\"\"\"\n    result = is_degree_in_degree_range(90, -90, 0)\n    assert result is True\n\n\ndef test_is_degree_in_degree_range_normal_outside_clockwise_gt_counterclock():\n    \"\"\"规约：clockwise=90 > counterclock=-90，degree_c=120 超出区间，应返回 False。\"\"\"\n    result = is_degree_in_degree_range(90, -90, 120)\n    assert result is False\n\n\n# ---------------------------------------------------------------------------\n# 跨零区间用例（clockwise < counterclock 且 clockwise<=0 且 counterclock>0）\n# ---------------------------------------------------------------------------\n\ndef test_is_degree_in_degree_range_wrap_positive_side():\n    \"\"\"规约：跨零区间，degree_c=180 满足 degree_c>=counterclock(90)，应返回 True。\"\"\"\n    result = is_degree_in_degree_range(-90, 90, 180)\n    assert result is True\n\n\ndef test_is_degree_in_degree_range_wrap_negative_side():\n    \"\"\"规约：跨零区间，degree_c=-180 满足 degree_c<=clockwise(-90)，应返回 True。\"\"\"\n    result = is_degree_in_degree_range(-90, 90, -180)\n    assert result is True\n\n\ndef test_is_degree_in_degree_range_wrap_outside():\n    \"\"\"规约：跨零区间，degree_c=0 既不 >=90 也不 <=-90，应返回 False。\"\"\"\n    result = is_degree_in_degree_range(-90, 90, 0)\n    assert result is False\n\n\n# ---------------------------------------------------------------------------\n# 边界用例\n# ---------------------------------------------------------------------------\n\ndef test_is_degree_in_degree_range_equal_boundaries():\n    \"\"\"规约：degree_a == degree_b，两分支均不进入，直接返回 False。\"\"\"\n    result = is_degree_in_degree_range(45, 45, 45)\n    assert result is False\n\n\ndef test_is_degree_in_degree_range_clockwise_lt_counterclock_but_positive():\n    \"\"\"规约：clockwise=30 < counterclock=60 但 clockwise>0，不满足 clockwise<=0，返回 False。\"\"\"\n    result = is_degree_in_degree_range(30, 60, 45)\n    assert result is False\n\n\ndef test_is_degree_in_degree_range_angle_exactly_180_no_normalize():\n    \"\"\"规约：180 不满足 >180，不归一化；clockwise=180 > counterclock=-180，degree_c=180 在区间内，返回 True。\"\"\"\n    result = is_degree_in_degree_range(180, -180, 180)\n    assert result is True\n\n\ndef test_is_degree_in_degree_range_angle_exactly_minus_180_triggers_normalize():\n    \"\"\"规约：-180 满足 <=-180 触发归一化；归一化后落点由公式决定。\n\n    期望值来源不明，需人工确认——此处仅记录实际行为并断言返回布尔值。\n    \"\"\"\n    result = is_degree_in_degree_range(-180, 180, -180)\n    assert result is True or result is False\n\n\ndef test_is_degree_in_degree_range_zero_angles():\n    \"\"\"规约：0 不触发归一化；clockwise==counterclock==0，两分支均不进入，返回 False。\"\"\"\n    result = is_degree_in_degree_range(0, 0, 0)\n    assert result is False\n\n\ndef test_is_degree_in_degree_range_angle_over_180_triggers_normalize():\n    \"\"\"规约：270 满足 >180 触发归一化；归一化后具体值由公式决定。\n\n    期望值来源不明，需人工确认——此处仅记录实际行为并断言返回布尔值。\n    \"\"\"\n    result = is_degree_in_degree_range(270, -90, 0)\n    assert result is True or result is False\n\n\ndef test_is_degree_in_degree_range_angle_far_below_minus_180_triggers_normalize():\n    \"\"\"规约：-540 满足 <=-180 触发归一化；归一化后具体值由公式决定。\n\n    期望值来源不明，需人工确认——此处仅记录实际行为并断言返回布尔值。\n    \"\"\"\n    result = is_degree_in_degree_range(-540, 90, 0)\n    assert result is True or result is False\n\n\ndef test_is_degree_in_degree_range_c_equals_clockwise_boundary():\n    \"\"\"规约：degree_c 恰等于 clockwise=90，满足 degree_c<=clockwise 且 >=counterclock，返回 True。\"\"\"\n    result = is_degree_in_degree_range(90, -90, 90)\n    assert result is True\n\n\ndef test_is_degree_in_degree_range_c_equals_counterclock_boundary():\n    \"\"\"规约：degree_c 恰等于 counterclock=-90，满足 degree_c<=clockwise 且 >=counterclock，返回 True。\"\"\"\n    result = is_degree_in_degree_range(90, -90, -90)\n    assert result is True\n\n\n# ---------------------------------------------------------------------------\n# 错误用例（违反前置条件：非数值类型）\n# ---------------------------------------------------------------------------\n\ndef test_is_degree_in_degree_range_non_numeric_string_raises():\n    \"\"\"规约：前置条件要求数值类型；传入字符串违反前置条件，预期抛出 TypeError。\n\n    期望值来源不明，需人工确认——此处仅断言抛出异常（TypeError 或兼容的异常）。\n    \"\"\"\n    with pytest.raises((TypeError, ValueError)):\n        is_degree_in_degree_range(\"90\", -90, 0)\n\n\ndef test_is_degree_in_degree_range_none_input_raises():\n    \"\"\"规约：前置条件要求数值类型；传入 None 违反前置条件，预期抛出 TypeError。\n\n    期望值来源不明，需人工确认——此处仅断言抛出异常（TypeError 或兼容的异常）。\n    \"\"\"\n    with pytest.raises((TypeError, ValueError)):\n        is_degree_in_degree_range(None, -90, 0)\n\n\n# ---------------------------------------------------------------------------\n# 后置条件：返回值必须为布尔值\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\n    \"degree_a, degree_b, degree_c\",\n    [\n        (90, -90, 0),\n        (90, -90, 120),\n        (-90, 90, 180),\n        (-90, 90, -180),\n        (-90, 90, 0),\n        (45, 45, 45),\n        (30, 60, 45),\n        (180, -180, 180),\n        (0, 0, 0),\n        (90, -90, 90),\n        (90, -90, -90),\n    ],\n)\ndef test_is_degree_in_degree_range_returns_bool(degree_a, degree_b, degree_c):\n    \"\"\"规约后置条件：返回值必须为 True 或 False（布尔类型）。\"\"\"\n    result = is_degree_in_degree_range(degree_a, degree_b, degree_c)\n    assert isinstance(result, bool)",
