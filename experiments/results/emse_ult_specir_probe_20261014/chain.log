          "patch": "python\nimport collections.abc\n\nPROCESSOR_MAPPING = {\n    \"BertConfig\": \"BertProcessor\",\n    \"GPTConfig\": \"GPTProcessor\",\n    \"RobertaConfig\": \"RobertaProcessor\",\n    \"XLNetConfig\": \"XLNetProcessor\",\n    \"DistilBertConfig\": \"DistilBertProcessor\"\n}\n\nTOKENIZER_MAPPING = {\n    \"GPTConfig\": \"GPTTokenizer\",\n    \"XLNetConfig\": \"XLNetTokenizer\",\n    \"DistilBertConfig\": \"DistilBertTokenizer\"\n}\n\nIMAGE_PROCESSOR_MAPPING = {\n    \"RobertaConfig\": \"RobertaImageProcessor\"\n}\n\nFEATURE_EXTRACTOR_MAPPING = {\n    \"GPTConfig\": \"GPTFeatureExtractor\",\n    \"XLNetConfig\": \"XLNetFeatureExtractor\"\n}\n\ndef get_processor_types_from_config_class(config_class, allowed_mappings=None):\n\n    # To make a uniform return type\n    def _to_tuple(x):\n        # Strings (and bytes) are Sequences, but should be treated as a single\n        # element rather than being split into characters.\n        if isinstance(x, (str, bytes)) or not isinstance(x, collections.abc.Sequence):\n            x = (x,)\n        else:\n            x = tuple(x)\n        return x\n\n    if allowed_mappings is None:\n        allowed_mappings = [\"processor\", \"tokenizer\", \"image_processor\", \"feature_extractor\"]\n\n    processor_types = ()\n\n    # Check first if a model has `ProcessorMixin`. Otherwise, check if it has tokenizers, and/or an image processor or\n    # a feature extractor\n    if config_class in PROCESSOR_MAPPING and \"processor\" in allowed_mappings:\n        processor_types = _to_tuple(PROCESSOR_MAPPING[config_class])\n    else:\n        if config_class in TOKENIZER_MAPPING and \"tokenizer\" in allowed_mappings:\n            processor_types += _to_tuple(TOKENIZER_MAPPING[config_class])\n\n        if config_class in IMAGE_PROCESSOR_MAPPING and \"image_processor\" in allowed_mappings:\n            processor_types += _to_tuple(IMAGE_PROCESSOR_MAPPING[config_class])\n        elif config_class in FEATURE_EXTRACTOR_MAPPING and \"feature_extractor\" in allowed_mappings:\n            processor_types += _to_tuple(FEATURE_EXTRACTOR_MAPPING[config_class])\n\n    # Remark: some configurations have no processor at all. For example, generic composite models like\n    # `EncoderDecoderModel` is used for any (compatible) text models. Also, `DecisionTransformer` doesn't\n    # require any processor.\n\n    # We might get `None` for some tokenizers - remove them here.\n    processor_types = tuple(p for p in processor_types if p is not None)\n\n    return processor_types\n",
          "generated_test": "import collections.abc\n\nimport pytest\n\nfrom get_processor_types_from_config_class import get_processor_types_from_config_class\n\n\n# ---------------------------------------------------------------------------\n# 规约中明确给出的映射关系（来自测试计划，作为期望值来源）\n# ---------------------------------------------------------------------------\n# 这些期望值来自测试计划中明确列出的映射表内容，属于规约的一部分。\n# 对于计划中未明确给出映射值的 config_class，采用探索性断言。\n\n\ndef test_get_processor_types_from_config_class_returns_tuple_for_bert():\n    \"\"\"BertConfig 命中 PROCESSOR_MAPPING，默认 allowed_mappings 含 processor。\n\n    期望值来源：测试计划明确给出 (\"BertProcessor\",)。\n    \"\"\"\n    result = get_processor_types_from_config_class(\"BertConfig\")\n    assert isinstance(result, tuple)\n    assert result == (\"BertProcessor\",)\n\n\ndef test_get_processor_types_from_config_class_returns_tuple_for_gpt():\n    \"\"\"GPTConfig 未命中 PROCESSOR_MAPPING，累积 tokenizer 与 feature_extractor。\n\n    期望值来源：测试计划明确给出 (\"GPTTokenizer\", \"GPTFeatureExtractor\")。\n    \"\"\"\n    result = get_processor_types_from_config_class(\"GPTConfig\")\n    assert isinstance(result, tuple)\n    assert result == (\"GPTTokenizer\", \"GPTFeatureExtractor\")\n\n\ndef test_get_processor_types_from_config_class_returns_tuple_for_roberta():\n    \"\"\"RobertaConfig 命中 IMAGE_PROCESSOR_MAPPING。\n\n    期望值来源：测试计划明确给出 (\"RobertaImageProcessor\",)。\n    \"\"\"\n    result = get_processor_types_from_config_class(\"RobertaConfig\")\n    assert isinstance(result, tuple)\n    assert result == (\"RobertaImageProcessor\",)\n\n\ndef test_get_processor_types_from_config_class_returns_tuple_for_xlnet():\n    \"\"\"XLNetConfig 累积 tokenizer 与 feature_extractor。\n\n    期望值来源：测试计划明确给出 (\"XLNetTokenizer\", \"XLNetFeatureExtractor\")。\n    \"\"\"\n    result = get_processor_types_from_config_class(\"XLNetConfig\")\n    assert isinstance(result, tuple)\n    assert result == (\"XLNetTokenizer\", \"XLNetFeatureExtractor\")\n\n\ndef test_get_processor_types_from_config_class_returns_tuple_for_distilbert():\n    \"\"\"DistilBertConfig 仅命中 TOKENIZER_MAPPING。\n\n    期望值来源：测试计划明确给出 (\"DistilBertTokenizer\",)。\n    \"\"\"\n    result = get_processor_types_from_config_class(\"DistilBertConfig\")\n    assert isinstance(result, tuple)\n    assert result == (\"DistilBertTokenizer\",)\n\n\ndef test_get_processor_types_from_config_class_none_allowed_mappings_defaults():\n    \"\"\"allowed_mappings 为 None 时等价于默认四类。\n\n    期望值来源：规约后置条件 + 测试计划明确给出 (\"BertProcessor\",)。\n    \"\"\"\n    result = get_processor_types_from_config_class(\"BertConfig\", None)\n    assert isinstance(result, tuple)\n    assert result == (\"BertProcessor\",)\n\n\ndef test_get_processor_types_from_config_class_empty_allowed_mappings():\n    \"\"\"allowed_mappings 为空列表 → 返回空元组。\n\n    期望值来源：规约边界情况明确给出 ()。\n    \"\"\"\n    result = get_processor_types_from_config_class(\"BertConfig\", [])\n    assert isinstance(result, tuple)\n    assert result == ()\n\n\ndef test_get_processor_types_from_config_class_processor_only_not_in_processor_mapping():\n    \"\"\"allowed_mappings 仅含 processor 但 config_class 不在 PROCESSOR_MAPPING → 空元组。\n\n    期望值来源：规约边界情况明确给出 ()。\n    \"\"\"\n    result = get_processor_types_from_config_class(\"GPTConfig\", [\"processor\"])\n    assert isinstance(result, tuple)\n    assert result == ()\n\n\ndef test_get_processor_types_from_config_class_tokenizer_only_for_gpt():\n    \"\"\"allowed_mappings 仅含 tokenizer 时 GPTConfig 只返回 tokenizer。\n\n    期望值来源：测试计划明确给出 (\"GPTTokenizer\",)。\n    \"\"\"\n    result = get_processor_types_from_config_class(\"GPTConfig\", [\"tokenizer\"])\n    assert isinstance(result, tuple)\n    assert result == (\"GPTTokenizer\",)\n\n\ndef test_get_processor_types_from_config_class_image_processor_only_for_roberta():\n    \"\"\"allowed_mappings 仅含 image_processor 时 RobertaConfig 返回 image_processor。\n\n    期望值来源：测试计划明确给出 (\"RobertaImageProcessor\",)。\n    \"\"\"\n    result = get_processor_types_from_config_class(\"RobertaConfig\", [\"image_processor\"])\n    assert isinstance(result, tuple)\n    assert result == (\"RobertaImageProcessor\",)\n\n\ndef test_get_processor_types_from_config_class_feature_extractor_only_for_gpt():\n    \"\"\"allowed_mappings 仅含 feature_extractor 时 GPTConfig 返回 feature_extractor。\n\n    期望值来源：测试计划明确给出 (\"GPTFeatureExtractor\",)。\n    \"\"\"\n    result = get_processor_types_from_config_class(\"GPTConfig\", [\"feature_extractor\"])\n    assert isinstance(result, tuple)\n    assert result == (\"GPTFeatureExtractor\",)\n\n\ndef test_get_processor_types_from_config_class_unknown_config_class():\n    \"\"\"未知 config_class 不在任何映射表中 → 返回空元组。\n\n    期望值来源：规约边界情况明确给出 ()。\n    \"\"\"\n    result = get_processor_types_from_config_class(\"EncoderDecoderModel\")\n    assert isinstance(result, tuple)\n    assert result == ()\n\n\ndef test_get_processor_types_from_config_class_processor_priority_over_tokenizer():\n    \"\"\"命中 PROCESSOR_MAPPING 时走 processor 分支，不再累积 tokenizer。\n\n    期望值来源：规约后置条件 + 测试计划明确给出 (\"BertProcessor\",)。\n    \"\"\"\n    result = get_processor_types_from_config_class(\"BertConfig\", [\"processor\", \"tokenizer\"])\n    assert isinstance(result, tuple)\n    assert result == (\"BertProcessor\",)\n\n\ndef test_get_processor_types_from_config_class_image_processor_priority_over_feature_extractor():\n    \"\"\"同时允许 image_processor 与 feature_extractor 时只取 image_processor（elif 分支）。\n\n    期望值来源：规约边界情况 + 测试计划明确给出 (\"RobertaImageProcessor\",)。\n    \"\"\"\n    result = get_processor_types_from_config_class(\n        \"RobertaConfig\", [\"image_processor\", \"feature_extractor\"]\n    )\n    assert isinstance(result, tuple)\n    assert result == (\"RobertaImageProcessor\",)\n\n\ndef test_get_processor_types_from_config_class_none_config_class():\n    \"\"\"config_class 为 None 不在任何映射表中 → 返回空元组（不抛异常）。\n\n    期望值来源：测试计划明确给出 ()。\n    \"\"\"\n    result = get_processor_types_from_config_class(None)\n    assert isinstance(result, tuple)\n    assert result == ()\n\n\ndef test_get_processor_types_from_config_class_unhashable_config_class():\n    \"\"\"config_class 为不可哈希对象（列表）时，字典成员判断会抛 TypeError。\n\n    期望值来源：规约前置条件要求 config_class 可哈希；违反前置条件时行为未定义，\n    测试计划标注期望值未知。此处仅验证其抛出异常（探索性），需人工确认。\n    \"\"\"\n    with pytest.raises(TypeError):\n        get_processor_types_from_config_class([])\n\n\ndef test_get_processor_types_from_config_class_string_allowed_mappings():\n    \"\"\"allowed_mappings 传入字符串（Sequence 但非列表）时按子串语义判断。\n\n    期望值来源：规约边界情况说明行为依赖调用方约定，测试计划标注期望值未知。\n    此处采用探索性断言：仅验证返回类型与不变量，需人工确认具体值。\n    \"\"\"\n    result = get_processor_types_from_config_class(\"GPTConfig\", \"tokenizer\")\n    assert isinstance(result, tuple)\n    assert all(p is not None for p in result)\n    assert all(isinstance(p, str) for p in result)\n\n\n# ---------------------------------------------------------------------------\n# 通用不变量测试：对多个输入验证后置条件与不变量\n# ---------------------------------------------------------------------------\n@pytest.mark.parametrize(\n    \"config_class, allowed_mappings\",\n    [\n        (\"BertConfig\", None),\n        (\"GPTConfig\", None),\n        (\"RobertaConfig\", None),\n        (\"XLNetConfig\", None),\n        (\"DistilBertConfig\", None),\n        (\"EncoderDecoderModel\", None),\n        (\"BertConfig\", []),\n        (\"GPTConfig\", [\"processor\"]),\n        (\"GPTConfig\", [\"tokenizer\"]),\n        (\"RobertaConfig\", [\"image_processor\"]),\n        (\"GPTConfig\", [\"feature_extractor\"]),\n        (\"BertConfig\", [\"processor\", \"tokenizer\"]),\n        (\"RobertaConfig\", [\"image_processor\", \"feature_extractor\"]),\n        (None, None),\n    ],\n)\ndef test_get_processor_types_from_config_class_invariants(config_class, allowed_mappings):\n    \"\"\"验证后置条件与不变量：返回 tuple、无 None 元素、元素均为 str。\n\n    期望值来源：规约后置条件与不变量。\n    \"\"\"\n    result = get_processor_types_from_config_class(config_class, allowed_mappings)\n    assert isinstance(result, tuple)\n    assert all(p is not None for p in result)\n    assert all(isinstance(