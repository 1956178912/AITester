          "rag_stats": null,
          "patch": "python\ndef can_blas(inputs, result, idx_removed):\n\n    # Gotta remove indices\n    if len(idx_removed) == 0:\n        return False\n\n    # Can only do two\n    if len(inputs) != 2:\n        return False\n\n    # Make sure there is overlap\n    if len(set(inputs[0]) & set(inputs[1])) == 0:\n        return False\n\n    # Build a few temporaries\n    sets = [set(x) for x in inputs]\n    keep_left = sets[0] - idx_removed\n    keep_right = sets[1] - idx_removed\n    input_left = inputs[0]\n    input_right = inputs[1]\n    rs = len(idx_removed)\n\n    if any(len(l) != len(s) for l, s in zip(inputs, sets)):\n        return False\n\n    # DDOT\n    if inputs[0] == inputs[1]:\n        return 'DOT'\n\n    # Cannot handle partial inner\n    if len(keep_left & keep_right):\n        return False\n\n    # DDOT doesnt make sense if you have to tranpose\n    elif sets[0] == sets[1]:\n        return False\n\n    # GEMM no transpose\n    elif input_left[-rs:] == input_right[:rs]:\n        return 'GEMM'\n\n    # GEMM transpose both\n    elif input_left[:rs] == input_right[-rs:]:\n        return 'GEMM'\n\n    # GEMM transpose right\n    elif input_left[-rs:] == input_right[-rs:]:\n        return 'GEMM'\n\n    # GEMM tranpose left\n    elif input_left[:rs] == input_right[:rs]:\n        return 'GEMM'\n\n    # Einsum is faster than vectordot if we have to copy\n    elif (len(keep_left) == 0) or (len(keep_right) == 0):\n        return False\n\n    # Conventional tensordot\n    else:\n        return 'TDOT'\n",
          "generated_test": "import pytest\n\nfrom can_blas import can_blas\n\n\n# ---------------------------------------------------------------------------\n# 辅助工具\n# ---------------------------------------------------------------------------\n\nVALID_RESULTS = (False, \"DOT\", \"GEMM\", \"TDOT\")\n\n\ndef _assert_valid_result(result):\n    \"\"\"断言返回值属于规约允许的取值集合。\"\"\"\n    assert result in VALID_RESULTS, (\n        \"返回值必须为 False 或 'DOT'/'GEMM'/'TDOT' 之一，实际为 %r\" % (result,)\n    )\n\n\n# ---------------------------------------------------------------------------\n# 后置条件：返回值域\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\n    \"inputs, result, idx_removed\",\n    [\n        ([\"ij\", \"jk\"], \"ik\", {\"j\"}),\n        ([\"ij\", \"ij\"], \"ij\", {\"i\"}),\n        ([\"ij\", \"jk\"], \"ik\", set()),\n        ([\"ij\", \"kl\"], \"ijkl\", {\"i\"}),\n        ([\"ii\", \"jk\"], \"ijk\", {\"i\"}),\n        ([\"ij\"], \"ij\", {\"i\"}),\n        ([\"ij\", \"jk\", \"kl\"], \"il\", {\"j\"}),\n    ],\n)\ndef test_can_blas_return_value_in_allowed_domain(inputs, result, idx_removed):\n    \"\"\"后置条件：返回值必须为 False 或 'DOT'/'GEMM'/'TDOT' 之一。\"\"\"\n    out = can_blas(inputs, result, idx_removed)\n    _assert_valid_result(out)\n\n\n# ---------------------------------------------------------------------------\n# 边界：idx_removed 为空 → False\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\n    \"inputs, result\",\n    [\n        ([\"ij\", \"jk\"], \"ik\"),\n        ([\"ij\", \"ij\"], \"ij\"),\n        ([\"ij\", \"jk\"], \"ijk\"),\n    ],\n)\ndef test_can_blas_empty_idx_removed_returns_false(inputs, result):\n    \"\"\"边界：idx_removed 为空 → False。\"\"\"\n    out = can_blas(inputs, result, set())\n    assert out is False\n\n\n# ---------------------------------------------------------------------------\n# 边界：inputs 长度不为 2 → False\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\n    \"inputs, result, idx_removed\",\n    [\n        ([], \"i\", {\"i\"}),\n        ([\"ij\"], \"ij\", {\"i\"}),\n        ([\"ij\", \"jk\", \"kl\"], \"il\", {\"j\"}),\n    ],\n)\ndef test_can_blas_inputs_length_not_two_returns_false(inputs, result, idx_removed):\n    \"\"\"边界：inputs 长度不为 2（0/1/3）→ False。\"\"\"\n    out = can_blas(inputs, result, idx_removed)\n    assert out is False\n\n\n# ---------------------------------------------------------------------------\n# 边界：两输入无交集 → False\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\n    \"inputs, result, idx_removed\",\n    [\n        ([\"ij\", \"kl\"], \"ijkl\", {\"i\"}),\n        ([\"ab\", \"cd\"], \"abcd\", {\"a\"}),\n        ([\"ij\", \"kl\"], \"ijkl\", {\"i\", \"k\"}),\n    ],\n)\ndef test_can_blas_no_intersection_returns_false(inputs, result, idx_removed):\n    \"\"\"边界：两输入无交集 → False。\"\"\"\n    out = can_blas(inputs, result, idx_removed)\n    assert out is False\n\n\n# ---------------------------------------------------------------------------\n# 边界：输入字符串含重复字符 → False\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\n    \"inputs, result, idx_removed\",\n    [\n        ([\"ii\", \"jk\"], \"ijk\", {\"i\"}),\n        ([\"ij\", \"jj\"], \"ij\", {\"j\"}),\n        ([\"aa\", \"ab\"], \"ab\", {\"a\"}),\n    ],\n)\ndef test_can_blas_repeated_chars_returns_false(inputs, result, idx_removed):\n    \"\"\"边界：输入字符串含重复字符 → False。\"\"\"\n    out = can_blas(inputs, result, idx_removed)\n    assert out is False\n\n\n# ---------------------------------------------------------------------------\n# 边界：inputs[0] == inputs[1] → 'DOT'\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\n    \"inputs, result, idx_removed\",\n    [\n        ([\"ij\", \"ij\"], \"ij\", {\"i\"}),\n        ([\"ij\", \"ij\"], \"ij\", {\"j\"}),\n        ([\"abc\", \"abc\"], \"abc\", {\"a\"}),\n    ],\n)\ndef test_can_blas_identical_inputs_returns_dot(inputs, result, idx_removed):\n    \"\"\"边界：inputs[0] == inputs[1]（且 idx_removed 非空、有交集）→ 'DOT'。\"\"\"\n    out = can_blas(inputs, result, idx_removed)\n    assert out == \"DOT\"\n\n\n# ---------------------------------------------------------------------------\n# 边界：sets[0] == sets[1] 但字符串不同 → False\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\n    \"inputs, result, idx_removed\",\n    [\n        ([\"ij\", \"ji\"], \"ij\", {\"i\"}),\n        ([\"abc\", \"cba\"], \"abc\", {\"a\"}),\n        ([\"ij\", \"ji\"], \"ij\", {\"j\"}),\n    ],\n)\ndef test_can_blas_same_set_different_string_returns_false(inputs, result, idx_removed):\n    \"\"\"边界：sets[0] == sets[1] 但字符串不同 → False。\"\"\"\n    out = can_blas(inputs, result, idx_removed)\n    assert out is False\n\n\n# ---------------------------------------------------------------------------\n# 边界：keep_left 与 keep_right 有交集（部分内积）→ False\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\n    \"inputs, result, idx_removed\",\n    [\n        # inputs[0]=\"ijk\", inputs[1]=\"jkl\", idx_removed={\"j\"}\n        # keep_left = {i,k}, keep_right = {k,l} → 交集 {k} 非空\n        ([\"ijk\", \"jkl\"], \"ijkl\", {\"j\"}),\n        # inputs[0]=\"abc\", inputs[1]=\"bcd\", idx_removed={\"b\"}\n        # keep_left = {a,c}, keep_right = {c,d} → 交集 {c} 非空\n        ([\"abc\", \"bcd\"], \"abcd\", {\"b\"}),\n    ],\n)\ndef test_can_blas_partial_inner_product_returns_false(inputs, result, idx_removed):\n    \"\"\"边界：keep_left 与 keep_right 有交集（部分内积）→ False。\"\"\"\n    out = can_blas(inputs, result, idx_removed)\n    assert out is False\n\n\n# ---------------------------------------------------------------------------\n# 边界：keep_left 或 keep_right 为空 → False\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\n    \"inputs, result, idx_removed\",\n    [\n        # inputs[0]=\"ij\", inputs[1]=\"jk\", idx_removed={\"i\",\"j\"}\n        # keep_left = {} → 空\n        ([\"ij\", \"jk\"], \"k\", {\"i\", \"j\"}),\n        # inputs[0]=\"ij\", inputs[1]=\"jk\", idx_removed={\"j\",\"k\"}\n        # keep_right = {} → 空\n        ([\"ij\", \"jk\"], \"i\", {\"j\", \"k\"}),\n    ],\n)\ndef test_can_blas_empty_keep_side_returns_false(inputs, result, idx_removed):\n    \"\"\"边界：keep_left 或 keep_right 为空 → False。\"\"\"\n    out = can_blas(inputs, result, idx_removed)\n    assert out is False\n\n\n# ---------------------------------------------------------------------------\n# 后置条件：返回 'DOT' 时的性质\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\n    \"inputs, result, idx_removed\",\n    [\n        ([\"ij\", \"ij\"], \"ij\", {\"i\"}),\n        ([\"ij\", \"ij\"], \"ij\", {\"j\"}),\n        ([\"abc\", \"abc\"], \"abc\", {\"a\"}),\n    ],\n)\ndef test_can_blas_dot_postcondition(inputs, result, idx_removed):\n    \"\"\"后置条件：返回 'DOT' 时 inputs[0]==inputs[1]、idx_removed 非空、\n    inputs 长度为 2 且两输入有交集。\"\"\"\n    out = can_blas(inputs, result, idx_removed)\n    if out == \"DOT\":\n        assert len(inputs) == 2\n        assert inputs[0] == inputs[1]\n        assert len(idx_removed) > 0\n        assert set(inputs[0]) & set(inputs[1])\n    else:\n        # 规约未强制此输入必为 DOT，记录实际行为\n        _assert_valid_result(out)\n\n\n# ---------------------------------------------------------------------------\n# 后置条件：返回 'GEMM' 时的性质\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\n    \"inputs, result, idx_removed\",\n    [\n        # 典型 GEMM 场景：共享一个收缩索引，各自保留一个自由索引\n        ([\"ij\", \"jk\"], \"ik\", {\"j\"}),\n        ([\"ij\", \"kj\"], \"ik\", {\"j\"}),\n        ([\"ji\", \"jk\"], \"ik\", {\"j\"}),\n        ([\"ji\", \"kj\"], \"ik\", {\"j\"}),\n    ],\n)\ndef test_can_blas_gemm_postcondition(inputs, result, idx_removed):\n    \"\"\"后置条件：返回 'GEMM' 时两输入集合不等且存在指定重叠模式。\"\"\"\n    out = can_blas(inputs, result, idx_removed)\n    if out == \"GEMM\":\n        assert set(inputs[0]) != set(inputs[1])\n    else:\n        _assert_valid_result(out)\n\n\n# ---------------------------------------------------------------------------\n# 后置条件：返回 'TDOT' 时的性质\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\n    \"inputs, result, idx_removed\",\n    [\n        # 非 GEMM 重叠模式，keep_left / keep_right 非空\n        ([\"ijk\", \"jkl\"], \"il\", {\"j\", \"k\"}),\n        ([\"abc\", \"cde\"], \"abe\", {\"c\", \"d\"}),\n    ],\n)\ndef test_can_blas_tdot_postcondition(inputs, result, idx_removed):\n    \"\"\"后置条件：返回 'TDOT' 时 keep_left 或 keep_right 非空且无 GEMM 重叠模式。\"\"\"\n    out = can_blas(inputs, result, idx_removed)\n    if out == \"TDOT\":\n        keep_left = set(inputs[0]) - set(idx_removed)\n        keep_right = set(inputs[1]) - set(idx_removed)\n        assert keep_left or keep_right\n    else:\n        _assert_valid_result(out)\n\n\n# ---------------------------------------------------------------------------\n# 探索性：GEMM 四种重叠模式（期望值来源不明，需人工确认）\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\n    \"inputs, result, idx_removed\",\n    [\n        # 模式 1：inputs[0] 尾部索引 == inputs[1] 头部索引\n        ([\"ij\", \"jk\"], \"ik\", {\"j\"}),\n        # 模式 2：inputs[0] 尾部索引 == inputs[1] 尾部索引\n        ([\"ij\", \"kj\"], \"ik\", {\"j\"}),\n        # 模式 3：inputs[0] 头部索引 == inputs[1] 头部索引\n        ([\"ji\", \"jk\"], \"ik\", {\"j\"}),\n        # 模式 4：inputs[0] 头部索引 == inputs[1] 尾部索引\n        ([\"ji\", \"kj\"], \"ik\", {\"j\"}),\n    ],\n)\ndef test_can_blas_gemm_overlap_patterns_exploratory(inputs, result, idx_removed):\n    \"\"\"探索性：GEMM 四种重叠模式分别命中。\n\n    期望值来源不明，需人工确认：规约仅声明 'GEMM 四种重叠模式分别命中'，\n    未给出每种模式的确切返回值。此处仅记录实际行为并断言返回值域。\n    \"\"\"\n    out = can_blas(inputs, result, idx_removed)\n    _assert_valid_result(out)\n\n\n# ---------------------------------------------------------------------------\n# 探索性：一般合法输入的行为记录（期望值来源不明，需人工确认）\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\n    \"inputs, result, idx_removed\",\n    [\n        ([\"ij\", \"jk\"], \"ik\", {\"j\"}),\n        ([\"ij\", \"ij\"], \"ij\", {\"i\"}),\n        ([\"ijk\", \"jkl\"], \"il\", {\"j\", \"k\"}),\n    ],\n)\ndef test_can_blas_general_behavior_exploratory(inputs, result, idx_removed):\n    \"\"\"探索性：记录一般合法输入下的实际返回值。\n\n    期望值来源不明，需人工确认：规约未对每种输入给出唯一确定返回值，\n    仅约束返回值域。此处断言返回值域，不臆造具体值。\n    \"\"\"\n    out = can_blas(inputs, result, idx_removed)\n    _assert_valid_result(out)",
