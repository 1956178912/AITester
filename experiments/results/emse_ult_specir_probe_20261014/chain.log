          "patch": "python\nimport re\n\n\ndef calc_query_pos_from_cigar(cigar, strand):\n\n    cigar_ops = [[int(op[0]), op[1]] for op in re.findall(r'(\\d+)([A-Za-z])', cigar)]\n\n    order_ops = cigar_ops\n    if not strand:  # - strand\n        order_ops = order_ops[::-1]\n\n    qs_pos = 0\n    qe_pos = 0\n    q_len = 0\n\n    for op_position in range(len(order_ops)):\n        op_len = order_ops[op_position][0]\n        op_type = order_ops[op_position][1]\n\n        if op_position == 0 and (op_type == 'H' or op_type == 'S'):\n            qs_pos += op_len\n            qe_pos += op_len\n            q_len += op_len\n        elif op_type == 'H' or op_type == 'S':\n            q_len += op_len\n        elif op_type == 'M' or op_type == 'I' or op_type == 'X':\n            qe_pos += op_len\n            q_len += op_len\n\n    return qs_pos, qe_pos, q_len\n",
          "generated_test": "import pytest\n\nfrom calc_query_pos_from_cigar import calc_query_pos_from_cigar\n\n\n# ---------------------------------------------------------------------------\n# 规约（Spec）中可判定的后置条件断言辅助函数\n# ---------------------------------------------------------------------------\ndef _assert_postconditions(result):\n    \"\"\"断言规约中列出的所有可执行后置条件。\"\"\"\n    assert isinstance(result, tuple), \"返回值必须是 tuple\"\n    assert len(result) == 2, \"返回值长度必须为 2\"\n    qs_pos, qe_pos = result\n    assert isinstance(qs_pos, int) and not isinstance(qs_pos, bool), \"qs_pos 必须为整数\"\n    assert isinstance(qe_pos, int) and not isinstance(qe_pos, bool), \"qe_pos 必须为整数\"\n    assert qs_pos >= 0, \"qs_pos 必须非负\"\n    assert qe_pos >= 0, \"qe_pos 必须非负\"\n    assert qe_pos >= qs_pos, \"qe_pos 必须 >= qs_pos\"\n\n\n# ---------------------------------------------------------------------------\n# 正常用例\n# ---------------------------------------------------------------------------\ndef test_calc_query_pos_from_cigar_positive_strand_typical():\n    \"\"\"正链典型 CIGAR '10M5S'。\n\n    期望值来源：测试计划明确给出 expected_output=[0, 15]。\n    \"\"\"\n    result = calc_query_pos_from_cigar(\"10M5S\", True)\n    _assert_postconditions(result)\n    assert result == (0, 15)\n\n\ndef test_calc_query_pos_from_cigar_negative_strand_typical():\n    \"\"\"负链典型 CIGAR '10M5S'。\n\n    期望值来源：测试计划明确给出 expected_output=[0, 15]。\n    \"\"\"\n    result = calc_query_pos_from_cigar(\"10M5S\", False)\n    _assert_postconditions(result)\n    assert result == (0, 15)\n\n\ndef test_calc_query_pos_from_cigar_first_op_is_s():\n    \"\"\"首操作为 S 的 CIGAR '5S10M'。\n\n    期望值来源：测试计划明确给出 expected_output=[5, 15]。\n    \"\"\"\n    result = calc_query_pos_from_cigar(\"5S10M\", True)\n    _assert_postconditions(result)\n    assert result == (5, 15)\n\n\ndef test_calc_query_pos_from_cigar_first_op_is_h():\n    \"\"\"首操作为 H 的 CIGAR '5H10M'。\n\n    期望值来源：测试计划明确给出 expected_output=[5, 15]。\n    \"\"\"\n    result = calc_query_pos_from_ci