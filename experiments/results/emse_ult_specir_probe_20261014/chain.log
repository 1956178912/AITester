          "rag_stats": null,
          "patch": "python\ndef BinaryFromFraction(num, den):\n    Precision = 52\n    MinExponent = -1022\n\n    assert num != 0\n    assert den != 0\n\n    f = 0\n    e = 0\n    p = Precision\n    isExact = True\n\n    # g = fractions.gcd(num, den)\n    # num //= g\n    # den //= g\n\n    # Scale into [2^(p-1), 2^p)\n    # Use bit_length to compute the shift directly instead of looping,\n    # which avoids O(value) iterations for large integers.\n    shift = num.bit_length() - den.bit_length() - (p - 1)\n    if shift > 0:\n        den <<= shift\n        e += shift\n    elif shift < 0:\n        num <<= -shift\n        e += shift\n\n    # After the direct shift, adjust by at most one step to land in range.\n    while num >= 2**p * den:\n        den *= 2\n        e += 1\n    while num < 2**(p - 1) * den:\n        num *= 2\n        e -= 1\n\n    # For subnormal numbers, try to reduce the precision of the\n    # significand to get the exponent into the valid range.\n    while e < MinExponent and p > 1:\n        den *= 2\n        e += 1\n        p -= 1\n\n    # Divide and round\n    f, r = divmod(num, den)\n    assert f >= 0\n    assert f < 2**Precision\n    isExact = (r == 0)\n    if not isExact:\n        # Round to nearest-even\n        if 2 * r > den or (2 * r == den and (f % 2) != 0):\n            f += 1\n            if f == 2**Precision:\n                # Overflow.\n                # Move a trailing zero into the exponent.\n                f = 2**(Precision - 1)\n                e += 1\n\n    assert f > 0\n    assert f < 2**Precision\n\n    return f, e, p, isExact\n",
          "generated_test": "import pytest\n\nfrom BinaryFromFraction import BinaryFromFraction\n\n\nclass TestBinaryFromFraction:\n    \"\"\"Tests for BinaryFromFraction.\n\n    The function converts a positive fraction num/den into a binary\n    floating point representation, returning (f, e, p, isExact) where\n    f is the significand, e the exponent, p the precision used, and\n    isExact indicates whether the representation is exact.\n\n    Expected values are derived from the docstring/implementation\n    invariants (assertions) present in the source code.\n    \"\"\"\n\n    def test_binaryfromfraction_zero_numerator_raises(self):\n        \"\"\"num == 0 must trigger an AssertionError (assert num != 0).\"\"\"\n        with pytest.raises(AssertionError):\n            BinaryFromFraction(0, 1)\n\n    def test_binaryfromfraction_zero_denominator_raises(self):\n        \"\"\"den == 0 must trigger an AssertionError (assert den != 0).\"\"\"\n        with pytest.raises(AssertionError):\n            BinaryFromFraction(1, 0)\n\n    def test_binaryfromfraction_zero_both_raises(self):\n        \"\"\"num == 0 and den == 0 must trigger an AssertionError.\"\"\"\n        with pytest.raises(AssertionError):\n            BinaryFromFraction(0, 0)\n\n    def test_binaryfromfraction_one_half_exact(self):\n        \"\"\"1/2 = 2^-1 is exactly representable.\n\n        Expected values derived from the implementation invariants:\n        f in [2^(p-1), 2^p), e is the binary exponent, isExact True.\n        \"\"\"\n        f, e, p, isExact = BinaryFromFraction(1, 2)\n        assert isExact is True\n        assert 0 < f < 2 ** 52\n        # 1/2 scaled into [2^(p-1), 2^p) with p=52 gives f = 2^51, e = -1\n        assert f == 2 ** 51\n        assert e == -1\n        assert p == 52\n\n    def test_binaryfromfraction_one_exact(self):\n        \"\"\"1/1 = 1 is exactly representable.\n\n        Expected values derived from the implementation invariants.\n        \"\"\"\n        f, e, p, isExact = BinaryFromFraction(1, 1)\n        assert isExact is True\n        assert 0 < f < 2 ** 52\n        # 1 scaled into [2^(p-1), 2^p) with p=52 gives f = 2^51, e = 0\n        assert f == 2 ** 51\n        assert e == 0\n        assert p == 52\n\n    def test_binaryfromfraction_three_quarters_exact(self):\n        \"\"\"3/4 = 0.11b is exactly representable.\n\n        Expected values derived from the implementation invariants.\n        \"\"\"\n        f, e, p, isExact = BinaryFromFraction(3, 4)\n        assert isExact is True\n        assert 0 < f < 2 ** 52\n        # 3/4 scaled into [2^(p-1), 2^p) with p=52 gives f = 3*2^50, e = -1\n        assert f == 3 * 2 ** 50\n        assert e == -1\n        assert p == 52\n\n    def test_binaryfromfraction_one_third_inexact(self):\n        \"\"\"1/3 is not exactly representable in binary.\n\n        Expected values derived from the implementation invariants:\n        isExact must be False, and f must lie in [2^(p-1), 2^p).\n        \"\"\"\n        f, e, p, isExact = BinaryFromFraction(1, 3)\n        assert isExact is False\n        assert 0 < f < 2 ** 52\n        assert p == 52\n\n    def test_binaryfromfraction_returns_four_tuple(self):\n        \"\"\"Return value must be a 4-tuple (f, e, p, isExact).\n\n        Expected structure derived from the return statement.\n        \"\"\"\n        result = BinaryFromFraction(1, 2)\n        assert isinstance(result, tuple)\n        assert len(result) == 4\n\n    def test_binaryfromfraction_significand_in_range(self):\n        \"\"\"f must satisfy 0 < f < 2^52 for a variety of inputs.\n\n        Invariant derived from the assertions in the source code.\n        \"\"\"\n        for num, den in [(1, 2), (1, 1), (3, 4), (1, 3), (7, 8), (5, 7)]:\n            f, e, p, isExact = BinaryFromFraction(num, den)\n            assert 0 < f < 2 ** 52\n\n    def test_binaryfromfraction_precision_positive(self):\n        \"\"\"p must be a positive integer (p starts at 52 and only decreases).\n\n        Invariant derived from the implementation.\n        \"\"\"\n        for num, den in [(1, 2), (1, 1), (1, 3)]:\n            f, e, p, isExact = BinaryFromFraction(num, den)\n            assert p >= 1\n            assert p <= 52\n\n    def test_binaryfromfraction_is_exact_boolean(self):\n        \"\"\"isExact must be a boolean value.\n\n        Derived from the implementation (r == 0 comparison).\n        \"\"\"\n        for num, den in [(1, 2), (1, 3)]:\n            f, e, p, isExact = BinaryFromFraction(num, den)\n            assert isinstance(isExact, bool)\n\n    def test_binaryfromfraction_large_numerator(self):\n        \"\"\"Large numerator should still produce a valid significand.\n\n        Invariant derived from the assertions in the source code.\n        \"\"\"\n        f, e, p, isExact = BinaryFromFraction(2 ** 60, 1)\n        assert 0 < f < 2 ** 52\n        assert p == 52\n\n    def test_binaryfromfraction_small_fraction_subnormal(self):\n        \"\"\"Very small fraction should exercise the subnormal path.\n\n        Expected values derived from the implementation invariants:\n        e must be >= MinExponent (-1022) after the subnormal loop, and\n        f must remain in [1, 2^52).\n        \"\"\"\n        f, e, p, isExact = BinaryFromFraction(1, 2 ** 2000)\n        assert 0 < f < 2 ** 52\n        assert e >= -1022\n        assert p >= 1",
