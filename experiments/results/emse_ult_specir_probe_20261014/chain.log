ue)\n    assert isinstance(result, str)\n    assert result == \"\"\n\n\n# ---------------------------------------------------------------------------\n# 边界用例\n# ---------------------------------------------------------------------------\n\ndef test_single_defcom_extract_negative_start_from():\n    \"\"\"start_from 为负数时从索引 0 开始扫描。\n\n    期望值来源：规约边界情况「start_from 为负数」。\n    负数索引 + 1 后循环起点落在有效范围内，仍能提取注释体。\n    \"\"\"\n    srcls = [\n        \"def foo():\",\n        '    \"\"\"',\n        \"    x\",\n        '    \"\"\"',\n    ]\n    result = single_defcom_extract(-1, srcls, False)\n    assert isinstance(result, str)\n    assert result == \"    x\\n\"\n\n\ndef test_single_defcom_extract_start_from_last_index():\n    \"\"\"start_from 等于 len(srcls)-1 时循环不执行，返回空字符串。\n\n    期望值来源：规约边界情况「start_from 等于或超过 len(srcls)-1（循环不执行）」。\n    \"\"\"\n    srcls = [\n        \"def foo():\",\n        '    \"\"\"',\n        \"    x\",\n        '    \"\"\"',\n    ]\n    result = single_defcom_extract(3, srcls, False)\n    assert isinstance(result, str)\n    assert result == \"\"\n\n\ndef test_single_defcom_extract_empty_srcls():\n    \"\"\"srcls 为空列表时返回空字符串。\n\n    期望值来源：规约边界情况「srcls 为空列表」。\n    \"\"\"\n    result = single_defcom_extract(0, [], False)\n    assert isinstance(result, str)\n    assert result == \"\"\n\n\ndef test_single_defcom_extract_unclosed_comment_block():\n    \"\"\"注释块未闭合（到列表末尾仍未遇到结束标记）时收集所有剩余行。\n\n    期望值来源：规约边界情况「注释块未闭合（到列表末尾仍未遇到结束标记）」。\n    期望值来源不明，需人工确认：拼接分隔符（换行 vs 直接连接）规约未明确，\n    此处仅断言返回值包含所有剩余行内容且为 str。\n    \"\"\"\n    srcls = [\n        \"def foo():\",\n        '    \"\"\"',\n        \"    line1\",\n        \"    line2\",\n    ]\n    result = single_defcom_extract(0, srcls, False)\n    assert isinstance(result, str)\n    # 期望值来源不明，需人工确认：仅断言内容被收集\n    assert \"line1\" in result\n    assert \"line2\" in result\n\n\ndef test_single_defcom_extract_start_from_beyond_length():\n    \"\"\"start_from 超出列表长度时返回空字符串。\n\n    期望值来源：规约边界情况「start_from 等于或超过 len(srcls)-1（循环不执行）」