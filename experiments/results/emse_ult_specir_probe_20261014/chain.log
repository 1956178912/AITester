assert sorted(result) == sorted(message)\n\n\ndef test_uoc_railfence_encrypt_hole_skips_position():\n    \"\"\"\n    洞位置应被跳过，不写入字符。\n    期望值来源：实现中 if pos not in holes 分支。\n    期望值来源不明，需人工确认：具体密文排列依赖 zigzag 与洞的交互。\n    \"\"\"\n    message = \"ABCD\"\n    holes = [(0, 0)]\n    result = uoc_railfence_encrypt(message, (2, holes))\n    # 仅断言长度与字符集合，避免臆造具体排列\n    assert len(result) == len(message)\n    assert sorted(result) == sorted(message)\n\n\ndef test_uoc_railfence_encrypt_message_shorter_than_rows():\n    \"\"\"\n    消息长度小于行数时的行为。\n    期望值来源：实现中 while 循环按字符数终止，应仍返回全部字符。\n    \"\"\"\n    message = \"AB\"\n    result = uoc_railfence_encrypt(message, (5, []))\n    assert sorted(result) == sorted(message)\n\n\ndef test_uoc_railfence_encrypt_single_character():\n    \"\"\"\n    单字符消息应返回该字符本身。\n    期望值来源：实现中仅一个字符被写入并读出。\n    \"\"\"\n    result = uoc_railfence_encrypt(\"X\", (3, []))\n    assert result == \"X\"\n\n\ndef test_uoc_railfence_encrypt_repeated_characters():\n    \"\"\"\n    重复字符消息应保持字符计数一致。\n    期望值来源：实现仅重排字符。\n    \"\"\"\n    message = \"AAAAABBBBB\"\n    result = uoc_railfence_encrypt(message, (3, []))\n    assert result.count(\"A\") == 5\n    assert result.count(\"B\") == 5\n    assert len(result) == 10\n\n\ndef test_uoc_railfence_encrypt_invalid_key_type_raises():\n    \"\"\"\n    非法 key 类型（非可索引）应抛出异常。\n    期望值来源：实现中 key[0]、key[1] 需要可索引对象。\n    \"\"\"\n    with pytest.raises(TypeError):\n        uoc_railfence_encrypt(\"HELLO\", 2)\n\n\ndef test_uoc_railfence_encrypt_zero_rows_raises():\n    \"\"\"\n    rows=0 时应抛出异常（无法构建矩阵或索引越界）。\n    期望值来源：实现中 rows-1 = -1 导致逻辑异常。\n    \"\"\"\n    with pytest.raises(Exception):\n        uoc_railfence_encrypt(\"HELLO\", (0, []))",
