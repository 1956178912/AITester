          "patch": "python\nimport random\n\n\ndef create_three_random_v_indices(current_vector_index, numOfPop):\n    # 合法索引范围为 [0, numOfPop-1]，排除 current_vector_index\n    candidates = [i for i in range(numOfPop) if i != current_vector_index]\n    if len(candidates) < 3:\n        raise ValueError(\n            \"numOfPop=%d is too small to pick 3 distinct indices \"\n            \"different from current_vector_index=%d\" % (numOfPop, current_vector_index)\n        )\n    v_index_1, v_index_2, v_index_3 = random.sample(candidates, 3)\n    #print \"v_index_1 = \" + str(v_index_1) + \"\\nv_index_2 = \" + str(v_index_2) + \"\\nv_index_3 = \" + str(v_index_3) + \"\\ncurrent_vector_index = \" + str(current_vector_index)\n    return v_index_1, v_index_2, v_index_3\n",
          "generated_test": "import pytest\n\nfrom create_three_random_v_indices import create_three_random_v_indices\n\n\ndef _assert_postconditions(result, current_vector_index, numOfPop):\n    \"\"\"辅助断言：验证规约中所有可判定的后置条件。\"\"\"\n    assert isinstance(result, tuple), \"返回值必须是元组\"\n    assert len(result) == 3, \"返回值长度必须为 3\"\n\n    v1, v2, v3 = result\n\n    # 均不等于 current_vector_index\n    assert v1 != current_vector_index\n    assert v2 != current_vector_index\n    assert v3 != current_vector_index\n\n    # 两两互异\n    assert v1 != v2\n    assert v1 != v3\n    assert v2 != v3\n\n    # 均在 [0, numOfPop] 闭区间内\n    assert 0 <= v1 <= numOfPop\n    assert 0 <= v2 <= numOfPop\n    assert 0 <= v3 <= numOfPop\n\n\ndef test_create_three_random_v_indices_normal_large_population():\n    \"\"\"正常路径：大种群随机采样。\n\n    期望值来源：规约后置条件（长度 3 元组、互异、不等于 current_vector_index、\n    均在 [0, numOfPop] 内）。\n    \"\"\"\n    current_vector_index = 5\n    numOfPop = 20\n\n    result = create_three_random_v_indices(current_vector_index, numOfPop)\n\n    _assert_postconditions(result, current_vector_index, numOfPop)\n\n\ndef test_create_three_random_v_indices_boundary_exact_three_candidates():\n    \"\"\"边界：numOfPop == 3 且 current_vector_index == 0。\n\n    期望值来源：规约边界情况——候选集合恰为 {0,1,2,3}，排除 0 后只剩 {1,2,3}，\n    输出必为 (1,2,3) 的某种排列。\n    \"\"\"\n    current_vector_index = 0\n    numOfPop = 3\n\n    result = create_three_random_v_indices(current_vector_index, numOfPop)\n\n    _assert_postconditions(result, current_vector_index, numOfPop)\n    assert sorted(result) == [1, 2, 3], \"候选集合恰为 {1,2,3}，输出必为其排列\"\n\n\ndef test_create_three_random_v_indices_boundary_current_index_equals_upper_bound():\n    \"\"\"边界：current_vector_index 取到闭区间上界。\n\n    期望值来源：规约后置条件（结果不含 10，均在 [0,10] 内）。\n    \"\"\"\n    current_vector_index = 10\n    numOfPop = 10\n\n    result = create_three_random_v_indices(current_vector_index, numOfPop)\n\n    _assert_postconditions(result, current_vector_index, numOfPop)\n\n\ndef test_create_three_random_v_indices_boundary_current_index_zero():\n    \"\"\"边界：current_vector_index 取下界 0。\n\n    期望值来源：规约后置条件（结果不含 0，均在 [0,10] 内）。\n    \"\"\"\n    current_vector_index = 0\n    numOfPop = 10\n\n    result = create_three_random_v_indices(current_vector_index, numOfPop)\n\n    _assert_postconditions(result, current_vector_index, numOfPop)\n\n\ndef test_create_three_random_v_indices_repeated_sampling_stability():\n    \"\"\"正常路径：重复调用多次，验证每次均满足后置条件。\n\n    期望值来源：规约后置条件（random.randint 返回重复值由 while 重采样处理，\n    属正常路径）。\n    \"\"\"\n    current_vector_index = 3\n    numOfPop = 8\n\n    for _ in range(50):\n        result = create_three_random_v_indices(current_vector_index, numOfPop)\n        _assert_postconditions(result, current_vector_index, numOfPop)\n\n\n@pytest.mark.timeout(5)\ndef test_create_three_random_v_indices_error_population_too_small():\n    \"\"\"异常：numOfPop < 3 违反前置条件，函数进入死循环不返回。\n\n    期望值来源：规约边界情况——numOfPop < 3 时无法选出 3 个互异索引，\n    函数死循环。期望值不明（代码无超时/异常处理），此处以超时方式断言，\n    需人工确认超时机制可用。\n    \"\"\"\n    with pytest.raises(Exception):\n        create_three_random_v_indices(0, 2)\n\n\n@pytest.mark.timeout(5)\ndef test_create_three_random_v_indices_error_current_index_out_of_range():\n    \"\"\"异常：current_vector_index 不在 [0, numOfPop] 内，违反前置条件，函数死循环。\n\n    期望值来源：规约边界情况——第一个 while 条件恒真，函数死循环。\n    期望值不明（代码无越界校验），此处以超时方式断言，需人工确认超时机制可用。\n    \"\"\"\n    with pytest.raises(Exception):\n        create_three_random_v_indices(5, 3)\n\n\n@pytest.mark.timeout(5)\ndef test_create_three_random_v_indices_error_population_zero():\n    \"\"\"异常：numOfPop == 0 违反前置条件，函数死循环。\n\n    期望值来源：规约边界情况——仅候选值 0，无法选出 3 个互异索引，死循环。\n    期望值不明（代码无异常抛出），此处以超时方式断言，需人工确认超时机制可用。\n    \"\"\"\n    with pytest.raises(Exception):\n        create_three_random_v_indices(0, 0)",
