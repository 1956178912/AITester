------------\n\ndef test_remove_strings_no_quotes_last_char_dropped():\n    \"\"\"无引号时字符保留，但循环上界为 len(code)-1，最后一个字符不处理。\n\n    期望值来源：测试计划 test_cases[2].expected_output。\n    \"\"\"\n    code = \"abc\"\n    result = remove_strings(code)\n    _assert_postconditions(code, result)\n    assert result == \"ab\"\n\n\ndef test_remove_strings_empty_string():\n    \"\"\"空字符串输入，循环不执行，返回空串。\n\n    期望值来源：测试计划 test_cases[3].expected_output。\n    \"\"\"\n    code = \"\"\n    result = remove_strings(code)\n    _assert_postconditions(code, result)\n    assert result == \"\"\n\n\ndef test_remove_strings_single_char_quote():\n    \"\"\"单字符输入为引号，range(0,0) 为空，循环不执行，返回空串。\n\n    期望值来源：测试计划 test_cases[4].expected_output。\n    \"\"\"\n    code = \"'\"\n    result = remove_strings(code)\n    _assert_postconditions(code, result)\n    assert result == \"\"\n\n\ndef test_remove_strings_escaped_single_quote():\n    \"\"\"反斜杠转义的引号不触发字符串态；最后一个字符因循环上界被丢弃。\n\n    期望值来源：测试计划 test_cases[5].expected_output。\n    \"\"\"\n    code = \"a = \\\\'b\\\\'\"\n    result = remove_strings(code)\n    _assert_postconditions(code, result)\n    assert result == \"a = \\\\'b\"\n\n\ndef test_remove_strings_trailing_quote_ignored():\n    \"\"\"最后一个字符为引号，因循环上界为 len(code)-1 而不被处理。\n\n    期望值来源：测试计划 test_cases[9].expected_output。\n    \"\"\"\n    code = \"ab'\"\n    result = remove_strings(code)\n    _assert_postconditions(code, result)\n    assert result == \"ab\"\n\n\n# ---------------------------------------------------------------------------\n# 异常 / 未闭合引号用例\n# ---------------------------------------------------------------------------\n\ndef test_remove_strings_unclosed_quote():\n    \"\"\"未闭合引号：进入字符串态后不再退出，后续字符全部被移除。\n\n    期望值来源：测试计划 test_cases[6].expected_output。\n    \"\"\"\n    code = \"a = 'hello\"\n    result = remove_strings(code)\n    _assert_postconditions(code, result)\n    assert result == \"a = '\"\n\n\n# ---------------------------------------------------------------------------\n# 探索性用例：规约未给出具体期望值，仅