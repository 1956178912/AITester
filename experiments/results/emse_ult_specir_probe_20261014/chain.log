          "patch": "python\nimport re\n\n\ndef fix_labels(header):\n\n    for i, label in enumerate(header):\n        if re.search(\"Unix\", label):\n            header[i] = \"Timestamp\"\n        if (re.search(\"Accel\", label) and re.search(\"X\", label)):\n            header[i] = \"Accel_X\"\n        if (re.search(\"Accel\", label) and re.search(\"Y\", label)):\n            header[i] = \"Accel_Y\"\n        if (re.search(\"Accel\", label) and re.search(\"Z\", label)):\n            header[i] = \"Accel_Z\"\n        if (re.search(\"Gyro\", label) and re.search(\"X\", label)):\n            header[i] = \"Gyro_X\"\n        if (re.search(\"Gyro\", label) and re.search(\"Y\", label)):\n            header[i] = \"Gyro_Y\"\n        if (re.search(\"Gyro\", label) and re.search(\"Z\", label)):\n            header[i] = \"Gyro_Z\"\n        if re.search(\"Pressure\", label):\n            header[i] = \"Pressure\"\n        if re.search(\"Temp\", label):\n            header[i] = \"Temperature\"\n        if re.search(\"GSR\", label):\n            header[i] = \"GSR\"\n\n    return header\n",
          "generated_test": "import pytest\n\nfrom fix_labels import fix_labels\n\n\n# ---------------------------------------------------------------------------\n# 边界用例\n# ---------------------------------------------------------------------------\n\ndef test_fix_labels_empty_list():\n    \"\"\"空列表：循环不执行，返回空列表（期望值来源：规约边界情况）。\"\"\"\n    header = []\n    result = fix_labels(header)\n    assert result == []\n    assert result is header\n\n\ndef test_fix_labels_empty_string_element():\n    \"\"\"空字符串元素：所有 re.search 均不匹配，保持原值（期望值来源：规约边界情况）。\"\"\"\n    header = [\"\"]\n    result = fix_labels(header)\n    assert result == [\"\"]\n    assert result is header\n\n\ndef test_fix_labels_no_match_keeps_original():\n    \"\"\"无匹配标签保持原值（期望值来源：规约后置条件）。\"\"\"\n    header = [\"Unknown\"]\n    result = fix_labels(header)\n    assert result == [\"Unknown\"]\n    assert result is header\n\n\ndef test_fix_labels_accel_without_axis_keeps_original():\n    \"\"\"含 Accel 但不含 X/Y/Z：不匹配任何 Accel 分支，保持原值（期望值来源：规约边界情况）。\"\"\"\n    header = [\"Accel\"]\n    result = fix_labels(header)\n    assert result == [\"Accel\"]\n    assert result is header\n\n\ndef test_fix_labels_gyro_without_axis_keeps_original():\n    \"\"\"含 Gyro 但不含 X/Y/Z：不匹配任何 Gyro 分支，保持原值（期望值来源：规约边界情况）。\"\"\"\n    header = [\"Gyro\"]\n    result = fix_labels(header)\n    assert result == [\"Gyro\"]\n    assert result is header\n\n\ndef test_fix_labels_case_sensitive_lowercase_unix():\n    \"\"\"大小写敏感：小写 unix 不匹配 Unix 正则，保持原值（期望值来源：规约边界情况）。\"\"\"\n    header = [\"unix\"]\n    result = fix_labels(header)\n    assert result == [\"unix\"]\n    assert result is header\n\n\ndef test_fix_labels_case_sensitive_lowercase_accel():\n    \"\"\"大小写敏感：小写 accel 不匹配 Accel 正则，保持原值（期望值来源：规约边界情况）。\"\"\"\n    header = [\"accel x\"]\n    result = fix_labels(header)\n    assert result == [\"accel x\"]\n    assert result is header\n\n\n# ---------------------------------------------------------------------------\n# 正常用例：单标签重命名\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\n    \"raw, expected\",\n    [\n        (\"Unix Timestamp\", \"Timestamp\"),\n        (\"Accel X\", \"Accel_X\"),\n        (\"Accel Y\", \"Accel_Y\"),\n        (\"Accel Z\", \"Accel_Z\"),\n        (\"Gyro X\", \"Gyro_X\"),\n        (\"Gyro Y\", \"Gyro_Y\"),\n        (\"Gyro Z\", \"Gyro_Z\"),\n        (\"Pressure\", \"Pressure\"),\n        (\"Temp\", \"Temperature\"),\n        (\"GSR\", \"GSR\"),\n    ],\n)\ndef test_fix_labels_single_label_rename(raw, expected):\n    \"\"\"单标签按规则重命名为标准标签（期望值来源：测试计划 normal 用例）。\"\"\"\n    header = [raw]\n    result = fix_labels(header)\n    assert result == [expected]\n    assert result is header\n\n\n# ---------------------------------------------------------------------------\n# 正常用例：多元素混合列表\n# ---------------------------------------------------------------------------\n\ndef test_fix_labels_mixed_list():\n    \"\"\"多元素列表中各元素独立按规则重命名（期望值来源：测试计划 normal 用例）。\"\"\"\n    header = [\"Unix Timestamp\", \"Accel X\", \"Gyro Z\", \"Pressure\", \"Unknown\"]\n    result = fix_labels(header)\n    assert result == [\"Timestamp\", \"Accel_X\", \"Gyro_Z\", \"Pressure\", \"Unknown\"]\n    assert result is header\n\n\n# ---------------------------------------------------------------------------\n# 后置条件 / 不变量\n# ---------------------------------------------------------------------------\n\ndef test_fix_labels_returns_same_object():\n    \"\"\"原地修改并返回同一列表对象（期望值来源：规约后置条件 result is header）。\"\"\"\n    header = [\"Unix\"]\n    result = fix_labels(header)\n    assert result is header\n    assert result == [\"Timestamp\"]\n\n\ndef test_fix_labels_length_invariant():\n    \"\"\"长度不变量：len(result) == len(header)（期望值来源：规约不变量）。\"\"\"\n    header = [\"Unix Timestamp\", \"Accel X\", \"Gyro Z\", \"Pressure\", \"Unknown\", \"\"]\n    original_len = len(header)\n    result = fix_labels(header)\n    assert len(result) == original_len\n    assert result is header\n\n\n# ---------------------------------------------------------------------------\n# 覆盖顺序（多关键词命中）\n# ---------------------------------------------------------------------------\n\ndef test_fix_labels_multi_keyword_override_order():\n    \"\"\"同一元素命中多个 if 时，最终值由最后一个命中的 if 决定。\n\n    期望值来源：规约边界情况（'Accel X Gyro Y' -> 'Gyro_Y'）。\n    \"\"\"\n    header = [\"Accel X Gyro Y\"]\n    result = fix_labels(header)\n    assert result == [\"Gyro_Y\"]\n    assert result is header\n\n\n# ---------------------------------------------------------------------------\n# 异常路径（前置条件不满足）\n# ---------------------------------------------------------------------------\n\ndef test_fix_labels_none_input_raises():\n    \"\"\"header 为 None 时违反前置条件，期望抛出异常。\n\n    期望值来源：规约前置条件要求 header 为可迭代序列；\n    具体异常类型未在规约中约定，故仅断言抛出异常（需人工确认具体类型）。\n    \"\"\"\n    with pytest.raises(Exception):\n        fix_labels(None)\n\n\ndef test_fix_labels_non_string_element_raises():\n    \"\"\"元素非字符串时违反前置条件，期望抛出异常。\n\n    期望值来源：规约前置条件要求元素为字符串；\n    具体异常类型未在规约中约定，故仅断言抛出异常（需人工确认具体类型）。\n    \"\"\"\n    with pytest.raises(Exception):\n        fix_labels([123])",
