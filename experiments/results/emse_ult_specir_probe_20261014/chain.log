          "generated_test": "import pytest\n\nfrom next_holiday import next_holiday\n\n\n# ---------------------------------------------------------------------------\n# 非法月份分支：规约明确给出期望值 ['invalid month', -1]\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\n    \"year, month, day\",\n    [\n        (2024, 0, 15),\n        (2024, 13, 1),\n        (2024, -1, 1),\n    ],\n)\ndef test_next_holiday_invalid_month_returns_sentinel(year, month, day):\n    \"\"\"月份非法（0 / 13 / 负数）时应返回 ['invalid month', -1]。\n\n    期望值来源：规约后置条件「月份非法时返回值等于 ['invalid month', -1]」。\n    \"\"\"\n    result = next_holiday(year, month, day)\n    assert result == [\"invalid month\", -1]\n\n\ndef test_next_holiday_invalid_month_result_shape():\n    \"\"\"非法月份返回值必须是长度为 2 的列表。\n\n    期望值来源：规约后置条件「返回值是长度为 2 的列表」。\n    \"\"\"\n    result = next_holiday(2024, 0, 15)\n    assert isinstance(result, list)\n    assert len(result) == 2\n\n\n# ---------------------------------------------------------------------------\n# 合法月份：规约只约束返回结构，未给出具体节日名称与天数\n# 因此使用探索性断言（记录实际行为），不臆造具体值\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\n    \"year, month, day\",\n    [\n        (2024, 6, 15),    # 正常日期_月中\n        (2024, 2, 28),    # 闰年（能被4整除不能被100整除）\n        (2000, 2, 28),    # 闰年（能被400整除）\n        (1900, 2, 28),    # 世纪年非闰年\n        (2023, 2, 28),    # 平年 2 月最后一天\n        (2024, 12, 31),   # 年末边界\n        (2024, 6, 0),     # day 为 0（非法日期，代码未显式处理）\n        (2024, 6, -5),    # day 为负数（非法日期，代码未显式处理）\n        (0, 1, 1),        # year 为 0\n        (-4, 1, 1),       # year 为负数\n    ],\n)\ndef test_next_holiday_valid_month_returns_two_element_list(year, month, day):\n    \"\"\"合法月份下返回值应为长度为 2 的列表，且第二项为 int。\n\n    期望值来源：规约后置条件\n      - isinstance(result, list) and len(result) == 2\n      - result == [\"invalid month\", -1] or isinstance(result[1], int)\n\n    注意：具体节日名称与 days_until 数值取决于被截断的节日分支逻辑，\n    规约未覆盖，故此