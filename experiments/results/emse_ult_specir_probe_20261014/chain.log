          "rag_stats": null,
          "patch": "python\ndef string_contrast(ss):\n    s = [item + 'q' for item in ss if item is not None]\n    short = min(s, key=len)\n    for ib in range(len(short)):\n        if not all([mc[ib] == short[ib] for mc in s]):\n            preidx = ib\n            break\n    else:\n        preidx = 0\n    for ib in range(len(short)):\n        ie = -1 * (ib + 1)\n        if not all([mc[ie] == short[ie] for mc in s]):\n            sufidx = ie + 1\n            break\n    else:\n        sufidx = -1\n\n    miditer = iter([mc[preidx:sufidx] for mc in s])\n    prefix = short[:preidx]\n    suffix = short[sufidx:-1]\n    middle = ['' if mc is None else next(miditer) for mc in ss]\n\n    return prefix, suffix, middle\n",
          "generated_test": "import pytest\n\nfrom string_contrast import string_contrast\n\n\n# ---------------------------------------------------------------------------\n# 正常用例：期望值来自规约推导（公共前后缀 + 中段切片）\n# ---------------------------------------------------------------------------\n\ndef test_string_contrast_two_strings_common_prefix_suffix():\n    \"\"\"两元素均非 None，公共前缀 'ab'，公共后缀 'de'，中段 'c' 与 'x'。\n\n    期望值来源：规约后置条件（prefix 为 short 前缀、suffix 为 short 去掉末位\n    的后缀、middle 为去掉公共前后缀后的中段）推导得出。\n    \"\"\"\n    result = string_contrast([\"abcde\", \"abxde\"])\n    assert isinstance(result, tuple)\n    assert len(result) == 3\n    prefix, suffix, middle = result\n    assert prefix == \"ab\"\n    assert suffix == \"de\"\n    assert middle == [\"c\", \"x\"]\n\n\ndef test_string_contrast_with_none_element():\n    \"\"\"含 None 元素时，None 位置输出 ''，且不参与比较。\n\n    期望值来源：规约边界情况「元素含 None 与非 None 混合：None 位置输出 ''」。\n    \"\"\"\n    result = string_contrast([\"abcde\", None, \"abxde\"])\n    assert len(result) == 3\n    prefix, suffix, middle = result\n    assert prefix == \"ab\"\n    assert suffix == \"de\"\n    assert middle == [\"c\", \"\", \"x\"]\n\n\n# ---------------------------------------------------------------------------\n# 边界用例\n# ---------------------------------------------------------------------------\n\ndef test_string_contrast_single_element():\n    \"\"\"单元素：preidx=0，sufidx=-len(short)，middle 为该元素去掉末位 'q'。\n\n    期望值来源：规约边界情况「ss 只有一个非 None 元素」。\n    \"\"\"\n    result = string_contrast([\"abc\"])\n    assert len(result) == 3\n    prefix, suffix, middle = result\n    assert prefix == \"\"\n    assert suffix == \"ab\"\n    assert middle == [\"c\"]\n\n\ndef test_string_contrast_all_elements_identical():\n    \"\"\"所有元素相同：前缀与后缀循环均走 else，preidx=0，sufidx=-len(short)。\n\n    期望值来源：规约边界情况「所有元素完全相同」。\n    \"\"\"\n    result = string_contrast([\"abc\", \"abc\"])\n    assert len(result) == 3\n    prefix, suffix, middle = result\n    assert prefix == \"\"\n    assert suffix == 