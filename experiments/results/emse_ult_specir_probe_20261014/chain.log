          "generated_test": "import pytest\n\nfrom deg2HMS import deg2HMS\n\n\n# ---------------------------------------------------------------------------\n# 正常路径：仅传 dec / 仅传 ra / 两者均传\n# ---------------------------------------------------------------------------\n\ndef test_deg2HMS_only_dec_returns_str():\n    \"\"\"仅传 dec 时应返回字符串（后置条件：仅一个非 None 返回对应字符串）。\"\"\"\n    result = deg2HMS(dec=30.5)\n    assert isinstance(result, str)\n\n\ndef test_deg2HMS_only_ra_returns_str():\n    \"\"\"仅传 ra 时应返回字符串（后置条件：仅一个非 None 返回对应字符串）。\"\"\"\n    result = deg2HMS(ra=120.0)\n    assert isinstance(result, str)\n\n\ndef test_deg2HMS_both_returns_tuple():\n    \"\"\"ra 与 dec 均非 None 时应返回二元元组 (RA, DEC)。\"\"\"\n    result = deg2HMS(ra=120.0, dec=30.5)\n    assert isinstance(result, tuple)\n    assert len(result) == 2\n    assert isinstance(result[0], str)\n    assert isinstance(result[1], str)\n\n\ndef test_deg2HMS_both_tuple_matches_individual_calls():\n    \"\"\"两者均传时返回的元组元素应与分别单独调用结果一致。\"\"\"\n    ra_str = deg2HMS(ra=120.0)\n    dec_str = deg2HMS(dec=30.5)\n    result = deg2HMS(ra=120.0, dec=30.5)\n    assert result == (ra_str, dec_str)\n\n\n# ---------------------------------------------------------------------------\n# 边界：两者均为 None\n# ---------------------------------------------------------------------------\n\ndef test_deg2HMS_both_none_returns_empty_string():\n    \"\"\"ra 与 dec 均为 None 时应返回空字符串 ''。\"\"\"\n    result = deg2HMS()\n    assert result == \"\"\n\n\ndef test_deg2HMS_explicit_none_returns_empty_string():\n    \"\"\"显式传入 ra=None, dec=None 时应返回空字符串 ''。\"\"\"\n    result = deg2HMS(ra=None, dec=None)\n    assert result == \"\"\n\n\n# ---------------------------------------------------------------------------\n# 边界：零值\n# ---------------------------------------------------------------------------\n\ndef test_deg2HMS_ra_zero_returns_str():\n    \"\"\"ra=0 边界值，应返回字符串（后置条件：仅一个非 None 返回字符串）。\"\"\"\n    result = deg2HMS(ra=0)\n    assert isinstance(result, str)\n\n\ndef test_deg2HMS_dec_zero_returns_str():\n    \"\"\"dec=0 边界值，应返回字符串（后置条件：仅一个非 None 返回字符串）。\"\"\"\n    result = deg2HMS(dec=0)\n    assert isinstance(result, str)\n\n\n# ---------------------------------------------------------------------------\n# 边界：负数（符号处理）\n# ---------------------------------------------------------------------------\n\ndef test_deg2HMS_negative_dec_returns_str():\n    \"\"\"dec 为负数时应返回字符串，且符号处理不抛异常。\"\"\"\n    result = deg2HMS(dec=-30.5)\n    assert isinstance(result, str)\n\n\ndef test_deg2HMS_negative_ra_returns_str():\n    \"\"\"ra 为负数时应返回字符串，且符号处理不抛异常。\"\"\"\n    result = deg2HMS(ra=-120.0)\n    assert isinstance(result, str)\n\n\n# ---------------------------------------------------------------------------\n# round 参数：True / False 的秒值差异\n# ---------------------------------------------------------------------------\n\ndef test_deg2HMS_round_true_returns_str():\n    \"\"\"round=True 时应返回字符串（后置条件：仅一个非 None 返回字符串）。\"\"\"\n    result = deg2HMS(dec=30.5, round=True)\n    assert isinstance(result, str)\n\n\ndef test_deg2HMS_round_false_returns_str():\n    \"\"\"round=False 时应返回字符串（后置条件：仅一个非 None 返回字符串）。\"\"\"\n    result = deg2HMS(dec=30.5, round=False)\n    assert isinstance(result, str)\n\n\ndef test_deg2HMS_round_true_vs_false_differ_in_seconds():\n    \"\"\"round=True 与 round=False 的秒值表示应存在差异（秒取整 vs 浮点）。\n\n    期望值来源：规约中\"round=True 与 round=False 的秒值差异\"边界情况。\n    具体秒值格式未在规约中给出，故仅断言两者字符串不同。\n    \"\"\"\n    rounded = deg2HMS(dec=30.5, round=True)\n    unrounded = deg2HMS(dec=30.5, round=False)\n    assert rounded != unrounded\n\n\ndef test_deg2HMS_round_true_both_returns_tuple():\n    \"\"\"round=True 且两者均传时仍返回二元元组。\"\"\"\n    result = deg2HMS(ra=120.0, dec=30.5, round=True)\n    assert isinstance(result, tuple)\n    assert len(result) == 2\n\n\n# ---------------------------------------------------------------------------\n# 边界：极大值与浮点小数\n# ---------------------------------------------------------------------------\n\ndef test_deg2HMS_large_ra_returns_str():\n    \"\"\"ra 为极大值时仍应返回字符串，不抛异常。\"\"\"\n    result = deg2HMS(ra=360.0)\n    assert isinstance(result, str)\n\n\ndef test_deg2HMS_large_dec_returns_str():\n    \"\"\"dec 为极大值时仍应返回字符串，不抛异常。\"\"\"\n    result = deg2HMS(dec=90.0)\n    assert isinstance(result, str)\n\n\ndef test_deg2HMS_fractional_values_return_str():\n    \"\"\"ra/dec 为浮点小数时应返回字符串。\"\"\"\n    result = deg2HMS(ra=123.456, dec=-45.678)\n    assert isinstance(result, tuple)\n    assert len(result) == 2\n\n\n# ---------------------------------------------------------------------------\n# 错误路径：非数值类型输入\n# ---------------------------------------------------------------------------\n\ndef test_deg2HMS_ra_non_numeric_raises():\n    \"\"\"ra 为非数值类型（字符串）时应抛出异常。\n\n    期望值来源：规约前置条件\"ra/dec 为数值类型以便参与算术运算\"。\n    具体异常类型未在规约中明确，故接受 TypeError 或 ValueError。\n    \"\"\"\n    with pytest.raises((TypeError, ValueError)):\n        deg2HMS(ra=\"abc\")\n\n\ndef test_deg2HMS_dec_non_numeric_raises():\n    \"\"\"dec 为非数值类型（字符串）时应抛出异常。\n\n    期望值来源：规约前置条件\"ra/dec 为数值类型以便参与算术运算\"。\n    具体异常类型未在规约中明确，故接受 TypeError 或 ValueError。\n    \"\"\"\n    with pytest.raises((TypeError, ValueError)):\n        deg2HMS(dec=\"abc\")\n\n\n# ---------------------------------------------------------------------------\n# 探索性：字符串格式（期望值来源不明，需人工确认）\n# ---------------------------------------------------------------------------\n\ndef test_deg2HMS_dec_format_exploratory():\n    \"\"\"探索性：记录 dec=30.5 的实际字符串格式。\n\n    期望值来源不明，需人工确认。仅断言返回类型为 str。\n    \"\"\"\n    result = deg2HMS(dec=30.5)\n    assert isinstance(result, str)\n\n\ndef test_deg2HMS_ra_format_exploratory():\n    \"\"\"探索性：记录 ra=120.0 的实际字符串格式。\n\n    期望值来源不明，需人工确认。仅断言返回类型为 str。\n    \"\"\"\n    result = deg2HMS(ra=120.0)\n    assert isinstance(result, str)",
