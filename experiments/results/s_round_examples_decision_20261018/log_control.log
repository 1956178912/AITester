1, 3, 5, 7]\n        assert find_in_sorted(arr, 4) == -1\n\n    def test_find_in_sorted_negative_target_miss(self):\n        \"\"\"负数目标未命中，应返回 -1。\"\"\"\n        arr = [-5, -3, 0, 2]\n        assert find_in_sorted(arr, -4) == -1\n\n\nclass TestFindInSortedPostconditions:\n    \"\"\"后置条件测试：返回值范围与命中一致性。\"\"\"\n\n    @pytest.mark.parametrize(\n        \"arr, x\",\n        [\n            ([1, 3, 5, 7, 9], 5),\n            ([1, 3, 5, 7, 9], 1),\n            ([1, 3, 5, 7, 9], 9),\n            ([3, 4, 5, 5, 5, 5, 6], 5),\n            ([], 1),\n            ([5], 5),\n            ([5], 3),\n            ([10, 20, 30], 5),\n            ([10, 20, 30], 35),\n            ([1, 3, 5, 7], 4),\n            ([-5, -3, 0, 2], -4),\n            ([-5, -3, 0, 2], -3),\n        ],\n    )\n    def test_find_in_sorted_postconditions(self, arr, x):\n        \"\"\"返回值必须在 [-1, len(arr)) 范围内，且命中时 arr[result] == x。\"\"\"\n        result = find_in_sorted(arr, x)\n        assert -1 <= result < len(arr)\n        if result != -1:\n            assert arr[result] == x\n        else:\n            assert x not in arr\n\n\n# SpecIR v2 确定性 oracle（compile_readiness=1.00）\nimport pytest\nfrom find_in_sorted import find_in_sorted\n\ndef test_specir_v2_oracle():\n    try:\n        arr, x = 0, 0\n        # [未断言·无满足前件的见证] # pre: all(arr[i] <= arr[i + 1] for i in range(len(arr) - 1))\n        # [未断言·无满足前件的见证] assert all(arr[i] <= arr[i + 1] for i in range(len(arr) - 1))\n        r = find_in_sorted(arr, x)\n        # post: result == -1 or arr[result] == x\n        assert r == -1 or arr[r] == x\n        # post: -1 <= result < len(arr)\n        assert -1 <= r < len(arr)\n        # invariant: 0 <= result < len(arr) or result == -1\n        assert 0 <= r < len(arr) or r == -1\n    except AssertionError:\n        # 断言失败 = oracle 的语义判定信号，必须保留为 fail（不得 skip）\n        raise\n    except Exception as exc:\n        pytest.skip(f\"oracle-unavailable: {type(exc).__name__}: {exc}\")",
