arch_cycle_reachable(node_a, node_b, node_c):\n    \"\"\"含环图可达：图中存在环但目标可达，应返回 True。\"\"\"\n    node_a.successors = [node_b]\n    node_b.successors = [node_a, node_c]\n    node_c.successors = []\n    assert depth_first_search(node_a, node_c) is True\n\n\ndef test_depth_first_search_returns_bool(node_a, node_b):\n    \"\"\"返回值类型应为 bool（后置条件 isinstance(result, bool)）。\"\"\"\n    node_a.successors = [node_b]\n    result = depth_first_search(node_a, node_b)\n    assert isinstance(result, bool)\n\n\ndef test_depth_first_search_does_not_modify_graph(node_a, node_b, node_c):\n    \"\"\"函数不修改图结构：调用前后 successors 保持不变。\"\"\"\n    node_a.successors = [node_b]\n    node_b.successors = [node_c]\n    node_c.successors = []\n    before = (list(node_a.successors), list(node_b.successors), list(node_c.successors))\n    depth_first_search(node_a, node_c)\n    after = (list(node_a.successors), list(node_b.successors), list(node_c.successors))\n    assert before == after\n\n\n# SpecIR v2 确定性 oracle（compile_readiness=1.00）\nimport pytest\nfrom depth_first_search import depth_first_search\n\ndef test_specir_v2_oracle():\n    try:\n        startnode, goalnode = 0, 0\n        # [未断言·无满足前件的见证] # pre: startnode is not None\n        # [未断言·无满足前件的见证] assert startnode is not None\n        # [未断言·无满足前件的见证] # pre: goalnode is not None\n        # [未断言·无满足前件的见证] assert goalnode is not None\n        r = depth_first_search(startnode, goalnode)\n        # post: isinstance(result, bool)\n        assert isinstance(r, bool)\n    except AssertionError:\n        # 断言失败 = oracle 的语义判定信号，必须保留为 fail（不得 skip）\n        raise\n    except Exception as exc:\n        pytest.skip(f\"oracle-unavailable: {type(exc).__name__}: {exc}\")",
