          "rag_stats": null,
          "patch": "```python\ndef levenshtein(source, target):\n    if source == '' or target == '':\n        return len(source) or len(target)\n\n    elif source[0] == target[0]:\n        return levenshtein(source[1:], target[1:])\n\n    else:\n        return 1 + min(\n            levenshtein(source,     target[1:]),\n            levenshtein(source[1:], target[1:]),\n            levenshtein(source[1:], target)\n        )\n\n\"\"\"\nLevenshtein Distance\n\n\nCalculates the Levenshtein distance between two strings.  The Levenshtein distance is defined as the minimum amount of single-character edits (either removing a character, adding a character, or changing a character) necessary to transform a source string into a target string.\n\nInput:\n    source: The string you begin with.\n    target: The string to transform into.\n\nOutput:\n    The Levenshtein distance between the source and target.\n\nExample:\n    electron can be transformed into neutron by removing the e, turning the l into n, and turning the c into u.\n    >>> levenshtein(electron, neutron)\n    3\n\"\"\"\n```",
          "generated_test": "import pytest\n\nfrom levenshtein import levenshtein\n\n\nclass TestLevenshteinNormal:\n    \"\"\"正常用例：覆盖递归主分支。\"\"\"\n\n    def test_levenshtein_identical_strings(self):\n        \"\"\"相同字符串编辑距离为 0，覆盖 source[0]==target[0] 递归分支。\"\"\"\n        assert levenshtein(\"abc\", \"abc\") == 0\n\n    def test_levenshtein_single_char_substitution(self):\n        \"\"\"单字符不同需一次替换，覆盖 else 分支。\"\"\"\n        assert levenshtein(\"a\", \"b\") == 1\n\n    def test_levenshtein_docstring_example_electron_neutron(self):\n        \"\"\"验证 docstring 给出的示例结果 3。\"\"\"\n        assert levenshtein(\"electron\", \"neutron\") == 3\n\n\nclass TestLevenshteinBoundary:\n    \"\"\"边界用例：空串、单字符、长度差异等。\"\"\"\n\n    def test_levenshtein_empty_source(self):\n        \"\"\"source 为空串时返回 len(target)。\"\"\"\n        assert levenshtein(\"\", \"abc\") == 3\n\n    def test_levenshtein_empty_target(self):\n        \"\"\"target 为空串时返回 len(source)。\"\"\"\n        assert levenshtein(\"abc\", \"\") == 3\n\n    def test_levenshtein_both_empty(self):\n        \"\"\"双空串边界，返回 0。\"\"\"\n        assert levenshtein(\"\", \"\") == 0\n\n    def test_levenshtein_single_char_same(self):\n        \"\"\"最小非空输入且相同，返回 0。\"\"\"\n        assert levenshtein(\"a\", \"a\") == 0\n\n    def test_levenshtein_single_char_vs_empty(self):\n        \"\"\"单字符对空串，距离为 1。\"\"\"\n        assert levenshtein(\"a\", \"\") == 1\n\n    def test_levenshtein_large_length_difference(self):\n        \"\"\"长度差异大，距离等于长度差。\"\"\"\n        assert levenshtein(\"a\", \"abcdefghij\") == 9\n\n\nclass TestLevenshteinPostconditions:\n    \"\"\"后置条件：返回值范围与对称性等性质。\"\"\"\n\n    @pytest.mark.parametrize(\n        \"source,target\",\n        [\n            (\"abc\", \"abc\"),\n            (\"a\", \"b\"),\n            (\"electron\", \"neutron\"),\n            (\"\", \"abc\"),\n            (\"abc\", \"\"),\n            (\"\", \"\"),\n            (\"a\", \"abcdefghij\"),\n            (\"kitten\", \"sitting\"),\n            (\"aaaa\", \"aa\"),\n        ],\n    )\n    def test_levenshtein_result_non_negative_and_bounded(self, source, target):\n        \"\"\"返回值应为非负整数且不超过 max(len(source), len(target))。\"\"\"\n        result = levenshtein(source, target)\n        assert isinstance(result, int)\n        assert result >= 0\n        assert result <= max(len(source), len(target))\n\n    @pytest.mark.parametrize(\n        \"source,target\",\n        [\n            (\"abc\", \"abc\"),\n            (\"a\", \"b\"),\n            (\"electron\", \"neutron\"),\n            (\"kitten\", \"sitting\"),\n            (\"aaaa\", \"aa\"),\n        ],\n    )\n    def test_levenshtein_symmetric(self, source, target):\n        \"\"\"编辑距离应对称：d(source, target) == d(target, source)。\"\"\"\n        assert levenshtein(source, target) == levenshtein(target, source)\n\n\nclass TestLevenshteinErrors:\n    \"\"\"异常用例：非字符串输入。期望值来源不明，需人工确认。\"\"\"\n\n    def test_levenshtein_non_string_source(self):\n        \"\"\"非字符串 source 应抛异常。\n\n        期望值来源不明，需人工确认：代码未做类型校验，\n        传入 int 会在 source[0] 或 len 处抛异常，具体异常类型未在 docstring 约定。\n        \"\"\"\n        with pytest.raises(Exception):\n            levenshtein(123, \"abc\")\n\n    def test_levenshtein_none_source(self):\n        \"\"\"None 作为 source 应抛异常。\n\n        期望值来源不明，需人工确认：None 与 '' 比较为 False，\n        随后 None[0] 抛 TypeError，异常类型未约定。\n        \"\"\"\n        with pytest.raises(Exception):\n            levenshtein(None, \"abc\")\n\n\n# SpecIR v2 确定性 oracle（compile_readiness=1.00）\nimport pytest\nfrom levenshtein import levenshtein\n\ndef test_specir_v2_oracle():\n    try:\n        source, target = 0, 0\n        # [未断言·无满足前件的见证] # pre: isinstance(source, str) and isinstance(target, str)\n        # [未断言·无满足前件的见证] assert isinstance(source, str) and isinstance(target, str)\n        r = levenshtein(source, target)\n        # post: result >= 0\n        assert r >= 0\n        # post: result <= max(len(source), len(target))\n        assert r <= max(len(source), len(target))\n        # post: source != target or result == 0\n        assert source != target or r == 0\n        # post: source != \"\" or result == len(target)\n        assert source != \"\" or r == len(target)\n        # post: target != \"\" or result == len(source)\n        assert target != \"\" or r == len(source)\n    except AssertionError:\n        # 断言失败 = oracle 的语义判定信号，必须保留为 fail（不得 skip）\n        raise\n    except Exception as exc:\n        pytest.skip(f\"oracle-unavailable: {type(exc).__name__}: {exc}\")",
