          "generated_test": "import pytest\n\nfrom breadth_first_search import breadth_first_search\n\n\nclass Node:\n    \"\"\"Simple directed graph node with successors and identity-based equality.\"\"\"\n\n    def __init__(self, name):\n        self.name = name\n        self.successors = []\n\n    def __repr__(self):\n        return f\"Node({self.name!r})\"\n\n\ndef make_node(name, successors=None):\n    n = Node(name)\n    if successors:\n        n.successors = list(successors)\n    return n\n\n\ndef test_breadth_first_search_start_is_goal_returns_true():\n    \"\"\"startnode is goalnode -> True (docstring: reachable).\"\"\"\n    a = make_node(\"a\")\n    result = breadth_first_search(a, a)\n    assert result is True\n\n\ndef test_breadth_first_search_direct_successor_returns_true():\n    \"\"\"a -> b, goal b reachable -> True.\"\"\"\n    b = make_node(\"b\")\n    a = make_node(\"a\", [b])\n    result = breadth_first_search(a, b)\n    assert result is True\n\n\ndef test_breadth_first_search_multi_hop_returns_true():\n    \"\"\"a -> b -> c, goal c reachable -> True.\"\"\"\n    c = make_node(\"c\")\n    b = make_node(\"b\", [c])\n    a = make_node(\"a\", [b])\n    result = breadth_first_search(a, b if False else c)\n    assert result is True\n\n\ndef test_breadth_first_search_cycle_reachable_returns_true():\n    \"\"\"a -> b -> a cycle, plus b -> c; goal c reachable -> True.\"\"\"\n    a = make_node(\"a\")\n    b = make_node(\"b\")\n    c = make_node(\"c\")\n    a.successors = [b]\n    b.successors = [a, c]\n    result = breadth_first_search(a, c)\n    assert result is True\n\n\ndef test_breadth_first_search_duplicate_successors_returns_true():\n    \"\"\"Multiple paths share successor d; goal d reachable -> True.\"\"\"\n    d = make_node(\"d\")\n    b = make_node(\"b\", [d])\n    c = make_node(\"c\", [d])\n    a = make_node(\"a\", [b, c])\n    result = breadth_first_search(a, d)\n    assert result is True\n\n\ndef test_breadth_first_search_unreachable_returns_false():\n    \"\"\"goal z not in graph -> must return False (docstring contract).\n\n    Expected value source: docstring \"Whether goalnode is reachable from\n    startnode\" -> unreachable must yield False.\n    \"\"\"\n    a = make_node(\"a\")\n    z = make_node(\"z\")\n    result = breadth_first_search(a, z)\n    assert result is False\n\n\ndef test_breadth_first_search_no_successors_non_goal_returns_false():\n    \"\"\"startnode has no successors and is not goal -> must return False.\n\n    Expected value source: docstring reachability contract.\n    \"\"\"\n    a = make_node(\"a\")\n    b = make_node(\"b\")\n    result = breadth_first_search(a, b)\n    assert result is False\n\n\ndef test_breadth_first_search_value_equal_but_not_identical_returns_false():\n    \"\"\"Two distinct nodes with equal name; identity comparison must not match.\n\n    Expected value source: docstring says reachable via graph edges; clone\n    is not reachable, so result must be False.\n    \"\"\"\n    a = make_node(\"a\")\n    a_clone = make_node(\"a\")\n    result = breadth_first_search(a, a_clone)\n    assert result is False\n\n\ndef test_breadth_first_search_returns_bool_type():\n    \"\"\"Return value must be a bool instance (postcondition).\"\"\"\n    a = make_node(\"a\")\n    result = breadth_first_search(a, a)\n    assert isinstance(result, bool)\n\n\ndef test_breadth_first_search_unreachable_returns_bool_not_none():\n    \"\"\"Unreachable case must return a bool, not None (kills return_void mutant).\"\"\"\n    a = make_node(\"a\")\n    z = make_node(\"z\")\n    result = breadth_first_search(a, z)\n    assert result is not None\n    assert isinstance(result, bool)\n    assert result is False\n\n\ndef test_breadth_first_search_unreachable_not_empty_container():\n    \"\"\"Unreachable case must return False, not an empty container (kills return_empty mutant).\"\"\"\n    a = make_node(\"a\")\n    z = make_node(\"z\")\n    result = breadth_first_search(a, z)\n    assert result is False\n    assert not (isinstance(result, (list, tuple, dict, set)) and len(result) == 0)\n\n\ndef test_breadth_first_search_does_not_modify_successors():\n    \"\"\"Function must not mutate input node successors (postcondition).\"\"\"\n    b = make_node(\"b\")\n    a = make_node(\"a\", [b])\n    original = list(a.successors)\n    breadth_first_search(a, b)\n    assert a.successors == original\n\n\n# SpecIR v2 确定性 oracle（compile_readiness=0.83）\nimport pytest\nfrom breadth_first_search import breadth_first_search\n\ndef test_specir_v2_oracle():\n    try:\n        startnode, goalnode = 0, 0\n        # [未断言·无满足前件的见证] # pre: startnode is not None\n        # [未断言·无满足前件的见证] assert startnode is not None\n        # [未断言·无满足前件的见证] # pre: goalnode is not None\n        # [未断言·无满足前件的见证] assert goalnode is not None\n        # [未断言·无满足前件的见证] # pre: hasattr(startnode, \"successors\")\n        # [未断言·无满足前件的见证] assert hasattr(startnode, \"successors\")\n        # [未断言·无满足前件的见证] # pre: hasattr(goalnode, \"successors\")\n        # [未断言·无满足前件的见证] assert hasattr(goalnode, \"successors\")\n        r = breadth_first_search(startnode, goalnode)\n        # post: isinstance(result, bool)\n        assert isinstance(r, bool)\n        # NL provenance (uncompiled post): len(nodesseen) >= 1\n    except AssertionError:\n        # 断言失败 = oracle 的语义判定信号，必须保留为 fail（不得 skip）\n        raise\n    except Exception as exc:\n        pytest.skip(f\"oracle-unavailable: {type(exc).__name__}: {exc}\")",
