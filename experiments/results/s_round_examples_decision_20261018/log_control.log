          "rag_stats": null,
          "patch": "```python\ndef detect_cycle(node):\n    hare = tortoise = node\n\n    while True:\n        if hare.successor is None:\n            return False\n\n        tortoise = tortoise.successor\n        hare = hare.successor.successor\n\n        if hare is None:\n            return False\n\n        if hare is tortoise:\n            return True\n\n\n\n\"\"\"\nLinked List Cycle Detection\ntortoise-hare\n\nImplements the tortoise-and-hare method of cycle detection.\n\nInput:\n    node: The head node of a linked list\n\nOutput:\n    Whether the linked list is cyclic\n\"\"\"\n```",
          "generated_test": "import pytest\n\nfrom detect_cycle import detect_cycle\n\n\nclass Node:\n    \"\"\"单链表节点，具备 successor 属性。\"\"\"\n\n    def __init__(self, value=None):\n        self.value = value\n        self.successor = None\n\n    def __repr__(self):\n        return f\"Node({self.value!r})\"\n\n\ndef _build_chain(values):\n    \"\"\"根据值列表构建无环单链表，返回头节点。\"\"\"\n    nodes = [Node(v) for v in values]\n    for i in range(len(nodes) - 1):\n        nodes[i].successor = nodes[i + 1]\n    return nodes[0] if nodes else None\n\n\ndef test_detect_cycle_empty_list_raises_attribute_error():\n    \"\"\"空链表（node=None）：代码未做判空，访问 hare.successor 抛 AttributeError。\n\n    期望值来源：测试计划标注为异常路径，代码未对 None 判空。\n    \"\"\"\n    with pytest.raises(AttributeError):\n        detect_cycle(None)\n\n\ndef test_detect_cycle_single_node_no_cycle_returns_false():\n    \"\"\"单节点且 successor 为 None：应立即返回 False（布尔语义校验）。\"\"\"\n    node = Node(\"A\")\n    result = detect_cycle(node)\n    assert result is False\n    assert isinstance(result, bool)\n\n\ndef test_detect_cycle_single_node_self_loop_returns_true():\n    \"\"\"单节点自环：successor 指向自身，应返回 True（布尔语义校验）。\"\"\"\n    node = Node(\"A\")\n    node.successor = node\n    result = detect_cycle(node)\n    assert result is True\n    assert isinstance(result, bool)\n\n\ndef test_detect_cycle_two_nodes_mutual_cycle_returns_true():\n    \"\"\"两节点互指成环 A->B->A：应返回 True。\"\"\"\n    a = Node(\"A\")\n    b = Node(\"B\")\n    a.successor = b\n    b.successor = a\n    result = detect_cycle(a)\n    assert result is True\n    assert isinstance(result, bool)\n\n\ndef test_detect_cycle_two_nodes_no_cycle_returns_false():\n    \"\"\"两节点无环 A->B->None：应返回 False。\"\"\"\n    head = _build_chain([\"A\", \"B\"])\n    result = detect_cycle(head)\n    assert result is False\n    assert isinstance(result, bool)\n\n\ndef test_detect_cycle_long_chain_no_cycle_returns_false():\n    \"\"\"长链无环 A->B->C->D->None：应返回 False。\"\"\"\n    head = _build_chain([\"A\", \"B\", \"C\", \"D\"])\n    result = detect_cycle(head)\n    assert result is False\n    assert isinstance(result, bool)\n\n\ndef test_detect_cycle_three_nodes_no_cycle_returns_false():\n    \"\"\"三节点无环 A->B->C->None：hare 前进两步后 successor 为 None，应返回 False。\"\"\"\n    head = _build_chain([\"A\", \"B\", \"C\"])\n    result = detect_cycle(head)\n    assert result is False\n    assert isinstance(result, bool)\n\n\ndef test_detect_cycle_tail_cycle_returns_true():\n    \"\"\"尾部成环 A->B->C->D->B：应返回 True。\"\"\"\n    a = Node(\"A\")\n    b = Node(\"B\")\n    c = Node(\"C\")\n    d = Node(\"D\")\n    a.successor = b\n    b.successor = c\n    c.successor = d\n    d.successor = b\n    result = detect_cycle(a)\n    assert result is True\n    assert isinstance(result, bool)\n\n\ndef test_detect_cycle_node_without_successor_raises_attribute_error():\n    \"\"\"node 无 successor 属性：访问 hare.successor 抛 AttributeError。\n\n    期望值来源：测试计划标注为异常路径，代码未做类型校验。\n    \"\"\"\n\n    class NoSuccessor:\n        pass\n\n    with pytest.raises(AttributeError):\n        detect_cycle(NoSuccessor())\n\n\n@pytest.mark.parametrize(\n    \"values, expected\",\n    [\n        ([\"A\"], False),\n        ([\"A\", \"B\"], False),\n        ([\"A\", \"B\", \"C\"], False),\n        ([\"A\", \"B\", \"C\", \"D\"], False),\n        ([\"A\", \"B\", \"C\", \"D\", \"E\"], False),\n    ],\n)\ndef test_detect_cycle_various_acyclic_chains_return_false(values, expected):\n    \"\"\"多种长度的无环链均应返回 False（布尔语义校验，杀死 not 变异体）。\"\"\"\n    head = _build_chain(values)\n    result = detect_cycle(head)\n    assert result is expected\n    assert result is False\n    assert isinstance(result, bool)\n\n\n@pytest.mark.parametrize(\n    \"length, loop_to_index\",\n    [\n        (1, 0),\n        (2, 0),\n        (2, 1),\n        (3, 0),\n        (3, 1),\n        (4, 1),\n        (5, 2),\n    ],\n)\ndef test_detect_cycle_various_cyclic_chains_return_true(length, loop_to_index):\n    \"\"\"多种长度与环入口位置的环链均应返回 True（布尔语义校验，杀死 not 变异体）。\"\"\"\n    nodes = [Node(i) for i in range(length)]\n    for i in range(length - 1):\n        nodes[i].successor = nodes[i + 1]\n    nodes[-1].successor = nodes[loop_to_index]\n    result = detect_cycle(nodes[0])\n    assert result is True\n    assert isinstance(result, bool)\n\n\ndef test_detect_cycle_return_type_is_strict_bool():\n    \"\"\"返回值必须是严格的 bool 类型（True/False），而非真值/假值。\"\"\"\n    acyclic = _build_chain([\"A\", \"B\", \"C\"])\n    assert detect_cycle(acyclic) is False\n\n    a = Node(\"A\")\n    b = Node(\"B\")\n    a.successor = b\n    b.successor = a\n    assert detect_cycle(a) is True\n\n\n# SpecIR v2 确定性 oracle（compile_readiness=1.00）\nimport pytest\nfrom detect_cycle import detect_cycle\n\ndef test_specir_v2_oracle():\n    try:\n        node = 0\n        # [未断言·无满足前件的见证] # pre: node is None or hasattr(node, \"successor\")\n        # [未断言·无满足前件的见证] assert node is None or hasattr(node, \"successor\")\n        r = detect_cycle(node)\n        # post: isinstance(result, bool)\n        assert isinstance(r, bool)\n    except AssertionError:\n        # 断言失败 = oracle 的语义判定信号，必须保留为 fail（不得 skip）\n        raise\n    except Exception as exc:\n        pytest.skip(f\"oracle-unavailable: {type(exc).__name__}: {exc}\")",
