\"\"\"后置条件验证测试。\"\"\"\n\n    @pytest.mark.parametrize(\n        \"arr,k\",\n        [\n            ([3, 1, 2, 1], 4),\n            ([], 5),\n            ([0], 1),\n            ([2, 2, 2], 3),\n            ([0, 1, 2, 3], 4),\n            ([4, 3, 2, 1, 0], 5),\n            ([1, 3], 10),\n        ],\n    )\n    def test_bucketsort_postconditions(self, arr, k):\n        \"\"\"后置条件：长度一致、非降序、多重集相同。\"\"\"\n        result = bucketsort(arr, k)\n        assert len(result) == len(arr)\n        assert result == sorted(arr)\n        assert all(result[i] <= result[i + 1] for i in range(len(result) - 1))\n\n\nclass TestBucketsortError:\n    \"\"\"违反前置条件的异常路径测试。\"\"\"\n\n    def test_bucketsort_element_out_of_range_raises(self):\n        \"\"\"元素越界（x >= k）：counts[x] 触发 IndexError。\n\n        期望值来源不明，需人工确认：此处仅断言会抛出异常。\n        \"\"\"\n        arr = [5]\n        k = 3\n        with pytest.raises(Exception):\n            bucketsort(arr, k)\n\n    def test_bucketsort_negative_element(self):\n        \"\"\"负元素：counts[-1] 访问末尾桶，行为不确定。\n\n        期望值来源不明，需人工确认：记录实际行为，不做强断言。\n        \"\"\"\n        arr = [-1]\n        k = 3\n        try:\n            result = bucketsort(arr, k)\n        except Exception:\n            # 抛出异常属于可接受行为\n            return\n        # 若未抛异常，仅记录实际结果，不臆造期望值\n        assert isinstance(result, list)\n\n    def test_bucketsort_k_zero_nonempty_raises(self):\n        \"\"\"k 为 0 且 arr 非空：counts 为空列表，counts[0] 触发 IndexError。\n\n        期望值来源不明，需人工确认：此处仅断言会抛出异常。\n        \"\"\"\n        arr = [0]\n        k = 0\n        with pytest.raises(Exception):\n            bucketsort(arr, k)\n\n\n# SpecIR v2 确定性 oracle（compile_readiness=1.00）\nimport pytest\nfrom bucketsort import bucketsort\n\ndef test_specir_v2_oracle():\n    try:\n        arr, k = 0, 0\n        # [未断言·无满足前件的见证] # pre: all(isinstance(x, int) and 0 <= x < k for x in arr)\n        # [未断言·无满足前件的见证] assert all(isinstance(x, int) and 0 <= x < k for x in arr)\n        # [未断言·无满足前件的见证] # pre: k > 0\n        # [未断言·无满足前