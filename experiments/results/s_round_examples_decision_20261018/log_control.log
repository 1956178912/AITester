            "by_model": {
              "deepseek-flash": 12332
            }
          },
          "rag_stats": null,
          "patch": "```python\ndef lcs_length(s, t):\n    from collections import Counter\n\n    dp = Counter()\n\n    for i in range(len(s)):\n        for j in range(len(t)):\n            if s[i] == t[j]:\n                dp[i, j] = dp[i - 1, j - 1] + 1\n\n    return max(dp.values()) if dp else 0\n\n\n\n\"\"\"\nLongest Common Substring\nlongest-common-substring\n\nInput:\n    s: a string\n    t: a string\n\nOutput:\n    Length of the longest substring common to s and t\n\nExample:\n    >>> lcs_length('witch', 'sandwich')\n    2\n    >>> lcs_length('meow', 'homeowner')\n    4\n\"\"\"\n```",
          "generated_test": "import pytest\n\nfrom lcs_length import lcs_length\n\n\nclass TestLcsLengthNormal:\n    \"\"\"正常路径测试。\"\"\"\n\n    def test_lcs_length_docstring_witch_sandwich(self):\n        \"\"\"docstring 示例：'witch' 与 'sandwich' 的最长公共子串长度为 2。\"\"\"\n        assert lcs_length(\"witch\", \"sandwich\") == 2\n\n    def test_lcs_length_docstring_meow_homeowner(self):\n        \"\"\"docstring 示例：'meow' 与 'homeowner' 的最长公共子串长度为 4。\"\"\"\n        assert lcs_length(\"meow\", \"homeowner\") == 4\n\n    def test_lcs_length_identical_strings(self):\n        \"\"\"两串完全相同时，最长公共子串为整串，长度为 3。\"\"\"\n        assert lcs_length(\"abc\", \"abc\") == 3\n\n    def test_lcs_length_common_substring_at_tail(self):\n        \"\"\"公共子串位于串尾时，长度为 3。\"\"\"\n        assert lcs_length(\"xxabc\", \"yyabc\") == 3\n\n    def test_lcs_length_common_substring_at_head(self):\n        \"\"\"公共子串位于串首时，长度为 3。\"\"\"\n        assert lcs_length(\"abcxx\", \"abcyy\") == 3\n\n\nclass TestLcsLengthBoundary:\n    \"\"\"边界路径测试。\"\"\"\n\n    def test_lcs_length_no_common_chars(self):\n        \"\"\"无任何公共字符时返回 0。\"\"\"\n        assert lcs_length(\"abc\", \"xyz\") == 0\n\n    def test_lcs_length_empty_s(self):\n        \"\"\"s 为空串时返回 0。\"\"\"\n        assert lcs_length(\"\", \"abc\") == 0\n\n    def test_lcs_length_empty_t(self):\n        \"\"\"t 为空串时返回 0。\"\"\"\n        assert lcs_length(\"abc\", \"\") == 0\n\n    def test_lcs_length_both_empty(self):\n        \"\"\"两串均为空串时返回 0。\"\"\"\n        assert lcs_length(\"\", \"\") == 0\n\n    def test_lcs_length_single_char_equal(self):\n        \"\"\"单字符相等时返回 1。\"\"\"\n        assert lcs_length(\"a\", \"a\") == 1\n\n    def test_lcs_length_single_char_not_equal(self):\n        \"\"\"单字符不等时返回 0。\"\"\"\n        assert lcs_length(\"a\", \"b\") == 0\n\n    def test_lcs_length_repeated_chars_aaa_aa(self):\n        \"\"\"重复字符场景：'aaa' 与 'aa' 的最长公共子串长度为 2。\"\"\"\n        assert lcs_length(\"aaa\", \"aa\") == 2\n\n    def test_lcs_length_single_char_common_substring(self):\n        \"\"\"仅存在长度为 1 的公共子串时返回 1。\"\"\"\n        assert lcs_length(\"xyz\", \"ayb\") == 1\n\n\nclass TestLcsLengthPostconditions:\n    \"\"\"后置条件测试。\"\"\"\n\n    @pytest.mark.parametrize(\n        \"s,t\",\n        [\n            (\"witch\", \"sandwich\"),\n            (\"meow\", \"homeowner\"),\n            (\"abc\", \"abc\"),\n            (\"abc\", \"xyz\"),\n            (\"\", \"abc\"),\n            (\"abc\", \"\"),\n            (\"\", \"\"),\n            (\"a\", \"a\"),\n            (\"a\", \"b\"),\n            (\"xxabc\", \"yyabc\"),\n            (\"abcxx\", \"abcyy\"),\n            (\"aaa\", \"aa\"),\n            (\"xyz\", \"ayb\"),\n        ],\n    )\n    def test_lcs_length_postconditions(self, s, t):\n        \"\"\"返回值应为非负整数且不超过 min(len(s), len(t))。\"\"\"\n        result = lcs_length(s, t)\n        assert isinstance(result, int)\n        assert result >= 0\n        assert result <= min(len(s), len(t))\n\n\nclass TestLcsLengthError:\n    \"\"\"异常路径测试。\"\"\"\n\n    def test_lcs_length_non_string_int_raises(self):\n        \"\"\"s 为整数时 len() 抛 TypeError（期望值来源不明，需人工确认）。\"\"\"\n        with pytest.raises(TypeError):\n            lcs_length(123, \"abc\")\n\n    def test_lcs_length_non_string_none_raises(self):\n        \"\"\"s 为 None 时 len() 抛 TypeError（期望值来源不明，需人工确认）。\"\"\"\n        with pytest.raises(TypeError):\n            lcs_length(None, \"abc\")\n\n\n# SpecIR v2 确定性 oracle（compile_readiness=1.00）\nimport pytest\nfrom lcs_length import lcs_length\n\ndef test_specir_v2_oracle():\n    try:\n        s, t = 0, 0\n        # [未断言·无满足前件的见证] # pre: isinstance(s, str) and isinstance(t, str)\n        # [未断言·无满足前件的见证] assert isinstance(s, str) and isinstance(t, str)\n        r = lcs_length(s, t)\n        # post: isinstance(result, int) and result >= 0\n        assert isinstance(r, int) and r >= 0\n        # post: result <= min(len(s), len(t))\n        assert r <= min(len(s), len(t))\n        # post: len(s) == 0 or len(t) == 0 or result >= 0\n        assert le