          "patch": "```python\nfrom collections import deque as Queue\n\n\ndef breadth_first_search(startnode, goalnode):\n    queue = Queue()\n    queue.append(startnode)\n\n    nodesseen = set()\n    nodesseen.add(startnode)\n\n    while queue:\n        node = queue.popleft()\n\n        if node is goalnode:\n            return True\n        else:\n            queue.extend(node for node in node.successors if node not in nodesseen)\n            nodesseen.update(node.successors)\n\n    return False\n\n\n\n\"\"\"\nBreadth-First Search\n\n\nInput:\n    startnode: A digraph node\n    goalnode: A digraph node\n\nOutput:\n    Whether goalnode is reachable from startnode\n\"\"\"\n```",
          "generated_test": "import pytest\n\nfrom breadth_first_search import breadth_first_search\n\n\nclass Node:\n    \"\"\"简单的有向图节点，具备 successors 可迭代属性且可哈希。\"\"\"\n\n    def __init__(self, name, successors=None):\n        self.name = name\n        self.successors = successors if successors is not None else []\n\n    def __repr__(self):\n        return f\"Node({self.name})\"\n\n\ndef test_breadth_first_search_start_is_goal():\n    \"\"\"起点即终点：startnode 与 goalnode 为同一对象，应返回 True。\"\"\"\n    a = Node(\"A\")\n    assert breadth_first_search(a, a) is True\n\n\ndef test_breadth_first_search_direct_successor():\n    \"\"\"直接后继可达：目标为起点的直接后继，应返回 True。\"\"\"\n    b = Node(\"B\")\n    a = Node(\"A\", [b])\n    assert breadth_first_search(a, b) is True\n\n\ndef test_breadth_first_search_multi_hop():\n    \"\"\"多跳可达：A -> B -> C，应返回 True。\"\"\"\n    c = Node(\"C\")\n    b = Node(\"B\", [c])\n    a = Node(\"A\", [b])\n    assert breadth_first_search(a, c) is True\n\n\ndef test_breadth_first_search_unreachable_target():\n    \"\"\"不可达目标：期望值来源不明，需人工确认。\n\n    docstring 声称不可达时返回 False，但实现中 while True 循环在队列\n    耗尽后 popleft 会抛 IndexError。此处记录实际行为，断言与 docstring\n    一致（返回 False），若实现抛异常则测试失败以暴露不一致。\n    \"\"\"\n    b = Node(\"B\")\n    a = Node(\"A\", [b])\n    c = Node(\"C\")  # 孤立节点\n    try:\n        result = breadth_first_search(a, c)\n    except IndexError:\n        pytest.fail(\n            \"实现抛出 IndexError，与 docstring 声称的返回 False 不一致，需人工确认\"\n        )\n    assert result is False\n\n\ndef test_breadth_first_search_start_no_successors_not_goal():\n    \"\"\"起点无后继且非目标：期望值来源不明，需人工确认。\n\n    docstring 声称不可达返回 False，但实现队列耗尽后 popleft 抛\n    IndexError。此处记录实际行为，断言与 docstring 一致。\n    \"\"\"\n    a = Node(\"A\", [])\n    b = Node(\"B\")\n    try:\n        result = breadth_first_search(a, b)\n    except IndexError:\n        pytest.fail(\n            \"实现抛出 IndexError，与 docstring 声称的返回 False 不一致，需人工确认\"\n        )\n    assert result is False\n\n\ndef test_breadth_first_search_with_cycle():\n    \"\"\"图中存在环：A -> B -> A，且 B -> C，应返回 True 且不无限循环。\"\"\"\n    a = Node(\"A\")\n    b = Node(\"B\")\n    c = Node(\"C\")\n    a.successors = [b]\n    b.successors = [a, c]\n    assert breadth_first_search(a, c) is True\n\n\ndef test_breadth_first_search_goal_on_cycle():\n    \"\"\"目标为环上节点：起点即目标且存在环，应返回 True。\"\"\"\n    a = Node(\"A\")\n    b = Node(\"B\")\n    a.successors = [b]\n    b.successors = [a]\n    assert breadth_first_search(a, a) is True\n\n\ndef test_breadth_first_search_returns_bool():\n    \"\"\"返回值类型应为 bool（后置条件）。\"\"\"\n    a = Node(\"A\")\n    result = breadth_first_search(a, a)\n    assert isinstance(result, bool)\n\n\n# SpecIR v2 确定性 oracle（compile_readiness=1.00；examples=1）\nimport pytest\nfrom collections.abc import Iterator\nfrom breadth_first_search import breadth_first_search\n\ndef _specir_norm_return(value):\n    \"\"\"P-1.1 返回表示归一：tuple/list→list（递归）、iterator→list、str/bytes/dict 不误归。\"\"\"\n    if isinstance(value, tuple):\n        return [_specir_norm_return(item) for item in value]\n    if isinstance(value, list):\n        return [_specir_norm_return(item) for item in value]\n    if isinstance(value, dict):\n        return {key: _specir_norm_return(item) for key, item in value.items()}\n    if isinstance(value, (str, bytes, bytearray)):\n        return value\n    if isinstance(value, Iterator):\n        return [_specir_norm_return(item) for item in value]\n    return value\n\ndef test_specir_v2_oracle():\n    try:\n        # examples（1 条规格可执行示例；期望值来自规约，不是实现）\n        assert _specir_norm_return(breadth_first_search({'name': 'A', 'successors': []}, {'name': 'A', 'successors': []})) == _specir_norm_return(True)\n    except AssertionError:\n        # 断言失败 = oracle 的语义判定信号，必须保留为 fail（不得 skip）\n        raise\n    except Exception as exc:\n        pytest.skip(f\"oracle-unavailable: {type(exc).__name__}: {exc}\")",
