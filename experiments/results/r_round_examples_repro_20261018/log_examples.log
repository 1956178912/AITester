rt find_first_in_sorted([1, 2, 3, 4], 4) == 3\n\n    def test_find_first_in_sorted_all_same(self):\n        \"\"\"All elements identical returns index 0.\"\"\"\n        assert find_first_in_sorted([5, 5, 5, 5], 5) == 0\n\n    def test_find_first_in_sorted_less_than_all(self):\n        \"\"\"x smaller than all elements returns -1.\"\"\"\n        assert find_first_in_sorted([2, 3, 4], 1) == -1\n\n    def test_find_first_in_sorted_greater_than_all(self):\n        \"\"\"x greater than all elements returns -1.\"\"\"\n        assert find_first_in_sorted([2, 3, 4], 9) == -1\n\n    def test_find_first_in_sorted_missing_in_middle(self):\n        \"\"\"x absent but within range returns -1.\"\"\"\n        assert find_first_in_sorted([1, 3, 5, 7], 4) == -1\n\n    def test_find_first_in_sorted_negative_values(self):\n        \"\"\"Negative values are handled correctly.\"\"\"\n        assert find_first_in_sorted([-5, -3, -1], -3) == 1\n\n    @pytest.mark.parametrize(\n        \"arr, x\",\n        [\n            ([3, 4, 5, 5, 5, 5, 6], 5),\n            ([7], 7),\n            ([1, 2, 3, 4], 1),\n            ([1, 2, 3, 4], 4),\n            ([5, 5, 5, 5], 5),\n            ([-5, -3, -1], -3),\n        ],\n    )\n    def test_find_first_in_sorted_postconditions_on_hit(self, arr, x):\n        \"\"\"On a hit, result is a valid lowest index of x.\"\"\"\n        result = find_first_in_sorted(arr, x)\n        assert result != -1\n        assert 0 <= result < len(arr)\n        assert arr[result] == x\n        assert result == 0 or arr[result - 1] != x\n\n    @pytest.mark.parametrize(\n        \"arr, x\",\n        [\n            ([], 5),\n            ([2, 3, 4], 1),\n            ([2, 3, 4], 9),\n            ([1, 3, 5, 7], 4),\n            ([7], 3),\n        ],\n    )\n    def test_find_first_in_sorted_postconditions_on_miss(self, arr, x):\n        \"\"\"On a miss, result is -1 and x is not in arr.\"\"\"\n        result = find_first_in_sorted(arr, x)\n        assert result == -1\n        assert x not in arr\n\n\n# SpecIR v2 确定性 oracle（compile_readiness=0.60；examples=3）\nimport pytest\nfrom collections.abc import Iterator\nfrom find_first_in_sorted import find_first_in_sorted\n\ndef _specir_norm_return(value):\n    \"\"\"P-1.1 返回表示归一：tuple/list→list（递归）、iterator→list、str/bytes/dict 不误归。\"\"\"\n    if isinstance(value, tuple):\n        return [_specir_norm_return(item) for item in value]\n    if isinstance(value, list):\n        return [_specir_norm_return(item) for item in value]\n    if isinstance(value, dict):\n        return {key: _specir_norm_return(item) for key, item in value.items()}\n    if isinstance(value, (str, bytes, bytearray)):\n        return value\n    if isinstance(value, Iterator):\n        return [_specir_norm_return(item) for item in value]\n    return value\n\ndef test_specir_v2_oracle():\n    try:\n        assert _specir_norm_return(find_first_in_sorted([3, 4, 5, 5, 5, 5, 6], 5)) == _specir_norm_return(2)\n        assert _specir_norm_return(find_first_in_sorted([1, 2, 3], 4)) == _specir_norm_return(-1)\n        assert _specir_norm_return(find_first_in_sorted([], '1')) == _specir_norm_return(-1)\n    except AssertionError:\n        # 断言失败 = oracle 的语义判定信号，必须保留为 fail（不得 skip）\n        raise\n    except Exception as exc:\n        pytest.skip(f\"oracle-unavailable: {type(exc).__name__}: {exc}\")",
