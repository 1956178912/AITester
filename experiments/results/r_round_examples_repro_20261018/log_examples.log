          "rag_stats": null,
          "patch": "```python\ndef is_valid_parenthesization(parens):\n    depth = 0\n    for paren in parens:\n        if paren == '(':\n            depth += 1\n        else:\n            depth -= 1\n            if depth < 0:\n                return False\n\n    return depth == 0\n\n\n\"\"\"\nNested Parens\nInput:\n    parens: A string of parentheses\n\nPrecondition:\n    all(paren in '()' for paren in parens)\n\nOutput:\n    Whether the parentheses are properly nested\n\nExamples:\n    >>> is_valid_parenthesization('((()()))()')\n    True\n    >>> is_valid_parenthesization(')()(')\n    False\n\"\"\"\n```",
          "generated_test": "import pytest\n\nfrom is_valid_parenthesization import is_valid_parenthesization\n\n\nclass TestIsValidParenthesizationExamples:\n    \"\"\"Tests derived from the docstring examples.\"\"\"\n\n    def test_is_valid_parenthesization_docstring_example_true(self):\n        \"\"\"Docstring example: '((()()))()' should be properly nested -> True.\"\"\"\n        assert is_valid_parenthesization(\"((()()))()\") is True\n\n    def test_is_valid_parenthesization_docstring_example_false(self):\n        \"\"\"Docstring example: ')()(' starts with a closing paren -> False.\"\"\"\n        assert is_valid_parenthesization(\")()(\") is False\n\n\nclass TestIsValidParenthesizationBoundary:\n    \"\"\"Boundary cases.\"\"\"\n\n    def test_is_valid_parenthesization_empty_string(self):\n        \"\"\"Empty string has no unmatched parens -> True.\"\"\"\n        assert is_valid_parenthesization(\"\") is True\n\n    def test_is_valid_parenthesization_single_open(self):\n        \"\"\"A single '(' is a valid prefix (no unmatched close) -> True.\"\"\"\n        assert is_valid_parenthesization(\"(\") is True\n\n    def test_is_valid_parenthesization_single_close(self):\n        \"\"\"A single ')' is unmatched -> False.\"\"\"\n        assert is_valid_parenthesization(\")\") is False\n\n    def test_is_valid_parenthesization_balanced_simple(self):\n        \"\"\"'()' is properly nested -> True.\"\"\"\n        assert is_valid_parenthesization(\"()\") is True\n\n    def test_is_valid_parenthesization_balanced_nested(self):\n        \"\"\"'(())' is properly nested -> True.\"\"\"\n        assert is_valid_parenthesization(\"(())\") is True\n\n    def test_is_valid_parenthesization_balanced_sequence(self):\n        \"\"\"'()()' is properly nested -> True.\"\"\"\n        assert is_valid_parenthesization(\"()()\") is True\n\n\nclass TestIsValidParenthesizationUnbalanced:\n    \"\"\"Cases where the string is not properly nested.\"\"\"\n\n    def test_is_valid_parenthesization_extra_close(self):\n        \"\"\"'())' has an unmatched closing paren -> False.\"\"\"\n        assert is_valid_parenthesization(\"())\") is False\n\n    def test_is_valid_parenthesization_starts_with_close(self):\n        \"\"\"')(' starts with a closing paren -> False.\"\"\"\n        assert is_valid_parenthesization(\")(\") is False\n\n    def test_is_valid_parenthesization_close_then_open(self):\n        \"\"\"')(())' starts with a closing paren -> False.\"\"\"\n        assert is_valid_parenthesization(\")(())\") is False\n\n    def test_is_valid_parenthesization_middle_unmatched_close(self):\n        \"\"\"'(()))' has an extra closing paren -> False.\"\"\"\n        assert is_valid_parenthesization(\"(()))\") is False\n\n\nclass TestIsValidParenthesizationFinalDepth:\n    \"\"\"Proper nesting requires the final depth to be zero.\n\n    A string with more opening than closing parens is NOT properly nested,\n    even though the implementation may currently return True for it.\n    \"\"\"\n\n    @pytest.mark.parametrize(\n        \"parens\",\n        [\n            \"(()\",\n            \"(((\",\n            \"(()()\",\n            \"((())\",\n        ],\n    )\n    def test_is_valid_parenthesization_unbalanced_open_returns_false(self, parens):\n        \"\"\"Strings with unmatched opening parens are not properly nested -> False.\n\n        Expected value source: problem semantics (\"properly nested\" requires\n        every opening paren to be matched by a closing paren, i.e. final\n        depth must be zero). The current implementation does not check the\n        final depth, so this test is expected to fail on the buggy code.\n        \"\"\"\n        assert is_valid_parenthesization(parens) is False\n\n\nclass TestIsValidParenthesizationParametrized:\n    \"\"\"Parametrized coverage of valid and invalid inputs.\"\"\"\n\n    @pytest.mark.parametrize(\n        \"parens,expected\",\n        [\n            (\"\", True),\n            (\"()\", True),\n            (\"(())\", True),\n            (\"()()\", True),\n            (\"((()))\", True),\n            (\"((()()))()\", True),\n            (\")\", False),\n            (\")(\", False),\n            (\")()(\", False),\n            (\"())\", False),\n            (\"(()))\", False),\n            (\")(())\", False),\n        ],\n    )\n    def test_is_valid_parenthesization_known_cases(self, parens, expected):\n        \"\"\"Verify known valid/invalid parenthesization cases.\"\"\"\n        assert is_valid_parenthesization(parens) is expected\n\n\n# SpecIR v2 确定性 oracle（compile_readiness=1.00；examples=3）\nimport pytest\nfrom collections.abc import Iterator\nfrom is_valid_parenthesization import is_valid_parenthesization\n\ndef _specir_norm_return(value):\n    \"\"\"P-1.1 返回表示归一：tuple/list→list（递归）、iterator→list、str/bytes/dict 不误归。\"\"\"\n    if isinstance(value, tuple):\n        return [_specir_norm_return(item) for item in value]\n    if isinstance(value, list):\n        return [_specir_norm_return(item) for item in value]\n    if isinstance(value, dict):\n        return {key: _specir_norm_return(item) for key, item in value.items()}\n    if isinstance(value, (str, bytes, bytearray)):\n        return value\n    if isinstance(value, Iterator):\n        return [_specir_norm_return(item) for item in value]\n    return value\n\ndef test_specir_v2_oracle():\n    try:\n        assert _specir_norm_return(is_valid_parenthesization('((()()))()')) == _specir_norm_return(True)\n        assert _specir_norm_return(is_valid_parenthesization(')()(')) == _specir_norm_return(False)\n        assert _specir_norm_return(is_valid_parenthesization('')) == _specir_norm_return(True)\n    except AssertionError:\n        # 断言失败 = oracle 的语义判定信号，必须保留为 fail（不得 skip）\n        raise\n    except Exception as exc:\n        pytest.skip(f\"oracle-unavailable: {type(exc).__name__}: {exc}\")",
