          "patch": "```python\ndef levenshtein(source, target):\n    if source == '' or target == '':\n        return len(source) or len(target)\n\n    elif source[0] == target[0]:\n        return levenshtein(source[1:], target[1:])\n\n    else:\n        return 1 + min(\n            levenshtein(source,     target[1:]),\n            levenshtein(source[1:], target[1:]),\n            levenshtein(source[1:], target)\n        )\n\n\"\"\"\nLevenshtein Distance\n\n\nCalculates the Levenshtein distance between two strings.  The Levenshtein distance is defined as the minimum amount of single-character edits (either removing a character, adding a character, or changing a character) necessary to transform a source string into a target string.\n\nInput:\n    source: The string you begin with.\n    target: The string to transform into.\n\nOutput:\n    The Levenshtein distance between the source and target.\n\nExample:\n    electron can be transformed into neutron by removing the e, turning the l into n, and turning the c into u.\n    >>> levenshtein(electron, neutron)\n    3\n\"\"\"\n```",
          "generated_test": "import pytest\n\nfrom levenshtein import levenshtein\n\n\nclass TestLevenshteinNormal:\n    \"\"\"正常路径测试。\"\"\"\n\n    def test_levenshtein_identical_strings(self):\n        \"\"\"相同字符串编辑距离应为 0。\"\"\"\n        assert levenshtein(\"abc\", \"abc\") == 0\n\n    def test_levenshtein_single_char_substitution(self):\n        \"\"\"单字符替换距离应为 1。\"\"\"\n        assert levenshtein(\"a\", \"b\") == 1\n\n    def test_levenshtein_docstring_example(self):\n        \"\"\"docstring 示例：electron -> neutron 距离为 3。\"\"\"\n        assert levenshtein(\"electron\", \"neutron\") == 3\n\n\nclass TestLevenshteinBoundary:\n    \"\"\"边界条件测试。\"\"\"\n\n    def test_levenshtein_empty_source(self):\n        \"\"\"空源串应返回目标串长度。\"\"\"\n        assert levenshtein(\"\", \"abc\") == 3\n\n    def test_levenshtein_empty_target(self):\n        \"\"\"空目标串应返回源串长度。\"\"\"\n        assert levenshtein(\"abc\", \"\") == 3\n\n    def test_levenshtein_both_empty(self):\n        \"\"\"双空串应返回 0。\"\"\"\n        assert levenshtein(\"\", \"\") == 0\n\n    def test_levenshtein_single_char_insertion(self):\n        \"\"\"单字符插入距离应为 1。\"\"\"\n        assert levenshtein(\"a\", \"ab\") == 1\n\n\nclass TestLevenshteinPostconditions:\n    \"\"\"后置条件测试。\"\"\"\n\n    @pytest.mark.parametrize(\n        \"source,target\",\n        [\n            (\"abc\", \"abc\"),\n            (\"\", \"abc\"),\n            (\"abc\", \"\"),\n            (\"\", \"\"),\n            (\"a\", \"b\"),\n            (\"electron\", \"neutron\"),\n            (\"kitten\", \"sitting\"),\n            (\"a\", \"ab\"),\n        ],\n    )\n    def test_levenshtein_result_non_negative(self, source, target):\n        \"\"\"返回值应始终为非负整数。\"\"\"\n        result = levenshtein(source, target)\n        assert isinstance(result, int)\n        assert result >= 0\n\n    @pytest.mark.parametrize(\n        \"source,target\",\n        [\n            (\"abc\", \"abc\"),\n            (\"\", \"abc\"),\n            (\"abc\", \"\"),\n            (\"\", \"\"),\n            (\"a\", \"b\"),\n            (\"electron\", \"neutron\"),\n            (\"kitten\", \"sitting\"),\n        ],\n    )\n    def test_levenshtein_result_upper_bound(self, source, target):\n        \"\"\"返回值应不超过两串长度的最大值。\"\"\"\n        result = levenshtein(source, target)\n        assert result <= max(len(source), len(target))\n\n    @pytest.mark.parametrize(\n        \"source,target\",\n        [\n            (\"abc\", \"abc\"),\n            (\"\", \"abc\"),\n            (\"abc\", \"\"),\n            (\"\", \"\"),\n            (\"a\", \"b\"),\n            (\"electron\", \"neutron\"),\n        ],\n    )\n    def test_levenshtein_identical_implies_zero(self, source, target):\n        \"\"\"若两串相同则结果应为 0。\"\"\"\n        result = levenshtein(source, target)\n        if source == target:\n            assert result == 0\n\n\nclass TestLevenshteinError:\n    \"\"\"输入域外行为测试。\"\"\"\n\n    def test_levenshtein_non_string_input(self):\n        \"\"\"非字符串输入行为未在规格中定义。\n\n        期望值来源不明，需人工确认：代码未做类型校验，\n        传入非字符串会在切片/比较处抛异常，具体异常类型未定义。\n        此处仅记录实际行为，断言其抛出任意异常。\n        \"\"\"\n        with pytest.raises(Exception):\n            levenshtein(123, \"abc\")\n\n\n# SpecIR v2 确定性 oracle（compile_readiness=1.00；examples=3）\nimport pytest\nfrom collections.abc import Iterator\nfrom levenshtein import levenshtein\n\ndef _specir_norm_return(value):\n    \"\"\"P-1.1 返回表示归一：tuple/list→list（递归）、iterator→list、str/bytes/dict 不误归。\"\"\"\n    if isinstance(value, tuple):\n        return [_specir_norm_return(item) for item in value]\n    if isinstance(value, list):\n        return [_specir_norm_return(item) for item in value]\n    if isinstance(value, dict):\n        return {key: _specir_norm_return(item) for key, item in value.items()}\n    if isinstance(value, (str, bytes, bytearray)):\n        return value\n    if isinstance(value, Iterator):\n        return [_specir_norm_return(item) for item in value]\n    return value\n\ndef test_specir_v2_oracle():\n    try:\n        # examples（3 条规格可执行示例；期望值来自规约，不是实现）\n        assert _specir_norm_return(levenshtein('electron', 'neutron')) == _specir_norm_return(3)\n        assert _specir_norm_return(levenshtein('', 'abc')) == _specir_norm_return(3)\n        assert _specir_norm_return(levenshtein('abc', 'abc')) == _specir_norm_return(0)\n    except AssertionError:\n        # 断言失败 = oracle 的语义判定信号，必须保留为 fail（不得 skip）\n        raise\n    except Exception as exc:\n        pytest.skip(f\"oracle-unavailable: {type(exc).__name__}: {exc}\")",
