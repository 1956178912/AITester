          "rag_stats": null,
          "patch": "```python\ndef lcs_length(s, t):\n    from collections import Counter\n\n    dp = Counter()\n\n    for i in range(len(s)):\n        for j in range(len(t)):\n            if s[i] == t[j]:\n                dp[i, j] = dp[i - 1, j - 1] + 1\n\n    return max(dp.values()) if dp else 0\n\n\n\n\"\"\"\nLongest Common Substring\nlongest-common-substring\n\nInput:\n    s: a string\n    t: a string\n\nOutput:\n    Length of the longest substring common to s and t\n\nExample:\n    >>> lcs_length('witch', 'sandwich')\n    2\n    >>> lcs_length('meow', 'homeowner')\n    4\n\"\"\"\n```",
          "generated_test": "import pytest\n\nfrom lcs_length import lcs_length\n\n\nclass TestLcsLengthExamples:\n    \"\"\"docstring 示例测试。\"\"\"\n\n    def test_lcs_length_docstring_example_witch_sandwich(self):\n        \"\"\"docstring 示例：lcs_length('witch', 'sandwich') == 2。\"\"\"\n        assert lcs_length(\"witch\", \"sandwich\") == 2\n\n    def test_lcs_length_docstring_example_meow_homeowner(self):\n        \"\"\"docstring 示例：lcs_length('meow', 'homeowner') == 4。\"\"\"\n        assert lcs_length(\"meow\", \"homeowner\") == 4\n\n\nclass TestLcsLengthNormal:\n    \"\"\"常规用例。\"\"\"\n\n    def test_lcs_length_identical_strings(self):\n        \"\"\"两字符串完全相同时，最长公共子串为整个字符串。\"\"\"\n        assert lcs_length(\"abc\", \"abc\") == 3\n\n    def test_lcs_length_s_is_substring_of_t(self):\n        \"\"\"s 整体是 t 的子串时，结果为 len(s)。\"\"\"\n        assert lcs_length(\"bc\", \"abcd\") == 2\n\n    def test_lcs_length_common_substring_at_end(self):\n        \"\"\"公共子串出现在字符串末尾，验证 dp 索引边界。\"\"\"\n        assert lcs_length(\"xxab\", \"yyab\") == 2\n\n\nclass TestLcsLengthBoundary:\n    \"\"\"边界用例。\"\"\"\n\n    def test_lcs_length_no_common_chars(self):\n        \"\"\"无任何公共字符时返回 0。\"\"\"\n        assert lcs_length(\"abc\", \"xyz\") == 0\n\n    def test_lcs_length_empty_s(self):\n        \"\"\"s 为空串时返回 0。\"\"\"\n        assert lcs_length(\"\", \"abc\") == 0\n\n    def test_lcs_length_empty_t(self):\n        \"\"\"t 为空串时返回 0。\"\"\"\n        assert lcs_length(\"abc\", \"\") == 0\n\n    def test_lcs_length_both_empty(self):\n        \"\"\"两串均为空时返回 0。\"\"\"\n        assert lcs_length(\"\", \"\") == 0\n\n    def test_lcs_length_single_char_same(self):\n        \"\"\"单字符相同，最小非零公共子串长度为 1。\"\"\"\n        assert lcs_length(\"a\", \"a\") == 1\n\n    def test_lcs_length_single_char_different(self):\n        \"\"\"单字符不同，无公共子串，返回 0。\"\"\"\n        assert lcs_length(\"a\", \"b\") == 0\n\n    def test_lcs_length_repeated_chars(self):\n        \"\"\"重复字符场景，结果受较短串长度限制。\"\"\"\n        assert lcs_length(\"aaaa\", \"aa\") == 2\n\n\nclass TestLcsLengthPostconditions:\n    \"\"\"后置条件与不变量测试。\"\"\"\n\n    @pytest.mark.parametrize(\n        \"s,t\",\n        [\n            (\"witch\", \"sandwich\"),\n            (\"meow\", \"homeowner\"),\n            (\"abc\", \"abc\"),\n            (\"abc\", \"xyz\"),\n            (\"\", \"abc\"),\n            (\"abc\", \"\"),\n            (\"\", \"\"),\n            (\"a\", \"a\"),\n            (\"a\", \"b\"),\n            (\"bc\", \"abcd\"),\n            (\"xxab\", \"yyab\"),\n            (\"aaaa\", \"aa\"),\n        ],\n    )\n    def test_lcs_length_result_is_non_negative_int_within_bound(self, s, t):\n        \"\"\"返回值应为非负整数，且不超过 min(len(s), len(t))。\"\"\"\n        result = lcs_length(s, t)\n        assert isinstance(result, int)\n        assert result >= 0\n        assert result <= min(len(s), len(t))\n\n    @pytest.mark.parametrize(\n        \"s,t\",\n        [\n            (\"\", \"abc\"),\n            (\"abc\", \"\"),\n            (\"\", \"\"),\n        ],\n    )\n    def test_lcs_length_empty_input_returns_zero(self, s, t):\n        \"\"\"任一为空串时返回值必须为 0。\"\"\"\n        assert lcs_length(s, t) == 0\n\n\n# SpecIR v2 确定性 oracle（compile_readiness=1.00；examples=3）\nimport pytest\nfrom collections.abc import Iterator\nfrom lcs_length import lcs_length\n\ndef _specir_norm_return(value):\n    \"\"\"P-1.1 返回表示归一：tuple/list→list（递归）、iterator→list、str/bytes/dict 不误归。\"\"\"\n    if isinstance(value, tuple):\n        return [_specir_norm_return(item) for item in value]\n    if isinstance(value, list):\n        return [_specir_norm_return(item) for item in value]\n    if isinstance(value, dict):\n        return {key: _specir_norm_return(item) for key, item in value.items()}\n    if isinstance(value, (str, bytes, bytearray)):\n        return value\n    if isinstance(value, Iterator):\n        return [_specir_norm_return(item) for item in value]\n    return value\n\ndef test_specir_v2_oracle():\n    try:\n        # examples（3 条规格可执行示例；期望值来自规约，不是实现）\n        assert _specir_norm_return(lcs_length('witch', 'sandwich')) == _specir_norm_return(2)\n        assert _specir_norm_return(lcs_length('meow', 'homeowner')) == _specir_norm_return(4)\n        assert _specir_norm_return(lcs_length('', 'abc')) == _specir_norm_return(0)\n    except AssertionError:\n        # 断言失败 = oracle 的语义判定信号，必须保留为 fail（不得 skip）\n        raise\n    except Exception as exc:\n        pytest.skip(f\"oracle-unavailable: {type(exc).__name__}: {exc}\")",
