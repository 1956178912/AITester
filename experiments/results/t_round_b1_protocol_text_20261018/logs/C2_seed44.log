          "generated_test": "import pytest\n\nfrom task_0014 import _better, best_score, worst_score\n\n\nclass TestBetter:\n    \"\"\"Tests for the _better helper function.\"\"\"\n\n    @pytest.mark.parametrize(\n        \"current, candidate, expected\",\n        [\n            (5, 3, True),\n            (3, 5, False),\n            (5, 5, False),\n            (0, -1, True),\n            (-1, 0, False),\n            (-5, -10, True),\n            (-10, -5, False),\n        ],\n    )\n    def test_better_returns_true_when_candidate_smaller(self, current, candidate, expected):\n        \"\"\"_better should return True iff candidate < current.\"\"\"\n        assert _better(current, candidate) is expected\n\n    def test_better_equal_values_returns_false(self):\n        \"\"\"_better with equal values should return False (candidate not strictly less).\"\"\"\n        assert _better(7, 7) is False\n\n\nclass TestBestScore:\n    \"\"\"Tests for best_score.\"\"\"\n\n    def test_best_score_single_element(self):\n        \"\"\"A single-element list should return that element.\"\"\"\n        assert best_score([42]) == 42\n\n    @pytest.mark.parametrize(\n        \"scores, expected\",\n        [\n            ([1, 2, 3], 1),\n            ([3, 2, 1], 1),\n            ([5, 5, 5], 5),\n            ([10, -3, 7, 0], -3),\n            ([-1, -2, -3], -3),\n            ([0, 0, 1], 0),\n            ([100], 100),\n        ],\n    )\n    def test_best_score_returns_minimum(self, scores, expected):\n        \"\"\"best_score should return the minimum value in the list.\"\"\"\n        assert best_score(scores) == expected\n\n    def test_best_score_does_not_mutate_input(self):\n        \"\"\"best_score should not modify the input list.\"\"\"\n        scores = [3, 1, 2]\n        original = list(scores)\n        best_score(scores)\n        assert scores == original\n\n    def test_best_score_two_elements(self):\n        \"\"\"best_score with two elements returns the smaller one.\"\"\"\n        assert best_score([9, 4]) == 4\n        assert best_score([4, 9]) == 4\n\n\nclass TestWorstScore:\n    \"\"\"Tests for worst_score.\"\"\"\n\n    def test_worst_score_single_element(self):\n        \"\"\"A single-element list should return that element.\"\"\"\n        assert worst_score([42]) == 42\n\n    @pytest.mark.parametrize(\n        \"scores, expected\",\n        [\n            ([1, 2, 3], 3),\n            ([3, 2, 1], 3),\n            ([5, 5, 5], 5),\n            ([10, -3, 7, 0], 10),\n            ([-1, -2, -3], -1),\n            ([0, 0, 1], 1),\n            ([100], 100),\n        ],\n    )\n    def test_worst_score_returns_maximum(self, scores, expected):\n        \"\"\"worst_score should return the maximum value in the list.\"\"\"\n        assert worst_score(scores) == expected\n\n    def test_worst_score_does_not_mutate_input(self):\n        \"\"\"worst_score should not modify the input list.\"\"\"\n        scores = [3, 1, 2]\n        original = list(scores)\n        worst_score(scores)\n        assert scores == original\n\n    def test_worst_score_two_elements(self):\n        \"\"\"worst_score with two elements returns the larger one.\"\"\"\n        assert worst_score([9, 4]) == 9\n        assert worst_score([4, 9]) == 9\n\n\nclass TestBestWorstConsistency:\n    \"\"\"Cross-checks between best_score and worst_score.\"\"\"\n\n    @pytest.mark.parametrize(\n        \"scores\",\n        [\n            [1, 2, 3],\n            [3, 2, 1],\n            [5, 5, 5],\n            [10, -3, 7, 0],\n            [-1, -2, -3],\n            [0],\n        ],\n    )\n    def test_best_score_le_worst_score(self, scores):\n        \"\"\"best_score should always be <= worst_score for the same input.\"\"\"\n        assert best_score(scores) <= worst_score(scores)\n\n    @pytest.mark.parametrize(\n        \"scores\",\n        [\n            [1, 2, 3],\n            [10, -3, 7, 0],\n            [-1, -2, -3],\n        ],\n    )\n    def test_best_and_worst_match_builtins(self, scores):\n        \"\"\"best_score/worst_score should match min/max builtins.\"\"\"\n        assert best_score(scores) == min(scores)\n        assert worst_score(scores) == max(scores)",
