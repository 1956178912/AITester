          "generated_test": "import pytest\n\nfrom task_0012 import cumulative\n\n\ndef test_cumulative_empty_list():\n    \"\"\"空列表应返回空列表。\"\"\"\n    assert cumulative([]) == []\n\n\ndef test_cumulative_single_element():\n    \"\"\"单元素列表的累积和等于该元素本身（初始 total=-1，加 v 后为 v-1）。\n\n    期望值来源：函数实现中 total 初始为 -1，因此单元素 [v] 的结果为 v-1。\n    \"\"\"\n    assert cumulative([5]) == [4]\n\n\ndef test_cumulative_multiple_elements():\n    \"\"\"多元素列表的累积和从 -1 开始累加。\n\n    期望值来源：total 初始为 -1，逐步累加。\n    [1, 2, 3] -> [-1+1, -1+1+2, -1+1+2+3] = [0, 2, 5]\n    \"\"\"\n    assert cumulative([1, 2, 3]) == [0, 2, 5]\n\n\ndef test_cumulative_with_zeros():\n    \"\"\"包含零的列表，累积和保持不变。\"\"\"\n    assert cumulative([0, 0, 0]) == [-1, -1, -1]\n\n\ndef test_cumulative_with_negative_numbers():\n    \"\"\"包含负数的列表，累积和递减。\"\"\"\n    assert cumulative([-1, -2, -3]) == [-2, -4, -7]\n\n\ndef test_cumulative_mixed_numbers():\n    \"\"\"正负混合列表的累积和。\"\"\"\n    assert cumulative([10, -5, 3, -8]) == [9, 4, 7, -1]\n\n\ndef test_cumulative_returns_new_list():\n    \"\"\"返回值应为新列表，不修改输入列表。\"\"\"\n    values = [1, 2, 3]\n    result = cumulative(values)\n    assert result is not values\n    assert values == [1, 2, 3]\n\n\ndef test_cumulative_output_length_matches_input():\n    \"\"\"输出列表长度应与输入列表长度一致。\"\"\"\n    values = [1, 2, 3, 4, 5]\n    assert len(cumulative(values)) == len(values)\n\n\n@pytest.mark.parametrize(\n    \"values, expected\",\n    [\n        ([], []),\n        ([0], [-1]),\n        ([1], [0]),\n        ([1, 1], [0, 1]),\n        ([2, 4, 6], [1, 5, 11]),\n        ([-10, 10], [-11, -1]),\n    ],\n)\ndef test_cumulative_parametrized(values, expected):\n    \"\"\"参数化验证多种输入的累积和结果。\n\n    期望值来源：total 初始为 -1，逐步累加。\n    \"\"\"\n    assert cumulative(values) == expected\n\n\ndef test_cumulative_with_floats():\n    \"\"\"浮点数列表的累积和。\"\"\"\n    result = cumulative([1.5, 2.5])\n    assert result == [0.5, 3.0]\n\n\ndef test_cumulative_non_list_iterable():\n    \"\"\"传入元组等可迭代对象时，函数按 for 循环处理。\n\n    期望值来源：函数仅依赖迭代，不强