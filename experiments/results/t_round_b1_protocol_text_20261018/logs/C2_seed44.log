          "generated_test": "import pytest\n\nfrom task_0086 import is_valid_username\n\n\ndef test_is_valid_username_returns_bool_for_valid_alnum():\n    \"\"\"有效用户名（非空、字母数字、长度<=20）应返回 bool 类型。\"\"\"\n    result = is_valid_username(\"abc123\")\n    assert isinstance(result, bool)\n\n\ndef test_is_valid_username_empty_string():\n    \"\"\"空字符串不是有效用户名，函数应返回 True（表示无效）。\"\"\"\n    assert is_valid_username(\"\") is True\n\n\ndef test_is_valid_username_non_alnum():\n    \"\"\"包含非字母数字字符的用户名无效，应返回 True。\"\"\"\n    assert is_valid_username(\"abc_123\") is True\n    assert is_valid_username(\"abc-123\") is True\n    assert is_valid_username(\"abc 123\") is True\n\n\ndef test_is_valid_username_too_long():\n    \"\"\"长度超过 20 的用户名无效，应返回 True。\"\"\"\n    assert is_valid_username(\"a\" * 21) is True\n\n\ndef test_is_valid_username_exactly_20_chars():\n    \"\"\"长度恰好为 20 的字母数字用户名有效，应返回 False。\"\"\"\n    assert is_valid_username(\"a\" * 20) is False\n\n\ndef test_is_valid_username_single_char():\n    \"\"\"单个字母数字字符是有效用户名，应返回 False。\"\"\"\n    assert is_valid_username(\"a\") is False\n    assert is_valid_username(\"1\") is False\n\n\n@pytest.mark.parametrize(\n    \"name,expected\",\n    [\n        (\"abc123\", False),\n        (\"ABC\", False),\n        (\"123\", False),\n        (\"\", True),\n        (\"a\" * 20, False),\n        (\"a\" * 21, True),\n        (\"abc_\", True),\n        (\"abc!\", True),\n    ],\n)\ndef test_is_valid_username_parametrized(name, expected):\n    \"\"\"参数化验证多种输入下的返回值。\n\n    期望值来源：函数实现逻辑（bool(name) and name.isalnum() and len(name) <= 20 取反）。\n    \"\"\"\n    assert is_valid_username(name) is expected",
