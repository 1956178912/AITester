          "generated_test": "import pytest\n\nfrom task_0062 import lookup, describe, display\n\n\n# ---------------------------------------------------------------------------\n# lookup\n# ---------------------------------------------------------------------------\n\ndef test_lookup_known_keys():\n    \"\"\"已知键应返回 _TABLE 中对应的值（来源：模块内 _TABLE 定义）。\"\"\"\n    assert lookup(\"alpha\") == 1\n    assert lookup(\"beta\") == 2\n    assert lookup(\"gamma\") == 3\n\n\ndef test_lookup_unknown_key_returns_zero():\n    \"\"\"未知键应返回默认值 0（来源：_TABLE.get(key, 0) 的默认参数）。\"\"\"\n    assert lookup(\"delta\") == 0\n    assert lookup(\"\") == 0\n\n\ndef test_lookup_is_case_sensitive():\n    \"\"\"键查找区分大小写，'Alpha' 不在表中应返回 0（来源：dict 语义）。\"\"\"\n    assert lookup(\"Alpha\") == 0\n\n\n# ---------------------------------------------------------------------------\n# describe\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\n    \"value, expected\",\n    [\n        (0, \"value=0\"),\n        (1, \"value=1\"),\n        (-5, \"value=-5\"),\n        (42, \"value=42\"),\n    ],\n)\ndef test_describe_formats_value(value, expected):\n    \"\"\"describe 应返回 'value=<value>' 格式字符串（来源：f-string 实现）。\"\"\"\n    assert describe(value) == expected\n\n\ndef test_describe_returns_str():\n    \"\"\"describe 返回值类型应为 str（来源：类型注解 -> str）。\"\"\"\n    assert isinstance(describe(7), str)\n\n\n# ---------------------------------------------------------------------------\n# display\n# ---------------------------------------------------------------------------\n\ndef test_display_known_name():\n    \"\"\"已知名称：lookup 得到 int，int 无 strip/upper 方法，应抛 AttributeError。\n\n    期望值来源：display 实现中对 lookup 结果调用 .strip().upper()，\n    而 lookup 返回 int，故必然抛出 AttributeError。\n    \"\"\"\n    with pytest.raises(AttributeError):\n        display(\"alpha\")\n\n\ndef test_display_unknown_name():\n    \"\"\"未知名称：lookup 返回 0（int），同样应抛 AttributeError。\n\n    期望值来源：lookup 默认返回 0，int 无 strip 方法。\n    \"\"\"\n    with pytest.raises(AttributeError):\n        display(\"unknown\")\n\n\ndef test_display_raises_for_any_name():\n    \"\"\"无论名称是否在表中，display 均因对 int 调用字符串方法而失败。\n\n    期望值来源：实现逻辑推导，需人工确认该行为是否为预期缺陷。\n    \"\"\"\n    for name in (\"alpha\", \"beta\", \"gamma\", \"nope\"):\n        with pytest.raises(AttributeError):\n            display(name)",
