          "generated_test": "import pytest\n\nfrom task_0013 import binary_search\n\n\nclass TestBinarySearch:\n    \"\"\"Tests for binary_search function.\"\"\"\n\n    def test_binary_search_finds_element_in_middle(self):\n        \"\"\"Test that binary_search finds an element located in the middle of the array.\"\"\"\n        arr = [1, 3, 5, 7, 9]\n        assert binary_search(arr, 5) == 2\n\n    def test_binary_search_finds_first_element(self):\n        \"\"\"Test that binary_search finds the first element of the array.\"\"\"\n        arr = [1, 3, 5, 7, 9]\n        assert binary_search(arr, 1) == 0\n\n    def test_binary_search_finds_last_element(self):\n        \"\"\"Test that binary_search finds the last element of the array.\"\"\"\n        arr = [1, 3, 5, 7, 9]\n        assert binary_search(arr, 9) == 4\n\n    def test_binary_search_returns_minus_one_for_missing_element(self):\n        \"\"\"Test that binary_search returns -1 when the target is not present.\"\"\"\n        arr = [1, 3, 5, 7, 9]\n        assert binary_search(arr, 4) == -1\n\n    def test_binary_search_returns_minus_one_for_empty_array(self):\n        \"\"\"Test that binary_search returns -1 for an empty array.\"\"\"\n        assert binary_search([], 1) == -1\n\n    def test_binary_search_single_element_found(self):\n        \"\"\"Test that binary_search finds the only element in a single-element array.\"\"\"\n        assert binary_search([42], 42) == 0\n\n    def test_binary_search_single_element_not_found(self):\n        \"\"\"Test that binary_search returns -1 for a single-element array without the target.\"\"\"\n        assert binary_search([42], 7) == -1\n\n    def test_binary_search_target_smaller_than_all(self):\n        \"\"\"Test that binary_search returns -1 when target is smaller than all elements.\"\"\"\n        arr = [10, 20, 30, 40]\n        assert binary_search(arr, 5) == -1\n\n    def test_binary_search_target_larger_than_all(self):\n        \"\"\"Test that binary_search returns -1 when target is larger than all elements.\"\"\"\n        arr = [10, 20, 30, 40]\n        assert binary_search(arr, 50) == -1\n\n    def test_binary_search_two_elements_first(self):\n        \"\"\"Test that binary_search finds the first of two elements.\"\"\"\n        assert binary_search([1, 2], 1) == 0\n\n    def test_binary_search_two_elements_second(self):\n        \"\"\"Test that binary_search finds the second of two elements.\"\"\"\n        assert binary_search([1, 2], 2) == 1\n\n    def test_binary_search_negative_numbers(self):\n        \"\"\"Test that binary_search works with negative numbers.\"\"\"\n        arr = [-10, -5, 0, 5, 10]\n        assert binary_search(arr, -5) == 1\n        assert binary_search(arr, 0) == 2\n        assert binary_search(arr, 10) == 4\n\n    def test_binary_search_duplicate_elements_returns_a_valid_index(self):\n        \"\"\"Test that binary_search returns an index pointing to the target when duplicates exist.\"\"\"\n        arr = [1, 2, 2, 2, 3]\n        result = binary_search(arr, 2)\n        assert result != -1\n        assert arr[result] == 2\n\n    @pytest.mark.parametrize(\n        \"arr, target, expected\",\n        [\n            ([1, 3, 5, 7, 9, 11], 1, 0),\n            ([1, 3, 5, 7, 9, 11], 11, 5),\n            ([1, 3, 5, 7, 9, 11], 7, 3),\n            ([1, 3, 5, 7, 9, 11], 2, -1),\n            ([1, 3, 5, 7, 9, 11], 12, -1),\n            ([1, 3, 5, 7, 9, 11], 0, -1),\n        ],\n    )\n    def test_binary_search_parametrized(self, arr, target, expected):\n        \"\"\"Parametrized test covering found and not-found cases.\"\"\"\n        assert binary_search(arr, target) == expected\n\n    def test_binary_search_large_array(self):\n        \"\"\"Test that binary_search works on a large sorted array.\"\"\"\n        arr = list(range(0, 1000, 2))\n        assert binary_search(arr, 500) == 250\n        assert binary_search(arr, 501) == -1",
