          "generated_test": "import pytest\n\nfrom task_0039 import factorial\n\n\ndef test_factorial_zero_returns_one():\n    \"\"\"factorial(0) 应返回 1（依据函数实现与阶乘定义）。\"\"\"\n    assert factorial(0) == 1\n\n\n@pytest.mark.parametrize(\n    \"n, expected\",\n    [\n        (1, 1),\n        (2, 2),\n        (3, 6),\n        (4, 24),\n        (5, 120),\n        (6, 720),\n        (10, 3628800),\n    ],\n)\ndef test_factorial_positive_integers(n, expected):\n    \"\"\"正整数 n 的阶乘应等于 n!（期望值来自阶乘数学定义）。\"\"\"\n    assert factorial(n) == expected\n\n\ndef test_factorial_one_returns_one():\n    \"\"\"factorial(1) 应返回 1（依据函数实现与阶乘定义）。\"\"\"\n    assert factorial(1) == 1\n\n\ndef test_factorial_recursive_consistency():\n    \"\"\"对任意 n>0，应满足 factorial(n) == n * factorial(n-1)（递归关系）。\"\"\"\n    for n in range(1, 8):\n        assert factorial(n) == n * factorial(n - 1)\n\n\ndef test_factorial_negative_raises_recursion_error():\n    \"\"\"负数输入会导致无限递归，最终抛出 RecursionError。\n\n    期望值来源不明，需人工确认：函数未对负数做校验，\n    此处仅记录实际行为（RecursionError）。\n    \"\"\"\n    with pytest.raises(RecursionError):\n        factorial(-1)\n\n\ndef test_factorial_non_integer_float_raises_recursion_error():\n    \"\"\"非整数（如 2.5）会因 n == 0 永不成立而无限递归，抛出 RecursionError。\n\n    期望值来源不明，需人工确认：函数未做类型校验，\n    此处仅记录实际行为（RecursionError）。\n    \"\"\"\n    with pytest.raises(RecursionError):\n        factorial(2.5)",
