          "generated_test": "import pytest\n\nfrom task_0020 import normalize_values, aggregate, doubled\n\n\n# ---------------------------------------------------------------------------\n# normalize_values\n# ---------------------------------------------------------------------------\n\ndef test_normalize_values_empty_list_returns_empty_list():\n    \"\"\"空列表应返回空列表（历史 bug：曾返回 [0]）。\n\n    期望值来源：函数语义（对每个元素翻倍，不应凭空追加元素）。\n    \"\"\"\n    assert normalize_values([]) == []\n\n\ndef test_normalize_values_single_element():\n    \"\"\"单元素列表应翻倍，且不追加额外元素。\n\n    期望值来源：函数实现语义（v * 2）。\n    \"\"\"\n    assert normalize_values([3]) == [6]\n\n\ndef test_normalize_values_multiple_elements():\n    \"\"\"多元素列表应逐个翻倍，且不追加额外元素。\n\n    期望值来源：函数实现语义（v * 2）。\n    \"\"\"\n    assert normalize_values([1, 2, 3]) == [2, 4, 6]\n\n\ndef test_normalize_values_negative_and_zero():\n    \"\"\"负数与零应正确翻倍。\n\n    期望值来源：函数实现语义（v * 2）。\n    \"\"\"\n    assert normalize_values([0, -1, -5]) == [0, -2, -10]\n\n\ndef test_normalize_values_does_not_append_zero():\n    \"\"\"结果长度应与输入长度一致（历史 bug：多出一个 0）。\n\n    期望值来源：函数语义（逐元素映射，长度不变）。\n    \"\"\"\n    values = [1, 2, 3, 4]\n    result = normalize_values(values)\n    assert len(result) == len(values)\n\n\ndef test_normalize_values_returns_new_list():\n    \"\"\"应返回新列表，不修改输入列表。\n\n    期望值来源：函数语义（列表推导式生成新列表）。\n    \"\"\"\n    values = [1, 2, 3]\n    result = normalize_values(values)\n    assert result is not values\n    assert values == [1, 2, 3]\n\n\n# ---------------------------------------------------------------------------\n# aggregate\n# ---------------------------------------------------------------------------\n\ndef test_aggregate_empty_list_raises():\n    \"\"\"空列表应抛出异常（历史 bug：除零）。\n\n    期望值来源：函数实现 sum/len，空列表 len 为 0 导致 ZeroDivisionError。\n    \"\"\"\n    with pytest.raises(ZeroDivisionError):\n        aggregate([])\n\n\ndef test_aggregate_single_element():\n    \"\"\"单元素列表的平均值等于该元素。\n\n    期望值来源：平均值定义。\n    \"\"\"\n    assert aggregate([5]) == 5.0\n\n\ndef test_aggregate_multiple_elements():\n    \"\"\"多元素列表的平均值。\n\n    期望值来源：平均值定义 (1+2+3+4)/4 = 2.5。\n    \"\"\"\n    assert aggregate([1, 2, 3, 4]) == 2.5\n\n\ndef test_aggregate_negative_values():\n    \"\"\"含负数的平均值。\n\n    期望值来源：平均值定义 (-2 + 2)/2 = 0.0。\n    \"\"\"\n    assert aggregate([-2, 2]) == 0.0\n\n\ndef test_aggregate_returns_float():\n    \"\"\"返回值应为 float 类型。\n\n    期望值来源：类型注解 -> float。\n    \"\"\"\n    result = aggregate([1, 2])\n    assert isinstance(result, float)\n\n\n# ---------------------------------------------------------------------------\n# doubled\n# ---------------------------------------------------------------------------\n\ndef test_doubled_empty_list_returns_zero():\n    \"\"\"空列表应返回 0。\n\n    期望值来源：sum([], 0) = 0，再乘 2 仍为 0。\n    \"\"\"\n    assert doubled([]) == 0\n\n\ndef test_doubled_single_element():\n    \"\"\"单元素列表应返回其两倍。\n\n    期望值来源：2 * sum(values, 0)。\n    \"\"\"\n    assert doubled([3]) == 6\n\n\ndef test_doubled_multiple_elements():\n    \"\"\"多元素列表应返回总和的两倍。\n\n    期望值来源：2 * sum([1,2,3], 0) = 12。\n    \"\"\"\n    assert doubled([1, 2, 3]) == 12\n\n\ndef test_doubled_negative_values():\n    \"\"\"含负数的列表应返回总和的两倍。\n\n    期望值来源：2 * sum([-1, -2], 0) = -6。\n    \"\"\"\n    assert doubled([-1, -2]) == -6\n\n\ndef test_doubled_returns_float():\n    \"\"\"返回值应为 float 类型（历史 bug：int 混用未归一化 float）。\n\n    期望值来源：类型注解 -> float。\n    \"\"\"\n    result = doubled([1, 2, 3])\n    assert isinstance(result, float)",
