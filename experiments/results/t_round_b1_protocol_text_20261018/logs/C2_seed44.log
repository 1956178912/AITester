          "generated_test": "import math\n\nimport pytest\n\nfrom task_0058 import rounded_ratio\n\n\ndef test_rounded_ratio_zero_total_returns_zero():\n    \"\"\"total 为 0 时应返回 0.0（依据 docstring/实现约定）。\"\"\"\n    assert rounded_ratio(5, 0) == 0.0\n\n\ndef test_rounded_ratio_zero_hit_returns_zero():\n    \"\"\"hit 为 0 时比例应为 0.0。\"\"\"\n    assert rounded_ratio(0, 10) == 0.0\n\n\ndef test_rounded_ratio_full_hit_returns_one():\n    \"\"\"hit 等于 total 时比例应为 1.0。\"\"\"\n    assert rounded_ratio(10, 10) == 1.0\n\n\ndef test_rounded_ratio_half_returns_half():\n    \"\"\"hit 为 total 一半时比例应为 0.5。\"\"\"\n    assert rounded_ratio(5, 10) == 0.5\n\n\ndef test_rounded_ratio_floors_to_two_decimals():\n    \"\"\"结果应向下取整到两位小数：1/3*100 = 33.333... -> 0.33。\"\"\"\n    assert rounded_ratio(1, 3) == 0.33\n\n\ndef test_rounded_ratio_floors_not_rounds():\n    \"\"\"应向下取整而非四舍五入：2/3*100 = 66.666... -> 0.66。\"\"\"\n    assert rounded_ratio(2, 3) == 0.66\n\n\ndef test_rounded_ratio_exact_two_decimals():\n    \"\"\"恰好两位小数的比例应保持不变：1/4 = 0.25。\"\"\"\n    assert rounded_ratio(1, 4) == 0.25\n\n\ndef test_rounded_ratio_returns_float_type():\n    \"\"\"返回值类型应为 float。\"\"\"\n    result = rounded_ratio(1, 2)\n    assert isinstance(result, float)\n\n\ndef test_rounded_ratio_zero_total_returns_float_type():\n    \"\"\"total 为 0 时返回值也应为 float。\"\"\"\n    result = rounded_ratio(0, 0)\n    assert isinstance(result, float)\n    assert result == 0.0\n\n\n@pytest.mark.parametrize(\n    \"hit,total,expected\",\n    [\n        (0, 1, 0.0),\n        (1, 1, 1.0),\n        (1, 2, 0.5),\n        (1, 4, 0.25),\n        (3, 4, 0.75),\n        (1, 3, 0.33),\n        (2, 3, 0.66),\n        (1, 10, 0.1),\n        (9, 10, 0.9),\n        (1, 100, 0.01),\n        (99, 100, 0.99),\n    ],\n)\ndef test_rounded_ratio_parametrized_values(hit, total, expected):\n    \"\"\"参数化验证常见比例值，期望值依据 floor(hit/total*100)/100 计算。\"\"\"\n    assert rounded_ratio(hit, total) == expected\n\n\n@pytest.mark.parametrize(\"total\", [1, 2, 3, 7, 10, 100])\ndef test_rounded_ratio_result_within_bounds(total):\n    \"\"\"对于 0 <= hit <= total，结果应在 [0.0, 1.0] 区间内。\"\"\"\n    for hit in range(total + 1):\n        result = rounded_ratio(hit, total)\n        assert 0.0 <= result <= 1.0\n\n\ndef test_rounded_ratio_matches_floor_formula():\n    \"\"\"结果应与 math.floor(hit/total*100)/100 一致（依据实现约定）。\"\"\"\n    hit, total = 7, 9\n    expected = math.floor(hit / total * 100) / 100\n    assert rounded_ratio(hit, total) == expected",
