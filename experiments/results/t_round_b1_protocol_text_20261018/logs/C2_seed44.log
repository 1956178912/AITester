          "generated_test": "import pytest\n\nfrom task_0085 import compute_scores, average, rank_top\n\n\n# ---------------------------------------------------------------------------\n# compute_scores\n# ---------------------------------------------------------------------------\n\ndef test_compute_scores_basic():\n    \"\"\"compute_scores 应将每条记录的 name 映射到 value。\"\"\"\n    records = [\n        {\"name\": \"a\", \"value\": 10},\n        {\"name\": \"b\", \"value\": 20},\n    ]\n    assert compute_scores(records) == {\"a\": 10, \"b\": 20}\n\n\ndef test_compute_scores_empty_list():\n    \"\"\"空记录列表应返回空字典。\"\"\"\n    assert compute_scores([]) == {}\n\n\ndef test_compute_scores_missing_name_uses_unknown():\n    \"\"\"缺少 name 字段时，key 应为 'unknown'（来自源码默认值）。\"\"\"\n    records = [{\"value\": 5}]\n    assert compute_scores(records) == {\"unknown\": 5}\n\n\ndef test_compute_scores_missing_value_uses_zero():\n    \"\"\"缺少 value 字段时，value 应为 0（来自源码默认值）。\"\"\"\n    records = [{\"name\": \"x\"}]\n    assert compute_scores(records) == {\"x\": 0}\n\n\ndef test_compute_scores_duplicate_name_last_wins():\n    \"\"\"同名记录后出现的 value 覆盖先前的值。\"\"\"\n    records = [\n        {\"name\": \"a\", \"value\": 1},\n        {\"name\": \"a\", \"value\": 2},\n    ]\n    assert compute_scores(records) == {\"a\": 2}\n\n\ndef test_compute_scores_returns_dict():\n    \"\"\"返回值类型应为 dict。\"\"\"\n    result = compute_scores([{\"name\": \"a\", \"value\": 1}])\n    assert isinstance(result, dict)\n\n\n# ---------------------------------------------------------------------------\n# average\n# ---------------------------------------------------------------------------\n\ndef test_average_empty_dict_returns_zero():\n    \"\"\"空字典的平均值应为 0.0（来自源码显式返回）。\"\"\"\n    assert average({}) == 0.0\n\n\ndef test_average_single_value():\n    \"\"\"单个值的平均值等于该值。\"\"\"\n    assert average({\"a\": 10}) == 10.0\n\n\ndef test_average_multiple_values():\n    \"\"\"多个值的平均值等于总和除以数量。\"\"\"\n    assert average({\"a\": 10, \"b\": 20, \"c\": 30}) == 20.0\n\n\ndef test_average_returns_float():\n    \"\"\"返回值类型应为 float。\"\"\"\n    result = average({\"a\": 1, \"b\": 2})\n    assert isinstance(result, float)\n\n\ndef test_average_zero_values():\n    \"\"\"所有值为 0 时平均值为 0.0。\"\"\"\n    assert average({\"a\": 0, \"b\": 0}) == 0.0\n\n\n# ---------------------------------------------------------------------------\n# rank_top\n# ---------------------------------------------------------------------------\n\ndef test_rank_top_basic_order():\n    \"\"\"rank_top 应按 value 降序返回 (key, value) 元组列表。\"\"\"\n    scores = {\"a\": 1, \"b\": 3, \"c\": 2}\n    assert rank_top(scores, 3) == [(\"b\", 3), (\"c\", 2), (\"a\", 1)]\n\n\ndef test_rank_top_limits_to_k():\n    \"\"\"rank_top 应只返回前 k 个元素。\"\"\"\n    scores = {\"a\": 1, \"b\": 3, \"c\": 2}\n    assert rank_top(scores, 2) == [(\"b\", 3), (\"c\", 2)]\n\n\ndef test_rank_top_k_larger_than_size():\n    \"\"\"k 大于字典大小时返回全部元素。\"\"\"\n    scores = {\"a\": 1, \"b\": 2}\n    assert rank_top(scores, 10) == [(\"b\", 2), (\"a\", 1)]\n\n\ndef test_rank_top_k_zero_returns_empty():\n    \"\"\"k 为 0 时返回空列表。\"\"\"\n    scores = {\"a\": 1, \"b\": 2}\n    assert rank_top(scores, 0) == []\n\n\ndef test_rank_top_empty_scores():\n    \"\"\"空字典应返回空列表。\"\"\"\n    assert rank_top({}, 5) == []\n\n\ndef test_rank_top_returns_list():\n    \"\"\"返回值类型应为 list。\"\"\"\n    result = rank_top({\"a\": 1}, 1)\n    assert isinstance(result, list)\n\n\ndef test_rank_top_negative_k():\n    \"\"\"k 为负数时按切片语义返回除末尾外的元素（期望值来源不明，需人工确认）。\"\"\"\n    scores = {\"a\": 1, \"b\": 2, \"c\": 3}\n    # 源码使用 items[:k]，负 k 会截断末尾元素\n    assert rank_top(scores, -1) == [(\"c\", 3), (\"b\", 2)]",
