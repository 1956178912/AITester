          "generated_test": "import pytest\n\nfrom task_0057 import mark_positions\n\n\ndef test_mark_positions_basic_marks():\n    \"\"\"基本用例：字符出现在前 len(text)-1 个位置时，对应位置记录索引，其余为 -1。\"\"\"\n    text = \"abca\"\n    ch = \"a\"\n    # 期望值来源：函数实现逻辑，遍历 range(len(text)-1)，匹配则记录 i，否则 -1\n    assert mark_positions(text, ch) == [0, -1, -1]\n\n\ndef test_mark_positions_ignores_last_character():\n    \"\"\"边界用例：最后一个字符即使匹配也不会被标记，因为循环范围是 len(text)-1。\"\"\"\n    text = \"xyzx\"\n    ch = \"x\"\n    # 期望值来源：函数实现逻辑，最后一个位置不参与遍历\n    assert mark_positions(text, ch) == [0, -1, -1]\n\n\ndef test_mark_positions_no_match():\n    \"\"\"无匹配字符时，所有位置均为 -1。\"\"\"\n    text = \"hello\"\n    ch = \"z\"\n    # 期望值来源：函数实现逻辑，无匹配则全部追加 -1\n    assert mark_positions(text, ch) == [-1, -1, -1, -1]\n\n\ndef test_mark_positions_all_match():\n    \"\"\"所有参与遍历的位置都匹配时，返回连续索引列表。\"\"\"\n    text = \"aaaa\"\n    ch = \"a\"\n    # 期望值来源：函数实现逻辑，前 3 个位置均匹配\n    assert mark_positions(text, ch) == [0, 1, 2]\n\n\ndef test_mark_positions_empty_string():\n    \"\"\"空字符串输入时，循环不执行，返回空列表。\"\"\"\n    # 期望值来源：函数实现逻辑，range(-1) 为空\n    assert mark_positions(\"\", \"a\") == []\n\n\ndef test_mark_positions_single_character():\n    \"\"\"单字符字符串输入时，循环不执行，返回空列表。\"\"\"\n    # 期望值来源：函数实现逻辑，range(0) 为空\n    assert mark_positions(\"a\", \"a\") == []\n\n\ndef test_mark_positions_two_characters():\n    \"\"\"两字符字符串输入时，仅检查第一个字符。\"\"\"\n    text = \"ab\"\n    ch = \"b\"\n    # 期望值来源：函数实现逻辑，仅遍历索引 0\n    assert mark_positions(text, ch) == [-1]\n\n\ndef test_mark_positions_two_characters_match_first():\n    \"\"\"两字符字符串输入且第一个字符匹配时，返回 [0]。\"\"\"\n    text = \"ab\"\n    ch = \"a\"\n    # 期望值来源：函数实现逻辑，仅遍历索引 0 且匹配\n    assert mark_positions(text, ch) == [0]\n\n\n@pytest.mark.parametrize(\n    \"text, ch, expected\",\n    [\n        (\"banana\", \"a\", [-1, 1, -1, 3, -1]),\n        (\"banana\", \"n\", [-1, -1, 2, -1, 4]),\n        (\"abcabc\", \"c\", [-1, -1, 2, -1, -1]),\n        (\"mississippi\", \"s\", [-1, -1, 2, 3, -1, 5, 6, -1, -1, -1]),