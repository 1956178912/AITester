          "generated_test": "import datetime\nimport pytest\n\nfrom task_0038 import parse_date, days_until, is_expired\n\n\n# ---------------------------------------------------------------------------\n# parse_date\n# ---------------------------------------------------------------------------\n\ndef test_parse_date_valid_date_returns_datetime():\n    \"\"\"Valid ISO date string should parse to the corresponding datetime.\"\"\"\n    result = parse_date(\"2024-01-15\")\n    assert isinstance(result, datetime.datetime)\n    assert result == datetime.datetime(2024, 1, 15)\n\n\ndef test_parse_date_invalid_format_returns_datetime_min():\n    \"\"\"Invalid format should fall back to datetime.min (per implementation).\"\"\"\n    result = parse_date(\"15/01/2024\")\n    assert result == datetime.datetime.min\n\n\ndef test_parse_date_empty_string_returns_datetime_min():\n    \"\"\"Empty string is invalid and should return datetime.min.\"\"\"\n    result = parse_date(\"\")\n    assert result == datetime.datetime.min\n\n\ndef test_parse_date_non_date_string_returns_datetime_min():\n    \"\"\"A non-date string should return datetime.min.\"\"\"\n    result = parse_date(\"not-a-date\")\n    assert result == datetime.datetime.min\n\n\ndef test_parse_date_impossible_date_returns_datetime_min():\n    \"\"\"An impossible calendar date (Feb 30) should return datetime.min.\"\"\"\n    result = parse_date(\"2024-02-30\")\n    assert result == datetime.datetime.min\n\n\n@pytest.mark.parametrize(\n    \"value\",\n    [\"2024-1-5\", \"2024-01-5\", \"2024-1-05\", \"2024/01/05\", \"20240105\"],\n)\ndef test_parse_date_various_invalid_formats_return_datetime_min(value):\n    \"\"\"Strings not matching %Y-%m-%d exactly should return datetime.min.\"\"\"\n    assert parse_date(value) == datetime.datetime.min\n\n\ndef test_parse_date_leap_day_valid():\n    \"\"\"A valid leap day should parse correctly.\"\"\"\n    result = parse_date(\"2024-02-29\")\n    assert result == datetime.datetime(2024, 2, 29)\n\n\ndef test_parse_date_non_leap_day_invalid():\n    \"\"\"Feb 29 in a non-leap year is invalid and should return datetime.min.\"\"\"\n    result = parse_date(\"2023-02-29\")\n    assert result == datetime.datetime.min\n\n\n# ---------------------------------------------------------------------------\n# days_until\n# ---------------------------------------------------------------------------\n\ndef test_days_until_future_date_positive():\n    \"\"\"A date far in the future should yield a positive day count.\"\"\"\n    future = (datetime.datetime.now() + datetime.timedelta(days=10)).strftime(\"%Y-%m-%d\")\n    result = days_until(future)\n    # Expected value derived from implementation: delta.days of (parsed - now).\n    # Because of time-of-day truncation the value is 9 or 10.\n    assert result in (9, 10)\n\n\ndef test_days_until_past_date_negative():\n    \"\"\"A date in the past should yield a negative day count.\"\"\"\n    past = (datetime.datetime.now() - datetime.timedelta(days=10)).strftime(\"%Y-%m-%d\")\n    result = days_until(past)\n    assert result in (-10, -11)\n\n\ndef test_days_until_invalid_date_returns_large_negative():\n    \"\"\"Invalid date parses to datetime.min, so days_until should be very negative.\"\"\"\n    result = days_until(\"invalid\")\n    assert result < 0\n\n\ndef test_days_until_today_is_zero_or_negative():\n    \"\"\"Today's date should yield 0 or -1 depending on current time of day.\n\n    Expected value source: implementation uses delta.days of (midnight - now),\n    which is 0 before midnight and -1 after midnight of the same day.\n    \"\"\"\n    today = datetime.datetime.now().strftime(\"%Y-%m-%d\")\n    result = days_until(today)\n    assert result in (0, -1)\n\n\n# ---------------------------------------------------------------------------\n# is_expired\n# ---------------------------------------------------------------------------\n\ndef test_is_expired_past_date_true():\n    \"\"\"A past date should be reported as expired.\"\"\"\n    past = (datetime.datetime.now() - datetime.timedelta(days=5)).strftime(\"%Y-%m-%d\")\n    assert is_expired(past) is True\n\n\ndef test_is_expired_future_date_false():\n    \"\"\"A future date should not be reported as expired.\"\"\"\n    future = (datetime.datetime.now() + datetime.timedelta(days=5)).strftime(\"%Y-%m-%d\")\n    assert is_expired(future) is False\n\n\ndef test_is_expired_invalid_date_true():\n    \"\"\"Invalid date parses to datetime.min, which is in the past -> expired.\"\"\"\n    assert is_expired(\"garbage\") is True\n\n\ndef test_is_expired_consistency_with_days_until():\n    \"\"\"is_expired should be consistent with days_until < 0.\"\"\"\n    for value in [\"2000-01-01\", \"2999-12-31\", \"bad-input\"]:\n        assert is_expired(value) == (days_until(value) < 0)",
