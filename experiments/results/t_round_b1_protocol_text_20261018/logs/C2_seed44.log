          "generated_test": "import pytest\n\nfrom task_0061 import process\n\n\ndef test_process_returns_list():\n    \"\"\"process 应返回 list 类型。\"\"\"\n    result = process([1, 2, 3])\n    assert isinstance(result, list)\n\n\ndef test_process_increments_each_element():\n    \"\"\"process 应对每个元素加 1（依据函数实现）。\"\"\"\n    assert process([1, 2, 3]) == [2, 3, 4, 0]\n\n\ndef test_process_appends_zero():\n    \"\"\"process 应在结果末尾追加 0（依据函数实现）。\"\"\"\n    result = process([5])\n    assert result[-1] == 0\n\n\ndef test_process_empty_list():\n    \"\"\"空列表输入应返回仅含末尾 0 的列表。\"\"\"\n    assert process([]) == [0]\n\n\ndef test_process_negative_numbers():\n    \"\"\"负数元素也应加 1。\"\"\"\n    assert process([-1, -2]) == [0, -1, 0]\n\n\ndef test_process_does_not_mutate_input():\n    \"\"\"process 不应修改传入的列表。\"\"\"\n    items = [1, 2, 3]\n    process(items)\n    assert items == [1, 2, 3]\n\n\ndef test_process_output_length():\n    \"\"\"输出长度应为输入长度加 1（末尾追加 0）。\"\"\"\n    items = [10, 20, 30, 40]\n    assert len(process(items)) == len(items) + 1\n\n\n@pytest.mark.parametrize(\n    \"items, expected\",\n    [\n        ([0], [1, 0]),\n        ([1, 1, 1], [2, 2, 2, 0]),\n        ([100], [101, 0]),\n    ],\n)\ndef test_process_parametrized(items, expected):\n    \"\"\"参数化验证 process 的加 1 与追加 0 行为。\"\"\"\n    assert process(items) == expected\n\n\ndef test_process_non_int_raises_type_error():\n    \"\"\"对非数值元素执行 +1 应抛出 TypeError（依据实现行为）。\"\"\"\n    with pytest.raises(TypeError):\n        process([\"a\"])",
