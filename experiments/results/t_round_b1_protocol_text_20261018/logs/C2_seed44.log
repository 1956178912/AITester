          "generated_test": "import pytest\n\nfrom task_0065 import compare, sort_desc, top_k\n\n\n# ---------------------------------------------------------------------------\n# compare\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\n    \"a, b, expected\",\n    [\n        (5, 3, 1),\n        (3, 5, -1),\n        (4, 4, 0),\n        (0, 0, 0),\n        (-1, -2, 1),\n        (-2, -1, -1),\n        (0, -1, 1),\n        (-1, 0, -1),\n        (10**9, 10**9, 0),\n    ],\n)\ndef test_compare_returns_expected_ordering(a, b, expected):\n    \"\"\"compare 应返回 1/0/-1 表示 a>b / a==b / a<b（来源：docstring 与实现）。\"\"\"\n    assert compare(a, b) == expected\n\n\ndef test_compare_is_antisymmetric():\n    \"\"\"compare(a, b) 与 compare(b, a) 应互为相反数（来源：实现逻辑）。\"\"\"\n    pairs = [(1, 2), (2, 1), (7, 7), (-3, 4), (0, 0)]\n    for a, b in pairs:\n        assert compare(a, b) == -compare(b, a)\n\n\n# ---------------------------------------------------------------------------\n# sort_desc\n# ---------------------------------------------------------------------------\n\ndef test_sort_desc_sorts_ascending():\n    \"\"\"sort_desc 实际按升序排序（函数名暗示降序，但实现为升序；期望值来源：实现行为，需人工确认）。\"\"\"\n    assert sort_desc([3, 1, 2]) == [1, 2, 3]\n\n\ndef test_sort_desc_empty_list():\n    \"\"\"空列表应返回空列表（来源：实现逻辑）。\"\"\"\n    assert sort_desc([]) == []\n\n\ndef test_sort_desc_single_element():\n    \"\"\"单元素列表应原样返回（来源：实现逻辑）。\"\"\"\n    assert sort_desc([42]) == [42]\n\n\ndef test_sort_desc_with_duplicates():\n    \"\"\"含重复元素的列表应正确排序（来源：实现逻辑）。\"\"\"\n    assert sort_desc([2, 2, 1, 3, 1]) == [1, 1, 2, 2, 3]\n\n\ndef test_sort_desc_with_negatives():\n    \"\"\"含负数的列表应正确排序（来源：实现逻辑）。\"\"\"\n    assert sort_desc([0, -5, 3, -1]) == [-5, -1, 0, 3]\n\n\ndef test_sort_desc_already_sorted():\n    \"\"\"已升序的列表应保持不变（来源：实现逻辑）。\"\"\"\n    assert sort_desc([1, 2, 3, 4]) == [1, 2, 3, 4]\n\n\ndef test_sort_desc_reverse_sorted():\n    \"\"\"降序列表应被排成升序（来源：实现逻辑）。\"\"\"\n    assert sort_desc([4, 3, 2, 1]) == [1, 2, 3, 4]\n\n\ndef test_sort_desc_mutates_input_in_place():\n    \"\"\"sort_desc 原地修改并返回同一列表对象（来源：实现逻辑）。\"\"\"\n    arr = [3, 1, 2]\n    result = sort_desc(arr)\n    assert result is arr\n    assert arr == [1, 2, 3]\n\n\n# ---------------------------------------------------------------------------\n# top_k\n# ---------------------------------------------------------------------------\n\ndef test_top_k_k_zero_returns_empty():\n    \"\"\"k <= 0 时应返回空列表（来源：实现逻辑）。\"\"\"\n    assert top_k([1, 2, 3], 0) == []\n\n\ndef test_top_k_negative_k_returns_empty():\n    \"\"\"k 为负数时应返回空列表（来源：实现逻辑）。\"\"\"\n    assert top_k([1, 2, 3], -1) == []\n\n\ndef test_top_k_k_ge_length_returns_full_sorted():\n    \"\"\"k >= len(arr) 时应返回完整排序结果（来源：实现逻辑）。\"\"\"\n    assert top_k([3, 1, 2], 3) == [1, 2, 3]\n    assert top_k([3, 1, 2], 5) == [1, 2, 3]\n\n\ndef test_top_k_returns_first_k_of_sorted():\n    \"\"\"0 < k < len(arr) 时应返回排序后的前 k 个元素（来源：实现逻辑）。\"\"\"\n    assert top_k([5, 1, 4, 2, 3], 2) == [1, 2]\n\n\ndef test_top_k_empty_list():\n    \"\"\"空列表任意 k 应返回空列表（来源：实现逻辑）。\"\"\"\n    assert top_k([], 0) == []\n    assert top_k([], 3) == []\n\n\ndef test_top_k_with_duplicates():\n    \"\"\"含重复元素时前 k 个应正确（来源：实现逻辑）。\"\"\"\n    assert top_k([2, 2, 1, 3], 3) == [1, 2, 2]\n\n\ndef test_top_k_with_negatives():\n    \"\"\"含负数时前 k 个应正确（来源：实现逻辑）。\"\"\"\n    assert top_k([0, -5, 3, -1], 2) == [-5, -1]",
