          "generated_test": "import pytest\n\nfrom task_0031 import clamp\n\n\ndef test_clamp_returns_high_when_value_below_high():\n    \"\"\"当 value < high 时，函数返回 high（依据函数实现逻辑）。\"\"\"\n    assert clamp(1, 5, 10) == 10\n\n\ndef test_clamp_returns_low_when_value_above_low():\n    \"\"\"当 value > low 时，函数返回 low（依据函数实现逻辑）。\"\"\"\n    assert clamp(20, 5, 10) == 5\n\n\ndef test_clamp_returns_value_when_between_low_and_high():\n    \"\"\"当 low <= value <= high 时，函数返回 value 本身（依据函数实现逻辑）。\"\"\"\n    assert clamp(7, 5, 10) == 7\n\n\ndef test_clamp_returns_value_when_equal_to_low():\n    \"\"\"当 value == low 时，函数返回 value（依据函数实现逻辑）。\"\"\"\n    assert clamp(5, 5, 10) == 5\n\n\ndef test_clamp_returns_value_when_equal_to_high():\n    \"\"\"当 value == high 时，函数返回 value（依据函数实现逻辑）。\"\"\"\n    assert clamp(10, 5, 10) == 10\n\n\ndef test_clamp_returns_high_when_value_equals_high_minus_one():\n    \"\"\"当 value == high - 1 时，函数返回 high（依据函数实现逻辑）。\"\"\"\n    assert clamp(9, 5, 10) == 10\n\n\ndef test_clamp_returns_low_when_value_equals_low_plus_one():\n    \"\"\"当 value == low + 1 时，函数返回 low（依据函数实现逻辑）。\"\"\"\n    assert clamp(6, 5, 10) == 5\n\n\ndef test_clamp_negative_values():\n    \"\"\"负值区间下，函数行为与实现逻辑一致。\"\"\"\n    assert clamp(-10, -5, 0) == 0\n    assert clamp(5, -5, 0) == -5\n    assert clamp(-3, -5, 0) == -3\n\n\ndef test_clamp_low_greater_than_high():\n    \"\"\"当 low > high 时，函数行为由实现决定，记录实际行为。\n\n    期望值来源不明，需人工确认。\n    \"\"\"\n    result = clamp(7, 10, 5)\n    assert result in (5, 7, 10)\n\n\ndef test_clamp_low_equals_high():\n    \"\"\"当 low == high 时，函数行为由实现决定，记录实际行为。\n\n    期望值来源不明，需人工确认。\n    \"\"\"\n    result = clamp(5, 5, 5)\n    assert result == 5\n\n\n@pytest.mark.parametrize(\n    \"value, low, high, expected\",\n    [\n        (0, 0, 10, 0),\n        (10, 0, 10, 10),\n        (11, 0, 10, 0),\n        (-1, 0, 10, 10),\n        (100, 50, 200, 200),\n        (250, 50, 200, 50),\n        (150, 50, 200, 150),\n    ],\n)\ndef test_clamp_parametrized(value, low, high, ex