          "generated_test": "import pytest\n\nfrom task_0045 import process\n\n\ndef test_process_returns_list():\n    \"\"\"process 应返回 list 类型（依据函数返回类型注解 list）。\"\"\"\n    result = process([1, 2, 3])\n    assert isinstance(result, list)\n\n\ndef test_process_increments_each_element():\n    \"\"\"process 应对每个元素加 1（依据函数实现约定）。\"\"\"\n    assert process([1, 2, 3]) == [2, 3, 4, 0]\n\n\ndef test_process_appends_zero_at_end():\n    \"\"\"process 应在结果末尾追加一个 0（依据函数实现约定）。\"\"\"\n    result = process([5, 6])\n    assert result[-1] == 0\n    assert result == [6, 7, 0]\n\n\ndef test_process_empty_list():\n    \"\"\"空列表输入应只返回 [0]（依据函数实现约定）。\"\"\"\n    assert process([]) == [0]\n\n\ndef test_process_single_element():\n    \"\"\"单元素列表应返回 [x+1, 0]（依据函数实现约定）。\"\"\"\n    assert process([10]) == [11, 0]\n\n\ndef test_process_negative_numbers():\n    \"\"\"负数元素也应加 1（依据函数实现约定）。\"\"\"\n    assert process([-1, -2]) == [0, -1, 0]\n\n\ndef test_process_does_not_mutate_input():\n    \"\"\"process 不应修改传入的原始列表（依据列表推导式实现约定）。\"\"\"\n    original = [1, 2, 3]\n    process(original)\n    assert original == [1, 2, 3]\n\n\ndef test_process_output_length():\n    \"\"\"输出长度应为输入长度加 1（依据函数实现约定）。\"\"\"\n    items = [1, 2, 3, 4]\n    assert len(process(items)) == len(items) + 1\n\n\n@pytest.mark.parametrize(\n    \"items, expected\",\n    [\n        ([0], [1, 0]),\n        ([1, 1, 1], [2, 2, 2, 0]),\n        ([100], [101, 0]),\n    ],\n)\ndef test_process_parametrized(items, expected):\n    \"\"\"参数化验证 process 的加 1 与追加 0 行为（依据函数实现约定）。\"\"\"\n    assert process(items) == expected\n\n\ndef test_process_non_list_input_raises():\n    \"\"\"传入非可迭代对象时应抛出 TypeError（依据列表推导式对可迭代性的要求）。\"\"\"\n    with pytest.raises(TypeError):\n        process(123)",
