          "generated_test": "import pytest\n\nfrom task_0063 import distance\n\n\ndef test_distance_returns_difference_of_two_ints():\n    \"\"\"distance(a, b) 应返回 a - b（依据函数实现与类型注解）。\"\"\"\n    assert distance(5, 3) == 2\n\n\ndef test_distance_with_equal_arguments_returns_zero():\n    \"\"\"当 a == b 时，a - b 应为 0。\"\"\"\n    assert distance(7, 7) == 0\n\n\ndef test_distance_with_negative_result():\n    \"\"\"当 a < b 时，结果应为负数，等于 a - b。\"\"\"\n    assert distance(3, 5) == -2\n\n\ndef test_distance_with_negative_operands():\n    \"\"\"负数操作数时结果仍为 a - b。\"\"\"\n    assert distance(-4, -6) == 2\n    assert distance(-4, 6) == -10\n\n\ndef test_distance_with_zero_operands():\n    \"\"\"零操作数时结果符合 a - b。\"\"\"\n    assert distance(0, 0) == 0\n    assert distance(0, 9) == -9\n    assert distance(9, 0) == 9\n\n\n@pytest.mark.parametrize(\n    \"a, b, expected\",\n    [\n        (10, 4, 6),\n        (4, 10, -6),\n        (100, 100, 0),\n        (-1, 1, -2),\n        (1, -1, 2),\n        (2**31 - 1, 1, 2**31 - 2),\n    ],\n)\ndef test_distance_parametrized(a, b, expected):\n    \"\"\"参数化验证 distance 返回 a - b（期望值来源：函数实现 a - b）。\"\"\"\n    assert distance(a, b) == expected\n\n\ndef test_distance_does_not_mutate_inputs():\n    \"\"\"distance 为纯函数，调用后输入值不变。\"\"\"\n    a, b = 12, 5\n    distance(a, b)\n    assert (a, b) == (12, 5)\n\n\ndef test_distance_with_non_int_raises_type_error():\n    \"\"\"传入非整数时，减法运算应抛出 TypeError（期望值来源：Python 运算语义）。\"\"\"\n    with pytest.raises(TypeError):\n        distance(\"a\", 1)",
