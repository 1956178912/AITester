sort_desc_already_sorted():\n    \"\"\"已排序（升序）列表应保持不变。\"\"\"\n    assert sort_desc([1, 2, 3, 4]) == [1, 2, 3, 4]\n\n\n# ---------------------------------------------------------------------------\n# top_k\n# ---------------------------------------------------------------------------\n\ndef test_top_k_k_zero_returns_empty():\n    \"\"\"k <= 0 时应返回空列表。\"\"\"\n    assert top_k([1, 2, 3], 0) == []\n\n\ndef test_top_k_k_negative_returns_empty():\n    \"\"\"k 为负数时应返回空列表。\"\"\"\n    assert top_k([1, 2, 3], -5) == []\n\n\ndef test_top_k_k_ge_length_returns_full_sorted():\n    \"\"\"k >= len(arr) 时应返回整个排序后的列表（升序，依据实际实现）。\"\"\"\n    assert top_k([3, 1, 2], 3) == [1, 2, 3]\n    assert top_k([3, 1, 2], 10) == [1, 2, 3]\n\n\ndef test_top_k_returns_first_k_of_sorted():\n    \"\"\"0 < k < len(arr) 时应返回排序后列表的前 k 个元素（升序，依据实际实现）。\"\"\"\n    assert top_k([5, 3, 1, 4, 2], 2) == [1, 2]\n\n\ndef test_top_k_empty_list():\n    \"\"\"空列表且 k>0 时，k >= len(arr) 分支返回空列表。\"\"\"\n    assert top_k([], 3) == []\n\n\ndef test_top_k_k_equals_one():\n    \"\"\"k=1 时应返回排序后的最小元素（依据实际升序实现）。\"\"\"\n    assert top_k([9, 4, 7], 1) == [4]\n\n\ndef test_top_k_with_duplicates():\n    \"\"\"含重复元素时，返回排序后前 k 个元素。\"\"\"\n    assert top_k([2, 2, 1, 3], 2) == [1, 2]",
