([-2, 2]) == pytest.approx(0.0)\n\n\ndef test_aggregate_empty_list_raises_zero_division():\n    \"\"\"空列表输入：实现执行 sum/len 会触发 ZeroDivisionError。\n\n    期望值来源不明，需人工确认：docstring 未定义空列表行为，\n    此处记录实际行为（历史 bug 注释指出空列表除零）。\n    \"\"\"\n    with pytest.raises(ZeroDivisionError):\n        aggregate([])\n\n\n# ---------------------------------------------------------------------------\n# doubled\n# ---------------------------------------------------------------------------\n\ndef test_doubled_basic():\n    \"\"\"doubled 返回元素和的 2 倍。\"\"\"\n    assert doubled([1, 2, 3]) == 12\n\n\ndef test_doubled_empty_list_returns_zero():\n    \"\"\"空列表：sum(values, 0) 为 0，结果应为 0。\"\"\"\n    assert doubled([]) == 0\n\n\ndef test_doubled_single_element():\n    \"\"\"单元素列表：2 * 元素。\"\"\"\n    assert doubled([5]) == 10\n\n\ndef test_doubled_negative_values():\n    \"\"\"含负数：2 * 和。\"\"\"\n    assert doubled([-1, -2, 3]) == 0\n\n\ndef test_doubled_floats():\n    \"\"\"浮点列表：2 * 和。\"\"\"\n    assert doubled([0.5, 1.5]) == pytest.approx(4.0)\n\n\ndef test_doubled_returns_numeric():\n    \"\"\"返回值应为数值类型（int 或 float）。\"\"\"\n    result = doubled([1, 2])\n    assert isinstance(result, (int, float))",
