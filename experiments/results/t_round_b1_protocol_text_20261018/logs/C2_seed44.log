          "generated_test": "import pytest\n\nfrom task_0006 import normalize, aggregate, report\n\n\n# ---------------------------------------------------------------------------\n# normalize\n# ---------------------------------------------------------------------------\n\ndef test_normalize_empty_list():\n    \"\"\"normalize([]) 应返回空列表（列表推导对空输入返回空列表）。\"\"\"\n    assert normalize([]) == []\n\n\ndef test_normalize_single_element():\n    \"\"\"normalize 对单元素列表应返回该元素乘以 2。\"\"\"\n    assert normalize([3]) == [6]\n\n\ndef test_normalize_multiple_elements():\n    \"\"\"normalize 对每个元素乘以 2，保持顺序。\"\"\"\n    assert normalize([1, 2, 3]) == [2, 4, 6]\n\n\ndef test_normalize_negative_and_zero():\n    \"\"\"normalize 对负数与 0 同样乘以 2。\"\"\"\n    assert normalize([-1, 0, 5]) == [-2, 0, 10]\n\n\ndef test_normalize_returns_new_list():\n    \"\"\"normalize 应返回新列表，不修改输入。\"\"\"\n    data = [1, 2, 3]\n    result = normalize(data)\n    assert result == [2, 4, 6]\n    assert data == [1, 2, 3]\n    assert result is not data\n\n\n# ---------------------------------------------------------------------------\n# aggregate\n# ---------------------------------------------------------------------------\n\ndef test_aggregate_empty_list():\n    \"\"\"aggregate([]) 按实现返回 count=0, total=0。\"\"\"\n    assert aggregate([]) == {\"count\": 0, \"total\": 0}\n\n\ndef test_aggregate_single_element():\n    \"\"\"aggregate 对单元素列表返回 count=1 与对应 total。\"\"\"\n    assert aggregate([7]) == {\"count\": 1, \"total\": 7}\n\n\ndef test_aggregate_multiple_elements():\n    \"\"\"aggregate 返回元素个数与元素之和。\"\"\"\n    assert aggregate([1, 2, 3, 4]) == {\"count\": 4, \"total\": 10}\n\n\ndef test_aggregate_negative_values():\n    \"\"\"aggregate 对含负数的列表正确求和。\"\"\"\n    assert aggregate([-5, 5, -10]) == {\"count\": 3, \"total\": -10}\n\n\ndef test_aggregate_returns_dict_with_expected_keys():\n    \"\"\"aggregate 返回的字典应包含 count 与 total 两个键。\"\"\"\n    result = aggregate([2, 4])\n    assert set(result.keys()) == {\"count\", \"total\"}\n\n\n# ---------------------------------------------------------------------------\n# report\n# ---------------------------------------------------------------------------\n\ndef test_report_empty_list():\n    \"\"\"report([]) 先 normalize 再 aggregate，结果 count=0 total=0。\"\"\"\n    assert report([]) == \"count=0 total=0\"\n\n\ndef test_report_single_element():\n    \"\"\"report([3]) -> normalize=[6] -> count=1 total=6。\"\"\"\n    assert report([3]) == \"count=1 total=6\"\n\n\ndef test_report_multiple_elements():\n    \"\"\"report([1, 2, 3]) -> normalize=[2,4,6] -> count=3 total=12。\"\"\"\n    assert report([1, 2, 3]) == \"count=3 total=12\"\n\n\ndef test_report_negative_values():\n    \"\"\"report([-1, 1]) -> normalize=[-2,2] -> count=2 total=0。\"\"\"\n    assert report([-1, 1]) == \"count=2 total=0\"\n\n\ndef test_report_format_string():\n    \"\"\"report 输出格式应为 'count=<n> total=<m>'。\"\"\"\n    result = report([5])\n    assert result.startswith(\"count=\")\n    assert \" total=\" in result\n    assert result == \"count=1 total=10\"\n\n\n@pytest.mark.parametrize(\n    \"data, expected\",\n    [\n        ([], \"count=0 total=0\"),\n        ([1], \"count=1 total=2\"),\n        ([1, 2], \"count=2 total=6\"),\n        ([10, 20, 30], \"count=3 total=120\"),\n    ],\n)\ndef test_report_parametrized(data, expected):\n    \"\"\"参数化验证 report 在多种输入下的输出（期望值由实现逻辑推导）。\"\"\"\n    assert report(data) == expected",
