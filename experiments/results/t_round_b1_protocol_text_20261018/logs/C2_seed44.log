== [1, 2, 3, 4]\n\n\n# ---------------------------------------------------------------------------\n# top_k\n# ---------------------------------------------------------------------------\n\ndef test_top_k_k_zero_returns_empty():\n    \"\"\"k <= 0 时应返回空列表。\"\"\"\n    assert top_k([1, 2, 3], 0) == []\n\n\ndef test_top_k_k_negative_returns_empty():\n    \"\"\"k 为负数时应返回空列表。\"\"\"\n    assert top_k([1, 2, 3], -1) == []\n\n\ndef test_top_k_k_ge_length_returns_full_sorted():\n    \"\"\"k >= len(arr) 时应返回完整排序结果（升序，与 sort_desc 一致）。\"\"\"\n    assert top_k([3, 1, 2], 3) == [1, 2, 3]\n    assert top_k([3, 1, 2], 5) == [1, 2, 3]\n\n\ndef test_top_k_returns_first_k_of_sorted():\n    \"\"\"0 < k < len(arr) 时应返回排序后的前 k 个元素。\n\n    期望值来源：目标代码实现（sort_desc 为升序），需人工确认语义。\n    \"\"\"\n    assert top_k([5, 3, 1, 4, 2], 2) == [1, 2]\n\n\ndef test_top_k_empty_list():\n    \"\"\"空列表且 k>0 时应返回空列表。\"\"\"\n    assert top_k([], 3) == []\n\n\ndef test_top_k_k_equals_one():\n    \"\"\"k=1 时应返回排序后的最小元素（按当前实现）。\"\"\"\n    assert top_k([9, 4, 7], 1) == [4]\n\n\ndef test_top_k_does_not_mutate_input_when_k_small():\n    \"\"\"k 小于长度时，sort_desc 会原地排序输入列表，记录该副作用。\n\n    期望值来源：目标代码实现，需人工确认是否允许修改入参。\n    \"\"\"\n    arr = [3, 1, 2]\n    top_k(arr, 1)\n    assert arr == [1, 2, 3]",
