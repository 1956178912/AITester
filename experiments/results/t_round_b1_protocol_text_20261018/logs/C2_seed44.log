          "generated_test": "import pytest\n\nfrom task_0076 import _better, best_score, worst_score\n\n\nclass TestBetter:\n    \"\"\"Tests for the _better helper function.\"\"\"\n\n    @pytest.mark.parametrize(\n        \"current, candidate, expected\",\n        [\n            (5, 3, True),\n            (3, 5, False),\n            (5, 5, False),\n            (0, -1, True),\n            (-1, 0, False),\n            (100, 99, True),\n            (99, 100, False),\n        ],\n    )\n    def test_better_returns_correct_comparison(self, current, candidate, expected):\n        \"\"\"_better should return True iff candidate < current.\"\"\"\n        assert _better(current, candidate) is expected\n\n    def test_better_with_equal_values(self):\n        \"\"\"_better should return False when candidate equals current.\"\"\"\n        assert _better(42, 42) is False\n\n    def test_better_with_large_negative_values(self):\n        \"\"\"_better should handle large negative integers correctly.\"\"\"\n        assert _better(-10, -20) is True\n        assert _better(-20, -10) is False\n\n\nclass TestBestScore:\n    \"\"\"Tests for the best_score function.\"\"\"\n\n    def test_best_score_single_element(self):\n        \"\"\"best_score of a single-element list returns that element.\"\"\"\n        assert best_score([7]) == 7\n\n    def test_best_score_multiple_elements(self):\n        \"\"\"best_score returns the minimum value in the list.\"\"\"\n        assert best_score([3, 1, 4, 1, 5, 9, 2, 6]) == 1\n\n    def test_best_score_already_sorted_ascending(self):\n        \"\"\"best_score returns first element when list is ascending.\"\"\"\n        assert best_score([1, 2, 3, 4, 5]) == 1\n\n    def test_best_score_already_sorted_descending(self):\n        \"\"\"best_score returns last element when list is descending.\"\"\"\n        assert best_score([5, 4, 3, 2, 1]) == 1\n\n    def test_best_score_all_equal(self):\n        \"\"\"best_score returns the common value when all elements are equal.\"\"\"\n        assert best_score([4, 4, 4, 4]) == 4\n\n    def test_best_score_negative_numbers(self):\n        \"\"\"best_score handles negative numbers correctly.\"\"\"\n        assert best_score([-1, -5, -3, -2]) == -5\n\n    def test_best_score_mixed_signs(self):\n        \"\"\"best_score handles a mix of positive and negative numbers.\"\"\"\n        assert best_score([10, -10, 0, 5, -3]) == -10\n\n    def test_best_score_two_elements(self):\n        \"\"\"best_score works with exactly two elements.\"\"\"\n        assert best_score([9, 2]) == 2\n        assert best_score([2, 9]) == 2\n\n    def test_best_score_does_not_mutate_input(self):\n        \"\"\"best_score should not modify the input list.\"\"\"\n        data = [3, 1, 2]\n        original = list(data)\n        best_score(data)\n        assert data == original\n\n    def test_best_score_empty_list_raises(self):\n        \"\"\"best_score on an empty list raises IndexError (accesses scores[0]).\"\"\"\n        with pytest.raises(IndexError):\n            best_score([])\n\n\nclass TestWorstScore:\n    \"\"\"Tests for the worst_score function.\"\"\"\n\n    def test_worst_score_single_element(self):\n        \"\"\"worst_score of a single-element list returns that element.\"\"\"\n        assert worst_score([7]) == 7\n\n    def test_worst_score_multiple_elements(self):\n        \"\"\"worst_score returns the maximum value in the list.\"\"\"\n        assert worst_score([3, 1, 4, 1, 5, 9, 2, 6]) == 9\n\n    def test_worst_score_already_sorted_ascending(self):\n        \"\"\"worst_score returns last element when list is ascending.\"\"\"\n        assert worst_score([1, 2, 3, 4, 5]) == 5\n\n    def test_worst_score_already_sorted_descending(self):\n        \"\"\"worst_score returns first element when list is descending.\"\"\"\n        assert worst_score([5, 4, 3, 2, 1]) == 5\n\n    def test_worst_score_all_equal(self):\n        \"\"\"worst_score returns the common value when all elements are equal.\"\"\"\n        assert worst_score([4, 4, 4, 4]) == 4\n\n    def test_worst_score_negative_numbers(self):\n        \"\"\"worst_score handles negative numbers correctly.\"\"\"\n        assert worst_score([-1, -5, -3, -2]) == -1\n\n    def test_worst_score_mixed_signs(self):\n        \"\"\"worst_score handles a mix of positive and negative numbers.\"\"\"\n        assert worst_score([10, -10, 0, 5, -3]) == 10\n\n    def test_worst_score_two_elements(self):\n        \"\"\"worst_score works with exactly two elements.\"\"\"\n        assert worst_score([9, 2]) == 9\n        assert worst_score([2, 9]) == 9\n\n    def test_worst_score_does_not_mutate_input(self):\n        \"\"\"worst_score should not modify the input list.\"\"\"\n        data = [3, 1, 2]\n        original = list(data)\n        worst_score(data)\n        assert data == original\n\n    def test_worst_score_empty_list_raises(self):\n        \"\"\"worst_score on an empty list raises IndexError (accesses scores[0]).\"\"\"\n        with pytest.raises(IndexError):\n            worst_score([])\n\n\nclass TestBestWorstConsistency:\n    \"\"\"Cross-checks between best_score and worst_score.\"\"\"\n\n    @pytest.mark.parametrize(\n        \"scores\",\n        [\n            [1],\n            [1, 2],\n            [2, 1],\n            [5, 5, 5],\n            [-3, 0, 3],\n            [100, -100, 50, -50],\n            [7, 7, 1, 9, 9],\n        ],\n    )\n    def test_best_and_worst_match_builtin_min_max(self, scores):\n        \"\"\"best_score/worst_score should agree with min/max builtins.\"\"\"\n        assert best_score(scores) == min(scores)\n        assert worst_score(scores) == max(scores)\n\n    @pytest.mark.parametrize(\n        \"scores\",\n        [\n            [1, 2, 3],\n            [3, 2, 1],\n            [-5, 5],\n            [0, 0, 0],\n        ],\n    )\n    def test_best_score_le_worst_score(self, scores):\n        \"\"\"best_score should always be <= worst_score.\"\"\"\n        assert best_score(scores) <= worst_