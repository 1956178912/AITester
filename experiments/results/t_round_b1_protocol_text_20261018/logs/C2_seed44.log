实现逻辑，循环次数为 len(text)-1\n    text = \"abcdef\"\n    result = mark_positions(text, \"a\")\n    assert len(result) == len(text) - 1\n\n\n@pytest.mark.parametrize(\n    \"text, ch, expected\",\n    [\n        (\"abcabc\", \"a\", [0, -1, -1, 3, -1]),\n        (\"hello\", \"z\", [-1, -1, -1, -1]),\n        (\"aaaa\", \"a\", [0, 1, 2]),\n        (\"\", \"a\", []),\n        (\"a\", \"a\", []),\n        (\"ab\", \"a\", [0]),\n        (\"ab\", \"b\", [-1]),\n        (\"xyz\", \"z\", [-1, -1]),\n    ],\n)\ndef test_mark_positions_parametrized(text, ch, expected):\n    \"\"\"参数化用例：覆盖多种输入组合，验证标记结果。\"\"\"\n    # 期望值来源：函数实现逻辑推导\n    assert mark_positions(text, ch) == expected",
