          "generated_test": "import pytest\n\nfrom task_0070 import lookup, describe, display\n\n\n# ---------------------------------------------------------------------------\n# lookup\n# ---------------------------------------------------------------------------\n\ndef test_lookup_known_keys():\n    \"\"\"已知键应返回 _TABLE 中对应的值（来源：模块内 _TABLE 定义）。\"\"\"\n    assert lookup(\"alpha\") == 1\n    assert lookup(\"beta\") == 2\n    assert lookup(\"gamma\") == 3\n\n\ndef test_lookup_unknown_key_returns_zero():\n    \"\"\"未知键应返回默认值 0（来源：_TABLE.get(key, 0) 的默认参数）。\"\"\"\n    assert lookup(\"delta\") == 0\n    assert lookup(\"\") == 0\n    assert lookup(\"ALPHA\") == 0  # 大小写敏感\n\n\n@pytest.mark.parametrize(\"key\", [\"alpha\", \"beta\", \"gamma\", \"unknown\", \"\"])\ndef test_lookup_returns_int(key):\n    \"\"\"lookup 的返回类型注解为 int，任意键都应返回 int（来源：类型注解）。\"\"\"\n    result = lookup(key)\n    assert isinstance(result, int)\n\n\n# ---------------------------------------------------------------------------\n# describe\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\n    \"value, expected\",\n    [\n        (0, \"value=0\"),\n        (1, \"value=1\"),\n        (-5, \"value=-5\"),\n        (42, \"value=42\"),\n    ],\n)\ndef test_describe_formats_value(value, expected):\n    \"\"\"describe 应返回 f\"value={value}\" 格式字符串（来源：函数实现）。\"\"\"\n    assert describe(value) == expected\n\n\ndef test_describe_returns_str():\n    \"\"\"describe 的返回类型注解为 str（来源：类型注解）。\"\"\"\n    assert isinstance(describe(7), str)\n\n\n# ---------------------------------------------------------------------------\n# display\n# ---------------------------------------------------------------------------\n\ndef test_display_known_name():\n    \"\"\"已知名称：value 为 int，int 无 strip/upper 方法，调用应抛 AttributeError。\n\n    期望值来源：函数实现中 value.strip().upper() 对 int 调用不存在的方法。\n    \"\"\"\n    with pytest.raises(AttributeError):\n        display(\"alpha\")\n\n\ndef test_display_unknown_name():\n    \"\"\"未知名称：lookup 返回 0（int），同样应抛 AttributeError。\n\n    期望值来源：lookup 默认返回 0，int 无 strip 方法。\n    \"\"\"\n    with pytest.raises(AttributeError):\n        display(\"unknown\")\n\n\n@pytest.mark.parametrize(\"name\", [\"alpha\", \"beta\", \"gamma\", \"nope\", \"\"])\ndef test_display_always_raises_attribute_error(name):\n    \"\"\"无论名称是否在表中，lookup 均返回 int，display 都会因 int.strip() 失败。\n\n    期望值来源：函数实现逻辑，需人工确认是否为预期行为。\n    \"\"\"\n    with pytest.raises(AttributeError):\n        display(name)",
