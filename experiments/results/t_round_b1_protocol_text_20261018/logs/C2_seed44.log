          "generated_test": "import pytest\n\nfrom task_0037 import normalize_values, aggregate, doubled\n\n\nclass TestNormalizeValues:\n    \"\"\"Tests for normalize_values.\"\"\"\n\n    def test_normalize_values_empty_list_returns_empty(self):\n        \"\"\"Empty input should return empty list (docstring/contract expectation).\n\n        Note: historical bug returned [0]; this test documents the intended\n        contract. Expected value source: function contract (list doubling).\n        \"\"\"\n        assert normalize_values([]) == []\n\n    def test_normalize_values_single_element(self):\n        \"\"\"A single element should be doubled.\"\"\"\n        assert normalize_values([3]) == [6]\n\n    def test_normalize_values_multiple_elements(self):\n        \"\"\"Each element should be doubled, preserving order.\"\"\"\n        assert normalize_values([1, 2, 3]) == [2, 4, 6]\n\n    def test_normalize_values_negative_and_zero(self):\n        \"\"\"Negatives and zero should be handled by simple doubling.\"\"\"\n        assert normalize_values([-1, 0, 5]) == [-2, 0, 10]\n\n    def test_normalize_values_returns_new_list(self):\n        \"\"\"The function should not mutate the input list.\"\"\"\n        original = [1, 2, 3]\n        result = normalize_values(original)\n        assert original == [1, 2, 3]\n        assert result is not original\n\n    def test_normalize_values_floats(self):\n        \"\"\"Float values should be doubled correctly.\"\"\"\n        assert normalize_values([1.5, 2.5]) == [3.0, 5.0]\n\n\nclass TestAggregate:\n    \"\"\"Tests for aggregate.\"\"\"\n\n    def test_aggregate_single_element(self):\n        \"\"\"Mean of a single element is that element.\"\"\"\n        assert aggregate([5]) == 5.0\n\n    def test_aggregate_multiple_elements(self):\n        \"\"\"Mean of [1, 2, 3] is 2.0.\"\"\"\n        assert aggregate([1, 2, 3]) == 2.0\n\n    def test_aggregate_floats(self):\n        \"\"\"Mean of floats should be computed correctly.\"\"\"\n        assert aggregate([1.0, 2.0, 3.0, 4.0]) == 2.5\n\n    def test_aggregate_negative_values(self):\n        \"\"\"Mean with negatives should be correct.\"\"\"\n        assert aggregate([-2, 0, 2]) == 0.0\n\n    def test_aggregate_empty_list_raises(self):\n        \"\"\"Empty list should raise ZeroDivisionError (historical bug).\n\n        Expected value source: division by len(values) with empty list.\n        \"\"\"\n        with pytest.raises(ZeroDivisionError):\n            aggregate([])\n\n\nclass TestDoubled:\n    \"\"\"Tests for doubled.\"\"\"\n\n    def test_doubled_empty_list(self):\n        \"\"\"Doubled sum of empty list is 0.\"\"\"\n        assert doubled([]) == 0\n\n    def test_doubled_single_element(self):\n        \"\"\"Doubled sum of [3] is 6.\"\"\"\n        assert doubled([3]) == 6\n\n    def test_doubled_multiple_elements(self):\n        \"\"\"Doubled sum of [1, 2, 3] is 12.\"\"\"\n        assert doubled([1, 2, 3]) == 12\n\n    def test_doubled_negative_values(self):\n        \"\"\"Doubled sum with negatives should be correct.\"\"\"\n        assert doubled([-1, -2, 3]) == 0\n\n    def test_doubled_floats(self):\n        \"\"\"Doubled sum of floats should be correct.\"\"\"\n        assert doubled([1.5, 2.5]) == 8.0\n\n    def test_doubled_returns_numeric(self):\n        \"\"\"Result should be a number (int or float).\"\"\"\n        result = doubled([1, 2])\n        assert isinstance(result, (int, float))",
