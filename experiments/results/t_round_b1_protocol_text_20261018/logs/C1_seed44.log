          "generated_test": "import pytest\n\nfrom task_0020 import normalize_values, aggregate, doubled\n\n\n# ---------------------------------------------------------------------------\n# normalize_values\n# ---------------------------------------------------------------------------\n\ndef test_normalize_values_empty_list_returns_empty_list():\n    \"\"\"空列表应返回空列表（历史 bug：曾返回 [0]）。\n\n    期望值来源：函数语义（对每个元素翻倍，空输入应无输出）。\n    \"\"\"\n    assert normalize_values([]) == []\n\n\ndef test_normalize_values_single_element():\n    \"\"\"单元素列表应翻倍并追加 0。\n\n    期望值来源：实现约定（[v*2 for v in values] + [0]）。\n    \"\"\"\n    assert normalize_values([3]) == [6, 0]\n\n\ndef test_normalize_values_multiple_elements():\n    \"\"\"多元素列表应逐个翻倍并追加 0。\n\n    期望值来源：实现约定（[v*2 for v in values] + [0]）。\n    \"\"\"\n    assert normalize_values([1, 2, 3]) == [2, 4, 6, 0]\n\n\ndef test_normalize_values_negative_and_zero():\n    \"\"\"负数与零应正确翻倍。\n\n    期望值来源：实现约定（乘法语义）。\n    \"\"\"\n    assert normalize_values([0, -1, -2]) == [0, -2, -4, 0]\n\n\ndef test_normalize_values_returns_new_list():\n    \"\"\"应返回新列表，不修改输入。\n\n    期望值来源：函数签名与实现（列表推导式生成新列表）。\n    \"\"\"\n    original = [1, 2]\n    result = normalize_values(original)\n    assert original == [1, 2]\n    assert result is not original\n\n\n# ---------------------------------------------------------------------------\n# aggregate\n# ---------------------------------------------------------------------------\n\ndef test_aggregate_empty_list_raises():\n    \"\"\"空列表应抛出异常（历史 bug：除零）。\n\n    期望值来源：实现中 sum/len 在空列表上会触发 ZeroDivisionError。\n    \"\"\"\n    with pytest.raises(ZeroDivisionError):\n        aggregate([])\n\n\ndef test_aggregate_single_element():\n    \"\"\"单元素列表的平均值等于该元素。\n\n    期望值来源：平均值定义。\n    \"\"\"\n    assert aggregate([5]) == 5.0\n\n\ndef test_aggregate_multiple_elements():\n    \"\"\"多元素列表的平均值。\n\n    期望值来源：平均值定义。\n    \"\"\"\n    assert aggregate([1, 2, 3, 4]) == 2.5\n\n\ndef test_aggregate_negative_values():\n    \"\"\"含负数的平均值。\n\n    期望值来源：平均值定义。\n    \"\"\"\n    assert aggregate([-2, 2]) == 0.0\n\n\ndef test_aggregate_returns_float():\n    \"\"\"返回值应为 float 类型。\n\n    期望值来源：类型注解 -> float。\n    \"\"\"\n    result = aggregate([1, 2])\n    assert isinstance(result, float)\n\n\n# ---------------------------------------------------------------------------\n# doubled\n# ---------------------------------------------------------------------------\n\ndef test_doubled_empty_list():\n    \"\"\"空列表的 doubled 应为 0。\n\n    期望值来源：sum([], 0) == 0，再乘 2 得 0。\n    \"\"\"\n    assert doubled([]) == 0\n\n\ndef test_doubled_single_element():\n    \"\"\"单元素列表的 doubled 应为该元素的两倍。\n\n    期望值来源：实现约定（2 * sum(values, 0)）。\n    \"\"\"\n    assert doubled([3]) == 6\n\n\ndef test_doubled_multiple_elements():\n    \"\"\"多元素列表的 doubled 应为总和的两倍。\n\n    期望值来源：实现约定（2 * sum(values, 0)）。\n    \"\"\"\n    assert doubled([1, 2, 3]) == 12\n\n\ndef test_doubled_negative_values():\n    \"\"\"含负数的 doubled。\n\n    期望值来源：实现约定（2 * sum(values, 0)）。\n    \"\"\"\n    assert doubled([-1, -2, 3]) == 0\n\n\ndef test_doubled_returns_numeric():\n    \"\"\"返回值应为数值类型（int 或 float）。\n\n    期望值来源：类型注解 -> float；实现可能返回 int，\n    此处仅断言为数值类型，避免臆造具体类型。\n    \"\"\"\n    result = doubled([1, 2])\n    assert isinstance(result, (int, float))",
