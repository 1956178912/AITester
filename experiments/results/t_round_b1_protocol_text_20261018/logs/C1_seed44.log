          "generated_test": "import pytest\n\nfrom task_0046 import pick_label, report\n\n\nclass TestPickLabel:\n    \"\"\"Tests for pick_label function.\"\"\"\n\n    @pytest.mark.parametrize(\"score,expected\", [\n        (90, \"excellent\"),\n        (95, \"excellent\"),\n        (100, \"excellent\"),\n        (1000, \"excellent\"),\n    ])\n    def test_pick_label_excellent(self, score, expected):\n        \"\"\"Scores >= 90 should return 'excellent' (per docstring/implementation).\"\"\"\n        assert pick_label(score) == expected\n\n    @pytest.mark.parametrize(\"score,expected\", [\n        (60, \"pass\"),\n        (75, \"pass\"),\n        (89, \"pass\"),\n    ])\n    def test_pick_label_pass(self, score, expected):\n        \"\"\"Scores in [60, 90) should return 'pass' (per implementation).\"\"\"\n        assert pick_label(score) == expected\n\n    @pytest.mark.parametrize(\"score\", [0, 1, 30, 59, -1, -100])\n    def test_pick_label_below_pass_returns_none(self, score):\n        \"\"\"Scores < 60 fall through both branches and return None.\n\n        Expected value source: implementation has no explicit return for\n        this range, so Python implicitly returns None. Needs human\n        confirmation whether None is the intended contract.\n        \"\"\"\n        assert pick_label(score) is None\n\n    def test_pick_label_boundary_90(self):\n        \"\"\"Boundary at 90 is inclusive for 'excellent'.\"\"\"\n        assert pick_label(90) == \"excellent\"\n        assert pick_label(89) == \"pass\"\n\n    def test_pick_label_boundary_60(self):\n        \"\"\"Boundary at 60 is inclusive for 'pass'.\"\"\"\n        assert pick_label(60) == \"pass\"\n        assert pick_label(59) is None\n\n    def test_pick_label_returns_str_or_none(self):\n        \"\"\"Return type is str for covered ranges, None otherwise.\"\"\"\n        assert isinstance(pick_label(95), str)\n        assert isinstance(pick_label(70), str)\n        assert pick_label(10) is None\n\n\nclass TestReport:\n    \"\"\"Tests for report function.\"\"\"\n\n    @pytest.mark.parametrize(\"score,expected\", [\n        (90, \"result: EXCELLENT\"),\n        (100, \"result: EXCELLENT\"),\n        (60, \"result: PASS\"),\n        (75, \"result: PASS\"),\n    ])\n    def test_report_uppercased_label(self, score, expected):\n        \"\"\"report should uppercase the label from pick_label.\"\"\"\n        assert report(score) == expected\n\n    def test_report_below_pass_raises_attribute_error(self):\n        \"\"\"For scores < 60, pick_label returns None and .upper() raises.\n\n        Expected behavior source: implementation calls .upper() on the\n        result of pick_label; None has no .upper(), so AttributeError is\n        raised. Needs human confirmation whether this is intended.\n        \"\"\"\n        with pytest.raises(AttributeError):\n            report(0)\n\n    def test_report_prefix(self):\n        \"\"\"report output always starts with 'result: ' when label exists.\"\"\"\n        assert report(95).startswith(\"result: \")\n        assert report(65).startswith(\"result: \")\n\n    def test_report_consistency_with_pick_label(self):\n        \"\"\"report output equals 'result: ' + pick_label(score).upper().\"\"\"\n        for score in (90, 89, 60, 59):\n            label = pick_label(score)\n            if label is None:\n                with pytest.raises(AttributeError):\n                    report(score)\n            else:\n                assert report(score) == f\"result: {label.upper()}\"",
