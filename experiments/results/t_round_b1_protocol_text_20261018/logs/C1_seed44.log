e temps are not 'freezing' per implementation, so temp is returned.\"\"\"\n        assert normalize(-5) == -5\n\n    def test_normalize_returns_temp_for_large_negative(self):\n        \"\"\"Large negative temps should be returned unchanged.\"\"\"\n        assert normalize(-100) == -100\n\n    @pytest.mark.parametrize(\"temp,expected\", [\n        (0, 0),\n        (10, 0),\n        (100, 0),\n        (-1, -1),\n        (-42, -42),\n    ])\n    def test_normalize_parametrized(self, temp, expected):\n        \"\"\"Parametrized check of normalize behavior.\n\n        Expected values derived from implementation: normalize returns 0\n        when is_freezing(temp) is True (temp >= 0), else returns temp.\n        \"\"\"\n        assert normalize(temp) == expected\n\n    def test_normalize_consistency_with_is_freezing(self):\n        \"\"\"normalize should return 0 exactly when is_freezing is True.\"\"\"\n        for temp in [-100, -1, 0, 1, 50]:\n            if is_freezing(temp):\n                assert normalize(temp) == 0\n            else:\n                assert normalize(temp) == temp",
