          "generated_test": "import math\n\nimport pytest\n\nfrom task_0034 import sqrt\n\n\ndef test_sqrt_zero_returns_zero():\n    \"\"\"x == 0 时应返回 0（依据函数实现中的显式分支）。\"\"\"\n    assert sqrt(0) == 0\n\n\ndef test_sqrt_zero_float_returns_zero():\n    \"\"\"x == 0.0 时应返回 0（依据函数实现中的显式分支）。\"\"\"\n    assert sqrt(0.0) == 0\n\n\n@pytest.mark.parametrize(\"x\", [1, 4, 9, 16, 25, 100])\ndef test_sqrt_perfect_squares(x):\n    \"\"\"完全平方数的平方根应为对应整数（依据数学定义与 x ** 0.5 实现）。\"\"\"\n    assert sqrt(x) == pytest.approx(math.sqrt(x))\n\n\n@pytest.mark.parametrize(\"x\", [2, 3, 5, 7, 10, 0.25, 1.44])\ndef test_sqrt_positive_values_match_math_sqrt(x):\n    \"\"\"正数的平方根应与 math.sqrt 一致（依据 x ** 0.5 实现）。\"\"\"\n    assert sqrt(x) == pytest.approx(math.sqrt(x))\n\n\ndef test_sqrt_returns_float_for_int_input():\n    \"\"\"整数输入时返回值应为 float 类型（依据类型注解 -> float）。\"\"\"\n    result = sqrt(4)\n    assert isinstance(result, float)\n\n\ndef test_sqrt_returns_float_for_float_input():\n    \"\"\"浮点输入时返回值应为 float 类型（依据类型注解 -> float）。\"\"\"\n    result = sqrt(2.25)\n    assert isinstance(result, float)\n\n\ndef test_sqrt_result_squared_equals_input():\n    \"\"\"对正数，结果的平方应约等于输入（依据平方根定义）。\"\"\"\n    x = 7.5\n    result = sqrt(x)\n    assert result * result == pytest.approx(x)\n\n\ndef test_sqrt_negative_raises():\n    \"\"\"负数输入时，x ** 0.5 在 Python 中返回复数而非抛异常；\n    期望值来源不明，需人工确认。此处记录实际行为：结果为复数。\"\"\"\n    result = sqrt(-4)\n    assert isinstance(result, complex)\n    assert result == pytest.approx(2j)\n\n\ndef test_sqrt_small_positive_value():\n    \"\"\"极小正数的平方根应接近其 math.sqrt（依据 x ** 0.5 实现）。\"\"\"\n    x = 1e-12\n    assert sqrt(x) == pytest.approx(math.sqrt(x))",
