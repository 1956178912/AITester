          "generated_test": "import pytest\n\nfrom task_0026 import mark_positions\n\n\ndef test_mark_positions_basic_marks():\n    \"\"\"基本用例：字符出现在部分位置时，对应位置标记为索引，其余为 -1。\"\"\"\n    text = \"abcabc\"\n    ch = \"a\"\n    # 期望值来源：函数实现逻辑，遍历 range(len(text)-1) 即 0..4\n    assert mark_positions(text, ch) == [0, -1, -1, 3, -1]\n\n\ndef test_mark_positions_no_match():\n    \"\"\"字符不存在时，所有位置均为 -1。\"\"\"\n    text = \"hello\"\n    ch = \"z\"\n    assert mark_positions(text, ch) == [-1, -1, -1, -1]\n\n\ndef test_mark_positions_all_match():\n    \"\"\"字符在每个位置都出现时，返回连续索引列表。\"\"\"\n    text = \"aaaa\"\n    ch = \"a\"\n    # 长度 4，遍历 0..2\n    assert mark_positions(text, ch) == [0, 1, 2]\n\n\ndef test_mark_positions_empty_string():\n    \"\"\"空字符串时，range(-1) 为空，返回空列表。\"\"\"\n    assert mark_positions(\"\", \"a\") == []\n\n\ndef test_mark_positions_single_char_string():\n    \"\"\"单字符字符串时，range(0) 为空，返回空列表。\"\"\"\n    assert mark_positions(\"a\", \"a\") == []\n\n\ndef test_mark_positions_two_char_string():\n    \"\"\"两字符字符串时，只检查索引 0。\"\"\"\n    assert mark_positions(\"ab\", \"a\") == [0]\n    assert mark_positions(\"ab\", \"b\") == [-1]\n\n\ndef test_mark_positions_last_char_never_marked():\n    \"\"\"最后一个字符永远不会被检查，因此即使匹配也不会被标记。\"\"\"\n    text = \"xyz\"\n    ch = \"z\"\n    # 只遍历索引 0 和 1\n    assert mark_positions(text, ch) == [-1, -1]\n\n\ndef test_mark_positions_returns_list():\n    \"\"\"返回值类型应为 list。\"\"\"\n    result = mark_positions(\"abc\", \"a\")\n    assert isinstance(result, list)\n\n\ndef test_mark_positions_length_is_len_minus_one():\n    \"\"\"返回列表长度应为 len(text) - 1（非负时）。\"\"\"\n    text = \"abcdef\"\n    result = mark_positions(text, \"a\")\n    assert len(result) == len(text) - 1\n\n\n@pytest.mark.parametrize(\n    \"text, ch, expected\",\n    [\n        (\"abcabc\", \"a\", [0, -1, -1, 3, -1]),\n        (\"abcabc\", \"b\", [-1, 1, -1, -1, 4]),\n        (\"abcabc\", \"c\", [-1, -1, 2, -1, -1]),\n        (\"hello\", \"l\", [-1, -1, 2, 2]),\n        (\"hello\", \"o\", [-1, -1, -1, -1]),\n        (\"\", \"a\", []),\n        (\"a\", \"a\", []),\n        (\"aa\", \"a\", [0]),\n    ],\n)\ndef test_mark_positions_parametrized(text, ch, expected):\n    \"\"\"参数化用例：覆盖多种输入组合。\"\"\"\n    assert mark_positions(text, ch) == expected\n\n\ndef test_mark_positions_does_not_mutate_input():\n    \"\"\"函数不应修改输入字符串（字符串不可变，验证返回值独立）。\"\"\"\n    text = \"abcabc\"\n    ch = \"a\"\n    first = mark_positions(text, ch)\n    second = mark_positions(text, ch)\n    assert first == second\n    assert first is not second",
