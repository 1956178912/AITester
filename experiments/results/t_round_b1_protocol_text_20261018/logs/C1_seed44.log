          "generated_test": "import pytest\n\nfrom task_0066 import safe_div\n\n\ndef test_safe_div_returns_float_for_exact_division():\n    \"\"\"正常整除时返回 float 结果（期望值来源：函数返回类型注解 -> float）。\"\"\"\n    result = safe_div(10, 2)\n    assert result == 5.0\n    assert isinstance(result, float)\n\n\ndef test_safe_div_returns_float_for_non_exact_division():\n    \"\"\"非整除时返回浮点商（期望值来源：Python 除法语义 a / b）。\"\"\"\n    result = safe_div(7, 2)\n    assert result == 3.5\n    assert isinstance(result, float)\n\n\ndef test_safe_div_negative_operands():\n    \"\"\"负数相除结果符号正确（期望值来源：Python 除法语义 a / b）。\"\"\"\n    assert safe_div(-9, 3) == -3.0\n    assert safe_div(9, -3) == -3.0\n    assert safe_div(-9, -3) == 3.0\n\n\ndef test_safe_div_zero_numerator():\n    \"\"\"被除数为 0 时结果为 0.0（期望值来源：Python 除法语义 a / b）。\"\"\"\n    result = safe_div(0, 5)\n    assert result == 0.0\n    assert isinstance(result, float)\n\n\ndef test_safe_div_division_by_zero_raises():\n    \"\"\"除数为 0 时抛出 ZeroDivisionError（期望值来源：Python 除法语义 a / b）。\"\"\"\n    with pytest.raises(ZeroDivisionError):\n        safe_div(1, 0)\n\n\n@pytest.mark.parametrize(\n    \"a, b, expected\",\n    [\n        (1, 1, 1.0),\n        (100, 4, 25.0),\n        (1, 4, 0.25),\n        (-1, 8, -0.125),\n        (0, 1, 0.0),\n    ],\n)\ndef test_safe_div_parametrized_cases(a, b, expected):\n    \"\"\"参数化验证常见除法场景（期望值来源：Python 除法语义 a / b）。\"\"\"\n    assert safe_div(a, b) == expected",
