          "generated_test": "import pytest\n\nfrom task_0057 import mark_positions\n\n\ndef test_mark_positions_basic_marks():\n    \"\"\"基本用例：标记字符出现的位置，其余为 -1。\"\"\"\n    assert mark_positions(\"abcabc\", \"a\") == [0, -1, -1, 3, -1]\n\n\ndef test_mark_positions_no_match():\n    \"\"\"字符不存在时，所有位置均为 -1。\"\"\"\n    assert mark_positions(\"hello\", \"z\") == [-1, -1, -1, -1]\n\n\ndef test_mark_positions_all_match():\n    \"\"\"所有位置都匹配时，返回对应索引。\"\"\"\n    assert mark_positions(\"aaaa\", \"a\") == [0, 1, 2]\n\n\ndef test_mark_positions_empty_string():\n    \"\"\"空字符串应返回空列表。\"\"\"\n    assert mark_positions(\"\", \"a\") == []\n\n\ndef test_mark_positions_single_char_string():\n    \"\"\"单字符字符串：循环范围为空，返回空列表。\"\"\"\n    assert mark_positions(\"a\", \"a\") == []\n\n\ndef test_mark_positions_two_char_string():\n    \"\"\"两字符字符串：只检查第一个字符。\"\"\"\n    assert mark_positions(\"ab\", \"a\") == [0]\n    assert mark_positions(\"ab\", \"b\") == [-1]\n\n\ndef test_mark_positions_last_char_never_marked():\n    \"\"\"最后一个字符永远不会被标记（循环到 len-1 为止）。\"\"\"\n    result = mark_positions(\"xyz\", \"z\")\n    assert result == [-1, -1]\n\n\ndef test_mark_positions_length_is_len_minus_one():\n    \"\"\"返回列表长度恒为 len(text) - 1（非负）。\"\"\"\n    text = \"abcdef\"\n    result = mark_positions(text, \"c\")\n    assert len(result) == len(text) - 1\n\n\n@pytest.mark.parametrize(\n    \"text, ch, expected\",\n    [\n        (\"banana\", \"a\", [-1, 1, -1, 3, -1]),\n        (\"banana\", \"n\", [-1, -1, 2, -1, 4]),\n        (\"banana\", \"b\", [0, -1, -1, -1, -1]),\n        (\"mississippi\", \"s\", [-1, -1, 2, 3, -1, 5, 6, -1, -1, -1]),\n    ],\n)\ndef test_mark_positions_parametrized(text, ch, expected):\n    \"\"\"参数化用例：验证多种输入下的标记结果。\"\"\"\n    assert mark_positions(text, ch) == expected\n\n\ndef test_mark_positions_returns_list_of_ints():\n    \"\"\"返回值应为整数列表。\"\"\"\n    result = mark_positions(\"abc\", \"b\")\n    assert isinstance(result, list)\n    assert all(isinstance(x, int) for x in result)",
