          "generated_test": "import pytest\n\nfrom task_0010 import is_palindrome\n\n\ndef test_is_palindrome_with_simple_palindrome():\n    \"\"\"普通回文字符串应返回 True。\"\"\"\n    assert is_palindrome(\"racecar\") is True\n\n\ndef test_is_palindrome_with_non_palindrome():\n    \"\"\"非回文字符串应返回 False。\"\"\"\n    assert is_palindrome(\"hello\") is False\n\n\ndef test_is_palindrome_with_empty_string():\n    \"\"\"空字符串是回文，应返回 True。\"\"\"\n    assert is_palindrome(\"\") is True\n\n\ndef test_is_palindrome_with_single_character():\n    \"\"\"单字符字符串是回文，应返回 True。\"\"\"\n    assert is_palindrome(\"a\") is True\n\n\ndef test_is_palindrome_with_two_same_characters():\n    \"\"\"两个相同字符组成的字符串是回文，应返回 True。\"\"\"\n    assert is_palindrome(\"aa\") is True\n\n\ndef test_is_palindrome_with_two_different_characters():\n    \"\"\"两个不同字符组成的字符串不是回文，应返回 False。\"\"\"\n    assert is_palindrome(\"ab\") is False\n\n\ndef test_is_palindrome_with_even_length_palindrome():\n    \"\"\"偶数长度回文字符串应返回 True。\"\"\"\n    assert is_palindrome(\"abba\") is True\n\n\ndef test_is_palindrome_with_odd_length_palindrome():\n    \"\"\"奇数长度回文字符串应返回 True。\"\"\"\n    assert is_palindrome(\"abcba\") is True\n\n\ndef test_is_palindrome_with_numeric_string():\n    \"\"\"数字字符串按字符比较，回文数字串应返回 True。\"\"\"\n    assert is_palindrome(\"12321\") is True\n\n\ndef test_is_palindrome_with_non_palindrome_numeric_string():\n    \"\"\"非回文数字串应返回 False。\"\"\"\n    assert is_palindrome(\"12345\") is False\n\n\ndef test_is_palindrome_is_case_sensitive():\n    \"\"\"函数按原样比较字符，大小写不同则不是回文。\"\"\"\n    assert is_palindrome(\"Racecar\") is False\n\n\ndef test_is_palindrome_with_spaces():\n    \"\"\"函数不忽略空格，含空格的字符串按原样比较。\"\"\"\n    assert is_palindrome(\"a b a\") is True\n\n\ndef test_is_palindrome_with_leading_trailing_spaces():\n    \"\"\"函数不裁剪空白，首尾空格会导致非回文。\"\"\"\n    assert is_palindrome(\" aba\") is False\n\n\ndef test_is_palindrome_with_unicode_characters():\n    \"\"\"Unicode 字符组成的回文应返回 True。\"\"\"\n    assert is_palindrome(\"上海海上\") is True\n\n\ndef test_is_palindrome_with_punctuation():\n    \"\"\"函数不忽略标点，含标点的回文按原样比较。\"\"\"\n    assert is_palindrome(\"a,b,a\") is True\n\n\n@pytest.mark.parametrize(\n    \"value,expected\",\n    [\n        (\"\", True),\n        (\"a\", True),\n        (\"ab\", False),\n        (\"aba\", True),\n        (\"abba\", True),\n        (\"abc\", False),\n        (\"12321\", True),\n        (\"12345\", False),\n    ],\n)\ndef test_is_palindrome_parametrized(value, expected):\n    \"\"\"参数化验证多种输入下的回文判断结果。\"\"\"\n    assert is_palindrome(value) is expected",
