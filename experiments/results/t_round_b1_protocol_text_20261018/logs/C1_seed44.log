          "generated_test": "import pytest\n\nfrom task_0068 import fibonacci\n\n\ndef test_fibonacci_returns_int_for_positive_input():\n    \"\"\"fibonacci 对正整数输入应返回 int 类型结果。\"\"\"\n    result = fibonacci(5)\n    assert isinstance(result, int)\n\n\ndef test_fibonacci_zero_returns_one():\n    \"\"\"根据实现，n <= 0 时返回 1（期望值来源：目标代码分支 n <= 0 -> return 1）。\"\"\"\n    assert fibonacci(0) == 1\n\n\ndef test_fibonacci_one_returns_one():\n    \"\"\"根据实现，n == 1 时返回 1（期望值来源：目标代码分支 n == 1 -> return 1）。\"\"\"\n    assert fibonacci(1) == 1\n\n\n@pytest.mark.parametrize(\"n\", [-10, -1, 0])\ndef test_fibonacci_non_positive_returns_one(n):\n    \"\"\"根据实现，所有 n <= 0 的输入均返回 1（期望值来源：目标代码分支 n <= 0 -> return 1）。\"\"\"\n    assert fibonacci(n) == 1\n\n\n@pytest.mark.parametrize(\n    \"n, expected\",\n    [\n        (2, 2),\n        (3, 3),\n        (4, 5),\n        (5, 8),\n        (6, 13),\n        (7, 21),\n    ],\n)\ndef test_fibonacci_recursive_values(n, expected):\n    \"\"\"根据实现 fibonacci(n) = fibonacci(n-1) + fibonacci(n-2) 推导的递推值。\n\n    期望值来源：目标代码递归定义 + 基线 fibonacci(0)=1, fibonacci(1)=1。\n    \"\"\"\n    assert fibonacci(n) == expected\n\n\ndef test_fibonacci_is_deterministic():\n    \"\"\"同一输入多次调用应返回相同结果（纯函数行为）。\"\"\"\n    first = fibonacci(8)\n    second = fibonacci(8)\n    assert first == second\n\n\ndef test_fibonacci_monotonic_non_decreasing_for_n_ge_1():\n    \"\"\"对于 n >= 1，fibonacci 序列应非递减（由递推定义推导）。\"\"\"\n    values = [fibonacci(n) for n in range(1, 10)]\n    assert all(values[i] <= values[i + 1] for i in range(len(values) - 1))\n\n\ndef test_fibonacci_recurrence_relation():\n    \"\"\"验证递推关系 fibonacci(n) == fibonacci(n-1) + fibonacci(n-2) 对 n >= 2 成立。\"\"\"\n    for n in range(2, 10):\n        assert fibonacci(n) == fibonacci(n - 1) + fibonacci(n - 2)",
