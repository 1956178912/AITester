          "generated_test": "import pytest\n\nfrom task_0065 import compare, sort_desc, top_k\n\n\n# ---------------------------------------------------------------------------\n# compare\n# ---------------------------------------------------------------------------\n\ndef test_compare_greater_returns_1():\n    \"\"\"a > b 时应返回 1（依据 docstring/实现约定）。\"\"\"\n    assert compare(5, 3) == 1\n\n\ndef test_compare_less_returns_minus_1():\n    \"\"\"a < b 时应返回 -1（依据实现约定）。\"\"\"\n    assert compare(3, 5) == -1\n\n\ndef test_compare_equal_returns_0():\n    \"\"\"a == b 时应返回 0（依据实现约定）。\"\"\"\n    assert compare(4, 4) == 0\n\n\n@pytest.mark.parametrize(\n    \"a,b,expected\",\n    [\n        (0, 0, 0),\n        (-1, -2, 1),\n        (-2, -1, -1),\n        (10**9, -10**9, 1),\n        (-10**9, 10**9, -1),\n    ],\n)\ndef test_compare_parametrized(a, b, expected):\n    \"\"\"参数化验证 compare 的三值语义。\"\"\"\n    assert compare(a, b) == expected\n\n\n# ---------------------------------------------------------------------------\n# sort_desc\n# ---------------------------------------------------------------------------\n\ndef test_sort_desc_returns_sorted_descending():\n    \"\"\"sort_desc 应返回降序排列的列表。\"\"\"\n    assert sort_desc([3, 1, 2]) == [3, 2, 1]\n\n\ndef test_sort_desc_empty_list():\n    \"\"\"空列表应返回空列表。\"\"\"\n    assert sort_desc([]) == []\n\n\ndef test_sort_desc_single_element():\n    \"\"\"单元素列表应原样返回。\"\"\"\n    assert sort_desc([7]) == [7]\n\n\ndef test_sort_desc_already_sorted():\n    \"\"\"已降序的列表应保持不变。\"\"\"\n    assert sort_desc([5, 4, 3, 2, 1]) == [5, 4, 3, 2, 1]\n\n\ndef test_sort_desc_with_duplicates():\n    \"\"\"含重复元素时应正确降序排列。\"\"\"\n    assert sort_desc([2, 3, 2, 1, 3]) == [3, 3, 2, 2, 1]\n\n\ndef test_sort_desc_negative_numbers():\n    \"\"\"负数应正确降序排列。\"\"\"\n    assert sort_desc([-1, -5, 0, 3, -2]) == [3, 0, -1, -2, -5]\n\n\ndef test_sort_desc_returns_list_type():\n    \"\"\"返回值应为 list 类型。\"\"\"\n    result = sort_desc([1, 2, 3])\n    assert isinstance(result, list)\n\n\n# ---------------------------------------------------------------------------\n# top_k\n# ---------------------------------------------------------------------------\n\ndef test_top_k_k_zero_returns_empty():\n    \"\"\"k <= 0 时应返回空列表。\"\"\"\n    assert top_k([1, 2, 3], 0) == []\n\n\ndef test_top_k_k_negative_returns_empty():\n    \"\"\"k 为负数时应返回空列表。\"\"\"\n    assert top_k([1, 2, 3], -5) == []\n\n\ndef test_top_k_k_ge_length_returns_all_sorted():\n    \"\"\"k >= len(arr) 时应返回全部元素降序排列。\"\"\"\n    assert top_k([1, 3, 2], 3) == [3, 2, 1]\n\n\ndef test_top_k_k_greater_than_length():\n    \"\"\"k 大于长度时应返回全部元素降序排列。\"\"\"\n    assert top_k([1, 3, 2], 10) == [3, 2, 1]\n\n\ndef test_top_k_normal_case():\n    \"\"\"常规情况应返回前 k 个最大元素降序排列。\"\"\"\n    assert top_k([5, 1, 9, 3, 7], 2) == [9, 7]\n\n\ndef test_top_k_k_one():\n    \"\"\"k=1 时应返回最大元素。\"\"\"\n    assert top_k([4, 8, 2, 6], 1) == [8]\n\n\ndef test_top_k_empty_list():\n    \"\"\"空列表时 k>=0 应返回空列表。\"\"\"\n    assert top_k([], 3) == []\n\n\ndef test_top_k_with_duplicates():\n    \"\"\"含重复元素时前 k 个应正确。\"\"\"\n    assert top_k([3, 3, 1, 2, 2], 3) == [3, 3, 2]\n\n\ndef test_top_k_returns_list_type():\n    \"\"\"返回值应为 list 类型。\"\"\"\n    result = top_k([1, 2, 3], 2)\n    assert isinstance(result, list)",
