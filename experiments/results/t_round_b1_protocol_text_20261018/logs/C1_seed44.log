          "generated_test": "import pytest\n\nfrom task_0043 import pick_label, report\n\n\nclass TestPickLabel:\n    \"\"\"Tests for pick_label function.\"\"\"\n\n    @pytest.mark.parametrize(\"score,expected\", [\n        (90, \"excellent\"),\n        (95, \"excellent\"),\n        (100, \"excellent\"),\n        (1000, \"excellent\"),\n    ])\n    def test_pick_label_excellent(self, score, expected):\n        \"\"\"Scores >= 90 should return 'excellent' (per docstring/implementation).\"\"\"\n        assert pick_label(score) == expected\n\n    @pytest.mark.parametrize(\"score,expected\", [\n        (60, \"pass\"),\n        (61, \"pass\"),\n        (75, \"pass\"),\n        (89, \"pass\"),\n    ])\n    def test_pick_label_pass(self, score, expected):\n        \"\"\"Scores in [60, 89] should return 'pass' (per implementation).\"\"\"\n        assert pick_label(score) == expected\n\n    @pytest.mark.parametrize(\"score\", [0, 1, 30, 59, -1, -100])\n    def test_pick_label_below_pass_returns_none(self, score):\n        \"\"\"Scores < 60 fall through both branches and return None.\n\n        Expected value source: implementation has no explicit return for\n        this range, so it implicitly returns None. Needs human confirmation\n        whether None is the intended contract.\n        \"\"\"\n        assert pick_label(score) is None\n\n    def test_pick_label_boundary_90(self):\n        \"\"\"Boundary at 90 is inclusive for 'excellent'.\"\"\"\n        assert pick_label(90) == \"excellent\"\n        assert pick_label(89) == \"pass\"\n\n    def test_pick_label_boundary_60(self):\n        \"\"\"Boundary at 60 is inclusive for 'pass'.\"\"\"\n        assert pick_label(60) == \"pass\"\n        assert pick_label(59) is None\n\n    def test_pick_label_returns_str_or_none(self):\n        \"\"\"Return type is str for passing scores, None otherwise.\"\"\"\n        assert isinstance(pick_label(100), str)\n        assert isinstance(pick_label(70), str)\n        assert pick_label(10) 