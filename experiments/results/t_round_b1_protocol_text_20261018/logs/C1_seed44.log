          "generated_test": "import datetime\nimport pytest\n\nfrom task_0038 import parse_date, days_until, is_expired\n\n\n# ---------------------------------------------------------------------------\n# parse_date\n# ---------------------------------------------------------------------------\n\ndef test_parse_date_valid_date_returns_datetime():\n    \"\"\"Valid ISO date string should parse to the corresponding datetime.\"\"\"\n    result = parse_date(\"2024-01-15\")\n    assert isinstance(result, datetime.datetime)\n    assert result == datetime.datetime(2024, 1, 15)\n\n\ndef test_parse_date_invalid_format_returns_datetime_min():\n    \"\"\"Invalid format should fall back to datetime.min (per implementation).\"\"\"\n    result = parse_date(\"15/01/2024\")\n    assert result == datetime.datetime.min\n\n\ndef test_parse_date_empty_string_returns_datetime_min():\n    \"\"\"Empty string is invalid and should return datetime.min.\"\"\"\n    result = parse_date(\"\")\n    assert result == datetime.datetime.min\n\n\ndef test_parse_date_non_date_string_returns_datetime_min():\n    \"\"\"Non-date text should return datetime.min.\"\"\"\n    result = parse_date(\"not-a-date\")\n    assert result == datetime.datetime.min\n\n\ndef test_parse_date_impossible_date_returns_datetime_min():\n    \"\"\"Impossible calendar date (Feb 30) should return datetime.min.\"\"\"\n    result = parse_date(\"2024-02-30\")\n    assert result == datetime.datetime.min\n\n\n@pytest.mark.parametrize(\n    \"value\",\n    [\"2024-01-15\", \"1999-12-31\", \"2000-02-29\"],\n)\ndef test_parse_date_various_valid_dates(value):\n    \"\"\"Various valid dates should parse without falling back to datetime.min.\"\"\"\n    result = parse_date(value)\n    assert result != datetime.datetime.min\n    assert result.strftime(\"%Y-%m-%d\") == value\n\n\n# ---------------------------------------------------------------------------\n# days_until\n# ---------------------------------------------------------------------------\n\ndef test_days_until_future_date_positive():\n    \"\"\"A date far in the future should yield a positive day count.\"\"\"\n    future = (datetime.datetime.now() + datetime.timedelta(days=10)).strftime(\"%Y-%m-%d\")\n    result = days_until(future)\n    # Expected value derived from implementation: delta.days of (parsed - now)\n    assert isinstance(result, int)\n    assert result >= 0\n\n\ndef test_days_until_past_date_negative():\n    \"\"\"A date in the past should yield a negative day count.\"\"\"\n    past = (datetime.datetime.now() - datetime.timedelta(days=10)).strftime(\"%Y-%m-%d\")\n    result = days_until(past)\n    assert isinstance(result, int)\n    assert result < 0\n\n\ndef test_days_until_invalid_date_negative():\n    \"\"\"Invalid date parses to datetime.min, so days_until should be negative.\"\"\"\n    result = days_until(\"invalid\")\n    assert isinstance(result, int)\n    assert result < 0\n\n\ndef test_days_until_returns_int():\n    \"\"\"days_until should always return an int.\"\"\"\n    result = days_until(\"2030-01-01\")\n    assert isinstance(result, int)\n\n\n# ---------------------------------------------------------------------------\n# is_expired\n# ---------------------------------------------------------------------------\n\ndef test_is_expired_past_date_true():\n    \"\"\"A past date should be reported as expired.\"\"\"\n    past = (datetime.datetime.now() - datetime.timedelta(days=5)).strftime(\"%Y-%m-%d\")\n    assert is_expired(past) is True\n\n\ndef test_is_expired_future_date_false():\n    \"\"\"A future date should not be reported as expired.\"\"\"\n    future = (datetime.datetime.now() + datetime.timedelta(days=5)).strftime(\"%Y-%m-%d\")\n    assert is_expired(future) is False\n\n\ndef test_is_expired_invalid_date_true():\n    \"\"\"Invalid date maps to datetime.min, which is in the past -> expired.\"\"\"\n    assert is_expired(\"garbage\") is True\n\n\ndef test_is_expired_returns_bool():\n    \"\"\"is_expired should return a bool.\"\"\"\n    result = is_expired(\"2030-01-01\")\n    assert isinstance(result, bool)",
