h pytest.raises(AttributeError):\n        display(\"alpha\")\n\n\ndef test_display_raises_attribute_error_for_unknown_key():\n    \"\"\"display 对未知键 lookup 返回 0（int），同样应抛出 AttributeError。\n\n    期望值来源：目标代码中 lookup 默认返回 0，int 无 strip 方法。\n    \"\"\"\n    with pytest.raises(AttributeError):\n        display(\"nonexistent\")\n\n\n@pytest.mark.parametrize(\"name\", [\"alpha\", \"beta\", \"gamma\", \"delta\", \"\"])\ndef test_display_always_raises_attribute_error(name):\n    \"\"\"无论键是否存在，display 都会因 int.strip() 抛出 AttributeError。\n\n    期望值来源：目标代码逻辑，lookup 始终返回 int。\n    \"\"\"\n    with pytest.raises(AttributeError):\n        display(name)",
