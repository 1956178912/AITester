          "generated_test": "import pytest\n\nfrom task_0037 import normalize_values, aggregate, doubled\n\n\nclass TestNormalizeValues:\n    \"\"\"Tests for normalize_values.\"\"\"\n\n    def test_normalize_values_empty_list_returns_empty(self):\n        \"\"\"Empty input should return empty list (docstring/contract expectation).\n\n        Note: historical bug returned [0]; this test documents the intended\n        contract. Expected value source: function contract (list doubling).\n        \"\"\"\n        assert normalize_values([]) == []\n\n    def test_normalize_values_single_element(self):\n        \"\"\"Single element should be doubled.\"\"\"\n        assert normalize_values([3]) == [6]\n\n    def test_normalize_values_multiple_elements(self):\n        \"\"\"Each element should be doubled, preserving order.\"\"\"\n        assert normalize_values([1, 2, 3]) == [2, 4, 6]\n\n    def test_normalize_values_negative_and_zero(self):\n        \"\"\"Negative and zero values should be doubled correctly.\"\"\"\n        assert normalize_values([0, -1, -5]) == [0, -2, -10]\n\n    def test_normalize_values_floats(self):\n        \"\"\"Float values should be doubled.\"\"\"\n        assert normalize_values([1.5, 2.5]) == [3.0, 5.0]\n\n    def test_normalize_values_returns_new_list(self):\n        \"\"\"Result should be a new list, not the same object.\"\"\"\n        original = [1, 2]\n        result = normalize_values(original)\n        assert result is not original\n        assert original == [1, 2]\n\n\nclass TestAggregate:\n    \"\"\"Tests for aggregate.\"\"\"\n\n    def test_aggregate_single_element(self):\n        \"\"\"Average of a single element is that element.\"\"\"\n        assert aggregate([5]) == 5.0\n\n    def test_aggregate_multiple_elements(self):\n        \"\"\"Average of [1, 2, 3] is 2.0.\"\"\"\n        assert aggregate([1, 2, 3]) == 2.0\n\n    def test_aggregate_floats(self):\n        \"\"\"Average of floats.\"\"\"\n        assert aggregate([1.0, 2.0, 3.0, 4.0]) == 2.5\n\n    def test_aggregate_negative_values(self):\n        \"\"\"Average with negative values.\"\"\"\n        assert aggregate([-2, -4]) == -3.0\n\n    def test_aggregate_empty_list_raises(self):\n        \"\"\"Empty list should raise ZeroDivisionError (historical bug).\n\n        Expected value source: division by len(values) when empty.\n        \"\"\"\n        with pytest.raises(ZeroDivisionError):\n            aggregate([])\n\n\nclass TestDoubled:\n    \"\"\"Tests for doubled.\"\"\"\n\n    def test_doubled_empty_list(self):\n        \"\"\"Doubled sum of empty list is 0.\"\"\"\n        assert doubled([]) == 0\n\n    def test_doubled_single_element(self):\n        \"\"\"Doubled sum of [3] is 6.\"\"\"\n        assert doubled([3]) == 6\n\n    def test_doubled_multiple_elements(self):\n        \"\"\"Doubled sum of [1, 2, 3] is 12.\"\"\"\n        assert doubled([1, 2, 3]) == 12\n\n    def test_doubled_floats(self):\n        \"\"\"Doubled sum of floats.\"\"\"\n        assert doubled([1.5, 2.5]) == 8.0\n\n    def test_doubled_negative_values(self):\n        \"\"\"Doubled sum with negatives.\"\"\"\n        assert doubled([-1, -2, 3]) == 0\n\n    def test_doubled_returns_numeric(self):\n        \"\"\"Result should be numeric (int or float).\"\"\"\n        result = doubled([1, 2])\n        assert isinstance(result, (int, float))",
