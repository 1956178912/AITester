          "generated_test": "import datetime\nimport pytest\n\nfrom task_0019 import parse_date, days_until, is_expired\n\n\n# ---------------------------------------------------------------------------\n# parse_date\n# ---------------------------------------------------------------------------\n\ndef test_parse_date_valid_date_returns_datetime():\n    \"\"\"parse_date 对合法日期字符串应返回对应的 datetime 对象。\"\"\"\n    result = parse_date(\"2024-01-15\")\n    assert isinstance(result, datetime.datetime)\n    assert result == datetime.datetime(2024, 1, 15)\n\n\ndef test_parse_date_invalid_format_returns_datetime_min():\n    \"\"\"parse_date 对非法格式应返回 datetime.min（依据源码 except 分支）。\"\"\"\n    result = parse_date(\"not-a-date\")\n    assert result == datetime.datetime.min\n\n\ndef test_parse_date_empty_string_returns_datetime_min():\n    \"\"\"parse_date 对空字符串应返回 datetime.min。\"\"\"\n    result = parse_date(\"\")\n    assert result == datetime.datetime.min\n\n\ndef test_parse_date_wrong_separator_returns_datetime_min():\n    \"\"\"parse_date 对使用错误分隔符的字符串应返回 datetime.min。\"\"\"\n    result = parse_date(\"2024/01/15\")\n    assert result == datetime.datetime.min\n\n\ndef test_parse_date_out_of_range_month_returns_datetime_min():\n    \"\"\"parse_date 对月份越界的字符串应返回 datetime.min。\"\"\"\n    result = parse_date(\"2024-13-01\")\n    assert result == datetime.datetime.min\n\n\n@pytest.mark.parametrize(\n    \"value\",\n    [\"2024-02-29\", \"2000-02-29\", \"1999-12-31\", \"0001-01-01\"],\n)\ndef test_parse_date_various_valid_dates(value):\n    \"\"\"parse_date 对多种合法日期字符串应返回非 datetime.min 的 datetime。\"\"\"\n    result = parse_date(value)\n    assert isinstance(result, datetime.datetime)\n    assert result != datetime.datetime.min\n\n\n# ---------------------------------------------------------------------------\n# days_until\n# ---------------------------------------------------------------------------\n\ndef test_days_until_future_date_positive():\n    \"\"\"days_until 对未来日期应返回正数天数（依据源码 delta.days）。\"\"\"\n    future = (datetime.datetime.now() + datetime.timedelta(days=10)).strftime(\"%Y-%m-%d\")\n    result = days_until(future)\n    # 由于 now() 的时分秒，结果可能为 9 或 10，断言为正即可\n    assert result > 0\n\n\ndef test_days_until_past_date_negative():\n    \"\"\"days_until 对过去日期应返回负数天数。\"\"\"\n    past = (datetime.datetime.now() - datetime.timedelta(days=10)).strftime(\"%Y-%m-%d\")\n    result = days_until(past)\n    assert result < 0\n\n\ndef test_days_until_invalid_date_returns_large_negative():\n    \"\"\"days_until 对非法日期（parse_date 返回 datetime.min）应返回很大的负数。\n\n    期望值来源：源码中 parse_date 失败返回 datetime.min，与 now() 相减\n    得到负的天数，因此结果必然远小于 0。\n    \"\"\"\n    result = days_until(\"invalid\")\n    assert result < 0\n\n\ndef test_days_until_returns_int():\n    \"\"\"days_until 的返回值应为 int 类型（依据类型注解 -> int）。\"\"\"\n    future = (datetime.datetime.now() + datetime.timedelta(days=1)).strftime(\"%Y-%m-%d\")\n    result = days_until(future)\n    assert isinstance(result, int)\n\n\n# ---------------------------------------------------------------------------\n# is_expired\n# ---------------------------------------------------------------------------\n\ndef test_is_expired_past_date_true():\n    \"\"\"is_expired 对过去日期应返回 True（days_until < 0）。\"\"\"\n    past = (datetime.datetime.now() - datetime.timedelta(days=5)).strftime(\"%Y-%m-%d\")\n    assert is_expired(past) is True\n\n\ndef test_is_expired_future_date_false():\n    \"\"\"is_expired 对未来日期应返回 False。\"\"\"\n    future = (datetime.datetime.now() + datetime.timedelta(days=5)).strftime(\"%Y-%m-%d\")\n    assert is_expired(future) is False\n\n\ndef test_is_expired_invalid_date_true():\n    \"\"\"is_expired 对非法日期应返回 True（parse_date 返回 datetime.min，days_until 为负）。\"\"\"\n    assert is_expired(\"bad-date\") is True\n\n\ndef test_is_expired_returns_bool():\n    \"\"\"is_expired 的返回值应为 bool 类型（依据类型注解 -> bool）。\"\"\"\n    future = (datetime.datetime.now() + datetime.timedelta(days=1)).strftime(\"%Y-%m-%d\")\n    result = is_expired(future)\n    assert isinstance(result, bool)",
