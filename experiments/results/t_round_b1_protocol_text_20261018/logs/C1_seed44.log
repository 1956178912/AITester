egative_values():\n    \"\"\"包含负数时平均值计算应正确。\"\"\"\n    assert aggregate([-2, 2]) == 0.0\n\n\ndef test_aggregate_returns_float():\n    \"\"\"返回值应为 float 类型。\"\"\"\n    result = aggregate([1, 2])\n    assert isinstance(result, float)\n\n\n# ---------------------------------------------------------------------------\n# doubled\n# ---------------------------------------------------------------------------\n\ndef test_doubled_empty_list():\n    \"\"\"空列表的总和翻倍应为 0。\"\"\"\n    assert doubled([]) == 0\n\n\ndef test_doubled_single_element():\n    \"\"\"单元素列表的总和翻倍应为该元素的两倍。\"\"\"\n    assert doubled([3]) == 6\n\n\ndef test_doubled_multiple_elements():\n    \"\"\"多元素列表的总和翻倍应正确。\"\"\"\n    assert doubled([1, 2, 3]) == 12\n\n\ndef test_doubled_negative_values():\n    \"\"\"包含负数时总和翻倍应正确。\"\"\"\n    assert doubled([-1, -2, 3]) == 0\n\n\ndef test_doubled_returns_numeric():\n    \"\"\"\n    返回值应为数值类型。\n    期望值来源不明（docstring 标注返回 float，但实现可能返回 int），\n    此处仅断言为数值类型，需人工确认是否应强制 float。\n    \"\"\"\n    result = doubled([1, 2])\n    assert isinstance(result, (int, float))",
