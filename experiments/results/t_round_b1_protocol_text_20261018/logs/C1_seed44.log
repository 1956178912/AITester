          "generated_test": "import pytest\n\nfrom task_0078 import safe_div\n\n\ndef test_safe_div_returns_float_for_integers():\n    \"\"\"safe_div 对整数输入应返回浮点结果（类型注解 -> float）。\"\"\"\n    result = safe_div(6, 3)\n    assert result == 2.0\n    assert isinstance(result, float)\n\n\ndef test_safe_div_returns_float_for_non_divisible():\n    \"\"\"safe_div 对不能整除的整数输入应返回精确浮点结果。\"\"\"\n    result = safe_div(1, 2)\n    assert result == 0.5\n    assert isinstance(result, float)\n\n\ndef test_safe_div_negative_operands():\n    \"\"\"safe_div 支持负数操作数，结果符号符合除法规则。\"\"\"\n    assert safe_div(-6, 3) == -2.0\n    assert safe_div(6, -3) == -2.0\n    assert safe_div(-6, -3) == 2.0\n\n\ndef test_safe_div_zero_numerator():\n    \"\"\"safe_div 分子为 0 时应返回 0.0。\"\"\"\n    result = safe_div(0, 5)\n    assert result == 0.0\n    assert isinstance(result, float)\n\n\ndef test_safe_div_division_by_zero_raises():\n    \"\"\"safe_div 除数为 0 时应抛出 ZeroDivisionError（Python 除法语义）。\"\"\"\n    with pytest.raises(ZeroDivisionError):\n        safe_div(1, 0)\n\n\n@pytest.mark.parametrize(\n    \"a, b, expected\",\n    [\n        (10, 2, 5.0),\n        (7, 2, 3.5),\n        (-9, 3, -3.0),\n        (0, 1, 0.0),\n        (1, 4, 0.25),\n    ],\n)\ndef test_safe_div_parametrized(a, b, expected):\n    \"\"\"safe_div 参数化用例：验证常见整数除法的浮点结果。\"\"\"\n    result = safe_div(a, b)\n    assert result == expected\n    assert isinstance(result, float)",
