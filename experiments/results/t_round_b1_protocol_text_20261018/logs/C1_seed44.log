          "generated_test": "import pytest\n\nfrom task_0042 import normalize, aggregate, report\n\n\n# ---------------------------------------------------------------------------\n# normalize\n# ---------------------------------------------------------------------------\n\ndef test_normalize_empty_list():\n    \"\"\"normalize([]) 应返回空列表（列表推导对空输入返回空列表）。\"\"\"\n    assert normalize([]) == []\n\n\ndef test_normalize_doubles_each_element():\n    \"\"\"normalize 对每个元素乘以 2（依据实现 [x * 2 for x in data]）。\"\"\"\n    assert normalize([1, 2, 3]) == [2, 4, 6]\n\n\ndef test_normalize_negative_and_zero():\n    \"\"\"normalize 对负数与 0 同样乘以 2。\"\"\"\n    assert normalize([0, -1, -5]) == [0, -2, -10]\n\n\ndef test_normalize_returns_new_list():\n    \"\"\"normalize 应返回新列表，不修改输入列表。\"\"\"\n    data = [1, 2, 3]\n    result = normalize(data)\n    assert result == [2, 4, 6]\n    assert data == [1, 2, 3]\n    assert result is not data\n\n\ndef test_normalize_floats():\n    \"\"\"normalize 对浮点数同样乘以 2。\"\"\"\n    assert normalize([0.5, 1.5]) == [1.0, 3.0]\n\n\n# ---------------------------------------------------------------------------\n# aggregate\n# ---------------------------------------------------------------------------\n\ndef test_aggregate_empty_list():\n    \"\"\"aggregate([]) 依据实现返回 {'count': 0, 'total': 0}。\"\"\"\n    assert aggregate([]) == {\"count\": 0, \"total\": 0}\n\n\ndef test_aggregate_single_element():\n    \"\"\"aggregate 对单元素列表返回 count=1、total=该元素。\"\"\"\n    assert aggregate([5]) == {\"count\": 1, \"total\": 5}\n\n\ndef test_aggregate_multiple_elements():\n    \"\"\"aggregate 返回元素个数与元素之和。\"\"\"\n    assert aggregate([1, 2, 3, 4]) == {\"count\": 4, \"total\": 10}\n\n\ndef test_aggregate_negative_values():\n    \"\"\"aggregate 对含负数的列表正确求和。\"\"\"\n    assert aggregate([-1, -2, 3]) == {\"count\": 3, \"total\": 0}\n\n\ndef test_aggregate_returns_dict_with_expected_keys():\n    \"\"\"aggregate 返回值应恰好包含 count 与 total 两个键。\"\"\"\n    result = aggregate([1, 2])\n    assert set(result.keys()) == {\"count\", \"total\"}\n\n\n# ---------------------------------------------------------------------------\n# report\n# ---------------------------------------------------------------------------\n\ndef test_report_empty_list():\n    \"\"\"report([]) 先 normalize 得 []，再 aggregate 得 count=0,total=0。\"\"\"\n    assert report([]) == \"count=0 total=0\"\n\n\ndef test_report_single_element():\n    \"\"\"report([3]) -> normalize=[6] -> count=1,total=6。\"\"\"\n    assert report([3]) == \"count=1 total=6\"\n\n\ndef test_report_multiple_elements():\n    \"\"\"report([1,2,3]) -> normalize=[2,4,6] -> count=3,total=12。\"\"\"\n    assert report([1, 2, 3]) == \"count=3 total=12\"\n\n\ndef test_report_negative_values():\n    \"\"\"report([-1,-2]) -> normalize=[-2,-4] -> count=2,total=-6。\"\"\"\n    assert report([-1, -2]) == \"count=2 total=-6\"\n\n\ndef test_report_returns_string():\n    \"\"\"report 返回值类型应为 str。\"\"\"\n    assert isinstance(report([1, 2]), str)\n\n\ndef test_report_does_not_mutate_input():\n    \"\"\"report 不应修改传入的原始列表。\"\"\"\n    data = [1, 2, 3]\n    report(data)\n    assert data == [1, 2, 3]",
