          "generated_test": "import pytest\n\nfrom task_0064 import process\n\n\ndef test_process_returns_list():\n    \"\"\"process 应返回 list 类型（依据类型注解 -> list）。\"\"\"\n    result = process([1, 2, 3])\n    assert isinstance(result, list)\n\n\ndef test_process_increments_each_element():\n    \"\"\"每个元素应加 1（依据函数实现语义）。\"\"\"\n    assert process([1, 2, 3]) == [2, 3, 4, 0]\n\n\ndef test_process_appends_zero_at_end():\n    \"\"\"结果末尾应追加一个 0（依据函数实现语义）。\"\"\"\n    result = process([5])\n    assert result[-1] == 0\n\n\ndef test_process_empty_list():\n    \"\"\"空输入应返回仅含追加 0 的列表。\"\"\"\n    assert process([]) == [0]\n\n\ndef test_process_negative_numbers():\n    \"\"\"负数元素同样加 1。\"\"\"\n    assert process([-1, -2]) == [0, -1, 0]\n\n\ndef test_process_length_is_input_plus_one():\n    \"\"\"输出长度应为输入长度加 1（依据实现：列表推导 + 追加一个 0）。\"\"\"\n    items = [10, 20, 30, 40]\n    assert len(process(items)) == len(items) + 1\n\n\ndef test_process_does_not_mutate_input():\n    \"\"\"process 不应修改传入的列表。\"\"\"\n    items = [1, 2, 3]\n    original = list(items)\n    process(items)\n    assert items == original\n\n\n@pytest.mark.parametrize(\n    \"items, expected\",\n    [\n        ([0], [1, 0]),\n        ([1, 1, 1], [2, 2, 2, 0]),\n        ([100], [101, 0]),\n    ],\n)\ndef test_process_parametrized(items, expected):\n    \"\"\"参数化验证元素加 1 且末尾追加 0。\"\"\"\n    assert process(items) == expected\n\n\ndef test_process_non_list_input_raises():\n    \"\"\"非可迭代/不支持加法的输入应抛出异常（期望值来源不明，需人工确认）。\"\"\"\n    with pytest.raises(TypeError):\n        process(None)",
