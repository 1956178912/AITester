          "generated_test": "import pytest\n\nfrom task_0080 import process\n\n\ndef test_process_returns_list():\n    \"\"\"process 应返回 list 类型（依据函数返回类型注解 -> list）。\"\"\"\n    result = process([1, 2, 3])\n    assert isinstance(result, list)\n\n\ndef test_process_adds_one_to_each_item():\n    \"\"\"process 对每个元素加 1（依据函数体实现 x + 1）。\"\"\"\n    assert process([1, 2, 3]) == [2, 3, 4]\n\n\ndef test_process_appends_zero_at_end():\n    \"\"\"process 在结果末尾追加 0（依据函数体实现 + [0]）。\"\"\"\n    result = process([1, 2, 3])\n    assert result[-1] == 0\n\n\ndef test_process_empty_list():\n    \"\"\"空列表输入时，结果应仅包含末尾追加的 0（依据函数体实现）。\"\"\"\n    assert process([]) == [0]\n\n\ndef test_process_negative_numbers():\n    \"\"\"负数元素同样加 1（依据函数体实现 x + 1）。\"\"\"\n    assert process([-3, -1, 0]) == [-2, 0, 1, 0]\n\n\ndef test_process_single_element():\n    \"\"\"单元素列表：元素加 1 后追加 0（依据函数体实现）。\"\"\"\n    assert process([5]) == [6, 0]\n\n\ndef test_process_does_not_mutate_input():\n    \"\"\"process 不应修改传入的列表（依据列表推导式生成新列表）。\"\"\"\n    items = [1, 2, 3]\n    original = list(items)\n    process(items)\n    assert items == original\n\n\ndef test_process_output_length():\n    \"\"\"输出长度应为输入长度加 1（依据函数体实现：逐元素加 1 后追加 0）。\"\"\"\n    items = [10, 20, 30, 40]\n    assert len(process(items)) == len(items) + 1\n\n\n@pytest.mark.parametrize(\n    \"items, expected\",\n    [\n        ([1], [2, 0]),\n        ([0], [1, 0]),\n        ([1, 1, 1], [2, 2, 2, 0]),\n        ([-1, -2], [0, -1, 0]),\n    ],\n)\ndef test_process_parametrized(items, expected):\n    \"\"\"参数化验证 process 的逐元素加 1 与末尾追加 0 行为（依据函数体实现）。\"\"\"\n    assert process(items) == expected\n\n\ndef test_process_non_int_raises_type_error():\n    \"\"\"非数值元素（如字符串）执行 x + 1 会抛 TypeError（依据函数体实现）。\n\n    期望值来源：函数体对元素执行 x + 1，字符串与 int 相加在 Python 中抛 TypeError。\n    \"\"\"\n    with pytest.raises(TypeError):\n        process([\"a\", \"b\"])\n\n\ndef test_process_none_input_raises_type_error():\n    \"\"\"传入 None 时迭代会抛 TypeError（依据函数体对 items 进行迭代）。\n\n    期望值来源：函数体对 items 直接迭代，None 不可迭代，抛 TypeError。\n    \"\"\"\n    with pytest.raises(TypeError):\n        process(None)",
