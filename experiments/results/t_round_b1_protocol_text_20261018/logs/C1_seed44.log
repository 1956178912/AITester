          "generated_test": "import pytest\n\nfrom task_0004 import compare, sort_desc, top_k\n\n\n# ---------------------------------------------------------------------------\n# compare\n# ---------------------------------------------------------------------------\n\ndef test_compare_greater_returns_1():\n    \"\"\"a > b 时应返回 1（依据 docstring/实现约定）。\"\"\"\n    assert compare(5, 3) == 1\n\n\ndef test_compare_less_returns_minus_1():\n    \"\"\"a < b 时应返回 -1（依据实现约定）。\"\"\"\n    assert compare(3, 5) == -1\n\n\ndef test_compare_equal_returns_0():\n    \"\"\"a == b 时应返回 0（依据实现约定）。\"\"\"\n    assert compare(4, 4) == 0\n\n\n@pytest.mark.parametrize(\n    \"a,b,expected\",\n    [\n        (0, 0, 0),\n        (-1, -2, 1),\n        (-2, -1, -1),\n        (10, -10, 1),\n        (-10, 10, -1),\n        (100, 100, 0),\n    ],\n)\ndef test_compare_parametrized(a, b, expected):\n    \"\"\"参数化验证 compare 的三值语义。\"\"\"\n    assert compare(a, b) == expected\n\n\n# ---------------------------------------------------------------------------\n# sort_desc\n# ---------------------------------------------------------------------------\n\ndef test_sort_desc_returns_sorted_list():\n    \"\"\"sort_desc 应返回降序排列的列表。\"\"\"\n    assert sort_desc([3, 1, 2]) == [3, 2, 1]\n\n\ndef test_sort_desc_empty_list():\n    \"\"\"空列表应返回空列表。\"\"\"\n    assert sort_desc([]) == []\n\n\ndef test_sort_desc_single_element():\n    \"\"\"单元素列表应原样返回。\"\"\"\n    assert sort_desc([7]) == [7]\n\n\ndef test_sort_desc_already_sorted():\n    \"\"\"已降序的列表应保持不变。\"\"\"\n    assert sort_desc([5, 4, 3, 2, 1]) == [5, 4, 3, 2, 1]\n\n\ndef test_sort_desc_with_duplicates():\n    \"\"\"含重复元素的列表应正确降序排列。\"\"\"\n    assert sort_desc([2, 3, 2, 1, 3]) == [3, 3, 2, 2, 1]\n\n\ndef test_sort_desc_with_negatives():\n    \"\"\"含负数的列表应正确降序排列。\"\"\"\n    assert sort_desc([-1, 5, -10, 0]) == [5, 0, -1, -10]\n\n\ndef test_sort_desc_in_place_mutation():\n    \"\"\"sort_desc 原地排序并返回同一列表对象（依据实现约定）。\"\"\"\n    arr = [1, 3, 2]\n    result = sort_desc(arr)\n    assert result is arr\n    assert arr == [3, 2, 1]\n\n\n# ---------------------------------------------------------------------------\n# top_k\n# ---------------------------------------------------------------------------\n\ndef test_top_k_basic():\n    \"\"\"top_k 应返回降序排列的前 k 个元素。\"\"\"\n    assert top_k([1, 5, 3, 4, 2], 2) == [5, 4]\n\n\ndef test_top_k_k_zero_returns_empty():\n    \"\"\"k <= 0 时应返回空列表（依据实现约定）。\"\"\"\n    assert top_k([1, 2, 3], 0) == []\n\n\ndef test_top_k_k_negative_returns_empty():\n    \"\"\"k 为负数时应返回空列表（依据实现约定）。\"\"\"\n    assert top_k([1, 2, 3], -5) == []\n\n\ndef test_top_k_k_equals_length():\n    \"\"\"k 等于列表长度时应返回完整降序列表。\"\"\"\n    assert top_k([3, 1, 2], 3) == [3, 2, 1]\n\n\ndef test_top_k_k_greater_than_length():\n    \"\"\"k 大于列表长度时应返回完整降序列表（依据实现约定）。\"\"\"\n    assert top_k([3, 1, 2], 10) == [3, 2, 1]\n\n\ndef test_top_k_empty_list():\n    \"\"\"空列表时 top_k 应返回空列表。\"\"\"\n    assert top_k([], 3) == []\n\n\ndef test_top_k_with_duplicates():\n    \"\"\"含重复元素时 top_k 应正确返回前 k 个。\"\"\"\n    assert top_k([2, 2, 3, 1, 3], 3) == [3, 3, 2]\n\n\n@pytest.mark.parametrize(\n    \"arr,k,expected\",\n    [\n        ([10, 20, 30, 40], 1, [40]),\n        ([10, 20, 30, 40], 2, [40, 30]),\n        ([5], 1, [5]),\n        ([-1, -2, -3], 2, [-1, -2]),\n    ],\n)\ndef test_top_k_parametrized(arr, k, expected):\n    \"\"\"参数化验证 top_k 的截取行为。\"\"\"\n    assert top_k(arr, k) == expected",
