ments():\n    \"\"\"worst_score 应返回列表中的最大值。\"\"\"\n    assert worst_score([3, 1, 4, 1, 5, 9, 2, 6]) == 9\n\n\ndef test_worst_score_sorted_ascending():\n    \"\"\"worst_score 对升序列表应返回最后一个元素。\"\"\"\n    assert worst_score([1, 2, 3, 4, 5]) == 5\n\n\ndef test_worst_score_sorted_descending():\n    \"\"\"worst_score 对降序列表应返回第一个元素。\"\"\"\n    assert worst_score([5, 4, 3, 2, 1]) == 5\n\n\ndef test_worst_score_negative_numbers():\n    \"\"\"worst_score 应正确处理负数。\"\"\"\n    assert worst_score([-1, -5, -3, -2]) == -1\n\n\ndef test_worst_score_all_equal():\n    \"\"\"worst_score 对全部相等的列表应返回该值。\"\"\"\n    assert worst_score([7, 7, 7, 7]) == 7\n\n\ndef test_worst_score_duplicates():\n    \"\"\"worst_score 对含重复最大值的列表应返回该最大值。\"\"\"\n    assert worst_score([2, 3, 2, 3, 1]) == 3\n\n\ndef test_best_and_worst_score_consistency():\n    \"\"\"best_score 与 worst_score 在同一列表上应分别返回最小值和最大值。\"\"\"\n    scores = [10, -3, 7, 0, 15, -8, 4]\n    assert best_score(scores) == min(scores)\n    assert worst_score(scores) == max(scores)",
