          "generated_test": "import pytest\n\nfrom task_0061 import process\n\n\ndef test_process_returns_list():\n    \"\"\"process 应返回 list 类型（依据函数签名 -> list）。\"\"\"\n    result = process([1, 2, 3])\n    assert isinstance(result, list)\n\n\ndef test_process_increments_each_element():\n    \"\"\"每个元素应加 1（依据实现约定：x + 1）。\"\"\"\n    assert process([1, 2, 3]) == [2, 3, 4, 0]\n\n\ndef test_process_appends_zero_at_end():\n    \"\"\"结果末尾应追加一个 0（依据实现约定：+ [0]）。\"\"\"\n    result = process([5])\n    assert result[-1] == 0\n\n\ndef test_process_empty_list():\n    \"\"\"空输入应返回仅含末尾 0 的列表（依据实现约定）。\"\"\"\n    assert process([]) == [0]\n\n\ndef test_process_negative_numbers():\n    \"\"\"负数元素同样加 1（依据实现约定：x + 1）。\"\"\"\n    assert process([-1, -2]) == [0, -1, 0]\n\n\ndef test_process_does_not_mutate_input():\n    \"\"\"process 不应修改传入的列表（依据列表推导式不原地修改）。\"\"\"\n    items = [1, 2, 3]\n    process(items)\n    assert items == [1, 2, 3]\n\n\ndef test_process_output_length():\n    \"\"\"输出长度应为输入长度加 1（依据实现约定：追加一个 0）。\"\"\"\n    items = [10, 20, 30, 40]\n    assert len(process(items)) == len(items) + 1\n\n\ndef test_process_floats():\n    \"\"\"浮点数元素同样加 1（依据实现约定：x + 1）。\"\"\"\n    assert process([1.5, 2.5]) == [2.5, 3.5, 0]\n\n\n@pytest.mark.parametrize(\n    \"items, expected\",\n    [\n        ([0], [1, 0]),\n        ([100], [101, 0]),\n        ([1, 1, 1], [2, 2, 2, 0]),\n    ],\n)\ndef test_process_parametrized(items, expected):\n    \"\"\"参数化验证 process 的加 1 与追加 0 行为（依据实现约定）。\"\"\"\n    assert process(items) == expected\n\n\ndef test_process_non_list_input_raises():\n    \"\"\"传入非可迭代对象应抛出 TypeError（依据列表推导式对不可迭代对象的行为）。\n\n    期望值来源：Python 语言对不可迭代对象迭代时的标准行为，需人工确认。\n    \"\"\"\n    with pytest.raises(TypeError):\n        process(123)",
