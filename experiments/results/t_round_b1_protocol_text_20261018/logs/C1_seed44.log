          "generated_test": "import pytest\n\nfrom task_0083 import lookup, describe, display\n\n\n# ---------------------------------------------------------------------------\n# lookup\n# ---------------------------------------------------------------------------\n\ndef test_lookup_known_keys():\n    \"\"\"已知键应返回 _TABLE 中对应的值（来源：模块内 _TABLE 定义）。\"\"\"\n    assert lookup(\"alpha\") == 1\n    assert lookup(\"beta\") == 2\n    assert lookup(\"gamma\") == 3\n\n\ndef test_lookup_unknown_key_returns_zero():\n    \"\"\"未知键应返回默认值 0（来源：_TABLE.get(key, 0) 的默认参数）。\"\"\"\n    assert lookup(\"delta\") == 0\n    assert lookup(\"\") == 0\n\n\ndef test_lookup_is_case_sensitive():\n    \"\"\"键查找区分大小写，'Alpha' 不在表中，应返回 0（来源：dict 语义）。\"\"\"\n    assert lookup(\"Alpha\") == 0\n\n\n@pytest.mark.parametrize(\"key,expected\", [\n    (\"alpha\", 1),\n    (\"beta\", 2),\n    (\"gamma\", 3),\n    (\"unknown\", 0),\n])\ndef test_lookup_parametrized(key, expected):\n    \"\"\"参数化验证 lookup 的返回值（来源：_TABLE 定义与默认值 0）。\"\"\"\n    assert lookup(key) == expected\n\n\n# ---------------------------------------------------------------------------\n# describe\n# ---------------------------------------------------------------------------\n\ndef test_describe_positive_int():\n    \"\"\"describe 应返回 'value=<n>' 格式（来源：f-string 实现）。\"\"\"\n    assert describe(5) == \"value=5\"\n\n\ndef test_describe_zero():\n    \"\"\"describe(0) 应返回 'value=0'（来源：f-string 实现）。\"\"\"\n    assert describe(0) == \"value=0\"\n\n\ndef test_describe_negative_int():\n    \"\"\"describe 对负数应返回 'value=-3'（来源：f-string 实现）。\"\"\"\n    assert describe(-3) == \"value=-3\"\n\n\n@pytest.mark.parametrize(\"value,expected\", [\n    (0, \"value=0\"),\n    (1, \"value=1\"),\n    (42, \"value=42\"),\n    (-7, \"value=-7\"),\n])\ndef test_describe_parametrized(value, expected):\n    \"\"\"参数化验证 describe 输出格式（来源：f-string 实现）。\"\"\"\n    assert describe(value) == expected\n\n\n# ---------------------------------------------------------------------------\n# display\n# ---------------------------------------------------------------------------\n\ndef test_display_raises_attribute_error_for_int():\n    \"\"\"display 内部对 lookup 的 int 结果调用 .strip()，int 无该属性，\n    因此任何输入都会抛出 AttributeError（来源：代码实现，int 无 strip 方法）。\"\"\"\n    with pytest.raises(AttributeError):\n        display(\"alpha\")\n\n\ndef test_display_raises_attribute_error_for_unknown_key():\n    \"\"\"未知键 lookup 返回 0（int），同样触发 AttributeError（来源：代码实现）。\"\"\"\n    with pytest.raises(AttributeError):\n        display(\"unknown\")\n\n\n@pytest.mark.parametrize(\"name\", [\"alpha\", \"beta\", \"gamma\", \"missing\", \"\"])\ndef test_display_always_raises_attribute_error(name):\n    \"\"\"无论 name 为何值，display 都会因 int.strip() 抛 AttributeError\n    （来源：代码实现；期望值来源明确，为 int 无 strip 属性）。\"\"\"\n    with pytest.raises(AttributeError):\n        display(name)",
