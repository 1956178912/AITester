          "generated_test": "import pytest\n\nfrom task_0077 import initials\n\n\ndef test_initials_basic_two_words():\n    \"\"\"基本用例：两个单词返回首字母大写并以点连接。\"\"\"\n    assert initials(\"john doe\") == \"J.D\"\n\n\ndef test_initials_single_word():\n    \"\"\"单个单词返回其首字母大写。\"\"\"\n    assert initials(\"alice\") == \"A\"\n\n\ndef test_initials_three_words():\n    \"\"\"三个单词返回三个首字母大写并以点连接。\"\"\"\n    assert initials(\"mary jane watson\") == \"M.J.W\"\n\n\ndef test_initials_already_uppercase():\n    \"\"\"输入已大写时结果保持一致。\"\"\"\n    assert initials(\"JOHN DOE\") == \"J.D\"\n\n\ndef test_initials_mixed_case():\n    \"\"\"混合大小写输入应统一转为大写首字母。\"\"\"\n    assert initials(\"jOhN dOe\") == \"J.D\"\n\n\ndef test_initials_extra_whitespace():\n    \"\"\"多余空白应被 split 忽略。\"\"\"\n    assert initials(\"  john   doe  \") == \"J.D\"\n\n\ndef test_initials_tabs_and_newlines():\n    \"\"\"制表符和换行符作为分隔符也应正确处理。\"\"\"\n    assert initials(\"john\\tdoe\\nsmith\") == \"J.D.S\"\n\n\ndef test_initials_none_raises_attribute_error():\n    \"\"\"None 输入会触发 AttributeError（None 无 split 方法）。\n\n    期望值来源：函数签名允许 None，但实现直接调用 full_name.split()，\n    因此 None 会抛出 AttributeError，需人工确认是否应改为显式处理。\n    \"\"\"\n    with pytest.raises(AttributeError):\n        initials(None)\n\n\ndef test_initials_empty_string_raises_value_error():\n    \"\"\"空字符串 split 后为空列表，join 返回空字符串。\n\n    期望值来源：实现逻辑推导，空字符串 -> [] -> \"\"。\n    \"\"\"\n    assert initials(\"\") == \"\"\n\n\ndef test_initials_whitespace_only_raises_value_error():\n    \"\"\"仅含空白的字符串 split 后为空列表，返回空字符串。\n\n    期望值来源：实现逻辑推导。\n    \"\"\"\n    assert initials(\"   \") == \"\"\n\n\ndef test_initials_non_string_raises_attribute_error():\n    \"\"\"非字符串输入（如整数）会触发 AttributeError。\n\n    期望值来源：实现直接调用 .split()，整数无此方法。\n    \"\"\"\n    with pytest.raises(AttributeError):\n        initials(123)",
