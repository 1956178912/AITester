          "generated_test": "import pytest\n\nfrom task_0055 import lookup, describe, display\n\n\nclass TestLookup:\n    \"\"\"Tests for lookup function.\"\"\"\n\n    @pytest.mark.parametrize(\n        \"key, expected\",\n        [\n            (\"alpha\", 1),\n            (\"beta\", 2),\n            (\"gamma\", 3),\n        ],\n    )\n    def test_lookup_known_keys(self, key, expected):\n        \"\"\"Known keys should return their mapped integer values.\"\"\"\n        assert lookup(key) == expected\n\n    @pytest.mark.parametrize(\"key\", [\"delta\", \"\", \"ALPHA\", \"unknown\"])\n    def test_lookup_unknown_keys_returns_zero(self, key):\n        \"\"\"Unknown keys should return the default value 0.\"\"\"\n        assert lookup(key) == 0\n\n    def test_lookup_returns_int(self):\n        \"\"\"lookup should always return an int per its type annotation.\"\"\"\n        assert isinstance(lookup(\"alpha\"), int)\n        assert isinstance(lookup(\"missing\"), int)\n\n\nclass TestDescribe:\n    \"\"\"Tests for describe function.\"\"\"\n\n    @pytest.mark.parametrize(\n        \"value, expected\",\n        [\n            (0, \"value=0\"),\n            (1, \"value=1\"),\n            (-5, \"value=-5\"),\n            (42, \"value=42\"),\n        ],\n    )\n    def test_describe_formats_value(self, value, expected):\n        \"\"\"describe should format as 'value=<int>'.\"\"\"\n        assert describe(value) == expected\n\n    def test_describe_returns_str(self):\n        \"\"\"describe should return a string.\"\"\"\n        assert isinstance(describe(7), str)\n\n\nclass TestDisplay:\n    \"\"\"Tests for display function.\"\"\"\n\n    def test_display_known_key_raises_attribute_error(self):\n        \"\"\"display calls .strip() on an int from lookup, which raises AttributeError.\n\n        Expected behavior derived from source: lookup returns int, and int has\n        no .strip() method, so display raises AttributeError for any input.\n        \"\"\"\n        with pytest.raises(AttributeError):\n            display(\"alpha\")\n\n    def test_display_unknown_key_raises_attribute_error(self):\n        \"\"\"Unknown key yields int 0 from lookup, also lacking .strip().\"\"\"\n        with pytest.raises(AttributeError):\n            display(\"nonexistent\")\n\n    def test_display_empty_string_raises_attribute_error(self):\n        \"\"\"Empty string key yields int 0 from lookup, also lacking .strip().\"\"\"\n        with pytest.raises(AttributeError):\n            display(\"\")",
