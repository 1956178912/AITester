          "generated_test": "import pytest\n\nfrom task_0049 import compute_scores, average, rank_top\n\n\n# ---------------------------------------------------------------------------\n# compute_scores\n# ---------------------------------------------------------------------------\n\ndef test_compute_scores_basic():\n    \"\"\"基本用例：根据 name/value 构建映射。\"\"\"\n    records = [\n        {\"name\": \"a\", \"value\": 10},\n        {\"name\": \"b\", \"value\": 20},\n    ]\n    assert compute_scores(records) == {\"a\": 10, \"b\": 20}\n\n\ndef test_compute_scores_empty_list():\n    \"\"\"空列表应返回空字典。\"\"\"\n    assert compute_scores([]) == {}\n\n\ndef test_compute_scores_missing_name_uses_unknown():\n    \"\"\"缺少 name 时使用默认键 'unknown'（来自 docstring/实现约定）。\"\"\"\n    records = [{\"value\": 5}]\n    assert compute_scores(records) == {\"unknown\": 5}\n\n\ndef test_compute_scores_missing_value_defaults_zero():\n    \"\"\"缺少 value 时默认值为 0（来自实现约定）。\"\"\"\n    records = [{\"name\": \"x\"}]\n    assert compute_scores(records) == {\"x\": 0}\n\n\ndef test_compute_scores_duplicate_name_last_wins():\n    \"\"\"同名记录后者覆盖前者（字典赋值语义）。\"\"\"\n    records = [\n        {\"name\": \"a\", \"value\": 1},\n        {\"name\": \"a\", \"value\": 2},\n    ]\n    assert compute_scores(records) == {\"a\": 2}\n\n\ndef test_compute_scores_empty_record():\n    \"\"\"空记录使用默认键和默认值。\"\"\"\n    assert compute_scores([{}]) == {\"unknown\": 0}\n\n\n# ---------------------------------------------------------------------------\n# average\n# ---------------------------------------------------------------------------\n\ndef test_average_empty_dict_returns_zero():\n    \"\"\"空字典返回 0.0（来自实现约定）。\"\"\"\n    assert average({}) == 0.0\n\n\ndef test_average_single_value():\n    \"\"\"单个值的平均值等于该值。\"\"\"\n    assert average({\"a\": 10}) == 10.0\n\n\ndef test_average_multiple_values():\n    \"\"\"多个值的平均值。\"\"\"\n    assert average({\"a\": 10, \"b\": 20, \"c\": 30}) == 20.0\n\n\ndef test_average_returns_float():\n    \"\"\"返回值应为 float 类型。\"\"\"\n    result = average({\"a\": 1, \"b\": 2})\n    assert isinstance(result, float)\n\n\ndef test_average_negative_values():\n    \"\"\"包含负值的平均值。\"\"\"\n    assert average({\"a\": -10, \"b\": 10}) == 0.0\n\n\n# ---------------------------------------------------------------------------\n# rank_top\n# ---------------------------------------------------------------------------\n\ndef test_rank_top_basic():\n    \"\"\"按值降序返回前 k 项。\"\"\"\n    scores = {\"a\": 1, \"b\": 3, \"c\": 2}\n    assert rank_top(scores, 2) == [(\"b\", 3), (\"c\", 2)]\n\n\ndef test_rank_top_k_larger_than_size():\n    \"\"\"k 大于字典大小时返回全部项。\"\"\"\n    scores = {\"a\": 1, \"b\": 2}\n    assert rank_top(scores, 10) == [(\"b\", 2), (\"a\", 1)]\n\n\ndef test_rank_top_k_zero():\n    \"\"\"k 为 0 时返回空列表。\"\"\"\n    assert rank_top({\"a\": 1}, 0) == []\n\n\ndef test_rank_top_empty_scores():\n    \"\"\"空字典返回空列表。\"\"\"\n    assert rank_top({}, 3) == []\n\n\ndef test_rank_top_returns_list_of_tuples():\n    \"\"\"返回值为 (key, value) 元组列表。\"\"\"\n    result = rank_top({\"a\": 5}, 1)\n    assert result == [(\"a\", 5)]\n    assert isinstance(result, list)\n    assert isinstance(result[0], tuple)\n\n\ndef test_rank_top_negative_k():\n    \"\"\"k 为负数时切片行为：返回除末尾 |k| 项外的所有项（Python 切片语义）。\"\"\"\n    scores = {\"a\": 3, \"b\": 2, \"c\": 1}\n    # 期望值来源：Python 列表切片语义，非 docstring 明确约定，需人工确认\n    assert rank_top(scores, -1) == [(\"a\", 3), (\"b\", 2)]",
