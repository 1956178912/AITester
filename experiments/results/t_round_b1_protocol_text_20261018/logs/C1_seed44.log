          "generated_test": "import pytest\n\nfrom task_0039 import factorial\n\n\ndef test_factorial_zero_returns_one():\n    \"\"\"factorial(0) 应返回 1（依据函数实现与阶乘定义）。\"\"\"\n    assert factorial(0) == 1\n\n\n@pytest.mark.parametrize(\n    \"n, expected\",\n    [\n        (1, 1),\n        (2, 2),\n        (3, 6),\n        (4, 24),\n        (5, 120),\n        (6, 720),\n        (7, 5040),\n        (10, 3628800),\n    ],\n)\ndef test_factorial_positive_integers(n, expected):\n    \"\"\"正整数 n 的阶乘应等于 n!（依据阶乘数学定义）。\"\"\"\n    assert factorial(n) == expected\n\n\ndef test_factorial_recursive_consistency():\n    \"\"\"对任意 n>=1，factorial(n) 应等于 n * factorial(n-1)（依据实现逻辑）。\"\"\"\n    for n in range(1, 8):\n        assert factorial(n) == n * factorial(n - 1)\n\n\ndef test_factorial_negative_raises_recursion_error():\n    \"\"\"负数输入会导致无限递归，最终抛出 RecursionError（依据实现无负数保护）。\n\n    期望值来源：实现中缺少 n<0 的边界处理，递归无法终止。\n    \"\"\"\n    with pytest.raises(RecursionError):\n        factorial(-1)\n\n\ndef test_factorial_non_integer_float_raises_recursion_error():\n    \"\"\"非整数（如 2.5）输入会因递归无法到达 0 而抛出 RecursionError。\n\n    期望值来源：实现仅判断 n == 0，浮点数递减不会精确等于 0。\n    \"\"\"\n    with pytest.raises(RecursionError):\n        factorial(2.5)",
