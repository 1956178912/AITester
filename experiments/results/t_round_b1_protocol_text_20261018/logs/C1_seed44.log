          "generated_test": "import math\nimport pytest\n\nfrom task_0067 import rounded_ratio\n\n\ndef test_rounded_ratio_zero_total_returns_zero():\n    \"\"\"total 为 0 时应返回 0.0（依据 docstring/实现约定）。\"\"\"\n    assert rounded_ratio(5, 0) == 0.0\n\n\ndef test_rounded_ratio_zero_hit_returns_zero():\n    \"\"\"hit 为 0 时比例应为 0.0。\"\"\"\n    assert rounded_ratio(0, 10) == 0.0\n\n\ndef test_rounded_ratio_full_hit_returns_one():\n    \"\"\"hit 等于 total 时比例应为 1.0。\"\"\"\n    assert rounded_ratio(10, 10) == 1.0\n\n\ndef test_rounded_ratio_half_returns_half():\n    \"\"\"hit 为 total 一半时比例应为 0.5。\"\"\"\n    assert rounded_ratio(5, 10) == 0.5\n\n\n@pytest.mark.parametrize(\n    \"hit,total,expected\",\n    [\n        (1, 3, math.floor(1 / 3 * 100) / 100),\n        (2, 3, math.floor(2 / 3 * 100) / 100),\n        (1, 7, math.floor(1 / 7 * 100) / 100),\n        (3, 8, math.floor(3 / 8 * 100) / 100),\n        (99, 100, 0.99),\n        (1, 100, 0.01),\n    ],\n)\ndef test_rounded_ratio_floor_to_two_decimals(hit, total, expected):\n    \"\"\"结果应为向下取整到两位小数的比例（依据实现中的 math.floor 逻辑）。\"\"\"\n    assert rounded_ratio(hit, total) == expected\n\n\ndef test_rounded_ratio_returns_float_type():\n    \"\"\"返回值类型应为 float。\"\"\"\n    result = rounded_ratio(1, 2)\n    assert isinstance(result, float)\n\n\ndef test_rounded_ratio_never_exceeds_one():\n    \"\"\"对于合法输入 0 <= hit <= total，结果不应超过 1.0。\"\"\"\n    for hit, total in [(0, 1), (1, 2), (2, 3), (7, 10), (10, 10)]:\n        assert rounded_ratio(hit, total) <= 1.0\n\n\ndef test_rounded_ratio_never_negative_for_valid_input():\n    \"\"\"对于合法输入 0 <= hit <= total，结果不应为负。\"\"\"\n    for hit, total in [(0, 1), (1, 2), (2, 3), (7, 10), (10, 10)]:\n        assert rounded_ratio(hit, total) >= 0.0\n\n\ndef test_rounded_ratio_monotonic_in_hit():\n    \"\"\"固定 total 时，hit 增大结果不应减小。\"\"\"\n    total = 10\n    prev = rounded_ratio(0, total)\n    for hit in range(1, total + 1):\n        cur = rounded_ratio(hit, total)\n        assert cur >= prev\n        prev = cur\n\n\ndef test_rounded_ratio_zero_total_ignores_hit():\n    \"\"\"total 为 0 时无论 hit 为何值都返回 0.0。\"\"\"\n    assert rounded_ratio(0, 0) == 0.0\n    assert rounded_ratio(100, 0) == 0.0",
