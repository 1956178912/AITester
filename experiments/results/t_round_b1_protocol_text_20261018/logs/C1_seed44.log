          "generated_test": "import pytest\n\nfrom task_0048 import fibonacci\n\n\ndef test_fibonacci_returns_int_for_positive_input():\n    \"\"\"fibonacci 对正整数输入应返回 int 类型结果。\"\"\"\n    result = fibonacci(5)\n    assert isinstance(result, int)\n\n\n@pytest.mark.parametrize(\"n\", [0, -1, -10])\ndef test_fibonacci_non_positive_returns_one(n):\n    \"\"\"根据实现，n <= 0 时返回 1（期望值来源：目标代码分支逻辑）。\"\"\"\n    assert fibonacci(n) == 1\n\n\ndef test_fibonacci_n_equals_one_returns_one():\n    \"\"\"n == 1 时返回 1（期望值来源：目标代码分支逻辑）。\"\"\"\n    assert fibonacci(1) == 1\n\n\n@pytest.mark.parametrize(\n    \"n, expected\",\n    [\n        (2, 2),\n        (3, 3),\n        (4, 5),\n        (5, 8),\n        (6, 13),\n        (7, 21),\n    ],\n)\ndef test_fibonacci_recursive_values(n, expected):\n    \"\"\"n >= 2 时按 f(n)=f(n-1)+f(n-2) 递推，且 f(0)=f(1)=1。\n\n    期望值来源：目标代码分支逻辑推导（f(0)=1, f(1)=1）。\n    \"\"\"\n    assert fibonacci(n) == expected\n\n\ndef test_fibonacci_consistency_relation():\n    \"\"\"验证递推关系 f(n) == f(n-1) + f(n-2) 对若干 n 成立。\"\"\"\n    for n in range(2, 10):\n        assert fibonacci(n) == fibonacci(n - 1) + fibonacci(n - 2)\n\n\ndef test_fibonacci_monotonic_non_decreasing():\n    \"\"\"序列在 n >= 0 范围内应非递减（由递推关系与正初值推出）。\"\"\"\n    values = [fibonacci(n) for n in range(0, 10)]\n    assert values == sorted(values)\n\n\ndef test_fibonacci_large_n_returns_int():\n    \"\"\"较大 n 时仍返回 int（探索性：仅断言类型，不臆造具体数值）。\"\"\"\n    result = fibonacci(15)\n    assert isinstance(result, int)\n    assert result > 0",
