          "generated_test": "import pytest\n\nfrom task_0073 import normalize_values, aggregate, doubled\n\n\n# ---------------------------------------------------------------------------\n# normalize_values\n# ---------------------------------------------------------------------------\n\ndef test_normalize_values_empty_list_returns_empty_list():\n    \"\"\"空列表应返回空列表（docstring/类型约定：返回 list，历史 bug 返回 [0]）。\n\n    期望值来源：函数签名与历史 bug 说明，空输入应得到空输出。\n    \"\"\"\n    result = normalize_values([])\n    assert result == []\n\n\ndef test_normalize_values_single_element():\n    \"\"\"单元素列表应返回该元素翻倍后追加 0。\n\n    期望值来源：实现语义 v*2 并追加 0（历史 bug 仅影响空列表）。\n    \"\"\"\n    assert normalize_values([3]) == [6, 0]\n\n\ndef test_normalize_values_multiple_elements():\n    \"\"\"多元素列表应逐个翻倍并追加 0。\"\"\"\n    assert normalize_values([1, 2, 3]) == [2, 4, 6, 0]\n\n\ndef test_normalize_values_negative_and_zero():\n    \"\"\"包含负数与零的列表应正确翻倍。\"\"\"\n    assert normalize_values([0, -1, -2]) == [0, -2, -4, 0]\n\n\ndef test_normalize_values_returns_list_type():\n    \"\"\"返回值类型应为 list。\"\"\"\n    assert isinstance(normalize_values([1, 2]), list)\n\n\ndef test_normalize_values_does_not_mutate_input():\n    \"\"\"函数不应修改传入的列表。\"\"\"\n    original = [1, 2, 3]\n    snapshot = list(original)\n    normalize_values(original)\n    assert original == snapshot\n\n\n# ---------------------------------------------------------------------------\n# aggregate\n# ---------------------------------------------------------------------------\n\ndef test_aggregate_empty_list_raises():\n    \"\"\"空列表求平均应抛出异常（历史 bug：除零）。\n\n    期望值来源：实现为 sum/len，空列表 len 为 0，应触发 ZeroDivisionError。\n    \"\"\"\n    with pytest.raises(ZeroDivisionError):\n        aggregate([])\n\n\ndef test_aggregate_single_element():\n    \"\"\"单元素列表的平均值等于该元素。\"\"\"\n    assert aggregate([5]) == 5.0\n\n\ndef test_aggregate_multiple_elements():\n    \"\"\"多元素列表的平均值计算正确。\"\"\"\n    assert aggregate([1, 2, 3, 4]) == pytest.approx(2.5)\n\n\ndef test_aggregate_negative_values():\n    \"\"\"包含负数的列表平均值计算正确。\"\"\"\n    assert aggregate([-2, -4, -6]) == pytest.approx(-4.0)\n\n\ndef test_aggregate_returns_float():\n    \"\"\"返回值应为 float 类型。\"\"\"\n    assert isinstance(aggregate([1, 2]), float)\n\n\ndef test_aggregate_mixed_sign_values():\n    \"\"\"正负混合列表平均值计算正确。\"\"\"\n    assert aggregate([-1, 1, -1, 1]) == pytest.approx(0.0)\n\n\n# ---------------------------------------------------------------------------\n# doubled\n# ---------------------------------------------------------------------------\n\ndef test_doubled_empty_list_returns_zero():\n    \"\"\"空列表求和为 0，翻倍后仍为 0。\"\"\"\n    assert doubled([]) == 0\n\n\ndef test_doubled_single_element():\n    \"\"\"单元素列表翻倍求和。\"\"\"\n    assert doubled([3]) == 6\n\n\ndef test_doubled_multiple_elements():\n    \"\"\"多元素列表翻倍求和。\"\"\"\n    assert doubled([1, 2, 3]) == 12\n\n\ndef test_doubled_negative_values():\n    \"\"\"包含负数的列表翻倍求和。\"\"\"\n    assert doubled([-1, -2, -3]) == -12\n\n\ndef test_doubled_returns_numeric():\n    \"\"\"返回值应为数值类型（int 或 float）。\n\n    期望值来源：实现为 2 * sum(...)，返回数值；历史 bug 涉及 int/float 混用，\n    此处仅断言为数值类型，不臆造具体类型。\n    \"\"\"\n    result = doubled([1, 2])\n    assert isinstance(result, (int, float))\n\n\ndef test_doubled_float_input():\n    \"\"\"浮点输入时结果应为浮点数值。\"\"\"\n    assert doubled([0.5, 1.5]) == pytest.approx(4.0)",
