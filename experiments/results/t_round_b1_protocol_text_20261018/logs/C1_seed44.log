          "generated_test": "import pytest\n\nfrom task_0054 import compute_scores, average, rank_top\n\n\n# ---------------------------------------------------------------------------\n# compute_scores\n# ---------------------------------------------------------------------------\n\ndef test_compute_scores_basic():\n    \"\"\"compute_scores 应将每条记录的 name 映射到 value。\"\"\"\n    records = [\n        {\"name\": \"a\", \"value\": 10},\n        {\"name\": \"b\", \"value\": 20},\n    ]\n    assert compute_scores(records) == {\"a\": 10, \"b\": 20}\n\n\ndef test_compute_scores_empty_list():\n    \"\"\"空记录列表应返回空字典。\"\"\"\n    assert compute_scores([]) == {}\n\n\ndef test_compute_scores_missing_name_uses_unknown():\n    \"\"\"缺少 name 字段时，key 应为 'unknown'（来自 record.get 默认值）。\"\"\"\n    records = [{\"value\": 5}]\n    assert compute_scores(records) == {\"unknown\": 5}\n\n\ndef test_compute_scores_missing_value_defaults_zero():\n    \"\"\"缺少 value 字段时，值应为 0（来自 record.get 默认值）。\"\"\"\n    records = [{\"name\": \"x\"}]\n    assert compute_scores(records) == {\"x\": 0}\n\n\ndef test_compute_scores_duplicate_names_last_wins():\n    \"\"\"同名记录后出现的值覆盖先前的值。\"\"\"\n    records = [\n        {\"name\": \"a\", \"value\": 1},\n        {\"name\": \"a\", \"value\": 2},\n    ]\n    assert compute_scores(records) == {\"a\": 2}\n\n\ndef test_compute_scores_returns_dict_type():\n    \"\"\"返回值类型应为 dict。\"\"\"\n    result = compute_scores([{\"name\": \"a\", \"value\": 1}])\n    assert isinstance(result, dict)\n\n\n# ---------------------------------------------------------------------------\n# average\n# ---------------------------------------------------------------------------\n\ndef test_average_empty_dict_returns_zero():\n    \"\"\"空字典的平均值应为 0.0（docstring/实现约定）。\"\"\"\n    assert average({}) == 0.0\n\n\ndef test_average_single_value():\n    \"\"\"单个值的平均值等于该值。\"\"\"\n    assert average({\"a\": 10}) == 10.0\n\n\ndef test_average_multiple_values():\n    \"\"\"多个值的平均值应为总和除以数量。\"\"\"\n    assert average({\"a\": 10, \"b\": 20, \"c\": 30}) == 20.0\n\n\ndef test_average_returns_float():\n    \"\"\"返回值类型应为 float。\"\"\"\n    result = average({\"a\": 1, \"b\": 2})\n    assert isinstance(result, float)\n\n\ndef test_average_negative_values():\n    \"\"\"包含负值时平均值计算正确。\"\"\"\n    assert average({\"a\": -10, \"b\": 10}) == 0.0\n\n\n# ---------------------------------------------------------------------------\n# rank_top\n# ---------------------------------------------------------------------------\n\ndef test_rank_top_basic_ordering():\n    \"\"\"rank_top 应按值降序返回前 k 个 (key, value) 元组。\"\"\"\n    scores = {\"a\": 1, \"b\": 3, \"c\": 2}\n    assert rank_top(scores, 2) == [(\"b\", 3), (\"c\", 2)]\n\n\ndef test_rank_top_k_larger_than_size():\n    \"\"\"k 大于字典大小时返回全部条目。\"\"\"\n    scores = {\"a\": 1, \"b\": 2}\n    result = rank_top(scores, 10)\n    assert result == [(\"b\", 2), (\"a\", 1)]\n\n\ndef test_rank_top_k_zero():\n    \"\"\"k 为 0 时返回空列表。\"\"\"\n    assert rank_top({\"a\": 1, \"b\": 2}, 0) == []\n\n\ndef test_rank_top_empty_scores():\n    \"\"\"空字典应返回空列表。\"\"\"\n    assert rank_top({}, 3) == []\n\n\ndef test_rank_top_returns_list():\n    \"\"\"返回值类型应为 list。\"\"\"\n    result = rank_top({\"a\": 1}, 1)\n    assert isinstance(result, list)\n\n\ndef test_rank_top_negative_k():\n    \"\"\"k 为负数时按切片语义返回除末尾外的元素（实现行为，期望值来源不明，需人工确认）。\"\"\"\n    scores = {\"a\": 1, \"b\": 2, \"c\": 3}\n    # 排序后为 [(\"c\",3),(\"b\",2),(\"a\",1)]，切片 [: -1] 去掉最后一个\n    assert rank_top(scores, -1) == [(\"c\", 3), (\"b\", 2)]",
