          "generated_test": "import datetime\nimport pytest\n\nfrom task_0059 import parse_date, days_until, is_expired\n\n\n# ---------------------------------------------------------------------------\n# parse_date\n# ---------------------------------------------------------------------------\n\ndef test_parse_date_valid_date_returns_datetime():\n    \"\"\"parse_date 对合法日期字符串应返回对应的 datetime（时间部分为 00:00:00）。\"\"\"\n    result = parse_date(\"2024-01-15\")\n    assert isinstance(result, datetime.datetime)\n    assert result == datetime.datetime(2024, 1, 15, 0, 0, 0)\n\n\ndef test_parse_date_leap_day():\n    \"\"\"parse_date 应能正确解析闰年 2 月 29 日。\"\"\"\n    result = parse_date(\"2020-02-29\")\n    assert result == datetime.datetime(2020, 2, 29)\n\n\n@pytest.mark.parametrize(\n    \"bad_input\",\n    [\n        \"2024-13-01\",   # 月份越界\n        \"2024-00-10\",   # 月份为 0\n        \"2024-02-30\",   # 非闰年 2 月 30 日\n        \"not-a-date\",   # 完全非法\n        \"\",             # 空字符串\n        \"2024/01/15\",   # 分隔符不符\n        \"2024-1-5\",     # 非零填充（strptime %m/%d 要求两位）\n    ],\n)\ndef test_parse_date_invalid_returns_datetime_min(bad_input):\n    \"\"\"parse_date 对非法日期字符串应返回 datetime.min（依据 docstring/实现约定）。\"\"\"\n    assert parse_date(bad_input) == datetime.datetime.min\n\n\n# ---------------------------------------------------------------------------\n# days_until\n# ---------------------------------------------------------------------------\n\ndef test_days_until_future_date_positive():\n    \"\"\"days_until 对较远的未来日期应返回正数天数。\"\"\"\n    future = (datetime.datetime.now() + datetime.timedelta(days=10)).strftime(\"%Y-%m-%d\")\n    result = days_until(future)\n    # 由于 now() 的时分秒，结果可能为 9 或 10，允许一定容差\n    assert result in (9, 10)\n\n\ndef test_days_until_past_date_negative():\n    \"\"\"days_until 对过去的日期应返回负数天数。\"\"\"\n    past = (datetime.datetime.now() - datetime.timedelta(days=10)).strftime(\"%Y-%m-%d\")\n    result = days_until(past)\n    assert result in (-10, -11)\n\n\ndef test_days_until_invalid_date_returns_large_negative():\n    \"\"\"days_until 对非法日期（parse_date 返回 datetime.min）应返回一个很大的负数。\n\n    期望值来源：实现中 parse_date 失败返回 datetime.min，与 now() 相减得到负天数。\n    具体数值依赖当前时间，故只断言为负且量级很大。\n    \"\"\"\n    result = days_until(\"invalid-date\")\n    assert result < 0\n    assert result < -100000  # datetime.min 距今约 73 万年\n\n\n# ---------------------------------------------------------------------------\n# is_expired\n# ---------------------------------------------------------------------------\n\ndef test_is_expired_past_date_true():\n    \"\"\"is_expired 对过去日期应返回 True。\"\"\"\n    past = (datetime.datetime.now() - datetime.timedelta(days=5)).strftime(\"%Y-%m-%d\")\n    assert is_expired(past) is True\n\n\ndef test_is_expired_future_date_false():\n    \"\"\"is_expired 对未来日期应返回 False。\"\"\"\n    future = (datetime.datetime.now() + datetime.timedelta(days=5)).strftime(\"%Y-%m-%d\")\n    assert is_expired(future) is False\n\n\ndef test_is_expired_invalid_date_true():\n    \"\"\"is_expired 对非法日期（解析为 datetime.min）应返回 True。\"\"\"\n    assert is_expired(\"not-a-date\") is True",
