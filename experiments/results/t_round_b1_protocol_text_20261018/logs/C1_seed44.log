          "generated_test": "import pytest\n\nfrom task_0047 import clamp\n\n\ndef test_clamp_returns_value_when_within_range():\n    \"\"\"值在 [min_val, max_val] 区间内时，应原样返回该值。\"\"\"\n    assert clamp(5.0, 0.0, 10.0) == 5.0\n\n\ndef test_clamp_returns_min_val_when_value_below_min():\n    \"\"\"值小于 min_val 时，应返回 min_val。\"\"\"\n    assert clamp(-3.0, 0.0, 10.0) == 0.0\n\n\ndef test_clamp_returns_max_val_when_value_above_max():\n    \"\"\"值大于 max_val 时，应返回 max_val。\"\"\"\n    assert clamp(42.0, 0.0, 10.0) == 10.0\n\n\ndef test_clamp_returns_min_val_when_value_equals_min():\n    \"\"\"值等于 min_val 时，应返回该值（即 min_val）。\"\"\"\n    assert clamp(0.0, 0.0, 10.0) == 0.0\n\n\ndef test_clamp_returns_max_val_when_value_equals_max():\n    \"\"\"值等于 max_val 时，应返回该值（即 max_val）。\"\"\"\n    assert clamp(10.0, 0.0, 10.0) == 10.0\n\n\ndef test_clamp_handles_negative_range():\n    \"\"\"区间为负数范围时，边界裁剪应正确。\"\"\"\n    assert clamp(-15.0, -10.0, -5.0) == -10.0\n    assert clamp(-1.0, -10.0, -5.0) == -5.0\n    assert clamp(-7.0, -10.0, -5.0) == -7.0\n\n\ndef test_clamp_handles_min_equals_max():\n    \"\"\"min_val 与 max_val 相等时，任何值都应被裁剪到该值。\"\"\"\n    assert clamp(3.0, 5.0, 5.0) == 5.0\n    assert clamp(7.0, 5.0, 5.0) == 5.0\n    assert clamp(5.0, 5.0, 5.0) == 5.0\n\n\ndef test_clamp_handles_integer_inputs():\n    \"\"\"传入整数时，应返回正确的裁剪结果。\"\"\"\n    assert clamp(3, 0, 10) == 3\n    assert clamp(-1, 0, 10) == 0\n    assert clamp(11, 0, 10) == 10\n\n\n@pytest.mark.parametrize(\n    \"value, min_val, max_val, expected\",\n    [\n        (5.0, 0.0, 10.0, 5.0),\n        (-1.0, 0.0, 10.0, 0.0),\n        (11.0, 0.0, 10.0, 10.0),\n        (0.0, 0.0, 10.0, 0.0),\n        (10.0, 0.0, 10.0, 10.0),\n        (-100.0, -50.0, 50.0, -50.0),\n        (100.0, -50.0, 50.0, 50.0),\n        (0.0, -50.0, 50.0, 0.0),\n    ],\n)\ndef test_clamp_parametrized_cases(value, min_val, max_val, expected):\n    \"\"\"参数化验证 clamp 在各类边界与区间内的裁剪行为。\"\"\"\n    assert clamp(value, min_val, max_val) == expected\n\n\ndef test_clamp_returns_float_type_for_float_inputs():\n    \"\"\"浮点输入时，返回值应为 float 类型。\"\"\"\n    result = clamp(5.0, 0.0, 10.0)\n    assert isinstance(result, float)",
