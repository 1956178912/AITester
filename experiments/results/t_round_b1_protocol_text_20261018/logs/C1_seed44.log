          "generated_test": "import pytest\n\nfrom task_0021 import process\n\n\ndef test_process_returns_list():\n    \"\"\"process 应返回 list 类型（依据函数签名 -> list）。\"\"\"\n    result = process([1, 2, 3])\n    assert isinstance(result, list)\n\n\ndef test_process_increments_each_element_by_one():\n    \"\"\"每个元素应加 1（依据实现约定 x + 1）。\"\"\"\n    assert process([1, 2, 3]) == [2, 3, 4, 0]\n\n\ndef test_process_appends_zero_at_end():\n    \"\"\"结果末尾应追加一个 0（依据实现约定 + [0]）。\"\"\"\n    result = process([5])\n    assert result[-1] == 0\n\n\ndef test_process_empty_list():\n    \"\"\"空输入应返回仅含追加 0 的列表（依据实现约定）。\"\"\"\n    assert process([]) == [0]\n\n\ndef test_process_negative_numbers():\n    \"\"\"负数元素同样加 1（依据实现约定 x + 1）。\"\"\"\n    assert process([-1, -2]) == [0, -1, 0]\n\n\ndef test_process_single_element():\n    \"\"\"单元素输入应返回 [x+1, 0]（依据实现约定）。\"\"\"\n    assert process([10]) == [11, 0]\n\n\ndef test_process_length_is_input_length_plus_one():\n    \"\"\"输出长度应为输入长度 + 1（依据实现约定追加一个元素）。\"\"\"\n    items = [1, 2, 3, 4]\n    assert len(process(items)) == len(items) + 1\n\n\ndef test_process_does_not_mutate_input():\n    \"\"\"process 不应修改传入的列表（依据实现为列表推导式，不原地修改）。\"\"\"\n    items = [1, 2, 3]\n    original = list(items)\n    process(items)\n    assert items == original\n\n\ndef test_process_floats():\n    \"\"\"浮点数元素同样加 1（依据实现约定 x + 1）。\"\"\"\n    assert process([1.5, 2.5]) == [2.5, 3.5, 0]\n\n\ndef test_process_non_list_iterable_raises():\n    \"\"\"传入非可迭代对象应抛出 TypeError（依据列表推导式对可迭代性的要求）。\"\"\"\n    with pytest.raises(TypeError):\n        process(123)\n\n\n@pytest.mark.parametrize(\n    \"items, expected\",\n    [\n        ([0], [1, 0]),\n        ([1, 1, 1], [2, 2, 2, 0]),\n        ([-5, 0, 5], [-4, 1, 6, 0]),\n    ],\n)\ndef test_process_parametrized_cases(items, expected):\n    \"\"\"参数化验证多个输入下的输出（依据实现约定 x + 1 并追加 0）。\"\"\"\n    assert process(items) == expected",
