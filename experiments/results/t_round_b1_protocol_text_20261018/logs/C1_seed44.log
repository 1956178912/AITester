          "generated_test": "import pytest\n\nfrom task_0076 import _better, best_score, worst_score\n\n\n# ---------------------------------------------------------------------------\n# _better\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\n    \"current, candidate, expected\",\n    [\n        (5, 3, True),\n        (3, 5, False),\n        (4, 4, False),\n        (-1, -5, True),\n        (-5, -1, False),\n        (0, -1, True),\n        (0, 1, False),\n    ],\n)\ndef test__better_returns_true_iff_candidate_smaller(current, candidate, expected):\n    \"\"\"_better 应在 candidate < current 时返回 True，否则返回 False。\"\"\"\n    assert _better(current, candidate) is expected\n\n\ndef test__better_strict_inequality_on_equal_values():\n    \"\"\"_better 使用严格小于，相等时应返回 False。\"\"\"\n    assert _better(7, 7) is False\n\n\n# ---------------------------------------------------------------------------\n# best_score\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\n    \"scores, expected\",\n    [\n        ([3], 3),\n        ([1, 2, 3], 1),\n        ([3, 2, 1], 1),\n        ([5, 1, 9, 1, 5], 1),\n        ([-1, -2, -3], -3),\n        ([0, -1, 1], -1),\n        ([2, 2, 2], 2),\n        ([10, 3, 10, 3], 3),\n    ],\n)\ndef test_best_score_returns_minimum(scores, expected):\n    \"\"\"best_score 返回列表中的最小值（依据 _better 语义：candidate < current 时更新）。\"\"\"\n    assert best_score(scores) == expected\n\n\ndef test_best_score_single_element_list():\n    \"\"\"单元素列表应直接返回该元素。\"\"\"\n    assert best_score([42]) == 42\n\n\ndef test_best_score_does_not_mutate_input():\n    \"\"\"best_score 不应修改传入的列表。\"\"\"\n    scores = [4, 2, 8, 1]\n    original = list(scores)\n    best_score(scores)\n    assert scores == original\n\n\ndef test_best_score_empty_list_raises_index_error():\n    \"\"\"空列表会因 scores[0] 访问越界而抛出 IndexError。\"\"\"\n    with pytest.raises(IndexError):\n        best_score([])\n\n\n# ---------------------------------------------------------------------------\n# worst_score\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\n    \"scores, expected\",\n    [\n        ([3], 3),\n        ([1, 2, 3], 3),\n        ([3, 2, 1], 3),\n        ([5, 1, 9, 1, 5], 9),\n        ([-1, -2, -3], -1),\n        ([0, -1, 1], 1),\n        ([2, 2, 2], 2),\n        ([10, 3, 10, 3], 10),\n    ],\n)\ndef test_worst_score_returns_maximum(scores, expected):\n    \"\"\"worst_score 返回列表中的最大值（依据 not _better 语义：candidate >= current 时更新）。\"\"\"\n    assert worst_score(scores) == expected\n\n\ndef test_worst_score_single_element_list():\n    \"\"\"单元素列表应直接返回该元素。\"\"\"\n    assert worst_score([-7]) == -7\n\n\ndef test_worst_score_does_not_mutate_input():\n    \"\"\"worst_score 不应修改传入的列表。\"\"\"\n    scores = [4, 2, 8, 1]\n    original = list(scores)\n    worst_score(scores)\n    assert scores == original\n\n\ndef test_worst_score_empty_list_raises_index_error():\n    \"\"\"空列表会因 scores[0] 访问越界而抛出 IndexError。\"\"\"\n    with pytest.raises(IndexError):\n        worst_score([])\n\n\n# ---------------------------------------------------------------------------\n# 组合一致性\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\n    \"scores\",\n    [\n        [1, 2, 3, 4, 5],\n        [5, 4, 3, 2, 1],\n        [-3, 0, 7, -1, 7],\n        [0],\n    ],\n)\ndef test_best_and_worst_score_consistent_with_builtins(scores):\n    \"\"\"best_score / worst_score 应与内置 min / max 结果一致。\"\"\"\n    assert best_score(scores) == min(scores)\n    assert worst_score(scores) == max(scores)",
