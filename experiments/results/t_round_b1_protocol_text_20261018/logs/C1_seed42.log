          "generated_test": "import pytest\n\nfrom task_0033 import compare, sort_desc, top_k\n\n\n# ---------------------------------------------------------------------------\n# compare\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\n    \"a, b, expected\",\n    [\n        (5, 3, 1),\n        (3, 5, -1),\n        (4, 4, 0),\n        (0, 0, 0),\n        (-1, -2, 1),\n        (-2, -1, -1),\n        (0, -1, 1),\n        (-1, 0, -1),\n        (10**9, 10**9, 0),\n    ],\n)\ndef test_compare_returns_expected_ordering(a, b, expected):\n    \"\"\"compare 应返回 1/0/-1 表示 a>b / a==b / a<b（来源：docstring 与实现）。\"\"\"\n    assert compare(a, b) == expected\n\n\ndef test_compare_is_antisymmetric():\n    \"\"\"compare(a, b) 与 compare(b, a) 应互为相反数（来源：实现语义）。\"\"\"\n    pairs = [(1, 2), (2, 1), (7, 7), (-3, 4), (0, 0)]\n    for a, b in pairs:\n        assert compare(a, b) == -compare(b, a)\n\n\n# ---------------------------------------------------------------------------\n# sort_desc\n# ---------------------------------------------------------------------------\n\ndef test_sort_desc_sorts_ascending_in_place_and_returns_same_list():\n    \"\"\"sort_desc 实际按升序排序并原地修改，返回同一列表对象（来源：实现行为）。\"\"\"\n    arr = [3, 1, 2]\n    result = sort_desc(arr)\n    assert result == [1, 2, 3]\n    assert result is arr\n\n\n@pytest.mark.parametrize(\n    \"arr, expected\",\n    [\n        ([], []),\n        ([1], [1]),\n        ([2, 1], [1, 2]),\n        ([5, 3, 8, 1, 9, 2], [1, 2, 3, 5, 8, 9]),\n        ([1, 1, 1], [1, 1, 1]),\n        ([-1, -5, 0, 3], [-5, -1, 0, 3]),\n    ],\n)\ndef test_sort_desc_ordering(arr, expected):\n    \"\"\"sort_desc 对各类输入应产生升序结果（来源：实现行为，函数名与实际排序方向不一致，需人工确认）。\"\"\"\n    assert sort_desc(arr) == expected\n\n\ndef test_sort_desc_does_not_change_length():\n    \"\"\"sort_desc 不应改变列表长度（来源：排序语义）。\"\"\"\n    arr = [4, 2, 9, 2, 7]\n    original_len = len(arr)\n    sort_desc(arr)\n    assert len(arr) == original_len\n\n\n# ------