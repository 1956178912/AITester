          "generated_test": "import pytest\n\nfrom task_0032 import _better, best_score, worst_score\n\n\n# ---------------------------------------------------------------------------\n# _better\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\n    \"current, candidate, expected\",\n    [\n        (5, 3, True),\n        (3, 5, False),\n        (4, 4, False),\n        (0, -1, True),\n        (-1, 0, False),\n        (10, 9, True),\n        (9, 10, False),\n    ],\n)\ndef test__better_returns_true_iff_candidate_smaller(current, candidate, expected):\n    \"\"\"_better 当且仅当 candidate < current 时返回 True。\"\"\"\n    assert _better(current, candidate) is expected\n\n\ndef test__better_strict_inequality_on_equal_values():\n    \"\"\"相等时 _better 返回 False（严格小于）。\"\"\"\n    assert _better(7, 7) is False\n\n\n# ---------------------------------------------------------------------------\n# best_score\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\n    \"scores, expected\",\n    [\n        ([1], 1),\n        ([3, 1, 2], 1),\n        ([5, 4, 3, 2, 1], 1),\n        ([1, 2, 3, 4, 5], 1),\n        ([2, 2, 2], 2),\n        ([-1, -5, -3], -5),\n        ([0, -10, 10], -10),\n        ([7, 7, 3, 7], 3),\n    ],\n)\ndef test_best_score_returns_minimum(scores, expected):\n    \"\"\"best_score 返回列表中的最小值（依据 _better 语义：candidate < current 时替换）。\"\"\"\n    assert best_score(scores) == expected\n\n\ndef test_best_score_single_element_returns_that_element():\n    \"\"\"单元素列表返回该元素本身。\"\"\"\n    assert best_score([42]) == 42\n\n\ndef test_best_score_does_not_mutate_input():\n    \"\"\"best_score 不应修改输入列表。\"\"\"\n    scores = [3, 1, 2]\n    original = list(scores)\n    best_score(scores)\n    assert scores == original\n\n\ndef test_best_score_empty_list_raises_index_error():\n    \"\"\"空列表访问 scores[0] 会抛出 IndexError。\"\"\"\n    with pytest.raises(IndexError):\n        best_score([])\n\n\n# ---------------------------------------------------------------------------\n# worst_score\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\n    \"scores, expected\",\n    [\n        ([1], 1),\n        ([3, 1, 2], 3),\n        ([5, 4, 3, 2, 1], 5),\n        ([1, 2, 3, 4, 5], 5),\n        ([2, 2, 2], 2),\n        ([-1, -5, -3], -1),\n        ([0, -10, 10], 10),\n        ([7, 7, 3, 7], 7),\n    ],\n)\ndef test_worst_score_returns_maximum(scores, expected):\n    \"\"\"worst_score 返回列表中的最大值（依据 not _better 语义：candidate >= current 时替换）。\"\"\"\n    assert worst_score(scores) == expected\n\n\ndef test_worst_score_single_element_returns_that_element():\n    \"\"\"单元素列表返回该元素本身。\"\"\"\n    assert worst_score([42]) == 42\n\n\ndef test_worst_score_does_not_mutate_input():\n    \"\"\"worst_score 不应修改输入列表。\"\"\"\n    scores = [3, 1, 2]\n    original = list(scores)\n    worst_score(scores)\n    assert scores == original\n\n\ndef test_worst_score_empty_list_raises_index_error():\n    \"\"\"空列表访问 scores[0] 会抛出 IndexError。\"\"\"\n    with pytest.raises(IndexError):\n        worst_score([])\n\n\n# ---------------------------------------------------------------------------\n# 一致性\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\n    \"scores\",\n    [\n        [1],\n        [3, 1, 2],\n        [5, 4, 3, 2, 1],\n        [1, 2, 3, 4, 5],\n        [2, 2, 2],\n        [-1, -5, -3],\n        [0, -10, 10],\n        [7, 7, 3, 7],\n    ],\n)\ndef test_best_and_worst_score_consistent_with_builtins(scores):\n    \"\"\"best_score / worst_score 与内置 min / max 结果一致。\"\"\"\n    assert best_score(scores) == min(scores)\n    assert worst_score(scores) == max(scores)",
