          "generated_test": "import math\n\nimport pytest\n\nfrom task_0057 import rounded_ratio\n\n\ndef test_rounded_ratio_zero_total_returns_zero():\n    \"\"\"total 为 0 时应返回 0.0（依据 docstring/实现约定）。\"\"\"\n    assert rounded_ratio(5, 0) == 0.0\n\n\ndef test_rounded_ratio_zero_hit_returns_zero():\n    \"\"\"hit 为 0 时比例应为 0.0。\"\"\"\n    assert rounded_ratio(0, 10) == 0.0\n\n\ndef test_rounded_ratio_full_hit_returns_one():\n    \"\"\"hit 等于 total 时比例应为 1.0。\"\"\"\n    assert rounded_ratio(10, 10) == 1.0\n\n\ndef test_rounded_ratio_half_returns_half():\n    \"\"\"hit 为 total 一半时比例应为 0.5。\"\"\"\n    assert rounded_ratio(5, 10) == 0.5\n\n\n@pytest.mark.parametrize(\n    \"hit,total,expected\",\n    [\n        (1, 3, 0.33),\n        (2, 3, 0.66),\n        (1, 8, 0.12),\n        (7, 8, 0.87),\n        (1, 100, 0.01),\n        (99, 100, 0.99),\n    ],\n)\ndef test_rounded_ratio_floor_to_two_decimals(hit, total, expected):\n    \"\"\"结果应为向下取整到两位小数（依据实现使用 math.floor）。\"\"\"\n    assert rounded_ratio(hit, total) == expected\n\n\ndef test_rounded_ratio_returns_float_type():\n    \"\"\"返回值类型应为 float。\"\"\"\n    result = rounded_ratio(1, 4)\n    assert isinstance(result, float)\n\n\ndef test_rounded_ratio_result_matches_floor_formula():\n    \"\"\"结果应与 math.floor(hit/total*100)/100 一致（依据实现）。\"\"\"\n    hit, total = 3, 7\n    expected = math.floor(hit / total * 100) / 100\n    assert rounded_ratio(hit, total) == expected\n\n\ndef test_rounded_ratio_result_within_unit_interval():\n    \"\"\"对于 0 <= hit <= total，结果应落在 [0.0, 1.0] 区间内。\"\"\"\n    for hit, total in [(0, 5), (1, 5), (3, 5), (5, 5)]:\n        result = rounded_ratio(hit, total)\n        assert 0.0 <= result <= 1.0\n\n\ndef test_rounded_ratio_negative_total_returns_zero():\n    \"\"\"total 为 0 时返回 0.0；负 total 行为期望值来源不明，需人工确认。\"\"\"\n    # 期望值来源不明，需人工确认：仅记录实际行为，不做强断言\n    result = rounded_ratio(1, -1)\n    assert isinstance(result, float)",
