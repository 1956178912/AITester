          "generated_test": "import pytest\n\nfrom task_0011 import is_freezing, normalize\n\n\n# ---------------------------------------------------------------------------\n# is_freezing\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\"celsius\", [0, 1, 10, 100, 1000])\ndef test_is_freezing_returns_true_for_non_negative(celsius):\n    \"\"\"is_freezing 对 >= 0 的输入应返回 True（依据函数实现 celsius >= 0）。\"\"\"\n    assert is_freezing(celsius) is True\n\n\n@pytest.mark.parametrize(\"celsius\", [-1, -10, -100, -273])\ndef test_is_freezing_returns_false_for_negative(celsius):\n    \"\"\"is_freezing 对 < 0 的输入应返回 False（依据函数实现 celsius >= 0）。\"\"\"\n    assert is_freezing(celsius) is False\n\n\ndef test_is_freezing_boundary_zero():\n    \"\"\"边界值 0：is_freezing(0) 应为 True（依据实现 celsius >= 0）。\"\"\"\n    assert is_freezing(0) is True\n\n\ndef test_is_freezing_boundary_minus_one():\n    \"\"\"边界值 -1：is_freezing(-1) 应为 False（依据实现 celsius >= 0）。\"\"\"\n    assert is_freezing(-1) is False\n\n\ndef test_is_freezing_returns_bool_type():\n    \"\"\"is_freezing 的返回值类型应为 bool。\"\"\"\n    result = is_freezing(5)\n    assert isinstance(result, bool)\n\n\n# ---------------------------------------------------------------------------\n# normalize\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\"temp\", [0, 1, 10, 100, 1000])\ndef test_normalize_returns_zero_when_is_freezing_true(temp):\n    \"\"\"当 is_freezing(temp) 为 True（temp >= 0）时，normalize 应返回 0。\"\"\"\n    assert normalize(temp) == 0\n\n\n@pytest.mark.parametrize(\"temp\", [-1, -10, -100, -273])\ndef test_normalize_returns_temp_when_is_freezing_false(temp):\n    \"\"\"当 is_freezing(temp) 为 False（temp < 0）时，normalize 应原样返回 temp。\"\"\"\n    assert normalize(temp) == temp\n\n\ndef test_normalize_boundary_zero():\n    \"\"\"边界值 0：normalize(0) 应为 0（依据 is_freezing(0) 为 True）。\"\"\"\n    assert normalize(0) == 0\n\n\ndef test_normalize_boundary_minus_one():\n    \"\"\"边界值 -1：normalize(-1) 应为 -1（依据 is_freezing(-1) 为 False）。\"\"\"\n    assert normalize(-1) == -1\n\n\ndef test_normalize_returns_int_type():\n    \"\"\"normalize 的返回值类型应为 int。\"\"\"\n    result = normalize(-5)\n    assert isinstance(result, int)",
