ises(AttributeError):\n            display(\"alpha\")\n\n    def test_display_unknown_key_raises_attribute_error(self):\n        \"\"\"Even unknown keys yield int 0 from lookup, so .strip() fails.\"\"\"\n        with pytest.raises(AttributeError):\n            display(\"nonexistent\")\n\n    def test_display_empty_name_raises_attribute_error(self):\n        \"\"\"Empty name still triggers lookup -> int -> .strip() AttributeError.\"\"\"\n        with pytest.raises(AttributeError):\n            display(\"\")",
