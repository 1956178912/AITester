          "generated_test": "import pytest\n\nfrom task_0046 import split_words\n\n\ndef test_split_words_basic():\n    \"\"\"基本用例：以单个空格分隔的字符串应被拆分为单词列表。\"\"\"\n    assert split_words(\"hello world\") == [\"hello\", \"world\"]\n\n\ndef test_split_words_single_word():\n    \"\"\"单个单词（无空格）应返回仅含该单词的列表。\"\"\"\n    assert split_words(\"hello\") == [\"hello\"]\n\n\ndef test_split_words_empty_string():\n    \"\"\"空字符串按 str.split(\" \") 语义应返回 ['']。\"\"\"\n    assert split_words(\"\") == [\"\"]\n\n\ndef test_split_words_multiple_spaces():\n    \"\"\"连续空格会产生空字符串元素（str.split(\" \") 的语义）。\"\"\"\n    assert split_words(\"a  b\") == [\"a\", \"\", \"b\"]\n\n\ndef test_split_words_leading_space():\n    \"\"\"前导空格会产生一个空字符串作为首元素。\"\"\"\n    assert split_words(\" hello\") == [\"\", \"hello\"]\n\n\ndef test_split_words_trailing_space():\n    \"\"\"尾随空格会产生一个空字符串作为末元素。\"\"\"\n    assert split_words(\"hello \") == [\"hello\", \"\"]\n\n\ndef test_split_words_only_spaces():\n    \"\"\"仅含空格的字符串应返回对应数量的空字符串元素。\"\"\"\n    assert split_words(\"   \") == [\"\", \"\", \"\", \"\"]\n\n\ndef test_split_words_tabs_not_split():\n    \"\"\"制表符不是空格分隔符，应保留在单词内部。\"\"\"\n    assert split_words(\"a\\tb c\") == [\"a\\tb\", \"c\"]\n\n\ndef test_split_words_newline_not_split():\n    \"\"\"换行符不是空格分隔符，应保留在单词内部。\"\"\"\n    assert split_words(\"a\\nb c\") == [\"a\\nb\", \"c\"]\n\n\n@pytest.mark.parametrize(\n    \"text, expected\",\n    [\n        (\"one two three\", [\"one\", \"two\", \"three\"]),\n        (\"a b c d\", [\"a\", \"b\", \"c\", \"d\"]),\n        (\"x\", [\"x\"]),\n        (\"\", [\"\"]),\n    ],\n)\ndef test_split_words_parametrized(text, expected):\n    \"\"\"参数化用例：验证多种输入下的拆分结果。\"\"\"\n    assert split_words(text) == expected\n\n\ndef test_split_words_returns_list():\n    \"\"\"返回值类型应为 list。\"\"\"\n    result = split_words(\"a b\")\n    assert isinstance(result, list)\n\n\ndef test_split_words_non_string_raises():\n    \"\"\"传入非字符串（如 None）时，str.split 调用应抛出 AttributeError。\"\"\"\n    with pytest.raises(AttributeError):\n        split_words(None)",
