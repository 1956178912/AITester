          "generated_test": "import datetime\nimport pytest\n\nfrom task_0037 import parse_date, days_until, is_expired\n\n\n# ---------------------------------------------------------------------------\n# parse_date\n# ---------------------------------------------------------------------------\n\ndef test_parse_date_valid_format_returns_datetime():\n    \"\"\"parse_date 对合法 'YYYY-MM-DD' 字符串应返回对应 datetime。\"\"\"\n    result = parse_date(\"2024-01-15\")\n    assert isinstance(result, datetime.datetime)\n    assert result == datetime.datetime(2024, 1, 15)\n\n\ndef test_parse_date_invalid_format_returns_datetime_min():\n    \"\"\"parse_date 对非法格式应返回 datetime.min（依据实现约定）。\"\"\"\n    result = parse_date(\"not-a-date\")\n    assert result == datetime.datetime.min\n\n\ndef test_parse_date_empty_string_returns_datetime_min():\n    \"\"\"parse_date 对空字符串应返回 datetime.min。\"\"\"\n    assert parse_date(\"\") == datetime.datetime.min\n\n\ndef test_parse_date_wrong_separator_returns_datetime_min():\n    \"\"\"parse_date 对错误分隔符应返回 datetime.min。\"\"\"\n    assert parse_date(\"2024/01/15\") == datetime.datetime.min\n\n\ndef test_parse_date_impossible_date_returns_datetime_min():\n    \"\"\"parse_date 对不存在的日期（如 2 月 30 日）应返回 datetime.min。\"\"\"\n    assert parse_date(\"2024-02-30\") == datetime.datetime.min\n\n\n@pytest.mark.parametrize(\n    \"value,expected\",\n    [\n        (\"2024-01-15\", datetime.datetime(2024, 1, 15)),\n        (\"1999-12-31\", datetime.datetime(1999, 12, 31)),\n        (\"2000-02-29\", datetime.datetime(2000, 2, 29)),\n    ],\n)\ndef test_parse_date_parametrized_valid(value, expected):\n    \"\"\"parse_date 对多个合法日期应返回正确 datetime。\"\"\"\n    assert parse_date(value) == expected\n\n\n# ---------------------------------------------------------------------------\n# days_until\n# ---------------------------------------------------------------------------\n\ndef test_days_until_far_future_is_positive():\n    \"\"\"days_until 对远期未来日期应返回正数。\"\"\"\n    future = (datetime.datetime.now() + datetime.timedelta(days=100)).strftime(\"%Y-%m-%d\")\n    result = days_until(future)\n    # 允许因跨天边界产生 ±1 的误差\n    assert 98 <= result <= 100\n\n\ndef test_days_until_far_past_is_negative():\n    \"\"\"days_until 对远期过去日期应返回负数。\"\"\"\n    past = (datetime.datetime.now() - datetime.timedelta(days=100)).strftime(\"%Y-%m-%d\")\n    result = days_until(past)\n    assert -101 <= result <= -99\n\n\ndef test_days_until_invalid_date_returns_large_negative():\n    \"\"\"days_until 对非法日期（parse_date 返回 datetime.min）应返回很大的负数。\n\n    期望值来源：实现中 parse_date 失败返回 datetime.min，\n    与 now 相减必然为负，具体数值依赖当前时间，故只断言符号与量级。\n    \"\"\"\n    result = days_until(\"invalid\")\n    assert result < 0\n    assert result < -100000\n\n\ndef test_days_until_returns_int():\n    \"\"\"days_until 返回值应为 int 类型。\"\"\"\n    future = (datetime.datetime.now() + datetime.timedelta(days=10)).strftime(\"%Y-%m-%d\")\n    assert isinstance(days_until(future), int)\n\n\n# ---------------------------------------------------------------------------\n# is_expired\n# ---------------------------------------------------------------------------\n\ndef test_is_expired_past_date_returns_true():\n    \"\"\"is_expired 对过去日期应返回 True。\"\"\"\n    past = (datetime.datetime.now() - datetime.timedelta(days=10)).strftime(\"%Y-%m-%d\")\n    assert is_expired(past) is True\n\n\ndef test_is_expired_future_date_returns_false():\n    \"\"\"is_expired 对未来日期应返回 False。\"\"\"\n    future = (datetime.datetime.now() + datetime.timedelta(days=10)).strftime(\"%Y-%m-%d\")\n    assert is_expired(future) is False\n\n\ndef test_is_expired_invalid_date_returns_true():\n    \"\"\"is_expired 对非法日期应返回 True（days_until 为负）。\"\"\"\n    assert is_expired(\"invalid\") is True\n\n\ndef test_is_expired_returns_bool():\n    \"\"\"is_expired 返回值应为 bool 类型。\"\"\"\n    future = (datetime.datetime.now() + datetime.timedelta(days=5)).strftime(\"%Y-%m-%d\")\n    assert isinstance(is_expired(future), bool)",
