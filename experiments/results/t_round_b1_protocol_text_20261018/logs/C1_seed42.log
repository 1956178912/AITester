          "generated_test": "import pytest\n\nfrom task_0069 import mark_positions\n\n\ndef test_mark_positions_basic_marks_matching_positions():\n    \"\"\"基本用例：标记出所有匹配字符的位置，其余为 -1。\"\"\"\n    text = \"abcabc\"\n    ch = \"a\"\n    result = mark_positions(text, ch)\n    # 遍历范围是 range(len(text) - 1)，即索引 0..4\n    assert result == [0, -1, -1, 3, -1]\n\n\ndef test_mark_positions_returns_list():\n    \"\"\"返回值类型应为 list。\"\"\"\n    result = mark_positions(\"hello\", \"l\")\n    assert isinstance(result, list)\n\n\ndef test_mark_positions_length_is_len_minus_one():\n    \"\"\"结果长度应为 len(text) - 1（依据实现中的 range(len(text) - 1)）。\"\"\"\n    text = \"abcdef\"\n    result = mark_positions(text, \"a\")\n    assert len(result) == len(text) - 1\n\n\ndef test_mark_positions_no_match_all_minus_one():\n    \"\"\"无匹配字符时，结果应全为 -1。\"\"\"\n    text = \"abcdef\"\n    ch = \"z\"\n    result = mark_positions(text, ch)\n    assert result == [-1] * (len(text) - 1)\n\n\ndef test_mark_positions_all_match():\n    \"\"\"所有被遍历位置都匹配时，结果应为对应索引序列。\"\"\"\n    text = \"aaaa\"\n    ch = \"a\"\n    result = mark_positions(text, ch)\n    assert result == [0, 1, 2]\n\n\ndef test_mark_positions_last_char_never_marked():\n    \"\"\"最后一个字符不会被遍历到，因此即使匹配也不会被标记。\"\"\"\n    text = \"abca\"\n    ch = \"a\"\n    result = mark_positions(text, ch)\n    # 索引 3 是最后一个字符，不在遍历范围内\n    assert result == [0, -1, -1]\n\n\ndef test_mark_positions_empty_string():\n    \"\"\"空字符串时，range(-1) 为空，结果应为空列表。\"\"\"\n    result = mark_positions(\"\", \"a\")\n    assert result == []\n\n\ndef test_mark_positions_single_char_string():\n    \"\"\"单字符字符串时，range(0) 为空，结果应为空列表。\"\"\"\n    result = mark_positions(\"a\", \"a\")\n    assert result == []\n\n\ndef test_mark_positions_two_char_string():\n    \"\"\"两字符字符串时，只遍历索引 0。\"\"\"\n    result = mark_positions(\"ab\", \"a\")\n    assert result == [0]\n\n\ndef test_mark_positions_two_char_string_no_match():\n    \"\"\"两字符字符串且不匹配时，结果为 [-1]。\"\"\"\n    result = mark_positions(\"ab\", \"b\")\n    assert result == [-1]\n\n\n@pytest.mark.parametrize(\n    \"text, ch, expected\",\n    [\n        (\"abcabc\", \"a\", [0, -1, -1, 3, -1]),\n        (\"abcabc\", \"b\", [-1, 1, -1, -1, 4]),\n        (\"abcabc\", \"c\", [-1, -1, 2, -1, -1]),\n        (\"xyz\", \"x\", [0, -1]),\n        (\"xyz\", \"z\", [-1, -1]),\n        (\"aaaa\", \"a\", [0, 1, 2]),\n        (\"ab\", \"a\", [0]),\n        (\"ab\", \"b\", [-1]),\n        (\"\", \"a\", []),\n        (\"a\", \"a\", []),\n    ],\n)\ndef test_mark_positions_parametrized(text, ch, expected):\n    \"\"\"参数化用例：覆盖多种输入组合，期望值依据实现逻辑推导。\"\"\"\n    assert mark_positions(text, ch) == expected\n\n\ndef test_mark_positions_does_not_mutate_input():\n    \"\"\"函数不应修改输入字符串（字符串不可变，验证返回值独立）。\"\"\"\n    text = \"hello\"\n    ch = \"l\"\n    result = mark_positions(text, ch)\n    assert text == \"hello\"\n    assert result == [-1, 2, 2, -1]",
