          "generated_test": "import pytest\n\nfrom task_0063 import normalize_values, aggregate, doubled\n\n\n# ---------------------------------------------------------------------------\n# normalize_values\n# ---------------------------------------------------------------------------\n\ndef test_normalize_values_empty_list_returns_empty_list():\n    \"\"\"空列表应返回空列表（docstring/函数签名约定：返回 list，历史 bug 返回 [0]）。\n\n    期望值来源：函数名与类型注解表明是逐元素变换，空输入应得空输出；\n    历史 bug 注释明确指出空列表返回 [0] 是错误行为。\n    \"\"\"\n    assert normalize_values([]) == []\n\n\ndef test_normalize_values_single_element():\n    \"\"\"单元素列表应返回该元素的两倍，且不附加额外元素。\n\n    期望值来源：实现为 v * 2 的列表推导，历史 bug 仅在于尾部多出的 [0]。\n    \"\"\"\n    assert normalize_values([3]) == [6]\n\n\ndef test_normalize_values_multiple_elements():\n    \"\"\"多元素列表应逐元素翻倍，长度保持不变。\n\n    期望值来源：实现为 v * 2 的列表推导。\n    \"\"\"\n    assert normalize_values([1, 2, 3]) == [2, 4, 6]\n\n\ndef test_normalize_values_negative_and_zero():\n    \"\"\"负数与零应正确翻倍。\n\n    期望值来源：乘法语义，0*2=0，-5*2=-10。\n    \"\"\"\n    assert normalize_values([0, -5, 7]) == [0, -10, 14]\n\n\ndef test_normalize_values_does_not_append_zero():\n    \"\"\"结果长度必须等于输入长度（历史 bug 会多出一个 0）。\n\n    期望值来源：历史 bug 注释说明尾部 [0] 是错误行为。\n    \"\"\"\n    values = [1, 2, 3, 4]\n    result = normalize_values(values)\n    assert len(result) == len(values)\n\n\ndef test_normalize_values_returns_new_list():\n    \"\"\"应返回新列表，不修改输入列表。\n\n    期望值来源：函数签名返回 list，实现使用列表推导创建新对象。\n    \"\"\"\n    values = [1, 2, 3]\n    result = normalize_values(values)\n    assert result is not values\n    assert values == [1, 2, 3]\n\n\n# ---------------------------------------------------------------------------\n# aggregate\n# ---------------------------------------------------------------------------\n\ndef test_aggregate_empty_list_raises():\n    \"\"\"空列表求平均应抛出异常（历史 bug：除零）。\n\n    期望值来源：实现为 sum/len，空列表 len 为 0 导致 ZeroDivisionError；\n    历史 bug 注释指出空列表除零是缺陷，因此期望抛出异常而非返回某值。\n    \"\"\"\n    with pytest.raises(ZeroDivisionError):\n        aggregate([])\n\n\ndef test_aggregate_single_element():\n    \"\"\"单元素列表的平均值等于该元素。\n\n    期望值来源：sum/len 语义。\n    \"\"\"\n    assert aggregate([5]) == 5.0\n\n\ndef test_aggregate_multiple_elements():\n    \"\"\"多元素列表的平均值。\n\n    期望值来源：sum/len 语义，(1+2+3+4)/4 = 2.5。\n    \"\"\"\n    assert aggregate([1, 2, 3, 4]) == 2.5\n\n\ndef test_aggregate_negative_values():\n    \"\"\"含负数的平均值。\n\n    期望值来源：sum/len 语义，(-2 + 2 + 4)/3 = 4/3。\n    \"\"\"\n    assert aggregate([-2, 2, 4]) == pytest.approx(4 / 3)\n\n\ndef test_aggregate_returns_float():\n    \"\"\"返回值应为 float 类型。\n\n    期望值来源：类型注解 -> float。\n    \"\"\"\n    assert isinstance(aggregate([1, 2]), float)\n\n\n# ---------------------------------------------------------------------------\n# doubled\n# ---------------------------------------------------------------------------\n\ndef test_doubled_empty_list():\n    \"\"\"空列表求和为 0，翻倍后为 0。\n\n    期望值来源：sum([], 0) == 0，2 * 0 == 0。\n    \"\"\"\n    assert doubled([]) == 0\n\n\ndef test_doubled_single_element():\n    \"\"\"单元素列表翻倍求和。\n\n    期望值来源：2 * sum([3], 0) == 6。\n    \"\"\"\n    assert doubled([3]) == 6\n\n\ndef test_doubled_multiple_elements():\n    \"\"\"多元素列表翻倍求和。\n\n    期望值来源：2 * (1+2+3) == 12。\n    \"\"\"\n    assert doubled([1, 2, 3]) == 12\n\n\ndef test_doubled_negative_values():\n    \"\"\"含负数的翻倍求和。\n\n    期望值来源：2 * (-1 + -2 + 3) == 0。\n    \"\"\"\n    assert doubled([-1, -2, 3]) == 0\n\n\ndef test_doubled_returns_float():\n    \"\"\"返回值应为 float 类型（历史 bug：int 混用未归一化 float）。\n\n    期望值来源：类型注解 -> float；历史 bug 注释指出应归一化为 float。\n    \"\"\"\n    result = doubled([1, 2, 3])\n    assert isinstance(result, float)",
