          "generated_test": "import pytest\n\nfrom task_0028 import mark_positions\n\n\ndef test_mark_positions_basic_marks():\n    \"\"\"基本用例：字符出现在部分位置时，对应位置标记为索引，其余为 -1。\"\"\"\n    text = \"abcabc\"\n    ch = \"a\"\n    result = mark_positions(text, ch)\n    # 遍历范围是 range(len(text) - 1)，即索引 0..4\n    assert result == [0, -1, -1, 3, -1]\n\n\ndef test_mark_positions_no_match():\n    \"\"\"字符不存在时，所有位置都应标记为 -1。\"\"\"\n    text = \"hello\"\n    ch = \"z\"\n    result = mark_positions(text, ch)\n    assert result == [-1, -1, -1, -1]\n\n\ndef test_mark_positions_all_match():\n    \"\"\"字符在每个被遍历位置都出现时，结果应为连续索引。\"\"\"\n    text = \"aaaa\"\n    ch = \"a\"\n    result = mark_positions(text, ch)\n    assert result == [0, 1, 2]\n\n\ndef test_mark_positions_empty_string():\n    \"\"\"空字符串时，range(-1) 为空，应返回空列表。\"\"\"\n    result = mark_positions(\"\", \"a\")\n    assert result == []\n\n\ndef test_mark_positions_single_char_string():\n    \"\"\"单字符字符串时，range(0) 为空，应返回空列表。\"\"\"\n    result = mark_positions(\"a\", \"a\")\n    assert result == []\n\n\ndef test_mark_positions_two_char_string():\n    \"\"\"两字符字符串时，只遍历索引 0，返回长度为 1 的列表。\"\"\"\n    result = mark_positions(\"ab\", \"a\")\n    assert result == [0]\n\n\ndef test_mark_positions_last_char_ignored():\n    \"\"\"最后一个字符不会被遍历，因此即使匹配也不会被标记。\"\"\"\n    text = \"xyz\"\n    ch = \"z\"\n    result = mark_positions(text, ch)\n    assert result == [-1, -1]\n\n\ndef test_mark_positions_result_length():\n    \"\"\"返回列表长度应始终为 len(text) - 1（当 len(text) >= 1 时）。\"\"\"\n    text = \"abcdef\"\n    result = mark_positions(text, \"c\")\n    assert len(result) == len(text) - 1\n\n\n@pytest.mark.parametrize(\n    \"text, ch, expected\",\n    [\n        (\"abcabc\", \"a\", [0, -1, -1, 3, -1]),\n        (\"abcabc\", \"b\", [-1, 1, -1, -1, 4]),\n        (\"abcabc\", \"c\", [-1, -1, 2, -1, -1]),\n        (\"hello\", \"l\", [-1, -1, 2, 3]),\n        (\"aaaa\", \"a\", [0, 1, 2]),\n        (\"ab\", \"a\", [0]),\n        (\"ab\", \"b\", [-1]),\n        (\"\", \"a\", []),\n        (\"a\", \"a\", []),\n    ],\n)\ndef test_mark_positions_parametrized(text, ch, expected):\n    \"\"\"参数化用例：覆盖多种输入组合，验证标记结果。\"\"\"\n    assert mark_positions(text, ch) == expected\n\n\ndef test_mark_positions_returns_list():\n    \"\"\"返回值类型应为 list。\"\"\"\n    result = mark_positions(\"abc\", \"a\")\n    assert isinstance(result, list)\n\n\ndef test_mark_positions_does_not_mutate_input():\n    \"\"\"函数不应修改输入字符串（字符串不可变，验证返回值独立于输入）。\"\"\"\n    text = \"abcabc\"\n    original = text\n    mark_positions(text, \"a\")\n    assert text == original",
