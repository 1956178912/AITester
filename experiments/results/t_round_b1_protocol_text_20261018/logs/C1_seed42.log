          "generated_test": "import pytest\n\nfrom task_0073 import normalize, aggregate, report\n\n\nclass TestNormalize:\n    \"\"\"Tests for normalize function.\"\"\"\n\n    def test_normalize_empty_list(self):\n        \"\"\"normalize([]) should return an empty list.\"\"\"\n        assert normalize([]) == []\n\n    def test_normalize_single_element(self):\n        \"\"\"normalize([3]) should double each element -> [6].\"\"\"\n        assert normalize([3]) == [6]\n\n    def test_normalize_multiple_elements(self):\n        \"\"\"normalize([1, 2, 3]) should double each element -> [2, 4, 6].\"\"\"\n        assert normalize([1, 2, 3]) == [2, 4, 6]\n\n    def test_normalize_negative_numbers(self):\n        \"\"\"normalize([-1, -2]) should double each element -> [-2, -4].\"\"\"\n        assert normalize([-1, -2]) == [-2, -4]\n\n    def test_normalize_zero(self):\n        \"\"\"normalize([0]) should return [0].\"\"\"\n        assert normalize([0]) == [0]\n\n    def test_normalize_returns_new_list(self):\n        \"\"\"normalize should return a new list, not mutate the input.\"\"\"\n        original = [1, 2, 3]\n        result = normalize(original)\n        assert result == [2, 4, 6]\n        assert original == [1, 2, 3]\n        assert result is not original\n\n\nclass TestAggregate:\n    \"\"\"Tests for aggregate function.\"\"\"\n\n    def test_aggregate_empty_list(self):\n        \"\"\"aggregate([]) should return count=0 and total=0.\"\"\"\n        assert aggregate([]) == {\"count\": 0, \"total\": 0}\n\n    def test_aggregate_single_element(self):\n        \"\"\"aggregate([5]) should return count=1 and total=5.\"\"\"\n        assert aggregate([5]) == {\"count\": 1, \"total\": 5}\n\n    def test_aggregate_multiple_elements(self):\n        \"\"\"aggregate([1, 2, 3]) should return count=3 and total=6.\"\"\"\n        assert aggregate([1, 2, 3]) == {\"count\": 3, \"total\": 6}\n\n    def test_aggregate_negative_numbers(self):\n        \"\"\"aggregate([-1, -2, -3]) should return count=3 and total=-6.\"\"\"\n        assert aggregate([-1, -2, -3]) == {\"count\": 3, \"total\": -6}\n\n    def test_aggregate_mixed_numbers(self):\n        \"\"\"aggregate([-1, 0, 1]) should return count=3 and total=0.\"\"\"\n        assert aggregate([-1, 0, 1]) == {\"count\": 3, \"total\": 0}\n\n    def test_aggregate_returns_dict_with_expected_keys(self):\n        \"\"\"aggregate result should contain exactly 'count' and 'total' keys.\"\"\"\n        result = aggregate([1, 2])\n        assert set(result.keys()) == {\"count\", \"total\"}\n\n\nclass TestReport:\n    \"\"\"Tests for report function.\"\"\"\n\n    def test_report_empty_list(self):\n        \"\"\"report([]) should produce 'count=0 total=0'.\"\"\"\n        assert report([]) == \"count=0 total=0\"\n\n    def test_report_single_element(self):\n        \"\"\"report([3]) normalizes to [6], so count=1 total=6.\"\"\"\n        assert report([3]) == \"count=1 total=6\"\n\n    def test_report_multiple_elements(self):\n        \"\"\"report([1, 2, 3]) normalizes to [2, 4, 6], so count=3 total=12.\"\"\"\n        assert report([1, 2, 3]) == \"count=3 total=12\"\n\n    def test_report_negative_numbers(self):\n        \"\"\"report([-1, -2]) normalizes to [-2, -4], so count=2 total=-6.\"\"\"\n        assert report([-1, -2]) == \"count=2 total=-6\"\n\n    def test_report_zero(self):\n        \"\"\"report([0]) normalizes to [0], so count=1 total=0.\"\"\"\n        assert report([0]) == \"count=1 total=0\"\n\n    def test_report_returns_string(self):\n        \"\"\"report should return a string.\"\"\"\n        assert isinstance(report([1, 2]), str)\n\n    def test_report_uses_normalized_values(self):\n        \"\"\"report should reflect doubled values from normalize in its total.\"\"\"\n        data = [1, 2, 3, 4]\n        normalized = normalize(data)\n        expected_total = sum(normalized)\n        expected = \"count={0} total={1}\".format(len(normalized), expected_total)\n        assert report(data) == expected",
