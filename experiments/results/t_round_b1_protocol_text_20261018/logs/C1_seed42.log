          "generated_test": "import pytest\n\nfrom task_0004 import _better, best_score, worst_score\n\n\nclass TestBetter:\n    \"\"\"Tests for the _better helper function.\"\"\"\n\n    @pytest.mark.parametrize(\n        \"current, candidate, expected\",\n        [\n            (5, 3, True),\n            (3, 5, False),\n            (5, 5, False),\n            (0, -1, True),\n            (-1, 0, False),\n            (-5, -10, True),\n            (-10, -5, False),\n        ],\n    )\n    def test_better_returns_candidate_less_than_current(self, current, candidate, expected):\n        \"\"\"_better should return True iff candidate < current.\"\"\"\n        assert _better(current, candidate) is expected\n\n    def test_better_equal_values_returns_false(self):\n        \"\"\"_better with equal values should return False (candidate not strictly less).\"\"\"\n        assert _better(7, 7) is False\n\n    def test_better_large_ints(self):\n        \"\"\"_better should work with large integers.\"\"\"\n        assert _better(10**18, 10**18 - 1) is True\n        assert _better(10**18 - 1, 10**18) is False\n\n\nclass TestBestScore:\n    \"\"\"Tests for best_score.\"\"\"\n\n    @pytest.mark.parametrize(\n        \"scores, expected\",\n        [\n            ([1, 2, 3], 1),\n            ([3, 2, 1], 1),\n            ([5], 5),\n            ([2, 2, 2], 2),\n            ([-1, -2, -3], -3),\n            ([0, -5, 5], -5),\n            ([10, 1, 10, 1], 1),\n            ([100, 50, 75, 25], 25),\n        ],\n    )\n    def test_best_score_returns_minimum(self, scores, expected):\n        \"\"\"best_score should return the minimum value in the list.\"\"\"\n        assert best_score(scores) == expected\n\n    def test_best_score_single_element(self):\n        \"\"\"best_score on a single-element list returns that element.\"\"\"\n        assert best_score([42]) == 42\n\n    def test_best_score_does_not_mutate_input(self):\n        \"\"\"best_score should not modify the input list.\"\"\"\n        scores = [3, 1, 2]\n        original = list(scores)\n        best_score(scores)\n        assert scores == original\n\n    def test_best_score_empty_list_raises(self):\n        \"\"\"best_score on empty list raises IndexError (accesses scores[0]).\"\"\"\n        with pytest.raises(IndexError):\n            best_score([])\n\n\nclass TestWorstScore:\n    \"\"\"Tests for worst_score.\"\"\"\n\n    @pytest.mark.parametrize(\n        \"scores, expected\",\n        [\n            ([1, 2, 3], 3),\n            ([3, 2, 1], 3),\n            ([5], 5),\n            ([2, 2, 2], 2),\n            ([-1, -2, -3], -1),\n            ([0, -5, 5], 5),\n            ([10, 1, 10, 1], 10),\n            ([100, 50, 75, 25], 100),\n        ],\n    )\n    def test_worst_score_returns_maximum(self, scores, expected):\n        \"\"\"worst_score should return the maximum value in the list.\"\"\"\n        assert worst_score(scores) == expected\n\n    def test_worst_score_single_element(self):\n        \"\"\"worst_score on a single-element list returns that element.\"\"\"\n        assert worst_score([42]) == 42\n\n    def test_worst_score_does_not_mutate_input(self):\n        \"\"\"worst_score should not modify the input list.\"\"\"\n        scores = [3, 1, 2]\n        original = list(scores)\n        worst_score(scores)\n        assert scores == original\n\n    def test_worst_score_empty_list_raises(self):\n        \"\"\"worst_score on empty list raises IndexError (accesses scores[0]).\"\"\"\n        with pytest.raises(IndexError):\n            worst_score([])\n\n\nclass TestBestWorstConsistency:\n    \"\"\"Cross-checks between best_score and worst_score.\"\"\"\n\n    @pytest.mark.parametrize(\n        \"scores\",\n        [\n            [1, 2, 3],\n            [3, 2, 1],\n            [5],\n            [-1, -2, -3],\n            [0, -5, 5],\n            [10, 1, 10, 1],\n        ],\n    )\n    def test_best_score_and_worst_score_match_builtins(self, scores):\n        \"\"\"best_score == min(scores) and worst_score == max(scores).\"\"\"\n        assert best_score(scores) == min(scores)\n        assert worst_score(scores) == max(scores)\n\n    @pytest.mark.parametrize(\n        \"scores\",\n        [\n            [1, 2, 3],\n            [-1, -2, -3],\n            [0, -5, 5],\n        ],\n    )\n    def test_best_score_le_worst_score(self, scores):\n        \"\"\"best_score should always be <= worst_score.\"\"\"\n        assert best_score(scores) <= worst_score(scores)",
