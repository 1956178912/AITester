          "generated_test": "import pytest\n\nfrom task_0055 import clamp\n\n\ndef test_clamp_value_within_range_returns_value():\n    \"\"\"值在范围内时，应原样返回该值。\"\"\"\n    assert clamp(5.0, 0.0, 10.0) == 5.0\n\n\ndef test_clamp_value_below_min_returns_min():\n    \"\"\"值小于下界时，应返回下界。\"\"\"\n    assert clamp(-3.0, 0.0, 10.0) == 0.0\n\n\ndef test_clamp_value_above_max_returns_max():\n    \"\"\"值大于上界时，应返回上界。\"\"\"\n    assert clamp(15.0, 0.0, 10.0) == 10.0\n\n\ndef test_clamp_value_equal_to_min_returns_min():\n    \"\"\"值等于下界时，应返回下界。\"\"\"\n    assert clamp(0.0, 0.0, 10.0) == 0.0\n\n\ndef test_clamp_value_equal_to_max_returns_max():\n    \"\"\"值等于上界时，应返回上界。\"\"\"\n    assert clamp(10.0, 0.0, 10.0) == 10.0\n\n\n@pytest.mark.parametrize(\n    \"value,min_val,max_val,expected\",\n    [\n        (5.0, 0.0, 10.0, 5.0),\n        (-1.0, 0.0, 10.0, 0.0),\n        (11.0, 0.0, 10.0, 10.0),\n        (0.0, 0.0, 10.0, 0.0),\n        (10.0, 0.0, 10.0, 10.0),\n        (-5.0, -10.0, -1.0, -5.0),\n        (-20.0, -10.0, -1.0, -10.0),\n        (0.0, -10.0, -1.0, -1.0),\n        (3.14, 3.14, 3.14, 3.14),\n    ],\n)\ndef test_clamp_parametrized_cases(value, min_val, max_val, expected):\n    \"\"\"参数化验证 clamp 在各类边界与区间内的行为。\"\"\"\n    assert clamp(value, min_val, max_val) == expected\n\n\ndef test_clamp_min_equals_max_returns_that_value():\n    \"\"\"当下界等于上界时，任何输入都应返回该边界值。\"\"\"\n    assert clamp(100.0, 5.0, 5.0) == 5.0\n    assert clamp(-100.0, 5.0, 5.0) == 5.0\n    assert clamp(5.0, 5.0, 5.0) == 5.0\n\n\ndef test_clamp_returns_float_type():\n    \"\"\"返回值应为 float 类型（输入为 float 时）。\"\"\"\n    result = clamp(1.5, 0.0, 2.0)\n    assert isinstance(result, float)\n\n\ndef test_clamp_with_integers_returns_numeric():\n    \"\"\"整数输入时返回值应与预期数值相等（类型可能为 int 或 float）。\"\"\"\n    assert clamp(5, 0, 10) == 5\n    assert clamp(-1, 0, 10) == 0\n    assert clamp(11, 0, 10) == 10",
