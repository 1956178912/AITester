          "generated_test": "import pytest\n\nfrom task_0010 import compute_scores, average, rank_top\n\n\n# ---------------------------------------------------------------------------\n# compute_scores\n# ---------------------------------------------------------------------------\n\ndef test_compute_scores_basic():\n    \"\"\"compute_scores 应将每条记录的 name 映射到 value。\"\"\"\n    records = [\n        {\"name\": \"a\", \"value\": 10},\n        {\"name\": \"b\", \"value\": 20},\n    ]\n    result = compute_scores(records)\n    assert result == {\"a\": 10, \"b\": 20}\n\n\ndef test_compute_scores_empty_list():\n    \"\"\"空记录列表应返回空字典。\"\"\"\n    assert compute_scores([]) == {}\n\n\ndef test_compute_scores_missing_name_uses_unknown():\n    \"\"\"缺少 name 字段时，key 应为 'unknown'（来自 docstring/默认值约定）。\"\"\"\n    records = [{\"value\": 5}]\n    result = compute_scores(records)\n    assert result == {\"unknown\": 5}\n\n\ndef test_compute_scores_missing_value_defaults_zero():\n    \"\"\"缺少 value 字段时，value 应为 0（来自默认值约定）。\"\"\"\n    records = [{\"name\": \"x\"}]\n    result = compute_scores(records)\n    assert result == {\"x\": 0}\n\n\ndef test_compute_scores_duplicate_names_last_wins():\n    \"\"\"同名记录应后者覆盖前者（字典赋值语义）。\"\"\"\n    records = [\n        {\"name\": \"a\", \"value\": 1},\n        {\"name\": \"a\", \"value\": 2},\n    ]\n    result = compute_scores(records)\n    assert result == {\"a\": 2}\n\n\ndef test_compute_scores_returns_dict():\n    \"\"\"返回值类型应为 dict。\"\"\"\n    result = compute_scores([{\"name\": \"a\", \"value\": 1}])\n    assert isinstance(result, dict)\n\n\n# ---------------------------------------------------------------------------\n# average\n# ---------------------------------------------------------------------------\n\ndef test_average_empty_dict_returns_zero():\n    \"\"\"空字典应返回 0.0（来自 docstring/实现约定）。\"\"\"\n    assert average({}) == 0.0\n\n\ndef test_average_single_value():\n    \"\"\"单个值的平均值等于该值。\"\"\"\n    assert average({\"a\": 10}) == 10.0\n\n\ndef test_average_multiple_values():\n    \"\"\"多个值的平均值应为总和除以数量。\"\"\"\n    assert average({\"a\": 10, \"b\": 20, \"c\": 30}) == 20.0\n\n\ndef test_average_returns_float():\n    \"\"\"返回值类型应为 float。\"\"\"\n    result = average({\"a\": 1, \"b\": 2})\n    assert isinstance(result, float)\n\n\ndef test_average_negative_values():\n    \"\"\"包含负值时平均值计算应正确。\"\"\"\n    assert average({\"a\": -10, \"b\": 10}) == 0.0\n\n\n# ---------------------------------------------------------------------------\n# rank_top\n# ---------------------------------------------------------------------------\n\ndef test_rank_top_basic_order():\n    \"\"\"rank_top 应按 value 降序返回前 k 项。\"\"\"\n    scores = {\"a\": 1, \"b\": 3, \"c\": 2}\n    result = rank_top(scores, 2)\n    assert result == [(\"b\", 3), (\"c\", 2)]\n\n\ndef test_rank_top_k_larger_than_size():\n    \"\"\"k 大于字典大小时应返回全部项。\"\"\"\n    scores = {\"a\": 1, \"b\": 2}\n    result = rank_top(scores, 10)\n    assert result == [(\"b\", 2), (\"a\", 1)]\n\n\ndef test_rank_top_empty_dict():\n    \"\"\"空字典应返回空列表。\"\"\"\n    assert rank_top({}, 3) == []\n\n\ndef test_rank_top_k_zero():\n    \"\"\"k 为 0 时应返回空列表。\"\"\"\n    assert rank_top({\"a\": 1, \"b\": 2}, 0) == []\n\n\ndef test_rank_top_returns_list_of_tuples():\n    \"\"\"返回值应为 list，元素为 (key, value) 元组。\"\"\"\n    result = rank_top({\"a\": 1}, 1)\n    assert isinstance(result, list)\n    assert result == [(\"a\", 1)]\n\n\ndef test_rank_top_negative_k():\n    \"\"\"k 为负数时按切片语义返回除末尾外的所有项（期望值来源不明，需人工确认）。\"\"\"\n    scores = {\"a\": 1, \"b\": 2, \"c\": 3}\n    result = rank_top(scores, -1)\n    # 记录实际行为：sorted 降序后切片 [:-1]\n    assert result == [(\"c\", 3), (\"b\", 2)]",
          "execution_trace": [
