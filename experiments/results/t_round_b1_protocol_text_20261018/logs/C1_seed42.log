          "generated_test": "import pytest\n\nfrom task_0066 import pick_label, report\n\n\n# ---------------------------------------------------------------------------\n# pick_label\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\n    \"score, expected\",\n    [\n        (90, \"excellent\"),\n        (91, \"excellent\"),\n        (100, \"excellent\"),\n        (1000, \"excellent\"),\n    ],\n)\ndef test_pick_label_excellent(score, expected):\n    \"\"\"score >= 90 应返回 'excellent'（期望值来源：docstring/实现约定）。\"\"\"\n    assert pick_label(score) == expected\n\n\n@pytest.mark.parametrize(\n    \"score, expected\",\n    [\n        (60, \"pass\"),\n        (61, \"pass\"),\n        (75, \"pass\"),\n        (89, \"pass\"),\n    ],\n)\ndef test_pick_label_pass(score, expected):\n    \"\"\"60 <= score < 90 应返回 'pass'（期望值来源：实现约定）。\"\"\"\n    assert pick_label(score) == expected\n\n\n@pytest.mark.parametrize(\"score\", [0, 1, 30, 59, -1, -100])\ndef test_pick_label_below_pass_returns_none(score):\n    \"\"\"score < 60 时函数无显式 return，应返回 None。\n\n    期望值来源不明，需人工确认：实现中缺少 else 分支，\n    此处记录实际行为（隐式返回 None）。\n    \"\"\"\n    assert pick_label(score) is None\n\n\ndef test_pick_label_boundary_89_vs_90():\n    \"\"\"边界 89/90 应分别落入 'pass' 与 'excellent'。\"\"\"\n    assert pick_label(89) == \"pass\"\n    assert pick_label(90) == \"excellent\"\n\n\ndef test_pick_label_boundary_59_vs_60():\n    \"\"\"边界 59/60 应分别返回 None 与 'pass'。\n\n    期望值来源不明，需人工确认：59 依赖隐式 None 行为。\n    \"\"\"\n    assert pick_label(59) is None\n    assert pick_label(60) == \"pass\"\n\n\ndef test_pick_label_returns_str_when_defined():\n    \"\"\"在已定义分支上返回值类型应为 str。\"\"\"\n    assert isinstance(pick_label(90), str)\n    assert isinstance(pick_label(60), str)\n\n\n# ---------------------------------------------------------------------------\n# report\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\n    \"score, expected\",\n    [\n        (90, \"result: EXCELLENT\"),\n        (100, \"result: EXCELLENT\"),\n        (60, \"result: PASS\"),\n        (75, \"result: PASS\"),\n    ],\n)\ndef test_report_formats_uppercase_label(score, expected):\n    \"\"\"report 应返回 'result: ' 前缀加上大写标签（期望值来源：实现约定）。\"\"\"\n    assert report(score) == expected\n\n\ndef test_report_prefix_and_uppercase():\n    \"\"\"report 输出应以 'result: ' 开头且标签为大写。\"\"\"\n    out = report(95)\n    assert out.startswith(\"result: \")\n    assert out == \"result: \" + pick_label(95).upper()\n\n\ndef test_report_below_pass_raises_attribute_error():\n    \"\"\"score < 60 时 pick_label 返回 None，report 调用 .upper() 应抛 AttributeError。\n\n    期望值来源不明，需人工确认：该行为由实现中缺少兜底分支导致。\n    \"\"\"\n    with pytest.raises(AttributeError):\n        report(59)\n\n\ndef test_report_returns_str():\n    \"\"\"report 在正常分支上应返回 str。\"\"\"\n    assert isinstance(report(70), str)",
