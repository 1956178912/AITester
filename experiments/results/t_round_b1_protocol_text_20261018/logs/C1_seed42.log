          "generated_test": "import pytest\n\nfrom task_0018 import clamp\n\n\ndef test_clamp_returns_value_when_within_bounds():\n    \"\"\"值在 [min_val, max_val] 区间内时，应原样返回该值。\"\"\"\n    assert clamp(5.0, 0.0, 10.0) == 5.0\n\n\ndef test_clamp_returns_min_val_when_value_below_min():\n    \"\"\"值小于 min_val 时，应返回 min_val。\"\"\"\n    assert clamp(-3.0, 0.0, 10.0) == 0.0\n\n\ndef test_clamp_returns_max_val_when_value_above_max():\n    \"\"\"值大于 max_val 时，应返回 max_val。\"\"\"\n    assert clamp(42.0, 0.0, 10.0) == 10.0\n\n\ndef test_clamp_returns_value_when_equal_to_min():\n    \"\"\"值恰好等于 min_val 时，应返回该值（边界包含）。\"\"\"\n    assert clamp(0.0, 0.0, 10.0) == 0.0\n\n\ndef test_clamp_returns_value_when_equal_to_max():\n    \"\"\"值恰好等于 max_val 时，应返回该值（边界包含）。\"\"\"\n    assert clamp(10.0, 0.0, 10.0) == 10.0\n\n\ndef test_clamp_handles_negative_range():\n    \"\"\"区间为负数范围时，clamp 行为应一致。\"\"\"\n    assert clamp(-5.0, -10.0, -1.0) == -5.0\n    assert clamp(-20.0, -10.0, -1.0) == -10.0\n    assert clamp(0.0, -10.0, -1.0) == -1.0\n\n\ndef test_clamp_handles_zero_width_range():\n    \"\"\"min_val == max_val 时，任何输入都应返回该固定值。\"\"\"\n    assert clamp(3.0, 2.0, 2.0) == 2.0\n    assert clamp(-3.0, 2.0, 2.0) == 2.0\n    assert clamp(2.0, 2.0, 2.0) == 2.0\n\n\ndef test_clamp_handles_integer_inputs():\n    \"\"\"整数输入应被接受并返回数值结果。\"\"\"\n    assert clamp(5, 0, 10) == 5\n    assert clamp(-1, 0, 10) == 0\n    assert clamp(11, 0, 10) == 10\n\n\n@pytest.mark.parametrize(\n    \"value, min_val, max_val, expected\",\n    [\n        (5.0, 0.0, 10.0, 5.0),\n        (-1.0, 0.0, 10.0, 0.0),\n        (11.0, 0.0, 10.0, 10.0),\n        (0.0, 0.0, 10.0, 0.0),\n        (10.0, 0.0, 10.0, 10.0),\n        (1e-9, 0.0, 1.0, 1e-9),\n        (1e9, 0.0, 1.0, 1.0),\n    ],\n)\ndef test_clamp_parametrized_cases(value, min_val, max_val, expected):\n    \"\"\"参数化覆盖区间内、区间外、边界及极端值场景。\"\"\"\n    assert clamp(value, min_val, max_val) == expected\n\n\ndef test_clamp_returns_float_type():\n    \"\"\"返回值应为 float 类型（依据类型注解）。\"\"\"\n 