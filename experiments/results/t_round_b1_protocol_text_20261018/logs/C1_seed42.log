          "generated_test": "import pytest\n\nfrom task_0062 import initials\n\n\ndef test_initials_basic_two_part_name():\n    \"\"\"基本用例：两个单词的姓名应返回首字母大写并以点连接。\"\"\"\n    assert initials(\"john doe\") == \"J.D\"\n\n\ndef test_initials_three_part_name():\n    \"\"\"三个单词的姓名应返回三个首字母大写并以点连接。\"\"\"\n    assert initials(\"john ronald reuel tolkien\") == \"J.R.R.T\"\n\n\ndef test_initials_single_word():\n    \"\"\"单个单词应返回其首字母大写，无点号。\"\"\"\n    assert initials(\"alice\") == \"A\"\n\n\ndef test_initials_already_uppercase():\n    \"\"\"输入已大写时结果不变。\"\"\"\n    assert initials(\"John Doe\") == \"J.D\"\n\n\ndef test_initials_mixed_case():\n    \"\"\"混合大小写输入应统一转为大写首字母。\"\"\"\n    assert initials(\"jOhN dOe\") == \"J.D\"\n\n\ndef test_initials_extra_whitespace():\n    \"\"\"多余空白应被 split() 忽略，不产生空片段。\"\"\"\n    assert initials(\"  john   doe  \") == \"J.D\"\n\n\ndef test_initials_tabs_and_newlines():\n    \"\"\"制表符和换行符作为分隔符时行为与空格一致。\"\"\"\n    assert initials(\"john\\tdoe\\nsmith\") == \"J.D.S\"\n\n\ndef test_initials_empty_string():\n    \"\"\"空字符串 split() 后为空列表，join 结果为空字符串。\"\"\"\n    assert initials(\"\") == \"\"\n\n\ndef test_initials_whitespace_only():\n    \"\"\"仅含空白的字符串 split() 后为空列表，结果为空字符串。\"\"\"\n    assert initials(\"   \\t\\n  \") == \"\"\n\n\ndef test_initials_none_input_raises():\n    \"\"\"None 输入会触发 AttributeError（None 无 split 方法）。\n\n    期望值来源：函数签名允许 None，但实现未做 None 处理，\n    此处记录实际行为，需人工确认是否应改为显式处理 None。\n    \"\"\"\n    with pytest.raises(AttributeError):\n        initials(None)\n\n\ndef test_initials_non_string_input_raises():\n    \"\"\"非字符串输入（如整数）会触发 AttributeError。\n\n    期望值来源：类型注解声明为 str | None，非字符串输入属未定义行为，\n    此处记录实际行为，需人工确认。\n    \"\"\"\n    with pytest.raises(AttributeError):\n        initials(123)\n\n\n@pytest.mark.parametrize(\n    \"full_name, expected\",\n    [\n        (\"a b c\", \"A.B.C\"),\n        (\"x\", \"X\"),\n        (\"  y  \", \"Y\"),\n        (\"\", \"\"),\n    ],\n)\ndef test_initials_parametrized(full_name, expected):\n    \"\"\"参数化覆