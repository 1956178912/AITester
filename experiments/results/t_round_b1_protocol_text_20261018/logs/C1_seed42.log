          "generated_test": "import pytest\n\nfrom task_0085 import fibonacci\n\n\ndef test_fibonacci_returns_int_for_positive_input():\n    \"\"\"fibonacci 对正整数输入应返回 int 类型结果。\"\"\"\n    result = fibonacci(5)\n    assert isinstance(result, int)\n\n\ndef test_fibonacci_zero_returns_one():\n    \"\"\"根据实现，n <= 0 时返回 1（期望值来源：目标代码实现）。\"\"\"\n    assert fibonacci(0) == 1\n\n\ndef test_fibonacci_negative_returns_one():\n    \"\"\"根据实现，n < 0 时返回 1（期望值来源：目标代码实现）。\"\"\"\n    assert fibonacci(-1) == 1\n    assert fibonacci(-10) == 1\n\n\ndef test_fibonacci_one_returns_one():\n    \"\"\"根据实现，n == 1 时返回 1（期望值来源：目标代码实现）。\"\"\"\n    assert fibonacci(1) == 1\n\n\n@pytest.mark.parametrize(\n    \"n, expected\",\n    [\n        (2, 2),\n        (3, 3),\n        (4, 5),\n        (5, 8),\n        (6, 13),\n        (7, 21),\n        (8, 34),\n        (9, 55),\n        (10, 89),\n    ],\n)\ndef test_fibonacci_known_values(n, expected):\n    \"\"\"验证 fibonacci 在已知输入下的返回值（期望值来源：目标代码递推关系）。\"\"\"\n    assert fibonacci(n) == expected\n\n\ndef test_fibonacci_recursive_relation():\n    \"\"\"验证 fibonacci 满足递推关系 f(n) = f(n-1) + f(n-2)（n >= 2）。\"\"\"\n    for n in range(2, 12):\n        assert fibonacci(n) == fibonacci(n - 1) + fibonacci(n - 2)\n\n\ndef test_fibonacci_monotonic_increasing_for_n_ge_2():\n    \"\"\"对于 n >= 2，fibonacci 序列应严格递增（期望值来源：目标代码递推关系）。\"\"\"\n    values = [fibonacci(n) for n in range(2, 12)]\n    assert all(b > a for a, b in zip(values, values[1:]))\n\n\ndef test_fibonacci_accepts_bool_input():\n    \"\"\"bool 是 int 的子类，True 等价于 1，False 等价于 0（期望值来源：Python 类型语义）。\"\"\"\n    assert fibonacci(True) == fibonacci(1)\n    assert fibonacci(False) == fibonacci(0)\n\n\ndef test_fibonacci_float_input_raises_type_error():\n    \"\"\"传入 float 时，递归比较与减法仍可运行但结果不符合 int 语义；\n    此处记录实际行为：float 输入不会抛出异常（期望值来源不明，需人工确认）。\"\"\"\n    try:\n        result = fibonacci(3.0)\n    except TypeError:\n        pytest.skip(\"float 输入抛出 TypeError，行为与当前实现不同\")\n    assert isinstance(result, int)",
