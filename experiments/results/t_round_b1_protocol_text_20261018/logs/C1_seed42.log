          "generated_test": "import pytest\n\nfrom task_0020 import mark_positions\n\n\ndef test_mark_positions_basic_marks():\n    \"\"\"基本用例：字符出现在部分位置时，对应位置标记为索引，其余为 -1。\"\"\"\n    text = \"abcabc\"\n    ch = \"a\"\n    result = mark_positions(text, ch)\n    # 遍历范围是 range(len(text) - 1)，即索引 0..4\n    assert result == [0, -1, -1, 3, -1]\n\n\ndef test_mark_positions_no_match():\n    \"\"\"字符不存在时，所有位置都应标记为 -1。\"\"\"\n    text = \"hello\"\n    ch = \"z\"\n    result = mark_positions(text, ch)\n    assert result == [-1, -1, -1, -1]\n\n\ndef test_mark_positions_all_match():\n    \"\"\"所有被遍历位置都匹配时，返回连续索引列表。\"\"\"\n    text = \"aaaa\"\n    ch = \"a\"\n    result = mark_positions(text, ch)\n    # 遍历索引 0..2\n    assert result == [0, 1, 2]\n\n\ndef test_mark_positions_excludes_last_character():\n    \"\"\"最后一个字符不参与遍历：即使匹配也不会出现在结果中。\"\"\"\n    text = \"abca\"\n    ch = \"a\"\n    result = mark_positions(text, ch)\n    # 索引 0 匹配，索引 3 是最后一个字符被排除\n    assert result == [0, -1, -1]\n\n\ndef test_mark_positions_empty_string():\n    \"\"\"空字符串时，range(-1) 为空，返回空列表。\"\"\"\n    result = mark_positions(\"\", \"a\")\n    assert result == []\n\n\ndef test_mark_positions_single_character():\n    \"\"\"单字符字符串时，range(0) 为空，返回空列表。\"\"\"\n    result = mark_positions(\"a\", \"a\")\n    assert result == []\n\n\ndef test_mark_positions_two_characters():\n    \"\"\"两字符字符串时，只遍历索引 0。\"\"\"\n    result = mark_positions(\"ab\", \"a\")\n    assert result == [0]\n    result2 = mark_positions(\"ab\", \"b\")\n    assert result2 == [-1]\n\n\ndef test_mark_positions_returns_list():\n    \"\"\"返回值类型应为 list。\"\"\"\n    result = mark_positions(\"abc\", \"a\")\n    assert isinstance(result, list)\n\n\ndef test_mark_positions_length_is_len_minus_one():\n    \"\"\"返回列表长度应等于 len(text) - 1（非负）。\"\"\"\n    text = \"abcdef\"\n    result = mark_positions(text, \"x\")\n    assert len(result) == len(text) - 1\n\n\n@pytest.mark.parametrize(\n    \"text, ch, expected\",\n    [\n        (\"abcabc\", \"a\", [0, -1, -1, 3, -1]),\n        (\"abcabc\", \"b\", [-1, 1, -1, -1, 4]),\n        (\"abcabc\", \"c\", [-1, -1, 2, -1, -1]),\n        (\"xyz\", \"x\", [-1, -1]),\n        (\"xyz\", \"z\", [-1, -1]),\n        (\"\", \"a\", []),\n        (\"a\", \"a\", []),\n        (\"aa\", \"a\", [0]),\n    ],\n)\ndef test_mark_positions_parametrized(text, ch, expected):\n    \"\"\"参数化用例：覆盖多种输入组合，验证标记结果。\"\"\"\n    assert mark_positions(text, ch) == expected\n\n\ndef test_mark_positions_does_not_mutate_input():\n    \"\"\"函数不应修改输入字符串（字符串不可变，验证返回值独立）。\"\"\"\n    text = \"hello\"\n    ch = \"l\"\n    result = mark_positions(text, ch)\n    assert text == \"hello\"\n    assert result == [-1, 2, 2, -1]",
