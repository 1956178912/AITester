          "generated_test": "import pytest\n\nfrom task_0003 import normalize, aggregate, report\n\n\nclass TestNormalize:\n    \"\"\"Tests for normalize function.\"\"\"\n\n    def test_normalize_empty_list(self):\n        \"\"\"Empty list should return empty list.\"\"\"\n        assert normalize([]) == []\n\n    def test_normalize_single_element(self):\n        \"\"\"Single element should be doubled.\"\"\"\n        assert normalize([5]) == [10]\n\n    def test_normalize_multiple_elements(self):\n        \"\"\"Each element should be doubled.\"\"\"\n        assert normalize([1, 2, 3]) == [2, 4, 6]\n\n    def test_normalize_negative_numbers(self):\n        \"\"\"Negative numbers should be doubled correctly.\"\"\"\n        assert normalize([-1, -2, -3]) == [-2, -4, -6]\n\n    def test_normalize_zero(self):\n        \"\"\"Zero should remain zero after doubling.\"\"\"\n        assert normalize([0, 0, 0]) == [0, 0, 0]\n\n    def test_normalize_floats(self):\n        \"\"\"Float values should be doubled.\"\"\"\n        assert normalize([1.5, 2.5]) == [3.0, 5.0]\n\n    def test_normalize_returns_new_list(self):\n        \"\"\"normalize should return a new list, not modify input.\"\"\"\n        original = [1, 2, 3]\n        result = normalize(original)\n        assert result == [2, 4, 6]\n        assert original == [1, 2, 3]\n        assert result is not original\n\n\nclass TestAggregate:\n    \"\"\"Tests for aggregate function.\"\"\"\n\n    def test_aggregate_empty_list(self):\n        \"\"\"Empty list should return count=0 and total=0.\"\"\"\n        assert aggregate([]) == {\"count\": 0, \"total\": 0}\n\n    def test_aggregate_single_element(self):\n        \"\"\"Single element should have count=1 and total equal to element.\"\"\"\n        assert aggregate([5]) == {\"count\": 1, \"total\": 5}\n\n    def test_aggregate_multiple_elements(self):\n        \"\"\"Multiple elements should have correct count and total.\"\"\"\n        assert aggregate([1, 2, 3]) == {\"count\": 3, 