          "generated_test": "import pytest\n\nfrom task_0048 import safe_div\n\n\ndef test_safe_div_returns_float_for_exact_division():\n    \"\"\"正常整除应返回浮点结果 2.0（期望值来源：Python 除法语义）。\"\"\"\n    result = safe_div(4, 2)\n    assert result == 2.0\n    assert isinstance(result, float)\n\n\ndef test_safe_div_returns_float_for_non_exact_division():\n    \"\"\"非整除应返回浮点结果 2.5（期望值来源：Python 除法语义）。\"\"\"\n    result = safe_div(5, 2)\n    assert result == 2.5\n    assert isinstance(result, float)\n\n\ndef test_safe_div_negative_numbers():\n    \"\"\"负数除法应返回正确浮点结果 -2.5（期望值来源：Python 除法语义）。\"\"\"\n    assert safe_div(-5, 2) == -2.5\n\n\ndef test_safe_div_zero_numerator():\n    \"\"\"分子为 0 时应返回 0.0（期望值来源：Python 除法语义）。\"\"\"\n    assert safe_div(0, 5) == 0.0\n\n\ndef test_safe_div_by_zero_raises_zero_division_error():\n    \"\"\"除数为 0 时应抛出 ZeroDivisionError（期望值来源：Python 除法语义）。\"\"\"\n    with pytest.raises(ZeroDivisionError):\n        safe_div(1, 0)\n\n\n@pytest.mark.parametrize(\n    \"a, b, expected\",\n    [\n        (10, 4, 2.5),\n        (1, 3, 1 / 3),\n        (-10, -4, 2.5),\n        (7, 7, 1.0),\n    ],\n)\ndef test_safe_div_parametrized(a, b, expected):\n    \"\"\"参数化验证多种输入下的除法结果（期望值来源：Python 除法语义）。\"\"\"\n    assert safe_div(a, b) == expected",
