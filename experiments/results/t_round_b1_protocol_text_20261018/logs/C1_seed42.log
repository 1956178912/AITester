          "generated_test": "import math\n\nimport pytest\n\nfrom task_0013 import sqrt\n\n\ndef test_sqrt_zero_returns_zero():\n    \"\"\"sqrt(0) 应返回 0（依据函数实现中的显式分支）。\"\"\"\n    assert sqrt(0) == 0\n\n\ndef test_sqrt_zero_float_returns_zero():\n    \"\"\"sqrt(0.0) 应返回 0（依据函数实现中的显式分支）。\"\"\"\n    assert sqrt(0.0) == 0\n\n\n@pytest.mark.parametrize(\n    \"x, expected\",\n    [\n        (1, 1.0),\n        (4, 2.0),\n        (9, 3.0),\n        (16, 4.0),\n        (2.25, 1.5),\n        (0.25, 0.5),\n    ],\n)\ndef test_sqrt_perfect_squares(x, expected):\n    \"\"\"完全平方数/可精确开方的输入应返回精确结果（依据数学定义）。\"\"\"\n    assert sqrt(x) == pytest.approx(expected)\n\n\n@pytest.mark.parametrize(\"x\", [2, 3, 5, 7, 10, 0.5, 1.5, 100.0])\ndef test_sqrt_matches_math_sqrt(x):\n    \"\"\"对正数输入，sqrt 结果应与 math.sqrt 一致（依据数学定义）。\"\"\"\n    assert sqrt(x) == pytest.approx(math.sqrt(x))\n\n\n@pytest.mark.parametrize(\"x\", [1e-12, 1e12, 1e-6, 1e6])\ndef test_sqrt_extreme_positive_values(x):\n    \"\"\"极端正数输入下结果应与 math.sqrt 一致（依据数学定义）。\"\"\"\n    assert sqrt(x) == pytest.approx(math.sqrt(x))\n\n\ndef test_sqrt_result_is_non_negative():\n    \"\"\"对正数输入，返回值应为非负数（依据平方根数学定义）。\"\"\"\n    assert sqrt(42) >= 0\n\n\ndef test_sqrt_negative_raises_or_returns_complex():\n    \"\"\"负数输入的行为：期望值来源不明，需人工确认。\n\n    当前实现使用 x ** 0.5，对负数会返回复数（complex），\n    而非抛出异常。此处记录实际行为，避免臆造期望值。\n    \"\"\"\n    result = sqrt(-4)\n    # 记录实际行为：Python 中 (-4) ** 0.5 返回复数\n    assert isinstance(result, complex)\n    assert result == pytest.approx(2j)\n\n\ndef test_sqrt_negative_one_behavior():\n    \"\"\"sqrt(-1) 的行为：期望值来源不明，需人工确认。\n\n    记录当前实现返回复数 1j 的实际行为。\n    \"\"\"\n    result = sqrt(-1)\n    assert isinstance(result, complex)\n    assert result == pytest.approx(1j)",
