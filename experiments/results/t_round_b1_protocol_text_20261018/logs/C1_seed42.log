          "generated_test": "import pytest\n\nfrom task_0038 import cumulative\n\n\ndef test_cumulative_empty_list():\n    \"\"\"空列表应返回空列表。\"\"\"\n    assert cumulative([]) == []\n\n\ndef test_cumulative_single_element():\n    \"\"\"单元素列表的累积和等于该元素本身（初始 total=-1，加上 v 后为 v-1）。\n\n    期望值来源：函数实现中 total 初始为 -1，因此单元素 [v] 的结果为 v-1。\n    \"\"\"\n    assert cumulative([5]) == [4]\n\n\ndef test_cumulative_multiple_elements():\n    \"\"\"多元素列表的累积和从 -1 开始累加。\n\n    期望值来源：函数实现中 total 初始为 -1。\n    [1, 2, 3] -> [-1+1, 0+2, 2+3] = [0, 2, 5]\n    \"\"\"\n    assert cumulative([1, 2, 3]) == [0, 2, 5]\n\n\ndef test_cumulative_negative_values():\n    \"\"\"包含负数的列表累积和正确计算。\n\n    期望值来源：函数实现中 total 初始为 -1。\n    [-1, -2, -3] -> [-2, -4, -7]\n    \"\"\"\n    assert cumulative([-1, -2, -3]) == [-2, -4, -7]\n\n\ndef test_cumulative_zeros():\n    \"\"\"全零列表的累积和每项均为 -1。\n\n    期望值来源：函数实现中 total 初始为 -1，加 0 不变。\n    \"\"\"\n    assert cumulative([0, 0, 0]) == [-1, -1, -1]\n\n\ndef test_cumulative_mixed_values():\n    \"\"\"混合正负数的列表累积和正确计算。\n\n    期望值来源：函数实现中 total 初始为 -1。\n    [10, -5, 3] -> [9, 4, 7]\n    \"\"\"\n    assert cumulative([10, -5, 3]) == [9, 4, 7]\n\n\ndef test_cumulative_returns_new_list():\n    \"\"\"函数应返回新列表，不修改输入列表。\"\"\"\n    values = [1, 2, 3]\n    result = cumulative(values)\n    assert result is not values\n    assert values == [1, 2, 3]\n\n\ndef test_cumulative_output_length_matches_input():\n    \"\"\"输出列表长度应与输入列表长度一致。\"\"\"\n    values = [1, 2, 3, 4, 5]\n    assert len(cumulative(values)) == len(values)\n\n\ndef test_cumulative_float_values():\n    \"\"\"浮点数列表的累积和正确计算。\n\n    期望值来源：函数实现中 total 初始为 -1。\n    [1.5, 2.5] -> [0.5, 3.0]\n    \"\"\"\n    assert cumulative([1.5, 2.5]) == [0.5, 3.0]\n\n\ndef test_cumulative_non_list_iterable():\n    \"\"\"传入元组等可迭代对象时行为与列表一致。\n\n    期望值来源：函数实现仅依赖迭代，不依赖 list 类型。\n    (1, 2, 3) -> [0, 2, 5]\n    \"\"\"\n    assert cumulative((1, 2, 3)) == [0, 2, 5]\n\n\ndef test_cumulative_invalid_input_raises():\n    \"\"\"传入不可迭代对象时应抛出 TypeError。\"\"\"\n    with pytest.raises(TypeError):\n        cumulative(123)",
