          "generated_test": "import pytest\n\nfrom task_0065 import process\n\n\ndef test_process_returns_list():\n    \"\"\"process 应返回 list 类型（依据函数签名 -> list）。\"\"\"\n    result = process([1, 2, 3])\n    assert isinstance(result, list)\n\n\ndef test_process_increments_each_element():\n    \"\"\"每个元素应加 1（依据实现约定 x + 1）。\"\"\"\n    assert process([1, 2, 3]) == [2, 3, 4]\n\n\ndef test_process_appends_zero_at_end():\n    \"\"\"结果末尾应追加一个 0（依据实现约定 + [0]）。\"\"\"\n    result = process([5])\n    assert result[-1] == 0\n\n\ndef test_process_empty_list():\n    \"\"\"空输入应返回仅含末尾 0 的列表（依据实现约定）。\"\"\"\n    assert process([]) == [0]\n\n\ndef test_process_negative_numbers():\n    \"\"\"负数元素同样加 1（依据实现约定 x + 1）。\"\"\"\n    assert process([-1, -2]) == [0, -1, 0]\n\n\ndef test_process_single_element():\n    \"\"\"单元素输入应返回 [x+1, 0]（依据实现约定）。\"\"\"\n    assert process([10]) == [11, 0]\n\n\ndef test_process_length_is_input_plus_one():\n    \"\"\"输出长度应为输入长度加 1（依据实现约定追加一个 0）。\"\"\"\n    items = [1, 2, 3, 4]\n    assert len(process(items)) == len(items) + 1\n\n\ndef test_process_does_not_mutate_input():\n    \"\"\"process 不应修改传入的列表（依据实现为列表推导式，不原地修改）。\"\"\"\n    items = [1, 2, 3]\n    original = list(items)\n    process(items)\n    assert items == original\n\n\n@pytest.mark.parametrize(\n    \"items, expected\",\n    [\n        ([0], [1, 0]),\n        ([1, 1, 1], [2, 2, 2, 0]),\n        ([-5, 0, 5], [-4, 1, 6, 0]),\n    ],\n)\ndef test_process_parametrized(items, expected):\n    \"\"\"参数化验证各输入下的输出（依据实现约定 x + 1 并追加 0）。\"\"\"\n    assert process(items) == expected\n\n\ndef test_process_non_list_iterable_behavior():\n    \"\"\"传入非 list 可迭代对象时的行为记录。\n\n    期望值来源不明，需人工确认：函数签名标注 list，\n    此处仅记录实际行为，不强制断言具体结果。\n    \"\"\"\n    try:\n        result = process((1, 2))\n    except Exception as exc:  # noqa: BLE001\n        assert isinstance(exc, Exception)\n    else:\n        assert isinstance(result, list)",
