          "generated_test": "import pytest\n\nfrom task_0071 import safe_div\n\n\ndef test_safe_div_returns_float_for_positive_integers():\n    \"\"\"正常除法：正整数相除应返回正确结果（期望值来源：Python 除法语义）。\"\"\"\n    result = safe_div(10, 2)\n    assert result == 5.0\n    assert isinstance(result, float)\n\n\ndef test_safe_div_returns_float_for_negative_integers():\n    \"\"\"正常除法：负数相除应返回正确结果（期望值来源：Python 除法语义）。\"\"\"\n    result = safe_div(-9, 3)\n    assert result == -3.0\n    assert isinstance(result, float)\n\n\ndef test_safe_div_returns_float_for_mixed_signs():\n    \"\"\"正常除法：正负混合相除应返回正确结果（期望值来源：Python 除法语义）。\"\"\"\n    result = safe_div(7, -2)\n    assert result == -3.5\n    assert isinstance(result, float)\n\n\ndef test_safe_div_returns_float_for_non_integer_result():\n    \"\"\"正常除法：不能整除时应返回浮点结果（期望值来源：Python 除法语义）。\"\"\"\n    result = safe_div(1, 4)\n    assert result == 0.25\n    assert isinstance(result, float)\n\n\ndef test_safe_div_zero_numerator():\n    \"\"\"边界：被除数为 0 时应返回 0.0（期望值来源：Python 除法语义）。\"\"\"\n    result = safe_div(0, 5)\n    assert result == 0.0\n    assert isinstance(result, float)\n\n\ndef test_safe_div_division_by_zero_raises():\n    \"\"\"异常：除数为 0 时应抛出 ZeroDivisionError（期望值来源：Python 除法语义）。\"\"\"\n    with pytest.raises(ZeroDivisionError):\n        safe_div(1, 0)\n\n\ndef test_safe_div_zero_divided_by_zero_raises():\n    \"\"\"异常：0 除以 0 时应抛出 ZeroDivisionError（期望值来源：Python 除法语义）。\"\"\"\n    with pytest.raises(ZeroDivisionError):\n        safe_div(0, 0)\n\n\n@pytest.mark.parametrize(\n    \"a, b, expected\",\n    [\n        (10, 2, 5.0),\n        (-9, 3, -3.0),\n        (7, -2, -3.5),\n        (1, 4, 0.25),\n        (0, 5, 0.0),\n        (100, 10, 10.0),\n    ],\n)\ndef test_safe_div_parametrized_valid_inputs(a, b, expected):\n    \"\"\"参数化正常用例：验证多种输入下的除法结果（期望值来源：Python 除法语义）。\"\"\"\n    result = safe_div(a, b)\n    assert result == expected\n    assert isinstance(result, float)\n\n\n@pytest.mark.parametrize(\"a, b\", [(1, 0), (0, 0), (-5, 0)])\ndef test_safe_div_parametrized_division_by_zero(a, b):\n    \"\"\"参数化异常用例：除数为 0 时均应抛出 ZeroDivisionError（期望值来源：Python 除法语义）。\"\"\"\n    with pytest.raises(ZeroDivisionError):\n        safe_div(a, b)",
