          "generated_test": "import pytest\n\nfrom task_0072 import lookup, describe, display\n\n\n# ---------------------------------------------------------------------------\n# lookup\n# ---------------------------------------------------------------------------\n\ndef test_lookup_known_keys():\n    \"\"\"已知键应返回 _TABLE 中对应的值（来源：模块内 _TABLE 定义）。\"\"\"\n    assert lookup(\"alpha\") == 1\n    assert lookup(\"beta\") == 2\n    assert lookup(\"gamma\") == 3\n\n\ndef test_lookup_unknown_key_returns_zero():\n    \"\"\"未知键应返回默认值 0（来源：_TABLE.get(key, 0) 的默认参数）。\"\"\"\n    assert lookup(\"delta\") == 0\n    assert lookup(\"\") == 0\n\n\ndef test_lookup_is_case_sensitive():\n    \"\"\"键查找区分大小写，'Alpha' 不在表中，应返回 0（来源：dict 语义）。\"\"\"\n    assert lookup(\"Alpha\") == 0\n\n\n@pytest.mark.parametrize(\"key\", [\"alpha\", \"beta\", \"gamma\"])\ndef test_lookup_parametrized_known_keys(key):\n    \"\"\"参数化验证所有已知键均返回非零值（来源：_TABLE 定义）。\"\"\"\n    assert lookup(key) != 0\n\n\n# ---------------------------------------------------------------------------\n# describe\n# ---------------------------------------------------------------------------\n\ndef test_describe_positive_int():\n    \"\"\"describe 应返回 'value=<n>' 格式（来源：f-string 实现）。\"\"\"\n    assert describe(5) == \"value=5\"\n\n\ndef test_describe_zero():\n    \"\"\"describe(0) 应返回 'value=0'（来源：f-string 实现）。\"\"\"\n    assert describe(0) == \"value=0\"\n\n\ndef test_describe_negative_int():\n    \"\"\"describe 对负数应返回 'value=-3'（来源：f-string 实现）。\"\"\"\n    assert describe(-3) == \"value=-3\"\n\n\n@pytest.mark.parametrize(\"value\", [0, 1, -1, 42, 1000])\ndef test_describe_parametrized(value):\n    \"\"\"参数化验证 describe 输出格式（来源：f-string 实现）。\"\"\"\n    assert describe(value) == f\"value={value}\"\n\n\n# ---------------------------------------------------------------------------\n# display\n# ---------------------------------------------------------------------------\n\ndef test_display_raises_attribute_error_for_known_key():\n    \"\"\"d