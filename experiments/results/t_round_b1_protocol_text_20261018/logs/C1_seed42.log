          "generated_test": "import pytest\n\nfrom task_0084 import mark_positions\n\n\ndef test_mark_positions_basic_marks():\n    \"\"\"基本用例：字符出现在前 len(text)-1 个位置时，对应位置标记为索引，其余为 -1。\"\"\"\n    text = \"abca\"\n    ch = \"a\"\n    # 期望值来源：函数实现遍历 range(len(text)-1)，即索引 0..len-2\n    assert mark_positions(text, ch) == [0, -1, -1]\n\n\ndef test_mark_positions_ignores_last_character():\n    \"\"\"边界用例：最后一个字符即使匹配也不会被标记（循环范围不含最后一位）。\"\"\"\n    text = \"xyzx\"\n    ch = \"x\"\n    # 期望值来源：range(len(text)-1) 不包含最后一个索引\n    assert mark_positions(text, ch) == [0, -1, -1]\n\n\ndef test_mark_positions_no_match():\n    \"\"\"无匹配字符时，所有位置均为 -1。\"\"\"\n    text = \"hello\"\n    ch = \"z\"\n    assert mark_positions(text, ch) == [-1, -1, -1, -1]\n\n\ndef test_mark_positions_all_match():\n    \"\"\"所有被遍历位置都匹配时，返回对应索引列表。\"\"\"\n    text = \"aaaa\"\n    ch = \"a\"\n    assert mark_positions(text, ch) == [0, 1, 2]\n\n\ndef test_mark_positions_empty_string():\n    \"\"\"空字符串输入：range(-1) 为空，返回空列表。\"\"\"\n    assert mark_positions(\"\", \"a\") == []\n\n\ndef test_mark_positions_single_character():\n    \"\"\"单字符字符串：range(0) 为空，返回空列表。\"\"\"\n    assert mark_positions(\"a\", \"a\") == []\n\n\ndef test_mark_positions_two_characters():\n    \"\"\"两字符字符串：仅遍历索引 0。\"\"\"\n    assert mark_positions(\"ab\", \"a\") == [0]\n    assert mark_positions(\"ab\", \"b\") == [-1]\n\n\ndef test_mark_positions_returns_list():\n    \"\"\"返回值类型应为 list。\"\"\"\n    result = mark_positions(\"abc\", \"a\")\n    assert isinstance(result, list)\n\n\ndef test_mark_positions_length_is_len_minus_one():\n    \"\"\"返回列表长度应等于 len(text) - 1（对非空字符串）。\"\"\"\n    text = \"abcdef\"\n    result = mark_positions(text, \"a\")\n    assert len(result) == len(text) - 1\n\n\n@pytest.mark.parametrize(\n    \"text, ch, expected\",\n    [\n        (\"abcabc\", \"a\", [0, -1, -1, 3, -1]),\n        (\"abcabc\", \"c\", [-1, -1, 2, -1, -1]),\n        (\"banana\", \"n\", [-1, -1, 2, -1, 4]),\n        (\"banana\", \"b\", [0, -1, -1, -1, -1]),\n    ],\n)\ndef test_mark_positions_parametrized(text, ch, expected):\n    \"\"\"参数化用例：验证多种输入下的标记结果。\"\"\"\n    assert mark_positions(text, ch) == expected\n\n\ndef test_mark_positions_does_not_mutate_input():\n    \"\"\"函数不应修改输入字符串（字符串不可变，验证返回值独立且输入不变）。\"\"\"\n    text = \"hello\"\n    original = text\n    mark_positions(text, \"l\")\n    assert text == original",
