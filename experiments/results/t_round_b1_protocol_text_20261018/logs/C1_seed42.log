          "generated_test": "import pytest\n\nfrom task_0061 import is_palindrome\n\n\ndef test_is_palindrome_simple_true():\n    \"\"\"基本回文串应返回 True。\"\"\"\n    assert is_palindrome(\"racecar\") is True\n\n\ndef test_is_palindrome_simple_false():\n    \"\"\"非回文串应返回 False。\"\"\"\n    assert is_palindrome(\"hello\") is False\n\n\ndef test_is_palindrome_empty_string():\n    \"\"\"空字符串按定义 s == s[::-1] 成立，应返回 True。\"\"\"\n    assert is_palindrome(\"\") is True\n\n\ndef test_is_palindrome_single_char():\n    \"\"\"单字符字符串是回文，应返回 True。\"\"\"\n    assert is_palindrome(\"a\") is True\n\n\ndef test_is_palindrome_two_same_chars():\n    \"\"\"两个相同字符组成的字符串是回文。\"\"\"\n    assert is_palindrome(\"aa\") is True\n\n\ndef test_is_palindrome_two_diff_chars():\n    \"\"\"两个不同字符组成的字符串不是回文。\"\"\"\n    assert is_palindrome(\"ab\") is False\n\n\ndef test_is_palindrome_even_length_true():\n    \"\"\"偶数长度回文串应返回 True。\"\"\"\n    assert is_palindrome(\"abba\") is True\n\n\ndef test_is_palindrome_odd_length_true():\n    \"\"\"奇数长度回文串应返回 True。\"\"\"\n    assert is_palindrome(\"abcba\") is True\n\n\ndef test_is_palindrome_case_sensitive():\n    \"\"\"实现为大小写敏感比较，'Aa' 反转后为 'aA'，不相等，应返回 False。\"\"\"\n    assert is_palindrome(\"Aa\") is False\n\n\ndef test_is_palindrome_with_spaces():\n    \"\"\"实现不忽略空格，'a b a' 反转后为 'a b a'，应返回 True。\"\"\"\n    assert is_palindrome(\"a b a\") is True\n\n\ndef test_is_palindrome_with_spaces_false():\n    \"\"\"含空格但非回文的字符串应返回 False。\"\"\"\n    assert is_palindrome(\"ab a\") is False\n\n\ndef test_is_palindrome_numeric_string():\n    \"\"\"数字字符串同样适用反转比较。\"\"\"\n    assert is_palindrome(\"12321\") is True\n\n\ndef test_is_palindrome_numeric_string_false():\n    \"\"\"非回文数字字符串应返回 False。\"\"\"\n    assert is_palindrome(\"12345\") is False\n\n\ndef test_is_palindrome_unicode():\n    \"\"\"Unicode 字符同样按字符反转比较。\"\"\"\n    assert is_palindrome(\"上海自来水来自海上\") is True\n\n\ndef test_is_palindrome_returns_bool_type():\n    \"\"\"返回值类型应为 bool。\"\"\"\n    result = is_palindrome(\"abc\")\n    assert isinstance(result, bool)\n\n\n@pytest.mark.parametrize(\n    \"s,expected\",\n    [\n        (\"\", True),\n        (\"a\", True),\n        (\"ab\", False),\n        (\"aba\", True),\n        (\"abba\", True),\n        (\"abc\", False),\n        (\"12321\", True),\n        (\"12345\", False),\n    ],\n)\ndef test_is_palindrome_parametrized(s: str, expected: bool):\n    \"\"\"参数化验证多种输入下的回文判断结果。\"\"\"\n    assert is_palindrome(s) is expected",
