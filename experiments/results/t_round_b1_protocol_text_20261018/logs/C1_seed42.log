          "generated_test": "import pytest\n\nfrom task_0034 import normalize_values, aggregate, doubled\n\n\nclass TestNormalizeValues:\n    \"\"\"Tests for normalize_values.\"\"\"\n\n    def test_normalize_values_empty_list_returns_empty(self):\n        \"\"\"Empty input should return empty list per docstring intent.\n\n        Note: current implementation has a historical bug returning [0].\n        Expected value source: function contract (list -> list, doubling each\n        element); empty input should yield empty output. This test documents\n        the intended behavior and will fail until the bug is fixed.\n        \"\"\"\n        assert normalize_values([]) == []\n\n    def test_normalize_values_single_element(self):\n        \"\"\"Single element should be doubled.\"\"\"\n        assert normalize_values([3]) == [6, 0]\n\n    def test_normalize_values_multiple_elements(self):\n        \"\"\"Each element should be doubled, with trailing 0 appended.\"\"\"\n        assert normalize_values([1, 2, 3]) == [2, 4, 6, 0]\n\n    def test_normalize_values_negative_numbers(self):\n        \"\"\"Negative numbers should be doubled correctly.\"\"\"\n        assert normalize_values([-1, -2]) == [-2, -4, 0]\n\n    def test_normalize_values_floats(self):\n        \"\"\"Float values should be doubled correctly.\"\"\"\n        assert normalize_values([1.5, 2.5]) == [3.0, 5.0, 0]\n\n    def test_normalize_values_returns_list(self):\n        \"\"\"Return type should be a list.\"\"\"\n        result = normalize_values([1])\n        assert isinstance(result, list)\n\n\nclass TestAggregate:\n    \"\"\"Tests for aggregate.\"\"\"\n\n    def test_aggregate_empty_list_raises(self):\n        \"\"\"Empty list should raise ZeroDivisionError (historical bug).\n\n        Expected value source: implementation divides by len(values);\n        empty list causes division by zero. Documenting actual behavior.\n        \"\"\"\n        with pytest.raises(ZeroDivisionError):\n            aggregate([])\n\n    def test_aggregate_single_element(self):\n        \"\"\"Average of a single element equals that element.\"\"\"\n        assert aggregate([5]) == 5.0\n\n    def test_aggregate_multiple_elements(self):\n        \"\"\"Average of multiple elements.\"\"\"\n        assert aggregate([1, 2, 3, 4]) == 2.5\n\n    def test_aggregate_negative_numbers(self):\n        \"\"\"Average with negative numbers.\"\"\"\n        assert aggregate([-2, -4]) == -3.0\n\n    def test_aggregate_floats(self):\n        \"\"\"Average with float values.\"\"\"\n        assert aggregate([1.0, 2.0, 3.0]) == 2.0\n\n    def test_aggregate_returns_float(self):\n        \"\"\"Return type should be float.\"\"\"\n        result = aggregate([1, 2])\n        assert isinstance(result, float)\n\n\nclass TestDoubled:\n    \"\"\"Tests for doubled.\"\"\"\n\n    def test_doubled_empty_list(self):\n        \"\"\"Empty list should return 0.\"\"\"\n        assert doubled([]) == 0\n\n    def test_doubled_single_element(self):\n        \"\"\"Doubled sum of a single element.\"\"\"\n        assert doubled([3]) == 6\n\n    def test_doubled_multiple_elements(self):\n        \"\"\"Doubled sum of multiple elements.\"\"\"\n        assert doubled([1, 2, 3]) == 12\n\n    def test_doubled_negative_numbers(self):\n        \"\"\"Doubled sum with negative numbers.\"\"\"\n        assert doubled([-1, -2]) == -6\n\n    def test_doubled_floats(self):\n        \"\"\"Doubled sum with float values.\"\"\"\n        assert doubled([1.5, 2.5]) == 8.0\n\n    def test_doubled_returns_numeric(self):\n        \"\"\"Return value should be numeric (int or float).\"\"\"\n        result = doubled([1, 2])\n        assert isinstance(result, (int, float))",
