          "generated_test": "import pytest\n\nfrom task_0059 import is_valid_username\n\n\ndef test_is_valid_username_returns_bool_for_valid_alnum():\n    \"\"\"有效用户名（非空、字母数字、长度<=20）应返回 bool 类型。\n\n    期望值来源：函数签名 -> bool；docstring 未提供，但类型注解明确返回 bool。\n    \"\"\"\n    result = is_valid_username(\"abc123\")\n    assert isinstance(result, bool)\n\n\ndef test_is_valid_username_empty_string():\n    \"\"\"空字符串不是有效用户名。\n\n    期望值来源：实现中 bool(name) 为 False，ok 为 False，返回 not ok = True。\n    注意：函数名语义为 is_valid_username，但实现返回的是 not ok，\n    因此对无效输入返回 True。此处记录实际行为。\n    \"\"\"\n    assert is_valid_username(\"\") is True\n\n\ndef test_is_valid_username_non_alnum():\n    \"\"\"包含非字母数字字符的用户名无效。\n\n    期望值来源：实现中 name.isalnum() 为 False，ok 为 False，返回 True。\n    \"\"\"\n    assert is_valid_username(\"abc-123\") is True\n\n\ndef test_is_valid_username_too_long():\n    \"\"\"长度超过 20 的用户名无效。\n\n    期望值来源：实现中 len(name) <= 20 为 False，ok 为 False，返回 True。\n    \"\"\"\n    long_name = \"a\" * 21\n    assert is_valid_username(long_name) is True\n\n\ndef test_is_valid_username_exactly_20_chars():\n    \"\"\"长度恰好为 20 的字母数字用户名有效。\n\n    期望值来源：实现中 len(name) <= 20 为 True，ok 为 True，返回 False。\n    \"\"\"\n    name = \"a\" * 20\n    assert is_valid_username(name) is False\n\n\ndef test_is_valid_username_single_char():\n    \"\"\"单个字母数字字符是有效用户名。\n\n    期望值来源：非空、isalnum、长度<=20 均满足，ok 为 True，返回 False。\n    \"\"\"\n    assert is_valid_username(\"a\") is False\n\n\n@pytest.mark.parametrize(\n    \"name\",\n    [\"abc\", \"ABC123\", \"a1b2c3\", \"0\", \"Z9\"],\n)\ndef test_is_valid_username_valid_inputs_return_false(name):\n    \"\"\"多种有效用户名应返回 False（表示有效）。\n\n    期望值来源：实现逻辑 ok=True -> 返回 not ok = False。\n    \"\"\"\n    assert is_valid_username(name) is False\n\n\n@pytest.mark.parametrize(\n    \"name\",\n    [\"\", \" \", \"abc def\", \"abc_123\", \"abc.123\", \"a\" * 21, \"!@#\"],\n)\ndef test_is_valid_username_invalid_inputs_return_true(name):\n    \"\"\"多种无效用户名应返回 True（表示无效）。\n\n    期望值来源：实现逻辑 ok=False -> 返回 not ok = True。\n    \"\"\"\n    assert is_valid_username(name) is True\n\n\ndef test_is_valid_username_non_string_raises():\n    \"\"\"传入非字符串时，bool(name) 可能为 True 但 .isalnum() 不存在会抛 AttributeError。\n\n    期望值来源：实现直接调用 name.isalnum()，非字符串无此方法。\n    期望值来源不明，需人工确认：此处记录实际抛 AttributeError 的行为。\n    \"\"\"\n    with pytest.raises(AttributeError):\n        is_valid_username(123)",
