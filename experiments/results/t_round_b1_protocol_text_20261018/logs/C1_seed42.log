          "generated_test": "import pytest\n\nfrom task_0058 import normalize_values, aggregate, doubled\n\n\n# ---------------------------------------------------------------------------\n# normalize_values\n# ---------------------------------------------------------------------------\n\ndef test_normalize_values_empty_list_returns_empty_list():\n    \"\"\"空列表应返回空列表（docstring/函数签名约定：返回 list，历史 bug 返回 [0]）。\n\n    期望值来源：函数语义（对每个元素翻倍后拼接），空输入应得空输出。\n    \"\"\"\n    result = normalize_values([])\n    assert result == []\n\n\ndef test_normalize_values_single_element():\n    \"\"\"单元素列表应翻倍并追加 0（历史行为：末尾追加 0）。\"\"\"\n    result = normalize_values([3])\n    assert result == [6, 0]\n\n\ndef test_normalize_values_multiple_elements():\n    \"\"\"多元素列表应逐个翻倍并追加 0。\"\"\"\n    result = normalize_values([1, 2, 3])\n    assert result == [2, 4, 6, 0]\n\n\ndef test_normalize_values_negative_and_zero():\n    \"\"\"负数与零应正确翻倍。\"\"\"\n    result = normalize_values([-1, 0, 5])\n    assert result == [-2, 0, 10, 0]\n\n\ndef test_normalize_values_returns_list_type():\n    \"\"\"返回值类型应为 list。\"\"\"\n    result = normalize_values([1, 2])\n    assert isinstance(result, list)\n\n\ndef test_normalize_values_does_not_mutate_input():\n    \"\"\"不应修改传入的列表。\"\"\"\n    original = [1, 2, 3]\n    normalize_values(original)\n    assert original == [1, 2, 3]\n\n\n# ---------------------------------------------------------------------------\n# aggregate\n# ---------------------------------------------------------------------------\n\ndef test_aggregate_empty_list_raises():\n    \"\"\"空列表求平均应抛出异常（历史 bug：除零）。\n\n    期望值来源：函数语义为 sum/len，空列表 len 为 0，应触发 ZeroDivisionError。\n    \"\"\"\n    with pytest.raises(ZeroDivisionError):\n        aggregate([])\n\n\ndef test_aggregate_single_element():\n    \"\"\"单元素列表的平均值等于该元素。\"\"\"\n    assert aggregate([5]) == 5.0\n\n\ndef test_aggregate_multiple_elements():\n    \"\"\"多元素列表的平均值计算正确。\"\"\"\n    assert aggregate([1, 2, 3, 4]) == pytest.approx(2.5)\n\n\ndef test_aggregat