          "generated_test": "import pytest\n\nfrom task_0030 import process\n\n\ndef test_process_returns_list():\n    \"\"\"process 应返回 list 类型（依据函数返回类型注解 list）。\"\"\"\n    result = process([1, 2, 3])\n    assert isinstance(result, list)\n\n\ndef test_process_adds_one_to_each_element():\n    \"\"\"process 对每个元素加 1（依据函数体实现 x + 1）。\"\"\"\n    assert process([1, 2, 3])[:3] == [2, 3, 4]\n\n\ndef test_process_appends_zero_at_end():\n    \"\"\"process 在结果末尾追加 0（依据函数体实现 + [0]）。\"\"\"\n    result = process([1, 2, 3])\n    assert result[-1] == 0\n\n\ndef test_process_output_length_is_input_plus_one():\n    \"\"\"输出长度应为输入长度加 1（依据函数体实现）。\"\"\"\n    items = [10, 20, 30, 40]\n    assert len(process(items)) == len(items) + 1\n\n\ndef test_process_empty_list():\n    \"\"\"空列表输入应返回仅含一个 0 的列表（依据函数体实现）。\"\"\"\n    assert process([]) == [0]\n\n\ndef test_process_negative_numbers():\n    \"\"\"负数元素同样加 1（依据函数体实现 x + 1）。\"\"\"\n    assert process([-1, -2]) == [0, -1, 0]\n\n\ndef test_process_floats():\n    \"\"\"浮点数元素同样加 1（依据函数体实现 x + 1）。\"\"\"\n    assert process([1.5, 2.5]) == [2.5, 3.5, 0]\n\n\ndef test_process_does_not_mutate_input():\n    \"\"\"process 不应修改传入的列表（依据列表推导式生成新列表）。\"\"\"\n    items = [1, 2, 3]\n    original = list(items)\n    process(items)\n    assert items == original\n\n\ndef test_process_single_element():\n    \"\"\"单元素输入应返回 [x+1, 0]（依据函数体实现）。\"\"\"\n    assert process([5]) == [6, 0]\n\n\ndef test_process_non_list_input_raises():\n    \"\"\"传入不可迭代对象应抛出 TypeError（依据列表推导式需可迭代）。\n\n    期望值来源不明，需人工确认：函数未做类型校验，此处仅验证\n    对不可迭代输入会自然抛出 TypeError。\n    \"\"\"\n    with pytest.raises(TypeError):\n        process(123)",
