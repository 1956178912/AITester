          "generated_test": "import pytest\n\nfrom task_0000 import distance\n\n\ndef test_distance_returns_difference_of_two_ints():\n    \"\"\"distance(a, b) 应返回 a - b 的整数结果（依据函数实现与类型注解）。\"\"\"\n    assert distance(5, 3) == 2\n\n\ndef test_distance_negative_result_when_a_less_than_b():\n    \"\"\"当 a < b 时，distance 应返回负值（依据 a - b 的语义）。\"\"\"\n    assert distance(3, 5) == -2\n\n\ndef test_distance_zero_when_equal():\n    \"\"\"当 a == b 时，distance 应返回 0（依据 a - b 的语义）。\"\"\"\n    assert distance(7, 7) == 0\n\n\ndef test_distance_with_zero_operands():\n    \"\"\"与 0 运算时，distance 应返回相应值（依据 a - b 的语义）。\"\"\"\n    assert distance(0, 0) == 0\n    assert distance(0, 4) == -4\n    assert distance(4, 0) == 4\n\n\ndef test_distance_negative_operands():\n    \"\"\"负数输入时，distance 应正确计算 a - b（依据 a - b 的语义）。\"\"\"\n    assert distance(-3, -5) == 2\n    assert distance(-3, 5) == -8\n    assert distance(3, -5) == 8\n\n\n@pytest.mark.parametrize(\n    \"a, b, expected\",\n    [\n        (10, 4, 6),\n        (4, 10, -6),\n        (100, 100, 0),\n        (-1, 1, -2),\n        (1, -1, 2),\n        (0, 1, -1),\n        (1, 0, 1),\n    ],\n)\ndef test_distance_parametrized_cases(a, b, expected):\n    \"\"\"参数化验证 distance 在多种整数输入下返回 a - b（依据 a - b 的语义）。\"\"\"\n    assert distance(a, b) == expected\n\n\ndef test_distance_returns_int_type():\n    \"\"\"distance 的返回值应为 int 类型（依据返回类型注解）。\"\"\"\n    result = distance(9, 4)\n    assert isinstance(result, int)\n    assert not isinstance(result, bool)\n\n\ndef test_distance_large_values():\n    \"\"\"大整数输入时，distance 应返回 a - b（依据 a - b 的语义）。\"\"\"\n    a = 10**18\n    b = 10**18 - 12345\n    assert distance(a, b) == 12345",
