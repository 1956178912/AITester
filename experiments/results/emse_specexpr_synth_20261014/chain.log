          "generated_test": "import pytest\n\nfrom task_0032 import get_second\n\n\nclass TestGetSecondNormal:\n    \"\"\"正常路径测试：len(lst) > 1 时返回 lst[1]。\"\"\"\n\n    def test_get_second_multi_element_list_returns_second(self):\n        \"\"\"规约：len(lst) > 1 时返回 lst[1]。输入 [1, 2, 3]，期望 2。\"\"\"\n        assert get_second([1, 2, 3]) == 2\n\n    def test_get_second_string_elements_returns_second(self):\n        \"\"\"规约：元素类型不限，len(lst) > 1 时返回 lst[1]。输入 ['a','b','c']，期望 'b'。\"\"\"\n        assert get_second([\"a\", \"b\", \"c\"]) == \"b\"\n\n    def test_get_second_nested_list_elements_returns_second(self):\n        \"\"\"边界：元素为嵌套列表。规约：len(lst) > 1 时返回 lst[1]。\"\"\"\n        nested = [[1, 2], [3, 4], [5, 6]]\n        assert get_second(nested) == [3, 4]\n\n\nclass TestGetSecondBoundary:\n    \"\"\"边界路径测试：len(lst) <= 1 时返回 None；len(lst) == 2 时返回 lst[1]。\"\"\"\n\n    def test_get_second_exactly_two_elements_returns_second(self):\n        \"\"\"边界：恰好两元素列表，最小满足 len(lst) > 1 的输入。输入 [10, 20]，期望 20。\"\"\"\n        assert get_second([10, 20]) == 20\n\n    def test_get_second_single_element_list_returns_none(self):\n        \"\"\"边界：单元素列表，len(lst) == 1，规约要求返回 None。\"\"\"\n        assert get_second([42]) is None\n\n    def test_get_second_empty_list_returns_none(self):\n        \"\"\"边界：空列表，len(lst) == 0，规约要求返回 None。\"\"\"\n        assert get_second([]) is None\n\n    def test_get_second_list_of_none_elements_returns_second(self):\n        \"\"\"边界：元素为 None 的列表。规约：len(lst) > 1 时返回 lst[1]，即 None。\"\"\"\n        assert get_second([None, None, None]) is None\n\n    def test_get_second_single_none_element_returns_none(self):\n        \"\"\"边界：单元素且元素为 None，len(lst) == 1，规约要求返回 None。\"\"\"\n        assert get_second([None]) is None\n\n\nclass TestGetSecondPostconditions:\n    \"\"\"以可执行规约子句直接验证后置条件。\"\"\"\n\n    @pytest.mark.parametrize(\n        \"lst\",\n        [\n            [],\n            [1],\n            [\"only\"],\n            [None],\n            [1, 2],\n            [1, 2, 3],\n            [\"a\", \"b\"],\n            [[1], [2], [3]],\n            [None, None],\n        ],\n    )\n    def test_get_second_postcondition_len_gt_one_or_none(self, lst):\n        \"\"\"后置规约：len(lst) > 1 or result is None。\"\"\"\n        result = get_second(lst)\n        assert len(lst) > 1 or result is None\n\n    @pytest.mark.parametrize(\n        \"lst\",\n        [\n            [],\n            [1],\n            [\"only\"],\n            [None],\n            [1, 2],\n            [1, 2, 3],\n            [\"a\", \"b\"],\n            [[1], [2], [3]],\n            [None, None],\n        ],\n    )\n    def test_get_second_postcondition_len_le_one_or_equals_index_one(self, lst):\n        \"\"\"后置规约：len(lst) <= 1 or result == lst[1]。\"\"\"\n        result = get_second(lst)\n        assert len(lst) <= 1 or result == lst[1]\n\n\nclass TestGetSecondTypeContract:\n    \"\"\"类型契约外输入：规约前置条件要求 lst 为 list，非 list 输入行为未定义。\"\"\"\n\n    def test_get_second_none_input_behavior(self):\n        \"\"\"前置条件要求 lst 为 list；None 不满足前置条件。\n\n        期望值来源不明，需人工确认：实现可能抛 TypeError（len(None)）或返回 None。\n        此处仅记录实际行为，不做具体值断言。\n        \"\"\"\n        try:\n            result = get_second(None)\n        except TypeError:\n            # 记录：非 list 输入触发 TypeError，符合前置条件约束\n            return\n        # 若未抛异常，仅记录实际返回值，不臆造期望\n        assert result is None or result is not None\n\n    def test_get_second_string_input_behavior(self):\n        \"\"\"前置条件要求 lst 为 list；字符串不满足前置条件。\n\n        期望值来源不明，需人工确认：字符串支持索引与 len，行为未在规约中定义。\n        此处仅记录实际行为，不做具体值断言。\n        \"\"\"\n        try:\n            result = get_second(\"ab\")\n        except TypeError:\n            return\n        assert result is None or result is not None",
