up(\"delta\")\n    lookup(\"\")\n    lookup(\"Alpha\")\n    after = {k: lookup(k) for k in (\"alpha\", \"beta\", \"gamma\")}\n    assert before == after == {\"alpha\": 1, \"beta\": 2, \"gamma\": 3}\n\n\ndef test_lookup_return_type_is_int_for_all_paths():\n    \"\"\"规约：返回值必为 int（命中与未命中路径均如此）。\n\n    期望值来源：规约后置条件“返回值必为 int”。\n    \"\"\"\n    for key in (\"alpha\", \"beta\", \"gamma\", \"delta\", \"\", \"Alpha\"):\n        result = lookup(key)\n        assert isinstance(result, int)\n        assert not isinstance(result, bool)",
