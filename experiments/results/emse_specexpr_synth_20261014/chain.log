          "generated_test": "import math\n\nimport pytest\n\nfrom task_0025 import rounded_ratio\n\n\ndef test_rounded_ratio_zero_total_returns_zero():\n    \"\"\"total 为 0 时，按实现约定应返回 0.0（来源：函数体显式分支）。\"\"\"\n    assert rounded_ratio(0, 0) == 0.0\n    assert rounded_ratio(5, 0) == 0.0\n    assert rounded_ratio(100, 0) == 0.0\n\n\ndef test_rounded_ratio_full_hit_returns_one():\n    \"\"\"hit == total 时，比值为 1，向下取整到两位小数应为 1.0（来源：函数体计算逻辑）。\"\"\"\n    assert rounded_ratio(1, 1) == 1.0\n    assert rounded_ratio(50, 50) == 1.0\n    assert rounded_ratio(100, 100) == 1.0\n\n\ndef test_rounded_ratio_zero_hit_returns_zero():\n    \"\"\"hit 为 0 且 total 非 0 时，比值 0，结果应为 0.0（来源：函数体计算逻辑）。\"\"\"\n    assert rounded_ratio(0, 1) == 0.0\n    assert rounded_ratio(0, 100) == 0.0\n\n\ndef test_rounded_ratio_floor_behavior():\n    \"\"\"结果应为向下取整到两位小数，而非四舍五入（来源：函数体使用 math.floor）。\"\"\"\n    # 1/3 * 100 = 33.333... -> floor 到两位小数 = 0.33\n    assert rounded_ratio(1, 3) == 0.33\n    # 2/3 * 100 = 66.666... -> floor 到两位小数 = 0.66\n    assert rounded_ratio(2, 3) == 0.66\n    # 1/6 * 100 = 16.666... -> floor 到两位小数 = 0.16\n    assert rounded_ratio(1, 6) == 0.16\n\n\ndef test_rounded_ratio_exact_two_decimals():\n    \"\"\"恰好为两位小数的比值应保持不变（来源：函数体计算逻辑）。\"\"\"\n    # 1/4 * 100 = 25.0 -> 0.25\n    assert rounded_ratio(1, 4) == 0.25\n    # 1/2 * 100 = 50.0 -> 0.5\n    assert rounded_ratio(1, 2) == 0.5\n    # 3/4 * 100 = 75.0 -> 0.75\n    assert rounded_ratio(3, 4) == 0.75\n\n\ndef test_rounded_ratio_returns_float_type():\n    \"\"\"返回值类型应为 float（来源：函数签名类型注解 -> float）。\"\"\"\n    result = rounded_ratio(1, 2)\n    assert isinstance(result, float)\n\n\ndef test_rounded_ratio_result_within_zero_one():\n    \"\"\"当 0 <= hit <= total 时，结果应落在 [0.0, 1.0] 区间内（来源：函数语义约定）。\"\"\"\n    for hit, total in [(0, 10), (1, 10), (5, 10), (9, 10), (10, 10)]:\n        result = rounded_ratio(hit, total)\n        assert 0.0 <= result <= 1.0\n\n\ndef test_rounded_ratio_matches_manual_floor_formula():\n    \"\"\"结果应与手工按 math.floor(hit/total*100)/100 计算一致（来源：函数体实现）。\"\"\"\n    cases = [(1, 7), (3, 8), (7, 9), (13, 17), (99, 100)]\n    for hit, total in cases:\n        expected = math.floor(hit / total * 100) / 100\n        assert rounded_ratio(hit, total) == expected\n\n\ndef test_rounded_ratio_negative_total_returns_zero():\n    \"\"\"total 为负数时，实现未显式处理；期望值来源不明，需人工确认。\n\n    此处仅记录实际行为：按函数体逻辑，total != 0 时会进入计算分支。\n    \"\"\"\n    result = rounded_ratio(1, -2)\n    # 记录实际行为，不臆造具体期望值\n    assert isinstance(result, float)\n\n\ndef test_rounded_ratio_hit_greater_than_total():\n    \"\"\"hit 大于 total 时，实现未显式处理；期望值来源不明，需人工确认。\n\n    此处仅记录实际行为：按函数体逻辑会返回大于 1.0 的值。\n    \"\"\"\n    result = rounded_ratio(3, 2)\n    assert isinstance(result, float)\n    assert result > 1.0",
