"\")\n    assert result == [\"\"]\n    assert len(result) == 1\n\n\ndef test_split_words_single_space_returns_two_empty_strings():\n    \"\"\"边界：单个空格返回 [\"\", \"\"]。\"\"\"\n    assert split_words(\" \") == [\"\", \"\"]\n\n\ndef test_split_words_consecutive_spaces_not_merged():\n    \"\"\"边界：连续空格不合并，产生空串元素。\"\"\"\n    assert split_words(\"a  b\") == [\"a\", \"\", \"b\"]\n\n\ndef test_split_words_leading_trailing_spaces_not_stripped():\n    \"\"\"边界：首尾空格不剥离，产生首尾空串元素。\"\"\"\n    assert split_words(\" a \") == [\"\", \"a\", \"\"]\n\n\ndef test_split_words_non_space_whitespace_not_split():\n    \"\"\"边界：制表符/换行不属于分隔符 \" \"，不分割。\"\"\"\n    assert split_words(\"\\t\\n\") == [\"\\t\\n\"]\n\n\ndef test_split_words_unicode_characters():\n    \"\"\"正常：非 ASCII 字符正常按单空格分割，元素类型为 str。\"\"\"\n    result = split_words(\"你好 世界\")\n    assert result == [\"你好\", \"世界\"]\n    assert all(isinstance(item, str) for item in result)\n\n\ndef test_split_words_long_string_with_many_spaces():\n    \"\"\"边界：多分隔符场景，验证列表长度与顺序。\"\"\"\n    text = \"a b c d e f g h i j\"\n    result = split_words(text)\n    assert result == [\"a\", \"b\", \"c\", \"d\", \"e\", \"f\", \"g\", \"h\", \"i\", \"j\"]\n    assert len(result) == text.count(\" \") + 1\n\n\ndef test_split_words_large_input_linear_length():\n    \"\"\"边界：大量空格时列表长度线性增长（无固定上限）。\"\"\"\n    n = 1000\n    text = \" \" * n\n    result = split_words(text)\n    assert len(result) == n + 1\n    assert all(item == \"\" for item in result)\n    assert \" \".join(result) == text\n\n\n# ---------------------------------------------------------------------------\n# 异常路径：规约声明传入非 str 时抛出 AttributeError 或调用方类型错误\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\n    \"bad_input\",\n    [\n        None,\n        123,\n        [\"a\", \"b\"],\n    ],\n)\ndef test_split_words_non_str_raises(bad_input):\n    \"\"\"异常路径：非 str 输入（None/int/list）应抛出 AttributeError。\n\n    规约说明：传入非 str 时抛出 AttributeError（无 split 属性