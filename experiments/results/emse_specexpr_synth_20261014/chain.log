          "generated_test": "import pytest\n\nfrom task_0019 import lookup\n\n\n# ---------------------------------------------------------------------------\n# 规约常量（来自自然语言规约，非实现细节）\n# ---------------------------------------------------------------------------\n_TABLE_SPEC = {\"alpha\": 1, \"beta\": 2, \"gamma\": 3}\n\n\n# ---------------------------------------------------------------------------\n# 正常路径：命中 _TABLE 的键\n# ---------------------------------------------------------------------------\n@pytest.mark.parametrize(\n    \"key, expected\",\n    [\n        (\"alpha\", 1),\n        (\"beta\", 2),\n        (\"gamma\", 3),\n    ],\n)\ndef test_lookup_existing_keys_return_table_value(key, expected):\n    \"\"\"规约：key 在 _TABLE 中时返回值等于 _TABLE[key]。\n\n    期望值来源：自然语言规约明确给出 _TABLE = {\"alpha\":1,\"beta\":2,\"gamma\":3}。\n    \"\"\"\n    result = lookup(key)\n    assert result == expected\n    assert result == _TABLE_SPEC[key]\n\n\n# ---------------------------------------------------------------------------\n# 正常路径：未命中 _TABLE 的键\n# ---------------------------------------------------------------------------\n@pytest.mark.parametrize(\n    \"key\",\n    [\n        \"delta\",\n        \"\",\n        \"Alpha\",\n        \"ALPHA\",\n        \"Beta\",\n        \"GAMMA\",\n        \"alpha \",\n        \" alpha\",\n    ],\n)\ndef test_lookup_missing_keys_return_zero(key):\n    \"\"\"规约：key 不在 _TABLE 中时返回 0。\n\n    期望值来源：自然语言规约后置条件「key 不在 _TABLE 中时返回 0」。\n    覆盖边界：空字符串、大小写不同（字典键区分大小写）、带空白字符。\n    \"\"\"\n    assert lookup(key) == 0\n\n\ndef test_lookup_long_string_key_returns_zero():\n    \"\"\"规约：超长字符串键未命中，返回 0 且不抛异常。\n\n    期望值来源：自然语言规约边界情况「key 为超长字符串」+ 未命中返回 0。\n    \"\"\"\n    long_key = \"a\" * 1000\n    assert lookup(long_key) == 0\n\n\n# ---------------------------------------------------------------------------\n# 后置条件：返回值类型与取值范围\n# ---------------------------------------------------------------------------\n@pytest.mark.parametrize(\n    \"key\",\n    [\"alpha\", \"beta\", \"gamma\", \"delta\", \"\", \"Alpha\"],\n)\ndef test_lookup_result_is_int_in_range(key):\n    \"\"\"规约后置条件：返回值恒为 int，且 0 <= result <= 3。\n\n    期望值来源：可执行规约子句 isinstance(result, int)、result >= 0、result <= 3。\n    \"\"\"\n    result = lookup(key)\n    assert isinstance(result, int)\n    assert result >= 0\n    assert result <= 3\n\n\n@pytest.mark.parametrize(\n    \"key\",\n    [\"alpha\", \"beta\", \"gamma\", \"delta\", \"\", \"Alpha\", \"zzz\"],\n)\ndef test_lookup_invariant_result_in_allowed_set(key):\n    \"\"\"规约不变量：result == 0 or result in (1, 2, 3)。\n\n    期望值来源：可执行规约子句 result == 0 or result in (1, 2, 3)。\n    \"\"\"\n    result = lookup(key)\n    assert result == 0 or result in (1, 2, 3)\n\n\n# ---------------------------------------------------------------------------\n# 边界：None 作为键\n# ---------------------------------------------------------------------------\ndef test_lookup_none_key_returns_zero():\n    \"\"\"规约边界：key 为 None 时，dict.get 可接受任意可哈希对象，返回 0。\n\n    期望值来源：自然语言规约边界情况「key 为 None（dict.get 可接受任意\n    可哈希对象，返回 0）」。注意：类型注解声明 key 为 str，None 属于类型\n    约定外的输入，此处按规约记录其行为为返回 0。\n    \"\"\"\n    assert lookup(None) == 0\n\n\n# ---------------------------------------------------------------------------\n# 探索性：规约未覆盖的输入行为记录（需人工确认）\n# ---------------------------------------------------------------------------\ndef test_lookup_unhashable_key_behavior_recorded():\n    \"\"\"探索性用例：规约未覆盖不可哈希键（如 list）的行为。\n\n    期望值来源不明，需人工确认：规约仅声明 key 为 str，未规定不可哈希\n    输入的处理方式。此处仅记录实际行为，不做具体值断言。\n    \"\"\"\n    try:\n        result = lookup([\"alpha\"])\n    except TypeError:\n        # 不可哈希输入抛出 TypeError 是可接受的行为之一\n        return\n    # 若未抛异常，则记录实际返回值，仅校验其为 int（与后置条件一致）\n    assert isinstance(result, int)",
