 ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\n    \"full_name\",\n    [\n        \"john doe smith\",\n        \"alice\",\n        \"jOhN dOe\",\n        \"  john   doe  \",\n        \"john\\tdoe\\nsmith\",\n        \"张三 李四\",\n    ],\n)\ndef test_initials_returns_str_type(full_name):\n    \"\"\"后置条件：返回值类型为 str。\n\n    期望值来源：规约后置条件「返回值为 str 类型」。\n    \"\"\"\n    result = initials(full_name)\n    assert isinstance(result, str)\n\n\n@pytest.mark.parametrize(\n    \"full_name\",\n    [\n        \"john doe smith\",\n        \"  john   doe  \",\n        \"john\\tdoe\\nsmith\",\n    ],\n)\ndef test_initials_result_contains_no_whitespace(full_name):\n    \"\"\"后置条件：返回字符串中不包含原始空白字符。\n\n    期望值来源：规约后置条件「返回字符串中不包含原始空白字符」。\n    \"\"\"\n    result = initials(full_name)\n    assert not any(ch.isspace() for ch in result)\n\n\n# ---------------------------------------------------------------------------\n# None 输入：规约未约定处理方式\n# ---------------------------------------------------------------------------\n\ndef test_initials_none_input_behavior():\n    \"\"\"None 输入：规约前置条件允许传入 None，但未约定其处理方式。\n\n    期望值来源不明，需人工确认。\n    规约仅声明「调用方传入 str 或 None」，未说明 None 的返回或异常行为，\n    因此本用例记录实际行为，不做具体值断言，避免臆造实现细节。\n    \"\"\"\n    try:\n        result = initials(None)\n    except Exception as exc:  # noqa: BLE001 - 记录实际抛出的异常类型\n        # 记录实际行为：抛出异常（类型需人工确认是否符合预期）\n        assert exc is not None\n    else:\n        # 记录实际行为：返回了某个值（类型需人工确认是否符合预期）\n        assert isinstance(result, str)",
