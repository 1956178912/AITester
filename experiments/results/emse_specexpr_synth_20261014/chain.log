          "generated_test": "import datetime\n\nimport pytest\n\nfrom task_0001 import days_until\n\n\ndef test_days_until_future_date_returns_positive_int():\n    \"\"\"合法且远在未来的日期，应返回正 int。\n\n    期望值来源：规约「合法日期且在未来时返回值 >= 0」+「返回值为 int 类型」。\n    具体天数依赖当前时间，故只断言类型与符号。\n    \"\"\"\n    result = days_until(\"2999-12-31\")\n    assert isinstance(result, int)\n    assert result > 0\n\n\ndef test_days_until_past_date_returns_negative_int():\n    \"\"\"合法且已过去的日期，应返回负 int。\n\n    期望值来源：规约「合法日期且已过去时返回值 < 0」+「返回值为 int 类型」。\n    \"\"\"\n    result = days_until(\"2000-01-01\")\n    assert isinstance(result, int)\n    assert result < 0\n\n\ndef test_days_until_today_returns_zero_or_minus_one():\n    \"\"\"传入当天日期字符串，days 取决于当前时刻，应为 0 或 -1。\n\n    期望值来源：规约边界情况「target 为今天日期（days 可能为 0 或 -1，\n    取决于当前时刻）」。为避免跨零点竞态，允许 0 与 -1 两种取值。\n    \"\"\"\n    today = datetime.datetime.now().strftime(\"%Y-%m-%d\")\n    result = days_until(today)\n    assert isinstance(result, int)\n    assert result in (0, -1)\n\n\ndef test_days_until_datetime_min_date_returns_negative():\n    \"\"\"合法但等于 datetime.min 的日期，应返回极大负值。\n\n    期望值来源：规约边界情况「target 为合法但极端日期如 \"0001-01-01\"\n    （等于 datetime.min）」+「合法日期且已过去时返回值 < 0」。\n    具体数值依赖当前时间，故只断言符号。\n    \"\"\"\n    result = days_until(\"0001-01-01\")\n    assert isinstance(result, int)\n    assert result < 0\n\n\ndef test_days_until_datetime_max_date_returns_positive():\n    \"\"\"合法但等于 datetime.max 的日期，应返回极大正值。\n\n    期望值来源：规约边界情况「target 为 \"9999-12-31\"（datetime 最大值）」\n    +「合法日期且在未来时返回值 >= 0」。\n    \"\"\"\n    result = days_until(\"9999-12-31\")\n    assert isinstance(result, int)\n    assert result > 0\n\n\ndef test_days_until_leap_year_date_returns_int():\n    \"\"\"合法闰年日期 \"2024-02-29\" 应正常解析并返回 int。\n\n    期望值来源：规约边界情况「target 为闰年日期 \"2024-02-29\"」+\n    「返回值为 int 类型」。具体天数依赖当前时间，故只断言类型。\n    \"\"\"\n    result = days_until(\"2024-02-29\")\n    assert isinstance(result, int)\n\n\ndef test_days_until_invalid_leap_day_returns_negative():\n    \"\"\"非闰年 2 月 29