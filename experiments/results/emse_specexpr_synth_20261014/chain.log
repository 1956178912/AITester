          "generated_test": "import pytest\n\nfrom task_0011 import distance\n\n\n# ---------------------------------------------------------------------------\n# 正常路径（normal）\n# ---------------------------------------------------------------------------\n\ndef test_distance_positive_integers():\n    \"\"\"规约后置条件：返回值严格等于 a - b（常规正整数）。\"\"\"\n    assert distance(10, 3) == 7\n\n\n# ---------------------------------------------------------------------------\n# 边界情况（boundary）\n# ---------------------------------------------------------------------------\n\ndef test_distance_equal_operands_returns_zero():\n    \"\"\"边界情况：a == b 时结果为 0。\"\"\"\n    assert distance(5, 5) == 0\n\n\ndef test_distance_a_is_zero():\n    \"\"\"边界情况：a 为 0 时返回 -b。\"\"\"\n    assert distance(0, 7) == -7\n\n\ndef test_distance_b_is_zero():\n    \"\"\"边界情况：b 为 0 时返回 a。\"\"\"\n    assert distance(7, 0) == 7\n\n\ndef test_distance_a_negative():\n    \"\"\"边界情况：a 为负数时的结果等于 a - b。\"\"\"\n    assert distance(-4, 6) == -10\n\n\ndef test_distance_b_negative():\n    \"\"\"边界情况：b 为负数时等价于 a + |b|。\"\"\"\n    assert distance(4, -6) == 10\n\n\ndef test_distance_both_negative():\n    \"\"\"边界情况：a 与 b 均为负数时的结果等于 a - b。\"\"\"\n    assert distance(-4, -6) == 2\n\n\ndef test_distance_large_int_boundaries():\n    \"\"\"边界情况：a 为 2**63-1、b 为 -2**63，Python 无溢出，结果为大整数。\"\"\"\n    a = 2 ** 63 - 1\n    b = -(2 ** 63)\n    assert distance(a, b) == a - b\n    assert distance(a, b) == 18446744073709551615\n\n\ndef test_distance_opposite_signs_no_overflow():\n    \"\"\"边界情况：符号相反导致结果超出常规 64 位范围，Python 无溢出。\"\"\"\n    a = 2 ** 100\n    b = -(2 ** 100)\n    assert distance(a, b) == 2 ** 101\n\n\n# ---------------------------------------------------------------------------\n# 不变量 / 无副作用\n# ---------------------------------------------------------------------------\n\ndef test_distance_does_not_mutate_arguments():\n    \"\"\"后置条件：函数无副作用，不修改入参（int 不可变，验证调用后取值不变）。\"\"\"\n    a = 123\n    b = 456\n    a_before, b_before = a, b\n    distance(a, b)\n    assert a == a_before\n    assert b == b_before\n\n\n@pytest.mark.parametrize(\n    \"a, b\",\n    [\n        (0, 0),\n        (1, -1),\n        (-1, 1),\n        (100, 100),\n        (-100, -100),\n        (2 ** 63 - 1, 1),\n        (-(2 ** 63), -1),\n    ],\n)\ndef test_distance_matches_subtraction_invariant(a, b):\n    \"\"\"后置条件不变量：对任意满足前件的 int 输入，返回值等于 a - b。\"\"\"\n    assert distance(a, b) == a - b\n\n\n# ---------------------------------------------------------------------------\n# 类型契约违反路径（error）\n# ---------------------------------------------------------------------------\n\ndef test_distance_float_inputs_follows_python_subtraction():\n    \"\"\"类型契约违反：类型注解声明为 int，传入 float 时 Python 不报错。\n\n    期望值来源：规约未覆盖 float 行为，此处仅记录实际行为（a - b 的\n    Python 运算结果），需人工确认是否符合预期。\n    \"\"\"\n    result = distance(1.5, 0.5)\n    assert result == 1.5 - 0.5\n\n\ndef test_distance_str_input_raises_type_error():\n    \"\"\"类型契约违反：str 与 int 相减应抛出 TypeError。\"\"\"\n    with pytest.raises(TypeError):\n        distance(\"10\", 3)\n\n\ndef test_distance_none_input_raises_type_error():\n    \"\"\"类型契约违反：None 与 int 相减应抛出 TypeError。\"\"\"\n    with pytest.raises(TypeError):\n        distance(None, 3)",
