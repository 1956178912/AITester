cess(items)\n    assert result is not items\n\n\ndef test_process_string_elements_raises_type_error():\n    \"\"\"process 对字符串元素应抛出 TypeError（str + int 不支持）。\n\n    期望值来源：Python 中 str + int 会抛出 TypeError。\n    \"\"\"\n    with pytest.raises(TypeError):\n        process([\"a\", \"b\"])\n\n\ndef test_process_none_input_raises_type_error():\n    \"\"\"process 对 None 输入应抛出 TypeError（None 不可迭代）。\n\n    期望值来源：Python 中迭代 None 会抛出 TypeError。\n    \"\"\"\n    with pytest.raises(TypeError):\n        process(None)",
