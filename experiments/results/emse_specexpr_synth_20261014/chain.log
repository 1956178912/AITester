          "generated_test": "import pytest\n\nfrom task_0066 import clamp\n\n\ndef test_clamp_returns_high_when_value_below_high():\n    \"\"\"当 value < high 时，函数返回 high。\n\n    期望值来源：函数体第一条分支 `if value < high: return high`。\n    \"\"\"\n    assert clamp(1, 0, 10) == 10\n\n\ndef test_clamp_returns_low_when_value_above_low():\n    \"\"\"当 value >= high 且 value > low 时，函数返回 low。\n\n    期望值来源：函数体第二条分支 `if value > low: return low`。\n    \"\"\"\n    assert clamp(5, 0, 3) == 0\n\n\ndef test_clamp_returns_value_when_not_above_low():\n    \"\"\"当 value >= high 且 value <= low 时，函数返回 value 本身。\n\n    期望值来源：函数体最后 `return value`。\n    \"\"\"\n    assert clamp(-1, 0, -5) == -1\n\n\ndef test_clamp_value_equal_to_high_goes_to_second_branch():\n    \"\"\"value == high 时不满足 value < high，进入后续分支。\n\n    期望值来源：严格小于比较 `value < high`。\n    \"\"\"\n    assert clamp(10, 0, 10) == 0\n\n\ndef test_clamp_value_equal_to_low_returns_value():\n    \"\"\"value == low 时不满足 value > low，返回 value 本身。\n\n    期望值来源：严格大于比较 `value > low`。\n    \"\"\"\n    assert clamp(0, 0, -1) == 0\n\n\ndef test_clamp_typical_positive_range():\n    \"\"\"典型正数区间：value 小于 high 时返回 high。\n\n    期望值来源：函数体第一条分支。\n    \"\"\"\n    assert clamp(3, 1, 5) == 5\n\n\ndef test_clamp_negative_values():\n    \"\"\"负数输入下 value < high 时返回 high。\n\n    期望值来源：函数体第一条分支。\n    \"\"\"\n    assert clamp(-10, -5, -1) == -1\n\n\ndef test_clamp_zero_boundaries():\n    \"\"\"全零输入：value == high 且 value == low，返回 value。\n\n    期望值来源：函数体最后 `return value`。\n    \"\"\"\n    assert clamp(0, 0, 0) == 0\n\n\ndef test_clamp_large_values():\n    \"\"\"大整数输入下 value < high 时返回 high。\n\n    期望值来源：函数体第一条分支。\n    \"\"\"\n    assert clamp(10**18, 0, 10**19) == 10**19\n\n\ndef test_clamp_returns_int_type():\n    \"\"\"返回值类型应为 int。\n\n    期望值来源：函数签名 `-> int`。\n    \"\"\"\n    result = clamp(1, 0, 10)\n    assert isinstance(result, int)\n\n\n@pytest.mark.parametrize(\n    \"value, low, high, expected\",\n    [\n        (1, 0, 10, 10),\n        (5, 0, 3, 0),\n       