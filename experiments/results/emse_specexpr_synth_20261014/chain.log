          "generated_test": "import pytest\n\nfrom task_0025 import compute_scores\n\n\n# ---------------------------------------------------------------------------\n# 正常路径\n# ---------------------------------------------------------------------------\n\ndef test_compute_scores_normal_multiple_records():\n    \"\"\"正常多记录：按 name/value 构建字典。\n\n    期望值来源：规约「每个键来自 record.get(\"name\", \"unknown\")」、\n    「每个值来自 record.get(\"value\", 0)」。\n    \"\"\"\n    records = [\n        {\"name\": \"a\", \"value\": 1},\n        {\"name\": \"b\", \"value\": 2},\n    ]\n    result = compute_scores(records)\n    assert result == {\"a\": 1, \"b\": 2}\n\n\ndef test_compute_scores_returns_dict_type():\n    \"\"\"后置条件：返回值类型为 dict。\"\"\"\n    result = compute_scores([{\"name\": \"a\", \"value\": 1}])\n    assert isinstance(result, dict)\n\n\ndef test_compute_scores_length_not_exceed_input():\n    \"\"\"后置条件：返回字典长度 <= 输入记录条数。\"\"\"\n    records = [\n        {\"name\": \"a\", \"value\": 1},\n        {\"name\": \"b\", \"value\": 2},\n        {\"name\": \"c\", \"value\": 3},\n    ]\n    result = compute_scores(records)\n    assert len(result) <= len(records)\n\n\ndef test_compute_scores_keys_are_str_invariant():\n    \"\"\"不变量：所有键均为 str 类型。\"\"\"\n    records = [\n        {\"name\": \"a\", \"value\": 1},\n        {\"value\": 2},\n        {\"name\": \"c\"},\n    ]\n    result = compute_scores(records)\n    assert all(isinstance(k, str) for k in result)\n\n\n# ---------------------------------------------------------------------------\n# 边界路径\n# ---------------------------------------------------------------------------\n\ndef test_compute_scores_empty_list_returns_empty_dict():\n    \"\"\"边界：空列表返回 {}。\n\n    期望值来源：规约「空列表 records=[] 返回 {}」。\n    \"\"\"\n    result = compute_scores([])\n    assert result == {}\n\n\ndef test_compute_scores_missing_name_defaults_unknown():\n    \"\"\"边界：记录缺少 name 键时键为 \"unknown\"。\n\n    期望值来源：规约「记录缺少 name 键时键为 \"unknown\"」。\n    \"\"\"\n    records = [{\"value\"