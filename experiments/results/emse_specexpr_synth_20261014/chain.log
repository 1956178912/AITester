ma\", \"delta\", \"\", \"Alpha\", \"a\" * 1000],\n)\ndef test_lookup_result_non_negative(key):\n    \"\"\"返回值必须 >= 0。\n\n    期望值来源：规约后置条件 \"result >= 0\"。\n    \"\"\"\n    result = lookup(key)\n    assert result >= 0\n\n\n@pytest.mark.parametrize(\n    \"key\",\n    [\"alpha\", \"beta\", \"gamma\", \"delta\", \"\", \"Alpha\", \"a\" * 1000],\n)\ndef test_lookup_result_in_invariant_set(key):\n    \"\"\"返回值必须落在不变量集合 (0, 1, 2, 3) 中。\n\n    期望值来源：规约不变量 \"result in (0, 1, 2, 3)\"。\n    \"\"\"\n    result = lookup(key)\n    assert result in (0, 1, 2, 3)",
