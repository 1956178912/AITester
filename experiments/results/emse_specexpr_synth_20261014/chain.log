          "generated_test": "import pytest\n\nfrom task_0037 import initials\n\n\n# ---------------------------------------------------------------------------\n# 正常路径\n# ---------------------------------------------------------------------------\n\ndef test_initials_multi_part_name():\n    \"\"\"多段名字：每段取首字母大写并以 '.' 连接。\n\n    期望值来源：规约后置条件「每个输出段为对应输入段首字符的大写形式」。\n    \"\"\"\n    assert initials(\"john ronald reuel tolkien\") == \"J.R.R.T\"\n\n\ndef test_initials_two_part_name():\n    \"\"\"两段名字：输出格式为 'A.L'。\n\n    期望值来源：规约后置条件「每个输出段为对应输入段首字符的大写形式」。\n    \"\"\"\n    assert initials(\"ada lovelace\") == \"A.L\"\n\n\ndef test_initials_single_part_name():\n    \"\"\"单段名字：只返回一个大写首字母。\n\n    期望值来源：规约后置条件「每个输出段为对应输入段首字符的大写形式」。\n    \"\"\"\n    assert initials(\"madonna\") == \"M\"\n\n\n# ---------------------------------------------------------------------------\n# 边界情况\n# ---------------------------------------------------------------------------\n\ndef test_initials_empty_string():\n    \"\"\"空字符串：split 后无段，返回空串。\n\n    期望值来源：规约边界情况「full_name 为空字符串 ''」。\n    \"\"\"\n    assert initials(\"\") == \"\"\n\n\ndef test_initials_whitespace_only():\n    \"\"\"纯空白字符串：无有效段，返回空串。\n\n    期望值来源：规约边界情况「full_name 为纯空白 '   '」。\n    \"\"\"\n    assert initials(\"   \") == \"\"\n\n\ndef test_initials_multiple_consecutive_spaces():\n    \"\"\"多个连续空格：按任意空白分割并忽略连续空白。\n\n    期望值来源：规约边界情况「full_name 含多个连续空格」。\n    \"\"\"\n    assert initials(\"john    doe\") == \"J.D\"\n\n\ndef test_initials_tabs_and_newlines():\n    \"\"\"含制表符与换行：按任意空白分割。\n\n    期望值来源：规约边界情况「full_name 含制表符/换行等空白」。\n    \"\"\"\n    assert initials(\"john\\tdoe\\nsmith\") == \"J.D.S\"\n\n\ndef test_initials_leading_non_letter():\n    \"\"\"首字符为非字母（数字）：upper 不改变数字。\n\n    期望值来源：规约边界情况「full_name 首字符为非字母（如数字、标点）」，\n    后置条件「每个输出段为对应输入段首字符的大写形式」。\n    \"\"\"\n    assert initials(\"3rd rock\") == \"3.R\"\n\n\n# ---------------------------------------------------------------------------\n# 后置条件 / 不变量\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\n    \"full_name\",\n    [\n        \"john ronald reuel tolkien\",\n        \"ada lovelace\",\n        \"madonna\",\n        \"john    doe\",\n        \"john\\tdoe\\nsmith\",\n        \"3rd rock\",\n    ],\n)\ndef test_initials_returns_str(full_name):\n    \"\"\"后置条件：返回值类型为 str。\n\n    期望值来源：规约后置条件「返回值为 str」。\n    \"\"\"\n    result = initials(full_name)\n    assert isinstance(result, str)\n\n\n@pytest.mark.parametrize(\n    \"full_name\",\n    [\n        \"john ronald reuel tolkien\",\n        \"ada lovelace\",\n        \"madonna\",\n        \"john    doe\",\n        \"john\\tdoe\\nsmith\",\n        \"3rd rock\",\n    ],\n)\ndef test_initials_result_contains_no_whitespace(full_name):\n    \"\"\"后置条件：返回值中不包含空白字符。\n\n    期望值来源：规约后置条件「返回值中不包含空白字符」。\n    \"\"\"\n    result = initials(full_name)\n    assert not any(ch.isspace() for ch in result)\n\n\n# ---------------------------------------------------------------------------\n# 异常路径\n# ---------------------------------------------------------------------------\n\ndef test_initials_none_raises_attribute_error():\n    \"\"\"None 输入：无 split 方法，触发 AttributeError。\n\n    期望值来源：规约边界情况「full_name 为 None（会触发 AttributeError）」。\n    \"\"\"\n    with pytest.raises(AttributeError):\n        initials(None)",
