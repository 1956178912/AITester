          "generated_test": "import pytest\n\nfrom task_0011 import fibonacci\n\n\n# ---------------------------------------------------------------------------\n# 边界用例：n <= 0 分支\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\"n\", [0, -1, -5, -100])\ndef test_fibonacci_n_non_positive_returns_one(n):\n    \"\"\"规约：n<=0 时返回 1。期望值来源：自然语言规约后置条件。\"\"\"\n    assert fibonacci(n) == 1\n\n\n# ---------------------------------------------------------------------------\n# 边界用例：n == 1 分支\n# ---------------------------------------------------------------------------\n\ndef test_fibonacci_n_equals_one_returns_one():\n    \"\"\"规约：n==1 时返回 1。期望值来源：自然语言规约后置条件。\"\"\"\n    assert fibonacci(1) == 1\n\n\n# ---------------------------------------------------------------------------\n# 递归分支：n >= 2\n# ---------------------------------------------------------------------------\n\ndef test_fibonacci_n_equals_two_returns_two():\n    \"\"\"规约：n>=2 时返回 fibonacci(n-1)+fibonacci(n-2)。\n    n=2 -> fibonacci(1)+fibonacci(0) = 1+1 = 2。\n    期望值来源：规约后置条件推导。\"\"\"\n    assert fibonacci(2) == 2\n\n\ndef test_fibonacci_n_equals_three_returns_three():\n    \"\"\"n=3 -> fibonacci(2)+fibonacci(1) = 2+1 = 3。\n    期望值来源：规约后置条件推导。\"\"\"\n    assert fibonacci(3) == 3\n\n\ndef test_fibonacci_n_equals_five_returns_eight():\n    \"\"\"n=5 -> 8。期望值来源：规约后置条件推导。\"\"\"\n    assert fibonacci(5) == 8\n\n\ndef test_fibonacci_n_equals_ten_returns_eighty_nine():\n    \"\"\"n=10 -> 89。期望值来源：规约后置条件推导。\"\"\"\n    assert fibonacci(10) == 89\n\n\n# ---------------------------------------------------------------------------\n# 不变量：递归关系对任意 n>=2 成立\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\"n\", [2, 3, 4, 5, 6, 7, 8])\ndef test_fibonacci_recursive_relation_holds(n):\n    \"\"\"规约不变量：对 n>=2，fibonacci(n) == fibonacci(n-1) + fibonacci(n-2)。\n    期望值来源：规约后置条件（递归关系本身）。\"\"\"\n    assert fibonacci(n) == fibonacci(n - 1) + fibonacci(n - 2)\n\n\n# ---------------------------------------------------------------------------\n# 前置条件：n 必须为 int；非 int 输入行为规约未约定\n# ---------------------------------------------------------------------------\n\ndef test_fibonacci_with_float_input_behavior_unknown():\n    \"\"\"前置条件要求 n 为 int；传入 float 时规约未约定行为。\n    期望值来源不明，需人工确认：此处仅记录实际行为，不做具体值断言，\n    只要求调用要么返回 int，要么抛出异常，不得静默产生非预期类型。\"\"\"\n    try:\n        result = fibonacci(1.5)\n    except Exception:\n        # 规约未约定异常类型，任何异常均可接受\n        return\n    # 若未抛异常，则记录实际返回值类型，供人工确认\n    assert isinstance(result, int), (\n        f\"规约未约定 float 输入行为，实际返回类型为 {type(result)}，需人工确认\"\n    )\n\n\ndef test_fibonacci_with_none_input_behavior_unknown():\n    \"\"\"前置条件要求 n 为 int；传入 None 时规约未约定行为。\n    期望值来源不明，需人工确认：此处仅记录实际行为，不做具体值断言。\"\"\"\n    try:\n        result = fibonacci(None)\n    except Exception:\n        # 规约未约定异常类型，任何异常均可接受\n        return\n    assert isinstance(result, int), (\n        f\"规约未约定 None 输入行为，实际返回类型为 {type(result)}，需人工确认\"\n    )\n\n\n# ---------------------------------------------------------------------------\n# 大 n：递归深度 / 性能问题（规约提示的边界情况）\n# ---------------------------------------------------------------------------\n\ndef test_fibonacci_large_n_does_not_crash():\n    \"\"\"规约提示 n 很大时存在递归深度/性能问题。\n    期望值来源不明，需人工确认：此处仅验证在合理规模下调用能返回 int，\n    不臆造具体数值。\"\"\"\n    result = fibonacci(20)\n    assert isinstance(result, int)\n    # 与递归关系一致（规约不变量）\n    assert result == fibonacci(19) + fibonacci(18)",
