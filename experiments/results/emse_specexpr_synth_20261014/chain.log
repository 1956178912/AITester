          "generated_test": "import pytest\n\nfrom task_0066 import clamp\n\n\nclass TestClampNormal:\n    \"\"\"正常路径测试：覆盖规约中的后置条件分支。\"\"\"\n\n    def test_clamp_value_less_than_high_returns_high(self):\n        \"\"\"规约：若 value < high 成立，返回 high。\n\n        期望值来源：规约后置条件 1。\n        \"\"\"\n        assert clamp(value=1, low=0, high=10) == 10\n\n    def test_clamp_value_greater_than_low_returns_low(self):\n        \"\"\"规约：value < high 为假且 value > low 为真时，返回 low。\n\n        期望值来源：规约后置条件 2。\n        \"\"\"\n        assert clamp(value=20, low=0, high=10) == 0\n\n    def test_clamp_value_between_low_and_high_returns_high(self):\n        \"\"\"规约：value 同时小于 high 且大于 low 时，第一个分支优先命中，返回 high。\n\n        期望值来源：规约后置条件 1（value < high 成立）。\n        \"\"\"\n        assert clamp(value=5, low=0, high=10) == 10\n\n\nclass TestClampBoundary:\n    \"\"\"边界路径测试：覆盖规约列出的边界情况。\"\"\"\n\n    def test_clamp_value_equals_high_returns_low(self):\n        \"\"\"规约：value == high 时 value < high 为假，若 value > low 则返回 low。\n\n        期望值来源：规约后置条件 2。\n        \"\"\"\n        assert clamp(value=10, low=0, high=10) == 0\n\n    def test_clamp_value_equals_low_returns_high(self):\n        \"\"\"规约：value == low 时 value < high 成立，返回 high。\n\n        期望值来源：规约后置条件 1。\n        \"\"\"\n        assert clamp(value=0, low=0, high=10) == 10\n\n    def test_clamp_value_equals_low_and_high_returns_value(self):\n        \"\"\"规约：value == low == high 时两个分支均为假，返回 value。\n\n        期望值来源：规约后置条件 3。\n        \"\"\"\n        assert clamp(value=5, low=5, high=5) == 5\n\n    def test_clamp_all_zero_returns_value(self):\n        \"\"\"规约：全零输入时 value < high 为假、value > low 为假，返回 value。\n\n        期望值来源：规约后置条件 3。\n        \"\"\"\n        assert clamp(value=0, low=0, high=0) == 0\n\n    def test_clamp_negative_values_returns_high(self):\n        \"\"\"规约：负数输入且 value < high 成立时返回 high。\n\n        期望值来源：规约后置条件 1。\n        \"\"\"\n        assert clamp(value=-5, low=-10, high=-1) == -1\n\n    def test_clamp_large_integer_returns_high(self):\n        \"\"\"规约：接近 int 上限的输入且 value < high 成立时返回 high。\n\n        期望值来源：规约后置条件 1。\n        \"\"\"\n        assert clamp(\n            value=9223372036854775806,\n            low=0,\n            high=9223372036854775807,\n        ) == 9223372036854775807\n\n\nclass TestClampAbnormalInterval:\n    \"\"\"异常区间测试：low > high 时按规约分支判定。\"\"\"\n\n    def test_clamp_low_greater_than_high_returns_value(self):\n        \"\"\"规约：low > high 时，value < high 为假、value > low 为假，返回 value。\n\n        期望值来源：规约后置条件 3（两个条件均不成立）。\n        注：该结果与常规 clamp 语义不符，但规约明确以分支判定为准。\n        \"\"\"\n        assert clamp(value=5, low=10, high=0) == 5\n\n\nclass TestClampReturnDomain:\n    \"\"\"返回值域测试：返回值必须是 value、low、high 之一。\"\"\"\n\n    @pytest.mark.parametrize(\n        \"value, low, high\",\n        [\n            (1, 0, 10),\n            (20, 0, 10),\n            (10, 0, 10),\n            (0, 0, 10),\n            (5, 5, 5),\n            (0, 0, 0),\n            (-5, -10, -1),\n            (5, 10, 0),\n            (9223372036854775806, 0, 9223372036854775807),\n        ],\n    )\n    def test_clamp_return_value_in_input_domain(self, value, low, high):\n        \"\"\"规约：返回值取值为 value、low 或 high 之一。\n\n        期望值来源：规约输出域描述。\n        \"\"\"\n        result = clamp(value=value, low=low, high=high)\n        assert result in (value, low, high)\n\n    @pytest.mark.parametrize(\n        \"value, low, high\",\n        [\n            (1, 0, 10),\n            (20, 0, 10),\n            (10, 0, 10),\n            (0, 0, 10),\n            (5, 5, 5),\n            (0, 0, 0),\n            (-5, -10, -1),\n            (5, 10, 0),\n            (9223372036854775806, 0, 9223372036854775807),\n        ],\n    )\n    def test_clamp_return_type_is_int(self, value, low, high):\n        \"\"\"规约：返回值为 int 类型。\n\n        期望值来源：函数签名返回类型注解。\n        \"\"\"\n        result = clamp(value=value, low=low, high=high)\n        assert isinstance(result, int)",
