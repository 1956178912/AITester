          "generated_test": "import datetime\n\nimport pytest\n\nfrom task_0064 import days_until\n\n\ndef test_days_until_future_date_returns_positive_int():\n    \"\"\"合法未来日期应返回正整数天数。\n\n    期望值来源：规约后置条件“合法未来日期返回值 > 0”与“返回值为 int”。\n    具体数值依赖当前时间，不做精确断言。\n    \"\"\"\n    result = days_until(\"2999-12-31\")\n    assert isinstance(result, int)\n    assert result > 0\n\n\ndef test_days_until_past_date_returns_negative_int():\n    \"\"\"合法过去日期应返回负整数天数。\n\n    期望值来源：规约后置条件“合法过去日期返回值 < 0”与“返回值为 int”。\n    具体数值依赖当前时间，不做精确断言。\n    \"\"\"\n    result = days_until(\"1970-01-01\")\n    assert isinstance(result, int)\n    assert result < 0\n\n\ndef test_days_until_today_returns_int_near_zero():\n    \"\"\"传入当天日期，结果取决于当前时刻，可能为 0 或 -1。\n\n    期望值来源：规约边界情况“target 为当天日期（结果取决于当前时刻，\n    可能为 0 或 -1）”。仅断言类型与接近 0 的范围。\n    \"\"\"\n    today = datetime.datetime.now().strftime(\"%Y-%m-%d\")\n    result = days_until(today)\n    assert isinstance(result, int)\n    assert result in (0, -1)\n\n\ndef test_days_until_min_date_returns_large_negative_int():\n    \"\"\"datetime.min 对应日期应返回极大负整数。\n\n    期望值来源：规约边界情况“target 为合法但极端日期如 '0001-01-01'\n    （datetime.min）”。具体数值依赖当前时间，仅断言为负且量级很大。\n    \"\"\"\n    result = days_until(\"0001-01-01\")\n    assert isinstance(result, int)\n    assert result < 0\n    # datetime.min 与 now 的差约为 -739000 量级\n    assert result < -700000\n\n\ndef test_days_until_max_date_returns_large_positive_int():\n    \"\"\"datetime.max 对应日期应返回极大正整数。\n\n    期望值来源：规约边界情况“target 为 '9999-12-31'（datetime.max）”。\n    具体数值依赖当前时间，仅断言为正且量级很大。\n    \"\"\"\n    result = days_until(\"9999-12-31\")\n    assert isinstance(result, int)\n    assert result > 0\n    # datetime.max 与 now 的差约为 2900000 量级\n    assert result > 2000000\n\n\ndef test_days_until_empty_string_returns_large_negative_int():\n    \"\"\"空字符串无法解析，应走异常路径返回大负数。\n\n    期望值来源：规约后置条件“非法日期返回一个很大的负整数\n    （datetime.min 与 now 的差）”。具体数值依赖当前时间。\n    \"\"\"\n    result = days_until(\"\")\n    assert isinstance(result, int)\n    assert