          "generated_test": "import pytest\n\nfrom task_0057 import lookup\n\n\n# 规约中明确给出的 _TABLE 内容（用于校验不变量与命中期望值）\n_EXPECTED_TABLE = {\"alpha\": 1, \"beta\": 2, \"gamma\": 3}\n\n\ndef test_lookup_hit_alpha_returns_1():\n    \"\"\"规约：key 存在时返回 _TABLE[key]；'alpha' -> 1。\"\"\"\n    assert lookup(\"alpha\") == 1\n\n\ndef test_lookup_hit_beta_returns_2():\n    \"\"\"规约：key 存在时返回 _TABLE[key]；'beta' -> 2。\"\"\"\n    assert lookup(\"beta\") == 2\n\n\ndef test_lookup_hit_gamma_returns_3():\n    \"\"\"规约：key 存在时返回 _TABLE[key]；'gamma' -> 3。\"\"\"\n    assert lookup(\"gamma\") == 3\n\n\n@pytest.mark.parametrize(\"key\", [\"alpha\", \"beta\", \"gamma\"])\ndef test_lookup_hit_matches_table_value(key):\n    \"\"\"规约：命中时返回值等于 _TABLE[key]（期望值来源：规约给出的 _TABLE）。\"\"\"\n    assert lookup(key) == _EXPECTED_TABLE[key]\n\n\ndef test_lookup_miss_unknown_key_returns_0():\n    \"\"\"规约：key 不存在时返回 0；'delta' 未在 _TABLE 中。\"\"\"\n    assert lookup(\"delta\") == 0\n\n\ndef test_lookup_boundary_empty_string_returns_0():\n    \"\"\"边界：空字符串 key='' 未命中，规约规定返回 0。\"\"\"\n    assert lookup(\"\") == 0\n\n\ndef test_lookup_boundary_case_sensitive_returns_0():\n    \"\"\"边界：键区分大小写，'Alpha' 未命中，规约规定返回 0。\"\"\"\n    assert lookup(\"Alpha\") == 0\n\n\ndef test_lookup_boundary_whitespace_returns_0():\n    \"\"\"边界：仅含空格的 key=' ' 未命中，规约规定返回 0。\"\"\"\n    assert lookup(\" \") == 0\n\n\ndef test_lookup_boundary_very_long_string_returns_0():\n    \"\"\"边界：超长字符串未命中，规约规定返回 0 且不抛异常。\"\"\"\n    long_key = \"a\" * 2000\n    assert lookup(long_key) == 0\n\n\ndef test_lookup_does_not_modify_table():\n    \"\"\"后置条件：函数不修改 _TABLE；多次调用后命中/未命中结果保持一致。\"\"\"\n    before = {k: lookup(k) for k in _EXPECTED_TABLE}\n    lookup(\"delta\")\n    lookup(\"\")\n    lookup(\"Alpha\")\n    after = {k: lookup(k) for k in _EXPECTED_TABLE}\n    assert before == after == _EXPECTED_TABLE\n\n\ndef test_lookup_none_input_behavior():\n    \"\"\"边界：None 为非 str 输入，类型注解外。\n\n    期望值来源不明，需人工确认：规约仅说明\"行为由 dict.get 决定\"，\n    未约定是否允许非 str 输入。此处记录实际行为，不