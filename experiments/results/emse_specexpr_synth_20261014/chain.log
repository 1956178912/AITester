e(\n    \"name\",\n    [\n        \"user name\",\n        \"user_name\",\n        \"user-name\",\n        \"user!\",\n    ],\n)\ndef test_is_valid_username_non_alnum_returns_true(name):\n    \"\"\"规约：含空格/下划线/连字符/标点等非字母数字字符 -> 返回 True（无效）。\n\n    期望值来源：自然语言规约边界情况。\n    \"\"\"\n    assert is_valid_username(name) is True\n\n\n# ---------------------------------------------------------------------------\n# 错误用例：超长 -> 返回 True（无效）\n# ---------------------------------------------------------------------------\n\ndef test_is_valid_username_too_long_alnum_returns_true():\n    \"\"\"规约：长度 26 的纯字母字符串 -> len>20 -> 返回 True（无效）。\n\n    期望值来源：自然语言规约后置条件与边界情况。\n    \"\"\"\n    name = \"abcdefghijklmnopqrstuvwxyz\"\n    assert len(name) == 26\n    assert is_valid_username(name) is True\n\n\ndef test_is_valid_username_too_long_with_special_chars_returns_true():\n    \"\"\"规约：同时违反 isalnum 与长度限制 -> 返回 True（无效）。\n\n    期望值来源：自然语言规约后置条件（否则返回 True）。\n    \"\"\"\n    name = \"user name user name user name\"\n    assert is_valid_username(name) is True\n\n\n# ---------------------------------------------------------------------------\n# 返回值类型不变量\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\n    \"name\",\n    [\n        \"alice\",\n        \"\",\n        \"user name\",\n        \"a2345678901234567890\",\n        \"a23456789012345678901\",\n    ],\n)\ndef test_is_valid_username_returns_bool(name):\n    \"\"\"规约后置条件：返回值必须为 bool 类型。\n\n    期望值来源：自然语言规约后置条件。\n    \"\"\"\n    result = is_valid_username(name)\n    assert isinstance(result, bool)\n\n\n# ---------------------------------------------------------------------------\n# 探索性用例：Unicode 字母/数字行为未在规约中确定\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\n    \"name\",\n    [\n        \"中文\",\n        \"１２３\",  # 全角数字\n    ],\n)\ndef test_is_valid_username_unicode_alnum_exploratory(name):\n    \"\"\"探索性用例：规约指出含 Unicode 字母/数字时