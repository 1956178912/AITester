          "generated_test": "import pytest\n\nfrom task_0073 import lookup\n\n\n# ---------------------------------------------------------------------------\n# 前置条件：模块级 _TABLE 已初始化为 {\"alpha\":1,\"beta\":2,\"gamma\":3}\n# 期望值来源：自然语言规约（唯一合法来源）\n# ---------------------------------------------------------------------------\n\n@pytest.fixture\ndef table_snapshot():\n    \"\"\"在测试前后对 _TABLE 做快照，用于验证\"不修改 _TABLE\"的后置条件。\n\n    期望值来源：规约后置条件\"不修改 _TABLE\"。\n    \"\"\"\n    import task_0073\n\n    before = dict(task_0073._TABLE)\n    yield before\n    after = dict(task_0073._TABLE)\n    assert after == before, \"_TABLE 在调用 lookup 后被修改，违反后置条件\"\n\n\n# ---------------------------------------------------------------------------\n# 正常路径：命中 _TABLE 中存在的键\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\n    \"key, expected\",\n    [\n        (\"alpha\", 1),\n        (\"beta\", 2),\n        (\"gamma\", 3),\n    ],\n)\ndef test_lookup_hit_existing_keys(key, expected, table_snapshot):\n    \"\"\"命中 _TABLE 中存在的键时返回对应整数值。\n\n    期望值来源：规约前置条件 _TABLE = {\"alpha\":1,\"beta\":2,\"gamma\":3}\n    与边界情况\"key 为 _TABLE 中存在的键（返回对应值）\"。\n    \"\"\"\n    result = lookup(key)\n    assert result == expected\n    assert isinstance(result, int)\n\n\n# ---------------------------------------------------------------------------\n# 边界路径：未命中返回默认值 0\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\n    \"key\",\n    [\n        \"delta\",       # 不存在的键\n        \"\",            # 空字符串\n        \"Alpha\",       # 大小写变体\n        \"ALPHA\",\n        \"alpha \",      # 带尾随空格\n    ],\n)\ndef test_lookup_miss_returns_zero(key, table_snapshot):\n    \"\"\"未命中的键返回默认值 0。\n\n    期望值来源：规约边界情况\"key 为空字符串 ''（未命中，返回 0）\"、\n    \"key 为大小写变体如 'Alpha'（未命中，返回 0）\"，\n    以及描述中\"键不存在时返回默认值 0\"。\n    \"\"\"\n    result = lookup(key)\n    assert result == 0\n    assert isinstance(result, int)\n\n\ndef test_lookup_empty_string_returns_zero(table_snapshot):\n    \"\"\"空字符串键未命中，返回 0。\n\n    期望值来源：规约边界情况\"key 为空字符串 ''（未命中，返回 0）\"。\n    \"\"\"\n    assert lookup(\"\") == 0\n\n\ndef test_lookup_case_sensitive(table_snapshot):\n    \"\"\"字典键区分大小写，\"Alpha\" 未命中返回 0。\n\n    期望值来源：规约边界情况\"key 为大小写变体如 'Alpha'（未命中，返回 0）\"。\n    \"\"\"\n    assert lookup(\"Alpha\") == 0\n    # 对照：小写形式命中\n    assert lookup(\"alpha\") == 1\n\n\n# ---------------------------------------------------------------------------\n# 边界路径：非字符串键（None）\n# ---------------------------------------------------------------------------\n\ndef test_lookup_none_key_returns_zero(table_snapshot):\n    \"\"\"传入 None 作为键时返回默认值 0。\n\n    期望值来源：规约边界情况\"key 为 None 或非字符串（dict.get 可接受\n    任意可哈希对象，返回 0）\"。\n    \"\"\"\n    result = lookup(None)\n    assert result == 0\n    assert isinstance(result, int)\n\n\n# ---------------------------------------------------------------------------\n# 后置条件：返回值恒为 int\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\n    \"key\",\n    [\"alpha\", \"beta\", \"gamma\", \"delta\", \"\", \"Alpha\", None],\n)\ndef test_lookup_always_returns_int(key, table_snapshot):\n    \"\"\"无论命中与否，返回值恒为 int 类型。\n\n    期望值来源：规约后置条件\"返回值恒为 int 类型\"。\n    \"\"\"\n    result = lookup(key)\n    assert isinstance(result, int)\n    assert not isinstance(result, bool)  # bool 是 int 子类，但语义上不应返回布尔\n\n\n# ---------------------------------------------------------------------------\n# 后置条件：纯函数（同一 key 多次调用结果一致）\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\n    \"key\",\n    [\"alpha\", \"beta\", \"gamma\", \"delta\", \"\", \"Alpha\", None],\n)\ndef test_lookup_is_pure_repeated_calls_consistent(key, table_snapshot):\n    \"\"\"对同一 key 多次调用结果一致（纯函数）。\n\n    期望值来源：规约后置条件\"对同一 key 多次调用结果一致（纯函数）\"。\n    \"\"\"\n    first = lookup(key)\n    for _ in range(5):\n        assert lookup(key) == first\n\n\n# ---------------------------------------------------------------------------\n# 后置条件：不修改 _TABLE\n# ---------------------------------------------------------------------------\n\ndef test_lookup_does_not_mutate_table(table_snapshot):\n    \"\"\"调用 lookup 不修改模块级 _TABLE。\n\n    期望值来源：规约后置条件\"不修改 _TABLE\"。\n    \"\"\"\n    import task_0073\n\n    before = dict(task_0073._TABLE)\n    for key in [\"alpha\", \"beta\", \"gamma\", \"delta\", \"\", \"Alpha\", None]:\n        lookup(key)\n    after = dict(task_0073._TABLE)\n    assert after == before\n    # 同时确认 _TABLE 内容与前置条件一致\n    assert after == {\"alpha\": 1, \"beta\": 2, \"gamma\": 3}",
