          "generated_test": "import pytest\n\nfrom task_0081 import factorial\n\n\nclass TestFactorialBoundary:\n    \"\"\"边界用例：递归基例与最小非基例。\"\"\"\n\n    def test_factorial_n_zero_returns_one(self):\n        \"\"\"n=0 时返回 1（规约后置条件：n==0 时返回 1）。\"\"\"\n        assert factorial(0) == 1\n\n    def test_factorial_n_one_returns_one(self):\n        \"\"\"n=1 时返回 1（规约后置条件：n>0 时返回 n*(n-1)*...*1，即 1）。\"\"\"\n        assert factorial(1) == 1\n\n    def test_factorial_n_two_returns_two(self):\n        \"\"\"n=2 时返回 2（规约后置条件：n>0 时返回 n*(n-1)*...*1，即 2*1）。\"\"\"\n        assert factorial(2) == 2\n\n\nclass TestFactorialNormal:\n    \"\"\"正常用例：多次递归累积乘法。\"\"\"\n\n    @pytest.mark.parametrize(\n        \"n, expected\",\n        [\n            (3, 6),\n            (4, 24),\n            (5, 120),\n            (6, 720),\n            (10, 3628800),\n        ],\n    )\n    def test_factorial_positive_returns_product(self, n, expected):\n        \"\"\"n>0 时返回 n*(n-1)*...*1（规约后置条件）。\"\"\"\n        assert factorial(n) == expected\n\n    def test_factorial_matches_iterative_reference(self):\n        \"\"\"n>0 时结果应与迭代累乘参考实现一致（规约后置条件：n*(n-1)*...*1）。\"\"\"\n        for n in range(1, 13):\n            reference = 1\n            for k in range(2, n + 1):\n                reference *= k\n            assert factorial(n) == reference\n\n\nclass TestFactorialError:\n    \"\"\"错误用例：负数与极大值触发 RecursionError。\"\"\"\n\n    @pytest.mark.parametrize(\"n\", [-1, -5, -100])\n    def test_factorial_negative_raises_recursion_error(self, n):\n        \"\"\"n<0 时无基例可达，递归深度超限抛 RecursionError（规约后置条件）。\"\"\"\n        with pytest.raises(RecursionError):\n            factorial(n)\n\n    def test_factorial_large_n_raises_recursion_error(self):\n        \"\"\"n 极大时递归深度超过 Python 默认限制，抛 RecursionError（规约边界情况）。\"\"\"\n        with pytest.raises(RecursionError):\n            factorial(10000)",
