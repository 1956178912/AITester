pe_error():\n    \"\"\"元素类型不支持加法：字符串与整数相加抛 TypeError。\n\n    期望值来源：规约边界情况 items 元素为不支持加法的类型（如 str）会抛 TypeError。\n    \"\"\"\n    items = [\"a\"]\n    with pytest.raises(TypeError):\n        process(items)\n\n\ndef test_process_non_list_input_behavior():\n    \"\"\"非列表输入：规约前置条件要求 items 为 list，非列表行为未约定。\n\n    期望值来源不明，需人工确认：规约仅声明前置条件 isinstance(items, list)，\n    未约定违反前置条件时的行为，因此仅记录实际行为，不做具体值断言。\n    \"\"\"\n    items = \"abc\"\n    try:\n        result = process(items)\n    except Exception as exc:  # noqa: BLE001\n        # 记录实际抛出的异常类型，供人工确认\n        assert exc is not None\n    else:\n        # 若未抛异常，仅记录返回值类型，不臆造具体值\n        assert result is not None\n\n\n@pytest.mark.parametrize(\n    \"items\",\n    [\n        [1, 2, 3],\n        [],\n        [0],\n        [-1, -5],\n        [1.5, 2.5],\n        [10, -10, 0],\n    ],\n)\ndef test_process_postconditions_invariant(items):\n    \"\"\"参数化验证后置条件与不变量：长度、末元素、逐元素加 1。\n\n    期望值来源：规约后置条件与不变量子句。\n    \"\"\"\n    result = process(items)\n    assert isinstance(result, list)\n    assert len(result) == len(items) + 1\n    assert result[-1] == 0\n    assert all(result[i] == items[i] + 1 for i in range(len(items)))",
