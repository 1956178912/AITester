          "generated_test": "import pytest\n\nfrom task_0069 import split_words\n\n\nclass TestSplitWordsNormal:\n    \"\"\"正常路径测试：验证常规字符串按单个空格分割的行为。\"\"\"\n\n    def test_split_words_normal_two_words(self):\n        \"\"\"普通多词字符串：'hello world' 应分割为 ['hello', 'world']。\n\n        期望值来源：规约后置条件\"以单个空格为分隔符切分\"。\n        \"\"\"\n        result = split_words(\"hello world\")\n        assert result == [\"hello\", \"world\"]\n\n    def test_split_words_normal_no_space(self):\n        \"\"\"无空格字符串：'hello' 应返回单元素列表 ['hello']。\n\n        期望值来源：规约后置条件\"以单个空格为分隔符切分\"。\n        \"\"\"\n        result = split_words(\"hello\")\n        assert result == [\"hello\"]\n\n    def test_split_words_normal_returns_list(self):\n        \"\"\"返回值类型必须为 list。\n\n        期望值来源：规约后置条件\"返回值为list类型\"。\n        \"\"\"\n        result = split_words(\"a b c\")\n        assert isinstance(result, list)\n\n    def test_split_words_normal_elements_are_str(self):\n        \"\"\"返回列表中所有元素必须为 str 类型。\n\n        期望值来源：规约后置条件\"返回列表中的元素均为str类型\"。\n        \"\"\"\n        result = split_words(\"a b c\")\n        assert all(isinstance(item, str) for item in result)\n\n    def test_split_words_normal_multiple_words(self):\n        \"\"\"多个单词：'a b c d' 应分割为 ['a', 'b', 'c', 'd']。\n\n        期望值来源：规约后置条件\"以单个空格为分隔符切分\"。\n        \"\"\"\n        result = split_words(\"a b c d\")\n        assert result == [\"a\", \"b\", \"c\", \"d\"]\n\n\nclass TestSplitWordsBoundary:\n    \"\"\"边界情况测试：空串、单空格、连续空格、首尾空格等。\"\"\"\n\n    def test_split_words_boundary_empty_string(self):\n        \"\"\"空字符串 '' 按单个空格分割应返回 ['']。\n\n        期望值来源：规约边界情况\"空字符串''\"，\n        以及 Python str.split(' ') 的语义（以单个空格为分隔符切分）。\n        \"\"\"\n        result = split_words(\"\")\n        assert result == [\"\"]\n\n    def test_split_words_boundary_single_space(self):\n        \"\"\"单个空格 ' ' 应分割为 ['', '']。\n\n        期望值来源：规约边界情况\"单个空格' '\"，以单个空格为分隔符切分。\n        \"\"\"\n        result = split_words(\" \")\n        assert result == [\"\", \"\"]\n\n    def test_split_words_boundary_consecutive_spaces(self):\n        \"\"\"连续多个空格 'a  b' 应分割为 ['a', '', 'b']（不合并空格）。\n\n        期望值来源：规约边界情况\"连续多个空格'  '\"，以单个空格为分隔符切分。\n        \"\"\"\n        result = split_words(\"a  b\")\n        assert result == [\"a\", \"\", \"b\"]\n\n    def test_split_words_boundary_leading_trailing_spaces(self):\n        \"\"\"首尾带空格 ' a b ' 应分割为 ['', 'a', 'b', '']。\n\n        期望值来源：规约边界情况\"首尾带空格的字符串' a b '\"。\n        \"\"\"\n        result = split_words(\" a b \")\n        assert result == [\"\", \"a\", \"b\", \"\"]\n\n    def test_split_words_boundary_only_spaces(self):\n        \"\"\"仅含多个空格 '   ' 应分割为 ['', '', '', '']。\n\n        期望值来源：规约边界情况\"仅含空格的字符串'   '\"，\n        三个空格以单个空格为分隔符切分得到四个空字符串。\n        \"\"\"\n        result = split_words(\"   \")\n        assert result == [\"\", \"\", \"\", \"\"]\n\n    def test_split_words_boundary_no_space_abc(self):\n        \"\"\"无空格字符串 'abc' 应返回 ['abc']。\n\n        期望值来源：规约边界情况\"无空格字符串'abc'\"。\n        \"\"\"\n        result = split_words(\"abc\")\n        assert result == [\"abc\"]\n\n\nclass TestSplitWordsError:\n    \"\"\"异常路径测试：前置条件不满足时的行为。\n\n    规约前置条件要求 text 必须是 str 类型。传入非 str 类型时，\n    函数未定义异常处理，具体异常类型与信息未知。\n    以下用例采用探索性断言，仅验证会抛出异常，需人工确认具体异常类型。\n    \"\"\"\n\n    def test_split_words_error_non_string_int(self):\n        \"\"\"非字符串输入（int）应抛出异常。\n\n        期望值来源不明，需人工确认：规约仅规定前置条件为 str，\n        未定义非 str 输入时的异常类型，此处仅断言会抛出异常。\n        \"\"\"\n        with pytest.raises(Exception):\n            split_words(123)\n\n    def test_split_words_error_none_input(self):\n        \"\"\"None 输入应抛出异常。\n\n        期望值来源不明，需人工确认：规约仅规定前置条件为 str，\n        未定义 None 输入时的异常类型，此处仅断言会抛出异常。\n        \"\"\"\n        with pytest.raises(Exception):\n            split_words(None)",
