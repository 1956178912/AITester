          "generated_test": "import pytest\n\nfrom task_0040 import clamp\n\n\n# ---------------------------------------------------------------------------\n# 正常区间用例\n# ---------------------------------------------------------------------------\n\ndef test_clamp_value_inside_range_returns_value():\n    \"\"\"value 位于区间内部，应返回原值。\n\n    期望值来源：规约后置条件「当 min_val <= value <= max_val 时返回值等于 value」。\n    \"\"\"\n    assert clamp(5.0, 0.0, 10.0) == 5.0\n\n\ndef test_clamp_value_below_min_returns_min():\n    \"\"\"value 小于 min_val，应返回 min_val。\n\n    期望值来源：规约后置条件「返回值 >= min_val」及边界描述「小于下界返回下界」。\n    \"\"\"\n    assert clamp(-3.0, 0.0, 10.0) == 0.0\n\n\ndef test_clamp_value_above_max_returns_max():\n    \"\"\"value 大于 max_val，应返回 max_val。\n\n    期望值来源：规约后置条件「返回值 <= max_val」及边界描述「大于上界返回上界」。\n    \"\"\"\n    assert clamp(15.0, 0.0, 10.0) == 10.0\n\n\ndef test_clamp_negative_range_inside_returns_value():\n    \"\"\"负数区间内取值，应返回原值。\n\n    期望值来源：规约后置条件「当 min_val <= value <= max_val 时返回值等于 value」。\n    \"\"\"\n    assert clamp(-5.0, -10.0, -1.0) == -5.0\n\n\ndef test_clamp_negative_range_below_min_returns_min():\n    \"\"\"负数区间下 value 小于 min_val，应返回 min_val。\n\n    期望值来源：规约边界描述「小于下界返回下界」。\n    \"\"\"\n    assert clamp(-20.0, -10.0, -1.0) == -10.0\n\n\n# ---------------------------------------------------------------------------\n# 边界用例\n# ---------------------------------------------------------------------------\n\ndef test_clamp_value_equals_min_returns_value():\n    \"\"\"value 恰好等于 min_val，应返回原值（等号边界不触发下界截断）。\n\n    期望值来源：规约边界情况「value == min_val（不触发第一分支，返回 value）」。\n    \"\"\"\n    assert clamp(0.0, 0.0, 10.0) == 0.0\n\n\ndef test_clamp_value_equals_max_returns_value():\n    \"\"\"value 恰好等于 max_val，应返回原值（等号边界不触发上界截断）。\n\n    期望值来源：规约边界情况「value == max_val（不触发第二分支，返回 value）」。\n    \"\"\"\n    assert clamp(10.0, 0.0, 10.0) == 10.0\n\n\ndef test_clamp_value_slightly_below_min_returns_min():\n    \"\"\"value 仅比 min_val 小极小量，应返回 min_val。\n\n    期望值来源：规约边界情况「value 略小于 min_val」。\n    \