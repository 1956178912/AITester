          "generated_test": "import pytest\n\nfrom task_0063 import pick_label\n\n\n# ---------------------------------------------------------------------------\n# pick_label 后置条件测试\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\n    \"score, expected\",\n    [\n        (90, \"excellent\"),          # excellent 下边界\n        (100, \"excellent\"),         # excellent 典型值\n        (10 ** 18, \"excellent\"),    # 极大值\n    ],\n)\ndef test_pick_label_excellent_branch(score, expected):\n    \"\"\"score >= 90 时 pick_label 应返回 \"excellent\"。\n\n    期望值来源：规约后置条件 \"score >= 90 时返回 excellent\"。\n    \"\"\"\n    assert pick_label(score) == expected\n\n\n@pytest.mark.parametrize(\n    \"score, expected\",\n    [\n        (89, \"pass\"),   # pass 上边界\n        (60, \"pass\"),   # pass 下边界\n        (75, \"pass\"),   # pass 典型值\n    ],\n)\ndef test_pick_label_pass_branch(score, expected):\n    \"\"\"60 <= score < 90 时 pick_label 应返回 \"pass\"。\n\n    期望值来源：规约后置条件 \"60 <= score < 90 时返回 pass\"。\n    \"\"\"\n    assert pick_label(score) == expected\n\n\n@pytest.mark.parametrize(\n    \"score\",\n    [\n        59,   # 无 return 分支边界\n        0,    # 零值\n        -1,   # 负数\n    ],\n)\ndef test_pick_label_below_60_returns_none(score):\n    \"\"\"score < 60 时 pick_label 隐式返回 None。\n\n    期望值来源：规约后置条件 \"score < 60 时隐式返回 None\"。\n    \"\"\"\n    assert pick_label(score) is None\n\n\ndef test_pick_label_postcondition_consistency():\n    \"\"\"对一组覆盖各分支的输入，验证后置条件整体成立。\n\n    期望值来源：可执行规约\n    score >= 90 and result == \"excellent\"\n    or 60 <= score < 90 and result == \"pass\"\n    or score < 60 and result is None\n    \"\"\"\n    for score in (90, 89, 60, 59, 0, -1, 10 ** 18):\n        result = pick_label(score)\n        assert (\n            (score >= 90 and result == \"excellent\")\n            or (60 <= score < 90 and result == \"pass\")\n            or (score < 60 and result is None)\n        ), f\"后置条件在 score={score} 时被违反，实际返回 {result!r}\"\n\n\n# ---------------------------------------------------------------------------\n# report 行为测试（report 依赖 pick_label 的返回值）\n# ---------------------------------------------------------------------------\n\ndef test_pick_label_report_excellent_uppercase():\n    \"\"\"report 对 excellent 标签应返回 \"result: EXCELLENT\"。\n\n    期望值来源：规约后置条件 \"report 返回以 'result: ' 开头且标签大写的字符串\"，\n    结合 pick_label(95) == \"excellent\"。\n    \"\"\"\n    from task_0063 import report\n\n    assert report(95) == \"result: EXCELLENT\"\n\n\ndef test_pick_label_report_pass_uppercase():\n    \"\"\"report 对 pass 标签应返回 \"result: PASS\"。\n\n    期望值来源：规约后置条件 \"report 返回以 'result: ' 开头且标签大写的字符串\"，\n    结合 pick_label(70) == \"pass\"。\n    \"\"\"\n    from task_0063 import report\n\n    assert report(70) == \"result: PASS\"\n\n\ndef test_pick_label_report_below_60_raises_attribute_error():\n    \"\"\"score < 60 时 pick_label 返回 None，report 对 None 调用 .upper() 应抛 AttributeError。\n\n    期望值来源：规约边界情况 \"report 在 score<60 时对 None 调用 .upper() 抛 AttributeError\"。\n    \"\"\"\n    from task_0063 import report\n\n    with pytest.raises(AttributeError):\n        report(30)",
