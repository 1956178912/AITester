          "generated_test": "import pytest\n\nfrom task_0012 import split_words\n\n\n# ---------------------------------------------------------------------------\n# 正常路径\n# ---------------------------------------------------------------------------\n\ndef test_split_words_normal_two_words():\n    \"\"\"规约：按单个空格 ' ' 分割。'hello world' -> ['hello', 'world']。\"\"\"\n    result = split_words(\"hello world\")\n    assert result == [\"hello\", \"world\"]\n\n\ndef test_split_words_normal_single_word_no_space():\n    \"\"\"规约：无空格字符串返回包含原字符串的单元素列表。\"\"\"\n    result = split_words(\"hello\")\n    assert result == [\"hello\"]\n\n\ndef test_split_words_returns_list_type():\n    \"\"\"后置条件：返回值为 list 类型。\"\"\"\n    result = split_words(\"hello world\")\n    assert isinstance(result, list)\n\n\ndef test_split_words_elements_are_str():\n    \"\"\"后置条件：返回列表元素均为 str 类型。\"\"\"\n    result = split_words(\"hello world foo\")\n    assert all(isinstance(item, str) for item in result)\n\n\n# ---------------------------------------------------------------------------\n# 边界情况\n# ---------------------------------------------------------------------------\n\ndef test_split_words_empty_string():\n    \"\"\"边界：空字符串 ''。str.split(' ') 对空串返回 ['']。\"\"\"\n    result = split_words(\"\")\n    assert result == [\"\"]\n\n\ndef test_split_words_single_space():\n    \"\"\"边界：仅含一个空格的字符串 ' ' -> ['', '']。\"\"\"\n    result = split_words(\" \")\n    assert result == [\"\", \"\"]\n\n\ndef test_split_words_multiple_consecutive_spaces():\n    \"\"\"边界：仅含三个连续空格的字符串 '   ' -> 四个空字符串。\"\"\"\n    result = split_words(\"   \")\n    assert result == [\"\", \"\", \"\", \"\"]\n\n\ndef test_split_words_leading_and_trailing_spaces():\n    \"\"\"边界：首尾均有空格的字符串 ' hello ' -> ['', 'hello', '']。\"\"\"\n    result = split_words(\" hello \")\n    assert result == [\"\", \"hello\", \"\"]\n\n\ndef test_split_words_middle_consecutive_spaces():\n    \"\"\"边界：中间含两个连续空格的字符串 'hello  world' -> ['hello', '', 'world']。\"\"\"\n    result = split_words(\"hello  world\")\n    assert result == [\"hello\", \"\", \"world\"]\n\n\ndef test_split_words_tab_not_split():\n    \"\"\"边界：制表符不被视为分隔符，'hello\\\\tworld' 整体作为一个元素。\"\"\"\n    result = split_words(\"hello\\tworld\")\n    assert result == [\"hello\\tworld\"]\n\n\ndef test_split_words_newline_not_split():\n    \"\"\"边界：换行符不被视为分隔符，'hello\\\\nworld' 整体作为一个元素。\"\"\"\n    result = split_words(\"hello\\nworld\")\n    assert result == [\"hello\\nworld\"]\n\n\ndef test_split_words_long_string():\n    \"\"\"边界：超长字符串。规约未给出具体期望值，仅验证后置条件（list 且元素为 str）。\"\"\"\n    text = \" \".join([\"word\"] * 10000)\n    result = split_words(text)\n    assert isinstance(result, list)\n    assert all(isinstance(item, str) for item in result)\n    assert len(result) == 10000\n\n\n# ---------------------------------------------------------------------------\n# 异常路径\n# ---------------------------------------------------------------------------\n\ndef test_split_words_non_string_input_raises():\n    \"\"\"异常：前置条件要求 text 为 str。传入 int 应抛出异常。\n\n    期望值来源不明（具体异常类型/信息取决于实现），需人工确认；\n    此处仅断言会抛出异常，不臆造具体异常类型。\n    \"\"\"\n    with pytest.raises(Exception):\n        split_words(123)\n\n\ndef test_split_words_none_input_raises():\n    \"\"\"异常：前置条件要求 text 为 str。传入 None 应抛出异常。\n\n    期望值来源不明（具体异常类型/信息取决于实现），需人工确认；\n    此处仅断言会抛出异常，不臆造具体异常类型。\n    \"\"\"\n    with pytest.raises(Exception):\n        split_words(None)",
