          "generated_test": "import pytest\n\nfrom task_0035 import lookup\n\n\n# ---------------------------------------------------------------------------\n# 正常路径：有效键返回对应映射值\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\n    \"key, expected\",\n    [\n        (\"alpha\", 1),\n        (\"beta\", 2),\n        (\"gamma\", 3),\n    ],\n)\ndef test_lookup_valid_keys_return_mapped_value(key, expected):\n    \"\"\"规约：有效键返回对应映射值（alpha->1, beta->2, gamma->3）。\"\"\"\n    result = lookup(key)\n    assert result == expected\n    assert isinstance(result, int)\n\n\n# ---------------------------------------------------------------------------\n# 无效键：返回默认值 0\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\n    \"key\",\n    [\n        \"delta\",          # 普通无效键\n        \"\",               # 空字符串\n        \"Alpha\",          # 大小写不同\n        \" alpha \",        # 带前后空格\n        \"a\" * 1000,       # 超长字符串\n    ],\n)\ndef test_lookup_invalid_keys_return_zero(key):\n    \"\"\"规约：无效键（含空串、大小写不同、带空格、超长）返回默认值 0。\"\"\"\n    result = lookup(key)\n    assert result == 0\n    assert isinstance(result, int)\n\n\n# ---------------------------------------------------------------------------\n# 边界：None 作为键\n# ---------------------------------------------------------------------------\n\ndef test_lookup_none_key_returns_zero():\n    \"\"\"规约边界：None 不在字典中，dict.get 不校验类型，返回 0。\n\n    期望值来源：规约边界情况明确说明 None 返回 0。\n    \"\"\"\n    result = lookup(None)\n    assert result == 0\n    assert isinstance(result, int)\n\n\n# ---------------------------------------------------------------------------\n# 后置条件：返回值始终为 int\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\n    \"key\",\n    [\"alpha\", \"beta\", \"gamma\", \"delta\", \"\", \"Alpha\", \" alpha \", None],\n)\ndef test_lookup_return_type_is_int(key):\n    \"\"\"规约后置条件：返回值始终为 int 类型。\"\"\"\n    result = lookup(key)\n    assert isinstance(result, int)\n\n\n# ---------------------------------------------------------------------------\n# 后置条件：函数无副作用，不修改 _TABLE\n# ---------------------------------------------------------------------------\n\ndef test_lookup_has_no_side_effect_on_table():\n    \"\"\"规约后置条件：函数无副作用，不修改模块级 _TABLE。\n\n    通过多次调用前后对比 _TABLE 内容来验证。\n    \"\"\"\n    import task_0035\n\n    table_before = dict(task_0035._TABLE)\n\n    lookup(\"alpha\")\n    lookup(\"delta\")\n    lookup(\"\")\n    lookup(None)\n\n    table_after = dict(task_0035._TABLE)\n    assert table_after == table_before\n\n\n# ---------------------------------------------------------------------------\n# 幂等性：重复调用同一键结果一致\n# ---------------------------------------------------------------------------\n\ndef test_lookup_is_idempotent_for_same_key():\n    \"\"\"规约：无副作用，同一键重复调用应返回一致结果。\"\"\"\n    first = lookup(\"beta\")\n    second = lookup(\"beta\")\n    assert first == second == 2",
