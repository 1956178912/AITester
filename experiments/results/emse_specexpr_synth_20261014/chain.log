          "generated_test": "import pytest\n\nfrom task_0000 import process\n\n\ndef test_process_returns_list_with_incremented_items_and_trailing_zero():\n    \"\"\"验证 process 对输入列表元素加 1 并在末尾追加 0。\n\n    期望值来源：目标代码实现 `[x + 1 for x in items] + [0]`。\n    \"\"\"\n    result = process([1, 2, 3])\n    assert result == [2, 3, 4, 0]\n\n\ndef test_process_empty_list_returns_single_zero():\n    \"\"\"验证空列表输入时返回仅含一个 0 的列表。\n\n    期望值来源：目标代码实现，空列表推导结果为空，再追加 0。\n    \"\"\"\n    result = process([])\n    assert result == [0]\n\n\ndef test_process_single_element():\n    \"\"\"验证单元素列表的处理结果。\n\n    期望值来源：目标代码实现。\n    \"\"\"\n    result = process([5])\n    assert result == [6, 0]\n\n\ndef test_process_negative_numbers():\n    \"\"\"验证负数元素同样执行加 1 操作。\n\n    期望值来源：目标代码实现，未对元素符号做特殊处理。\n    \"\"\"\n    result = process([-1, -2])\n    assert result == [0, -1, 0]\n\n\ndef test_process_zero_element():\n    \"\"\"验证元素为 0 时的处理结果。\n\n    期望值来源：目标代码实现。\n    \"\"\"\n    result = process([0])\n    assert result == [1, 0]\n\n\ndef test_process_returns_new_list_not_same_object():\n    \"\"\"验证返回的是新列表对象，而非输入对象本身。\n\n    期望值来源：目标代码使用列表推导构造新列表。\n    \"\"\"\n    items = [1, 2, 3]\n    result = process(items)\n    assert result is not items\n\n\ndef test_process_does_not_mutate_input():\n    \"\"\"验证输入列表在调用后保持不变。\n\n    期望值来源：目标代码未对输入做原地修改。\n    \"\"\"\n    items = [1, 2, 3]\n    process(items)\n    assert items == [1, 2, 3]\n\n\ndef test_process_float_elements():\n    \"\"\"验证浮点元素同样执行加 1 操作。\n\n    期望值来源：目标代码实现，未限制元素类型。\n    \"\"\"\n    result = process([1.5, 2.5])\n    assert result == [2.5, 3.5, 0]\n\n\ndef test_process_large_list_length():\n    \"\"\"验证输出长度等于输入长度加 1。\n\n    期望值来源：目标代码实现，末尾固定追加一个 0。\n    \"\"\"\n    items = list(range(100))\n    result = process(items)\n    assert len(result) == len(items) + 1\n    assert result[-1] == 0\n\n\ndef test_process_non_list_input_raises_type_error():\n    \"\"\"验证非可迭代输入会抛出 TypeError。\n\n    期望值来源：目标代码对输入执行迭代，非可迭代对象将触发 TypeError。\n    \"\"\"\n    with py