          "generated_test": "import pytest\n\nfrom task_0080 import initials\n\n\n# ---------------------------------------------------------------------------\n# 正常路径\n# ---------------------------------------------------------------------------\n\ndef test_initials_multi_word_name():\n    \"\"\"多词姓名：每个词贡献一个大写首字符，以 '.' 连接。\n\n    期望值来源：规约后置条件「每个词贡献一个大写首字符」+ 测试计划。\n    \"\"\"\n    assert initials(\"john doe\") == \"J.D\"\n\n\ndef test_initials_single_word_name():\n    \"\"\"单词输入：仅返回单个大写首字母。\n\n    期望值来源：规约后置条件「每个词贡献一个大写首字符」。\n    \"\"\"\n    assert initials(\"alice\") == \"A\"\n\n\n# ---------------------------------------------------------------------------\n# 边界：空白处理\n# ---------------------------------------------------------------------------\n\ndef test_initials_multiple_spaces_between_words():\n    \"\"\"连续空白分隔：按空白拆分后仍取每个词首字母。\n\n    期望值来源：规约「按空白拆分」+ 测试计划。\n    \"\"\"\n    assert initials(\"a  b\") == \"A.B\"\n\n\ndef test_initials_leading_and_trailing_spaces():\n    \"\"\"前导/尾随空白：应被忽略，不影响结果。\n\n    期望值来源：规约「按空白拆分」+ 测试计划。\n    \"\"\"\n    assert initials(\" a b \") == \"A.B\"\n\n\ndef test_initials_empty_string_returns_empty():\n    \"\"\"空字符串输入：返回空字符串。\n\n    期望值来源：规约边界情况「空字符串 ''」+ 测试计划。\n    \"\"\"\n    assert initials(\"\") == \"\"\n\n\ndef test_initials_whitespace_only_returns_empty():\n    \"\"\"纯空白输入：返回空字符串。\n\n    期望值来源：规约边界情况「纯空白 '   '」+ 测试计划。\n    \"\"\"\n    assert initials(\"   \") == \"\"\n\n\n# ---------------------------------------------------------------------------\n# 边界：单字符 / Unicode / 非字母\n# ---------------------------------------------------------------------------\n\ndef test_initials_single_character():\n    \"\"\"单字符输入：返回该字符的大写形式。\n\n    期望值来源：规约边界情况「单字符 'a'」+ 后置条件。\n    \"\"\"\n    assert initials(\"x\") == \"X\"\n\n\ndef test_initials_unicode_character():\n    \"\"\"Unicode 首字符：应被大写处理。\n\n    期望值来源：规约边界情况「Unicode 字符 'é'」+ 后置条件。\n    \"\"\"\n    assert initials(\"éa b\") == \"É.B\"\n\n\ndef test_initials_with_digits_and_punctuation():\n    \"\"\"含数字/标点的词：首字符仍按大写规则处理。\n\n    期望值来源：规约边界情况「含数字或标点 'a1 b2'」+ 后置条件。\n    \"\"\"\n    assert initials(\"a1 b2\") == \"A.B\"\n\n\n# ---------------------------------------------------------------------------\n# 后置条件：返回值类型与无尾部点号\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\n    \"full_name\",\n    [\"john doe\", \"alice\", \"a  b\", \" a b \", \"\", \"   \", \"x\", \"éa b\", \"a1 b2\"],\n)\ndef test_initials_returns_str_type(full_name):\n    \"\"\"后置条件：返回值类型必须为 str。\n\n    期望值来源：规约后置条件「返回值类型为 str」。\n    \"\"\"\n    result = initials(full_name)\n    assert isinstance(result, str)\n\n\n@pytest.mark.parametrize(\n    \"full_name\",\n    [\"john doe\", \"alice\", \"a  b\", \" a b \", \"x\", \"éa b\", \"a1 b2\"],\n)\ndef test_initials_no_trailing_dot(full_name):\n    \"\"\"后置条件：返回值不含尾部点号。\n\n    期望值来源：规约后置条件「返回值不含尾部点号」。\n    \"\"\"\n    result = initials(full_name)\n    assert not result.endswith(\".\")\n\n\n# ---------------------------------------------------------------------------\n# 边界：None 输入（期望值来源不明，探索性断言）\n# ---------------------------------------------------------------------------\n\ndef test_initials_none_input_behavior():\n    \"\"\"None 输入：规约仅声明前置条件允许 None，但未约定其返回行为。\n\n    期望值来源不明，需人工确认。\n    此处采用探索性断言：记录实际行为，仅校验「要么返回 str，\n    要么抛出异常」这一可判定性质，避免臆造具体返回值。\n    \"\"\"\n    try:\n        result = initials(None)\n    except Exception:\n        # 规约未约定 None 的行为，抛出异常视为可接受的实际行为\n        return\n    assert isinstance(result, str)",
