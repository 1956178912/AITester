nce(result, str)\n    assert result == \"\"\n\n\n# ---------------------------------------------------------------------------\n# 边界：字符集\n# ---------------------------------------------------------------------------\n\ndef test_initials_unicode_name():\n    \"\"\"Unicode 姓名：'josé garcía' -> 'J.G'（首字母大写行为）。\"\"\"\n    result = initials(\"josé garcía\")\n    assert isinstance(result, str)\n    assert result == \"J.G\"\n\n\n# ---------------------------------------------------------------------------\n# 异常路径\n# ---------------------------------------------------------------------------\n\ndef test_initials_none_raises():\n    \"\"\"None 输入：类型注解允许 None，但规约指出会触发 AttributeError。\n\n    期望值来源：规约边界情况明确说明 None 会触发 AttributeError。\n    \"\"\"\n    with pytest.raises(AttributeError):\n        initials(None)\n\n\n# ---------------------------------------------------------------------------\n# 规约性质：后置条件与不变量（参数化覆盖）\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\n    \"full_name\",\n    [\n        \"john doe\",\n        \"john ronald reuel tolkien\",\n        \"madonna\",\n        \"  john doe  \",\n        \"john    doe\",\n        \"josé garcía\",\n        \"a b c d e\",\n    ],\n)\ndef test_initials_postcondition_matches_spec(full_name):\n    \"\"\"后置条件：result == '.'.join(p[0].upper() for p in full_name.split())。\n\n    期望值来源：规约可执行后置子句。\n    \"\"\"\n    result = initials(full_name)\n    assert isinstance(result, str)\n    assert result == \".\".join(p[0].upper() for p in full_name.split())\n\n\n@pytest.mark.parametrize(\n    \"full_name\",\n    [\n        \"john doe\",\n        \"john ronald reuel tolkien\",\n        \"madonna\",\n        \"  john doe  \",\n        \"john    doe\",\n        \"josé garcía\",\n    ],\n)\ndef test_initials_result_contains_no_spaces(full_name):\n    \"\"\"后置条件：返回值中不含空格。\"\"\"\n    result = initials(full_name)\n    assert \" \" not in result\n\n\n@pytest.mark.parametrize(\n    \"full_name\