          "rag_stats": null,
          "patch": "python\ndef safe_div(a: int, b: int) -> float:\n    # 边界处理：除零保护\n    if b == 0:\n        raise ZeroDivisionError(\"division by zero\")\n    # 超大整数直接相除可能触发 OverflowError，回退到 Decimal 计算\n    try:\n        return a / b\n    except OverflowError:\n        from decimal import Decimal, getcontext\n        # 提高精度以容纳超大整数\n        getcontext().prec = max(len(str(abs(a))), len(str(abs(b)))) + 10\n        return float(Decimal(a) / Decimal(b))\n# noise_seed=4839\n",
          "generated_test": "import math\n\nimport pytest\n\nfrom task_0043 import safe_div\n\n\n# ---------------------------------------------------------------------------\n# 正常路径（normal）\n# ---------------------------------------------------------------------------\n\ndef test_safe_div_normal_exact_division():\n    \"\"\"正常整除：10 / 2 应返回浮点商 5.0。\n\n    期望值来源：规约「返回值为 a / b 的浮点商」。\n    \"\"\"\n    result = safe_div(10, 2)\n    assert isinstance(result, float)\n    assert result == 5.0\n\n\ndef test_safe_div_normal_non_exact_division():\n    \"\"\"正常非整除：7 / 2 应返回浮点商 3.5。\n\n    期望值来源：规约「返回值为 a / b 的浮点商」。\n    \"\"\"\n    result = safe_div(7, 2)\n    assert isinstance(result, float)\n    assert result == 3.5\n\n\n# ---------------------------------------------------------------------------\n# 边界路径（boundary）\n# ---------------------------------------------------------------------------\n\ndef test_safe_div_boundary_zero_dividend():\n    \"\"\"边界 a == 0：0 / 5 应返回 0.0。\n\n    期望值来源：规约「a == 0 结果为 0.0」。\n    \"\"\"\n    result = safe_div(0, 5)\n    assert isinstance(result, float)\n    assert result == 0.0\n\n\ndef test_safe_div_boundary_divisor_one():\n    \"\"\"边界 b == 1：9 / 1 应等于 float(9)。\n\n    期望值来源：规约「b == 1 结果等于 float(a)」。\n    \"\"\"\n    result = safe_div(9, 1)\n    assert isinstance(result, float)\n    assert result == float(9)\n\n\ndef test_safe_div_boundary_divisor_minus_one():\n    \"\"\"边界 b == -1：9 / -1 应等于 -float(9)。\n\n    期望值来源：规约「b == -1 结果等于 -float(a)」。\n    \"\"\"\n    result = safe_div(9, -1)\n    assert isinstance(result, float)\n    assert result == -float(9)\n\n\ndef test_safe_div_boundary_negative_dividend():\n    \"\"\"边界负数：-8 / 2 应返回负浮点结果 -4.0。\n\n    期望值来源：规约「a 或 b 为负数结果为负」+「返回值为 a / b 的浮点商」。\n    \"\"\"\n    result = safe_div(-8, 2)\n    assert isinstance(result, float)\n    assert result == -4.0\n    assert result < 0\n\n\ndef test_safe_div_boundary_negative_divisor():\n    \"\"\"边界负数：8 / -2 应返回负浮点结果 -4.0。\n\n    期望值来源：规约「a 或 b 为负数结果为负」+「返回值为 a / b 的浮点商」。\n    \"\"\"\n    result = safe_div(8, -2)\n    assert isinstance(result, float)\n    assert result == -4.0\n    assert result < 0\n\n\ndef test_safe_div_boundary_both_negative():\n    \"\"\"边界负数：-8 / -2 应返回正浮点结果 4.0。\n\n    期望值来源：规约「返回值为 a / b 的浮点商」（两负数相除为正）。\n    \"\"\"\n    result = safe_div(-8, -2)\n    assert isinstance(result, float)\n    assert result == 4.0\n\n\n# ---------------------------------------------------------------------------\n# 后置条件（postcondition）\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\n    \"a, b\",\n    [\n        (10, 2),\n        (7, 2),\n        (0, 5),\n        (9, 1),\n        (9, -1),\n        (-8, 2),\n        (8, -2),\n        (-8, -2),\n        (1, 3),\n        (100, 7),\n    ],\n)\ndef test_safe_div_postcondition_returns_float(a, b):\n    \"\"\"后置条件：返回值必须是 float 类型。\n\n    期望值来源：可执行规约「isinstance(result, float)」。\n    \"\"\"\n    result = safe_div(a, b)\n    assert isinstance(result, float)\n\n\n@pytest.mark.parametrize(\n    \"a, b\",\n    [\n        (10, 2),\n        (7, 2),\n        (0, 5),\n        (9, 1),\n        (9, -1),\n        (-8, 2),\n        (8, -2),\n        (-8, -2),\n        (1, 3),\n        (100, 7),\n    ],\n)\ndef test_safe_div_postcondition_result_times_divisor_equals_dividend(a, b):\n    \"\"\"后置条件：result * b == a（浮点精度允许范围内）。\n\n    期望值来源：规约「返回值满足 result * b == a（在浮点精度允许范围内）」。\n    \"\"\"\n    result = safe_div(a, b)\n    assert math.isclose(result * b, a, rel_tol=1e-9, abs_tol=1e-9)\n\n\n# ---------------------------------------------------------------------------\n# 异常路径（error）\n# ---------------------------------------------------------------------------\n\ndef test_safe_div_error_zero_divisor_raises():\n    \"\"\"异常路径 b == 0：应触发 ZeroDivisionError。\n\n    期望值来源：规约「b 不为 0（否则触发 ZeroDivisionError）」。\n    \"\"\"\n    with pytest.raises(ZeroDivisionError):\n        safe_div(1, 0)\n\n\n@pytest.mark.parametrize(\"a\", [0, 1, -1, 100, -100])\ndef test_safe_div_error_zero_divisor_various_dividends(a):\n    \"\"\"异常路径 b == 0：任意被除数都应触发 ZeroDivisionError。\n\n    期望值来源：规约「b 不为 0（否则触发 ZeroDivisionError）」。\n    \"\"\"\n    with pytest.raises(ZeroDivisionError):\n        safe_div(a, 0)\n\n\n# ---------------------------------------------------------------------------\n# 探索性用例（期望值来源不明，需人工确认）\n# ---------------------------------------------------------------------------\n\ndef test_safe_div_explore_large_integers_behavior():\n    \"\"\"探索性：极大整数相除的实际行为。\n\n    期望值来源不明，需人工确认：规约仅说明「极大整数相除可能溢出为 inf\n    或精度丢失」，未约定具体返回值。此处仅记录实际行为并断言其与\n    「a / b 的浮点商」这一后置条件在浮点语义下一致（允许 inf）。\n    \"\"\"\n    a = 10 ** 400\n    b = 3\n    result = safe_div(a, b)\n    assert isinstance(result, float)\n    # 记录实际行为：Python 中 int/int 对超大整数可能返回 inf 或有限浮点值\n    assert math.isinf(result) or math.isfinite(result)\n\n\ndef test_safe_div_explore_float_precision_behavior():\n    \"\"\"探索性：非整除时的浮点精度行为。\n\n    期望值来源不明，需人工确认：规约未约定精度截断方式。此处仅断言\n    返回值与 a / b 在浮点精度范围内一致。\n    \"\"\"\n    a = 1\n    b = 3\n    result = safe_div(a, b)\n    assert isinstance(result, float)\n    assert math.isclose(result, a / b, rel_tol=1e-9, abs_tol=1e-12)",
