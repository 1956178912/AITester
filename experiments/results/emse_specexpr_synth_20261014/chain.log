          "generated_test": "import pytest\n\nfrom task_0019 import aggregate\n\n\n# ---------------------------------------------------------------------------\n# 正常路径 / 主路径\n# ---------------------------------------------------------------------------\n\ndef test_aggregate_multi_element_integers():\n    \"\"\"多元素整数列表：返回值应为 sum(values)/len(values)（规约后置条件）。\"\"\"\n    values = [1, 2, 3, 4]\n    result = aggregate(values)\n    assert result == sum(values) / len(values)\n    assert result == 2.5\n\n\ndef test_aggregate_returns_float_type():\n    \"\"\"返回值类型应为 float（规约后置条件：Python 3 真除法）。\"\"\"\n    result = aggregate([1, 2, 3, 4])\n    assert isinstance(result, float)\n\n\ndef test_aggregate_negative_elements():\n    \"\"\"含负数元素：返回值应为 sum(values)/len(values)。\"\"\"\n    values = [-1, -2, -3]\n    result = aggregate(values)\n    assert result == sum(values) / len(values)\n    assert result == -2.0\n\n\n# ---------------------------------------------------------------------------\n# 边界情况\n# ---------------------------------------------------------------------------\n\ndef test_aggregate_single_element():\n    \"\"\"单元素列表 [x]：len==1，返回值应等于该元素（float 化）。\"\"\"\n    values = [5]\n    result = aggregate(values)\n    assert result == sum(values) / len(values)\n    assert result == 5.0\n    assert isinstance(result, float)\n\n\ndef test_aggregate_all_zeros():\n    \"\"\"全零列表：sum 为 0，返回值应为 0.0 而非异常。\"\"\"\n    values = [0, 0, 0]\n    result = aggregate(values)\n    assert result == sum(values) / len(values)\n    assert result == 0.0\n\n\ndef test_aggregate_float_elements():\n    \"\"\"含浮点数元素：返回值应为 sum(values)/len(values)。\"\"\"\n    values = [1.5, 2.5]\n    result = aggregate(values)\n    assert result == sum(values) / len(values)\n    assert result == 2.0\n\n\ndef test_aggregate_positive_negative_cancel():\n    \"\"\"正负抵消：sum 为 0，返回值应为 0.0。\"\"\"\n    values = [-5, 5]\n    result = aggregate(values)\n    assert result == sum(values) / len(values)\n    assert result == 0.0\n\n\n