\", \"\"])\ndef test_lookup_return_type_is_int(key):\n    \"\"\"后置条件：返回值始终为 int。\n\n    期望值来源：规约后置条件\"返回值始终为 int\"。\n    \"\"\"\n    result = lookup(key)\n    assert isinstance(result, int)\n\n\ndef test_lookup_does_not_modify_table():\n    \"\"\"后置条件：lookup 不修改模块级 _TABLE。\n\n    期望值来源：规约后置条件\"不修改 _TABLE\"。\n    通过多次调用前后行为一致性间接验证（不直接访问 _TABLE 符号）。\n    \"\"\"\n    before = {k: lookup(k) for k in (\"alpha\", \"beta\", \"gamma\")}\n    # 触发若干未命中与命中调用\n    lookup(\"delta\")\n    lookup(\"\")\n    lookup(\"Alpha\")\n    after = {k: lookup(k) for k in (\"alpha\", \"beta\", \"gamma\")}\n    assert before == after\n    assert before == {\"alpha\": 1, \"beta\": 2, \"gamma\": 3}\n\n\n# ---------------------------------------------------------------------------\n# 类型约定外输入（违反前置条件）：期望值不明，记录实际行为\n# ---------------------------------------------------------------------------\n\ndef test_lookup_none_key_behavior():\n    \"\"\"边界：key 为 None，违反 str 类型注解前置条件。\n\n    期望值来源不明，需人工确认：规约未定义类型约定外输入的行为。\n    本用例仅记录实际行为，不臆造具体返回值；若实现抛异常则接受异常。\n    \"\"\"\n    try:\n        result = lookup(None)\n    except Exception as exc:  # noqa: BLE001 - 记录实际行为\n        # 实现选择抛异常也属合理，记录即可\n        assert exc is not None\n    else:\n        # 若未抛异常，仅断言返回类型为 int（规约后置条件），不臆造具体值\n        assert isinstance(result, int)\n\n\ndef test_lookup_non_string_key_behavior():\n    \"\"\"边界：key 为 int 123，违反 str 类型注解前置条件。\n\n    期望值来源不明，需人工确认：规约未定义类型约定外输入的行为。\n    本用例仅记录实际行为，不臆造具体返回值；若实现抛异常则接受异常。\n    \"\"\"\n    try:\n        result = lookup(123)\n    except Exception as exc:  # noqa: BLE001 - 记录实际行为\n        assert exc is not None\n    else:\n        assert isinstance(result, int)",
