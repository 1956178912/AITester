          "generated_test": "import pytest\n\nfrom task_0011 import distance\n\n\ndef test_distance_returns_difference_of_two_ints():\n    \"\"\"基本功能：distance(a, b) 应返回 a - b。\n\n    期望值来源：函数实现 `return a - b`（docstring 未提供，依据实现约定）。\n    \"\"\"\n    assert distance(5, 3) == 2\n\n\ndef test_distance_returns_negative_when_a_less_than_b():\n    \"\"\"当 a < b 时，distance 应返回负数。\n\n    期望值来源：函数实现 `return a - b`。\n    \"\"\"\n    assert distance(3, 5) == -2\n\n\ndef test_distance_returns_zero_when_equal():\n    \"\"\"当 a == b 时，distance 应返回 0。\n\n    期望值来源：函数实现 `return a - b`。\n    \"\"\"\n    assert distance(7, 7) == 0\n\n\n@pytest.mark.parametrize(\n    \"a, b, expected\",\n    [\n        (0, 0, 0),\n        (0, 5, -5),\n        (5, 0, 5),\n        (-1, -1, 0),\n        (-1, 1, -2),\n        (1, -1, 2),\n        (-5, -3, -2),\n        (100, 250, -150),\n    ],\n)\ndef test_distance_parametrized_cases(a, b, expected):\n    \"\"\"参数化验证多组整数输入的差值结果。\n\n    期望值来源：函数实现 `return a - b`。\n    \"\"\"\n    assert distance(a, b) == expected\n\n\ndef test_distance_with_large_integers():\n    \"\"\"大整数输入应返回正确的差值（Python int 无溢出）。\n\n    期望值来源：函数实现 `return a - b`。\n    \"\"\"\n    big = 10**18\n    assert distance(big, big - 1) == 1\n    assert distance(-big, big) == -2 * big\n\n\ndef test_distance_returns_int_type():\n    \"\"\"返回值类型应为 int。\n\n    期望值来源：函数签名 `-> int`。\n    \"\"\"\n    result = distance(10, 4)\n    assert isinstance(result, int)\n\n\ndef test_distance_antisymmetry():\n    \"\"\"distance(a, b) 与 distance(b, a) 应互为相反数。\n\n    期望值来源：函数实现 `return a - b` 的数学性质。\n    \"\"\"\n    a, b = 42, 17\n    assert distance(a, b) == -distance(b, a)\n\n\ndef test_distance_with_bool_inputs():\n    \"\"\"bool 是 int 的子类，distance(True, False) 应等于 1。\n\n    期望值来源：函数实现 `return a - b` 与 Python bool/int 语义。\n    \"\"\"\n    assert distance(True, False) == 1\n    assert distance(False, True) == -1\n\n\ndef test_distance_with_float_inputs():\n    \"\"\"传入 float 时按 Python 运算规则返回 float 差值。\n\n    期望值