-----------\n# 后置条件：返回值类型与下界\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\"n\", [-10, -1, 0, 1, 2, 3, 5, 10])\ndef test_fibonacci_returns_int_and_at_least_one(n):\n    \"\"\"规约后置条件：返回值为 int 且 result >= 1。\n\n    期望值来源：可执行规约子句 isinstance(result, int) 与 result >= 1。\n    \"\"\"\n    result = fibonacci(n)\n    assert isinstance(result, int)\n    assert result >= 1\n\n\n# ---------------------------------------------------------------------------\n# 错误 / 深度边界：n 很大\n# ---------------------------------------------------------------------------\n\ndef test_fibonacci_large_n_may_raise_recursion_error():\n    \"\"\"规约：n 过大时递归深度可能超出限制，触发 RecursionError。\n\n    期望值来源：自然语言规约「n 过大可能触发 RecursionError」。\n    具体阈值依赖解释器设置，无法确定具体返回值，因此仅断言\n    「要么抛出 RecursionError，要么返回满足后置条件的 int」，\n    不臆造具体数值。需人工确认实际阈值行为。\n    \"\"\"\n    try:\n        result = fibonacci(10000)\n    except RecursionError:\n        # 符合规约中「n 过大可能触发 RecursionError」的描述\n        return\n    # 若未触发递归错误，则必须满足后置条件\n    assert isinstance(result, int)\n    assert result >= 1",
