          "generated_test": "import pytest\n\nfrom task_0021 import split_words\n\n\n# ---------------------------------------------------------------------------\n# 正常路径\n# ---------------------------------------------------------------------------\n\ndef test_split_words_normal_two_words():\n    \"\"\"规约：返回列表由原字符串按单个空格字符 ' ' 分割得到。\n\n    输入 'hello world' 应得到 ['hello', 'world']。\n    \"\"\"\n    result = split_words(\"hello world\")\n    assert isinstance(result, list)\n    assert result == [\"hello\", \"world\"]\n\n\ndef test_split_words_normal_single_word_no_space():\n    \"\"\"规约：无空格字符串 'hello' 为边界情况，应返回单元素列表 ['hello']。\"\"\"\n    result = split_words(\"hello\")\n    assert isinstance(result, list)\n    assert result == [\"hello\"]\n\n\n# ---------------------------------------------------------------------------\n# 边界路径\n# ---------------------------------------------------------------------------\n\ndef test_split_words_boundary_empty_string():\n    \"\"\"规约：空字符串 '' 为边界情况。\n\n    按单个空格 ' ' 分割空字符串，结果应为包含一个空字符串的列表 ['']。\n    \"\"\"\n    result = split_words(\"\")\n    assert isinstance(result, list)\n    assert result == [\"\"]\n\n\ndef test_split_words_boundary_single_space():\n    \"\"\"规约：仅一个空格 ' ' 为边界情况。\n\n    按单个空格 ' ' 分割，应得到两个空字符串元素 ['', '']。\n    \"\"\"\n    result = split_words(\" \")\n    assert isinstance(result, list)\n    assert result == [\"\", \"\"]\n\n\ndef test_split_words_boundary_consecutive_spaces():\n    \"\"\"规约：连续多个空格 'a  b' 为边界情况。\n\n    按单个空格 ' ' 分割，连续空格之间产生空字符串元素，结果应为 ['a', '', 'b']。\n    \"\"\"\n    result = split_words(\"a  b\")\n    assert isinstance(result, list)\n    assert result == [\"a\", \"\", \"b\"]\n\n\ndef test_split_words_boundary_leading_space():\n    \"\"\"规约：前导空格 ' hello' 为边界情况。\n\n    按单个空格 ' ' 分割，前导空格产生首元素为空字符串，结果应为 ['', 'hello']。\n    \"\"\"\n    result = split_words(\" hello\")\n    assert isinstance(result, list)\n    assert result == [\"\", \"hello\"]\n\n\ndef test_split_words_boundary_trailing_space():\n    \"\"\"