          "generated_test": "import pytest\n\nfrom task_0029 import compute_scores\n\n\n# ---------------------------------------------------------------------------\n# Normal cases\n# ---------------------------------------------------------------------------\n\ndef test_compute_scores_normal_mapping():\n    \"\"\"正常多记录映射：验证基本 name→value 映射。\n\n    期望值来源：规约后置条件 scores[record.get(\"name\",\"unknown\")] == record.get(\"value\",0)。\n    \"\"\"\n    records = [{\"name\": \"a\", \"value\": 1}, {\"name\": \"b\", \"value\": 2}]\n    result = compute_scores(records)\n    assert isinstance(result, dict)\n    assert result == {\"a\": 1, \"b\": 2}\n\n\ndef test_compute_scores_returns_dict_type():\n    \"\"\"返回值类型：验证返回值为 dict。\n\n    期望值来源：规约后置条件 isinstance(result, dict)。\n    \"\"\"\n    result = compute_scores([{\"name\": \"a\", \"value\": 1}])\n    assert isinstance(result, dict)\n\n\ndef test_compute_scores_len_not_exceeding_records():\n    \"\"\"长度约束：验证 len(result) <= len(records)。\n\n    期望值来源：规约后置条件 len(result) <= len(records)。\n    \"\"\"\n    records = [{\"name\": \"a\", \"value\": 1}, {\"name\": \"b\", \"value\": 2}]\n    result = compute_scores(records)\n    assert len(result) <= len(records)\n\n\ndef test_compute_scores_keys_are_str_invariant():\n    \"\"\"键类型不变量：验证所有键均为 str。\n\n    期望值来源：规约不变量 all(isinstance(k, str) for k in result)。\n    \"\"\"\n    records = [{\"name\": \"a\", \"value\": 1}, {\"value\": 2}]\n    result = compute_scores(records)\n    assert all(isinstance(k, str) for k in result)\n\n\n# ---------------------------------------------------------------------------\n# Boundary cases\n# ---------------------------------------------------------------------------\n\ndef test_compute_scores_empty_list_returns_empty_dict():\n    \"\"\"空列表边界：验证空输入返回空字典。\n\n    期望值来源：规约边界情况 records 为空列表 → 返回 {}。\n    \"\"\"\n    result = compute_scores([])\n    assert result == {}\n    assert isinstance(result, dict)\n\n\ndef test_compute_scores_missing_name_defaults_unknown():\n    \"\"\"缺 name 边界：验证 name 缺省为 \"unknown\"。\n\n    期望值来源：规约边界情况 record 缺 name → 键为 \"unknown\"。\n    \"\"\"\n    records = [{\"value\": 5}]\n    result = compute_scores(records)\n    assert result == {\"unknown\": 5}\n\n\ndef test_compute_scores_missing_value_defaults_zero():\n    \"\"\"缺 value 边界：验证 value 缺省为 0。\n\n    期望值来源：规约边界情况 record 缺 value → 值为 0。\n    \"\"\"\n    records = [{\"name\": \"x\"}]\n    result = compute_scores(records)\n    assert result == {\"x\": 0}\n\n\ndef test_compute_scores_duplicate_name_last_wins():\n    \"\"\"同名覆盖边界：验证同名键后者覆盖前者。\n\n    期望值来源：规约边界情况 多个 record 同名 → 仅保留最后一个 value。\n    \"\"\"\n    records = [{\"name\": \"a\", \"value\": 1}, {\"name\": \"a\", \"value\": 9}]\n    result = compute_scores(records)\n    assert result == {\"a\": 9}\n\n\ndef test_compute_scores_negative_and_zero_values():\n    \"\"\"数值边界：验证 0 与负数 value 原样保留。\n\n    期望值来源：规约边界情况 value 为 0 / 负数 / 极大数。\n    \"\"\"\n    records = [{\"name\": \"n\", \"value\": -3}, {\"name\": \"z\", \"value\": 0}]\n    result = compute_scores(records)\n    assert result == {\"n\": -3, \"z\": 0}\n\n\ndef test_compute_scores_large_value_preserved():\n    \"\"\"极大数边界：验证极大 value 原样保留。\n\n    期望值来源：规约边界情况 value 为 0 / 负数 / 极大数。\n    \"\"\"\n    big = 10 ** 18\n    records = [{\"name\": \"big\", \"value\": big}]\n    result = compute_scores(records)\n    assert result == {\"big\": big}\n\n\ndef test_compute_scores_mixed_missing_keys():\n    \"\"\"混合缺省边界：同时缺 name 与缺 value 的记录。\n\n    期望值来源：规约边界情况 record 缺 name → \"unknown\"；缺 value → 0。\n    \"\"\"\n    records = [{\"name\": \"a\", \"value\": 1}, {\"value\": 2}, {\"name\": \"b\"}]\n    result = compute_scores(records)\n    assert result == {\"a\": 1, \"unknown\": 2, \"b\": 0}\n\n\n# ---------------------------------------------------------------------------\n# Error cases (precondition violations)\n# ---------------------------------------------------------------------------\n\ndef test_compute_scores_non_mapping_record_raises():\n    \