          "generated_test": "import pytest\n\nfrom task_0007 import is_freezing\n\n\ndef test_is_freezing_positive_returns_true():\n    \"\"\"正温度应判定为非冻结（celsius >= 0 分支）。\n\n    期望值来源：规约后置条件「返回 True 当且仅当 celsius >= 0」。\n    \"\"\"\n    assert is_freezing(25) is True\n\n\ndef test_is_freezing_zero_returns_true():\n    \"\"\"0 度是冻结/非冻结分界点，应返回 True。\n\n    期望值来源：规约边界情况「celsius = 0 返回 True」。\n    \"\"\"\n    assert is_freezing(0) is True\n\n\ndef test_is_freezing_negative_returns_false():\n    \"\"\"负温度应判定为冻结（celsius < 0 分支）。\n\n    期望值来源：规约后置条件「返回 False 当且仅当 celsius < 0」。\n    \"\"\"\n    assert is_freezing(-10) is False\n\n\ndef test_is_freezing_minus_one_returns_false():\n    \"\"\"-1 是最接近 0 的负数边界，应返回 False。\n\n    期望值来源：规约边界情况「celsius = -1」及后置条件 celsius < 0。\n    \"\"\"\n    assert is_freezing(-1) is False\n\n\ndef test_is_freezing_max_positive_int_returns_true():\n    \"\"\"极大正整数（2**31-1）应返回 True 且不溢出。\n\n    期望值来源：规约边界情况「celsius 为极大正整数（如 2**31-1）」。\n    \"\"\"\n    assert is_freezing(2**31 - 1) is True\n\n\ndef test_is_freezing_min_negative_int_returns_false():\n    \"\"\"极小负整数（-2**31）应返回 False。\n\n    期望值来源：规约边界情况「celsius 为极小负整数（如 -2**31）」。\n    \"\"\"\n    assert is_freezing(-2**31) is False\n\n\n@pytest.mark.parametrize(\n    \"celsius, expected\",\n    [\n        (1, True),\n        (100, True),\n        (2**31 - 1, True),\n        (0, True),\n        (-1, False),\n        (-100, False),\n        (-2**31, False),\n    ],\n)\ndef test_is_freezing_matches_sign_contract(celsius, expected):\n    \"\"\"参数化验证后置条件：返回值等价于 celsius >= 0。\n\n    期望值来源：规约后置条件「返回 True 当且仅当 celsius >= 0」。\n    \"\"\"\n    assert is_freezing(celsius) is expected\n\n\ndef test_is_freezing_return_type_is_bool():\n    \"\"\"返回值类型应为 bool。\n\n    期望值来源：函数签名 -> bool 及规约输出域「布尔值 True 或 False」。\n    \"\"\"\n    result = is_freezing(0)\n    assert isinstance(result, bool)",
