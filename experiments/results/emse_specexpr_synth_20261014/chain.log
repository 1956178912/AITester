          "generated_test": "import pytest\n\nfrom task_0071 import lookup\n\n\n# ---------------------------------------------------------------------------\n# 前置条件 fixture：_TABLE 已初始化为 {\"alpha\":1,\"beta\":2,\"gamma\":3}\n# 规约声明该前置条件成立，因此测试直接依赖它，不做任何修改。\n# ---------------------------------------------------------------------------\n@pytest.fixture\ndef table_snapshot():\n    \"\"\"记录 _TABLE 的初始内容，用于验证 lookup 不修改 _TABLE。\"\"\"\n    import task_0071\n\n    return dict(task_0071._TABLE)\n\n\n# ---------------------------------------------------------------------------\n# 主路径 - 命中\n# ---------------------------------------------------------------------------\n@pytest.mark.parametrize(\n    \"key, expected\",\n    [\n        (\"alpha\", 1),\n        (\"beta\", 2),\n        (\"gamma\", 3),\n    ],\n)\ndef test_lookup_hit_returns_table_value(key, expected):\n    \"\"\"命中 _TABLE 中的键时，返回对应的整数值。\n\n    期望值来源：规约前置条件 _TABLE = {\"alpha\":1,\"beta\":2,\"gamma\":3}。\n    \"\"\"\n    result = lookup(key)\n    assert result == expected\n    assert isinstance(result, int)\n\n\n# ---------------------------------------------------------------------------\n# 主路径 - 未命中\n# ---------------------------------------------------------------------------\n@pytest.mark.parametrize(\n    \"key\",\n    [\n        \"delta\",\n        \"\",\n        \"Alpha\",\n        \"ALPHA\",\n        \"alpha \",\n    ],\n)\ndef test_lookup_miss_returns_zero(key):\n    \"\"\"未命中 _TABLE 的键时返回 0。\n\n    期望值来源：规约描述\"未命中时返回 0\"。\n    覆盖边界：不存在键、空字符串、大小写变体。\n    \"\"\"\n    result = lookup(key)\n    assert result == 0\n    assert isinstance(result, int)\n\n\ndef test_lookup_none_key_returns_zero():\n    \"\"\"key 为 None 时返回 0。\n\n    期望值来源：规约边界情况说明\"key 为 None（类型注解为 str，\n    但运行时 dict.get 可接受任意可哈希对象）\"，未命中返回 0。\n    \"\"\"\n    result = lookup(None)\n    assert result == 0\n    assert isinstance(result, int)\n\n\n# ---------------------------------------------------------------------------\n# 后置条件：返回值始终为 int\n# ---------------------------------------------------------------------------\n@pytest.mark.parametrize(\n    \"key\",\n    [\"alpha\", \"beta\", \"gamma\", \"delta\", \"\", \"Alpha\", None],\n)\ndef test_lookup_return_type_is_int(key):\n    \"\"\"无论命中与否，返回值类型始终为 int。\n\n    期望值来源：规约后置条件\"返回值始终为 int\"。\n    \"\"\"\n    result = lookup(key)\n    assert isinstance(result, int)\n    assert not isinstance(result, bool) or result in (0, 1)\n\n\n# ---------------------------------------------------------------------------\n# 后置条件：不修改 _TABLE\n# ---------------------------------------------------------------------------\n@pytest.mark.parametrize(\n    \"key\",\n    [\"alpha\", \"beta\", \"gamma\", \"delta\", \"\", \"Alpha\", None],\n)\ndef test_lookup_does_not_modify_table(key, table_snapshot):\n    \"\"\"lookup 调用前后 _TABLE 内容保持不变。\n\n    期望值来源：规约后置条件\"不修改 _TABLE\"。\n    \"\"\"\n    import task_0071\n\n    lookup(key)\n    assert task_0071._TABLE == table_snapshot\n\n\n# ---------------------------------------------------------------------------\n# 幂等性 / 重复调用一致性（由后置条件推导的不变量）\n# ---------------------------------------------------------------------------\ndef test_lookup_repeated_calls_are_consistent():\n    \"\"\"对同一 key 重复调用返回相同结果，且不改变 _TABLE。\n\n    期望值来源：规约后置条件（返回值确定、不修改 _TABLE）。\n    \"\"\"\n    import task_0071\n\n    before = dict(task_0071._TABLE)\n    first = lookup(\"alpha\")\n    second = lookup(\"alpha\")\n    third = lookup(\"delta\")\n    fourth = lookup(\"delta\")\n\n    assert first == second == 1\n    assert third == fourth == 0\n    assert task_0071._TABLE == before",
