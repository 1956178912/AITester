          "generated_test": "import pytest\n\nfrom task_0068 import pick_label\n\n\n# ---------------------------------------------------------------------------\n# pick_label: 后置条件 —— score >= 90 返回 \"excellent\"\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\n    \"score\",\n    [90, 91, 100, 10**18],\n    ids=[\"boundary_90\", \"just_above_90\", \"typical_100\", \"huge_10e18\"],\n)\ndef test_pick_label_excellent_for_score_ge_90(score):\n    \"\"\"规约后置条件：score >= 90 时 pick_label 返回 \"excellent\"。\n\n    覆盖边界 score == 90（excellent 下边界）与极大整数 10**18。\n    期望值来源：自然语言规约后置条件。\n    \"\"\"\n    assert pick_label(score) == \"excellent\"\n\n\n# ---------------------------------------------------------------------------\n# pick_label: 后置条件 —— 60 <= score < 90 返回 \"pass\"\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\n    \"score\",\n    [60, 61, 75, 89],\n    ids=[\"boundary_60\", \"just_above_60\", \"typical_75\", \"boundary_89\"],\n)\ndef test_pick_label_pass_for_score_between_60_and_89(score):\n    \"\"\"规约后置条件：60 <= score < 90 时 pick_label 返回 \"pass\"。\n\n    覆盖边界 score == 60（pass 下边界）与 score == 89（pass 上边界）。\n    期望值来源：自然语言规约后置条件。\n    \"\"\"\n    assert pick_label(score) == \"pass\"\n\n\n# ---------------------------------------------------------------------------\n# pick_label: 后置条件 —— score < 60 隐式返回 None\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\n    \"score\",\n    [59, 0, -1, -100],\n    ids=[\"boundary_59\", \"zero\", \"negative_minus_1\", \"negative_minus_100\"],\n)\ndef test_pick_label_returns_none_for_score_lt_60(score):\n    \"\"\"规约后置条件：score < 60 时 pick_label 隐式返回 None。\n\n    覆盖边界 score == 59、0 以及负数。\n    期望值来源：自然语言规约后置条件（隐式返回 None）。\n    \"\"\"\n    assert pick_label(score) is None\n\n\n# ---------------------------------------------------------------------------\n# pick_label: 前置条件 —— score 必须为 int，非 int 比较抛 TypeError\n# ---------------------------------------------------------------------------\n\ndef test_pick_label_raises_type_error_for_none():\n    \"\"\"规约边界情况：score 为 None（非 int）时比较抛 TypeError。\n\n    期望值来源：自然语言规约边界情况（\"score 为 None 或非 int（类型错误，\n    比较抛 TypeError）\"）。异常类型由规约明示为 TypeError。\n    \"\"\"\n    with pytest.raises(TypeError):\n        pick_label(None)\n\n\ndef test_pick_label_raises_type_error_for_str():\n    \"\"\"规约边界情况：score 为非 int（字符串）时比较抛 TypeError。\n\n    期望值来源：自然语言规约边界情况（\"score 为 None 或非 int（类型错误，\n    比较抛 TypeError）\"）。\n    \"\"\"\n    with pytest.raises(TypeError):\n        pick_label(\"90\")\n\n\n# ---------------------------------------------------------------------------\n# pick_label: 前置条件可执行子句 —— isinstance(score, int)\n# ---------------------------------------------------------------------------\n\ndef test_pick_label_precondition_isinstance_int():\n    \"\"\"规约前置条件（可执行）：isinstance(score, int) 为真时函数可正常调用。\n\n    期望值来源：可执行规约前置子句。此处仅验证合法输入不抛异常且返回\n    符合后置条件的值。\n    \"\"\"\n    score = 75\n    assert isinstance(score, int)\n    result = pick_label(score)\n    assert result == \"pass\"\n\n\n# ---------------------------------------------------------------------------\n# pick_label: 后置条件可执行子句 —— 组合断言\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\n    \"score\",\n    [90, 89, 60, 59],\n    ids=[\"boundary_90\", \"boundary_89\", \"boundary_60\", \"boundary_59\"],\n)\ndef test_pick_label_postcondition_expr(score):\n    \"\"\"规约后置条件（可执行子句）：\n    score >= 90 and result == \"excellent\" or 60 <= score < 90 and result == \"pass\"。\n\n    对 score < 60 的输入，后置子句不覆盖（规约另有隐式 None 约定），\n    此处仅对 score >= 60 的输入断言该子句成立。\n    期望值来源：可执行规约后置子句。\n    \"\"\"\n    result = pick_label(score)\n    if score >= 60:\n        assert (score >= 90 and result == \"excellent\") or (\n            60 <= score < 90 and result == \"pass\"\n        )\n    else:\n        # score < 60：规约后置条件为隐式返回 None\n        assert result is None",
