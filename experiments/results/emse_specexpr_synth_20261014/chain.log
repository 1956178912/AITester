          "generated_test": "import pytest\n\nfrom task_0049 import compute_scores\n\n\ndef test_compute_scores_normal_multiple_records():\n    \"\"\"正常多记录：验证正常记录被正确映射为字典。\n\n    期望值来源：规约「返回 dict 的键集合等于各 record 的 name 集合」，\n    以及测试计划中 normal 用例的 expected_output。\n    \"\"\"\n    records = [\n        {\"name\": \"a\", \"value\": 1},\n        {\"name\": \"b\", \"value\": 2},\n    ]\n    result = compute_scores(records)\n    assert result == {\"a\": 1, \"b\": 2}\n\n\ndef test_compute_scores_empty_list_returns_empty_dict():\n    \"\"\"空列表：验证空输入返回空字典。\n\n    期望值来源：规约「空列表返回空字典」。\n    \"\"\"\n    result = compute_scores([])\n    assert result == {}\n\n\ndef test_compute_scores_missing_name_defaults_to_unknown():\n    \"\"\"缺失 name 键：验证 name 缺省为 \"unknown\"。\n\n    期望值来源：规约「name（缺省 \"unknown\"）」。\n    \"\"\"\n    records = [{\"value\": 5}]\n    result = compute_scores(records)\n    assert result == {\"unknown\": 5}\n\n\ndef test_compute_scores_missing_value_defaults_to_zero():\n    \"\"\"缺失 value 键：验证 value 缺省为 0。\n\n    期望值来源：规约「value（缺省 0）」。\n    \"\"\"\n    records = [{\"name\": \"x\"}]\n    result = compute_scores(records)\n    assert result == {\"x\": 0}\n\n\ndef test_compute_scores_duplicate_name_last_wins():\n    \"\"\"同名覆盖：验证同名键后者覆盖前者。\n\n    期望值来源：规约「同名键后者覆盖前者」。\n    \"\"\"\n    records = [\n        {\"name\": \"a\", \"value\": 1},\n        {\"name\": \"a\", \"value\": 9},\n    ]\n    result = compute_scores(records)\n    assert result == {\"a\": 9}\n\n\ndef test_compute_scores_negative_value_preserved():\n    \"\"\"value 为负数：验证负数 value 被原样保留。\n\n    期望值来源：规约「value 为 0 或负数」边界情况，值应原样保留。\n    \"\"\"\n    records = [{\"name\": \"n\", \"value\": -3}]\n    result = compute_scores(records)\n    assert result == {\"n\": -3}\n\n\ndef test_compute_scores_zero_value_preserved():\n    \"\"\"value 为 0：验证 0 值被原样保留（而非被缺省逻辑吞掉）。\n\n    期望值来源：规约「value 为 0 或负数」边界情况。\n    \"\"\"\n    records = [{\"name\": \"z\", \"value\": 0}]\n    result = compute_scores(records)\n    assert result