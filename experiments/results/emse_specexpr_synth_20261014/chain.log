          "generated_test": "import pytest\n\nfrom task_0048 import pick_label\n\n\n# ---------------------------------------------------------------------------\n# 正常路径：后置条件 score >= 90 -> \"excellent\"\n# ---------------------------------------------------------------------------\n\ndef test_pick_label_high_score_returns_excellent():\n    \"\"\"规约后置条件：score >= 90 时返回 \"excellent\"。\"\"\"\n    assert pick_label(95) == \"excellent\"\n\n\ndef test_pick_label_excellent_lower_boundary_90():\n    \"\"\"边界情况：score == 90 为 excellent 下边界，应返回 \"excellent\"。\"\"\"\n    assert pick_label(90) == \"excellent\"\n\n\ndef test_pick_label_large_value_returns_excellent():\n    \"\"\"边界情况：极大值 score 仍满足 score >= 90，应返回 \"excellent\"。\"\"\"\n    assert pick_label(1000000000) == \"excellent\"\n\n\n# ---------------------------------------------------------------------------\n# 正常路径：后置条件 60 <= score < 90 -> \"pass\"\n# ---------------------------------------------------------------------------\n\ndef test_pick_label_mid_score_returns_pass():\n    \"\"\"规约后置条件：60 <= score < 90 时返回 \"pass\"。\"\"\"\n    assert pick_label(75) == \"pass\"\n\n\ndef test_pick_label_pass_upper_boundary_89():\n    \"\"\"边界情况：score == 89 为 pass 上边界，应返回 \"pass\"。\"\"\"\n    assert pick_label(89) == \"pass\"\n\n\ndef test_pick_label_pass_lower_boundary_60():\n    \"\"\"边界情况：score == 60 为 pass 下边界，应返回 \"pass\"。\"\"\"\n    assert pick_label(60) == \"pass\"\n\n\n# ---------------------------------------------------------------------------\n# 边界路径：score < 60 -> 隐式返回 None\n# 期望值来源：规约明确写明 \"score < 60 时返回 None（隐式）\"\n# ---------------------------------------------------------------------------\n\ndef test_pick_label_below_60_boundary_59_returns_none():\n    \"\"\"边界情况：score == 59 无分支命中，规约约定隐式返回 None。\"\"\"\n    assert pick_label(59) is None\n\n\ndef test_pick_label_zero_returns_none():\n    \"\"\"边界情况：score == 0 无分支命中，规约约定隐式返回 None。\"\"\"\n    assert pick_label(0) is None\n\n\ndef test_pick_label_negative_returns_none():\n    \"\"\"边界情况：score 为负数无分支命中，规约约定隐式返回 None。\"\"\"\n    assert pick_label(-1) is None\n\n\n# ---------------------------------------------------------------------------\n# 不变量：返回值只能是 \"excellent\" / \"pass\" / None\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\n    \"score\",\n    [95, 90, 89, 75, 60, 59, 0, -1, 1000000000],\n)\ndef test_pick_label_invariant_result_domain(score):\n    \"\"\"不变量：返回值必须属于 {\"excellent\", \"pass\", None}。\"\"\"\n    result = pick_label(score)\n    assert result == \"excellent\" or result == \"pass\" or result is None\n\n\n# ---------------------------------------------------------------------------\n# 后置条件组合校验（可执行规约直接转写）\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\n    \"score, expected\",\n    [\n        (95, \"excellent\"),\n        (90, \"excellent\"),\n        (89, \"pass\"),\n        (75, \"pass\"),\n        (60, \"pass\"),\n        (59, None),\n        (0, None),\n        (-1, None),\n        (1000000000, \"excellent\"),\n    ],\n)\ndef test_pick_label_postcondition_mapping(score, expected):\n    \"\"\"可执行后置条件：score >= 90 -> \"excellent\"；60 <= score < 90 -> \"pass\"；\n    score < 60 -> None（规约约定）。\"\"\"\n    assert pick_label(score) == expected",
