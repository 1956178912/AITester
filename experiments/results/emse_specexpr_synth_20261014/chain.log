          "generated_test": "import pytest\n\nfrom task_0014 import distance\n\n\n# ---------------------------------------------------------------------------\n# 常规路径：后置条件 result == a - b\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\n    \"a, b, expected\",\n    [\n        (5, 3, 2),\n        (3, 5, -2),\n        (7, 7, 0),\n        (0, 4, -4),\n        (4, 0, 4),\n        (0, 0, 0),\n        (-5, -3, -2),\n        (5, -3, 8),\n        (-5, 3, -8),\n    ],\n)\ndef test_distance_postcondition_returns_difference(a, b, expected):\n    \"\"\"后置条件：返回值等于 a - b（期望值来源：规约 postconditions_expr）。\"\"\"\n    assert distance(a, b) == expected\n\n\n@pytest.mark.parametrize(\n    \"a, b\",\n    [\n        (5, 3),\n        (3, 5),\n        (7, 7),\n        (0, 4),\n        (4, 0),\n        (0, 0),\n        (-5, -3),\n        (5, -3),\n        (-5, 3),\n        (123456789, -987654321),\n    ],\n)\ndef test_distance_invariant_equals_a_minus_b(a, b):\n    \"\"\"不变量：result == a - b（期望值来源：规约 invariants_expr）。\"\"\"\n    result = distance(a, b)\n    assert result == a - b\n\n\n# ---------------------------------------------------------------------------\n# 边界情况\n# ---------------------------------------------------------------------------\n\ndef test_distance_equal_operands_returns_zero():\n    \"\"\"边界：a == b 时结果为 0（期望值来源：规约 edge_cases）。\"\"\"\n    assert distance(7, 7) == 0\n\n\ndef test_distance_a_is_zero():\n    \"\"\"边界：a == 0 时返回 -b（期望值来源：规约 edge_cases + 后置条件）。\"\"\"\n    assert distance(0, 4) == -4\n\n\ndef test_distance_b_is_zero():\n    \"\"\"边界：b == 0 时返回 a（期望值来源：规约 edge_cases + 后置条件）。\"\"\"\n    assert distance(4, 0) == 4\n\n\ndef test_distance_both_zero():\n    \"\"\"边界：a == 0 且 b == 0 时返回 0（期望值来源：规约 edge_cases）。\"\"\"\n    assert distance(0, 0) == 0\n\n\ndef test_distance_both_negative():\n    \"\"\"边界：两数均为负数（期望值来源：规约 edge_cases + 后置条件）。\"\"\"\n    assert distance(-5, -3) == -2\n\n\ndef test_distance_positive_minus_negative():\n    \"\"\"边界：a 为正、b 为负（期望值来源：规约 edge_cases + 后置条件）。\"\"\"\n    assert distance(5, -3) == 8\n\n\ndef test_distance_negative_minus_positive():\n    \"\"\"边界：a 为负、b 为正（期望值来源：规约 edge_cases + 后置条件）。\"\"\"\n    assert distance(-5, 3) == -8\n\n\ndef test_distance_large_integers():\n    \"\"\"边界：极大整数相减不溢出（期望值来源：规约 edge_cases + 后置条件）。\"\"\"\n    a = 10 ** 30\n    b = -(10 ** 30)\n    assert distance(a, b) == 2 * 10 ** 30\n\n\ndef test_distance_small_integers():\n    \"\"\"边界：极小整数相减不溢出（期望值来源：规约 edge_cases + 后置条件）。\"\"\"\n    a = -(10 ** 30)\n    b = 10 ** 30\n    assert distance(a, b) == -2 * 10 ** 30\n\n\n# ---------------------------------------------------------------------------\n# 前置条件违反：非 int 入参\n# ---------------------------------------------------------------------------\n\ndef test_distance_non_int_raises_type_error():\n    \"\"\"前置条件违反：字符串与整数相减应抛 TypeError。\n\n    期望值来源不明，需人工确认：规约仅约定 a、b 为 int，\n    未约定非 int 入参的具体异常类型与信息，此处仅断言抛出 TypeError。\n    \"\"\"\n    with pytest.raises(TypeError):\n        distance(\"5\", 3)\n\n\ndef test_distance_none_raises_type_error():\n    \"\"\"前置条件违反：None 参与减法应抛 TypeError。\n\n    期望值来源不明，需人工确认：规约未约定 None 入参的具体异常类型与信息，\n    此处仅断言抛出 TypeError。\n    \"\"\"\n    with pytest.raises(TypeError):\n        distance(None, 1)",
