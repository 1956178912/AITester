 期望值来源：规约中显式声明的后置条件 isinstance(result, int)。\n    \"\"\"\n    result = lookup(key)\n    assert isinstance(result, int)\n\n\n# ---------------------------------------------------------------------------\n# 后置条件：返回值属于 {0, 1, 2, 3}\n# ---------------------------------------------------------------------------\n@pytest.mark.parametrize(\n    \"key\",\n    [\"alpha\", \"beta\", \"gamma\", \"delta\", \"\", \"Alpha\", \"阿尔法\", \"a\" * 10000],\n)\ndef test_lookup_result_in_spec_range(key):\n    \"\"\"规约后置：result == 0 or result == 1 or result == 2 or result == 3。\n\n    期望值来源：规约中显式声明的可执行后置子句。\n    \"\"\"\n    result = lookup(key)\n    assert result in (0, 1, 2, 3)\n\n\n# ---------------------------------------------------------------------------\n# 不变量：result >= 0\n# ---------------------------------------------------------------------------\n@pytest.mark.parametrize(\n    \"key\",\n    [\"alpha\", \"beta\", \"gamma\", \"delta\", \"\", \"Alpha\", \"阿尔法\", \"a\" * 10000],\n)\ndef test_lookup_result_non_negative_invariant(key):\n    \"\"\"规约不变量：result >= 0。\n\n    期望值来源：规约中显式声明的可执行不变量子句。\n    \"\"\"\n    result = lookup(key)\n    assert result >= 0\n\n\n# ---------------------------------------------------------------------------\n# 边界：空字符串键\n# ---------------------------------------------------------------------------\ndef test_lookup_empty_string_key_returns_zero():\n    \"\"\"边界：空字符串不是 _TABLE 的键，应返回默认值 0。\n\n    期望值来源：规约边界情况\"key 为空字符串 ''（未命中，返回 0）\"。\n    \"\"\"\n    assert lookup(\"\") == 0\n\n\n# ---------------------------------------------------------------------------\n# 边界：大小写变体键\n# ---------------------------------------------------------------------------\n@pytest.mark.parametrize(\"key\", [\"Alpha\", \"ALPHA\", \"aLpHa\", \"BETA\", \"Gamma\"])\ndef test_lookup_case_variant_keys_return_zero(key):\n    \"\"\"边界：字典键区分大小写，大小写变体未命中，应返回 0。\n\n    期望值来源：规约边界情况\"key 为大小写变体如 'Alpha'/'ALPHA'\n    （字典键区分大小写，未命中返回 0）\"。\n    \"\"\"\n    assert lookup(key) == 0\n\n\n# --------