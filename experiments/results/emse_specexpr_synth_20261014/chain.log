9999999],\n)\ndef test_pick_label_invariant_output_domain(score):\n    \"\"\"规约不变量：返回值必须属于 {\"excellent\", \"pass\", None}。\n\n    期望值来源：SpecExpr 不变量子句\n    `result == \"excellent\" or result == \"pass\" or result is None`。\n    \"\"\"\n    result = pick_label(score)\n    assert result == \"excellent\" or result == \"pass\" or result is None\n\n\n# ---------------------------------------------------------------------------\n# 前置条件：score 必须为 int；非 int 输入应触发异常\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\n    \"bad_score\",\n    [\"90\", None, 90.0, [90], {\"score\": 90}],\n)\ndef test_pick_label_invalid_type_raises(bad_score):\n    \"\"\"前置条件：score 为 int 类型。\n\n    非 int 输入违反前置条件，期望抛出异常。\n    期望值来源：SpecExpr 前置子句 `isinstance(score, int)`；\n    具体异常类型由运行时决定，故仅断言抛出 Exception 子类。\n    \"\"\"\n    with pytest.raises(Exception):\n        pick_label(bad_score)",
