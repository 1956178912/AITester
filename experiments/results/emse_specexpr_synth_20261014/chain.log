          "generated_test": "import pytest\n\nfrom task_0001 import initials\n\n\n# ---------------------------------------------------------------------------\n# 正常路径\n# ---------------------------------------------------------------------------\n\ndef test_initials_two_part_name():\n    \"\"\"规约：各部分首字母大写后以 '.' 连接。'john doe' -> 'J.D'\"\"\"\n    assert initials(\"john doe\") == \"J.D\"\n\n\ndef test_initials_three_part_name():\n    \"\"\"规约：多段姓名每段首字母均被提取。'john ronald doe' -> 'J.R.D'\"\"\"\n    assert initials(\"john ronald doe\") == \"J.R.D\"\n\n\ndef test_initials_single_part_name():\n    \"\"\"规约：单段姓名只返回一个首字母。'alice' -> 'A'\"\"\"\n    assert initials(\"alice\") == \"A\"\n\n\ndef test_initials_already_uppercase():\n    \"\"\"规约：已大写输入仍正确返回。'John Doe' -> 'J.D'\"\"\"\n    assert initials(\"John Doe\") == \"J.D\"\n\n\ndef test_initials_returns_str_type():\n    \"\"\"后置条件：返回值为 str。\"\"\"\n    result = initials(\"john doe\")\n    assert isinstance(result, str)\n\n\n# ---------------------------------------------------------------------------\n# 边界情况\n# ---------------------------------------------------------------------------\n\ndef test_initials_empty_string():\n    \"\"\"边界：空字符串 '' -> split() 返回 []，join 返回 ''。\"\"\"\n    assert initials(\"\") == \"\"\n\n\ndef test_initials_whitespace_only():\n    \"\"\"边界：纯空白 '   ' -> split() 返回 []，返回 ''。\"\"\"\n    assert initials(\"   \") == \"\"\n\n\ndef test_initials_multiple_spaces():\n    \"\"\"边界：多空格分隔 'a  b' -> split() 自动忽略多余空白。\"\"\"\n    assert initials(\"a  b\") == \"A.B\"\n\n\ndef test_initials_leading_trailing_whitespace():\n    \"\"\"边界：首尾空白被 split 自动忽略。'  john doe  ' -> 'J.D'\"\"\"\n    assert initials(\"  john doe  \") == \"J.D\"\n\n\ndef test_initials_single_character():\n    \"\"\"边界：单字符名 'a' -> 'A'。\"\"\"\n    assert initials(\"a\") == \"A\"\n\n\ndef test_initials_non_ascii_character():\n    \"\"\"边界：非 ASCII 字符 'é'，upper() 行为依赖 Unicode。\n\n    规约仅说明 upper() 依赖 Unicode，未给出具体期望值，\n    故此处记录实际行为并断言其为 str，需人工确认。\n    \"