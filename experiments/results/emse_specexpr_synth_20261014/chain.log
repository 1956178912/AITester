          "generated_test": "import pytest\n\nfrom task_0015 import split_words\n\n\n# ---------------------------------------------------------------------------\n# 正常路径\n# ---------------------------------------------------------------------------\n\ndef test_split_words_normal_two_words():\n    \"\"\"普通多词字符串：按单个空格分割为两个子串。\n\n    期望值来源：规约「返回列表由输入字符串按空格字符分割得到」。\n    \"\"\"\n    result = split_words(\"hello world\")\n    assert result == [\"hello\", \"world\"]\n\n\ndef test_split_words_no_space_returns_single_element():\n    \"\"\"无空格字符串：返回仅含原字符串的单元素列表。\n\n    期望值来源：规约边界情况「无空格'hello'」。\n    \"\"\"\n    result = split_words(\"hello\")\n    assert result == [\"hello\"]\n\n\n# ---------------------------------------------------------------------------\n# 边界情况\n# ---------------------------------------------------------------------------\n\ndef test_split_words_empty_string():\n    \"\"\"空字符串：按空格分割得到包含一个空字符串的列表。\n\n    期望值来源：规约边界情况「空字符串''」。\n    \"\"\"\n    result = split_words(\"\")\n    assert result == [\"\"]\n\n\ndef test_split_words_single_space():\n    \"\"\"单个空格：分割为两个空字符串。\n\n    期望值来源：规约边界情况「单个空格' '」。\n    \"\"\"\n    result = split_words(\" \")\n    assert result == [\"\", \"\"]\n\n\ndef test_split_words_consecutive_spaces():\n    \"\"\"连续空格：产生空字符串元素。\n\n    期望值来源：规约边界情况「多个连续空格'   '」及按空格分割语义。\n    \"\"\"\n    result = split_words(\"a  b\")\n    assert result == [\"a\", \"\", \"b\"]\n\n\ndef test_split_words_leading_and_trailing_spaces():\n    \"\"\"首尾空格：产生首尾空字符串元素。\n\n    期望值来源：规约边界情况「首尾空格' hello '」。\n    \"\"\"\n    result = split_words(\" hello \")\n    assert result == [\"\", \"hello\", \"\"]\n\n\ndef test_split_words_only_spaces():\n    \"\"\"仅多个空格：三个空格分割为四个空字符串。\n\n    期望值来源：规约边界情况「多个连续空格'   '」及按空格分割语义。\n    \"\"\"\n    result = split_words(\"   \")\n    assert result == [\"\", \"\", \"\", \"\"]\n\n\ndef test_split_words_tab_not_split():\n    \"\"\"含制表符：制表符不是空格，不被分割。\n\n    期望值来源：规约边界情况「含制表符'hello\\\\tworld'（制表符不是空格，不会被分割）」。\n    \"\"\"\n    result = split_words(\"hello\\tworld\")\n    assert result == [\"hello\\tworld\"]\n\n\ndef test_split_words_newline_not_split():\n    \"\"\"含换行符：换行符不是空格，不被分割。\n\n    期望值来源：规约边界情况「含换行符'hello\\\\nworld'（换行符不是空格，不会被分割）」。\n    \"\"\"\n    result = split_words(\"hello\\nworld\")\n    assert result == [\"hello\\nworld\"]\n\n\ndef test_split_words_long_string():\n    \"\"\"超长字符串：按空格分割后元素数量与拼接一致。\n\n    期望值来源：规约边界情况「超长字符串」及按空格分割语义。\n    \"\"\"\n    text = \" \".join([\"word\"] * 1000)\n    result = split_words(text)\n    assert result == [\"word\"] * 1000\n\n\n# ---------------------------------------------------------------------------\n# 后置条件 / 不变量\n# ---------------------------------------------------------------------------\n\ndef test_split_words_returns_list_type():\n    \"\"\"后置条件：返回值类型为 list。\n\n    期望值来源：规约后置条件「返回值为list类型」。\n    \"\"\"\n    result = split_words(\"hello world\")\n    assert isinstance(result, list)\n\n\ndef test_split_words_elements_are_str():\n    \"\"\"后置条件：返回列表元素均为 str 类型。\n\n    期望值来源：规约后置条件「返回列表元素均为str类型」。\n    \"\"\"\n    result = split_words(\"a b c\")\n    assert all(isinstance(item, str) for item in result)\n\n\ndef test_split_words_does_not_modify_input():\n    \"\"\"后置条件：不修改原字符串（字符串不可变，验证内容不变）。\n\n    期望值来源：规约后置条件「不修改原字符串」。\n    \"\"\"\n    original = \"hello world\"\n    text = original\n    split_words(text)\n    assert text == original\n\n\ndef test_split_words_join_roundtrip():\n    \"\"\"不变量：用空格重新拼接结果应还原原字符串。\n\n    期望值来源：规约「返回列表由输入字符串按空格字符分割得到」。\n    \"\"\"\n    text = \"a b  c \"\n    result = split_words(text)\n    assert \" \".join(result) == text\n\n\n# ---------------------------------------------------------------------------\n# 异常路径（前置条件：text 必须是 str）\n# ---------------------------------------------------------------------------\n\ndef test_split_words_non_str_int_raises():\n    \"\"\"非字符串输入（int）：违反前置条件，期望抛出异常。\n\n    期望值来源：规约前置条件「输入参数text必须是str类型」。\n    具体异常类型未在规约中明确，故接受任意异常。\n    \"\"\"\n    with pytest.raises(Exception):\n        split_words(123)\n\n\ndef test_split_words_non_str_none_raises():\n    \"\"\"非字符串输入（None）：违反前置条件，期望抛出异常。\n\n    期望值来源：规约前置条件「输入参数text必须是str类型」。\n    具体异常类型未在规约中明确，故接受任意异常。\n    \"\"\"\n    with pytest.raises(Exception):\n        split_words(None)",
