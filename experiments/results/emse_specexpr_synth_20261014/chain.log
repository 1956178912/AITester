          "generated_test": "import math\n\nimport pytest\n\nfrom task_0083 import aggregate\n\n\ndef test_aggregate_normal_multi_int_list():\n    \"\"\"规约后置：result == sum(values)/len(values)，多元素整数列表主路径。\"\"\"\n    values = [1, 2, 3, 4]\n    result = aggregate(values)\n    assert result == sum(values) / len(values)\n    assert result == 2.5\n\n\ndef test_aggregate_single_element_list():\n    \"\"\"边界：单元素列表 [x]，结果等于 x（规约边界情况）。\"\"\"\n    values = [5]\n    result = aggregate(values)\n    assert result == sum(values) / len(values)\n    assert result == 5.0\n\n\ndef test_aggregate_negative_values():\n    \"\"\"规约后置：含负数列表平均值可能为负，且等于 sum/len。\"\"\"\n    values = [-1, -2, -3]\n    result = aggregate(values)\n    assert result == sum(values) / len(values)\n    assert result == -2.0\n\n\ndef test_aggregate_float_values():\n    \"\"\"规约后置：含浮点数列表结果为浮点平均值，等于 sum/len。\"\"\"\n    values = [1.5, 2.5, 3.0]\n    result = aggregate(values)\n    assert result == sum(values) / len(values)\n    assert result == pytest.approx(2.3333333333333335)\n\n\ndef test_aggregate_all_zeros():\n    \"\"\"边界：全零列表结果为 0.0（规约边界情况）。\"\"\"\n    values = [0, 0, 0]\n    result = aggregate(values)\n    assert result == sum(values) / len(values)\n    assert result == 0.0\n\n\ndef test_aggregate_result_type_is_float():\n    \"\"\"规约后置：返回值类型为 float（int/int 除法产生 float）。\"\"\"\n    result = aggregate([1, 2, 3, 4])\n    assert isinstance(result, float)\n\n\ndef test_aggregate_result_within_min_max_bounds():\n    \"\"\"规约后置：返回值位于 min(values) 与 max(values) 之间（含端点）。\"\"\"\n    values = [-4, 0, 7, 3]\n    result = aggregate(values)\n    assert min(values) <= result <= max(values)\n\n\ndef test_aggregate_large_numbers_overflow():\n    \"\"\"边界：大数列表可能溢出为 inf。\n\n    期望值来源不明，需人工确认：规约仅说明\"可能产生浮点精度损失或\n    溢出为 inf\"，未约定确定值。此处仅记录实际行为，断言其与\n    sum(values)/len(values) 一致（规约后置），不臆造具体数值。\n    \"\"\"\n    values = [1e308, 1e308]\n    result = aggregate(values)\n    assert result == sum(values) / len(values)\n\n\ndef test_aggregate_empty_list_raises_zero_division_error():\n    \"\"\"异常路径：空列表 len==0 触发 ZeroDivisionError（规约边界情况）。\"\"\"\n    with pytest.raises(ZeroDivisionError):\n        aggregate([])\n\n\ndef test_aggregate_non_numeric_elements_raises_type_error():\n    \"\"\"异常路径：非数值元素使 sum(values, 0) 抛 TypeError。\n\n    期望值来自 Python 内置 sum 行为（规约前置：元素需支持与 0 相加）。\n    \"\"\"\n    with pytest.raises(TypeError):\n        aggregate([\"a\", \"b\"])",
