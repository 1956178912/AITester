t)\n\n\n# ---------------------------------------------------------------------------\n# 异常路径：不可哈希键\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\n    \"key\",\n    [\n        [\"alpha\"],\n        {\"alpha\": 1},\n        {\"alpha\"},\n    ],\n)\ndef test_lookup_unhashable_key_raises_type_error(key):\n    \"\"\"边界情况：key 为不可哈希类型（如 list）会抛 TypeError。\n\n    期望值来源：规约边界情况明确说明不可哈希键抛 TypeError。\n    \"\"\"\n    with pytest.raises(TypeError):\n        lookup(key)\n\n\n# ---------------------------------------------------------------------------\n# 后置条件：不修改 _TABLE\n# ---------------------------------------------------------------------------\n\ndef test_lookup_does_not_modify_table():\n    \"\"\"后置条件：lookup 调用后 _TABLE 保持不变。\n\n    期望值来源：规约后置条件「不修改 _TABLE」。\n    \"\"\"\n    import task_0062\n\n    before = dict(task_0062._TABLE)\n    lookup(\"alpha\")\n    lookup(\"delta\")\n    lookup(\"\")\n    lookup(None)\n    after = dict(task_0062._TABLE)\n    assert after == before\n    assert after == _EXPECTED_TABLE\n\n\n# ---------------------------------------------------------------------------\n# 后置条件：对任意 str 输入均返回 int，不抛异常\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\n    \"key\",\n    [\n        \"alpha\",\n        \"beta\",\n        \"gamma\",\n        \"delta\",\n        \"\",\n        \" \",\n        \"0\",\n        \"None\",\n        \"alpha\\n\",\n        \"α\",\n    ],\n)\ndef test_lookup_any_str_returns_int_without_exception(key):\n    \"\"\"后置条件：对任意 str 输入均返回 int，不抛异常。\n\n    期望值来源：规约后置条件。仅断言返回类型为 int，不断言具体数值\n    （除已由前置条件确定的键外）。\n    \"\"\"\n    result = lookup(key)\n    assert isinstance(result, int)\n    assert not isinstance(result, bool)",
