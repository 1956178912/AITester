          "generated_test": "import pytest\n\nfrom task_0058 import is_palindrome\n\n\n# ---------------------------------------------------------------------------\n# 正常用例\n# ---------------------------------------------------------------------------\n\ndef test_is_palindrome_even_length_palindrome():\n    \"\"\"偶数长度回文 'abba' 应返回 True（规约：result == (s == s[::-1])）。\"\"\"\n    s = \"abba\"\n    assert is_palindrome(s) == (s == s[::-1])\n    assert is_palindrome(s) is True\n\n\ndef test_is_palindrome_odd_length_palindrome():\n    \"\"\"奇数长度回文 'abcba' 应返回 True（规约：result == (s == s[::-1])）。\"\"\"\n    s = \"abcba\"\n    assert is_palindrome(s) == (s == s[::-1])\n    assert is_palindrome(s) is True\n\n\ndef test_is_palindrome_non_palindrome():\n    \"\"\"普通非回文 'hello' 应返回 False（规约：result == (s == s[::-1])）。\"\"\"\n    s = \"hello\"\n    assert is_palindrome(s) == (s == s[::-1])\n    assert is_palindrome(s) is False\n\n\n# ---------------------------------------------------------------------------\n# 边界用例\n# ---------------------------------------------------------------------------\n\ndef test_is_palindrome_empty_string():\n    \"\"\"空字符串反转仍为空串，规约明确应为 True。\"\"\"\n    s = \"\"\n    assert is_palindrome(s) == (s == s[::-1])\n    assert is_palindrome(s) is True\n\n\ndef test_is_palindrome_single_character():\n    \"\"\"单字符反转等于自身，规约明确应为 True。\"\"\"\n    s = \"a\"\n    assert is_palindrome(s) == (s == s[::-1])\n    assert is_palindrome(s) is True\n\n\ndef test_is_palindrome_two_identical_characters():\n    \"\"\"最小偶数长度回文 'aa'，规约明确应为 True。\"\"\"\n    s = \"aa\"\n    assert is_palindrome(s) == (s == s[::-1])\n    assert is_palindrome(s) is True\n\n\ndef test_is_palindrome_two_different_characters():\n    \"\"\"最小非回文 'ab'，规约明确应为 False。\"\"\"\n    s = \"ab\"\n    assert is_palindrome(s) == (s == s[::-1])\n    assert is_palindrome(s) is False\n\n\ndef test_is_palindrome_with_spaces():\n    \"\"\"含空格回文 'a b a' 按字符比较，规约明确应为 True（不做空白归一化）。\"\"\"\n    s = \"a b a\"\n    assert is_palindrome(s) == (s == s[::-1])\n    assert is_palindrome(s) is True\n\n\ndef test_is_palindrome_case_sensitive():\n    \"\"\"大小写敏感：'Aa' 反转后为 'aA'，规约明确应为 False。\"\"\"\n    s = \"Aa\"\n    assert is_palindrome(s) == (s == s[::-1])\n    assert is_palindrome(s) is False\n\n\n# ---------------------------------------------------------------------------\n# 后置条件一致性（参数化，覆盖多种合法 str 输入）\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\n    \"s\",\n    [\n        \"\",\n        \"a\",\n        \"aa\",\n        \"ab\",\n        \"abba\",\n        \"abcba\",\n        \"hello\",\n        \"a b a\",\n        \"Aa\",\n        \"A man, a plan, a canal: Panama\",\n        \"racecar\",\n        \"not a palindrome\",\n        \"12321\",\n        \"12345\",\n        \"!@#$%^&*()\",\n        \"()*&^%$#@!\",\n        \"中文回文测试\",\n        \"上海自来水来自海上\",\n        \"😀😀\",\n        \"😀a😀\",\n    ],\n)\ndef test_is_palindrome_postcondition_matches_reverse_equality(s):\n    \"\"\"后置条件：返回值必须等于 (s == s[::-1])，覆盖多种合法 str 输入。\"\"\"\n    assert is_palindrome(s) == (s == s[::-1])\n\n\n@pytest.mark.parametrize(\n    \"s\",\n    [\n        \"\",\n        \"a\",\n        \"aa\",\n        \"abba\",\n        \"abcba\",\n        \"a b a\",\n        \"racecar\",\n        \"上海自来水来自海上\",\n    ],\n)\ndef test_is_palindrome_true_implies_characterwise_equal(s):\n    \"\"\"后置条件：若返回 True，则 s 与其反转逐字符相等。\"\"\"\n    result = is_palindrome(s)\n    if result:\n        assert s == s[::-1]\n        assert list(s) == list(s[::-1])\n\n\n@pytest.mark.parametrize(\n    \"s\",\n    [\n        \"ab\",\n        \"hello\",\n        \"Aa\",\n        \"not a palindrome\",\n        \"12345\",\n    ],\n)\ndef test_is_palindrome_false_implies_some_position_differs(s):\n    \"\"\"后置条件：若返回 False，则 s 与其反转至少有一个位置字符不同。\"\"\"\n    result = is_palindrome(s)\n    if not result:\n        assert s != s[::-1]\n        assert any(a != b for a, b in zip(s, s[::-1]))\n\n\n# ---------------------------------------------------------------------------\n# 错误路径：非 str 类型输入\n# ---------------------------------------------------------------------------\n\ndef test_is_palindrome_none_raises_type_error():\n    \"\"\"非 str 类型 None 传入：规约指出会触发 TypeError 或返回非预期结果。\n\n    期望值来源：规约边界情况明确列出 None 会触发 TypeError 或返回非预期结果。\n    此处按规约的异常路径断言 TypeError；若实现返回非预期结果而非抛异常，\n    该用例将失败并暴露规约与实现的不一致，需人工确认。\n    \"\"\"\n    with pytest.raises(TypeError):\n        is_palindrome(None)\n\n\ndef test_is_palindrome_int_raises_type_error():\n    \"\"\"非 str 类型 int 传入：规约指出会触发 TypeError 或返回非预期结果。\n\n    期望值来源：规约边界情况明确列出 int 会触发 TypeError 或返回非预期结果。\n    此处按规约的异常路径断言 TypeError；若实现返回非预期结果而非抛异常，\n    该用例将失败并暴露规约与实现的不一致，需人工确认。\n    \"\"\"\n    with pytest.raises(TypeError):\n        is_palindrome(12321)\n\n\ndef test_is_palindrome_list_raises_type_error():\n    \"\"\"非 str 类型 list 传入：规约指出会触发 TypeError 或返回非预期结果。\n\n    期望值来源：规约边界情况明确列出 list 会触发 TypeError 或返回非预期结果。\n    此处按规约的异常路径断言 TypeError；若实现返回非预期结果而非抛异常，\n    该用例将失败并暴露规约与实现的不一致，需人工确认。\n    \"\"\"\n    with pytest.raises(TypeError):\n        is_palindrome([1, 2, 3])",
