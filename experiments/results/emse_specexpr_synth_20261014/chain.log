          "rag_stats": null,
          "patch": "python\ndef _better(current: int, candidate: int) -> bool:\n    return candidate > current\n\n\ndef best_score(scores: list) -> int:\n    best = scores[0]\n    for s in scores[1:]:\n        if _better(best, s):\n            best = s\n    return best\n\n\ndef worst_score(scores: list) -> int:\n    worst = scores[0]\n    for s in scores[1:]:\n        if not _better(worst, s):\n            worst = s\n    return worst\n# noise_seed=2162\n",
          "generated_test": "import pytest\n\nfrom task_0007 import best_score\n\n\n# ---------------------------------------------------------------------------\n# 规约驱动的辅助断言\n# ---------------------------------------------------------------------------\n\ndef _assert_best_postconditions(scores, result):\n    \"\"\"断言 best_score 的后置条件：返回值属于 scores 且不小于任意元素。\"\"\"\n    assert result in scores\n    assert all(result >= s for s in scores)\n\n\n# ---------------------------------------------------------------------------\n# best_score 正常 / 边界用例\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\n    \"scores, expected\",\n    [\n        ([5], 5),\n        ([1, 2, 3, 4, 5], 5),\n        ([5, 4, 3, 2, 1], 5),\n        ([7, 7, 7], 7),\n        ([-3, -1, -2], -1),\n        ([0, -5, 3], 3),\n        ([3, 1, 3, 2, 3], 3),\n        ([-10, -10, -20], -10),\n    ],\n)\ndef test_best_score_returns_maximum(scores, expected):\n    \"\"\"best_score 应返回列表中的最大值。\n\n    期望值来源：规约后置条件（返回值属于 scores 且不小于任意元素），\n    对给定输入唯一确定为列表最大值。\n    \"\"\"\n    result = best_score(scores)\n    assert result == expected\n    _assert_best_postconditions(scores, result)\n\n\n@pytest.mark.parametrize(\n    \"scores\",\n    [\n        [5],\n        [1, 2, 3, 4, 5],\n        [5, 4, 3, 2, 1],\n        [7, 7, 7],\n        [-3, -1, -2],\n        [0, -5, 3],\n        [42, 42, 1, 42],\n    ],\n)\ndef test_best_score_postconditions_hold(scores):\n    \"\"\"对任意满足前置条件的输入，best_score 的后置条件必须成立。\n\n    期望值来源：规约后置条件（result in scores；all(result >= s)）。\n    \"\"\"\n    result = best_score(scores)\n    _assert_best_postconditions(scores, result)\n\n\ndef test_best_score_single_element_returns_element():\n    \"\"\"单元素列表：返回值即该唯一元素。\n\n    期望值来源：规约后置条件（返回值属于 scores），单元素时唯一确定。\n    \"\"\"\n    result = best_score([5])\n    assert result == 5\n\n\ndef test_best_score_all_equal_returns_common_value():\n    \"\"\"全部元素相等：返回值等于该公共值。\n\n    期望值来源：规约后置条件（返回值属于 scores），全相等时唯一确定。\n    \"\"\"\n    result = best_score([7, 7, 7])\n    assert result == 7\n\n\ndef test_best_score_ascending_returns_last():\n    \"\"\"升序列表：最大值为末元素。\n\n    期望值来源：规约后置条件（返回值不小于任意元素）。\n    \"\"\"\n    scores = [1, 2, 3, 4, 5]\n    assert best_score(scores) == 5\n\n\ndef test_best_score_descending_returns_first():\n    \"\"\"降序列表：最大值为首元素。\n\n    期望值来源：规约后置条件（返回值不小于任意元素）。\n    \"\"\"\n    scores = [5, 4, 3, 2, 1]\n    assert best_score(scores) == 5\n\n\ndef test_best_score_with_negatives_returns_least_negative():\n    \"\"\"含负数列表：最大值为最接近零的负数。\n\n    期望值来源：规约后置条件（返回值不小于任意元素）。\n    \"\"\"\n    scores = [-3, -1, -2]\n    assert best_score(scores) == -1\n\n\ndef test_best_score_with_zero_returns_positive_max():\n    \"\"\"含 0 的混合列表：最大值为正数元素。\n\n    期望值来源：规约后置条件（返回值不小于任意元素）。\n    \"\"\"\n    scores = [0, -5, 3]\n    assert best_score(scores) == 3\n\n\ndef test_best_score_duplicate_maximum_returns_max_value():\n    \"\"\"含重复最大值：返回值仍为该最大值。\n\n    期望值来源：规约后置条件（返回值不小于任意元素）。\n    \"\"\"\n    scores = [3, 1, 3, 2, 3]\n    assert best_score(scores) == 3\n\n\n# ---------------------------------------------------------------------------\n# best_score 错误用例\n# ---------------------------------------------------------------------------\n\ndef test_best_score_empty_list_raises_index_error():\n    \"\"\"空列表违反前置条件 len(scores) > 0。\n\n    规约边界情况明确：空列表应抛 IndexError。\n    期望值来源：规约边界情况（空列表 IndexError）。\n    \"\"\"\n    with pytest.raises(IndexError):\n        best_score([])",
