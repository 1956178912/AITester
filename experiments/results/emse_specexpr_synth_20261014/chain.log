          "generated_test": "import pytest\n\nfrom task_0020 import compare\n\n\n# ---------------------------------------------------------------------------\n# 正常分支用例\n# ---------------------------------------------------------------------------\n\ndef test_compare_a_greater_than_b_returns_1():\n    \"\"\"规约：a > b 时返回 1。输入 (5, 3)。\"\"\"\n    assert compare(5, 3) == 1\n\n\ndef test_compare_a_less_than_b_returns_minus_1():\n    \"\"\"规约：a < b 时返回 -1。输入 (3, 5)。\"\"\"\n    assert compare(3, 5) == -1\n\n\ndef test_compare_a_equal_to_b_returns_0():\n    \"\"\"规约：a == b 时返回 0。输入 (4, 4)。\"\"\"\n    assert compare(4, 4) == 0\n\n\n# ---------------------------------------------------------------------------\n# 边界用例\n# ---------------------------------------------------------------------------\n\ndef test_compare_adjacent_integers_returns_minus_1():\n    \"\"\"边界：相邻整数（差 1），a=1, b=2，规约 a < b 返回 -1。\"\"\"\n    assert compare(1, 2) == -1\n\n\ndef test_compare_adjacent_integers_reversed_returns_1():\n    \"\"\"边界：相邻整数（差 1），a=2, b=1，规约 a > b 返回 1。\"\"\"\n    assert compare(2, 1) == 1\n\n\ndef test_compare_zero_and_zero_returns_0():\n    \"\"\"边界：a=0, b=0，规约 a == b 返回 0。\"\"\"\n    assert compare(0, 0) == 0\n\n\ndef test_compare_zero_and_positive_returns_minus_1():\n    \"\"\"边界：a=0, b=1，规约 a < b 返回 -1。\"\"\"\n    assert compare(0, 1) == -1\n\n\ndef test_compare_positive_and_zero_returns_1():\n    \"\"\"边界：a=1, b=0，规约 a > b 返回 1。\"\"\"\n    assert compare(1, 0) == 1\n\n\ndef test_compare_negative_numbers_returns_minus_1():\n    \"\"\"边界：负数域比较，a=-5, b=-3，规约 a < b 返回 -1。\"\"\"\n    assert compare(-5, -3) == -1\n\n\ndef test_compare_negative_numbers_returns_1():\n    \"\"\"边界：负数域比较，a=-3, b=-5，规约 a > b 返回 1。\"\"\"\n    assert compare(-3, -5) == 1\n\n\ndef test_compare_negative_and_positive_returns_minus_1():\n    \"\"\"边界：负数与正数比较，a=-1, b=1，规约 a < b 返回 -1。\"\"\"\n    assert compare(-1, 1) == -1\n\n\ndef test_compare_max_and_min_int64_returns_1():\n    \"\"\"边界：64 位整数极值比较，a=2**63-1, b=-2**63，规约 a > b 返回 1。\"\"\"\n    assert compare(9223372036854775807, -9223372036854775808) == 1\n\n\ndef test_compare_min_and_max_int64_returns_minus_1():\n    \"\"\"边界：64 位整数极值比较，a=-2**63, b=2**63-1，规约 a < b 返回 -1。\"\"\"\n    assert compare(-9223372036854775808, 9223372036854775807) == -1\n\n\ndef test_compare_extreme_equal_returns_0():\n    \"\"\"边界：极大整数相等，a=b=2**63-1，规约 a == b 返回 0。\"\"\"\n    assert compare(9223372036854775807, 9223372036854775807) == 0\n\n\n# ---------------------------------------------------------------------------\n# 后置条件通用性质（参数化）\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\n    \"a, b\",\n    [\n        (5, 3),\n        (3, 5),\n        (4, 4),\n        (0, 0),\n        (0, 1),\n        (1, 0),\n        (-5, -3),\n        (-3, -5),\n        (1, 2),\n        (2, 1),\n        (9223372036854775807, -9223372036854775808),\n        (-9223372036854775808, 9223372036854775807),\n    ],\n)\ndef test_compare_result_in_output_domain(a, b):\n    \"\"\"后置条件：返回值必须属于 {1, -1, 0}。\"\"\"\n    result = compare(a, b)\n    assert result in (1, -1, 0)\n\n\n@pytest.mark.parametrize(\n    \"a, b\",\n    [\n        (5, 3),\n        (3, 5),\n        (4, 4),\n        (0, 0),\n        (0, 1),\n        (1, 0),\n        (-5, -3),\n        (-3, -5),\n        (1, 2),\n        (2, 1),\n        (9223372036854775807, -9223372036854775808),\n        (-9223372036854775808, 9223372036854775807),\n    ],\n)\ndef test_compare_matches_ordering_relation(a, b):\n    \"\"\"后置条件：(a>b -> 1) 且 (a<b -> -1) 且 (a==b -> 0)。\"\"\"\n    result = compare(a, b)\n    if a > b:\n        assert result == 1\n    elif a < b:\n        assert result == -1\n    else:\n        assert result == 0\n\n\n# ---------------------------------------------------------------------------\n# 前置条件违反：非 int 入参\n# ---------------------------------------------------------------------------\n\ndef test_compare_non_int_input_raises_type_error():\n    \"\"\"前置条件要求 a、b 均为 int；传入 str 违反前置条件。\n\n    期望值来源不明，需人工确认：规约未定义非 int 入参的行为，\n    此处仅记录 Python 中比较 str 与 int 会抛 TypeError 的实际行为。\n    \"\"\"\n    with pytest.raises(TypeError):\n        compare(\"5\", 3)\n\n\ndef test_compare_non_int_second_arg_raises_type_error():\n    \"\"\"前置条件要求 a、b 均为 int；第二个参数为 str 违反前置条件。\n\n    期望值来源不明，需人工确认：规约未定义非 int 入参的行为，\n    此处仅记录 Python 中比较 int 与 str 会抛 TypeError 的实际行为。\n    \"\"\"\n    with pytest.raises(TypeError):\n        compare(3, \"5\")",
