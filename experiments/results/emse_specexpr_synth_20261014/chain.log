          "generated_test": "import pytest\n\nfrom task_0061 import compute_scores\n\n\ndef test_compute_scores_normal_records():\n    \"\"\"正常记录转换：验证正常 name/value 映射。\n\n    期望值来源：规约后置条件（键为 name，值为 value）。\n    \"\"\"\n    records = [\n        {\"name\": \"a\", \"value\": 1},\n        {\"name\": \"b\", \"value\": 2},\n    ]\n    result = compute_scores(records)\n    assert result == {\"a\": 1, \"b\": 2}\n\n\ndef test_compute_scores_empty_list():\n    \"\"\"空列表：验证空输入返回空字典。\n\n    期望值来源：规约边界情况（空列表返回 {}）。\n    \"\"\"\n    result = compute_scores([])\n    assert result == {}\n\n\ndef test_compute_scores_missing_name_uses_unknown():\n    \"\"\"缺失 name：验证缺失 name 使用 'unknown'。\n\n    期望值来源：规约后置条件（缺失 name 的键统一为 'unknown'）。\n    \"\"\"\n    records = [{\"value\": 5}]\n    result = compute_scores(records)\n    assert result == {\"unknown\": 5}\n\n\ndef test_compute_scores_missing_value_uses_zero():\n    \"\"\"缺失 value：验证缺失 value 使用 0。\n\n    期望值来源：规约后置条件（缺失 value 的值为 0）。\n    \"\"\"\n    records = [{\"name\": \"a\"}]\n    result = compute_scores(records)\n    assert result == {\"a\": 0}\n\n\ndef test_compute_scores_duplicate_unknown_overwritten():\n    \"\"\"重复 unknown 覆盖：验证多个缺失 name 时后值覆盖前值。\n\n    期望值来源：规约边界情况（多个 record 缺少 name 导致 'unknown' 键被覆盖）。\n    \"\"\"\n    records = [{\"value\": 1}, {\"value\": 2}]\n    result = compute_scores(records)\n    assert result == {\"unknown\": 2}\n\n\ndef test_compute_scores_negative_value_preserved():\n    \"\"\"value 为负数：验证负数 value 原样保留。\n\n    期望值来源：规约边界情况（record 的 value 为 0 或负数）。\n    \"\"\"\n    records = [{\"name\": \"a\", \"value\": -3}]\n    result = compute_scores(records)\n    assert result == {\"a\": -3}\n\n\ndef test_compute_scores_zero_value_preserved():\n    \"\"\"value 为 0：验证 0 值原样保留（不被当作缺失）。\n\n    期望值来源：规约边界情况（record 的 value 为 0 或负数）。\n    \"\"\"\n    records = [{\"name\": \"a\", \"value\": 0}]\n    result = compute_scores(records)\n    assert result == {\"a\": 0}\n\n\ndef test_compute_scores_result_length_matches_record