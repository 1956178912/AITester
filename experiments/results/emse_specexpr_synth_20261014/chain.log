          "generated_test": "import pytest\n\nfrom task_0018 import process\n\n\ndef test_process_returns_list():\n    \"\"\"process 应返回 list 类型。\n\n    期望值来源：函数签名 `-> list`。\n    \"\"\"\n    result = process([1, 2, 3])\n    assert isinstance(result, list)\n\n\ndef test_process_increments_each_element():\n    \"\"\"process 应对输入中每个元素加 1。\n\n    期望值来源：函数体 `[x + 1 for x in items]`。\n    \"\"\"\n    result = process([1, 2, 3])\n    assert result[:3] == [2, 3, 4]\n\n\ndef test_process_appends_zero_at_end():\n    \"\"\"process 应在结果末尾追加一个 0。\n\n    期望值来源：函数体 `+ [0]`。\n    \"\"\"\n    result = process([1, 2, 3])\n    assert result[-1] == 0\n\n\ndef test_process_output_length_is_input_plus_one():\n    \"\"\"process 输出长度应等于输入长度加 1。\n\n    期望值来源：函数体对每个元素加 1 后追加一个 0。\n    \"\"\"\n    items = [10, 20, 30, 40]\n    result = process(items)\n    assert len(result) == len(items) + 1\n\n\ndef test_process_empty_list():\n    \"\"\"process 对空列表应返回 [0]。\n\n    期望值来源：空列表推导结果为空，再追加 0。\n    \"\"\"\n    result = process([])\n    assert result == [0]\n\n\ndef test_process_single_element():\n    \"\"\"process 对单元素列表应返回 [x+1, 0]。\n\n    期望值来源：函数体逻辑。\n    \"\"\"\n    result = process([5])\n    assert result == [6, 0]\n\n\ndef test_process_negative_numbers():\n    \"\"\"process 对负数应正确加 1。\n\n    期望值来源：函数体 `x + 1` 对负数同样适用。\n    \"\"\"\n    result = process([-1, -2, -3])\n    assert result == [0, -1, -2, 0]\n\n\ndef test_process_zero_element():\n    \"\"\"process 对 0 应返回 1。\n\n    期望值来源：函数体 `0 + 1 == 1`。\n    \"\"\"\n    result = process([0])\n    assert result == [1, 0]\n\n\ndef test_process_floats():\n    \"\"\"process 对浮点数应正确加 1。\n\n    期望值来源：函数体 `x + 1` 对浮点数同样适用。\n    \"\"\"\n    result = process([1.5, 2.5])\n    assert result == [2.5, 3.5, 0]\n\n\ndef test_process_does_not_mutate_input():\n    \"\"\"process 不应修改输入列表。\n\n    期望值来源：函数体使用列表推导创建新列表，不修改原列表。\n    \"\"\"\n    items = [1, 2, 3]\n    original = list(items)\n    process(items)\n    assert items == original\n\n\ndef test_process_string_elements_raises_type_error():\n    \"\"\"process 对字符串元素应抛出 TypeError。\n\n    期望值来源：`str + int` 在 Python 中会抛出 TypeError。\n    \"\"\"\n    with pytest.raises(TypeError):\n        process([\"a\", \"b\"])\n\n\ndef test_process_none_input_raises_type_error():\n    \"\"\"process 对 None 输入应抛出 TypeError。\n\n    期望值来源：None 不可迭代。\n    \"\"\"\n    with pytest.raises(TypeError):\n        process(None)\n\n\ndef test_process_tuple_input():\n    \"\"\"process 对元组输入应返回列表。\n\n    期望值来源：函数签名 `-> list`，列表推导可迭代元组。\n    \"\"\"\n    result = process((1, 2, 3))\n    assert result == [2, 3, 4, 0]\n    assert isinstance(result, list)",
