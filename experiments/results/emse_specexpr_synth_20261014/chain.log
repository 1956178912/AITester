          "generated_test": "import sys\n\nimport pytest\n\nfrom task_0052 import factorial\n\n\nclass TestFactorialBoundary:\n    \"\"\"边界用例：递归基例与最小非基例。\"\"\"\n\n    def test_factorial_n_zero_returns_one(self):\n        \"\"\"n == 0 时返回 1（规约：递归基例）。\"\"\"\n        result = factorial(0)\n        assert result == 1\n        assert isinstance(result, int)\n\n    def test_factorial_n_one_returns_one(self):\n        \"\"\"n == 1 时返回 1（规约：最小非基例，1! == 1）。\"\"\"\n        result = factorial(1)\n        assert result == 1\n        assert isinstance(result, int)\n\n\nclass TestFactorialNormal:\n    \"\"\"常规用例：多次递归累积。\"\"\"\n\n    def test_factorial_n_five_returns_120(self):\n        \"\"\"n == 5 时返回 120（规约：n! == 120）。\"\"\"\n        result = factorial(5)\n        assert result == 120\n        assert isinstance(result, int)\n\n    def test_factorial_n_ten_returns_3628800(self):\n        \"\"\"n == 10 时返回 3628800（规约：n! == 3628800）。\"\"\"\n        result = factorial(10)\n        assert result == 3628800\n        assert isinstance(result, int)\n\n    @pytest.mark.parametrize(\n        \"n, expected\",\n        [\n            (2, 2),\n            (3, 6),\n            (4, 24),\n            (6, 720),\n            (7, 5040),\n        ],\n    )\n    def test_factorial_small_values_match_definition(self, n, expected):\n        \"\"\"对若干小整数验证 n! 的数学定义（规约：n > 0 时返回 n * factorial(n-1)）。\"\"\"\n        result = factorial(n)\n        assert result == expected\n        assert isinstance(result, int)\n\n    def test_factorial_result_is_int_and_positive(self):\n        \"\"\"后置条件：返回值类型为 int 且 result >= 1。\"\"\"\n        result = factorial(4)\n        assert isinstance(result, int)\n        assert result >= 1\n\n\nclass TestFactorialError:\n    \"\"\"异常路径：负值与超大 n 触发递归深度溢出。\"\"\"\n\n    def test_factorial_negative_raises_recursion_error(self):\n        \"\"\"n == -1 时无负值保护，无限递归直至 RecursionError。\n\n        期望值来源：规约明确说明「负值将导致无限递归 → RecursionError」。\n        \"\"\"\n        with pytest.raises(RecursionError):\n            factorial(-1)\n\n    def test_factorial_large_n_raises_recursion_error(self):\n        \"\"\"n == 1000 时递归深度超过 Python 默认限制，预期 RecursionError。\n\n        期望值来源：规约明确说明「n 极大（如 1000）递归深度超限 → RecursionError」。\n        \"\"\"\n        with pytest.raises(RecursionError):\n            factorial(1000)\n\n    def test_factorial_negative_other_value_raises_recursion_error(self):\n        \"\"\"n == -5 同样无保护，预期 RecursionError。\n\n        期望值来源：规约「负值将导致无限递归 → RecursionError」。\n        \"\"\"\n        with pytest.raises(RecursionError):\n            factorial(-5)",
