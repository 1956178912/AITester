          "generated_test": "import datetime\n\nimport pytest\n\nfrom task_0046 import days_until\n\n\ndef _now():\n    return datetime.datetime.now()\n\n\ndef test_days_until_future_date_returns_non_negative_int():\n    \"\"\"合法未来日期应返回 int 且 >= 0（规约：合法未来日期返回值 >= 0）。\n\n    具体天数依赖当前时间，期望值来源不明，仅断言规约可判定性质。\n    \"\"\"\n    result = days_until(\"2999-12-31\")\n    assert isinstance(result, int)\n    assert result >= 0\n\n\ndef test_days_until_past_date_returns_negative_int():\n    \"\"\"合法过去日期应返回 int 且 < 0（规约：合法过去日期返回值 < 0）。\n\n    具体天数依赖当前时间，期望值来源不明，仅断言规约可判定性质。\n    \"\"\"\n    result = days_until(\"1970-01-01\")\n    assert isinstance(result, int)\n    assert result < 0\n\n\ndef test_days_until_today_returns_int():\n    \"\"\"今天日期应返回 int（规约：返回值为 int）。\n\n    今天相对 now 的天数差可能为 0 或 -1（取决于当日时刻），\n    期望值来源不明，仅断言类型与规约边界（>= -1 且 <= 0 的合理范围不臆造，\n    此处仅断言 int 类型）。\n    \"\"\"\n    today = _now().strftime(\"%Y-%m-%d\")\n    result = days_until(today)\n    assert isinstance(result, int)\n\n\ndef test_days_until_invalid_format_slash_returns_negative_int():\n    \"\"\"非法格式 \"2024/01/01\" 走 ValueError 分支，返回 datetime.min 与 now 之差（负值）。\n\n    规约：非法格式日期返回 datetime.min 与 now 之差的天数（负值）。\n    具体值依赖当前时间，期望值来源不明，仅断言为 int 且为负。\n    \"\"\"\n    result = days_until(\"2024/01/01\")\n    assert isinstance(result, int)\n    assert result < 0\n\n\ndef test_days_until_invalid_format_abc_returns_negative_int():\n    \"\"\"非法格式 \"abc\" 走 ValueError 分支，返回负的天数差。\n\n    规约：非法格式日期返回 datetime.min 与 now 之差的天数（负值）。\n    具体值依赖当前时间，期望值来源不明，仅断言为 int 且为负。\n    \"\"\"\n    result = days_until(\"abc\")\n    assert isinstance(result, int)\n    assert result < 0\n\n\ndef test_days_until_empty_string_returns_negative_int():\n    \"\"\"空字符串无法解析，走 ValueError 分支，返回负的天数差。\n\n    规约：非法格式日期返回 datetime.min 与 now 之差的天数（负值）。\n    具体值依赖当前时间，期望值来源不明，仅断言为 int 且为负。\n    \"\"\"\n    result = days_until(\"\")\n    assert isinstance(result, int)\n    assert result < 0\n\n\ndef test_days_until_none_raises_type_error():\n    \"\"\"None 传入会触发 TypeError（规约：None 或非字符串会触发 TypeError，非 ValueError）。\n\n    期望值来源：规约边界情况明确说明触发 TypeError。\n    \"\"\"\n    with pytest.raises(TypeError):\n        days_until(None)\n\n\ndef test_days_until_non_string_int_raises_type_error():\n    \"\"\"非字符串（int）输入会触发 TypeError（规约：非字符串会触发 TypeError）。\n\n    期望值来源：规约边界情况明确说明非字符串触发 TypeError。\n    \"\"\"\n    with pytest.raises(TypeError):\n        days_until(20240101)\n\n\ndef test_days_until_min_boundary_date_returns_int():\n    \"\"\"最小边界日期 \"0001-01-01\" 应能解析并返回 int，不溢出。\n\n    规约：边界日期（如 \"0001-01-01\"）为合法日期字符串。\n    该日期为过去日期，期望返回负 int；具体值依赖当前时间，期望值来源不明。\n    \"\"\"\n    result = days_until(\"0001-01-01\")\n    assert isinstance(result, int)\n    assert result < 0\n\n\ndef test_days_until_max_boundary_date_returns_int():\n    \"\"\"最大边界日期 \"9999-12-31\" 应能解析并返回 int，不溢出。\n\n    规约：边界日期（如 \"9999-12-31\"）为合法日期字符串。\n    该日期为未来日期，期望返回非负 int；具体值依赖当前时间，期望值来源不明。\n    \"\"\"\n    result = days_until(\"9999-12-31\")\n    assert isinstance(result, int)\n    assert result >= 0\n\n\n@pytest.mark.parametrize(\n    \"target\",\n    [\"2024-13-01\", \"2024-00-10\", \"2024-02-30\", \"not-a-date\", \"2024-1-1\"],\n)\ndef test_days_until_malformed_date_strings_return_negative_int(target):\n    \"\"\"多种非法/畸形日期字符串应走 ValueError 分支，返回负的天数差。\n\n    规约：非法格式日期返回 datetime.min 与 now 之差的天数（负值）。\n    具体值依赖当前时间，期望值来源不明，仅断言为 int 且为负。\n    \"\"\"\n    result = days_until(target)\n    assert isinstance(result, int)\n    assert result < 0",
