          "generated_test": "import math\nimport pytest\n\nfrom task_0081 import factorial\n\n\n# ---------------------------------------------------------------------------\n# 正常路径 / 边界路径：期望值来自规约（n==0 -> 1；n>0 -> n!）\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\n    \"n, expected\",\n    [\n        (0, 1),          # 边界：递归基，规约明确 n == 0 返回 1\n        (1, 1),          # 边界：最小递归情形，1! = 1\n        (2, 2),          # 正常：2! = 2\n        (3, 6),          # 正常：3! = 6\n        (5, 120),        # 正常：5! = 120\n        (10, 3628800),   # 正常：10! = 3628800\n    ],\n)\ndef test_factorial_returns_expected_value(n, expected):\n    \"\"\"规约后置条件：n == 0 返回 1；n > 0 返回 n!。\n\n    期望值来源：规约后置条件（n! 定义）与边界情况说明。\n    \"\"\"\n    assert factorial(n) == expected\n\n\n@pytest.mark.parametrize(\"n\", [0, 1, 2, 5, 10])\ndef test_factorial_returns_int_type(n):\n    \"\"\"规约后置条件：返回值类型为 int。\"\"\"\n    result = factorial(n)\n    assert isinstance(result, int)\n\n\n@pytest.mark.parametrize(\"n\", [0, 1, 2, 5, 10])\ndef test_factorial_result_at_least_one(n):\n    \"\"\"规约后置条件：result >= 1（对满足前件的 n >= 0 成立）。\"\"\"\n    assert factorial(n) >= 1\n\n\ndef test_factorial_matches_math_factorial_for_valid_inputs():\n    \"\"\"规约后置条件：n > 0 时返回 n!，与 math.factorial 一致。\n\n    期望值来源：规约中 n! 的数学定义（用标准库作为独立参照）。\n    \"\"\"\n    for n in range(0, 15):\n        assert factorial(n) == math.factorial(n)\n\n\n# ---------------------------------------------------------------------------\n# 错误路径：规约明确说明的异常行为\n# ---------------------------------------------------------------------------\n\ndef test_factorial_negative_raises_recursion_error():\n    \"\"\"边界情况：n 为负数时无基例，无限递归 → RecursionError。\n\n    期望值来源：规约边界情况说明（负数行为未定义，仅可断言抛出 RecursionError）。\n    \"\"\"\n    with pytest.raises(RecursionError):\n        factorial(-1)\n\n\ndef test_factorial_large_n_raises_recursion_error():\n    \"\"\"边界情况：n 较大（如 1000）时递归深度超限 → RecursionError。\n\n    期望值来源：规约边界情况说明（大数行为未定义，仅可断言抛出 RecursionError）。\n    \"\"\"\n    with pytest.raises(RecursionError):\n        factorial(1000)\n\n\n# ---------------------------------------------------------------------------\n# 前件违反 / 未定义行为：探索性断言，需人工确认\n# ---------------------------------------------------------------------------\n\ndef test_factorial_non_int_input_behavior_undefined():\n    \"\"\"边界情况：n 为非 int（如 float）时行为未定义。\n\n    期望值来源不明，需人工确认：规约仅声明类型注解为 int，\n    未规定非 int 输入的行为。此处仅记录实际行为，不做具体值断言。\n    \"\"\"\n    try:\n        result = factorial(2.5)\n    except Exception as exc:  # noqa: BLE001 - 记录实际抛出的异常类型\n        # 行为未定义，仅记录异常类型，不臆造具体异常\n        assert exc is not None\n    else:\n        # 若未抛异常，仅记录返回值类型，不臆造具体值\n        assert result is not None",
