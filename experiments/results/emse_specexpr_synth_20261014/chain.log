          "generated_test": "import pytest\n\nfrom task_0023 import clamp\n\n\nclass TestClampSpec:\n    \"\"\"Spec-first tests for clamp(value, low, high).\n\n    Expected values are derived solely from the natural-language spec:\n      - if value < high: return high\n      - elif value > low: return low\n      - else: return value\n    \"\"\"\n\n    def test_clamp_value_less_than_high_returns_high(self):\n        \"\"\"value < high 成立时，规约要求返回 high。\"\"\"\n        assert clamp(1, 0, 10) == 10\n\n    def test_clamp_value_greater_than_low_returns_low(self):\n        \"\"\"value < high 不成立且 value > low 成立时，规约要求返回 low。\"\"\"\n        assert clamp(5, 0, 3) == 0\n\n    def test_clamp_value_equals_high_and_low_returns_value(self):\n        \"\"\"value == high 且 value == low 时两个分支均不成立，返回 value。\"\"\"\n        assert clamp(5, 5, 5) == 5\n\n    def test_clamp_value_equals_high_returns_value(self):\n        \"\"\"value == high 时 value < high 为假；value > low 成立则返回 low，否则返回 value。\n\n        此处 value=10, low=0, high=10：value > low 成立，故按规约返回 low=0。\n        \"\"\"\n        assert clamp(10, 0, 10) == 0\n\n    def test_clamp_value_equals_low_returns_high(self):\n        \"\"\"value == low 时 value < high 成立，规约要求返回 high。\"\"\"\n        assert clamp(0, 0, 10) == 10\n\n    def test_clamp_value_zero_returns_high(self):\n        \"\"\"value 为 0 且 0 < high 成立时，规约要求返回 high。\"\"\"\n        assert clamp(0, -5, 5) == 5\n\n    def test_clamp_negative_bounds_returns_high(self):\n        \"\"\"low、high 均为负数且 value < high 成立时，规约要求返回 high。\"\"\"\n        assert clamp(-3, -10, -1) == -1\n\n    def test_clamp_low_greater_than_high_returns_value(self):\n        \"\"\"low > high 的异常区间：value < high 为假、value > low 为假，返回 value。\n\n        期望值来自规约逻辑推导，非异常抛出。\n        \"\"\"\n        assert clamp(5, 10, 0) == 5\n\n    def test_clamp_value_between_low_and_high_returns_high(self):\n        \"\"\"low < value < high 时两个分支条件同时成立，优先命中第一个分支返回 high。\"\"\"\n        assert clamp(5, 0, 10) == 10\n\n    @pytest.mark.parametrize(\n        \"value, low, high, expected\",\n        [\n            (1, 0, 10, 10),\n            (5, 0, 3, 0),\n            (5, 5, 5, 5),\n            (10, 0, 10, 0),\n            (0, 0, 10, 10),\n            (0, -5, 5, 5),\n            (-3, -10, -1, -1),\n            (5, 10, 0, 5),\n            (5, 0, 10, 10),\n        ],\n    )\n    def test_clamp_spec_table(self, value, low, high, expected):\n        \"\"\"参数化覆盖规约中所有可判定分支与边界情况。\"\"\"\n        assert clamp(value, low, high) == expected\n\n    def test_clamp_return_value_is_one_of_inputs(self):\n        \"\"\"不变量：返回值必为 high、low 或 value 三者之一。\"\"\"\n        result = clamp(7, 2, 9)\n        assert result in (7, 2, 9)\n\n    def test_clamp_returns_int(self):\n        \"\"\"返回值类型为 int。\"\"\"\n        assert isinstance(clamp(3, 1, 8), int)",
