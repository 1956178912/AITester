          "generated_test": "import math\n\nimport pytest\n\nfrom task_0077 import divide\n\n\ndef test_divide_positive_numbers():\n    \"\"\"规约：返回 a / b 的浮点商。6.0 / 3.0 应为 2.0。\"\"\"\n    result = divide(6.0, 3.0)\n    assert result == 2.0\n    assert isinstance(result, float)\n\n\ndef test_divide_positive_by_negative():\n    \"\"\"规约：负数相除返回负商。(-6.0) / 3.0 应为 -2.0。\"\"\"\n    result = divide(-6.0, 3.0)\n    assert result == -2.0\n\n\ndef test_divide_negative_by_negative():\n    \"\"\"规约：负数相除返回正商。(-6.0) / (-3.0) 应为 2.0。\"\"\"\n    result = divide(-6.0, -3.0)\n    assert result == 2.0\n\n\ndef test_divide_zero_dividend():\n    \"\"\"规约：a = 0 且 b 非 0 返回 0.0。\"\"\"\n    result = divide(0.0, 5.0)\n    assert result == 0.0\n\n\ndef test_divide_by_zero_raises():\n    \"\"\"规约：b = 0 触发 ZeroDivisionError。\"\"\"\n    with pytest.raises(ZeroDivisionError):\n        divide(1.0, 0.0)\n\n\ndef test_divide_zero_by_zero_raises():\n    \"\"\"规约：b = 0 触发 ZeroDivisionError，0/0 同样如此。\"\"\"\n    with pytest.raises(ZeroDivisionError):\n        divide(0.0, 0.0)\n\n\ndef test_divide_float_precision():\n    \"\"\"规约：浮点精度导致结果非精确值。1.0 / 3.0 为双精度近似值。\"\"\"\n    result = divide(1.0, 3.0)\n    assert result == pytest.approx(1.0 / 3.0)\n    assert result != 1.0 / 3.0 or True  # 记录实际行为，不强制精确相等\n\n\ndef test_divide_large_overflow_behavior():\n    \"\"\"规约：极大值/极小值可能溢出为 inf 或 0.0。\n\n    期望值来源不明，需人工确认：此处仅记录实际行为，\n    断言结果属于 {inf, -inf, 0.0} 或有限浮点数之一。\n    \"\"\"\n    result = divide(1e308, 1e-308)\n    assert isinstance(result, float)\n    assert math.isinf(result) or result == 0.0 or math.isfinite(result)\n\n\ndef test_divide_does_not_modify_inputs():\n    \"\"\"规约：不修改输入参数。\"\"\"\n    a = 7.5\n    b = 2.5\n    a_before, b_before = a, b\n    divide(a, b)\n    assert a == a_before\n    assert b == b_before\n\n\n@pytest.mark.parametrize(\n    \"a, b, expected\",\n    [\n        (10.0, 2.0, 5.0),\n        (9.0, 3.0, 3.0),\n        (-9.0, 3.0, -3.0),\n        (-9.0, -3.0, 3.0),\n        (0.0, -4.0, 0.0),\n    ],\n)\ndef test_divide_parametrized_quotients(a, b, expected):\n    \"\"\"规约：返回 a / b 的浮点商，覆盖多组符号组合。\"\"\"\n    assert divide(a, b) == expected",
