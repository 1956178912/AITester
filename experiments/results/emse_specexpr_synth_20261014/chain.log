          "generated_test": "import pytest\n\nfrom task_0064 import lookup\n\n\n# ---------------------------------------------------------------------------\n# 规约来源说明：\n#   前置条件：模块级 _TABLE 已初始化为 {\"alpha\":1,\"beta\":2,\"gamma\":3}\n#   前置条件：调用方传入参数类型为 str\n#   后置条件：函数无副作用，不修改 _TABLE\n#   后置条件：返回值始终为 int 类型\n#   后置条件：返回值等于 _TABLE.get(key, 0)\n#   边界情况：空字符串 / 大小写变体 / 不存在字符串 / 超长字符串 / None 或非字符串\n# ---------------------------------------------------------------------------\n\n\n@pytest.fixture\ndef table_snapshot():\n    \"\"\"在测试前后对 _TABLE 做快照，用于验证无副作用（不修改 _TABLE）。\"\"\"\n    import task_0064\n\n    before = dict(task_0064._TABLE)\n    yield before\n    after = dict(task_0064._TABLE)\n    assert after == before, \"_TABLE 被 lookup 修改，违反无副作用后置条件\"\n\n\n# ---------------------------------------------------------------------------\n# 正常路径：命中分支\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\n    \"key, expected\",\n    [\n        (\"alpha\", 1),\n        (\"beta\", 2),\n        (\"gamma\", 3),\n    ],\n)\ndef test_lookup_hit_returns_mapped_value(key, expected, table_snapshot):\n    \"\"\"命中 _TABLE 中的键时，lookup 返回其映射整数值。\n\n    期望值来源：规约中 _TABLE = {\"alpha\":1,\"beta\":2,\"gamma\":3}。\n    \"\"\"\n    result = lookup(key)\n    assert result == expected\n    assert isinstance(result, int)\n\n\n# ---------------------------------------------------------------------------\n# 正常路径：未命中分支\n# ---------------------------------------------------------------------------\n\ndef test_lookup_miss_returns_zero(table_snapshot):\n    \"\"\"未命中 _TABLE 的普通字符串返回 0。\n\n    期望值来源：规约后置条件 返回值等于 _TABLE.get(key, 0)。\n    \"\"\"\n    result = lookup(\"delta\")\n    assert result == 0\n    assert isinstance(result, int)\n\n\n# ---------------------------------------------------------------------------\n# 边界情况\n# ---------------------------------------------------------------------------\n\ndef test_lookup_empty_string_returns_zero(table_snapshot):\n    \"\"\"空字符串键未命中，返回 0。\n\n    期望值来源：规约边界情况 key 为空字符串 \"\"（未命中，返回 0）。\n    \"\"\"\n    result = lookup(\"\")\n    assert result == 0\n    assert isinstance(result, int)\n\n\ndef test_lookup_case_sensitive_returns_zero(table_snapshot):\n    \"\"\"字典键区分大小写，\"Alpha\" 未命中，返回 0。\n\n    期望值来源：规约边界情况 大小写变体如 \"Alpha\"（未命中，返回 0）。\n    \"\"\"\n    result = lookup(\"Alpha\")\n    assert result == 0\n    assert isinstance(result, int)\n\n\ndef test_lookup_long_string_returns_zero(table_snapshot):\n    \"\"\"超长字符串键未命中，返回 0，且不抛异常。\n\n    期望值来源：规约边界情况 超长字符串（返回 0）。\n    \"\"\"\n    long_key = \"a\" * 4096\n    result = lookup(long_key)\n    assert result == 0\n    assert isinstance(result, int)\n\n\ndef test_lookup_whitespace_returns_zero(table_snapshot):\n    \"\"\"仅含空格的键未命中，返回 0。\n\n    期望值来源：规约后置条件 返回值等于 _TABLE.get(key, 0)，\n    空格不在 _TABLE 中。\n    \"\"\"\n    result = lookup(\" \")\n    assert result == 0\n    assert isinstance(result, int)\n\n\n# ---------------------------------------------------------------------------\n# 违反类型注解的输入（规约明确说明 dict.get 可处理，返回 0）\n# ---------------------------------------------------------------------------\n\ndef test_lookup_none_key_returns_zero(table_snapshot):\n    \"\"\"None 键违反类型注解，但规约说明 dict.get(None, 0) 返回 0。\n\n    期望值来源：规约边界情况 key 为 None 或非字符串类型\n    （dict.get 可处理，返回 0，但违反类型注解）。\n    \"\"\"\n    result = lookup(None)\n    assert result == 0\n    assert isinstance(result, int)\n\n\ndef test_lookup_int_key_returns_zero(table_snapshot):\n    \"\"\"整数键违反类型注解，但规约说明 dict.get(123, 0) 返回 0。\n\n    期望值来源：规约边界情况 key 为 None 或非字符串类型\n    （dict.get 可处理，返回 0，但违反类型注解）。\n    \"\"\"\n    result = lookup(123)\n    assert result == 0\n    assert isinstance(result, int)\n\n\n# ---------------------------------------------------------------------------\n# 后置条件：返回值类型始终为 int\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\"key\", [\"alpha\", \"beta\", \"gamma\", \"delta\", \"\", \"Alpha\"])\ndef test_lookup_return_type_is_int(key, table_snapshot):\n    \"\"\"无论命中与否，lookup 返回值类型始终为 int。\n\n    期望值来源：规约后置条件 返回值始终为 int 类型。\n    \"\"\"\n    result = lookup(key)\n    assert isinstance(result, int)\n    assert not isinstance(result, bool) or result in (0, 1)\n\n\n# ---------------------------------------------------------------------------\n# 后置条件：无副作用（不修改 _TABLE）\n# ---------------------------------------------------------------------------\n\ndef test_lookup_does_not_mutate_table(table_snapshot):\n    \"\"\"lookup 调用前后 _TABLE 内容保持不变。\n\n    期望值来源：规约后置条件 函数无副作用，不修改 _TABLE。\n    \"\"\"\n    import task_0064\n\n    before = dict(task_0064._TABLE)\n    lookup(\"alpha\")\n    lookup(\"delta\")\n    lookup(\"\")\n    after = dict(task_0064._TABLE)\n    assert after == before",
