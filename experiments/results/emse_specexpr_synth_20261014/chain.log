          "generated_test": "import pytest\n\nfrom task_0047 import add_item, stock_of, _STOCK\n\n\n@pytest.fixture(autouse=True)\ndef clear_stock():\n    \"\"\"在每个测试前后清空全局库存，避免测试间相互影响。\"\"\"\n    _STOCK.clear()\n    yield\n    _STOCK.clear()\n\n\ndef test_add_item_sets_stock_for_sku():\n    \"\"\"add_item 应将指定 sku 的库存设置为给定 qty。\n\n    期望值来源：函数签名 add_item(sku: int, qty: int) -> None 及实现\n    _STOCK[sku] = qty。\n    \"\"\"\n    add_item(1, 10)\n    assert _STOCK[1] == 10\n\n\ndef test_add_item_overwrites_existing_stock():\n    \"\"\"add_item 对同一 sku 重复调用应覆盖旧值。\n\n    期望值来源：实现使用赋值 _STOCK[sku] = qty，为覆盖语义。\n    \"\"\"\n    add_item(1, 10)\n    add_item(1, 3)\n    assert _STOCK[1] == 3\n\n\ndef test_add_item_accepts_zero_qty():\n    \"\"\"add_item 应允许 qty 为 0。\n\n    期望值来源：类型注解 qty: int，未限制取值范围。\n    \"\"\"\n    add_item(2, 0)\n    assert _STOCK[2] == 0\n\n\ndef test_add_item_accepts_negative_qty():\n    \"\"\"add_item 应允许 qty 为负数（实现未做校验）。\n\n    期望值来源：类型注解 qty: int，实现无校验逻辑。\n    \"\"\"\n    add_item(3, -5)\n    assert _STOCK[3] == -5\n\n\ndef test_stock_of_returns_stored_value():\n    \"\"\"stock_of 应返回已通过 add_item 写入的库存值。\n\n    期望值来源：实现 _STOCK.get(sku, 0)。\n    \"\"\"\n    add_item(1, 7)\n    assert stock_of(1) == 7\n\n\ndef test_stock_of_returns_zero_for_missing_sku():\n    \"\"\"stock_of 对不存在的 sku 应返回 0。\n\n    期望值来源：实现 _STOCK.get(sku, 0) 的默认值。\n    \"\"\"\n    assert stock_of(999) == 0\n\n\ndef test_stock_of_returns_zero_for_unknown_string_sku():\n    \"\"\"stock_of 对未知字符串 sku 应返回 0。\n\n    期望值来源：实现 _STOCK.get(sku, 0) 的默认值。\n    \"\"\"\n    assert stock_of(\"unknown-sku\") == 0\n\n\ndef test_stock_of_returns_zero_after_add_item_zero():\n    \"\"\"add_item 写入 0 后，stock_of 应返回 0。\n\n    期望值来源：实现直接返回存储值。\n    \"\"\"\n    add_item(4, 0)\n    assert stock_of(4) == 0\n\n\ndef test_stock_of_returns_negative_value():\n    \"\"\"stock_of 应原样返回负数库存。\n\n    期望值来源：实现直接返回存储值，无范围限制。\n    \"\"\"\n    add_item(5, -2)\n    assert stock_of(5) == -2\n\n\ndef test_stock_of_does_not_create_entry_for_missing_sku():\n    \"\"\"stock_of 查询不存在的 sku 不应向 _STOCK 写入条目。\n\n    期望值来源：实现使用 dict.get，不修改字典。\n    \"\"\"\n    stock_of(12345)\n    assert 12345 not in _STOCK\n\n\ndef test_add_item_and_stock_of_roundtrip_multiple_skus():\n    \"\"\"多个 sku 的写入与读取应互不干扰。\n\n    期望值来源：_STOCK 为以 sku 为键的字典。\n    \"\"\"\n    add_item(1, 10)\n    add_item(2, 20)\n    add_item(3, 30)\n    assert stock_of(1) == 10\n    assert stock_of(2) == 20\n    assert stock_of(3) == 30",
