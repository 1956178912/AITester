          "generated_test": "import pytest\n\nfrom task_0000 import first_n_chars\n\n\n# ---------------------------------------------------------------------------\n# 正常路径 / 主路径\n# ---------------------------------------------------------------------------\n\ndef test_first_n_chars_normal_returns_first_n_minus_1_chars():\n    \"\"\"n > 0 时返回 s 的前 n-1 个字符（主路径）。\n\n    期望值来源：规约后置条件 \"当 n > 0 时返回 s 的前 n-1 个字符\"。\n    \"\"\"\n    result = first_n_chars(\"hello\", 4)\n    assert isinstance(result, str)\n    assert result == \"hel\"\n\n\ndef test_first_n_chars_normal_returns_str_type():\n    \"\"\"返回值类型必须为 str。\n\n    期望值来源：规约后置条件 \"返回值为 str 类型\"。\n    \"\"\"\n    result = first_n_chars(\"hello\", 4)\n    assert isinstance(result, str)\n\n\n# ---------------------------------------------------------------------------\n# 边界：n <= 0 分支\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\"n\", [0, -1, -3, -100])\ndef test_first_n_chars_non_positive_n_returns_empty(n):\n    \"\"\"n <= 0 时返回空字符串。\n\n    期望值来源：规约后置条件 \"当 n <= 0 时返回空字符串\"。\n    \"\"\"\n    result = first_n_chars(\"hello\", n)\n    assert isinstance(result, str)\n    assert result == \"\"\n\n\ndef test_first_n_chars_n_zero_returns_empty():\n    \"\"\"n == 0 边界：返回空串。\n\n    期望值来源：规约边界情况 \"n == 0（返回空串）\"。\n    \"\"\"\n    assert first_n_chars(\"hello\", 0) == \"\"\n\n\ndef test_first_n_chars_n_negative_returns_empty():\n    \"\"\"n 为负数边界：返回空串。\n\n    期望值来源：规约边界情况 \"n 为负数（返回空串）\"。\n    \"\"\"\n    assert first_n_chars(\"hello\", -3) == \"\"\n\n\n# ---------------------------------------------------------------------------\n# 边界：n == 1\n# ---------------------------------------------------------------------------\n\ndef test_first_n_chars_n_one_returns_empty():\n    \"\"\"n == 1 边界：切片 s[:0] 返回空串。\n\n    期望值来源：规约边界情况 \"n == 1（切片 s[:0] 返回空串）\"。\n    \"\"\"\n    result = first_n_chars(\"hello\", 1)\n    assert isinstance(result, str)\n    assert result == \"\"\n\n\n# ---------------------------------------------------------------------------\n# 边界：n 与 len(s) 的关系\n# ---------------------------------------------------------------------------\n\ndef test_first_n_chars_n_equals_len_plus_one_returns_whole_string():\n    \"\"\"n == len(s)+1 边界：返回整个字符串。\n\n    期望值来源：规约边界情况 \"n == len(s)+1（返回整个 s）\"。\n    \"\"\"\n    s = \"hello\"\n    result = first_n_chars(s, len(s) + 1)\n    assert isinstance(result, str)\n    assert result == s\n\n\ndef test_first_n_chars_n_greater_than_len_plus_one_returns_whole_string():\n    \"\"\"n 大于 len(s)+1 边界：切片越界，返回整个 s。\n\n    期望值来源：规约边界情况 \"n 大于 len(s)+1（切片越界，返回整个 s）\"。\n    \"\"\"\n    s = \"hello\"\n    result = first_n_chars(s, 100)\n    assert isinstance(result, str)\n    assert result == s\n\n\n# ---------------------------------------------------------------------------\n# 边界：空字符串\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\"n\", [1, 3, 100])\ndef test_first_n_chars_empty_string_returns_empty(n):\n    \"\"\"s 为空字符串边界：切片结果为空串。\n\n    期望值来源：规约边界情况 \"s 为空字符串\" 与后置条件\n    \"n > 0 时返回 s 的前 n-1 个字符\"（空串切片仍为空串）。\n    \"\"\"\n    result = first_n_chars(\"\", n)\n    assert isinstance(result, str)\n    assert result == \"\"\n\n\n# ---------------------------------------------------------------------------\n# 不变量\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\n    \"s,n\",\n    [\n        (\"hello\", 4),\n        (\"hello\", 1),\n        (\"hello\", 0),\n        (\"hello\", -3),\n        (\"hello\", 100),\n        (\"hello\", 6),\n        (\"\", 3),\n        (\"a\", 2),\n        (\"abcdef\", 3),\n    ],\n)\ndef test_first_n_chars_invariant_length_not_exceed_input(s, n):\n    \"\"\"不变量：len(result) <= len(s)。\n\n    期望值来源：规约不变量 \"len(result) <= len(s)\"。\n    \"\"\"\n    result = first_n_chars(s, n)\n    assert isinstance(result, str)\n    assert len(result) <= len(s)\n\n\n@pytest.mark.parametrize(\n    \"s,n\",\n    [\n        (\"hello\", 4),\n        (\"hello\", 1),\n        (\"hello\", 0),\n        (\"hello\", -3),\n        (\"hello\", 100),\n        (\"hello\", 6),\n        (\"\", 3),\n        (\"a\", 2),\n        (\"abcdef\", 3),\n    ],\n)\ndef test_first_n_chars_postcondition_slice_equivalence(s, n):\n    \"\"\"后置条件：n <= 0 或 result == s[:n-1]。\n\n    期望值来源：规约可执行后置子句 \"n <= 0 or result == s[:n - 1]\"。\n    \"\"\"\n    result = first_n_chars(s, n)\n    assert isinstance(result, str)\n    assert n <= 0 or result == s[: n - 1]\n\n\n# ---------------------------------------------------------------------------\n# 类型异常路径（前置条件不满足）\n# ---------------------------------------------------------------------------\n\ndef test_first_n_chars_float_n_behavior():\n    \"\"\"n 为 float 时行为未在规约中定义。\n\n    期望值来源不明，需人工确认：规约仅声明前置条件 n 为 int，\n    未定义 float 输入的行为。此处记录实际行为（可能抛 TypeError，\n    也可能返回某值），不做具体值断言。\n    \"\"\"\n    try:\n        result = first_n_chars(\"hello\", 2.5)\n    except TypeError:\n        # 前置条件被违反，抛 TypeError 是合理行为\n        return\n    # 若未抛异常，则仅记录实际返回值，不臆造期望\n    assert isinstance(result, str)\n\n\ndef test_first_n_chars_none_s_behavior():\n    \"\"\"s 为 None 时行为未在规约中定义。\n\n    期望值来源不明，需人工确认：规约仅声明前置条件 s 为 str，\n    未定义 None 输入的行为。此处记录实际行为（可能抛 TypeError），\n    不做具体值断言。\n    \"\"\"\n    try:\n        result = first_n_chars(None, 3)\n    except TypeError:\n        # 前置条件被违反，抛 TypeError 是合理行为\n        return\n    # 若未抛异常，则仅记录实际返回值，不臆造期望\n    assert isinstance(result, str)",
