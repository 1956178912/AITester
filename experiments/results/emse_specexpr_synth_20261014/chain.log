          "generated_test": "import sys\nimport pytest\n\nfrom task_0010 import factorial\n\n\nclass TestFactorialBoundary:\n    \"\"\"边界情形测试：n=0 与 n=1。\"\"\"\n\n    def test_factorial_n_zero_returns_one(self):\n        \"\"\"规约：n==0 时返回 1（基准情形）。期望值来源：自然语言规约。\"\"\"\n        result = factorial(0)\n        assert result == 1\n\n    def test_factorial_n_zero_returns_int(self):\n        \"\"\"规约：返回值类型为 int。期望值来源：自然语言规约。\"\"\"\n        result = factorial(0)\n        assert isinstance(result, int)\n\n    def test_factorial_n_one_returns_one(self):\n        \"\"\"规约：n>0 时返回 n!，1! = 1（最小递归情形）。期望值来源：自然语言规约。\"\"\"\n        result = factorial(1)\n        assert result == 1\n\n    def test_factorial_n_one_returns_int(self):\n        \"\"\"规约：返回值类型为 int。期望值来源：自然语言规约。\"\"\"\n        result = factorial(1)\n        assert isinstance(result, int)\n\n\nclass TestFactorialNormal:\n    \"\"\"常规正数输入测试。\"\"\"\n\n    @pytest.mark.parametrize(\n        \"n, expected\",\n        [\n            (2, 2),\n            (3, 6),\n            (4, 24),\n            (5, 120),\n            (6, 720),\n            (10, 3628800),\n        ],\n    )\n    def test_factorial_positive_returns_factorial(self, n, expected):\n        \"\"\"规约：n>0 时返回 n!。期望值来源：自然语言规约（阶乘定义）。\"\"\"\n        assert factorial(n) == expected\n\n    @pytest.mark.parametrize(\"n\", [1, 2, 5, 10])\n    def test_factorial_positive_returns_int(self, n):\n        \"\"\"规约：返回值类型为 int。期望值来源：自然语言规约。\"\"\"\n        assert isinstance(factorial(n), int)\n\n    def test_factorial_recursive_relation(self):\n        \"\"\"规约：n>0 时返回 n*(n-1)!。验证递归关系 n! == n * (n-1)!。期望值来源：自然语言规约。\"\"\"\n        for n in range(1, 8):\n            assert factorial(n) == n * factorial(n - 1)\n\n\nclass TestFactorialError:\n    \"\"\"错误 / 未定义行为测试。\"\"\"\n\n    def test_factorial_negative_raises_recursion_error(self):\n        \"\"\"规约：n 为负数时无终止条件，导致无限递归。\n\n        期望值来源：自然语言规约（边界情况：n 为负数，无终止条件，无限递归）。\n        仅断言抛出 RecursionError，不臆造具体返回值。\n        \"\"\"\n        with pytest.raises(RecursionError):\n            factorial(-1)\n\n    def test_factorial_large_n_raises_recursion_error(self):\n        \"\"\"规约：n 过大导致递归深度超限。\n\n        期望值来源：自然语言规约（边界情况：n 过大导致递归深度超限）。\n        仅断言抛出 RecursionError，不臆造具体返回值。\n        \"\"\"\n        with pytest.raises(RecursionError):\n            factorial(10000)",
