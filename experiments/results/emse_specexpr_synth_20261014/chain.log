          "generated_test": "import math\n\nimport pytest\n\nfrom task_0051 import rounded_ratio\n\n\n# ---------------------------------------------------------------------------\n# 正常路径\n# ---------------------------------------------------------------------------\n\ndef test_rounded_ratio_half():\n    \"\"\"1/2*100=50.0，floor(50.0)/100=0.5（期望值来源：规约 floor 语义）。\"\"\"\n    assert rounded_ratio(1, 2) == 0.5\n\n\ndef test_rounded_ratio_quarter():\n    \"\"\"1/4*100=25.0，floor(25.0)/100=0.25（期望值来源：规约 floor 语义）。\"\"\"\n    assert rounded_ratio(1, 4) == 0.25\n\n\ndef test_rounded_ratio_all_hit():\n    \"\"\"hit==total 时结果为 1.0（期望值来源：规约边界情况）。\"\"\"\n    assert rounded_ratio(5, 5) == 1.0\n\n\ndef test_rounded_ratio_floor_non_integer_percentage():\n    \"\"\"1/3*100≈33.333...，floor 后为 33，除以 100 得 0.33（期望值来源：规约 floor 语义）。\"\"\"\n    assert rounded_ratio(1, 3) == 0.33\n\n\ndef test_rounded_ratio_returns_float_type():\n    \"\"\"返回值类型必须为 float（期望值来源：规约后置条件）。\"\"\"\n    result = rounded_ratio(1, 2)\n    assert isinstance(result, float)\n\n\n# ---------------------------------------------------------------------------\n# 边界路径\n# ---------------------------------------------------------------------------\n\ndef test_rounded_ratio_total_zero():\n    \"\"\"total==0 时返回 0.0 且不抛异常（期望值来源：规约后置条件）。\"\"\"\n    assert rounded_ratio(10, 0) == 0.0\n\n\ndef test_rounded_ratio_hit_zero():\n    \"\"\"hit==0 时结果为 0.0（期望值来源：规约边界情况）。\"\"\"\n    assert rounded_ratio(0, 10) == 0.0\n\n\ndef test_rounded_ratio_both_zero():\n    \"\"\"hit==0 且 total==0 时返回 0.0（期望值来源：规约 total==0 分支）。\"\"\"\n    assert rounded_ratio(0, 0) == 0.0\n\n\ndef test_rounded_ratio_negative_hit():\n    \"\"\"-1/2*100=-50.0，floor(-50.0)/100=-0.5（期望值来源：规约 floor 语义）。\"\"\"\n    assert rounded_ratio(-1, 2) == -0.5\n\n\ndef test_rounded_ratio_negative_total():\n    \"\"\"1/-2*100=-50.0，floor(-50.0)/100=-0.5（期望值来源：规约 floor 语义）。\"\"\"\n    assert rounded_ratio(1, -2) == -0.5\n\n\ndef test_rounded_ratio_both_negative():\n    \"\"\"-1/-2*100=50.0，floor(50.0)/100=0.5（期望值来源：规约 floor 语义）。\"\"\"\n    assert rounded_ratio(-1, -2) == 0.5\n\n\ndef test_rounded_ratio_negative_floor():\n    \"\"\"-1/3*100≈-33.333...，math.floor 向负无穷取整得 -34，除以 100 得 -0.34（期望值来源：规约 floor 语义）。\"\"\"\n    assert rounded_ratio(-1, 3) == -0.34\n\n\ndef test_rounded_ratio_hit_greater_than_total():\n    \"\"\"hit>total 时结果大于 1.0：3/2*100=150.0，floor(150.0)/100=1.5（期望值来源：规约边界情况）。\"\"\"\n    assert rounded_ratio(3, 2) == 1.5\n\n\ndef test_rounded_ratio_large_numbers():\n    \"\"\"1000000/3*100≈33333333.333...，floor 后为 33333333，除以 100 得 333333.33（期望值来源：规约 floor 语义）。\"\"\"\n    assert rounded_ratio(1000000, 3) == 333333.33\n\n\ndef test_rounded_ratio_exact_integer_percentage():\n    \"\"\"hit/total*100 恰为整数时无小数部分：2/5*100=40.0，floor(40.0)/100=0.4（期望值来源：规约边界情况）。\"\"\"\n    assert rounded_ratio(2, 5) == 0.4\n\n\ndef test_rounded_ratio_float_precision_floor():\n    \"\"\"浮点精度误差导致 floor 下移的探索性用例：0.1+0.2 类误差场景。\n\n    期望值来源不明，需人工确认：此处仅断言结果与规约 floor 语义一致，\n    即结果等于 math.floor(hit / total * 100) / 100。\n    \"\"\"\n    hit, total = 1, 10\n    expected = math.floor(hit / total * 100) / 100\n    assert rounded_ratio(hit, total) == expected\n\n\n# ---------------------------------------------------------------------------\n# 类型契约违反路径（前置条件要求 int，违反时行为未在规约中约定）\n# ---------------------------------------------------------------------------\n\ndef test_rounded_ratio_float_input_exploratory():\n    \"\"\"传入 float 违反 int 前置条件，规约未约定行为。\n\n    期望值来源不明，需人工确认：仅记录实际行为，不臆造具体值。\n    \"\"\"\n    try:\n        result = rounded_ratio(1.5, 2)\n    except (TypeError, ValueError):\n        # 允许实现以异常方式拒绝非法类型\n        return\n    # 若未抛异常，则按 Python 动态类型语义记录结果\n    assert isinstance(result, float)\n\n\ndef test_rounded_ratio_none_input_raises():\n    \"\"\"传入 None 违反 int 前置条件，hit/total 运算应抛 TypeError（期望值来源：Python 类型语义）。\"\"\"\n    with pytest.raises(TypeError):\n        rounded_ratio(None, 2)",
