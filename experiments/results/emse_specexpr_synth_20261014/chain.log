          "generated_test": "import math\n\nimport pytest\n\nfrom task_0008 import sqrt\n\n\n# ---------------------------------------------------------------------------\n# 正常路径：x > 0，规约明确要求返回算术平方根（非负）\n# ---------------------------------------------------------------------------\n\ndef test_sqrt_positive_perfect_square():\n    \"\"\"规约后置条件：x > 0 时返回 x 的算术平方根。4.0 的平方根为 2.0。\"\"\"\n    result = sqrt(4.0)\n    assert result == pytest.approx(2.0)\n    assert result >= 0\n\n\ndef test_sqrt_positive_non_perfect_square():\n    \"\"\"规约后置条件：x > 0 时返回算术平方根。2.25 的平方根为 1.5。\"\"\"\n    result = sqrt(2.25)\n    assert result == pytest.approx(1.5)\n    assert result >= 0\n\n\ndef test_sqrt_positive_result_is_non_negative():\n    \"\"\"规约后置条件：x > 0 时返回非负的算术平方根。\"\"\"\n    result = sqrt(9.0)\n    assert result >= 0\n    assert result == pytest.approx(3.0)\n\n\n# ---------------------------------------------------------------------------\n# 边界：x == 0 分支，规约明确要求返回 0\n# ---------------------------------------------------------------------------\n\ndef test_sqrt_zero_returns_zero():\n    \"\"\"规约后置条件：x == 0 时返回 0（走分支 1）。\"\"\"\n    assert sqrt(0) == 0\n\n\ndef test_sqrt_negative_zero_returns_zero():\n    \"\"\"规约边界：-0.0 == 0 为 True，走分支 1，返回 0。\"\"\"\n    assert sqrt(-0.0) == 0\n\n\n# ---------------------------------------------------------------------------\n# 边界：极小正数 / 极大正数\n# 规约未约定精度，期望值来源不明，采用探索性断言（记录实际行为）\n# ---------------------------------------------------------------------------\n\ndef test_sqrt_tiny_positive_exploratory():\n    \"\"\"规约边界：x 为极小正数（1e-308）时不走 0 分支。\n\n    期望值来源不明（规约未约定精度），此处仅记录实际行为：\n    结果应为非负且其平方近似等于输入，需人工确认。\n    \"\"\"\n    x = 1e-308\n    result = sqrt(x)\n    assert result >= 0\n    # 记录实际行为：平方应近似还原输入（在浮点容差内）\n    assert result * result == pytest.approx(x, rel=1e-6, abs=0.0)\n\n\ndef test_sqrt_large_positive_exploratory():\n    \"\"\"规约边界：x 为极大正数（1e308）时不溢出。\n\n    期望值来源不明（规约未约定精度），此处仅记录实际行为：\n    结果应为非负且其平方近似等于输入，需人工确认。\n    \"\"\"\n    x = 1e308\n    result = sqrt(x)\n    assert result >= 0\n    assert result * result == pytest.approx(x, rel=1e-6)\n\n\n# ---------------------------------------------------------------------------\n# 边界：负数\n# 规约后置条件：x < 0 时返回复数结果（类型注解 float 与实际不符）\n# 期望值来源：规约明确说明返回复数，故断言结果为复数类型\n# ---------------------------------------------------------------------------\n\ndef test_sqrt_negative_returns_complex():\n    \"\"\"规约后置条件：x < 0 时返回复数结果（与 float 注解不符）。\n\n    规约明确说明负数返回复数，故断言返回值为 complex 类型。\n    \"\"\"\n    result = sqrt(-1.0)\n    assert isinstance(result, complex)\n\n\ndef test_sqrt_negative_four_returns_complex():\n    \"\"\"规约后置条件：x < 0 时返回复数结果。验证 -4.0 亦返回复数。\"\"\"\n    result = sqrt(-4.0)\n    assert isinstance(result, complex)\n\n\n# ---------------------------------------------------------------------------\n# 边界：NaN\n# 规约边界：NaN == 0 为 False，走默认分支。\n# 规约未约定 NaN 的具体返回行为，采用探索性断言（记录实际行为）\n# ---------------------------------------------------------------------------\n\ndef test_sqrt_nan_exploratory():\n    \"\"\"规约边界：NaN == 0 为 False，走默认分支。\n\n    期望值来源不明（规约未约定 NaN 行为），此处仅记录实际行为：\n    结果应为 NaN 或复数（取决于实现），需人工确认。\n    \"\"\"\n    x = float(\"nan\")\n    result = sqrt(x)\n    # 记录实际行为：结果既非普通有限实数，也不应等于 0\n    assert result != 0\n    if isinstance(result, complex):\n        assert math.isnan(result.real) or math.isnan(result.imag)\n    else:\n        assert math.isnan(result)\n\n\n# ---------------------------------------------------------------------------\n# 边界：inf\n# 规约边界：x 为 inf，走默认分支。inf ** 0.5 返回 inf。\n# ---------------------------------------------------------------------------\n\ndef test_sqrt_positive_infinity():\n    \"\"\"规约边界：x 为 inf 时走默认分支，inf 的平方根为 inf。\"\"\"\n    result = sqrt(float(\"inf\"))\n    assert result == float(\"inf\")",
