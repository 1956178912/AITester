ndef test_lookup_non_str_key_returns_zero(key):\n    \"\"\"非 str 类型键（None / int / float / bool / bytes / tuple）不抛异常，返回 0。\n\n    期望值来源：规约边界情况 \"key 为 None 或非 str 类型（dict.get 不抛异常，返回 0）\"。\n    注意：这些输入不满足前置条件 isinstance(key, str)，但规约明确约定其行为为返回 0，\n    因此按规约断言而非走 pytest.raises 路径。\n    \"\"\"\n    result = lookup(key)\n    assert result == 0\n    assert isinstance(result, int)\n\n\n@pytest.mark.parametrize(\n    \"key\",\n    [\n        \"alpha\",\n        \"beta\",\n        \"gamma\",\n        \"delta\",\n        \"\",\n        \"Alpha\",\n        \"unknown\",\n    ],\n)\ndef test_lookup_result_is_int_and_in_invariant_set(key):\n    \"\"\"返回值恒为 int，且满足不变量 result in {0, 1, 2, 3}。\n\n    期望值来源：规约后置条件 \"返回值恒为 int\"、\"result >= 0\"，\n    以及不变量 \"result == 0 or result == 1 or result == 2 or result == 3\"。\n    \"\"\"\n    result = lookup(key)\n    assert isinstance(result, int)\n    assert result >= 0\n    assert result in (0, 1, 2, 3)\n\n\ndef test_lookup_hit_and_miss_are_consistent():\n    \"\"\"命中与未命中路径的返回值均落在不变量集合内，且命中值互不相同。\n\n    期望值来源：规约后置条件与不变量；alpha/beta/gamma 对应 1/2/3 由规约给出。\n    \"\"\"\n    assert lookup(\"alpha\") == 1\n    assert lookup(\"beta\") == 2\n    assert lookup(\"gamma\") == 3\n    assert lookup(\"nonexistent\") == 0\n    # 命中值互不相同（规约给出 1/2/3）\n    assert len({lookup(\"alpha\"), lookup(\"beta\"), lookup(\"gamma\")}) == 3",
