          "generated_test": "import pytest\n\nfrom task_0015 import split_words\n\n\n# ---------------------------------------------------------------------------\n# 普通 / 主路径用例\n# ---------------------------------------------------------------------------\n\ndef test_split_words_normal_multi_word():\n    \"\"\"普通多词字符串：'hello world foo' → ['hello', 'world', 'foo']。\n\n    期望值来源：规约边界/主路径约定。\n    \"\"\"\n    result = split_words(\"hello world foo\")\n    assert result == [\"hello\", \"world\", \"foo\"]\n\n\ndef test_split_words_normal_no_space():\n    \"\"\"无空格单词：'hello' → ['hello']。\n\n    期望值来源：规约后置条件（无分隔符时返回单元素列表）。\n    \"\"\"\n    result = split_words(\"hello\")\n    assert result == [\"hello\"]\n\n\ndef test_split_words_normal_unicode():\n    \"\"\"含 Unicode 字符：'你 好' → ['你', '好']。\n\n    期望值来源：规约边界情况。\n    \"\"\"\n    result = split_words(\"你 好\")\n    assert result == [\"你\", \"好\"]\n\n\n# ---------------------------------------------------------------------------\n# 边界用例\n# ---------------------------------------------------------------------------\n\ndef test_split_words_boundary_empty_string():\n    \"\"\"空字符串：'' → ['']。\n\n    期望值来源：规约边界情况。\n    \"\"\"\n    result = split_words(\"\")\n    assert result == [\"\"]\n\n\ndef test_split_words_boundary_single_space():\n    \"\"\"单个空格：' ' → ['', '']。\n\n    期望值来源：规约边界情况。\n    \"\"\"\n    result = split_words(\" \")\n    assert result == [\"\", \"\"]\n\n\ndef test_split_words_boundary_consecutive_spaces():\n    \"\"\"连续空格：'a  b' → ['a', '', 'b']。\n\n    期望值来源：规约边界情况。\n    \"\"\"\n    result = split_words(\"a  b\")\n    assert result == [\"a\", \"\", \"b\"]\n\n\ndef test_split_words_boundary_leading_trailing_spaces():\n    \"\"\"前后导空格：' a ' → ['', 'a', '']。\n\n    期望值来源：规约边界情况。\n    \"\"\"\n    result = split_words(\" a \")\n    assert result == [\"\", \"a\", \"\"]\n\n\ndef test_split_words_boundary_tab_newline_not_split():\n    \"\"\"仅含制表符与换行：'\\\\t\\\\n' → ['\\\\t\\\\n']（非空格空白不作为分隔符）。\n\n    期望值来源：规约边界情况。\n    \"\"\