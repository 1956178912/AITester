shable_key_returns_zero(key):\n    \"\"\"边界：int 违反 str 类型注解，但规约声明 dict.get 对可哈希对象\n    返回默认值 0。\n\n    期望值来源：规约边界情况\"key 为 None 或非 str 类型（dict.get\n    可接受任意可哈希对象，返回 0；但违反类型注解）\"。\n    \"\"\"\n    assert lookup(key) == 0\n\n\n# ---------------------------------------------------------------------------\n# 边界：不可哈希对象作为键（规约未约定具体异常类型）\n# ---------------------------------------------------------------------------\ndef test_lookup_unhashable_key_raises_type_error():\n    \"\"\"边界：list 不可哈希，dict.get 会抛 TypeError。\n\n    期望值来源：规约边界情况\"key 为 None 或非 str 类型（dict.get\n    可接受任意可哈希对象，返回 0）\"——不可哈希对象不在\"可接受\"范围内，\n    因此预期抛 TypeError。具体异常类型由 CPython 的 dict.get 语义决定，\n    规约未显式约定异常类型，此处按 Python 标准库语义断言 TypeError。\n    \"\"\"\n    with pytest.raises(TypeError):\n        lookup([])\n\n\n# ---------------------------------------------------------------------------\n# 边界：_TABLE 被外部修改后查询（模块级可变全局状态）\n# ---------------------------------------------------------------------------\ndef test_lookup_reflects_external_table_mutation():\n    \"\"\"边界：_TABLE 为模块级可变全局状态，外部修改后查询应反映最新内容。\n\n    期望值来源不明，需人工确认：规约仅声明 _TABLE 为模块级常量字典，\n    未约定外部修改后的行为。此处采用探索性断言——记录实际行为，\n    仅断言返回值满足后置条件（int 且属于 {0,1,2,3}），不臆造具体值。\n    \"\"\"\n    import task_0078\n\n    table = getattr(task_0078, \"_TABLE\", None)\n    if not isinstance(table, dict):\n        pytest.skip(\"_TABLE 不是可访问的 dict，跳过外部修改场景\")\n\n    original = dict(table)\n    try:\n        table[\"alpha\"] = 999\n        result = lookup(\"alpha\")\n        # 探索性断言：仅校验后置条件，不臆造具体值\n        assert isinstance(result, int)\n        assert result in (0, 1, 2, 3) or result == 999\n    finally:\n        table.clear()\n        table.update(original)",
