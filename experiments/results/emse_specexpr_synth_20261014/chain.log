          "generated_test": "import math\n\nimport pytest\n\nfrom task_0046 import sqrt\n\n\n# ---------------------------------------------------------------------------\n# 正常路径：x != 0，返回 x ** 0.5\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\n    \"x, expected\",\n    [\n        (4.0, 2.0),\n        (2.25, 1.5),\n        (9.0, 3.0),\n        (1.0, 1.0),\n    ],\n)\ndef test_sqrt_positive_returns_square_root(x, expected):\n    \"\"\"规约：x != 0 时返回 x ** 0.5。期望值来源：规约后置条件。\"\"\"\n    result = sqrt(x)\n    assert result == pytest.approx(expected)\n\n\ndef test_sqrt_positive_result_is_non_negative():\n    \"\"\"规约：x >= 0 时返回值 result 满足 result >= 0。期望值来源：规约后置条件。\"\"\"\n    result = sqrt(4.0)\n    assert result >= 0\n\n\ndef test_sqrt_result_squared_equals_input():\n    \"\"\"规约：x != 0 时返回 x ** 0.5，故 result ** 2 应约等于 x。期望值来源：规约后置条件。\"\"\"\n    x = 7.0\n    result = sqrt(x)\n    assert result ** 2 == pytest.approx(x)\n\n\n# ---------------------------------------------------------------------------\n# 边界：x == 0 分支\n# ---------------------------------------------------------------------------\n\ndef test_sqrt_zero_returns_zero():\n    \"\"\"规约：x == 0 时返回 0。期望值来源：规约后置条件（边界情况）。\"\"\"\n    result = sqrt(0.0)\n    assert result == 0\n\n\ndef test_sqrt_zero_result_is_non_negative():\n    \"\"\"规约：x >= 0 时 result >= 0，x == 0 亦满足。期望值来源：规约后置条件。\"\"\"\n    result = sqrt(0.0)\n    assert result >= 0\n\n\n# ---------------------------------------------------------------------------\n# 边界：极小 / 极大正数\n# ---------------------------------------------------------------------------\n\ndef test_sqrt_tiny_positive():\n    \"\"\"规约：x != 0 时返回 x ** 0.5。1e-300 的平方根为 1e-150。期望值来源：规约后置条件。\"\"\"\n    result = sqrt(1e-300)\n    assert result == pytest.approx(1e-150)\n\n\ndef test_sqrt_huge_positive():\n    \"\"\"规约：x != 0 时返回 x ** 0.5。1e308 的平方根为 1e154。期望值来源：规约后置条件。\"\"\"\n    result = sqrt(1e308)\n    assert result == pytest.approx(1e154)\n\n\n# ---------------------------------------------------------------------------\n# 边界：inf\n# ---------------------------------------------------------------------------\n\ndef test_sqrt_positive_infinity():\n    \"\"\"规约：x != 0 时返回 x ** 0.5。inf ** 0.5 == inf。期望值来源：规约后置条件 + 数学语义。\"\"\"\n    result = sqrt(float(\"inf\"))\n    assert math.isinf(result)\n    assert result > 0\n\n\n# ---------------------------------------------------------------------------\n# 边界：负数 / NaN —— 规约未定义具体返回值，采用探索性断言\n# ---------------------------------------------------------------------------\n\ndef test_sqrt_negative_input_behavior():\n    \"\"\"规约未覆盖负数输入的具体返回值（仅说明 x ** 0.5 在 Python 中返回复数，\n    与 float 注解不符）。期望值来源不明，需人工确认：此处仅记录实际行为，\n    断言返回值不是合法的非负实数平方根，或为复数类型。\"\"\"\n    result = sqrt(-4.0)\n    # 记录实际行为：Python 中 (-4.0) ** 0.5 返回复数，与 float 注解不符。\n    # 若实现返回复数，则 isinstance(result, float) 为 False。\n    # 若实现抛异常，则本测试会失败，需人工确认调用方约定。\n    assert not isinstance(result, float) or result >= 0\n\n\ndef test_sqrt_nan_input_behavior():\n    \"\"\"规约未覆盖 NaN 输入的具体返回值。期望值来源不明，需人工确认：\n    此处仅记录实际行为，断言结果为 NaN（若实现按 nan ** 0.5 处理）。\"\"\"\n    result = sqrt(float(\"nan\"))\n    # 记录实际行为：nan ** 0.5 结果为 nan。\n    # 若实现抛异常或返回其他值，需人工确认调用方约定。\n    assert isinstance(result, float) and math.isnan(result)",
