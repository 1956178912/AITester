, 1), (1, 1), (1, 2), (3, 4), (99, 100)]\n    for hit, total in cases:\n        result = rounded_ratio(hit, total)\n        assert 0.0 <= result <= 1.0\n\n\ndef test_rounded_ratio_negative_total_behavior():\n    \"\"\"total 为负数时的行为未在 docstring 中明确说明。\n\n    期望值来源不明，需人工确认。此处仅记录实际行为，\n    断言其与公式 math.floor(hit/total*100)/100 一致。\n    \"\"\"\n    hit, total = 1, -2\n    expected = math.floor(hit / total * 100) / 100\n    assert rounded_ratio(hit, total) == expected\n\n\ndef test_rounded_ratio_hit_greater_than_total_behavior():\n    \"\"\"hit 大于 total 时的行为未在 docstring 中明确说明。\n\n    期望值来源不明，需人工确认。此处仅记录实际行为，\n    断言其与公式 math.floor(hit/total*100)/100 一致。\n    \"\"\"\n    hit, total = 3, 2\n    expected = math.floor(hit / total * 100) / 100\n    assert rounded_ratio(hit, total) == expected",
