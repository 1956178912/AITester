          "generated_test": "import pytest\n\nfrom task_0002 import is_valid_username\n\n\n# ---------------------------------------------------------------------------\n# 规约（Spec）参考：\n#   后置条件 1：返回值为 bool 类型\n#   后置条件 2：result == (not (len(name) > 0 and name.isalnum() and len(name) <= 20))\n#   即：当且仅当 name 非空、全部字符为字母或数字、且长度 <= 20 时返回 False；\n#       否则返回 True。\n# ---------------------------------------------------------------------------\n\n\ndef _spec_expected(name: str) -> bool:\n    \"\"\"根据可执行规约子句计算期望值（期望值来源：规约 SpecExpr）。\"\"\"\n    return not (len(name) > 0 and name.isalnum() and len(name) <= 20)\n\n\n# ---------------------------------------------------------------------------\n# 正常用例\n# ---------------------------------------------------------------------------\n\ndef test_is_valid_username_normal_alnum_returns_false():\n    \"\"\"普通有效用户名：非空、纯字母数字、长度<=20，应返回 False（有效）。\n\n    期望值来源：规约后置条件 result == (not (len>0 and isalnum and len<=20))。\n    \"\"\"\n    name = \"user123\"\n    result = is_valid_username(name)\n    assert result is False\n    assert result == _spec_expected(name)\n\n\ndef test_is_valid_username_pure_alpha_returns_false():\n    \"\"\"纯字母用户名：isalnum 为 True 且长度合规，应返回 False。\n\n    期望值来源：规约后置条件。\n    \"\"\"\n    name = \"Alice\"\n    result = is_valid_username(name)\n    assert result is False\n    assert result == _spec_expected(name)\n\n\ndef test_is_valid_username_pure_digits_returns_false():\n    \"\"\"纯数字用户名：isalnum 对数字为 True，长度合规，应返回 False。\n\n    期望值来源：规约后置条件与边界情况（纯数字串视为有效）。\n    \"\"\"\n    name = \"123456\"\n    result = is_valid_username(name)\n    assert result is False\n    assert result == _spec_expected(name)\n\n\n# ---------------------------------------------------------------------------\n# 边界用例\n# ---------------------------------------------------------------------------\n\ndef test_is_valid_username_empty_string_returns_true():\n    \"\"\"空字符串：bool(name) 为 False，短路后应返回 True（无效）。\n\n    期望值来源：规约边界情况（空字符串返回 True）。\n    \"\"\"\n    name = \"\"\n    result = is_valid_username(name)\n    assert result is True\n    assert result == _spec_expected(name)\n\n\ndef test_is_valid_username_length_exactly_20_returns_false():\n    \"\"\"长度恰为 20 的纯字母数字串：满足 len<=20 边界，应返回 False。\n\n    期望值来源：规约边界情况（长度恰为 20 有效）。\n    \"\"\"\n    name = \"a\" * 20\n    assert len(name) == 20\n    result = is_valid_username(name)\n    assert result is False\n    assert result == _spec_expected(name)\n\n\ndef test_is_valid_username_length_exactly_21_returns_true():\n    \"\"\"长度恰为 21 的纯字母数字串：超出上限，应返回 True（无效）。\n\n    期望值来源：规约边界情况（长度恰为 21 无效）。\n    \"\"\"\n    name = \"a\" * 21\n    assert len(name) == 21\n    result = is_valid_username(name)\n    assert result is True\n    assert result == _spec_expected(name)\n\n\n# ---------------------------------------------------------------------------\n# 异常 / 无效输入用例\n# ---------------------------------------------------------------------------\n\ndef test_is_valid_username_with_space_returns_true():\n    \"\"\"含空格：isalnum 为 False，应返回 True（无效）。\n\n    期望值来源：规约后置条件（含非字母数字字符返回 True）。\n    \"\"\"\n    name = \"user name\"\n    result = is_valid_username(name)\n    assert result is True\n    assert result == _spec_expected(name)\n\n\ndef test_is_valid_username_with_underscore_returns_true():\n    \"\"\"含下划线：下划线非字母数字，isalnum 为 False，应返回 True。\n\n    期望值来源：规约边界情况（含下划线等非字母数字字符）。\n    \"\"\"\n    name = \"user_name\"\n    result = is_valid_username(name)\n    assert result is True\n    assert result == _spec_expected(name)\n\n\ndef test_is_valid_username_with_hyphen_returns_true():\n    \"\"\"含连字符：连字符非字母数字，isalnum 为 False，应返回 True。\n\n    期望值来源：规约边界情况（含连字符等非字母数字字符）。\n    \"\"\"\n    name = \"user-name\"\n    result = is_valid_username(name)\n    assert result is True\n    assert result == _spec_expected(name)\n\n\ndef test_is_valid_username_with_special_symbol_returns_true():\n    \"\"\"含特殊符号 @：isalnum 为 False，应返回 True。\n\n    期望值来源：规约后置条件（含非字母数字字符返回 True）。\n    \"\"\"\n    name = \"user@123\"\n    result = is_valid_username(name)\n    assert result is True\n    assert result == _spec_expected(name)\n\n\ndef test_is_valid_username_overlong_returns_true():\n    \"\"\"超长字符串（远大于 20）：应返回 True（无效）。\n\n    期望值来源：规约边界情况（超长字符串无效）。\n    \"\"\"\n    name = \"a\" * 40\n    assert len(name) > 20\n    result = is_valid_username(name)\n    assert result is True\n    assert result == _spec_expected(name)\n\n\n# ---------------------------------------------------------------------------\n# 返回值类型与规约一致性\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\n    \"name\",\n    [\n        \"\",\n        \"user123\",\n        \"Alice\",\n        \"123456\",\n        \"a\" * 20,\n        \"a\" * 21,\n        \"user name\",\n        \"user_name\",\n        \"user-name\",\n        \"user@123\",\n        \"a\" * 40,\n    ],\n)\ndef test_is_valid_username_returns_bool_and_matches_spec(name):\n    \"\"\"返回值必须为 bool 类型，且与可执行规约子句一致。\n\n    期望值来源：规约后置条件（isinstance(result, bool) 与 SpecExpr）。\n    \"\"\"\n    result = is_valid_username(name)\n    assert isinstance(result, bool)\n    assert result == _spec_expected(name)\n\n\ndef test_is_valid_username_unicode_chinese_exploratory():\n    \"\"\"含中文/Unicode 字符：规约提示 isalnum 对中文返回 True，需注意。\n\n    期望值来源不明，需人工确认：规约仅提示\"isalnum 对中文返回 True，需注意\"，\n    未明确给出中文用户名的期望返回值。此处按可执行规约子句\n    result == (not (len>0 and name.isalnum() and len<=20)) 记录实际行为，\n    若实现与规约子句不一致则暴露差异，供人工确认。\n    \"\"\"\n    name = \"用户名\"\n    result = is_valid_username(name)\n    assert isinstance(result, bool)\n    # 记录实际行为并与规约子句比对（规约子句基于 Python str.isalnum 语义）\n    assert result == _spec_expected(name)",
