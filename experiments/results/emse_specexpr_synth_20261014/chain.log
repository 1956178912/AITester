assert len(result) == text.count(\" \") + 1\n    assert \" \".join(result) == text\n\n\ndef test_split_words_boundary_single_space():\n    \"\"\"单个空格：仅一个空格，返回两个空串元素。\n\n    期望值来源：规约边界情况 \" \" → [\"\", \"\"]。\n    \"\"\"\n    text = \" \"\n    result = split_words(text)\n    assert isinstance(result, list)\n    assert all(isinstance(w, str) for w in result)\n    assert result == [\"\", \"\"]\n    assert len(result) == text.count(\" \") + 1\n    assert \" \".join(result) == text\n\n\ndef test_split_words_boundary_consecutive_spaces():\n    \"\"\"连续空格：连续空格不合并，中间产生空串元素。\n\n    期望值来源：规约边界情况 \"a  b\" → [\"a\", \"\", \"b\"]。\n    \"\"\"\n    text = \"a  b\"\n    result = split_words(text)\n    assert isinstance(result, list)\n    assert all(isinstance(w, str) for w in result)\n    assert result == [\"a\", \"\", \"b\"]\n    assert len(result) == text.count(\" \") + 1\n    assert \" \".join(result) == text\n\n\ndef test_split_words_boundary_leading_trailing_spaces():\n    \"\"\"首尾空格：首尾空格导致首尾空串元素。\n\n    期望值来源：规约边界情况 \" a \" → [\"\", \"a\", \"\"]。\n    \"\"\"\n    text = \" a \"\n    result = split_words(text)\n    assert isinstance(result, list)\n    assert all(isinstance(w, str) for w in result)\n    assert result == [\"\", \"a\", \"\"]\n    assert len(result) == text.count(\" \") + 1\n    assert \" \".join(result) == text\n\n\ndef test_split_words_boundary_only_tab_and_newline():\n    \"\"\"仅含制表符与换行：非空格空白不被分割，整体作为单元素返回。\n\n    期望值来源：规约边界情况 \"\\\\t\\\\n\" → [\"\\\\t\\\\n\"]。\n    \"\"\"\n    text = \"\\t\\n\"\n    result = split_words(text)\n    assert isinstance(result, list)\n    assert all(isinstance(w, str) for w in result)\n    assert result == [\"\\t\\n\"]\n    assert len(result) == text.count(\" \") + 1\n    assert \" \".join(result) == text\n\n\ndef test_split_words_boundary_long_string_many_spaces():\n    \"\"\"超长字符串（大量空格）：列表长度随空格数线性增长，无溢出风险。\n\n    期望值来源：规约边界情况（长度线性增长）+ 后置条件。\n    \"\"\"\n    n = 10000\n    text = \" \" * n\n    result = split_words(text)\n    assert isinstance(result, list)\n    assert all(isinstance(w, str) for w in result)\n    assert len(result) == n + 1\n    assert len(result) == text.count(\" \") + 1\n    assert \" \".join(result) == text\n    assert all(w == \"\" for w in result)\n\n\n# ---------------------------------------------------------------------------\n# 规约不变量 / 后置条件参数化验证\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\n    \"text\",\n    [\n        \"\",\n        \" \",\n        \"  \",\n        \"a\",\n        \"a b\",\n        \"a  b\",\n        \" a \",\n        \"  a  b  \",\n        \"\\t\\n\",\n        \"中 文\",\n        \"hello world foo\",\n        \"a\\tb c\\nd\",\n    ],\n)\ndef test_split_words_postconditions_invariants(text):\n    \"\"\"对多种合法 str 输入验证后置条件与不变量。\n\n    期望值来源：规约后置条件与不变量（不臆造具体切分结果，仅验证可判定性质）。\n    \"\"\"\n    result = split_words(text)\n    assert isinstance(result, list)\n    assert all(isinstance(w, str) for w in result)\n    assert len(result) == text.count(\" \") + 1\n    assert \" \".join(result) == text\n\n\n# ---------------------------------------------------------------------------\n# 异常路径用例（前置条件不满足）\n# ---------------------------------------------------------------------------\n\ndef test_split_words_error_non_string_int():\n    \"\"\"非字符串入参（int）：前置条件要求 text 为 str，传入 int 应抛异常。\n\n    期望值来源：规约前置条件 isinstance(text, str)；具体异常类型未约定，\n    故接受 AttributeError 或 TypeError（需人工确认实际异常类型）。\n    \"\"\"\n    with pytest.raises((AttributeError, TypeError)):\n        split_words(123)\n\n\ndef test_split_words_error_none():\n    \"\"\"None 入参：前置条件要求 text 为 str，传入 None 应抛异常。\n\n    期望值来源：规约前置条件 isinstance(text, str)；具体异常类型未约定，\n    故接受 AttributeError 或 TypeError（需人工确认实际异常类型）。\n    \"\"\"\n    with pytest.raises((AttributeError, TypeError)):\n        split_words(None)",
