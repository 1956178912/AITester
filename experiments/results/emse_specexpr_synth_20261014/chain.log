          "generated_test": "import math\n\nimport pytest\n\nfrom task_0086 import divide\n\n\ndef test_divide_positive_numbers():\n    \"\"\"规约：返回 a / b 的浮点商。6.0 / 2.0 应为 3.0。\"\"\"\n    result = divide(6.0, 2.0)\n    assert result == 3.0\n    assert isinstance(result, float)\n\n\ndef test_divide_negative_dividend_returns_negative_quotient():\n    \"\"\"规约边界：负数相除返回负商。-6.0 / 2.0 应为 -3.0。\"\"\"\n    result = divide(-6.0, 2.0)\n    assert result == -3.0\n\n\ndef test_divide_both_negative_returns_positive_quotient():\n    \"\"\"规约边界：负数相除。两个负数相除结果为正商。-6.0 / -2.0 应为 3.0。\"\"\"\n    result = divide(-6.0, -2.0)\n    assert result == 3.0\n\n\ndef test_divide_zero_dividend_returns_zero():\n    \"\"\"规约边界：a 为 0 且 b 非 0 返回 0.0。\"\"\"\n    result = divide(0.0, 5.0)\n    assert result == 0.0\n\n\ndef test_divide_zero_dividend_negative_divisor_returns_zero():\n    \"\"\"规约边界：a 为 0 且 b 非 0 返回 0.0（b 为负数时同样为 0.0）。\"\"\"\n    result = divide(0.0, -5.0)\n    assert result == 0.0\n\n\ndef test_divide_by_float_zero_raises_zero_division_error():\n    \"\"\"规约：b 为 0.0 时抛出 ZeroDivisionError。\"\"\"\n    with pytest.raises(ZeroDivisionError):\n        divide(1.0, 0.0)\n\n\ndef test_divide_by_int_zero_raises_zero_division_error():\n    \"\"\"规约边界：b 为整数 0 时同样触发 ZeroDivisionError。\"\"\"\n    with pytest.raises(ZeroDivisionError):\n        divide(1.0, 0)\n\n\ndef test_divide_non_numeric_input_raises_type_error():\n    \"\"\"规约边界：非数值类型传入触发 TypeError。\"\"\"\n    with pytest.raises(TypeError):\n        divide(\"1\", 2.0)\n\n\ndef test_divide_non_numeric_divisor_raises_type_error():\n    \"\"\"规约边界：非数值类型作为除数传入触发 TypeError。\"\"\"\n    with pytest.raises(TypeError):\n        divide(1.0, \"2\")\n\n\ndef test_divide_large_overflow_records_actual_behavior():\n    \"\"\"规约边界：极大/极小浮点数可能溢出为 inf 或下溢为 0.0。\n\n    期望值来源不明，需人工确认：规约仅说明\"可能溢出为 inf 或下溢为 0.0\"，\n    未给出确定结果，故此处记录实际行为并断言其为 float 且与规约描述一致\n    （inf 或有限值）。\n    \"\"\"\n    result = divide(1e308, 1e-308)\n    assert isinstance(result, float)\n    assert math.isinf(result) or math.isfinite(result)\n\n\ndef test_divide_underflow_records_actual_behavior():\n    \"\"\"规约边界：极小浮点数相除可能下溢为 0.0。\n\n    期望值来源不明，需人工确认：规约仅说明\"可能下溢为 0.0\"，\n    未给出确定结果，故记录实际行为并断言其为 float。\n    \"\"\"\n    result = divide(1e-308, 1e308)\n    assert isinstance(result, float)\n    assert result == 0.0 or math.isfinite(result)",
