          "generated_test": "import math\n\nimport pytest\n\nfrom task_0025 import rounded_ratio\n\n\ndef test_rounded_ratio_zero_total_returns_zero():\n    \"\"\"total 为 0 时应返回 0.0（依据函数实现中的显式分支）。\"\"\"\n    assert rounded_ratio(0, 0) == 0.0\n    assert rounded_ratio(5, 0) == 0.0\n    assert rounded_ratio(100, 0) == 0.0\n\n\ndef test_rounded_ratio_zero_hit_returns_zero():\n    \"\"\"hit 为 0 且 total 非 0 时，比值为 0，结果应为 0.0。\"\"\"\n    assert rounded_ratio(0, 1) == 0.0\n    assert rounded_ratio(0, 100) == 0.0\n\n\ndef test_rounded_ratio_full_hit_returns_one():\n    \"\"\"hit 等于 total 时，比值为 1，结果应为 1.0。\"\"\"\n    assert rounded_ratio(1, 1) == 1.0\n    assert rounded_ratio(100, 100) == 1.0\n\n\ndef test_rounded_ratio_floor_to_two_decimals():\n    \"\"\"结果应为向下取整到两位小数的百分比值（依据 math.floor 实现）。\"\"\"\n    # 1/3 * 100 = 33.333... -> floor(33.333...) = 33 -> 0.33\n    assert rounded_ratio(1, 3) == 0.33\n    # 2/3 * 100 = 66.666... -> floor(66.666...) = 66 -> 0.66\n    assert rounded_ratio(2, 3) == 0.66\n    # 1/8 * 100 = 12.5 -> floor(12.5) = 12 -> 0.12\n    assert rounded_ratio(1, 8) == 0.12\n\n\ndef test_rounded_ratio_exact_percentage():\n    \"\"\"能整除的比值应精确返回对应的小数。\"\"\"\n    assert rounded_ratio(1, 2) == 0.5\n    assert rounded_ratio(1, 4) == 0.25\n    assert rounded_ratio(3, 4) == 0.75\n    assert rounded_ratio(1, 10) == 0.1\n\n\ndef test_rounded_ratio_returns_float_type():\n    \"\"\"返回值类型应为 float。\"\"\"\n    result = rounded_ratio(1, 2)\n    assert isinstance(result, float)\n\n\ndef test_rounded_ratio_never_rounds_up():\n    \"\"\"由于使用 floor，结果不应向上取整（例如 0.999 不应变成 1.0）。\"\"\"\n    # 999/1000 * 100 = 99.9 -> floor(99.9) = 99 -> 0.99\n    assert rounded_ratio(999, 1000) == 0.99\n    # 199/200 * 100 = 99.5 -> floor(99.5) = 99 -> 0.99\n    assert rounded_ratio(199, 200) == 0.99\n\n\n@pytest.mark.parametrize(\n    \"hit, total, expected\",\n    [\n        (0, 0, 0.0),\n        (0, 5, 0.0),\n        (5, 5, 1.0),\n        (1, 2, 0.5),\n        (1, 3, 0.33),\n        (2, 3, 0.66),\n        (1, 8, 0.12),\n        (7, 8, 0.87),\n        (1, 100, 0.01),\n        (99, 100, 0.99),\n    ],\n)\ndef test_rounded_ratio_parametrized(hit, total, expected):\n    \"\"\"参数化验证多种输入下的向下取整百分比结果。\"\"\"\n    assert rounded_ratio(hit, total) == expected\n\n\ndef test_rounded_ratio_matches_manual_formula():\n    \"\"\"结果应与手动按 math.floor(hit/total*100)/100 计算一致。\"\"\"\n    for hit, total in [(1, 7), (3, 11), (13, 17), (22, 7), (5, 9)]:\n        expected = math.floor(hit / total * 100) / 100\n        assert rounded_ratio(hit, total) == expected",
