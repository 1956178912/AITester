          "generated_test": "import math\n\nimport pytest\n\nfrom task_0073 import sqrt\n\n\ndef test_sqrt_positive_integer_float():\n    \"\"\"规约：x != 0 时返回 x ** 0.5。输入 4.0 期望 2.0。\"\"\"\n    assert sqrt(4.0) == 2.0\n\n\ndef test_sqrt_positive_decimal():\n    \"\"\"规约：x != 0 时返回 x ** 0.5。输入 2.25 期望 1.5。\"\"\"\n    assert sqrt(2.25) == 1.5\n\n\ndef test_sqrt_zero_returns_zero():\n    \"\"\"规约：x == 0 时返回 0。输入 0 期望 0。\"\"\"\n    result = sqrt(0)\n    assert result == 0\n\n\ndef test_sqrt_negative_zero_returns_zero():\n    \"\"\"规约：-0.0 == 0 为 True，走 x == 0 分支返回 0。\"\"\"\n    result = sqrt(-0.0)\n    assert result == 0\n\n\ndef test_sqrt_large_positive():\n    \"\"\"规约：极大正数（1e308）开方约 1e154，不溢出。\"\"\"\n    result = sqrt(1e308)\n    assert result == pytest.approx(1e154, rel=1e-9)\n\n\ndef test_sqrt_tiny_positive_underflow():\n    \"\"\"规约：极小正数（5e-324）开方下溢为 0.0。\"\"\"\n    result = sqrt(5e-324)\n    assert result == 0.0\n\n\ndef test_sqrt_negative_input_behavior():\n    \"\"\"规约：x 为负数时 x ** 0.5 在 Python 中产生复数，非 float。\n\n    期望值来源不明，需人工确认调用方对负数输入的约定\n    （抛异常还是返回复数）。此处记录实际行为，仅断言与规约一致：\n    结果等于 (-4.0) ** 0.5。\n    \"\"\"\n    result = sqrt(-4.0)\n    assert result == (-4.0) ** 0.5\n\n\ndef test_sqrt_nan_input_behavior():\n    \"\"\"规约：NaN == 0 为 False，返回 NaN。\n\n    期望值来源不明，需人工确认调用方对 NaN 的处理约定。\n    此处记录实际行为：结果应为 NaN。\n    \"\"\"\n    result = sqrt(float(\"nan\"))\n    assert math.isnan(result)\n\n\ndef test_sqrt_inf_input():\n    \"\"\"规约：inf == 0 为 False，inf ** 0.5 返回 inf。\"\"\"\n    result = sqrt(float(\"inf\"))\n    assert result == float(\"inf\")\n\n\n@pytest.mark.parametrize(\n    \"x, expected\",\n    [\n        (1.0, 1.0),\n        (9.0, 3.0),\n        (0.25, 0.5),\n        (100.0, 10.0),\n    ],\n)\ndef test_sqrt_positive_values_parametrized(x, expected):\n    \"\"\"规约：x != 0 时返回 x ** 0.5。参数化验证多个正数输入。\"\"\"\n    assert sqrt(x) == pytest.approx(expected)",
