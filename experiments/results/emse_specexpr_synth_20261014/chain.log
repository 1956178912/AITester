rst_item_returns_str_type(restore_global_list):\n    \"\"\"在当前全局数据（字符串列表）下，first_item() 返回值类型应为 str。\n\n    期望值来源：规约后置条件\"返回值类型为 str（在当前全局数据下）\"。\n    \"\"\"\n    module = restore_global_list\n    module.list = [\"a\", \"b\", \"c\"]\n    result = first_item()\n    assert isinstance(result, str)\n\n\ndef test_first_item_non_list_global_behavior(restore_global_list):\n    \"\"\"全局 list 被重新赋值为非列表对象时的行为。\n\n    期望值来源不明，需人工确认：规约仅列出该边界情况，未约定具体结果。\n    此处仅记录实际行为，不做恒真/恒失败断言。\n    \"\"\"\n    module = restore_global_list\n    module.list = \"not-a-list\"\n    try:\n        result = first_item()\n    except Exception as exc:  # noqa: BLE001 - 记录实际行为\n        # 记录实际抛出的异常类型，供人工确认是否符合预期\n        assert isinstance(exc, Exception)\n    else:\n        # 记录实际返回值，供人工确认是否符合预期\n        assert result == module.list[0]",
