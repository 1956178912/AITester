-----------------------------------------------------------------\n# 边界：极小正数与极大值（期望值未知，记录实际行为）\n# ---------------------------------------------------------------------------\n\ndef test_sqrt_smallest_positive_float():\n    \"\"\"极小正数 x=5e-324（最小正浮点数）：走 x != 0 分支。\n\n    期望值来源不明，需人工确认：规约未给出该输入的具体返回值，\n    仅验证不抛异常且结果非负（不变量 result >= 0）。\n    \"\"\"\n    result = sqrt(5e-324)\n    assert result >= 0\n\n\ndef test_sqrt_large_value():\n    \"\"\"极大值 x=1e308：走 x != 0 分支，可能溢出为 inf。\n\n    期望值来源不明，需人工确认：规约仅提示\"可能溢出为 inf\"，\n    未给出确定返回值，仅验证不抛异常且结果非负。\n    \"\"\"\n    result = sqrt(1e308)\n    assert result >= 0\n\n\n# ---------------------------------------------------------------------------\n# 边界：NaN / inf（期望值未知，记录实际行为）\n# ---------------------------------------------------------------------------\n\ndef test_sqrt_nan_input():\n    \"\"\"NaN 输入：NaN != 0，走 x ** 0.5 分支，Python 中结果为 NaN。\n\n    期望值来源不明，需人工确认：规约将 NaN 列为边界情况但未给出确定返回值，\n    仅验证不抛异常；若返回 NaN 则记录该实际行为。\n    \"\"\"\n    result = sqrt(float(\"nan\"))\n    # 记录实际行为：NaN 的平方根在 Python 中仍为 NaN\n    assert math.isnan(result) or result >= 0\n\n\ndef test_sqrt_positive_infinity_input():\n    \"\"\"正无穷输入：inf != 0，走 x ** 0.5 分支，Python 中结果为 inf。\n\n    期望值来源不明，需人工确认：规约将 inf 列为边界情况但未给出确定返回值，\n    仅验证不抛异常且结果非负。\n    \"\"\"\n    result = sqrt(float(\"inf\"))\n    assert result >= 0\n\n\n# ---------------------------------------------------------------------------\n# 异常语义路径：负数输入\n# ---------------------------------------------------------------------------\n\ndef test_sqrt_negative_input_undefined_semantics():\n    \"\"\"负数输入 x=-4.0：规约标注为\"未定义/异常语义\"。\n\n    期望值来源不明，需人工确认：规约指出 x ** 0.5 在 Python 中返回复数，\n    与 float 返回注解不符。此处记录实际行为——要么抛出异常，\n    要么返回复数（非 float），要么返回其他值；不做具体值断言。\n    \"\"\"\n    try:\n        result = sqrt(-4.0)\n    except Exception:\n        # 实现选择抛出异常，符合\"异常语义\"路径\n        return\n    # 未抛异常：记录实际行为，结果不应是满足非负 float 后置条件的普通值\n    assert isinstance(result, complex) or not (isinstance(result, float) and result >= 0)",
