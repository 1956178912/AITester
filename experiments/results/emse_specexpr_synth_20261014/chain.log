          "generated_test": "import pytest\n\nfrom task_0042 import lookup\n\n\n# ---------------------------------------------------------------------------\n# 规约常量（来自自然语言规约，非实现细节）\n# ---------------------------------------------------------------------------\n_TABLE_SPEC = {\"alpha\": 1, \"beta\": 2, \"gamma\": 3}\n\n\n# ---------------------------------------------------------------------------\n# 正常路径：命中 _TABLE 中的键\n# ---------------------------------------------------------------------------\n@pytest.mark.parametrize(\n    \"key, expected\",\n    [\n        (\"alpha\", 1),\n        (\"beta\", 2),\n        (\"gamma\", 3),\n    ],\n)\ndef test_lookup_hit_returns_table_value(key, expected):\n    \"\"\"规约：key 在 _TABLE 中时返回值等于 _TABLE[key]。\n\n    期望值来源：自然语言规约中 _TABLE 的固定内容。\n    \"\"\"\n    result = lookup(key)\n    assert result == expected\n    assert result == _TABLE_SPEC[key]\n\n\n# ---------------------------------------------------------------------------\n# 正常路径：未命中返回 0\n# ---------------------------------------------------------------------------\n@pytest.mark.parametrize(\n    \"key\",\n    [\"delta\", \"alpha \", \" alpha\", \"ALPHA\", \"Beta\", \"GAMMA\", \"0\", \"1\"],\n)\ndef test_lookup_miss_returns_zero(key):\n    \"\"\"规约：key 不在 _TABLE 中时返回 0。\n\n    期望值来源：自然语言规约后置条件。\n    \"\"\"\n    assert lookup(key) == 0\n\n\n# ---------------------------------------------------------------------------\n# 边界：空字符串\n# ---------------------------------------------------------------------------\ndef test_lookup_empty_string_returns_zero():\n    \"\"\"边界：空字符串 \"\" 未命中，返回 0。\n\n    期望值来源：自然语言规约边界情况。\n    \"\"\"\n    assert lookup(\"\") == 0\n\n\n# ---------------------------------------------------------------------------\n# 边界：大小写变体\n# ---------------------------------------------------------------------------\n@pytest.mark.parametrize(\"key\", [\"Alpha\", \"BETA\", \"Gamma\", \"aLpHa\"])\ndef test_lookup_case_variant_returns_zero(key):\n    \"\"\"边界：字典键区分大小写，大小写变体未命中返回 0。\n\n    期望值来源：自然语言规约边界情况。\n    \"\"\"\n    assert lookup(key) == 0\n\n\n# ---------------------------------------------------------------------------\n# 后置条件：返回值恒为 int 且满足不变量\n# ---------------------------------------------------------------------------\n@pytest.mark.parametrize(\n    \"key\",\n    [\"alpha\", \"beta\", \"gamma\", \"delta\", \"\", \"Alpha\", \"unknown_key\"],\n)\ndef test_lookup_result_is_int_and_invariant(key):\n    \"\"\"后置/不变量：返回值恒为 int，且 result == 0 or result in (1, 2, 3)。\n\n    期望值来源：可执行规约后置条件与不变量。\n    \"\"\"\n    result = lookup(key)\n    assert isinstance(result, int)\n    assert result >= 0\n    assert result == 0 or result in (1, 2, 3)\n\n\n# ---------------------------------------------------------------------------\n# 边界：非 str 类型键（违反类型注解）\n# ---------------------------------------------------------------------------\n@pytest.mark.parametrize(\"key\", [None, 123, 1.5, (\"alpha\",), b\"alpha\"])\ndef test_lookup_non_str_key_behavior(key):\n    \"\"\"边界：违反 str 类型注解传入非 str 键。\n\n    期望值来源不明，需人工确认：规约仅说明 dict.get 可接受任意可哈希\n    对象并返回默认值 0，但未明确 lookup 对非 str 输入的行为（可能返回 0，\n    也可能因类型检查抛异常）。此处记录实际行为，不做具体值断言。\n    \"\"\"\n    try:\n        result = lookup(key)\n    except (TypeError, KeyError, ValueError) as exc:\n        # 实现选择对非 str 输入抛异常，记录该行为\n        assert exc is not None\n    else:\n        # 若未抛异常，则返回值应满足后置条件与不变量\n        assert isinstance(result, int)\n        assert result >= 0\n        assert result == 0 or result in (1, 2, 3)",
