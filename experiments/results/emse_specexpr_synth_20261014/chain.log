          "generated_test": "import pytest\n\nfrom task_0013 import lookup\n\n\n# 规约中声明的预定义表内容，用于校验不变量与命中期望值\n_EXPECTED_TABLE = {\"alpha\": 1, \"beta\": 2, \"gamma\": 3}\n\n\ndef test_lookup_hit_alpha_returns_1():\n    \"\"\"命中分支：key=\"alpha\" 应返回 1（期望值来源：规约 _TABLE 定义）。\"\"\"\n    assert lookup(\"alpha\") == 1\n\n\ndef test_lookup_hit_beta_returns_2():\n    \"\"\"命中分支：key=\"beta\" 应返回 2（期望值来源：规约 _TABLE 定义）。\"\"\"\n    assert lookup(\"beta\") == 2\n\n\ndef test_lookup_hit_gamma_returns_3():\n    \"\"\"命中分支：key=\"gamma\" 应返回 3（期望值来源：规约 _TABLE 定义）。\"\"\"\n    assert lookup(\"gamma\") == 3\n\n\ndef test_lookup_miss_returns_default_zero():\n    \"\"\"未命中分支：不存在的键应返回默认值 0（期望值来源：规约后置条件）。\"\"\"\n    assert lookup(\"delta\") == 0\n\n\ndef test_lookup_empty_string_key_returns_zero():\n    \"\"\"边界：空字符串键未命中，应返回 0（期望值来源：规约边界情况 + 默认值 0）。\"\"\"\n    assert lookup(\"\") == 0\n\n\ndef test_lookup_case_sensitive_alpha_returns_zero():\n    \"\"\"边界：键区分大小写，\"Alpha\" 未命中应返回 0（期望值来源：规约边界情况）。\"\"\"\n    assert lookup(\"Alpha\") == 0\n\n\ndef test_lookup_long_string_key_returns_zero():\n    \"\"\"边界：超长字符串未命中应返回 0（期望值来源：规约边界情况 + 默认值 0）。\"\"\"\n    long_key = \"a\" * 10000\n    assert lookup(long_key) == 0\n\n\ndef test_lookup_none_key_returns_zero():\n    \"\"\"边界：None 作为键，dict.get(None, 0) 语义下返回 0。\n\n    期望值来源：规约边界情况说明（运行时 dict.get 接受任意可哈希对象，\n    None 可哈希且不在 _TABLE 中，故返回默认值 0）。\n    \"\"\"\n    assert lookup(None) == 0\n\n\ndef test_lookup_unhashable_key_raises_type_error():\n    \"\"\"异常路径：不可哈希对象（list）作为键应触发 TypeError。\n\n    期望值来源：规约边界情况明确说明不可哈希对象会触发 TypeError。\n    \"\"\"\n    with pytest.raises(TypeError):\n        lookup([1, 2])\n\n\ndef test_lookup_return_type_is_int():\n    \"\"\"后置条件：返回值始终为 int（命中与未命中均校验）。\"\"\"\n    assert isinstance(lookup(\"alpha\"), int)\n    assert isinstance(lookup(\"nonexistent\"), int)\n\n\ndef test_lookup_does_not_modify_table():\n    \"\"\"后置条件：调用 lookup 不修改模块级 _TABLE。\n\n    通过多次调用后再次命中已知键，确认映射关系未被破坏。\n    \"\"\"\n    lookup(\"alpha\")\n    lookup(\"nonexistent\")\n    lookup(\"\")\n    assert lookup(\"alpha\") == 1\n    assert lookup(\"beta\") == 2\n    assert lookup(\"gamma\") == 3\n    assert lookup(\"delta\") == 0\n\n\n@pytest.mark.parametrize(\n    \"key, expected\",\n    [\n        (\"alpha\", 1),\n        (\"beta\", 2),\n        (\"gamma\", 3),\n        (\"delta\", 0),\n        (\"\", 0),\n        (\"Alpha\", 0),\n        (\"GAMMA\", 0),\n        (\"alpha \", 0),\n        (\" alpha\", 0),\n    ],\n)\ndef test_lookup_parametrized_hits_and_misses(key, expected):\n    \"\"\"参数化覆盖：命中与未命中（含大小写、空白差异）均返回预期值。\n\n    期望值来源：规约 _TABLE 定义与默认值 0。\n    \"\"\"\n    assert lookup(key) == expected",
