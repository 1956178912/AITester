          "generated_test": "import pytest\n\nfrom task_0036 import is_valid_username\n\n\n# ---------------------------------------------------------------------------\n# 正常用例\n# ---------------------------------------------------------------------------\n\ndef test_is_valid_username_valid_alnum_returns_false():\n    \"\"\"规约：非空、全字母数字、长度 <= 20 → 返回 False。\"\"\"\n    result = is_valid_username(\"user123\")\n    assert isinstance(result, bool)\n    assert result is False\n\n\ndef test_is_valid_username_valid_letters_returns_false():\n    \"\"\"规约：纯字母且长度合规 → 返回 False。\"\"\"\n    result = is_valid_username(\"Alice\")\n    assert isinstance(result, bool)\n    assert result is False\n\n\ndef test_is_valid_username_valid_digits_returns_false():\n    \"\"\"规约：纯数字 isalnum 为真且长度合规 → 返回 False。\"\"\"\n    result = is_valid_username(\"12345\")\n    assert isinstance(result, bool)\n    assert result is False\n\n\n# ---------------------------------------------------------------------------\n# 边界用例\n# ---------------------------------------------------------------------------\n\ndef test_is_valid_username_empty_string_returns_true():\n    \"\"\"规约：空串 → 返回 True（无效）。\"\"\"\n    result = is_valid_username(\"\")\n    assert isinstance(result, bool)\n    assert result is True\n\n\ndef test_is_valid_username_length_exactly_20_returns_false():\n    \"\"\"规约：长度恰为 20 的合法字母数字串 → 返回 False。\"\"\"\n    name = \"abcdefghij1234567890\"\n    assert len(name) == 20\n    result = is_valid_username(name)\n    assert isinstance(result, bool)\n    assert result is False\n\n\ndef test_is_valid_username_length_exactly_21_returns_true():\n    \"\"\"规约：长度恰为 21 的合法字母数字串 → 返回 True。\"\"\"\n    name = \"abcdefghij12345678901\"\n    assert len(name) == 21\n    result = is_valid_username(name)\n    assert isinstance(result, bool)\n    assert result is True\n\n\ndef test_is_valid_username_length_1000_returns_true():\n    \"\"\"规约：超长字符串（1000 字符）→ 返回 True。\"\"\"\n    name = \"a\" * 1000\n    assert len(name) == 1000\n    result = is_valid_username(name)\n    assert isinstance(result, bool)\n    assert result is True\n\n\n# ---------------------------------------------------------------------------\n# 错误 / 非法字符用例\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\n    \"name\",\n    [\n        \"user name\",   # 含空格\n        \"user_name\",   # 含下划线\n        \"user-name\",   # 含连字符\n        \"用户名\",       # 含中文\n        \"user@123\",    # 含特殊符号\n    ],\n)\ndef test_is_valid_username_non_alnum_returns_true(name):\n    \"\"\"规约：含非字母数字字符 → 返回 True（无效）。\"\"\"\n    result = is_valid_username(name)\n    assert isinstance(result, bool)\n    assert result is True\n\n\n# ---------------------------------------------------------------------------\n# 规约形式化子句一致性（属性式校验）\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\n    \"name\",\n    [\n        \"\",\n        \"user123\",\n        \"Alice\",\n        \"12345\",\n        \"abcdefghij1234567890\",\n        \"abcdefghij12345678901\",\n        \"a\" * 1000,\n        \"user name\",\n        \"user_name\",\n        \"user-name\",\n        \"用户名\",\n        \"user@123\",\n    ],\n)\ndef test_is_valid_username_matches_spec_clause(name):\n    \"\"\"规约可执行子句：result == (not (bool(name) and name.isalnum() and len(name) <= 20))。\"\"\"\n    result = is_valid_username(name)\n    assert isinstance(result, bool)\n    expected = not (bool(name) and name.isalnum() and len(name) <= 20)\n    assert result == expected",
