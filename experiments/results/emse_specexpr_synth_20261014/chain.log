          "generated_test": "import pytest\n\nfrom task_0005 import aggregate\n\n\ndef test_aggregate_returns_mean_of_values():\n    \"\"\"aggregate 应返回列表元素的算术平均值。\n\n    期望值来源：函数实现 sum(values) / len(values) 与 docstring 语义一致。\n    \"\"\"\n    assert aggregate([1, 2, 3, 4]) == pytest.approx(2.5)\n\n\ndef test_aggregate_single_element():\n    \"\"\"单元素列表的平均值应等于该元素本身。\n\n    期望值来源：算术平均值定义。\n    \"\"\"\n    assert aggregate([7]) == pytest.approx(7.0)\n\n\ndef test_aggregate_returns_float_type():\n    \"\"\"aggregate 的返回类型应为 float。\n\n    期望值来源：函数类型注解 -> float。\n    \"\"\"\n    result = aggregate([1, 2, 3])\n    assert isinstance(result, float)\n\n\ndef test_aggregate_negative_values():\n    \"\"\"包含负数的列表应正确计算平均值。\n\n    期望值来源：算术平均值定义。\n    \"\"\"\n    assert aggregate([-1, -2, -3]) == pytest.approx(-2.0)\n\n\ndef test_aggregate_mixed_sign_values():\n    \"\"\"正负混合列表的平均值应正确。\n\n    期望值来源：算术平均值定义。\n    \"\"\"\n    assert aggregate([-10, 10, 5]) == pytest.approx(5.0 / 3.0)\n\n\ndef test_aggregate_float_values():\n    \"\"\"浮点数列表的平均值应正确。\n\n    期望值来源：算术平均值定义。\n    \"\"\"\n    assert aggregate([0.5, 1.5, 2.5]) == pytest.approx(1.5)\n\n\ndef test_aggregate_empty_list_raises_zero_division():\n    \"\"\"空列表会触发除零错误（历史 bug）。\n\n    期望值来源：实现中 len(values) 为 0 导致 ZeroDivisionError，\n    该行为为已知历史 bug，此处记录当前实际行为。\n    \"\"\"\n    with pytest.raises(ZeroDivisionError):\n        aggregate([])\n\n\ndef test_aggregate_large_values():\n    \"\"\"大数值列表的平均值应正确。\n\n    期望值来源：算术平均值定义。\n    \"\"\"\n    assert aggregate([10**6, 2 * 10**6, 3 * 10**6]) == pytest.approx(2 * 10**6)\n\n\ndef test_aggregate_does_not_mutate_input():\n    \"\"\"aggregate 不应修改传入的列表。\n\n    期望值来源：函数实现仅做读取与求和，无副作用。\n    \"\"\"\n    values = [1, 2, 3]\n    original = list(values)\n    aggregate(values)\n    assert values == original",
