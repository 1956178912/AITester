t result == \"3.R\"\n\n\n# ---------------------------------------------------------------------------\n# 错误用例\n# ---------------------------------------------------------------------------\n\ndef test_initials_none_raises_attribute_error():\n    \"\"\"输入为 None 时抛出 AttributeError。\n\n    期望值来源：规约前置条件与边界情况明确说明 None 在 split 处触发 AttributeError。\n    \"\"\"\n    with pytest.raises(AttributeError):\n        initials(None)\n\n\n# ---------------------------------------------------------------------------\n# 规约性质（后置条件 / 不变量）参数化验证\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\n    \"full_name\",\n    [\n        \"john ronald reuel tolkien\",\n        \"alice\",\n        \"John Doe\",\n        \"\",\n        \"   \",\n        \"  john\\tdoe  \",\n        \"john\\ndoe\",\n        \"3rd rock\",\n        \"a b c d e\",\n        \"  leading\",\n        \"trailing  \",\n    ],\n)\ndef test_initials_postcondition_join_of_upper_first_chars(full_name):\n    \"\"\"后置条件：result == '.'.join(p[0].upper() for p in full_name.split())。\n\n    期望值来源：规约后置条件（可执行子句）。\n    \"\"\"\n    result = initials(full_name)\n    assert isinstance(result, str)\n    assert result == \".\".join(p[0].upper() for p in full_name.split())\n\n\n@pytest.mark.parametrize(\n    \"full_name\",\n    [\n        \"john ronald reuel tolkien\",\n        \"alice\",\n        \"John Doe\",\n        \"\",\n        \"   \",\n        \"  john\\tdoe  \",\n        \"john\\ndoe\",\n        \"3rd rock\",\n        \"a b c d e\",\n    ],\n)\ndef test_initials_invariant_length_relation(full_name):\n    \"\"\"不变量：len(result) == len(full_name.split()) or len(result) == 0。\n\n    期望值来源：规约不变量（可执行子句）。\n    \"\"\"\n    result = initials(full_name)\n    assert len(result) == len(full_name.split()) or len(result) == 0\n\n\n@pytest.mark.parametrize(\n    \"full_name\",\n    [\n        \"john ronald reuel tolkien\",\n        \"alice\",\n        \"John Doe\",\n        \"\",\n        \"