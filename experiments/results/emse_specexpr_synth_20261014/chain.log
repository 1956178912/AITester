          "generated_test": "import pytest\n\nfrom task_0041 import lookup\n\n\n# 规约中声明的模块级常量字典（用于推导期望值，不依赖实现内部符号）\n_TABLE_SPEC = {\"alpha\": 1, \"beta\": 2, \"gamma\": 3}\n\n\n@pytest.mark.parametrize(\n    \"key, expected\",\n    [\n        (\"alpha\", 1),\n        (\"beta\", 2),\n        (\"gamma\", 3),\n    ],\n)\ndef test_lookup_hit_keys_return_table_value(key, expected):\n    \"\"\"命中 _TABLE 中的键时，返回值应等于 _TABLE[key]。\n\n    期望值来源：规约「key 在 _TABLE 中时 result == _TABLE[key]」。\n    \"\"\"\n    result = lookup(key)\n    assert result == expected\n    assert result == _TABLE_SPEC[key]\n\n\n@pytest.mark.parametrize(\n    \"key\",\n    [\"delta\", \"\", \"Alpha\", \"ALPHA\", \"Beta\", \"gamma \", \" gamma\", \"unknown\"],\n)\ndef test_lookup_miss_keys_return_zero(key):\n    \"\"\"未命中 _TABLE 的键应返回默认值 0。\n\n    期望值来源：规约「key 不在 _TABLE 中时 result == 0」及边界情况\n    （空字符串、大小写变体、普通不存在字符串）。\n    \"\"\"\n    assert key not in _TABLE_SPEC\n    result = lookup(key)\n    assert result == 0\n\n\ndef test_lookup_none_key_returns_zero():\n    \"\"\"key 为 None 时，dict.get 语义下未命中，应返回 0。\n\n    期望值来源：规约边界情况「key 为 None 或非 str 类型……返回 0」。\n    \"\"\"\n    result = lookup(None)\n    assert result == 0\n\n\n@pytest.mark.parametrize(\n    \"key\",\n    [\"alpha\", \"beta\", \"gamma\", \"delta\", \"\", \"Alpha\"],\n)\ndef test_lookup_return_type_is_int(key):\n    \"\"\"返回值类型必须为 int。\n\n    期望值来源：规约后置条件「返回值类型为 int」。\n    \"\"\"\n    result = lookup(key)\n    assert isinstance(result, int)\n\n\n@pytest.mark.parametrize(\n    \"key\",\n    [\"alpha\", \"beta\", \"gamma\", \"delta\", \"\", \"Alpha\", \"unknown\"],\n)\ndef test_lookup_result_non_negative(key):\n    \"\"\"返回值必须非负。\n\n    期望值来源：规约后置条件「result >= 0」。\n    \"\"\"\n    result = lookup(key)\n    assert result >= 0\n\n\n@pytest.mark.parametrize(\n    \"key\",\n    [\"alpha\", \"beta\", \"gamma\", \"delta\", \"\", \"Alpha\", \"unknown\"],\n)\ndef test_lookup_invariant_result_in_allowed_set(key):\n    \"\"\"返回值不变量：result == 0 或 result in (1, 2, 3)。\n\n    期望值来源：规约不变量「result == 0 or result in (1, 2, 3)」。\n    \"\"\"\n    result = lookup(key)\n    assert result == 0 or result in (1, 2, 3)\n\n\n@pytest.mark.parametrize(\n    \"key\",\n    [\"alpha\", \"beta\", \"gamma\", \"delta\", \"\", \"Alpha\"],\n)\ndef test_lookup_consistent_with_spec_table(key):\n    \"\"\"返回值应与规约字典一致：命中返回 _TABLE[key]，未命中返回 0。\n\n    期望值来源：规约后置条件（命中/未命中两条分支）。\n    \"\"\"\n    result = lookup(key)\n    if key in _TABLE_SPEC:\n        assert result == _TABLE_SPEC[key]\n    else:\n        assert result == 0",
