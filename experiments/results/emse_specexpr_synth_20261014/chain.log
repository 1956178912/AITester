          "generated_test": "import pytest\n\nfrom task_0042 import lookup\n\n\n# ---------------------------------------------------------------------------\n# 规约来源说明：\n#   - 前置条件：模块级 _TABLE = {\"alpha\": 1, \"beta\": 2, \"gamma\": 3}\n#   - 后置条件：返回值恒为 int；命中返回 _TABLE[key]，未命中返回 0；不修改 _TABLE\n#   - 边界：\"\"、\"Alpha\"/\"ALPHA\"、\" alpha \"、\"α\"、超长字符串、None\n# 所有期望值均来自上述规约，未臆测实现细节。\n# ---------------------------------------------------------------------------\n\n\n@pytest.mark.parametrize(\n    \"key, expected\",\n    [\n        (\"alpha\", 1),\n        (\"beta\", 2),\n        (\"gamma\", 3),\n    ],\n)\ndef test_lookup_hit_returns_table_value(key, expected):\n    \"\"\"规约：命中时返回值等于 _TABLE[key]。期望值来源：规约前置条件中的 _TABLE 定义。\"\"\"\n    result = lookup(key)\n    assert result == expected\n    assert isinstance(result, int)\n\n\n@pytest.mark.parametrize(\n    \"key\",\n    [\n        \"delta\",\n        \"\",\n        \"Alpha\",\n        \"ALPHA\",\n        \" alpha \",\n        \"α\",\n        \"a\" * 10000,\n    ],\n)\ndef test_lookup_miss_returns_zero(key):\n    \"\"\"规约：未命中时返回 0。期望值来源：规约后置条件（未命中返回 0）。\n\n    覆盖边界：普通未命中键、空字符串、大小写变体、前后空白、非 ASCII、超长字符串。\n    \"\"\"\n    result = lookup(key)\n    assert result == 0\n    assert isinstance(result, int)\n\n\ndef test_lookup_none_returns_zero():\n    \"\"\"规约：None 违反类型注解，但规约明确说明会触发 dict.get 正常返回 0 而非异常。\n\n    期望值来源：规约边界情况说明（None -> 0，不抛异常）。\n    \"\"\"\n    result = lookup(None)\n    assert result == 0\n    assert isinstance(result, int)\n\n\ndef test_lookup_return_type_is_int_for_all_cases():\n    \"\"\"规约：返回值恒为 int 类型。期望值来源：规约后置条件。\"\"\"\n    for key in [\"alpha\", \"beta\", \"gamma\", \"delta\", \"\", \"Alpha\", \"α\"]:\n        result = lookup(key)\n        assert isinstance(result, int)\n\n\ndef test_lookup_does_not_modify_table():\n    \"\"\"规约：不修改 _TABLE。期望值来源：规约后置条件。\n\n    通过连续调用命中/未命中键，验证行为稳定（间接验证 _TABLE 未被修改）。\n    \"\"\"\n    # 首次调用\n    first_alpha = lookup(\"alpha\")\n    first_beta = lookup(\"beta\")\n    first_gamma = lookup(\"gamma\")\n    first_miss = lookup(\"delta\")\n\n    # 再次调用，结果应保持一致\n    assert lookup(\"alpha\") == first_alpha == 1\n    assert lookup(\"beta\") == first_beta == 2\n    assert lookup(\"gamma\") == first_gamma == 3\n    assert lookup(\"delta\") == first_miss == 0\n\n\ndef test_lookup_case_sensitivity():\n    \"\"\"规约：字典键大小写敏感，'Alpha'/'ALPHA' 未命中返回 0。\n\n    期望值来源：规约边界情况（大小写变体）。\n    \"\"\"\n    assert lookup(\"Alpha\") == 0\n    assert lookup(\"ALPHA\") == 0\n    assert lookup(\"alpha\") == 1\n\n\ndef test_lookup_whitespace_not_stripped():\n    \"\"\"规约：前后带空白的 ' alpha ' 未命中返回 0（不做 strip）。\n\n    期望值来源：规约边界情况（前后带空白）。\n    \"\"\"\n    assert lookup(\" alpha \") == 0\n    assert lookup(\"alpha \") == 0\n    assert lookup(\" alpha\") == 0",
