          "generated_test": "import pytest\n\nfrom task_0013 import lookup\n\n\n# ---------------------------------------------------------------------------\n# 规约常量（来自自然语言规约：_TABLE 已初始化为 {\"alpha\":1,\"beta\":2,\"gamma\":3}）\n# ---------------------------------------------------------------------------\n_TABLE_SPEC = {\"alpha\": 1, \"beta\": 2, \"gamma\": 3}\n\n\n# ---------------------------------------------------------------------------\n# 正常命中用例\n# ---------------------------------------------------------------------------\n@pytest.mark.parametrize(\n    \"key, expected\",\n    [\n        (\"alpha\", 1),\n        (\"beta\", 2),\n        (\"gamma\", 3),\n    ],\n)\ndef test_lookup_hit_returns_table_value(key, expected):\n    \"\"\"规约：若 key 存在于 _TABLE 则返回值等于 _TABLE[key]。\n\n    期望值来源：自然语言规约中 _TABLE 的初始化内容。\n    \"\"\"\n    result = lookup(key)\n    assert result == expected\n    assert result == _TABLE_SPEC[key]\n\n\n@pytest.mark.parametrize(\"key\", [\"alpha\", \"beta\", \"gamma\"])\ndef test_lookup_hit_returns_int(key):\n    \"\"\"规约：返回值恒为 int（后置条件 isinstance(result, int)）。\"\"\"\n    result = lookup(key)\n    assert isinstance(result, int)\n\n\n# ---------------------------------------------------------------------------\n# 未命中用例\n# ---------------------------------------------------------------------------\n@pytest.mark.parametrize(\n    \"key\",\n    [\n        \"delta\",          # 普通未命中键\n        \"\",               # 边界：空字符串\n        \"Alpha\",          # 边界：大小写变体（字典区分大小写）\n        \" \",              # 边界：空白字符串\n        \"a\" * 1000,       # 边界：超长字符串\n    ],\n)\ndef test_lookup_miss_returns_zero(key):\n    \"\"\"规约：若 key 不存在于 _TABLE 则返回 0。\n\n    期望值来源：自然语言规约后置条件。\n    \"\"\"\n    result = lookup(key)\n    assert result == 0\n\n\n@pytest.mark.parametrize(\n    \"key\",\n    [\n        \"delta\",\n        \"\",\n        \"Alpha\",\n        \" \",\n        \"a\" * 1000,\n    ],\n)\ndef test_lookup_miss_returns_int_and_non_negative(key):\n    \"\"\"规约：返回值恒为 int 且 result >= 0（后置条件 + 不变量）。\"\"\"\n    result = lookup(key)\n    assert isinstance(result, int)\n    assert result >= 0\n\n\n# ---------------------------------------------------------------------------\n# 后置条件 / 不变量统一校验\n# ---------------------------------------------------------------------------\n@pytest.mark.parametrize(\n    \"key\",\n    [\n        \"alpha\",\n        \"beta\",\n        \"gamma\",\n        \"delta\",\n        \"\",\n        \"Alpha\",\n        \" \",\n        \"a\" * 1000,\n    ],\n)\ndef test_lookup_postcondition_result_domain(key):\n    \"\"\"规约：result == 0 or result in (1, 2, 3)（后置条件）。\n\n    期望值来源：可执行规约 SpecExpr 子句。\n    \"\"\"\n    result = lookup(key)\n    assert result == 0 or result in (1, 2, 3)\n\n\n# ---------------------------------------------------------------------------\n# 大小写敏感性专项\n# ---------------------------------------------------------------------------\ndef test_lookup_case_sensitive_alpha_variant():\n    \"\"\"规约边界：字典区分大小写，\"Alpha\" 应未命中返回 0。\n\n    期望值来源：自然语言规约边界情况说明。\n    \"\"\"\n    assert lookup(\"Alpha\") == 0\n    assert lookup(\"ALPHA\") == 0\n    assert lookup(\"alpha\") == 1\n\n\n# ---------------------------------------------------------------------------\n# 前置条件被违反的输入（探索性，期望值来源不明，需人工确认）\n# ---------------------------------------------------------------------------\ndef test_lookup_non_str_key_int_exploratory():\n    \"\"\"探索性用例：传入 int 键违反前置条件 isinstance(key, str)。\n\n    期望值来源不明，需人工确认：规约仅声明前置条件为 str，\n    未规定违反前置条件时的行为（抛异常或返回 0 均可能）。\n    此处仅记录实际行为，不做具体值断言。\n    \"\"\"\n    try:\n        result = lookup(123)\n    except Exception as exc:  # noqa: BLE001\n        # 记录实际行为：抛出异常也是规约未禁止的合理实现\n        assert exc is not None\n    else:\n        # 若未抛异常，则返回值应满足后置条件域\n        assert isinstance(result, int)\n        assert result == 0 or result in (1, 2, 3)\n\n\ndef test_lookup_none_key_exploratory():\n    \"\"\"探索性用例：传入 None 键违反前置条件 isinstance(key, str)。\n\n    期望值来源不明，需人工确认：规约未规定 None 键的行为。\n    此处仅记录实际行为，不做具体值断言。\n    \"\"\"\n    try:\n        result = lookup(None)\n    except Exception as exc:  # noqa: BLE001\n        assert exc is not None\n    else:\n        assert isinstance(result, int)\n        assert result == 0 or result in (1, 2, 3)",
