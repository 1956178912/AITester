          "generated_test": "import pytest\n\nfrom task_0053 import is_palindrome\n\n\n# ---------------------------------------------------------------------------\n# 正常用例：验证后置条件 s == s[::-1] -> True / s != s[::-1] -> False\n# ---------------------------------------------------------------------------\n\ndef test_is_palindrome_normal_true_level():\n    \"\"\"规约：s == s[::-1] 时返回 True。'level' 反转仍为 'level'。\"\"\"\n    assert is_palindrome(\"level\") is True\n\n\ndef test_is_palindrome_normal_false_hello():\n    \"\"\"规约：s != s[::-1] 时返回 False。'hello' 反转 'olleh' 不等。\"\"\"\n    assert is_palindrome(\"hello\") is False\n\n\ndef test_is_palindrome_with_space_true():\n    \"\"\"规约：空格参与比较，'a b a' 反转仍为 'a b a'，返回 True。\"\"\"\n    assert is_palindrome(\"a b a\") is True\n\n\ndef test_is_palindrome_with_punctuation_false():\n    \"\"\"规约：标点参与比较，'ab!' 反转 '!ba' 不等，返回 False。\"\"\"\n    assert is_palindrome(\"ab!\") is False\n\n\ndef test_is_palindrome_unicode_true():\n    \"\"\"规约：Unicode 字符按码点反转后相等，'上海自来水来自海上' 返回 True。\"\"\"\n    assert is_palindrome(\"上海自来水来自海上\") is True\n\n\n# ---------------------------------------------------------------------------\n# 边界用例\n# ---------------------------------------------------------------------------\n\ndef test_is_palindrome_empty_string_true():\n    \"\"\"边界：空串反转仍为空串，s == s[::-1] 成立，返回 True。\"\"\"\n    assert is_palindrome(\"\") is True\n\n\ndef test_is_palindrome_single_char_true():\n    \"\"\"边界：单字符反转等于自身，返回 True。\"\"\"\n    assert is_palindrome(\"a\") is True\n\n\ndef test_is_palindrome_all_same_chars_true():\n    \"\"\"边界：全相同字符字符串反转等于自身，返回 True。\"\"\"\n    assert is_palindrome(\"aaaaa\") is True\n\n\ndef test_is_palindrome_two_chars_same_true():\n    \"\"\"边界：最小偶数长度回文 'aa'，返回 True。\"\"\"\n    assert is_palindrome(\"aa\") is True\n\n\ndef test_is_palindrome_two_chars_diff_false():\n    \"\"\"边界：最小偶数长度非回文 'ab'，返回 False。\"\"\"\n    assert is_palindrome(\"ab\") is False\n\n\ndef test_is_palindrome_case_sensitive_false():\n    \"\"\"边界：未做大小写归一化，'Aa' != 'aA'，返回 False。\"\"\"\n    assert is_palindrome(\"Aa\") is False\n\n\n# ---------------------------------------------------------------------------\n# 参数化：覆盖规约后置条件的等价类\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\n    \"s, expected\",\n    [\n        (\"level\", True),\n        (\"hello\", False),\n        (\"\", True),\n        (\"a\", True),\n        (\"aa\", True),\n        (\"ab\", False),\n        (\"Aa\", False),\n        (\"a b a\", True),\n        (\"ab!\", False),\n        (\"上海自来水来自海上\", True),\n        (\"racecar\", True),\n        (\"abccba\", True),\n        (\"abcabc\", False),\n    ],\n)\ndef test_is_palindrome_matches_reverse_equality(s, expected):\n    \"\"\"规约后置条件：返回值等价于 (s == s[::-1])。\"\"\"\n    assert is_palindrome(s) is expected\n    assert is_palindrome(s) is (s == s[::-1])\n\n\n# ---------------------------------------------------------------------------\n# 异常路径：前置条件声明 s 为 str，非 str 入参不在前件内\n# 期望值来源不明（规约未约定异常处理），仅验证异常路径存在\n# ---------------------------------------------------------------------------\n\ndef test_is_palindrome_non_str_int_raises_type_error():\n    \"\"\"前置条件要求 s 为 str；传入 int 时 s[::-1] 触发 TypeError。\n\n    期望值来源不明，需人工确认：规约未约定非 str 入参的处理方式，\n    此处仅验证异常路径存在（TypeError）。\n    \"\"\"\n    with pytest.raises(TypeError):\n        is_palindrome(12321)\n\n\ndef test_is_palindrome_none_raises_type_error():\n    \"\"\"前置条件要求 s 为 str；传入 None 时 s[::-1] 触发 TypeError。\n\n    期望值来源不明，需人工确认：规约未约定 None 入参的处理方式，\n    此处仅验证异常路径存在（TypeError）。\n    \"\"\"\n    with pytest.raises(TypeError):\n        is_palindrome(None)",
