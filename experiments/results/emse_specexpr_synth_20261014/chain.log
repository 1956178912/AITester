k_of 对不存在的字符串 sku 应返回 0。\n\n    期望值来源：实现 _STOCK.get(sku, 0) 的默认值 0。\n    \"\"\"\n    assert stock_of(\"not-exist\") == 0\n\n\ndef test_add_item_and_stock_of_roundtrip():\n    \"\"\"add_item 存入后 stock_of 应能读回相同值（往返一致性）。\n\n    期望值来源：两个函数的实现约定。\n    \"\"\"\n    add_item(7, 123)\n    assert stock_of(7) == 123\n\n\ndef test_stock_of_does_not_modify_stock():\n    \"\"\"stock_of 为只读操作，不应改变库存状态。\n\n    期望值来源：实现仅调用 _STOCK.get，不写入。\n    \"\"\"\n    add_item(8, 55)\n    stock_of(8)\n    stock_of(8)\n    assert _STOCK[8] == 55",
