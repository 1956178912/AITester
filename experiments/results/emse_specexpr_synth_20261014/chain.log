          "generated_test": "import pytest\n\nfrom task_0072 import safe_div\n\n\n# ---------------------------------------------------------------------------\n# 正常路径 / 主路径\n# ---------------------------------------------------------------------------\n\ndef test_safe_div_exact_division_returns_float():\n    \"\"\"规约：a 为 b 的整数倍时返回整数值的浮点表示（如 6/3 -> 2.0）。\"\"\"\n    result = safe_div(6, 3)\n    assert result == 2.0\n    assert isinstance(result, float)\n\n\ndef test_safe_div_non_exact_division_returns_float():\n    \"\"\"规约：返回值满足 result == a / b，且为 float 类型。\"\"\"\n    result = safe_div(7, 2)\n    assert result == 3.5\n    assert isinstance(result, float)\n\n\n# ---------------------------------------------------------------------------\n# 边界情况\n# ---------------------------------------------------------------------------\n\ndef test_safe_div_zero_dividend_returns_zero_float():\n    \"\"\"规约：a == 0 且 b != 0 时返回 0.0。\"\"\"\n    result = safe_div(0, 5)\n    assert result == 0.0\n    assert isinstance(result, float)\n\n\ndef test_safe_div_both_negative_returns_positive_quotient():\n    \"\"\"规约：a 与 b 均为负数时返回正商。\"\"\"\n    result = safe_div(-6, -3)\n    assert result == 2.0\n    assert result > 0\n    assert isinstance(result, float)\n\n\ndef test_safe_div_opposite_signs_returns_negative_quotient():\n    \"\"\"规约：a 为负数、b 为正数（或反之）时返回负商。\"\"\"\n    result = safe_div(-7, 2)\n    assert result == -3.5\n    assert result < 0\n    assert isinstance(result, float)\n\n\ndef test_safe_div_opposite_signs_positive_over_negative():\n    \"\"\"规约：a 为正数、b 为负数时返回负商。\"\"\"\n    result = safe_div(7, -2)\n    assert result == -3.5\n    assert result < 0\n    assert isinstance(result, float)\n\n\ndef test_safe_div_bool_inputs_treated_as_int():\n    \"\"\"规约：a 或 b 为 bool（int 子类）时按 0/1 参与运算。\n\n    True 视为 1，False 视为 0；此处 b=True 满足前置 b != 0。\n    \"\"\"\n    result = safe_div(True, True)\n    assert result == 1.0\n    assert isinstance(result, float)\n\n\ndef test_safe_div_bool_dividend_fals