          "generated_test": "import pytest\n\nfrom task_0036 import is_valid_username\n\n\nclass TestIsValidUsernameNormal:\n    \"\"\"正常场景测试：覆盖有效与无效用户名的典型输入。\"\"\"\n\n    def test_is_valid_username_valid_alnum(self):\n        \"\"\"非空、纯字母数字、长度<=20 应返回 False（有效）。\n\n        期望值来源：规约后置条件「当且仅当 name 非空、全部为字母数字且长度<=20 时返回 False」。\n        \"\"\"\n        assert is_valid_username(\"user123\") is False\n\n    def test_is_valid_username_invalid_with_underscore(self):\n        \"\"\"含下划线（非字母数字）应返回 True（无效）。\n\n        期望值来源：规约后置条件「否则返回 True」。\n        \"\"\"\n        assert is_valid_username(\"user_123\") is True\n\n    def test_is_valid_username_only_digits(self):\n        \"\"\"仅含数字的串，isalnum 为 True 且非空、长度<=20，应返回 False。\n\n        期望值来源：规约边界情况「仅含数字的串」+ 后置条件。\n        \"\"\"\n        assert is_valid_username(\"123456\") is False\n\n    def test_is_valid_username_only_letters(self):\n        \"\"\"仅含字母的串，isalnum 为 True 且非空、长度<=20，应返回 False。\n\n        期望值来源：规约边界情况「仅含字母的串」+ 后置条件。\n        \"\"\"\n        assert is_valid_username(\"abcdef\") is False\n\n\nclass TestIsValidUsernameBoundary:\n    \"\"\"边界场景测试：空串、长度 20/21 边界。\"\"\"\n\n    def test_is_valid_username_empty_string(self):\n        \"\"\"空字符串应返回 True（无效）。\n\n        期望值来源：规约边界情况「空字符串 ''」+ 后置条件（name 为空则返回 True）。\n        \"\"\"\n        assert is_valid_username(\"\") is True\n\n    def test_is_valid_username_length_exactly_20(self):\n        \"\"\"长度恰好为 20 的纯字母数字串应返回 False（有效）。\n\n        期望值来源：规约边界情况「长度恰好为 20 的纯字母数字串」+ 后置条件 len<=20。\n        \"\"\"\n        name = \"a2345678901234567890\"\n        assert len(name) == 20\n        assert is_valid_username(name) is False\n\n    def test_is_valid_username_length_exactly_21(self):\n        \"\"\"长度恰好为 21 的纯字母数字串应返回 True（无效）。\n\n        期望值来源：规约边界情况「长度恰好为 21 的纯字母数字串」+ 后置条件 len>20。\n        \"\"\"\n        name = \"a23456789012345678901\"\n        assert len(name) == 21\n        assert is_valid_username(name) is True\n\n\nclass TestIsValidUsernameInvalidChars:\n    \"\"\"非