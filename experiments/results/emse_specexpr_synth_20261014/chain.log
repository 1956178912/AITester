          "generated_test": "import math\n\nimport pytest\n\nfrom task_0071 import divide\n\n\ndef test_divide_positive_numbers():\n    \"\"\"规约：返回值为 a / b 的浮点商。6.0 / 3.0 应为 2.0。\"\"\"\n    result = divide(6.0, 3.0)\n    assert result == 2.0\n    assert isinstance(result, float)\n\n\ndef test_divide_negative_dividend():\n    \"\"\"规约：负数相除结果符号由两数符号决定。-6.0 / 3.0 应为 -2.0。\"\"\"\n    result = divide(-6.0, 3.0)\n    assert result == -2.0\n\n\ndef test_divide_negative_divisor():\n    \"\"\"规约：负数相除结果符号由两数符号决定。6.0 / -3.0 应为 -2.0。\"\"\"\n    result = divide(6.0, -3.0)\n    assert result == -2.0\n\n\ndef test_divide_both_negative():\n    \"\"\"规约：负数相除结果符号由两数符号决定。-6.0 / -3.0 应为 2.0。\"\"\"\n    result = divide(-6.0, -3.0)\n    assert result == 2.0\n\n\ndef test_divide_zero_dividend():\n    \"\"\"规约：a 为 0 且 b 非 0 时结果为 0.0。\"\"\"\n    result = divide(0.0, 5.0)\n    assert result == 0.0\n\n\ndef test_divide_zero_divisor_raises():\n    \"\"\"规约：b 为 0 时抛出 ZeroDivisionError。\"\"\"\n    with pytest.raises(ZeroDivisionError):\n        divide(5.0, 0.0)\n\n\ndef test_divide_negative_zero_divisor_raises():\n    \"\"\"规约：b 为 0 时抛出 ZeroDivisionError，-0.0 同样视为 0。\"\"\"\n    with pytest.raises(ZeroDivisionError):\n        divide(5.0, -0.0)\n\n\ndef test_divide_does_not_modify_inputs():\n    \"\"\"规约：不修改输入参数。\"\"\"\n    a = 7.0\n    b = 2.0\n    a_before = a\n    b_before = b\n    divide(a, b)\n    assert a == a_before\n    assert b == b_before\n\n\ndef test_divide_overflow_may_produce_inf():\n    \"\"\"规约：极大值/极小值可能产生 inf 或 0.0。\n    期望值来源不明，需人工确认：此处仅记录实际行为，\n    断言结果要么是 inf 要么是有限值，不臆造具体数值。\"\"\"\n    result = divide(1e308, 1e-308)\n    assert isinstance(result, float)\n    assert math.isinf(result) or math.isfinite(result)\n\n\ndef test_divide_underflow_may_produce_zero():\n    \"\"\"规约：极大值/极小值可能产生 inf 或 0.0。\n    期望值来源不明，需人工确认：此处仅记录实际行为，\n    断言结果要么是 0.0 要么是有限非零值，不臆造具体数值。\"\"\"\n    result = divide(1e-308, 1e308)\n    assert isinstance(result, float)\n    assert result == 0.0 or math.isfinite(result)\n\n\ndef test_divide_float_precision():\n    \"\"\"规约：浮点精度导致结果非精确值。\n    期望值来源不明，需人工确认：0.1/0.3 在二进制浮点中无法精确表示，\n    此处仅断言结果与 1/3 的浮点近似一致，不臆造精确数值。\"\"\"\n    result = divide(0.1, 0.3)\n    assert isinstance(result, float)\n    assert math.isclose(result, 0.1 / 0.3, rel_tol=1e-12)\n\n\n@pytest.mark.parametrize(\n    \"a, b, expected\",\n    [\n        (10.0, 2.0, 5.0),\n        (9.0, 3.0, 3.0),\n        (-9.0, 3.0, -3.0),\n        (9.0, -3.0, -3.0),\n        (-9.0, -3.0, 3.0),\n        (0.0, -4.0, 0.0),\n    ],\n)\ndef test_divide_parametrized_quotient(a, b, expected):\n    \"\"\"规约：返回值为 a / b 的浮点商，符号由两数符号决定。\"\"\"\n    assert divide(a, b) == expected",
