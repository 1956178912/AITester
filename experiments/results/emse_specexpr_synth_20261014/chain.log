          "generated_test": "import pytest\n\nfrom task_0066 import lookup\n\n\n# 规约中明确给出的 _TABLE 内容，作为期望值的唯一合法来源\n_EXPECTED_TABLE = {\"alpha\": 1, \"beta\": 2, \"gamma\": 3}\n\n\ndef test_lookup_hit_alpha_returns_1():\n    \"\"\"命中已有键 alpha，应返回 _TABLE 中对应值 1（期望值来源：规约前置条件）。\"\"\"\n    assert lookup(\"alpha\") == 1\n\n\ndef test_lookup_hit_beta_returns_2():\n    \"\"\"命中已有键 beta，应返回 _TABLE 中对应值 2（期望值来源：规约前置条件）。\"\"\"\n    assert lookup(\"beta\") == 2\n\n\ndef test_lookup_hit_gamma_returns_3():\n    \"\"\"命中已有键 gamma，应返回 _TABLE 中对应值 3（期望值来源：规约前置条件）。\"\"\"\n    assert lookup(\"gamma\") == 3\n\n\n@pytest.mark.parametrize(\n    \"key, expected\",\n    [\n        (\"alpha\", 1),\n        (\"beta\", 2),\n        (\"gamma\", 3),\n    ],\n)\ndef test_lookup_hit_existing_keys_returns_table_value(key, expected):\n    \"\"\"参数化验证所有已存在的键均返回 _TABLE 中对应值（期望值来源：规约前置条件）。\"\"\"\n    assert lookup(key) == expected\n\n\ndef test_lookup_missing_key_returns_0():\n    \"\"\"未命中键 delta，应返回默认值 0（期望值来源：规约边界情况）。\"\"\"\n    assert lookup(\"delta\") == 0\n\n\ndef test_lookup_empty_string_key_returns_0():\n    \"\"\"空字符串键未命中，应返回 0（期望值来源：规约边界情况）。\"\"\"\n    assert lookup(\"\") == 0\n\n\ndef test_lookup_case_sensitive_key_returns_0():\n    \"\"\"字典键区分大小写，\"Alpha\" 未命中，应返回 0（期望值来源：规约边界情况）。\"\"\"\n    assert lookup(\"Alpha\") == 0\n\n\ndef test_lookup_none_key_returns_0():\n    \"\"\"None 作为键，dict.get 不抛异常，应返回默认值 0（期望值来源：规约边界情况）。\"\"\"\n    assert lookup(None) == 0\n\n\n@pytest.mark.parametrize(\n    \"key\",\n    [\"alpha\", \"beta\", \"gamma\", \"delta\", \"\", \"Alpha\", None],\n)\ndef test_lookup_return_type_is_int(key):\n    \"\"\"后置条件：返回值始终为 int（期望值来源：规约后置条件）。\"\"\"\n    result = lookup(key)\n    assert isinstance(result, int)\n\n\ndef test_lookup_does_not_modify_table():\n    \"\"\"后置条件：调用 lookup 不修改模块级 _TABLE（期望值来源：规约后置条件）。\"\"\"\n    import task_0066\n\n    before = dict(task_0066._TABLE)\n    lookup(\"alpha\")\n    lookup(\"delta\")\n    lookup(\"\")\n    lookup(None)\n    after = dict(task_0066._TABLE)\n    assert after == before\n    assert after == _EXPECTED_TABLE\n\n\n@pytest.mark.parametrize(\n    \"key\",\n    [\"alpha\", \"beta\", \"gamma\", \"delta\", \"\", \"Alpha\", None],\n)\ndef test_lookup_is_pure_repeated_calls_consistent(key):\n    \"\"\"后置条件：对同一 key 多次调用结果一致（纯函数）（期望值来源：规约后置条件）。\"\"\"\n    first = lookup(key)\n    second = lookup(key)\n    third = lookup(key)\n    assert first == second == third",
