          "generated_test": "import pytest\n\nfrom task_0034 import is_palindrome\n\n\n# ---------------------------------------------------------------------------\n# 正常用例\n# ---------------------------------------------------------------------------\n\ndef test_is_palindrome_even_length_palindrome():\n    \"\"\"偶数长度回文 'abba'：s == s[::-1] 为真，应返回 True。\"\"\"\n    assert is_palindrome(\"abba\") is True\n\n\ndef test_is_palindrome_odd_length_palindrome():\n    \"\"\"奇数长度回文 'abcba'：s == s[::-1] 为真，应返回 True。\"\"\"\n    assert is_palindrome(\"abcba\") is True\n\n\ndef test_is_palindrome_non_palindrome():\n    \"\"\"非回文 'hello'：s == s[::-1] 为假，应返回 False。\"\"\"\n    assert is_palindrome(\"hello\") is False\n\n\n# ---------------------------------------------------------------------------\n# 边界用例\n# ---------------------------------------------------------------------------\n\ndef test_is_palindrome_empty_string():\n    \"\"\"空串 ''：反转仍为空串，s == s[::-1] 为真，应返回 True。\"\"\"\n    assert is_palindrome(\"\") is True\n\n\ndef test_is_palindrome_single_char():\n    \"\"\"单字符 'a'：反转等于自身，应返回 True。\"\"\"\n    assert is_palindrome(\"a\") is True\n\n\ndef test_is_palindrome_all_same_chars():\n    \"\"\"全部相同字符 'aaaa'：反转后相等，应返回 True。\"\"\"\n    assert is_palindrome(\"aaaa\") is True\n\n\ndef test_is_palindrome_case_sensitive():\n    \"\"\"大小写敏感：'Aa' 反转后为 'aA'，不相等，应返回 False。\"\"\"\n    assert is_palindrome(\"Aa\") is False\n\n\ndef test_is_palindrome_with_spaces_palindrome():\n    \"\"\"含空格回文 'a b a'：空格作为普通字符参与比较，反转仍相等，应返回 True。\"\"\"\n    assert is_palindrome(\"a b a\") is True\n\n\ndef test_is_palindrome_with_spaces_non_palindrome():\n    \"\"\"含空格非回文 'ab a'：反转不等，应返回 False。\"\"\"\n    assert is_palindrome(\"ab a\") is False\n\n\ndef test_is_palindrome_unicode_palindrome():\n    \"\"\"Unicode 回文 '上海自来水来自海上'：按码点反转后相等，应返回 True。\"\"\"\n    assert is_palindrome(\"上海自来水来自海上\") is True\n\n\n# ---------------------------------------------------------------------------\n# 参数化补充：覆盖规约中可判定的后置条件 s == s[::-1]\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\n    \"s, expected\",\n    [\n        (\"abba\", True),\n        (\"abcba\", True),\n        (\"hello\", False),\n        (\"\", True),\n        (\"a\", True),\n        (\"aaaa\", True),\n        (\"Aa\", False),\n        (\"a b a\", True),\n        (\"ab a\", False),\n        (\"上海自来水来自海上\", True),\n    ],\n)\ndef test_is_palindrome_matches_reverse_equality(s, expected):\n    \"\"\"后置条件：返回 True 当且仅当 s == s[::-1]。\"\"\"\n    assert is_palindrome(s) is expected\n    # 与规约定义的一致性交叉校验\n    assert is_palindrome(s) is (s == s[::-1])\n\n\n# ---------------------------------------------------------------------------\n# 异常路径：前置条件要求 s 为 str，非 str 入参行为规约未约定\n# ---------------------------------------------------------------------------\n\ndef test_is_palindrome_non_str_int_raises():\n    \"\"\"前置条件要求 s 为 str；传入 int 时 s[::-1] 会抛 TypeError。\n\n    期望值来源：类型注解前置条件 + Python 切片语义（int 不支持切片）。\n    规约未显式约定异常类型，此处按运行时必然行为断言 TypeError。\n    \"\"\"\n    with pytest.raises(TypeError):\n        is_palindrome(12321)\n\n\ndef test_is_palindrome_none_raises():\n    \"\"\"前置条件要求 s 为 str；传入 None 时 s[::-1] 会抛 TypeError。\n\n    期望值来源：类型注解前置条件 + Python 切片语义（None 不支持切片）。\n    规约未显式约定异常类型，此处按运行时必然行为断言 TypeError。\n    \"\"\"\n    with pytest.raises(TypeError):\n        is_palindrome(None)",
