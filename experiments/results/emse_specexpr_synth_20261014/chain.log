          "generated_test": "import pytest\n\nfrom task_0030 import aggregate\n\n\nclass TestAggregateNormal:\n    \"\"\"正常路径测试：非空数值列表的平均值计算。\"\"\"\n\n    def test_aggregate_multi_int_list(self):\n        \"\"\"多元素整数列表：期望值来自规约 result == sum(values)/len(values)。\n\n        sum([1,2,3,4])/4 == 10/4 == 2.5\n        \"\"\"\n        values = [1, 2, 3, 4]\n        result = aggregate(values)\n        assert result == sum(values) / len(values)\n        assert result == 2.5\n\n    def test_aggregate_single_element_list(self):\n        \"\"\"单元素列表：期望值来自规约 result == sum(values)/len(values)。\n\n        sum([5])/1 == 5.0\n        \"\"\"\n        values = [5]\n        result = aggregate(values)\n        assert result == sum(values) / len(values)\n        assert result == 5.0\n\n    def test_aggregate_float_list(self):\n        \"\"\"含浮点数列表：期望值来自规约 result == sum(values)/len(values)。\n\n        sum([1.5,2.5])/2 == 4.0/2 == 2.0\n        \"\"\"\n        values = [1.5, 2.5]\n        result = aggregate(values)\n        assert result == sum(values) / len(values)\n        assert result == 2.0\n\n    def test_aggregate_negative_list(self):\n        \"\"\"含负数列表：期望值来自规约 result == sum(values)/len(values)。\n\n        sum([-1,-2,-3])/3 == -6/3 == -2.0\n        \"\"\"\n        values = [-1, -2, -3]\n        result = aggregate(values)\n        assert result == sum(values) / len(values)\n        assert result == -2.0\n\n    def test_aggregate_returns_float_type(self):\n        \"\"\"后置条件：返回值类型为 float（Python 3 真除法）。\"\"\"\n        result = aggregate([1, 2, 3, 4])\n        assert isinstance(result, float)\n\n    def test_aggregate_no_exception_on_non_empty(self):\n        \"\"\"后置条件：输入非空时函数不抛异常。\"\"\"\n        try:\n            aggregate([1, 2, 3])\n        except Exception as exc:  # noqa: BLE001\n            pytest.fail(f\"非空输入不应抛异常，但抛出了 {type(exc).__name__}: {exc}\")\n\n\nclass TestAggregateBoundary:\n    \"\"\"边界路径测试。\"\"\"\n\n    def test_aggregate_all_zeros_list(self):\n        \"\"\"全零列表：期望值