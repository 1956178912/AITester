---------------\ndef test_lookup_unhashable_key_raises_type_error():\n    \"\"\"不可哈希类型（如 list）作为 key 时抛 TypeError。\n\n    期望值来源：规约边界情况明确约定不可哈希类型会抛 TypeError。\n    \"\"\"\n    with pytest.raises(TypeError):\n        lookup([])\n\n\n# ---------------------------------------------------------------------------\n# 后置条件：返回值恒为 int\n# ---------------------------------------------------------------------------\n@pytest.mark.parametrize(\"key\", [\"alpha\", \"beta\", \"gamma\", \"delta\", \"\", None])\ndef test_lookup_always_returns_int(key):\n    \"\"\"后置条件：返回值恒为 int。\n\n    期望值来源：规约后置条件“返回值恒为 int”。\n    \"\"\"\n    assert isinstance(lookup(key), int)\n\n\n# ---------------------------------------------------------------------------\n# 后置条件：不修改 _TABLE\n# ---------------------------------------------------------------------------\ndef test_lookup_does_not_modify_table():\n    \"\"\"后置条件：调用 lookup 不修改模块级 _TABLE。\n\n    期望值来源：规约后置条件“不修改 _TABLE”。\n    \"\"\"\n    import task_0036\n\n    before = dict(task_0036._TABLE)\n    for key in [\"alpha\", \"beta\", \"gamma\", \"delta\", \"\", None]:\n        lookup(key)\n    assert task_0036._TABLE == before\n\n\n# ---------------------------------------------------------------------------\n# 后置条件：纯函数，同一 key 多次调用结果一致\n# ---------------------------------------------------------------------------\n@pytest.mark.parametrize(\"key\", [\"alpha\", \"beta\", \"gamma\", \"delta\", \"\", None])\ndef test_lookup_is_pure_repeated_calls_consistent(key):\n    \"\"\"后置条件：对同一 key 多次调用结果一致（纯函数）。\n\n    期望值来源：规约后置条件“对同一 key 多次调用结果一致”。\n    \"\"\"\n    first = lookup(key)\n    for _ in range(5):\n        assert lookup(key) == first",
