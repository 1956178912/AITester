          "generated_test": "import pytest\n\nfrom task_0025 import compute_scores\n\n\ndef test_compute_scores_normal_multiple_records():\n    \"\"\"正常多记录转换：验证基本 name/value 映射。\n\n    期望值来源：规约后置条件（键来自 name，值来自 value）。\n    \"\"\"\n    records = [\n        {\"name\": \"a\", \"value\": 1},\n        {\"name\": \"b\", \"value\": 2},\n    ]\n    result = compute_scores(records)\n    assert result == {\"a\": 1, \"b\": 2}\n\n\ndef test_compute_scores_empty_list_returns_empty_dict():\n    \"\"\"空列表：验证空输入返回空字典。\n\n    期望值来源：规约边界情况「空列表返回 {}」。\n    \"\"\"\n    result = compute_scores([])\n    assert result == {}\n\n\ndef test_compute_scores_missing_name_uses_unknown():\n    \"\"\"缺少 name 键：验证 name 缺失时使用默认 'unknown'。\n\n    期望值来源：规约后置条件（键来自 record['name'] 或 'unknown'）。\n    \"\"\"\n    records = [{\"value\": 5}]\n    result = compute_scores(records)\n    assert result == {\"unknown\": 5}\n\n\ndef test_compute_scores_missing_value_uses_zero():\n    \"\"\"缺少 value 键：验证 value 缺失时使用默认 0。\n\n    期望值来源：规约后置条件（值为 record['value'] 或 0）。\n    \"\"\"\n    records = [{\"name\": \"x\"}]\n    result = compute_scores(records)\n    assert result == {\"x\": 0}\n\n\ndef test_compute_scores_duplicate_name_later_overrides():\n    \"\"\"同名覆盖：验证同名键后者覆盖前者。\n\n    期望值来源：规约边界情况「多条记录同名导致覆盖」。\n    \"\"\"\n    records = [\n        {\"name\": \"a\", \"value\": 1},\n        {\"name\": \"a\", \"value\": 9},\n    ]\n    result = compute_scores(records)\n    assert result == {\"a\": 9}\n\n\ndef test_compute_scores_negative_value_preserved():\n    \"\"\"value 为负数：验证负数 value 原样保留。\n\n    期望值来源：规约边界情况「value 为 0 或负数」。\n    \"\"\"\n    records = [{\"name\": \"n\", \"value\": -3}]\n    result = compute_scores(records)\n    assert result == {\"n\": -3}\n\n\ndef test_compute_scores_zero_value_preserved():\n    \"\"\"value 为 0：验证 0 值原样保留（不被误判为缺失）。\n\n    期望值来源：规约边界情况「value 为 0 或负数」。\n    \"\"\"\n    records = [{\"name\": \"z\", \"value\": 0}]\n    result = compute_scores(records)\n    assert result == {\"z\": 0}\n\n\n