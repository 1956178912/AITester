          "generated_test": "import pytest\n\nfrom task_0017 import distance\n\n\ndef test_distance_returns_difference_of_two_ints():\n    \"\"\"验证 distance 返回两个整数之差。\n\n    期望值来源：函数实现 `return a - b`（docstring 未提供额外约定）。\n    \"\"\"\n    assert distance(5, 3) == 2\n\n\ndef test_distance_with_negative_result():\n    \"\"\"验证 distance 在 a < b 时返回负值。\n\n    期望值来源：函数实现 `return a - b`。\n    \"\"\"\n    assert distance(3, 5) == -2\n\n\ndef test_distance_with_equal_arguments():\n    \"\"\"验证 distance 在 a == b 时返回 0。\n\n    期望值来源：函数实现 `return a - b`。\n    \"\"\"\n    assert distance(7, 7) == 0\n\n\ndef test_distance_with_zero():\n    \"\"\"验证 distance 与 0 的运算结果。\n\n    期望值来源：函数实现 `return a - b`。\n    \"\"\"\n    assert distance(0, 0) == 0\n    assert distance(0, 4) == -4\n    assert distance(4, 0) == 4\n\n\ndef test_distance_with_negative_arguments():\n    \"\"\"验证 distance 处理负数输入。\n\n    期望值来源：函数实现 `return a - b`。\n    \"\"\"\n    assert distance(-1, -1) == 0\n    assert distance(-1, 1) == -2\n    assert distance(1, -1) == 2\n\n\n@pytest.mark.parametrize(\n    \"a, b, expected\",\n    [\n        (10, 4, 6),\n        (4, 10, -6),\n        (100, 100, 0),\n        (-5, 5, -10),\n        (5, -5, 10),\n        (0, 1, -1),\n    ],\n)\ndef test_distance_parametrized(a, b, expected):\n    \"\"\"参数化验证 distance 的差值计算。\n\n    期望值来源：函数实现 `return a - b`。\n    \"\"\"\n    assert distance(a, b) == expected\n\n\ndef test_distance_returns_int_type():\n    \"\"\"验证 distance 返回类型为 int。\n\n    期望值来源：函数类型注解 `-> int`。\n    \"\"\"\n    result = distance(9, 4)\n    assert isinstance(result, int)\n    assert result == 5\n\n\ndef test_distance_large_values():\n    \"\"\"验证 distance 处理较大整数。\n\n    期望值来源：函数实现 `return a - b`。\n    \"\"\"\n    assert distance(10**9, 10**9 - 1) == 1\n    assert distance(10**9, 1) == 10**9 - 1",
