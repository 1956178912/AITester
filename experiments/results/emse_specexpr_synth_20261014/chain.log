          "generated_test": "import pytest\n\nfrom task_0050 import aggregate\n\n\ndef test_aggregate_basic_mean():\n    \"\"\"基本用例：非空列表返回算术平均值。\n\n    期望值来源：docstring/函数名约定（sum/len），[1, 2, 3] -> 2.0。\n    \"\"\"\n    assert aggregate([1, 2, 3]) == 2.0\n\n\ndef test_aggregate_single_element():\n    \"\"\"单元素列表：平均值等于该元素本身。\n\n    期望值来源：sum/len 语义，[5] -> 5.0。\n    \"\"\"\n    assert aggregate([5]) == 5.0\n\n\ndef test_aggregate_returns_float_type():\n    \"\"\"返回值类型应为 float（即使输入为整数列表）。\n\n    期望值来源：类型注解 -> float。\n    \"\"\"\n    result = aggregate([2, 4])\n    assert isinstance(result, float)\n    assert result == 3.0\n\n\ndef test_aggregate_negative_values():\n    \"\"\"包含负数的列表：平均值按算术平均计算。\n\n    期望值来源：sum/len 语义，[-1, -2, -3] -> -2.0。\n    \"\"\"\n    assert aggregate([-1, -2, -3]) == -2.0\n\n\ndef test_aggregate_mixed_sign_values():\n    \"\"\"正负混合列表：平均值按算术平均计算。\n\n    期望值来源：sum/len 语义，[-2, 2] -> 0.0。\n    \"\"\"\n    assert aggregate([-2, 2]) == 0.0\n\n\ndef test_aggregate_float_values():\n    \"\"\"浮点输入：平均值按算术平均计算。\n\n    期望值来源：sum/len 语义，[1.5, 2.5] -> 2.0。\n    \"\"\"\n    assert aggregate([1.5, 2.5]) == 2.0\n\n\ndef test_aggregate_empty_list_raises_zero_division():\n    \"\"\"空列表：历史 bug 为除零，应抛出 ZeroDivisionError。\n\n    期望值来源：代码实现 sum([])/len([]) 触发 ZeroDivisionError；\n    期望值来源不明（无 docstring 说明空输入行为），需人工确认是否\n    应改为返回 0.0 或抛出自定义异常。\n    \"\"\"\n    with pytest.raises(ZeroDivisionError):\n        aggregate([])\n\n\ndef test_aggregate_large_values():\n    \"\"\"大数值列表：平均值按算术平均计算。\n\n    期望值来源：sum/len 语义，[10**6, 2 * 10**6] -> 1.5e6。\n    \"\"\"\n    assert aggregate([10**6, 2 * 10**6]) == 1.5e6\n\n\ndef test_aggregate_does_not_mutate_input():\n    \"\"\"调用后不应修改输入列表。\n\n    期望值来源：函数无副作用约定（仅读取 values）。\n    \"\"\"\n    values = [1, 2, 3]\n    snapshot = list(values)\n    aggregate(values)\n    assert values == snapshot",
