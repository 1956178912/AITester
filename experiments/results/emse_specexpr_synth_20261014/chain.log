          "generated_test": "import pytest\n\nfrom task_0010 import fibonacci\n\n\n# ---------------------------------------------------------------------------\n# 正常 / 递归分支用例\n# ---------------------------------------------------------------------------\n\ndef test_fibonacci_n2_returns_2():\n    \"\"\"n=2 为最小递归情形，规约约定返回 fibonacci(1)+fibonacci(0)=1+1=2。\"\"\"\n    assert fibonacci(2) == 2\n\n\ndef test_fibonacci_n5_returns_8():\n    \"\"\"n=5 多级递归：按规约 fib(0)=fib(1)=1，fib(5)=fib(4)+fib(3)=5+3=8。\"\"\"\n    assert fibonacci(5) == 8\n\n\ndef test_fibonacci_n20_returns_10946():\n    \"\"\"n=20 较大值：按规约递推 fib(20)=10946（同时暴露指数级递归性能）。\"\"\"\n    assert fibonacci(20) == 10946\n\n\n# ---------------------------------------------------------------------------\n# 边界用例\n# ---------------------------------------------------------------------------\n\ndef test_fibonacci_n0_returns_1():\n    \"\"\"边界 n=0：走 n<=0 分支，规约约定返回 1。\"\"\"\n    assert fibonacci(0) == 1\n\n\ndef test_fibonacci_n1_returns_1():\n    \"\"\"边界 n=1：走 n==1 分支，规约约定返回 1。\"\"\"\n    assert fibonacci(1) == 1\n\n\n@pytest.mark.parametrize(\"n\", [-1, -5, -100])\ndef test_fibonacci_negative_returns_1(n):\n    \"\"\"边界负数：走 n<=0 分支，规约约定返回 1。\"\"\"\n    assert fibonacci(n) == 1\n\n\n# ---------------------------------------------------------------------------\n# 后置条件 / 不变量（可执行规约）\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\"n\", [0, 1, 2, 3, 5, 8, 10])\ndef test_fibonacci_result_is_int(n):\n    \"\"\"后置条件：返回值类型为 int（isinstance(result, int)）。\"\"\"\n    result = fibonacci(n)\n    assert isinstance(result, int)\n\n\n@pytest.mark.parametrize(\"n\", [0, 1, 2, 3, 5, 8, 10])\ndef test_fibonacci_result_at_least_1(n):\n    \"\"\"不变量：result >= 1。\"\"\"\n    assert fibonacci(n) >= 1\n\n\n@pytest.mark.parametrize(\"n\", [2, 3, 4, 5, 6, 7])\ndef test_fibonacci_recursive_relation(n):\n    \"\"\"后置条件：n>=2 时 result == fibonacci(n-1) + fibonacci(n-2)。\"\"\"\n    assert fibonacci(n) == fibonacci(n - 1) + fibonacci(n - 2)\n\n\n# ---------------------------------------------------------------------------\n# 错误 / 非法输入用例\n# ---------------------------------------------------------------------------\n\ndef test_fibonacci_non_int_string_raises():\n    \"\"\"前置条件要求 n 为 int；传入字符串违反前置，期望抛 TypeError。\n\n    期望值来源：规约前置条件 isinstance(n, int) 与类型注解 int；\n    具体异常信息未在规约中约定，故仅断言异常类型。\n    \"\"\"\n    with pytest.raises(TypeError):\n        fibonacci(\"a\")\n\n\ndef test_fibonacci_none_raises():\n    \"\"\"前置条件要求 n 为 int；传入 None 违反前置，期望抛 TypeError。\n\n    期望值来源：规约前置条件 isinstance(n, int) 与类型注解 int；\n    具体异常信息未在规约中约定，故仅断言异常类型。\n    \"\"\"\n    with pytest.raises(TypeError):\n        fibonacci(None)",
