          "generated_test": "import math\n\nimport pytest\n\nfrom task_0079 import rounded_ratio\n\n\ndef test_rounded_ratio_zero_total_returns_zero():\n    \"\"\"total 为 0 时应返回 0.0（来源：函数实现中的显式分支）。\"\"\"\n    assert rounded_ratio(0, 0) == 0.0\n\n\ndef test_rounded_ratio_zero_total_with_nonzero_hit_returns_zero():\n    \"\"\"total 为 0 时即使 hit 非零也应返回 0.0（来源：函数实现中的显式分支）。\"\"\"\n    assert rounded_ratio(5, 0) == 0.0\n\n\ndef test_rounded_ratio_full_ratio_returns_one():\n    \"\"\"hit == total 时比例为 1.0（来源：数学定义 hit/total）。\"\"\"\n    assert rounded_ratio(10, 10) == 1.0\n\n\ndef test_rounded_ratio_zero_hit_returns_zero():\n    \"\"\"hit 为 0 时比例应为 0.0（来源：数学定义 hit/total）。\"\"\"\n    assert rounded_ratio(0, 10) == 0.0\n\n\ndef test_rounded_ratio_half_returns_half():\n    \"\"\"hit/total = 0.5 时结果应为 0.5（来源：数学定义）。\"\"\"\n    assert rounded_ratio(1, 2) == 0.5\n\n\ndef test_rounded_ratio_floor_behavior():\n    \"\"\"结果应向下取整到两位小数（来源：实现使用 math.floor(x*100)/100）。\n\n    1/3 ≈ 0.3333...，向下取整到两位小数应为 0.33。\n    \"\"\"\n    assert rounded_ratio(1, 3) == 0.33\n\n\ndef test_rounded_ratio_floor_behavior_two_thirds():\n    \"\"\"2/3 ≈ 0.6666...，向下取整到两位小数应为 0.66（来源：实现使用 math.floor）。\"\"\"\n    assert rounded_ratio(2, 3) == 0.66\n\n\ndef test_rounded_ratio_exact_two_decimals():\n    \"\"\"hit/total 恰好为两位小数时不应被截断（来源：数学定义）。\n\n    1/4 = 0.25，向下取整到两位小数仍为 0.25。\n    \"\"\"\n    assert rounded_ratio(1, 4) == 0.25\n\n\ndef test_rounded_ratio_returns_float_type():\n    \"\"\"返回值类型应为 float（来源：函数类型注解 -> float）。\"\"\"\n    result = rounded_ratio(1, 2)\n    assert isinstance(result, float)\n\n\ndef test_rounded_ratio_zero_total_returns_float_type():\n    \"\"\"total 为 0 时返回值类型也应为 float（来源：函数类型注解 -> float）。\"\"\"\n    result = rounded_ratio(0, 0)\n    assert isinstance(result, float)\n\n\n@pytest.mark.parametrize(\n    \"hit, total, expected\",\n    [\n        (0, 1, 0.0),\n        (1, 1, 1.0),\n        (1, 2, 0.5),\n        (1, 4, 0.25),\n        (3, 4, 0.75),\n        (1, 3, 0.33),\n        (2, 3, 0.66),\n        (1, 10, 0.1),\n        (9, 10, 0.9),\n        (50, 100, 0.5),\n    ],\n)\ndef test_rounded_ratio_parametrized_values(hit, total, expected):\n    \"\"\"参数化验证常见比例下向下取整到两位小数的结果（来源：数学定义与 math.floor 语义）。\"\"\"\n    assert rounded_ratio(hit, total) == expected\n\n\n@pytest.mark.parametrize(\n    \"hit, total\",\n    [\n        (0, 0),\n        (1, 0),\n        (100, 0),\n    ],\n)\ndef test_rounded_ratio_parametrized_zero_total(hit, total):\n    \"\"\"参数化验证 total 为 0 时统一返回 0.0（来源：函数实现中的显式分支）。\"\"\"\n    assert rounded_ratio(hit, total) == 0.0\n\n\ndef test_rounded_ratio_result_never_exceeds_one():\n    \"\"\"当 hit <= total 时结果不应超过 1.0（来源：数学定义 hit/total <= 1）。\"\"\"\n    for hit, total in [(0, 5), (1, 5), (5, 5), (3, 7)]:\n        assert rounded_ratio(hit, total) <= 1.0\n\n\ndef test_rounded_ratio_result_is_multiple_of_point_zero_one():\n    \"\"\"结果应为 0.01 的整数倍（来源：实现使用 math.floor(x*100)/100）。\"\"\"\n    for hit, total in [(1, 3), (2, 3), (1, 7), (5, 9)]:\n        result = rounded_ratio(hit, total)\n        assert math.isclose(result * 100, round(result * 100), abs_tol=1e-9)\n\n\ndef test_rounded_ratio_floor_not_round():\n    \"\"\"验证使用向下取整而非四舍五入（来源：实现使用 math.floor）。\n\n    2/3 ≈ 0.6666...，四舍五入会得到 0.67，向下取整得到 0.66。\n    \"\"\"\n    assert rounded_ratio(2, 3) == 0.66\n    assert rounded_ratio(2, 3) != 0.67",
