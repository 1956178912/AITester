          "generated_test": "import pytest\n\nfrom task_0062 import normalize, aggregate, report\n\n\nclass TestNormalize:\n    \"\"\"Tests for the normalize function.\"\"\"\n\n    def test_normalize_empty_list(self):\n        \"\"\"normalize([]) should return an empty list.\"\"\"\n        assert normalize([]) == []\n\n    def test_normalize_single_element(self):\n        \"\"\"normalize([1]) should return [2].\"\"\"\n        assert normalize([1]) == [2]\n\n    def test_normalize_positive_integers(self):\n        \"\"\"normalize should double each element in a list of positive integers.\"\"\"\n        assert normalize([1, 2, 3]) == [2, 4, 6]\n\n    def test_normalize_negative_integers(self):\n        \"\"\"normalize should double each element in a list of negative integers.\"\"\"\n        assert normalize([-1, -2, -3]) == [-2, -4, -6]\n\n    def test_normalize_mixed_integers(self):\n        \"\"\"normalize should double each element in a mixed list.\"\"\"\n        assert normalize([-1, 0, 1]) == [-2, 0, 2]\n\n    def test_normalize_floats(self):\n        \"\"\"normalize should double each element in a list of floats.\"\"\"\n        assert normalize([1.5, 2.5]) == [3.0, 5.0]\n\n    def test_normalize_returns_new_list(self):\n        \"\"\"normalize should return a new list, not modify the input in place.\"\"\"\n        original = [1, 2, 3]\n        result = normalize(original)\n        assert result == [2, 4, 6]\n        assert original == [1, 2, 3]\n        assert result is not original\n\n    def test_normalize_zero(self):\n        \"\"\"normalize([0]) should return [0].\"\"\"\n        assert normalize([0]) == [0]\n\n\nclass TestAggregate:\n    \"\"\"Tests for the aggregate function.\"\"\"\n\n    def test_aggregate_empty_list(self):\n        \"\"\"aggregate([]) should return {'count': 0, 'total': 0}.\"\"\"\n        assert aggregate([]) == {\"count\": 0, \"total\": 0}\n\n    def test_aggregate_single_element(self):\n        \"\"\"aggregate([5]) should return {'count': 1, 'total': 5}.\"\"\"\n        assert aggregate([5]) == {\"count\": 1, \"total\": 5}\n\n    def test_aggregate_multiple_elements(self):\n        \"\"\"aggregate should return correct count and total for multiple elements.\"\"\"\n        assert aggregate([1, 2, 3]) == {\"count\": 3, \"total\": 6}\n\n    def test_aggregate_negative_numbers(self):\n        \"\"\"aggregate should handle negative numbers correctly.\"\"\"\n        assert aggregate([-1, -2, -3]) == {\"count\": 3, \"total\": -6}\n\n    def test_aggregate_mixed_numbers(self):\n        \"\"\"aggregate should handle mixed positive and negative numbers.\"\"\"\n        assert aggregate([-1, 0, 1]) == {\"count\": 3, \"total\": 0}\n\n    def test_aggregate_floats(self):\n        \"\"\"aggregate should handle floats.\"\"\"\n        result = aggregate([1.5, 2.5])\n        assert result[\"count\"] == 2\n        assert result[\"total\"] == pytest.approx(4.0)\n\n    def test_aggregate_returns_dict(self):\n        \"\"\"aggregate should return a dict with 'count' and 'total' keys.\"\"\"\n        result = aggregate([1, 2, 3])\n        assert isinstance(result, dict)\n        assert set(result.keys()) == {\"count\", \"total\"}\n\n    def test_aggregate_zeros(self):\n        \"\"\"aggregate([0, 0, 0]) should return {'count': 3, 'total': 0}.\"\"\"\n        assert aggregate([0, 0, 0]) == {\"count\": 3, \"total\": 0}\n\n\nclass TestReport:\n    \"\"\"Tests for the report function.\"\"\"\n\n    def test_report_empty_list(self):\n        \"\"\"report([]) should produce 'count=0 total=0'.\"\"\"\n        assert report([]) == \"count=0 total=0\"\n\n    def test_report_single_element(self):\n        \"\"\"report([1]) should produce 'count=1 total=2' (normalized then aggregated).\"\"\"\n        assert report([1]) == \"count=1 total=2\"\n\n    def test_report_multiple_elements(self):\n        \"\"\"report([1, 2, 3]) should produce 'count=3 total=12'.\"\"\"\n        assert report([1, 2, 3]) == \"count=3 total=12\"\n\n    def test_report_negative_numbers(self):\n        \"\"\"report([-1, -2]) should produce 'count=2 total=-6'.\"\"\"\n        assert report([-1, -2]) == \"count=2 total=-6\"\n\n    def test_report_zeros(self):\n        \"\"\"report([0, 0]) should produce 'count=2 total=0'.\"\"\"\n        assert report([0, 0]) == \"count=2 total=0\"\n\n    def test_report_returns_string(self):\n        \"\"\"report should return a string.\"\"\"\n        result = report([1, 2, 3])\n        assert isinstance(result, str)\n\n    def test_report_format(self):\n        \"\"\"report output should match the 'count=<n> total=<n>' format.\"\"\"\n        result = report([1, 2, 3])\n        assert result.startswith(\"count=\")\n        assert \" total=\" in result\n\n    def test_report_consistency_with_normalize_and_aggregate(self):\n        \"\"\"report output should be consistent with normalize followed by aggregate.\"\"\"\n        data = [1, 2, 3, 4]\n        normalized = normalize(data)\n        stats = aggregate(normalized)\n        expected = \"count={0} total={1}\".format(stats[\"count\"], stats[\"total\"])\n        assert report(data) == expected",
