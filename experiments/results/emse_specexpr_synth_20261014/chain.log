          "generated_test": "import pytest\n\nfrom task_0015 import is_palindrome\n\n\n# ---------------------------------------------------------------------------\n# 正常用例\n# ---------------------------------------------------------------------------\n\ndef test_is_palindrome_typical_odd_palindrome():\n    \"\"\"普通奇数长度回文 'racecar' 应返回 True（规约：result == (s == s[::-1])）。\"\"\"\n    s = \"racecar\"\n    result = is_palindrome(s)\n    assert result == (s == s[::-1])\n    assert result is True\n\n\ndef test_is_palindrome_typical_non_palindrome():\n    \"\"\"普通非回文 'hello' 应返回 False（规约：result == (s == s[::-1])）。\"\"\"\n    s = \"hello\"\n    result = is_palindrome(s)\n    assert result == (s == s[::-1])\n    assert result is False\n\n\ndef test_is_palindrome_even_length_palindrome():\n    \"\"\"偶数长度回文 'abba' 应返回 True（规约：result == (s == s[::-1])）。\"\"\"\n    s = \"abba\"\n    result = is_palindrome(s)\n    assert result == (s == s[::-1])\n    assert result is True\n\n\n# ---------------------------------------------------------------------------\n# 边界用例\n# ---------------------------------------------------------------------------\n\ndef test_is_palindrome_empty_string():\n    \"\"\"空字符串反转仍为空串，规约约定应为 True。\"\"\"\n    s = \"\"\n    result = is_palindrome(s)\n    assert result == (s == s[::-1])\n    assert result is True\n\n\ndef test_is_palindrome_single_character():\n    \"\"\"单字符反转等于自身，规约约定应为 True。\"\"\"\n    s = \"a\"\n    result = is_palindrome(s)\n    assert result == (s == s[::-1])\n    assert result is True\n\n\n@pytest.mark.parametrize(\n    \"s, expected\",\n    [\n        (\"aa\", True),\n        (\"ab\", False),\n    ],\n)\ndef test_is_palindrome_two_characters(s, expected):\n    \"\"\"两字符相同/不同：'aa' 为回文，'ab' 非回文（规约边界情况）。\"\"\"\n    result = is_palindrome(s)\n    assert result == (s == s[::-1])\n    assert result is expected\n\n\ndef test_is_palindrome_case_sensitive():\n    \"\"\"大小写敏感：'Aa' 反转 'aA' 不等，规约约定应为 False。\"\"\"\n    s = \"Aa\"\n    result = is_palindrome(s)\n    assert result == (s == s[::-1])\n    assert result is False\n\n\ndef test_is_palindrome_with_spaces():\n    \"\"\"含空格回文 'a b a'，规约约定应为 True（未过滤空白）。\"\"\"\n    s = \"a b a\"\n    result = is_palindrome(s)\n    assert result == (s == s[::-1])\n    assert result is True\n\n\ndef test_is_palindrome_unicode_chinese():\n    \"\"\"Unicode/中文回文 '上海自来水来自海上'，规约约定应为 True。\"\"\"\n    s = \"上海自来水来自海上\"\n    result = is_palindrome(s)\n    assert result == (s == s[::-1])\n    assert result is True\n\n\ndef test_is_palindrome_long_non_palindrome():\n    \"\"\"非回文长串应返回 False（规约边界情况）。\"\"\"\n    s = \"abcdefghijklmnopqrstuvwxyz\"\n    result = is_palindrome(s)\n    assert result == (s == s[::-1])\n    assert result is False\n\n\n# ---------------------------------------------------------------------------\n# 后置条件：返回类型\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\n    \"s\",\n    [\"\", \"a\", \"abba\", \"hello\", \"a b a\", \"上海自来水来自海上\"],\n)\ndef test_is_palindrome_returns_bool(s):\n    \"\"\"后置条件：返回值必须为 bool 类型（规约：isinstance(result, bool)）。\"\"\"\n    result = is_palindrome(s)\n    assert isinstance(result, bool)\n\n\n# ---------------------------------------------------------------------------\n# 前置条件违反路径（类型注解要求 str）\n# ---------------------------------------------------------------------------\n\ndef test_is_palindrome_non_string_int_raises():\n    \"\"\"前置条件要求 s 为 str；传入 int 违反前置条件。\n\n    规约未约定具体异常类型，期望值来源不明，需人工确认。\n    此处仅记录实际行为：应抛出异常（探索性断言）。\n    \"\"\"\n    with pytest.raises(Exception):\n        is_palindrome(12321)\n\n\ndef test_is_palindrome_none_raises():\n    \"\"\"前置条件要求 s 为 str；传入 None 违反前置条件。\n\n    规约未约定具体异常类型，期望值来源不明，需人工确认。\n    此处仅记录实际行为：应抛出异常（探索性断言）。\n    \"\"\"\n    with pytest.raises(Exception):\n        is_palindrome(None)",
