          "generated_test": "import pytest\n\nfrom task_0072 import add_item, stock_of, _STOCK\n\n\n@pytest.fixture(autouse=True)\ndef clean_stock():\n    \"\"\"在每个测试前后清空全局库存字典，保证测试隔离。\"\"\"\n    _STOCK.clear()\n    yield\n    _STOCK.clear()\n\n\ndef test_add_item_sets_stock_for_sku():\n    \"\"\"add_item 应将指定 sku 的库存设置为给定 qty。\n\n    期望值来源：add_item 的 docstring/类型注解未给出，但函数体\n    `_STOCK[sku] = qty` 明确表示写入行为，故断言 stock_of 返回 qty。\n    \"\"\"\n    add_item(1, 10)\n    assert stock_of(1) == 10\n\n\ndef test_add_item_overwrites_existing_stock():\n    \"\"\"add_item 对同一 sku 重复调用应覆盖旧值。\n\n    期望值来源：函数体为直接赋值 `_STOCK[sku] = qty`，因此为覆盖语义。\n    \"\"\"\n    add_item(1, 10)\n    add_item(1, 5)\n    assert stock_of(1) == 5\n\n\ndef test_add_item_accepts_zero_qty():\n    \"\"\"add_item 允许 qty 为 0，库存应被设置为 0。\n\n    期望值来源：类型注解 qty: int 未限制正数，函数体直接赋值。\n    \"\"\"\n    add_item(2, 0)\n    assert stock_of(2) == 0\n\n\ndef test_add_item_accepts_negative_qty():\n    \"\"\"add_item 对负数 qty 不做校验，应原样写入。\n\n    期望值来源：函数体无校验逻辑，直接赋值。\n    \"\"\"\n    add_item(3, -7)\n    assert stock_of(3) == -7\n\n\ndef test_add_item_returns_none():\n    \"\"\"add_item 的返回值为 None。\n\n    期望值来源：类型注解 `-> None`。\n    \"\"\"\n    assert add_item(4, 1) is None\n\n\ndef test_stock_of_returns_zero_for_unknown_sku():\n    \"\"\"stock_of 对未记录的 sku 返回 0。\n\n    期望值来源：函数体 `_STOCK.get(sku, 0)` 的默认值。\n    \"\"\"\n    assert stock_of(999) == 0\n\n\ndef test_stock_of_returns_stored_value():\n    \"\"\"stock_of 返回已记录 sku 的库存值。\n\n    期望值来源：函数体 `_STOCK.get(sku, 0)`。\n    \"\"\"\n    add_item(5, 42)\n    assert stock_of(5) == 42\n\n\ndef test_stock_of_returns_zero_after_clearing():\n    \"\"\"清空库存后 stock_of 应返回 0。\n\n    期望值来源：函数体默认值 0。\n    \"\"\"\n    add_item(6, 8)\n    _STOCK.clear()\n    assert stock_of(6) == 0\n\n\ndef test_stock_of_accepts_str_sku():\n    \"\"\"stock_of 的 sku 参数类型注解为 str，应能接受字符串键。\n\n    期望值来源：类型注解 `sku: str`。\n    \"\"\"\n    _STOCK[\"abc\"] = 3\n    assert stock_of(\"abc\") == 3\n\n\ndef test_add_item_and_stock_of_roundtrip_multiple_skus():\n    \"\"\"多个 sku 的写入与读取互不干扰。\n\n    期望值来源：函数体基于字典键值存储。\n    \"\"\"\n    add_item(10, 1)\n    add_item(11, 2)\n    add_item(12, 3)\n    assert stock_of(10) == 1\n    assert stock_of(11) == 2\n    assert stock_of(12) == 3",
