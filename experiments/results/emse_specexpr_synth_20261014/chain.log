          "generated_test": "import pytest\n\nfrom task_0085 import mark_positions\n\n\n# ---------------------------------------------------------------------------\n# 常规用例\n# ---------------------------------------------------------------------------\n\ndef test_mark_positions_mixed_hit_and_miss():\n    \"\"\"常规命中与未命中混合：命中处记录下标，未命中处记录 -1，且不处理最后一个字符。\n\n    期望值来源：规约后置条件 result[i] == i 当且仅当 text[i] == ch，\n    以及 len(result) == max(len(text) - 1, 0)。\n    \"\"\"\n    text = \"abcabc\"\n    ch = \"a\"\n    result = mark_positions(text, ch)\n    assert result == [0, -1, -1, 3, -1]\n\n\ndef test_mark_positions_all_chars_hit():\n    \"\"\"全部前 len-1 个字符命中：返回递增下标序列 [0, 1, ..., len(text)-2]。\n\n    期望值来源：规约边界情况\"text 全部字符等于 ch\"。\n    \"\"\"\n    text = \"aaaa\"\n    ch = \"a\"\n    result = mark_positions(text, ch)\n    assert result == [0, 1, 2]\n\n\ndef test_mark_positions_no_char_hit():\n    \"\"\"无字符命中：返回全 -1 列表。\n\n    期望值来源：规约边界情况\"text 中无字符等于 ch\"。\n    \"\"\"\n    text = \"abcd\"\n    ch = \"z\"\n    result = mark_positions(text, ch)\n    assert result == [-1, -1, -1]\n\n\n# ---------------------------------------------------------------------------\n# 边界用例\n# ---------------------------------------------------------------------------\n\ndef test_mark_positions_empty_text():\n    \"\"\"空字符串：len(text)-1 = -1，range(-1) 为空，返回 []。\n\n    期望值来源：规约边界情况\"text 为空串\"。\n    \"\"\"\n    result = mark_positions(\"\", \"a\")\n    assert result == []\n\n\ndef test_mark_positions_single_char_text():\n    \"\"\"单字符字符串：len(text)-1 = 0，range(0) 为空，返回 []（最后一个字符不参与比较）。\n\n    期望值来源：规约边界情况\"text 为单字符\"。\n    \"\"\"\n    result = mark_positions(\"a\", \"a\")\n    assert result == []\n\n\ndef test_mark_positions_two_char_text():\n    \"\"\"两字符字符串：最小非空迭代次数，仅比较第一个字符。\n\n    期望值来源：规约后置条件 len(result) == max(len(text)-1, 0) 与\n    result[i] == i 当且仅当 text[i] == ch。\n    \"\"\"\n    result = mark_positions(\"ab\", \"a\")\n    assert result == [0]\n\n\ndef test_mark_positions_multichar_ch():\n    \"\"\"ch 为多字符字符串：单字符与多字符比较恒不相等，全为 -1。\n\n    期望值来源：规约边界情况\"ch 为多字符字符串\"。\n    \"\"\"\n    result = mark_positions(\"abc\", \"ab\")\n    assert result == [-1, -1]\n\n\ndef test_mark_positions_empty_ch():\n    \"\"\"ch 为空字符串：空串与任何单字符不相等，全为 -1。\n\n    期望值来源：规约边界情况\"ch 为空串\"。\n    \"\"\"\n    result = mark_positions(\"abc\", \"\")\n    assert result == [-1, -1]\n\n\n# ---------------------------------------------------------------------------\n# 规约性质（后置条件 / 不变量）参数化验证\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\n    \"text, ch\",\n    [\n        (\"abcabc\", \"a\"),\n        (\"aaaa\", \"a\"),\n        (\"abcd\", \"z\"),\n        (\"\", \"a\"),\n        (\"a\", \"a\"),\n        (\"ab\", \"a\"),\n        (\"abc\", \"ab\"),\n        (\"abc\", \"\"),\n        (\"hello world\", \"o\"),\n        (\"xyz\", \"x\"),\n    ],\n)\ndef test_mark_positions_postcondition_length(text, ch):\n    \"\"\"后置条件：返回值为 list，且长度恒为 max(len(text)-1, 0)。\n\n    期望值来源：规约后置条件与不变量。\n    \"\"\"\n    result = mark_positions(text, ch)\n    assert isinstance(result, list)\n    assert len(result) == max(len(text) - 1, 0)\n\n\n@pytest.mark.parametrize(\n    \"text, ch\",\n    [\n        (\"abcabc\", \"a\"),\n        (\"aaaa\", \"a\"),\n        (\"abcd\", \"z\"),\n        (\"\", \"a\"),\n        (\"a\", \"a\"),\n        (\"ab\", \"a\"),\n        (\"abc\", \"ab\"),\n        (\"abc\", \"\"),\n        (\"hello world\", \"o\"),\n        (\"xyz\", \"x\"),\n    ],\n)\ndef test_mark_positions_postcondition_element_domain(text, ch):\n    \"\"\"后置条件：result 中每个元素要么等于其下标 i，要么等于 -1。\n\n    期望值来源：规约后置条件。\n    \"\"\"\n    result = mark_positions(text, ch)\n    assert all(result[i] == i or result[i] == -1 for i in range(len(result)))\n\n\n@pytest.mark.parametrize(\n    \"text, ch\",\n    [\n        (\"abcabc\", \"a\"),\n        (\"aaaa\", \"a\"),\n        (\"abcd\", \"z\"),\n        (\"\", \"a\"),\n        (\"a\", \"a\"),\n        (\"ab\", \"a\"),\n        (\"abc\", \"ab\"),\n        (\"abc\", \"\"),\n        (\"hello world\", \"o\"),\n        (\"xyz\", \"x\"),\n    ],\n)\ndef test_mark_positions_postcondition_hit_iff_equal(text, ch):\n    \"\"\"后置条件：result[i] == i 当且仅当 text[i] == ch。\n\n    期望值来源：规约后置条件。\n    \"\"\"\n    result = mark_positions(text, ch)\n    for i in range(len(result)):\n        if text[i] == ch:\n            assert result[i] == i\n        else:\n            assert result[i] == -1\n\n\n# ---------------------------------------------------------------------------\n# 错误 / 前置条件破坏路径\n# ---------------------------------------------------------------------------\n\ndef test_mark_positions_non_str_text_raises():\n    \"\"\"text 非字符串类型：签名标注 text 为 str，传入 int 时 len() 抛 TypeError。\n\n    期望值来源：规约前置条件 isinstance(text, str) 被破坏；\n    具体异常类型未在规约中显式声明，此处按 Python 内建语义断言 TypeError。\n    \"\"\"\n    with pytest.raises(TypeError):\n        mark_positions(123, \"1\")\n\n\ndef test_mark_positions_non_str_ch_behavior():\n    \"\"\"ch 非字符串类型：签名标注 ch 为 str，传入 int 时类型约定被破坏。\n\n    期望值来源不明，需人工确认：规约仅声明前置条件 isinstance(ch, str)，\n    未定义破坏该前置条件时的行为。此处仅记录实际行为，不做强断言。\n    \"\"\"\n    try:\n        result = mark_positions(\"abc\", 1)\n    except Exception as exc:  # noqa: BLE001 - 记录实际行为\n        # 若实现选择抛异常，记录异常类型即可，不臆造具体类型\n        assert exc is not None\n    else:\n        # 若实现未抛异常，则按规约后置条件校验其结构性质\n        assert isinstance(result, list)\n        assert len(result) == max(len(\"abc\") - 1, 0)\n        assert all(result[i] == i or result[i] == -1 for i in range(len(result)))",
