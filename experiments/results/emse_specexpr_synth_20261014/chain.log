res\",\n        [\n            [3, 1, 4, 1, 5, 9, 2, 6],\n            [7],\n            [5, 5, 5],\n            [-3, -1, -7],\n            [0, -5, 3],\n            [9, 5, 1],\n            [1, 5, 9],\n        ],\n    )\n    def test_best_score_result_in_scores(self, scores):\n        \"\"\"规约后置条件：返回值属于 scores。\n\n        对每个合法输入，断言 best_score(scores) in scores。\n        \"\"\"\n        result = best_score(scores)\n        assert result in scores\n\n    @pytest.mark.parametrize(\n        \"scores\",\n        [\n            [3, 1, 4, 1, 5, 9, 2, 6],\n            [7],\n            [5, 5, 5],\n            [-3, -1, -7],\n            [0, -5, 3],\n            [9, 5, 1],\n            [1, 5, 9],\n        ],\n    )\n    def test_best_score_is_maximum(self, scores):\n        \"\"\"规约后置条件：返回值等于 scores 中最大元素。\n\n        使用内置 max 作为规约的独立参照（规约明确要求返回最大值）。\n        \"\"\"\n        assert best_score(scores) == max(scores)\n\n\nclass TestBestScoreEmptyInput:\n    \"\"\"空列表输入：规约前置条件要求非空，空输入行为未定义。\"\"\"\n\n    def test_best_score_empty_list_behavior(self):\n        \"\"\"空列表违反前置条件（scores 为非空列表），行为未在规约中定义。\n\n        期望值来源不明，需人工确认：此处仅记录实际行为，\n        若实现抛出异常则接受异常，否则记录返回值。\n        \"\"\"\n        try:\n            result = best_score([])\n        except Exception as exc:  # noqa: BLE001\n            # 实现选择抛出异常，符合前置条件被违反的合理处理\n            assert exc is not None\n        else:\n            # 实现未抛异常，记录实际行为供人工确认\n            assert result is not None or result is None",
