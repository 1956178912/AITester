          "generated_test": "import pytest\n\nfrom task_0049 import compute_scores\n\n\ndef test_compute_scores_normal_multiple_records():\n    \"\"\"正常多记录转换：验证基本 name/value 映射。\n\n    期望值来源：规约后置条件 record.get('name','unknown') / record.get('value',0)。\n    \"\"\"\n    records = [\n        {\"name\": \"a\", \"value\": 1},\n        {\"name\": \"b\", \"value\": 2},\n    ]\n    result = compute_scores(records)\n    assert result == {\"a\": 1, \"b\": 2}\n\n\ndef test_compute_scores_empty_list():\n    \"\"\"空列表：验证空输入返回空字典。\n\n    期望值来源：规约边界情况 records 为空列表 -> 返回 {}。\n    \"\"\"\n    result = compute_scores([])\n    assert result == {}\n\n\ndef test_compute_scores_missing_name_key():\n    \"\"\"缺失 name 键：验证默认键 'unknown'。\n\n    期望值来源：规约边界情况 record 缺少 'name' -> 键为 'unknown'。\n    \"\"\"\n    records = [{\"value\": 5}]\n    result = compute_scores(records)\n    assert result == {\"unknown\": 5}\n\n\ndef test_compute_scores_missing_value_key():\n    \"\"\"缺失 value 键：验证默认值 0。\n\n    期望值来源：规约边界情况 record 缺少 'value' -> 值为 0。\n    \"\"\"\n    records = [{\"name\": \"x\"}]\n    result = compute_scores(records)\n    assert result == {\"x\": 0}\n\n\ndef test_compute_scores_duplicate_name_overrides():\n    \"\"\"重复 name 覆盖：验证后值覆盖前值。\n\n    期望值来源：规约边界情况 多个 record 的 name 相同 -> 后出现的覆盖前者。\n    \"\"\"\n    records = [\n        {\"name\": \"a\", \"value\": 1},\n        {\"name\": \"a\", \"value\": 2},\n    ]\n    result = compute_scores(records)\n    assert result == {\"a\": 2}\n\n\ndef test_compute_scores_negative_value_preserved():\n    \"\"\"value 为负数：验证负数原样保留。\n\n    期望值来源：规约边界情况 value 为 0 或负数 -> 原样保留。\n    \"\"\"\n    records = [{\"name\": \"n\", \"value\": -3}]\n    result = compute_scores(records)\n    assert result == {\"n\": -3}\n\n\ndef test_compute_scores_zero_value_preserved():\n    \"\"\"value 为 0：验证 0 原样保留（不被默认值逻辑误替换）。\n\n    期望值来源：规约边界情况 value 为 0 或负数 -> 原样保留。\n    \"\"\"\n    records = [{\"name\": \"z\", \"value\": 0}]\n    result = compute_scores(records)\n    assert result == {\"z\": 0}\n\n\ndef test_compute_scores_missing_name_and_value():\n    \"\"\"同时缺失 name 与 value：键为 'unknown'，值为 0。\n\n    期望值来源：规约后置条件与边界情况的组合。\n    \"\"\"\n    records = [{}]\n    result = compute_scores(records)\n    assert result == {\"unknown\": 0}\n\n\ndef test_compute_scores_result_length_equals_records_length():\n    \"\"\"后置条件：无键冲突时返回字典长度等于 records 长度。\n\n    期望值来源：规约后置条件 返回字典长度等于 records 长度。\n    \"\"\"\n    records = [\n        {\"name\": \"a\", \"value\": 1},\n        {\"name\": \"b\", \"value\": 2},\n        {\"name\": \"c\", \"value\": 3},\n    ]\n    result = compute_scores(records)\n    assert len(result) == len(records)\n\n\ndef test_compute_scores_non_dict_record_raises():\n    \"\"\"record 非 dict：非 dict 元素不满足前置条件（无 .get 方法）。\n\n    期望值来源：规约前置条件要求每个元素支持 .get 方法；\n    非 dict 输入违反前件，期望抛出 AttributeError。\n    \"\"\"\n    records = [1]\n    with pytest.raises(AttributeError):\n        compute_scores(records)",
