          "patch": "python\ndef _better(current: int, candidate: int) -> bool:\n    return candidate > current\n\ndef best_score(scores: list) -> int:\n    best = scores[0]\n    for s in scores[1:]:\n        if _better(best, s):\n            best = s\n    return best\n\ndef worst_score(scores: list) -> int:\n    worst = scores[0]\n    for s in scores[1:]:\n        if not _better(worst, s):\n            worst = s\n    return worst\n# noise_seed=2668\n",
          "generated_test": "import pytest\n\nfrom task_0018 import best_score\n\n\nclass TestBestScore:\n    \"\"\"best_score 的测试集合。\n\n    规约来源：函数签名与自然语言规约。\n    期望值仅来自规约：返回值是 scores 中按 _better 语义最优的元素。\n    规约未约定空列表行为，故空列表用例采用探索性断言。\n    \"\"\"\n\n    def test_best_score_single_element(self):\n        \"\"\"单元素列表：循环体不执行，直接返回首元素（边界情况）。\"\"\"\n        assert best_score([5]) == 5\n\n    def test_best_score_strictly_increasing(self):\n        \"\"\"严格递增序列：最优元素为最后一个（最大值）。\"\"\"\n        assert best_score([1, 2, 3, 4, 5]) == 5\n\n    def test_best_score_strictly_decreasing(self):\n        \"\"\"严格递减序列：最优元素为首元素（最大值）。\"\"\"\n        assert best_score([5, 4, 3, 2, 1]) == 5\n\n    def test_best_score_all_equal(self):\n        \"\"\"全部元素相等：返回该共同值（边界情况）。\"\"\"\n        assert best_score([7, 7, 7]) == 7\n\n    def test_best_score_with_negatives(self):\n        \"\"\"含负数：最优元素为最大负数（边界情况）。\"\"\"\n        assert best_score([-3, -1, -7]) == -1\n\n    def test_best_score_with_zero_and_mixed_signs(self):\n        \"\"\"含 0 与正负数：最优元素为最大值 3（边界情况）。\"\"\"\n        assert best_score([0, -5, 3]) == 3\n\n    def test_best_score_duplicate_maximum(self):\n        \"\"\"重复最大值：返回其中一个最大值 9（边界情况）。\"\"\"\n        assert best_score([2, 9, 9, 1]) == 9\n\n    def test_best_score_does_not_modify_input(self):\n        \"\"\"后置条件：不修改输入列表。\"\"\"\n        scores = [3, 1, 4, 1, 5, 9, 2, 6]\n        original = list(scores)\n        best_score(scores)\n        assert scores == original\n\n    def test_best_score_returns_element_from_input(self):\n        \"\"\"后置条件：返回值必须是 scores 中的元素。\"\"\"\n        scores = [10, -4, 7, 7, 0]\n        result = best_score(scores)\n        assert result in scores\n\n    def test_best_score_is_upper_bound_of_input(self):\n        \"\"\"后置条件：返回值不小于列表中任意元素（最优语义）。\"\"\"\n        scores = [-8, 3, 3, 12, 0, -1]\n        result = best_score(scores)\n        assert all(result >= s for s in scores)\n\n    def test_best_score_empty_list_behavior(self):\n        \"\"\"空列表：规约未约定空输入行为，期望值来源不明，需人工确认。\n\n        前置条件要求 scores 为非空列表，此处为探索性用例：\n        记录实际行为（抛出异常或返回某值），不做具体值断言。\n        \"\"\"\n        try:\n            result = best_score([])\n        except Exception as exc:  # noqa: BLE001\n            # 记录实际抛出的异常类型，供人工确认\n            assert isinstance(exc, Exception)\n        else:\n            # 若未抛异常，仅记录实际返回值，不臆造期望\n            assert result is not None or result is None",
