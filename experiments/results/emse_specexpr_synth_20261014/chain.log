-----------------------------------------\n\n@pytest.mark.parametrize(\"key\", [\"alpha\", \"beta\", \"gamma\", \"delta\", \"\"])\ndef test_lookup_is_pure_and_idempotent(key):\n    \"\"\"对同一 key 多次调用返回相同结果（纯函数后置条件）。\n\n    期望值来源：规约后置条件“对同一 key 多次调用返回相同结果”。\n    \"\"\"\n    first = lookup(key)\n    second = lookup(key)\n    third = lookup(key)\n    assert first == second == third\n\n\n# ---------------------------------------------------------------------------\n# 后置条件：不修改 _TABLE 内容\n# ---------------------------------------------------------------------------\n\ndef test_lookup_does_not_mutate_table():\n    \"\"\"调用 lookup 不修改模块级 _TABLE 内容（后置条件）。\n\n    期望值来源：规约后置条件“不修改 _TABLE 内容”。\n    通过调用前后对已知键的查询结果一致性间接验证。\n    \"\"\"\n    import task_0045\n\n    before = dict(task_0045._TABLE)\n    lookup(\"alpha\")\n    lookup(\"delta\")\n    lookup(\"\")\n    lookup(None)\n    after = dict(task_0045._TABLE)\n    assert before == after\n\n\n# ---------------------------------------------------------------------------\n# 类型违规路径：不可哈希类型应抛 TypeError\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\n    \"bad_key\",\n    [\n        [\"alpha\"],          # list 不可哈希\n        {\"alpha\": 1},       # dict 不可哈希\n        {\"alpha\"},          # set 不可哈希\n    ],\n)\ndef test_lookup_unhashable_key_raises_type_error(bad_key):\n    \"\"\"不可哈希类型作为 key 时，dict.get 会抛 TypeError。\n\n    期望值来源：规约边界情况“dict.get 对不可哈希类型会抛 TypeError”。\n    注意：该输入违反前置条件（key 应为 str），此处验证其失败模式。\n    \"\"\"\n    with pytest.raises(TypeError):\n        lookup(bad_key)",
