          "generated_test": "import math\n\nimport pytest\n\nfrom task_0027 import divide\n\n\n# ---------------------------------------------------------------------------\n# 正常路径\n# ---------------------------------------------------------------------------\n\ndef test_divide_positive_integers():\n    \"\"\"规约：返回 a / b 的浮点商。10.0 / 2.0 == 5.0。\"\"\"\n    result = divide(10.0, 2.0)\n    assert result == 5.0\n    assert isinstance(result, float)\n\n\ndef test_divide_non_exact_quotient():\n    \"\"\"规约：返回 a / b 的浮点商。1.0 / 3.0 的浮点近似值。\"\"\"\n    result = divide(1.0, 3.0)\n    assert result == pytest.approx(1.0 / 3.0)\n    assert isinstance(result, float)\n\n\n# ---------------------------------------------------------------------------\n# 边界情况\n# ---------------------------------------------------------------------------\n\ndef test_divide_zero_dividend():\n    \"\"\"规约边界：a = 0 时结果 0。\"\"\"\n    assert divide(0.0, 5.0) == 0.0\n\n\ndef test_divide_negative_dividend():\n    \"\"\"规约边界：负数输入。(-10.0) / 2.0 == -5.0。\"\"\"\n    assert divide(-10.0, 2.0) == -5.0\n\n\ndef test_divide_negative_divisor():\n    \"\"\"规约边界：负数输入。10.0 / (-2.0) == -5.0。\"\"\"\n    assert divide(10.0, -2.0) == -5.0\n\n\ndef test_divide_both_negative():\n    \"\"\"规约边界：负数输入。(-10.0) / (-2.0) == 5.0。\"\"\"\n    assert divide(-10.0, -2.0) == 5.0\n\n\ndef test_divide_tiny_float_underflow():\n    \"\"\"规约边界：极小浮点数下溢。5e-324 / 2.0 下溢为 0.0。\"\"\"\n    assert divide(5e-324, 2.0) == 0.0\n\n\ndef test_divide_max_float_no_overflow():\n    \"\"\"规约边界：极大浮点数不溢出。max_float / 1.0 == max_float。\"\"\"\n    max_float = 1.7976931348623157e+308\n    assert divide(max_float, 1.0) == max_float\n\n\ndef test_divide_infinity_dividend():\n    \"\"\"规约边界：Infinity 输入。inf / 2.0 == inf（IEEE 754 语义）。\"\"\"\n    assert divide(math.inf, 2.0) == math.inf\n\n\ndef test_divide_nan_dividend():\n    \"\"\"规约边界：NaN 输入。nan / 2.0 结果为 NaN（IEEE 754 语义）。\"\"\"\n    assert math.isnan(divide(math.nan, 2.0))\n\n\n# ---------------------------------------------------------------------------\n# 异常路径\n# ---------------------------------------------------------------------------\n\ndef test_divide_by_zero_raises():\n    \"\"\"规约：b 为 0 时抛出 ZeroDivisionError。\"\"\"\n    with pytest.raises(ZeroDivisionError):\n        divide(10.0, 0.0)\n\n\ndef test_divide_zero_by_zero_raises():\n    \"\"\"规约：b 为 0 时抛出 ZeroDivisionError（0.0 / 0.0）。\"\"\"\n    with pytest.raises(ZeroDivisionError):\n        divide(0.0, 0.0)\n\n\ndef test_divide_by_negative_zero_raises():\n    \"\"\"规约：b 为 0 时抛出 ZeroDivisionError（-0.0 亦为 0）。\"\"\"\n    with pytest.raises(ZeroDivisionError):\n        divide(10.0, -0.0)",
