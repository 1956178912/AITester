          "generated_test": "import pytest\n\nfrom task_0029 import mark_positions\n\n\n# ---------------------------------------------------------------------------\n# 正常用例\n# ---------------------------------------------------------------------------\n\ndef test_mark_positions_all_chars_match():\n    \"\"\"规约：text='aaa', ch='a' -> 前两位匹配，末位不参与比较，返回 [0, 1]。\"\"\"\n    result = mark_positions(\"aaa\", \"a\")\n    assert result == [0, 1]\n\n\ndef test_mark_positions_partial_match():\n    \"\"\"规约：text='abab', ch='a' -> 混合命中与未命中，返回 [0, -1, 2]。\"\"\"\n    result = mark_positions(\"abab\", \"a\")\n    assert result == [0, -1, 2]\n\n\ndef test_mark_positions_no_match():\n    \"\"\"规约：ch 不在 text 中，全部返回 -1。\"\"\"\n    result = mark_positions(\"xyz\", \"a\")\n    assert result == [-1, -1]\n\n\n# ---------------------------------------------------------------------------\n# 边界用例\n# ---------------------------------------------------------------------------\n\ndef test_mark_positions_empty_text():\n    \"\"\"规约：text 为空串时返回 []。\"\"\"\n    result = mark_positions(\"\", \"a\")\n    assert result == []\n\n\ndef test_mark_positions_single_char_text():\n    \"\"\"规约：text 长度为 1 时返回 []，即使唯一字符匹配也不标记。\"\"\"\n    result = mark_positions(\"a\", \"a\")\n    assert result == []\n\n\ndef test_mark_positions_last_char_match_not_marked():\n    \"\"\"规约：末位字符匹配但不被标记（循环上界为 len(text)-1）。\"\"\"\n    result = mark_positions(\"aba\", \"a\")\n    assert result == [0, -1]\n\n\ndef test_mark_positions_empty_ch():\n    \"\"\"规约：ch 为空串时，单字符 text[i] 永不等于 ''，全部返回 -1。\"\"\"\n    result = mark_positions(\"abc\", \"\")\n    assert result == [-1, -1]\n\n\ndef test_mark_positions_multichar_ch():\n    \"\"\"规约：ch 为多字符时，text[i] 为单字符，比较恒为 False，全部返回 -1。\"\"\"\n    result = mark_positions(\"abc\", \"ab\")\n    assert result == [-1, -1]\n\n\n# ---------------------------------------------------------------------------\n# 后置条件 / 不变量（参数化覆盖多种输入）\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\n    \"text, ch\",\n    [\n        (\"\", \"a\"),\n        (\"a\", \"a\"),\n        (\"ab\", \"a\"),\n        (\"aaa\", \"a\"),\n        (\"abab\", \"a\"),\n        (\"xyz\", \"a\"),\n        (\"abc\", \"\"),\n        (\"abc\", \"ab\"),\n        (\"hello world\", \"o\"),\n        (\"aaaa\", \"a\"),\n        (\"abcd\", \"d\"),\n    ],\n)\ndef test_mark_positions_length_invariant(text, ch):\n    \"\"\"规约不变量：len(result) == max(len(text) - 1, 0)。\"\"\"\n    result = mark_positions(text, ch)\n    assert len(result) == max(len(text) - 1, 0)\n\n\n@pytest.mark.parametrize(\n    \"text, ch\",\n    [\n        (\"\", \"a\"),\n        (\"a\", \"a\"),\n        (\"ab\", \"a\"),\n        (\"aaa\", \"a\"),\n        (\"abab\", \"a\"),\n        (\"xyz\", \"a\"),\n        (\"abc\", \"\"),\n        (\"abc\", \"ab\"),\n        (\"hello world\", \"o\"),\n        (\"aaaa\", \"a\"),\n        (\"abcd\", \"d\"),\n    ],\n)\ndef test_mark_positions_elements_are_int(text, ch):\n    \"\"\"规约后置条件：result 中所有元素为 int。\"\"\"\n    result = mark_positions(text, ch)\n    assert all(isinstance(x, int) for x in result)\n\n\n@pytest.mark.parametrize(\n    \"text, ch\",\n    [\n        (\"\", \"a\"),\n        (\"a\", \"a\"),\n        (\"ab\", \"a\"),\n        (\"aaa\", \"a\"),\n        (\"abab\", \"a\"),\n        (\"xyz\", \"a\"),\n        (\"abc\", \"\"),\n        (\"abc\", \"ab\"),\n        (\"hello world\", \"o\"),\n        (\"aaaa\", \"a\"),\n        (\"abcd\", \"d\"),\n    ],\n)\ndef test_mark_positions_element_domain(text, ch):\n    \"\"\"规约后置条件：每个元素要么等于其下标 i，要么等于 -1。\"\"\"\n    result = mark_positions(text, ch)\n    assert all(result[i] == i or result[i] == -1 for i in range(len(result)))\n\n\n@pytest.mark.parametrize(\n    \"text, ch\",\n    [\n        (\"\", \"a\"),\n        (\"a\", \"a\"),\n        (\"ab\", \"a\"),\n        (\"aaa\", \"a\"),\n        (\"abab\", \"a\"),\n        (\"xyz\", \"a\"),\n        (\"abc\", \"\"),\n        (\"abc\", \"ab\"),\n        (\"hello world\", \"o\"),\n        (\"aaaa\", \"a\"),\n        (\"abcd\", \"d\"),\n    ],\n)\ndef test_mark_positions_iff_condition(text, ch):\n    \"\"\"规约后置条件：result[i] == i 当且仅当 text[i] == ch，否则为 -1。\"\"\"\n    result = mark_positions(text, ch)\n    for i in range(len(result)):\n        if text[i] == ch:\n            assert result[i] == i\n        else:\n            assert result[i] == -1\n\n\n# ---------------------------------------------------------------------------\n# 错误 / 类型契约缺失用例（期望值来源不明，探索性断言）\n# ---------------------------------------------------------------------------\n\ndef test_mark_positions_non_str_text():\n    \"\"\"规约前置条件要求 text 为 str；非 str 输入行为未在规约中约定。\n\n    期望值来源不明，需人工确认：此处仅记录实际行为——\n    若抛出异常则接受，若返回列表则校验其长度不变量。\n    \"\"\"\n    try:\n        result = mark_positions(123, \"1\")\n    except Exception:\n        # 规约未约定异常类型，任何异常均视为可接受的实际行为\n        return\n    # 若未抛异常，则按不变量校验（探索性）\n    assert isinstance(result, list)\n\n\ndef test_mark_positions_non_str_ch():\n    \"\"\"规约前置条件要求 ch 为 str；非 str 输入行为未在规约中约定。\n\n    期望值来源不明，需人工确认：此处仅记录实际行为——\n    若抛出异常则接受，若返回列表则校验其长度不变量。\n    \"\"\"\n    try:\n        result = mark_positions(\"abc\", 1)\n    except Exception:\n        # 规约未约定异常类型，任何异常均视为可接受的实际行为\n        return\n    # 若未抛异常，则按不变量校验（探索性）\n    assert isinstance(result, list)\n    assert len(result) == max(len(\"abc\") - 1, 0)",
