          "generated_test": "import math\n\nimport pytest\n\nfrom task_0071 import divide\n\n\n# ---------------------------------------------------------------------------\n# 正常路径：后置条件 result == a / b\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\n    \"a, b, expected\",\n    [\n        (6.0, 3.0, 2.0),\n        (-6.0, 3.0, -2.0),\n        (-6.0, -3.0, 2.0),\n        (0.0, 5.0, 0.0),\n    ],\n)\ndef test_divide_normal_returns_quotient(a, b, expected):\n    \"\"\"规约后置条件：返回值为 a / b 的浮点商。\n\n    期望值来源：规约「后置条件：返回值为 a / b 的浮点商」。\n    \"\"\"\n    result = divide(a, b)\n    assert result == expected\n    assert isinstance(result, float)\n\n\n@pytest.mark.parametrize(\n    \"a, b\",\n    [\n        (6.0, 3.0),\n        (-6.0, 3.0),\n        (-6.0, -3.0),\n        (0.0, 5.0),\n        (1.0, 3.0),\n        (7.5, 2.5),\n        (-1.0, 8.0),\n    ],\n)\ndef test_divide_postcondition_result_equals_a_over_b(a, b):\n    \"\"\"规约后置条件（可执行）：result == a / b。\n\n    期望值来源：SpecExpr「后置（可执行）：result == a / b」。\n    \"\"\"\n    result = divide(a, b)\n    assert result == a / b\n\n\n@pytest.mark.parametrize(\n    \"a, b\",\n    [\n        (6.0, 3.0),\n        (-6.0, 3.0),\n        (-6.0, -3.0),\n        (1.0, 3.0),\n        (7.5, 2.5),\n    ],\n)\ndef test_divide_postcondition_result_times_b_equals_a(a, b):\n    \"\"\"规约后置条件：返回值满足 result * b == a（浮点精度允许范围内）。\n\n    期望值来源：规约「后置条件：返回值满足 result * b == a」。\n    \"\"\"\n    result = divide(a, b)\n    assert math.isclose(result * b, a, rel_tol=1e-9, abs_tol=1e-12)\n\n\n# ---------------------------------------------------------------------------\n# 边界：符号规则\n# ---------------------------------------------------------------------------\n\ndef test_divide_both_negative_returns_positive():\n    \"\"\"边界情况：a、b 均为负数，结果为正。\n\n    期望值来源：规约「边界情况：a、b 均为负数，结果为正」。\n    \"\"\"\n    result = divide(-6.0, -3.0)\n    assert result > 0\n    assert result == 2.0\n\n\ndef test_divide_negative_dividend_positive_divisor_returns_negative():\n    \"\"\"边界情况：a 为负数、b 为正数，结果为负。\n\n    期望值来源：规约「边界情况：a 为负数、b 为正数，结果为负」。\n    \"\"\"\n    result = divide(-6.0, 3.0)\n    assert result < 0\n    assert result == -2.0\n\n\ndef test_divide_zero_dividend_returns_zero():\n    \"\"\"边界情况：a == 0 且 b != 0，结果为 0.0。\n\n    期望值来源：规约「边界情况：a == 0 且 b != 0，结果为 0.0」。\n    \"\"\"\n    result = divide(0.0, 5.0)\n    assert result == 0.0\n    assert isinstance(result, float)\n\n\n# ---------------------------------------------------------------------------\n# 错误路径：b == 0 触发 ZeroDivisionError\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\"b\", [0, 0.0])\ndef test_divide_by_zero_raises_zero_division_error(b):\n    \"\"\"边界情况：b == 0（整数 0 或 0.0）触发 ZeroDivisionError。\n\n    期望值来源：规约「前置条件：b 不为 0（否则触发 ZeroDivisionError）」\n    与「边界情况：b == 0（整数 0 或 0.0）触发 ZeroDivisionError」。\n    \"\"\"\n    with pytest.raises(ZeroDivisionError):\n        divide(1.0, b)\n\n\ndef test_divide_zero_by_zero_raises_zero_division_error():\n    \"\"\"边界情况：0.0 / 0.0 触发 ZeroDivisionError。\n\n    期望值来源：规约「边界情况：b == 0（整数 0 或 0.0）触发 ZeroDivisionError」。\n    \"\"\"\n    with pytest.raises(ZeroDivisionError):\n        divide(0.0, 0.0)\n\n\n# ---------------------------------------------------------------------------\n# 边界：溢出 / 特殊浮点值\n# 规约仅声明「导致溢出为 inf」与「a 或 b 为 inf / nan 的浮点特殊值」，\n# 未给出精确数值约定，故采用记录实际行为的探索性断言。\n# ---------------------------------------------------------------------------\n\ndef test_divide_tiny_divisor_overflow_behavior():\n    \"\"\"边界情况：b 为极小非零值导致结果溢出。\n\n    期望值来源：规约「边界情况：b 为极小非零值导致结果溢出」，\n    但未约定精确数值，故记录实际行为：结果应为 inf 或有限值，\n    需人工确认。此处仅断言不抛异常且为 float。\n    \"\"\"\n    result = divide(1.0, 1e-308)\n    assert isinstance(result, float)\n    # 规约提示可能溢出为 inf；若实现返回有限值也属可接受范围，需人工确认。\n    assert result == float(\"inf\") or math.isfinite(result)\n\n\ndef test_divide_extreme_values_overflow_behavior():\n    \"\"\"边界情况：极大值/极小值（如 1e308 / 1e-308）导致溢出为 inf。\n\n    期望值来源：规约「边界情况：极大值/极小值（如 1e308 / 1e-308）\n    导致溢出为 inf」，未约定精确数值，记录实际行为，需人工确认。\n    \"\"\"\n    result = divide(1e308, 1e-308)\n    assert isinstance(result, float)\n    assert result == float(\"inf\") or math.isfinite(result)\n\n\ndef test_divide_infinite_dividend_behavior():\n    \"\"\"边界情况：a 为 inf 的浮点特殊值。\n\n    期望值来源：规约「边界情况：a 或 b 为 inf / nan 的浮点特殊值」，\n    未约定具体结果，记录实际行为，需人工确认。\n    \"\"\"\n    result = divide(float(\"inf\"), 2.0)\n    assert isinstance(result, float)\n    assert math.isinf(result)\n\n\ndef test_divide_infinite_divisor_behavior():\n    \"\"\"边界情况：b 为 inf 的浮点特殊值。\n\n    期望值来源：规约「边界情况：a 或 b 为 inf / nan 的浮点特殊值」，\n    未约定具体结果，记录实际行为，需人工确认。\n    \"\"\"\n    result = divide(1.0, float(\"inf\"))\n    assert isinstance(result, float)\n    assert result == 0.0\n\n\ndef test_divide_nan_dividend_behavior():\n    \"\"\"边界情况：a 为 nan 的浮点特殊值。\n\n    期望值来源：规约「边界情况：a 或 b 为 inf / nan 的浮点特殊值」，\n    未约定具体结果，记录实际行为，需人工确认。\n    \"\"\"\n    result = divide(float(\"nan\"), 2.0)\n    assert isinstance(result, float)\n    assert math.isnan(result)\n\n\ndef test_divide_nan_divisor_behavior():\n    \"\"\"边界情况：b 为 nan 的浮点特殊值。\n\n    期望值来源：规约「边界情况：a 或 b 为 inf / nan 的浮点特殊值」，\n    未约定具体结果，记录实际行为，需人工确认。\n    \"\"\"\n    result = divide(2.0, float(\"nan\"))\n    assert isinstance(result, float)\n    assert math.isnan(result)",
