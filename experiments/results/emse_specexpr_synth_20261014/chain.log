ue_returns_value():\n    \"\"\"边界：low == high == value，两分支均假，规约要求返回 value。\"\"\"\n    assert clamp(5, 5, 5) == 5\n\n\ndef test_clamp_low_greater_than_high_returns_value():\n    \"\"\"边界：low > high 区间反转，value 既不小于 high 也不大于 low，规约要求返回 value。\"\"\"\n    assert clamp(5, 10, 0) == 5\n\n\n# ---------------------------------------------------------------------------\n# 后置条件：返回值 ∈ {value, low, high}\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\n    \"value, low, high\",\n    [\n        (1, 0, 10),\n        (20, 0, 10),\n        (10, 0, 10),\n        (0, 0, 10),\n        (5, 5, 5),\n        (5, 10, 0),\n        (0, -10, 10),\n        (-5, -10, 10),\n        (9223372036854775807, 0, 10),\n        (-9223372036854775808, 0, 10),\n    ],\n)\ndef test_clamp_result_in_value_low_high(value, low, high):\n    \"\"\"后置条件：返回值必须属于 {value, low, high} 三者之一。\"\"\"\n    result = clamp(value, low, high)\n    assert result in (value, low, high)\n\n\n# ---------------------------------------------------------------------------\n# 异常路径：前置条件要求参数均为 int\n# ---------------------------------------------------------------------------\n\ndef test_clamp_non_int_value_raises_type_error():\n    \"\"\"异常路径：value 为 str 不满足前置条件（int），比较运算应抛 TypeError。\n\n    期望值来源：前置条件要求 int；具体异常类型由 Python 比较语义决定，\n    需人工确认实现是否显式校验类型。\n    \"\"\"\n    with pytest.raises(TypeError):\n        clamp(\"1\", 0, 10)\n\n\ndef test_clamp_none_value_raises_type_error():\n    \"\"\"异常路径：value 为 None 不满足前置条件（int），比较运算应抛 TypeError。\n\n    期望值来源：前置条件要求 int；具体异常类型由 Python 比较语义决定，\n    需人工确认实现是否显式校验类型。\n    \"\"\"\n    with pytest.raises(TypeError):\n        clamp(None, 0, 10)",
