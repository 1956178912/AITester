          "generated_test": "import pytest\n\nfrom task_0024 import first_item\n\n\n@pytest.fixture\ndef restore_global_list():\n    \"\"\"保存并恢复被测模块的全局 list，避免测试间相互污染。\"\"\"\n    import task_0024\n\n    original = getattr(task_0024, \"list\", None)\n    had_attr = hasattr(task_0024, \"list\")\n    yield task_0024\n    if had_attr:\n        task_0024.list = original\n    else:\n        try:\n            del task_0024.list\n        except AttributeError:\n            pass\n\n\ndef test_first_item_returns_first_element_of_default_list(restore_global_list):\n    \"\"\"规约：全局 list 非空时返回其第一个元素。\n\n    期望值来源：规约前置条件（全局 list 已定义且非空）与后置条件\n    （返回 list 的第一个元素）。此处显式设置全局 list 为已知值，\n    断言返回值等于该列表首元素。\n    \"\"\"\n    module = restore_global_list\n    module.list = [\"a\", \"b\", \"c\"]\n    assert first_item() == \"a\"\n\n\ndef test_first_item_does_not_modify_global_list(restore_global_list):\n    \"\"\"规约：返回首元素且不修改 list（不变量）。\n\n    期望值来源：规约后置条件“不修改 list”。调用前后比较全局 list 的内容。\n    \"\"\"\n    module = restore_global_list\n    module.list = [\"a\", \"b\", \"c\"]\n    snapshot = list(module.list)\n    first_item()\n    assert module.list == snapshot\n\n\ndef test_first_item_single_element_list(restore_global_list):\n    \"\"\"规约边界：list 只有一个元素时返回该唯一元素。\n\n    期望值来源：规约边界情况“list 只有一个元素”，返回其第一个（唯一）元素。\n    \"\"\"\n    module = restore_global_list\n    module.list = [\"x\"]\n    assert first_item() == \"x\"\n\n\ndef test_first_item_empty_list_raises_index_error(restore_global_list):\n    \"\"\"规约边界：list 为空时触发 IndexError。\n\n    期望值来源：规约边界情况“list 为空时触发 IndexError”。\n    具体异常信息未知，仅断言异常类型。\n    \"\"\"\n    module = restore_global_list\n    module.list = []\n    with pytest.raises(IndexError):\n        first_item()\n\n\ndef test_first_item_non_sequence_global_list(restore_global_list):\n    \"\"\"规约边界：list 被重新赋值为非序列类型时的行为。\n\n    期望值来源不明，需人工确认：规约仅声明“list 被重新赋值为非序列类型”\n    为边界情况，未规定具体异常类型或返回值。此处记录实际行为，\n    仅断言调用可被观测（返回或抛出异常），不做具体值臆测。\n    \"\"\"\n    module = restore_global_list\n    module.list = 12345\n    try:\n        result = first_item()\n    except Exception as exc:  # noqa: BLE001 - 记录实际行为\n        assert exc is not None\n    else:\n        # 非序列类型若未抛异常，则记录其实际返回值，供人工确认。\n        assert result is not None or result is None",
