  s = \"hi\"\n    n = 10\n    result = first_n_chars(s, n)\n    assert result == s[: n - 1]\n    assert result == \"h\"\n\n\ndef test_first_n_chars_empty_string_input():\n    \"\"\"边界 s 为空字符串：切片结果仍为空字符串。\n\n    期望值来源：后置条件 \"n > 0 时返回 s[:n-1]\"，空串切片为空。\n    \"\"\"\n    result = first_n_chars(\"\", 5)\n    assert result == \"\"\n    assert result == \"\"[: 5 - 1]\n\n\ndef test_first_n_chars_huge_n():\n    \"\"\"边界 n 为极大整数：切片返回整个字符串（去掉末尾一个字符）。\n\n    期望值来源：后置条件 \"n > 0 时返回 s[:n-1]\"。\n    \"\"\"\n    s = \"abc\"\n    n = 1000000000\n    result = first_n_chars(s, n)\n    assert result == s[: n - 1]\n    assert result == \"ab\"\n\n\n# ---------------------------------------------------------------------------\n# 不变量\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\n    \"s, n\",\n    [\n        (\"hello\", 4),\n        (\"hello\", 1),\n        (\"hello\", 0),\n        (\"hello\", -3),\n        (\"hi\", 10),\n        (\"\", 5),\n        (\"abc\", 1000000000),\n    ],\n)\ndef test_first_n_chars_invariant_length_bound(s, n):\n    \"\"\"不变量：len(result) <= max(0, n - 1)。\n\n    期望值来源：可执行不变量子句 \"len(result) <= max(0, n - 1)\"。\n    \"\"\"\n    result = first_n_chars(s, n)\n    assert len(result) <= max(0, n - 1)\n\n\n# ---------------------------------------------------------------------------\n# 前置条件违反（错误路径）\n# ---------------------------------------------------------------------------\n\ndef test_first_n_chars_n_is_str_raises():\n    \"\"\"前置条件违反：n 为 str 类型。\n\n    规约要求 n 为 int；传入 str 时行为未在规约中定义，\n    期望值来源不明，需人工确认。此处仅记录实际行为：\n    若抛出异常则接受，否则记录返回值。\n    \"\"\"\n    try:\n        result = first_n_chars(\"hello\", \"3\")\n    except (TypeError, ValueError):\n        # 前置条件被违反，抛出异常是可接受的行为\n        return\n    # 未抛异常：记录实际行为，需人工确认是否符合预期\n    assert isinstance(result, str)\n\n\ndef test_first_n_chars_s_is_none_raises():\n    \"\"\"前置条件违反：s 为 None。\n\n    规约要求 s 为 str；传入 None 时行为未在规约中定义，\n    期望值来源不明，需人工确认。此处仅记录实际行为：\n    若