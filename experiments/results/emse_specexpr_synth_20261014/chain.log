a\",\n    ],\n)\ndef test_initials_returns_str(full_name):\n    \"\"\"后置条件：返回值类型为 str。\n\n    期望值来源：规约后置条件「返回值为字符串」。\n    \"\"\"\n    assert isinstance(initials(full_name), str)\n\n\n@pytest.mark.parametrize(\n    \"full_name\",\n    [\n        \"john doe smith\",\n        \"  john doe  \",\n        \"john   doe\",\n        \"josé maría\",\n    ],\n)\ndef test_initials_result_contains_no_whitespace(full_name):\n    \"\"\"后置条件：返回字符串中不包含原始空白字符。\n\n    期望值来源：规约后置条件「返回字符串中不包含原始空白字符」。\n    \"\"\"\n    result = initials(full_name)\n    assert not any(ch.isspace() for ch in result)\n\n\n@pytest.mark.parametrize(\n    \"full_name, expected\",\n    [\n        (\"john doe smith\", \"J.D.S\"),\n        (\"alice\", \"A\"),\n        (\"  john doe  \", \"J.D\"),\n        (\"john   doe\", \"J.D\"),\n        (\"josé maría\", \"J.M\"),\n    ],\n)\ndef test_initials_each_part_first_char_uppercased(full_name, expected):\n    \"\"\"后置条件：每个部分仅保留首字符并转为大写，以 '.' 连接。\n\n    期望值来源：规约后置条件 + 描述「用点号连接」。\n    \"\"\"\n    assert initials(full_name) == expected\n\n\n# ---------------------------------------------------------------------------\n# 异常路径\n# ---------------------------------------------------------------------------\n\ndef test_initials_none_raises():\n    \"\"\"None 输入：规约声明会触发 AttributeError。\n\n    期望值来源：规约边界情况「full_name 为 None（会触发 AttributeError）」。\n    \"\"\"\n    with pytest.raises(AttributeError):\n        initials(None)",
