eption as exc:  # noqa: BLE001\n        # 若实现选择抛异常，记录异常类型，不臆造具体异常类\n        assert isinstance(exc, Exception)\n    else:\n        # 若实现未抛异常，仅记录返回值类型，不做具体值断言\n        assert result is not None or result is None",
