          "generated_test": "import pytest\n\nfrom task_0052 import normalize, aggregate, report\n\n\nclass TestNormalize:\n    \"\"\"Tests for normalize function.\"\"\"\n\n    def test_normalize_empty_list(self):\n        \"\"\"normalize([]) should return [].\"\"\"\n        assert normalize([]) == []\n\n    def test_normalize_single_element(self):\n        \"\"\"normalize([1]) should return [2].\"\"\"\n        assert normalize([1]) == [2]\n\n    def test_normalize_multiple_elements(self):\n        \"\"\"normalize([1, 2, 3]) should return [2, 4, 6].\"\"\"\n        assert normalize([1, 2, 3]) == [2, 4, 6]\n\n    def test_normalize_negative_numbers(self):\n        \"\"\"normalize([-1, -2]) should return [-2, -4].\"\"\"\n        assert normalize([-1, -2]) == [-2, -4]\n\n    def test_normalize_zero(self):\n        \"\"\"normalize([0]) should return [0].\"\"\"\n        assert normalize([0]) == [0]\n\n    def test_normalize_returns_new_list(self):\n        \"\"\"normalize should not mutate the input list.\"\"\"\n        data = [1, 2, 3]\n        result = normalize(data)\n        assert data == [1, 2, 3]\n        assert result is not data\n\n\nclass TestAggregate:\n    \"\"\"Tests for aggregate function.\"\"\"\n\n    def test_aggregate_empty_list(self):\n        \"\"\"aggregate([]) should return {'count': 0, 'total': 0}.\"\"\"\n        assert aggregate([]) == {\"count\": 0, \"total\": 0}\n\n    def test_aggregate_single_element(self):\n        \"\"\"aggregate([5]) should return {'count': 1, 'total': 5}.\"\"\"\n        assert aggregate([5]) == {\"count\": 1, \"total\": 5}\n\n    def test_aggregate_multiple_elements(self):\n        \"\"\"aggregate([1, 2, 3]) should return {'count': 3, 'total': 6}.\"\"\"\n        assert aggregate([1, 2, 3]) == {\"count\": 3, \"total\": 6}\n\n    def test_aggregate_negative_numbers(self):\n        \"\"\"aggregate([-1, -2, -3]) should return {'count': 3, 'total': -6}.\"\"\"\n        assert aggregate([-1, -2, -3]) == {\"count\": 3, \"total\": -6}\n\n    def test_aggregate_mixed_numbers(self):\n        \"\"\"aggregate([-1, 1]) should return {'count': 2, 'total': 0}.\"\"\"\n        assert aggregate([-1, 1]) == {\"count\": 2, \"total\": 0}\n\n    def test_aggregate_returns_dict(self):\n        \"\"\"aggregate should return a dict.\"\"\"\n        result = aggregate([1, 2])\n        assert isinstance(result, dict)\n\n\nclass TestReport:\n    \"\"\"Tests for report function.\"\"\"\n\n    def test_report_empty_list(self):\n        \"\"\"report([]) should return 'count=0 total=0'.\"\"\"\n        assert report([]) == \"count=0 total=0\"\n\n    def test_report_single_element(self):\n        \"\"\"report([1]) normalizes to [2], so count=1 total=2.\"\"\"\n        assert report([1]) == \"count=1 total=2\"\n\n    def test_report_multiple_elements(self):\n        \"\"\"report([1, 2, 3]) normalizes to [2, 4, 6], so count=3 total=12.\"\"\"\n        assert report([1, 2, 3]) == \"count=3 total=12\"\n\n    def test_report_negative_numbers(self):\n        \"\"\"report([-1, -2]) normalizes to [-2, -4], so count=2 total=-6.\"\"\"\n        assert report([-1, -2]) == \"count=2 total=-6\"\n\n    def test_report_zero(self):\n        \"\"\"report([0]) normalizes to [0], so count=1 total=0.\"\"\"\n        assert report([0]) == \"count=1 total=0\"\n\n    def test_report_returns_str(self):\n        \"\"\"report should return a string.\"\"\"\n        result = report([1, 2])\n        assert isinstance(result, str)\n\n    def test_report_uses_normalize_and_aggregate(self):\n        \"\"\"report output should be consistent with normalize + aggregate composition.\"\"\"\n        data = [3, 4, 5]\n        normalized = normalize(data)\n        stats = aggregate(normalized)\n        expected = \"count={0} total={1}\".format(stats[\"count\"], stats[\"total\"])\n        assert report(data) == expected",
