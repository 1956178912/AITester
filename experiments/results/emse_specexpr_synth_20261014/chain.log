          "generated_test": "import math\n\nimport pytest\n\nfrom task_0086 import divide\n\n\nclass TestDivideNormal:\n    \"\"\"正常路径：b != 0 时返回 a / b 的浮点商。\"\"\"\n\n    def test_divide_normal_exact_quotient(self):\n        \"\"\"规约后置：result == a / b。6.0 / 3.0 应为 2.0。\"\"\"\n        result = divide(6.0, 3.0)\n        assert result == 6.0 / 3.0\n        assert result == 2.0\n\n    def test_divide_normal_fractional_quotient(self):\n        \"\"\"规约后置：result == a / b。7.0 / 2.0 应为 3.5。\"\"\"\n        result = divide(7.0, 2.0)\n        assert result == 7.0 / 2.0\n        assert result == 3.5\n\n    def test_divide_normal_returns_float_type(self):\n        \"\"\"规约后置：返回值为浮点商，类型应为 float。\"\"\"\n        result = divide(6.0, 3.0)\n        assert isinstance(result, float)\n\n    def test_divide_normal_postcondition_product(self):\n        \"\"\"规约后置：满足 result * b == a（浮点精度允许范围内）。\"\"\"\n        a, b = 7.0, 2.0\n        result = divide(a, b)\n        assert math.isclose(result * b, a, rel_tol=1e-9, abs_tol=1e-12)\n\n\nclass TestDivideBoundary:\n    \"\"\"边界路径：a == 0、负数入参等。\"\"\"\n\n    def test_divide_boundary_zero_dividend(self):\n        \"\"\"规约边界：a == 0 且 b != 0 时结果为 0.0。\"\"\"\n        result = divide(0.0, 5.0)\n        assert result == 0.0\n        assert result == 0.0 / 5.0\n\n    def test_divide_boundary_negative_dividend(self):\n        \"\"\"规约边界：a < 0 时符号处理正确，-6.0 / 3.0 应为 -2.0。\"\"\"\n        result = divide(-6.0, 3.0)\n        assert result == -6.0 / 3.0\n        assert result == -2.0\n\n    def test_divide_boundary_negative_divisor(self):\n        \"\"\"规约边界：b < 0 时符号处理正确，6.0 / -3.0 应为 -2.0。\"\"\"\n        result = divide(6.0, -3.0)\n        assert result == 6.0 / -3.0\n        assert result == -2.0\n\n    def test_divide_boundary_both_negative(self):\n        \"\"\"规约边界：a < 0 且 b < 0 时结果为正，-6.0 / -3.0 应为 2.0。\"\"\"\n        result = divide(-6.0, -3.0)\n        assert result == -6.0 / -3.0\n        assert result == 2.0\n\n    def test_divide_boundary_negative_postcondition_product(self):\n        \"\"\"规约后置：负数入参下仍满足 result * b == a（精度允许范围内）。\"\"\"\n        a, b = -7.0, 2.0\n        result = divide(a, b)\n        assert math.isclose(result * b, a, rel_tol=1e-9, abs_tol=1e-12)\n\n\nclass TestDivideError:\n    \"\"\"异常路径：b == 0 时按 Python 语义抛 ZeroDivisionError。\"\"\"\n\n    def test_divide_error_divisor_zero(self):\n        \"\"\"规约边界：b == 0 抛 ZeroDivisionError。\"\"\"\n        with pytest.raises(ZeroDivisionError):\n            divide(1.0, 0.0)\n\n    def test_divide_error_zero_divided_by_zero(self):\n        \"\"\"规约边界：a == 0 且 b == 0 抛 ZeroDivisionError。\"\"\"\n        with pytest.raises(ZeroDivisionError):\n            divide(0.0, 0.0)\n\n    def test_divide_error_negative_dividend_divisor_zero(self):\n        \"\"\"规约边界：b == 0 时无论 a 取值均抛 ZeroDivisionError。\"\"\"\n        with pytest.raises(ZeroDivisionError):\n            divide(-1.0, 0.0)\n\n\nclass TestDivideOverflowExploratory:\n    \"\"\"极大/极小值边界：规约未声明具体行为，仅记录实际行为，需人工确认。\"\"\"\n\n    def test_divide_overflow_extreme_values_behavior(self):\n        \"\"\"期望值来源不明，需人工确认。\n\n        规约仅列出\"极大/极小值导致上溢或下溢（如 1e308 / 1e-308）\"，\n        未声明应抛 OverflowError 还是返回 inf。此处记录实际行为：\n        若抛 OverflowError 则通过；若返回 float（如 inf）则断言其为 float。\n        \"\"\"\n        try:\n            result = divide(1e308, 1e-308)\n        except OverflowError:\n            # 记录：实现选择抛出 OverflowError，符合\"上溢\"描述\n            return\n        assert isinstance(result, float)\n\n    def test_divide_underflow_extreme_values_behavior(self):\n        \"\"\"期望值来源不明，需人工确认。\n\n        规约列出\"下溢\"边界但未声明具体返回值。此处记录实际行为：\n        1e-308 / 1e308 结果应为 float（可能为 0.0 或次正规数）。\n        \"\"\"\n        result = divide(1e-308, 1e308)\n        assert isinstance(result, float)\n        assert result == 1e-308 / 1e308",
