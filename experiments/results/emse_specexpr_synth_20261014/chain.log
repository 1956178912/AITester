          "rag_stats": null,
          "patch": "python\ndef binary_search(arr: list, target: int) -> int:\n    left, right = 0, len(arr) - 1\n    while left <= right:\n        mid = (left + right) // 2\n        if arr[mid] == target:\n            return mid\n        elif arr[mid] < target:\n            left = mid + 1\n        else:\n            right = mid - 1\n    return -1\n# noise_seed=7652\n",
          "generated_test": "import pytest\n\nfrom task_0028 import binary_search\n\n\n# ---------------------------------------------------------------------------\n# 正常路径（normal）\n# ---------------------------------------------------------------------------\n\ndef test_binary_search_hit_middle_element():\n    \"\"\"命中中间元素：arr=[1,3,5,7,9], target=5 -> 索引 2。\n\n    期望值来源：规约后置条件「若返回 i >= 0，则 arr[i] == target」，\n    且 5 在升序列表中唯一，索引确定为 2。\n    \"\"\"\n    arr = [1, 3, 5, 7, 9]\n    result = binary_search(arr, 5)\n    assert result == 2\n    assert arr[result] == 5\n\n\ndef test_binary_search_hit_first_element():\n    \"\"\"命中首元素：arr=[1,3,5,7,9], target=1 -> 索引 0。\n\n    期望值来源：规约后置条件 + 元素唯一性。\n    \"\"\"\n    arr = [1, 3, 5, 7, 9]\n    result = binary_search(arr, 1)\n    assert result == 0\n    assert arr[result] == 1\n\n\ndef test_binary_search_hit_last_element():\n    \"\"\"命中末元素：arr=[1,3,5,7,9], target=9 -> 索引 4。\n\n    期望值来源：规约后置条件 + 元素唯一性。\n    \"\"\"\n    arr = [1, 3, 5, 7, 9]\n    result = binary_search(arr, 9)\n    assert result == 4\n    assert arr[result] == 9\n\n\ndef test_binary_search_target_between_elements_not_found():\n    \"\"\"目标不存在于两元素之间：arr=[1,3,5,7,9], target=4 -> -1。\n\n    期望值来源：规约「未找到返回 -1」。\n    \"\"\"\n    arr = [1, 3, 5, 7, 9]\n    assert binary_search(arr, 4) == -1\n\n\n# ---------------------------------------------------------------------------\n# 边界情况（boundary）\n# ---------------------------------------------------------------------------\n\ndef test_binary_search_empty_list():\n    \"\"\"空列表：arr=[], target=1 -> -1。\n\n    期望值来源：规约边界情况「空列表 arr=[]」+ 未找到返回 -1。\n    \"\"\"\n    assert binary_search([], 1) == -1\n\n\ndef test_binary_search_single_element_hit():\n    \"\"\"单元素列表命中：arr=[5], target=5 -> 索引 0。\n\n    期望值来源：规约边界情况「单元素列表命中」+ 后置条件。\n    \"\"\"\n    arr = [5]\n    result = binary_search(arr, 5)\n    assert result == 0\n    assert arr[result] == 5\n\n\ndef test_binary_search_single_element_miss():\n    \"\"\"单元素列表未命中：arr=[5], target=3 -> -1。\n\n    期望值来源：规约边界情况「单元素列表未命中」+ 未找到返回 -1。\n    \"\"\"\n    assert binary_search([5], 3) == -1\n\n\ndef test_binary_search_target_less_than_all_elements():\n    \"\"\"target 小于所有元素：arr=[10,20,30], target=0 -> -1。\n\n    期望值来源：规约边界情况「target 小于所有元素」+ 未找到返回 -1。\n    \"\"\"\n    assert binary_search([10, 20, 30], 0) == -1\n\n\ndef test_binary_search_target_greater_than_all_elements():\n    \"\"\"target 大于所有元素：arr=[10,20,30], target=100 -> -1。\n\n    期望值来源：规约边界情况「target 大于所有元素」+ 未找到返回 -1。\n    \"\"\"\n    assert binary_search([10, 20, 30], 100) == -1\n\n\ndef test_binary_search_negative_target_not_found():\n    \"\"\"负数 target 未命中：arr=[-5,-3,-1], target=-4 -> -1。\n\n    期望值来源：规约「未找到返回 -1」。\n    \"\"\"\n    assert binary_search([-5, -3, -1], -4) == -1\n\n\ndef test_binary_search_negative_target_hit():\n    \"\"\"负数 target 命中：arr=[-5,-3,-1], target=-3 -> 索引 1。\n\n    期望值来源：规约后置条件 + 元素唯一性。\n    \"\"\"\n    arr = [-5, -3, -1]\n    result = binary_search(arr, -3)\n    assert result == 1\n    assert arr[result] == -3\n\n\ndef test_binary_search_zero_target_not_found():\n    \"\"\"target=0 未命中：arr=[1,2,3], target=0 -> -1。\n\n    期望值来源：规约「未找到返回 -1」。\n    \"\"\"\n    assert binary_search([1, 2, 3], 0) == -1\n\n\ndef test_binary_search_duplicate_elements_returns_matching_index():\n    \"\"\"重复元素命中：arr=[2,2,2,2], target=2。\n\n    期望值来源：规约边界情况「重复元素（返回任一匹配索引，具体索引取决于\n    mid 计算）」。规约未约定具体返回哪个索引，故只断言后置条件：\n    返回值 ∈ [-1, len(arr)-1] 且 arr[result] == target。\n    期望值来源不明（具体索引），需人工确认。\n    \"\"\"\n    arr = [2, 2, 2, 2]\n    result = binary_search(arr, 2)\n    assert -1 <= result <= len(arr) - 1\n    assert result != -1\n    assert arr[result] == 2\n\n\n# ---------------------------------------------------------------------------\n# 后置条件 / 不变量（property-based 风格，覆盖多种合法输入）\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\n    \"arr, target\",\n    [\n        ([1, 3, 5, 7, 9], 5),\n        ([1, 3, 5, 7, 9], 1),\n        ([1, 3,