          "generated_test": "import sys\n\nimport pytest\n\nfrom task_0010 import factorial\n\n\n# ---------------------------------------------------------------------------\n# 正常 / 边界用例：期望值来自规约（n==0 -> 1；n>0 -> n * factorial(n-1)）\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\n    \"n, expected\",\n    [\n        (0, 1),          # 规约：n == 0 时返回 1（递归基例）\n        (1, 1),          # 规约：n > 0 时 n * factorial(n-1) = 1 * 1\n        (2, 2),          # 规约推导：2 * 1\n        (3, 6),          # 规约推导：3 * 2 * 1\n        (5, 120),        # 规约推导：5 * 4 * 3 * 2 * 1\n        (10, 3628800),   # 规约推导：10!\n    ],\n)\ndef test_factorial_returns_expected_value(n, expected):\n    \"\"\"规约后置条件：n==0 返回 1；n>0 返回 n * factorial(n-1)。\n\n    期望值来源：自然语言规约与递归定义推导，非实现代码。\n    \"\"\"\n    assert factorial(n) == expected\n\n\n@pytest.mark.parametrize(\"n\", [0, 1, 2, 3, 5, 10])\ndef test_factorial_return_type_is_int(n):\n    \"\"\"规约后置条件：返回值类型为 int（isinstance(result, int)）。\"\"\"\n    result = factorial(n)\n    assert isinstance(result, int)\n\n\n@pytest.mark.parametrize(\"n\", [0, 1, 2, 3, 5, 10])\ndef test_factorial_result_at_least_one(n):\n    \"\"\"规约后置条件：result >= 1（对满足前件的 n >= 0 成立）。\"\"\"\n    result = factorial(n)\n    assert result >= 1\n\n\ndef test_factorial_zero_is_base_case():\n    \"\"\"规约边界：n == 0 为递归基例，必须返回 1。\"\"\"\n    assert factorial(0) == 1\n\n\ndef test_factorial_one_minimal_recursion():\n    \"\"\"规约边界：n == 1 为最小递归情形，返回 1 * factorial(0) == 1。\"\"\"\n    assert factorial(1) == 1\n\n\ndef test_factorial_recursive_relation_holds():\n    \"\"\"规约后置条件：n > 0 时 result == n * factorial(n-1)。\n\n    通过比较相邻两次调用验证递归关系，期望值来自规约而非实现。\n    \"\"\"\n    for n in range(1, 8):\n        assert factorial(n) == n * factorial(n - 1)\n\n\n# ---------------------------------------------------------------------------\n# 错误 / 未定义行为用例\n# ---------------------------------------------------------------------------\n\ndef test_factorial_negative