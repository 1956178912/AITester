int)\n    assert result < -700000\n\n\ndef test_days_until_max_date_overflow():\n    \"\"\"datetime 可表示的最大日期应返回极大正数。\n\n    期望值来源：规约边界情况「target 为未来极远日期（如 '9999-12-31'）：\n    返回极大正数」。具体数值随运行时刻变化，故仅断言上界。\n    \"\"\"\n    result = days_until(\"9999-12-31\")\n    assert isinstance(result, int)\n    assert result > 2000000\n\n\n@pytest.mark.parametrize(\n    \"bad_target\",\n    [\"not-a-date\", \"2024/01/01\", \"2024-13-01\", \"\"],\n)\ndef test_days_until_invalid_format_falls_back_to_min(bad_target):\n    \"\"\"非法格式字符串应走 except 分支，返回 datetime.min 差值（极大负数）。\n\n    期望值来源：规约边界情况「target 为非法格式（如 'not-a-date'、\n    '2024/01/01'、'2024-13-01'、空字符串）：走 except 分支返回\n    datetime.min 差值」。具体数值随运行时刻变化，故仅断言下界。\n    \"\"\"\n    result = days_until(bad_target)\n    assert isinstance(result, int)\n    assert result < -700000\n\n\ndef test_days_until_none_raises_type_error():\n    \"\"\"None 传入应抛 TypeError，不被 except ValueError 捕获而向上传播。\n\n    期望值来源：规约边界情况「target 为 None 或非字符串：strptime 抛\n    TypeError，不被 except ValueError 捕获，会向上传播」。\n    \"\"\"\n    with pytest.raises(TypeError):\n        days_until(None)\n\n\ndef test_days_until_non_string_raises_type_error():\n    \"\"\"非字符串（如 int）传入应抛 TypeError 并向上传播。\n\n    期望值来源：规约边界情况「target 为 None 或非字符串：strptime 抛\n    TypeError，不被 except ValueError 捕获，会向上传播」。\n    \"\"\"\n    with pytest.raises(TypeError):\n        days_until(20240101)",
