          "generated_test": "import pytest\n\nfrom task_0044 import first_item\n\n\n@pytest.fixture\ndef restore_global_list():\n    \"\"\"保存并恢复被测模块的全局 list，避免测试间相互污染。\"\"\"\n    import task_0044\n\n    original = getattr(task_0044, \"list\", None)\n    had_attr = hasattr(task_0044, \"list\")\n    yield task_0044\n    if had_attr:\n        task_0044.list = original\n    else:\n        try:\n            del task_0044.list\n        except AttributeError:\n            pass\n\n\ndef test_first_item_returns_first_element(restore_global_list):\n    \"\"\"规约：全局 list 非空时返回其第一个元素。\"\"\"\n    module = restore_global_list\n    module.list = [\"a\", \"b\", \"c\"]\n    assert first_item() == \"a\"\n\n\ndef test_first_item_does_not_modify_list(restore_global_list):\n    \"\"\"规约：返回首元素且不修改全局 list。\"\"\"\n    module = restore_global_list\n    module.list = [\"a\", \"b\", \"c\"]\n    snapshot = list(module.list)\n    result = first_item()\n    assert result == \"a\"\n    assert module.list == snapshot\n\n\ndef test_first_item_single_element_list(restore_global_list):\n    \"\"\"边界：全局 list 仅含一个元素时返回该元素。\"\"\"\n    module = restore_global_list\n    module.list = [\"x\"]\n    assert first_item() == \"x\"\n\n\ndef test_first_item_empty_list_raises_index_error(restore_global_list):\n    \"\"\"边界：全局 list 为空时触发 IndexError。\n\n    期望值来源：规约明确约定空列表触发 IndexError；\n    具体异常消息未在规约中约定，故不校验消息内容。\n    \"\"\"\n    module = restore_global_list\n    module.list = []\n    with pytest.raises(IndexError):\n        first_item()\n\n\ndef test_first_item_reflects_modified_list(restore_global_list):\n    \"\"\"边界：全局 list 被修改后，返回值应反映新的首元素。\"\"\"\n    module = restore_global_list\n    module.list = [\"a\", \"b\", \"c\"]\n    assert first_item() == \"a\"\n    module.list = [\"z\", \"b\", \"c\"]\n    assert first_item() == \"z\"\n\n\ndef test_first_item_non_list_object_behavior(restore_global_list):\n    \"\"\"边界：全局 list 被重新赋值为非列表对象时的行为。\n\n    期望值来源不明，需人工确认：规约仅列出该边界情况，\n    未约定应抛出何种异常或返回何值，故此处仅记录实际行为。\n    \"\"