          "generated_test": "import pytest\n\nfrom task_0062 import normalize, aggregate, report\n\n\n# ---------------------------------------------------------------------------\n# normalize\n# ---------------------------------------------------------------------------\n\ndef test_normalize_doubles_each_element():\n    \"\"\"normalize 应将列表中每个元素乘以 2（依据源码实现）。\"\"\"\n    assert normalize([1, 2, 3]) == [2, 4, 6]\n\n\ndef test_normalize_empty_list_returns_empty_list():\n    \"\"\"normalize 对空列表应返回空列表（依据源码实现）。\"\"\"\n    assert normalize([]) == []\n\n\ndef test_normalize_negative_and_zero_values():\n    \"\"\"normalize 对负数与 0 应同样乘以 2（依据源码实现）。\"\"\"\n    assert normalize([0, -1, -5]) == [0, -2, -10]\n\n\ndef test_normalize_returns_new_list():\n    \"\"\"normalize 应返回新列表，不修改输入（依据源码实现）。\"\"\"\n    original = [1, 2, 3]\n    result = normalize(original)\n    assert result == [2, 4, 6]\n    assert original == [1, 2, 3]\n    assert result is not original\n\n\n# ---------------------------------------------------------------------------\n# aggregate\n# ---------------------------------------------------------------------------\n\ndef test_aggregate_empty_list_returns_zero_stats():\n    \"\"\"aggregate 对空列表应返回 count=0, total=0（依据源码实现）。\"\"\"\n    assert aggregate([]) == {\"count\": 0, \"total\": 0}\n\n\ndef test_aggregate_single_element():\n    \"\"\"aggregate 对单元素列表应返回 count=1 与对应 total（依据源码实现）。\"\"\"\n    assert aggregate([5]) == {\"count\": 1, \"total\": 5}\n\n\ndef test_aggregate_multiple_elements():\n    \"\"\"aggregate 应返回元素个数与元素之和（依据源码实现）。\"\"\"\n    assert aggregate([1, 2, 3, 4]) == {\"count\": 4, \"total\": 10}\n\n\ndef test_aggregate_negative_values():\n    \"\"\"aggregate 对含负数的列表应正确求和（依据源码实现）。\"\"\"\n    assert aggregate([-1, -2, 3]) == {\"count\": 3, \"total\": 0}\n\n\ndef test_aggregate_returns_dict_with_expected_keys():\n    \"\"\"aggregate 返回值应包含 count 与 total 两个键（依据源码实现）。\"\"\"\n    result = aggregate([1, 2])\n    assert set(result.keys()) == {\"count\", \"total\"}\n\n\n# ---------------------------------------------------------------------------\n# report\n# ---------------------------------------------------------------------------\n\ndef test_report_empty_list():\n    \"\"\"report 对空列表应输出 count=0 total=0（依据源码实现）。\"\"\"\n    assert report([]) == \"count=0 total=0\"\n\n\ndef test_report_single_element():\n    \"\"\"report 对 [1] 应输出 count=1 total=2（normalize 后为 [2]）。\"\"\"\n    assert report([1]) == \"count=1 total=2\"\n\n\ndef test_report_multiple_elements():\n    \"\"\"report 对 [1, 2, 3] 应输出 count=3 total=12（normalize 后为 [2,4,6]）。\"\"\"\n    assert report([1, 2, 3]) == \"count=3 total=12\"\n\n\ndef test_report_uses_normalized_values():\n    \"\"\"report 的 total 应基于 normalize 后的数据（依据源码实现）。\"\"\"\n    data = [10, 20]\n    normalized = normalize(data)\n    stats = aggregate(normalized)\n    expected = \"count={0} total={1}\".format(stats[\"count\"], stats[\"total\"])\n    assert report(data) == expected\n\n\ndef test_report_returns_string():\n    \"\"\"report 应返回字符串类型（依据源码实现）。\"\"\"\n    assert isinstance(report([1, 2]), str)",
