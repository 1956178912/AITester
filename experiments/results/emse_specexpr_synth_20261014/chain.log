          "generated_test": "import pytest\n\nfrom task_0084 import distance\n\n\n# ---------------------------------------------------------------------------\n# 正常用例：后置条件 result == a - b 与 isinstance(result, int)\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\n    \"a, b, expected\",\n    [\n        (5, 3, 2),\n        (10, 4, 6),\n        (3, 10, -7),\n    ],\n)\ndef test_distance_normal_returns_difference(a, b, expected):\n    \"\"\"正常用例：返回值应等于 a - b（后置条件 result == a - b）。\"\"\"\n    result = distance(a, b)\n    assert result == expected\n    assert result == a - b\n\n\n@pytest.mark.parametrize(\n    \"a, b\",\n    [\n        (5, 3),\n        (10, 4),\n        (3, 10),\n        (0, 0),\n        (-5, -3),\n    ],\n)\ndef test_distance_returns_int_type(a, b):\n    \"\"\"后置条件：返回值类型必须为 int。\"\"\"\n    result = distance(a, b)\n    assert isinstance(result, int)\n\n\n# ---------------------------------------------------------------------------\n# 边界用例\n# ---------------------------------------------------------------------------\n\ndef test_distance_equal_operands_returns_zero():\n    \"\"\"边界：a == b 时结果应为 0（规约边界情况）。\"\"\"\n    assert distance(7, 7) == 0\n\n\ndef test_distance_a_is_zero():\n    \"\"\"边界：a 为 0 时结果应为 -b（规约边界情况）。\"\"\"\n    assert distance(0, 5) == -5\n\n\ndef test_distance_b_is_zero():\n    \"\"\"边界：b 为 0 时结果应为 a（规约边界情况）。\"\"\"\n    assert distance(5, 0) == 5\n\n\ndef test_distance_a_is_negative():\n    \"\"\"边界：a 为负数时的结果（规约边界情况）。\"\"\"\n    assert distance(-5, 3) == -8\n\n\ndef test_distance_b_is_negative():\n    \"\"\"边界：b 为负数时等价于 a + |b|（规约边界情况）。\"\"\"\n    assert distance(5, -3) == 8\n\n\ndef test_distance_both_negative():\n    \"\"\"边界：a、b 均为负数时的结果（规约边界情况）。\"\"\"\n    assert distance(-5, -3) == -2\n\n\ndef test_distance_opposite_signs():\n    \"\"\"边界：a 与 b 符号相反时的结果（规约边界情况）。\"\"\"\n    assert distance(-5, 5) == -10\n    assert distance(5, -5) == 10\n\n\ndef test_distance_large_positive_overflow_boundary():\n    \"\"\"边界：a 为极大整数（64 位有符号上界），Python 任意精度无溢出。\"\"\"\n    a = 9223372036854775807\n    b = -9223372036854775808\n    result = distance(a, b)\n    assert result == a - b\n    assert result == 18446744073709551615\n\n\ndef test_distance_large_negative_underflow_boundary():\n    \"\"\"边界：a 为极小整数（64 位有符号下界），Python 任意精度无溢出。\"\"\"\n    a = -9223372036854775808\n    b = 9223372036854775807\n    result = distance(a, b)\n    assert result == a - b\n    assert result == -18446744073709551615\n\n\ndef test_distance_b_is_large_integer():\n    \"\"\"边界：b 为极大整数时的结果。\"\"\"\n    b = 9223372036854775807\n    a = 0\n    result = distance(a, b)\n    assert result == a - b\n    assert result == -9223372036854775807\n\n\n# ---------------------------------------------------------------------------\n# 错误用例：前置条件被违反（非 int 输入）\n# 规约未约定具体异常信息，仅断言抛出 TypeError。\n# ---------------------------------------------------------------------------\n\ndef test_distance_a_not_int_raises():\n    \"\"\"错误用例：a 非 int 时，str 与 int 不支持减法，应抛 TypeError。\n\n    期望值来源：规约前置条件 isinstance(a, int)；具体异常信息未约定，\n    仅断言异常类型为 TypeError。\n    \"\"\"\n    with pytest.raises(TypeError):\n        distance(\"5\", 3)\n\n\ndef test_distance_b_not_int_raises():\n    \"\"\"错误用例：b 为 None 时，int 与 NoneType 不支持减法，应抛 TypeError。\n\n    期望值来源：规约前置条件 isinstance(b, int)；具体异常信息未约定，\n    仅断言异常类型为 TypeError。\n    \"\"\"\n    with pytest.raises(TypeError):\n        distance(5, None)",
