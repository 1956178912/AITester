          "generated_test": "import importlib\nimport pytest\n\nimport task_0054\nfrom task_0054 import first_item\n\n\n@pytest.fixture\ndef restore_global_list():\n    \"\"\"保存并恢复 task_0054 模块级全局变量 list，避免测试间相互污染。\"\"\"\n    original = getattr(task_0054, \"list\", None)\n    had_attr = hasattr(task_0054, \"list\")\n    yield\n    if had_attr:\n        task_0054.list = original\n    elif hasattr(task_0054, \"list\"):\n        delattr(task_0054, \"list\")\n\n\ndef test_first_item_default_global_returns_first_element(restore_global_list):\n    \"\"\"正常取首元素：默认全局 list=[\"a\",\"b\",\"c\"] 时返回 list[0]。\n\n    期望值来源：规约后置条件 result == list[0] 及计划中默认全局数据。\n    \"\"\"\n    task_0054.list = [\"a\", \"b\", \"c\"]\n    result = first_item()\n    assert result == task_0054.list[0]\n    assert result == \"a\"\n\n\ndef test_first_item_single_element_list(restore_global_list):\n    \"\"\"边界：全局 list 仅含一个元素时返回该元素。\n\n    期望值来源：规约前置 len(list) > 0 与后置 result == list[0]。\n    \"\"\"\n    task_0054.list = [\"x\"]\n    result = first_item()\n    assert result == task_0054.list[0]\n    assert result == \"x\"\n\n\ndef test_first_item_returns_str_type(restore_global_list):\n    \"\"\"后置条件：在当前全局数据下返回值类型为 str。\n\n    期望值来源：规约后置条件“返回值类型为 str（在当前全局数据下）”。\n    \"\"\"\n    task_0054.list = [\"a\", \"b\", \"c\"]\n    result = first_item()\n    assert isinstance(result, str)\n\n\ndef test_first_item_empty_list_raises_index_error(restore_global_list):\n    \"\"\"边界：全局 list 为空列表时触发 IndexError。\n\n    期望值来源：规约边界情况“list 为空列表时触发 IndexError”。\n    具体异常消息未知，故仅断言异常类型。\n    \"\"\"\n    task_0054.list = []\n    with pytest.raises(IndexError):\n        first_item()\n\n\ndef test_first_item_none_global_raises_type_error(restore_global_list):\n    \"\"\"边界：全局 list 被置为 None 时行为改变，期望抛出 TypeError。\n\n    期望值来源：规约边界情况“list 被重新绑定为其他类型（如 None）时行为改变”。\n    具体异常类型依赖运行时，此处按计划期望 TypeError；若实现抛出其他异常，\n    该用例将暴露差异，需人工确认。\n    \"\"\"\n    task_0054.list = None\n    with pytest.raises(TypeError):\n        first_item()\n\n\ndef