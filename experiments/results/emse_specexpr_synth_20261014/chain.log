          "generated_test": "import math\n\nimport pytest\n\nfrom task_0046 import sqrt\n\n\n# ---------------------------------------------------------------------------\n# 正常路径：x > 0，返回算术平方根，满足 result ** 2 ≈ x\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\n    \"x, expected\",\n    [\n        (4.0, 2.0),\n        (2.25, 1.5),\n        (9.0, 3.0),\n        (1.0, 1.0),\n    ],\n)\ndef test_sqrt_positive_returns_arithmetic_square_root(x, expected):\n    \"\"\"规约：x > 0 时返回 x 的算术平方根。\n\n    期望值来源：规约后置条件 \"x > 0 时返回 x 的算术平方根\"，\n    对完全平方数可给出精确期望值。\n    \"\"\"\n    result = sqrt(x)\n    assert result == pytest.approx(expected)\n\n\n@pytest.mark.parametrize(\"x\", [2.0, 3.0, 0.5, 1e-10, 12345.678])\ndef test_sqrt_positive_satisfies_square_invariant(x):\n    \"\"\"规约：x > 0 时 result ** 2 ≈ x（不变量）。\n\n    期望值来源：规约后置条件中的平方关系，不依赖具体实现。\n    \"\"\"\n    result = sqrt(x)\n    assert result ** 2 == pytest.approx(x, rel=1e-9)\n\n\n# ---------------------------------------------------------------------------\n# 边界：x == 0 与 x == -0.0，直接返回 0\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\"x\", [0, 0.0, -0.0])\ndef test_sqrt_zero_returns_zero(x):\n    \"\"\"规约：x == 0（含 -0.0）时返回 0。\n\n    期望值来源：规约后置条件 \"x == 0 时返回 0\" 与边界情况\n    \"x = 0 / x = -0.0（等于 0，返回 0）\"。\n    \"\"\"\n    result = sqrt(x)\n    assert result == 0\n\n\n# ---------------------------------------------------------------------------\n# 边界：极大正数\n# ---------------------------------------------------------------------------\n\ndef test_sqrt_large_positive_value():\n    \"\"\"规约：x 为极大值（如 1e308）时返回其平方根。\n\n    期望值来源：规约边界情况 \"x 为极大值（如 1e308，可能溢出为 inf）\"。\n    1e308 的算术平方根为 1e154，规约未约定溢出，故断言平方关系。\n    \"\"\"\n    x = 1e308\n    result = sqrt(x)\n    assert result ** 2 == pytest.approx(x, rel=1e-9)\n\n\n# ---------------------------------------------------------------------------\n# 边界：极小正数（下溢行为规约未约定，探索性断言）\n# ---------------------------------------------------------------------------\n\ndef test_sqrt_tiny_positive_value_records_behavior():\n    \"\"\"规约：x 为极小正数（如 5e-324）时走非零分支。\n\n    期望值来源不明，需人工确认：规约仅说明 \"x 为极小正数（如 5e-324，\n    下溢）\"，未约定具体返回值。此处仅记录实际行为并断言其为数值类型，\n    不臆造具体值。\n    \"\"\"\n    x = 5e-324\n    result = sqrt(x)\n    # 探索性断言：结果应为数值（float 或 complex），不强制具体值\n    assert isinstance(result, (float, complex))\n\n\n# ---------------------------------------------------------------------------\n# 边界：inf\n# ---------------------------------------------------------------------------\n\ndef test_sqrt_positive_infinity_returns_infinity():\n    \"\"\"规约：x 为 inf 时走非零分支，inf ** 0.5 返回 inf。\n\n    期望值来源：规约边界情况 \"x 为 NaN / inf\" 与数学性质\n    sqrt(inf) = inf。\n    \"\"\"\n    result = sqrt(float(\"inf\"))\n    assert result == float(\"inf\")\n\n\n# ---------------------------------------------------------------------------\n# 边界：NaN（规约未约定具体值，探索性断言）\n# ---------------------------------------------------------------------------\n\ndef test_sqrt_nan_records_behavior():\n    \"\"\"规约：x 为 NaN 时走非零分支。\n\n    期望值来源不明，需人工确认：规约仅列出 \"x 为 NaN / inf\" 为边界情况，\n    未约定 NaN 的具体返回。此处记录实际行为：若返回 float 则应为 NaN，\n    否则记录为其他类型，不做强制断言。\n    \"\"\"\n    result = sqrt(float(\"nan\"))\n    if isinstance(result, float):\n        assert math.isnan(result)\n    else:\n        # 实现返回非 float（如 complex），记录实际行为，需人工确认\n        assert result is not None\n\n\n# ---------------------------------------------------------------------------\n# 边界：负数（规约明确返回复数，与 float 注解冲突）\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\"x\", [-4.0, -1.0, -2.25])\ndef test_sqrt_negative_returns_complex(x):\n    \"\"\"规约：x < 0 时返回复数（complex），不满足 float 返回类型注解。\n\n    期望值来源：规约后置条件 \"x < 0 时返回复数（complex）\" 与边界情况\n    \"x 为负数（x ** 0.5 产生复数）\"。断言返回类型为 complex 且平方 ≈ x。\n    \"\"\"\n    result = sqrt(x)\n    assert isinstance(result, complex)\n    assert result ** 2 == pytest.approx(complex(x, 0), rel=1e-9)\n\n\n# ---------------------------------------------------------------------------\n# 前置条件违反：非数值类型（字符串）\n# ---------------------------------------------------------------------------\n\ndef test_sqrt_non_numeric_string_raises():\n    \"\"\"规约：前置条件要求 x 为 float 类型（或可被解释为 float 的数值）。\n\n    字符串 \"4\" 不满足前置条件，规约未约定其行为；按 Python 语义\n    '4' ** 0.5 会抛 TypeError。期望值来源：规约前置条件 + Python 语义，\n    需人工确认具体异常类型。\n    \"\"\"\n    with pytest.raises(TypeError):\n        sqrt(\"4\")\n\n\ndef test_sqrt_none_input_raises():\n    \"\"\"规约：前置条件要求 x 为 float 类型（或可被解释为 float 的数值）。\n\n    None 不满足前置条件，规约未约定其行为；按 Python 语义\n    None == 0 为 False，随后 None ** 0.5 抛 TypeError。\n    期望值来源：规约前置条件 + Python 语义，需人工确认。\n    \"\"\"\n    with pytest.raises(TypeError):\n        sqrt(None)",
