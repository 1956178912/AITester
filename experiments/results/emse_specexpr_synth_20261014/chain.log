          "generated_test": "import pytest\n\nfrom task_0016 import _better, best_score, worst_score\n\n\nclass TestBetter:\n    \"\"\"Tests for the private helper `_better`.\"\"\"\n\n    def test_better_returns_true_when_candidate_smaller(self):\n        \"\"\"_better(current, candidate) should be True when candidate < current.\"\"\"\n        assert _better(5, 3) is True\n\n    def test_better_returns_false_when_candidate_larger(self):\n        \"\"\"_better(current, candidate) should be False when candidate > current.\"\"\"\n        assert _better(3, 5) is False\n\n    def test_better_returns_false_when_equal(self):\n        \"\"\"_better(current, candidate) should be False when candidate == current.\"\"\"\n        assert _better(4, 4) is False\n\n    def test_better_with_negative_numbers(self):\n        \"\"\"_better should handle negative integers correctly.\"\"\"\n        assert _better(-1, -5) is True\n        assert _better(-5, -1) is False\n\n\nclass TestBestScore:\n    \"\"\"Tests for `best_score`.\"\"\"\n\n    def test_best_score_single_element(self):\n        \"\"\"A single-element list should return that element.\"\"\"\n        assert best_score([7]) == 7\n\n    def test_best_score_ascending(self):\n        \"\"\"Ascending list: best (minimum) is the first element.\"\"\"\n        assert best_score([1, 2, 3, 4, 5]) == 1\n\n    def test_best_score_descending(self):\n        \"\"\"Descending list: best (minimum) is the last element.\"\"\"\n        assert best_score([5, 4, 3, 2, 1]) == 1\n\n    def test_best_score_unsorted(self):\n        \"\"\"Unsorted list: best is the minimum value.\"\"\"\n        assert best_score([3, 1, 4, 1, 5, 9, 2, 6]) == 1\n\n    def test_best_score_with_negatives(self):\n        \"\"\"Negative values should be handled correctly.\"\"\"\n        assert best_score([-3, -1, -4, -1, -5]) == -5\n\n    def test_best_score_all_equal(self):\n        \"\"\"All-equal list returns that value.\"\"\"\n        assert best_score([2, 2, 2, 2]) == 2\n\n    def test_best_score_duplicates(self):\n        \"\"\"Duplicates should not affect the minimum.\"\"\"\n        assert best_score([4, 4, 2, 4, 2]) == 2\n\n    def test_best_score_empty_raises_index_error(self):\n        \"\"\"Empty input raises IndexError (scores[0] access).\"\"\"\n        with pytest.raises(IndexError):\n            best_score([])\n\n\nclass TestWorstScore:\n    \"\"\"Tests for `worst_score`.\"\"\"\n\n    def test_worst_score_single_element(self):\n        \"\"\"A single-element list should return that element.\"\"\"\n        assert worst_score([7]) == 7\n\n    def test_worst_score_ascending(self):\n        \"\"\"Ascending list: worst (maximum) is the last element.\"\"\"\n        assert worst_score([1, 2, 3, 4, 5]) == 5\n\n    def test_worst_score_descending(self):\n        \"\"\"Descending list: worst (maximum) is the first element.\"\"\"\n        assert worst_score([5, 4, 3, 2, 1]) == 5\n\n    def test_worst_score_unsorted(self):\n        \"\"\"Unsorted list: worst is the maximum value.\"\"\"\n        assert worst_score([3, 1, 4, 1, 5, 9, 2, 6]) == 9\n\n    def test_worst_score_with_negatives(self):\n        \"\"\"Negative values should be handled correctly.\"\"\"\n        assert worst_score([-3, -1, -4, -1, -5]) == -1\n\n    def test_worst_score_all_equal(self):\n        \"\"\"All-equal list returns that value.\"\"\"\n        assert worst_score([2, 2, 2, 2]) == 2\n\n    def test_worst_score_duplicates(self):\n        \"\"\"Duplicates should not affect the maximum.\"\"\"\n        assert worst_score([4, 4, 2, 4, 2]) == 4\n\n    def test_worst_score_empty_raises_index_error(self):\n        \"\"\"Empty input raises IndexError (scores[0] access).\"\"\"\n        with pytest.raises(IndexError):\n            worst_score([])\n\n\nclass TestBestWorstConsistency:\n    \"\"\"Cross-checks between best_score and worst_score.\"\"\"\n\n    def test_best_score_le_worst_score(self):\n        \"\"\"For any non-empty list, best_score <= worst_score.\"\"\"\n        data = [3, 1, 4, 1, 5, 9, 2, 6]\n        assert best_score(data) <= worst_score(data)\n\n    def test_best_score_equals_min(self):\n        \"\"\"best_score should equal Python's built-in min.\"\"\"\n        data = [10, -2, 7, 0, 3]\n        assert best_score(data) == min(data)\n\n    def test_worst_score_equals_max(self):\n        \"\"\"worst_score should equal Python's built-in max.\"\"\"\n        data = [10, -2, 7, 0, 3]\n        assert worst_score(data) == max(data)",
