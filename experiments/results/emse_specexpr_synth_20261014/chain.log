          "generated_test": "import pytest\n\nfrom task_0027 import compute_scores\n\n\ndef test_compute_scores_normal_multiple_records():\n    \"\"\"正常多记录：验证正常映射转换，期望值来源：规约后置条件。\"\"\"\n    records = [\n        {\"name\": \"a\", \"value\": 1},\n        {\"name\": \"b\", \"value\": 2},\n    ]\n    result = compute_scores(records)\n    assert result == {\"a\": 1, \"b\": 2}\n\n\ndef test_compute_scores_empty_list():\n    \"\"\"空列表：验证空输入返回空字典，期望值来源：规约边界情况。\"\"\"\n    result = compute_scores([])\n    assert result == {}\n\n\ndef test_compute_scores_missing_name_uses_unknown():\n    \"\"\"缺失 name：验证 name 缺失时使用默认键 'unknown'，期望值来源：规约后置条件。\"\"\"\n    records = [{\"value\": 5}]\n    result = compute_scores(records)\n    assert result == {\"unknown\": 5}\n\n\ndef test_compute_scores_missing_value_uses_zero():\n    \"\"\"缺失 value：验证 value 缺失时使用默认值 0，期望值来源：规约后置条件。\"\"\"\n    records = [{\"name\": \"a\"}]\n    result = compute_scores(records)\n    assert result == {\"a\": 0}\n\n\ndef test_compute_scores_duplicate_name_last_wins():\n    \"\"\"重复 name 覆盖：验证同名键后者覆盖前者，期望值来源：规约后置条件。\"\"\"\n    records = [\n        {\"name\": \"a\", \"value\": 1},\n        {\"name\": \"a\", \"value\": 2},\n    ]\n    result = compute_scores(records)\n    assert result == {\"a\": 2}\n\n\ndef test_compute_scores_negative_value_preserved():\n    \"\"\"value 为负数：验证负数 value 原样保留，期望值来源：规约边界情况。\"\"\"\n    records = [{\"name\": \"a\", \"value\": -3}]\n    result = compute_scores(records)\n    assert result == {\"a\": -3}\n\n\ndef test_compute_scores_zero_value_preserved():\n    \"\"\"value 为 0：验证 0 值原样保留，期望值来源：规约边界情况。\"\"\"\n    records = [{\"name\": \"a\", \"value\": 0}]\n    result = compute_scores(records)\n    assert result == {\"a\": 0}\n\n\ndef test_compute_scores_large_value_preserved():\n    \"\"\"value 为大数：验证大数 value 原样保留，期望值来源：规约边界情况。\"\"\"\n    records = [{\"name\": \"a\", \"value\": 10**18}]\n    result = compute_scores(records)\n    assert result == {\"a\": 10**18}\n\n\ndef test_compute_scores_result_length_equals_records_length_when_unique():\n    \"\"\"后置不变量：键唯一时返回字典长度等于 records 长度，期望值来源：规约后置条件。\"\"\"\n    records = [\n        {\"name\": \"a\", \"value\": 1},\n        {\"name\": \"b\", \"value\": 2},\n        {\"name\": \"c\", \"value\": 3},\n    ]\n    result = compute_scores(records)\n    assert len(result) == len(records)\n\n\ndef test_compute_scores_missing_name_and_value_defaults():\n    \"\"\"同时缺失 name 与 value：验证默认键 'unknown' 与默认值 0，期望值来源：规约后置条件。\"\"\"\n    records = [{}]\n    result = compute_scores(records)\n    assert result == {\"unknown\": 0}\n\n\ndef test_compute_scores_non_mapping_element_raises():\n    \"\"\"元素非映射：元素无 get 方法，期望抛出 AttributeError，期望值来源：规约前置条件（元素须实现 get）。\"\"\"\n    records = [1]\n    with pytest.raises(AttributeError):\n        compute_scores(records)",
