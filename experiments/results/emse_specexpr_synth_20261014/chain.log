          "generated_test": "import pytest\n\nfrom task_0037 import distance\n\n\n# ---------------------------------------------------------------------------\n# 正常路径\n# ---------------------------------------------------------------------------\n\ndef test_distance_positive_numbers():\n    \"\"\"规约：返回值恒等于 a - b。输入 5, 3 期望 2。\"\"\"\n    assert distance(5, 3) == 2\n\n\ndef test_distance_positive_and_negative():\n    \"\"\"规约：返回值恒等于 a - b。输入 5, -3 期望 8。\"\"\"\n    assert distance(5, -3) == 8\n\n\ndef test_distance_negative_and_positive():\n    \"\"\"规约：返回值恒等于 a - b。输入 -5, 3 期望 -8。\"\"\"\n    assert distance(-5, 3) == -8\n\n\n# ---------------------------------------------------------------------------\n# 边界情况\n# ---------------------------------------------------------------------------\n\ndef test_distance_equal_operands_returns_zero():\n    \"\"\"边界：a 与 b 相等时结果为 0。\"\"\"\n    assert distance(7, 7) == 0\n\n\ndef test_distance_a_is_zero():\n    \"\"\"边界：a 为 0 时结果为 -b。\"\"\"\n    assert distance(0, 5) == -5\n\n\ndef test_distance_b_is_zero():\n    \"\"\"边界：b 为 0 时结果为 a。\"\"\"\n    assert distance(5, 0) == 5\n\n\ndef test_distance_both_zero():\n    \"\"\"边界：a 与 b 均为 0 时结果为 0。\"\"\"\n    assert distance(0, 0) == 0\n\n\ndef test_distance_both_negative():\n    \"\"\"边界：a、b 均为负数时结果符号正确。输入 -5, -3 期望 -2。\"\"\"\n    assert distance(-5, -3) == -2\n\n\ndef test_distance_large_integers():\n    \"\"\"边界：超出 64 位范围的大整数仍可正确相减（Python int 无溢出）。\"\"\"\n    assert distance(10_000_000_000_000_000_000, 1) == 9_999_999_999_999_999_999\n\n\ndef test_distance_extreme_boundary():\n    \"\"\"边界：极大正负整数相减不溢出。输入 -1e19, 1e19 期望 -2e19。\"\"\"\n    assert distance(-10_000_000_000_000_000_000, 10_000_000_000_000_000_000) == -20_000_000_000_000_000_000\n\n\n# ---------------------------------------------------------------------------\n# 不变量 / 性质\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\n    \"a, b\",\n    [\n        (0, 0),\n        (1, 1),\n        (-1, -1),\n        (123, 456),\n        (-123, 456),\n        (123, -456),\n        (-123, -456),\n        (10**30, 10**30 - 1),\n        (-(10**30), 10**30),\n    ],\n)\ndef test_distance_equals_a_minus_b(a, b):\n    \"\"\"不变量：返回值恒等于 a - b（对多组输入参数化验证）。\"\"\"\n    assert distance(a, b) == a - b\n\n\n@pytest.mark.parametrize(\n    \"a, b\",\n    [\n        (5, 3),\n        (-5, -3),\n        (0, 0),\n        (10**20, -10**20),\n    ],\n)\ndef test_distance_does_not_mutate_arguments(a, b):\n    \"\"\"后置条件：函数无副作用，不修改入参。\"\"\"\n    a_before, b_before = a, b\n    distance(a, b)\n    assert a == a_before\n    assert b == b_before\n\n\ndef test_distance_antisymmetry():\n    \"\"\"性质：distance(a, b) == -distance(b, a)。\"\"\"\n    a, b = 17, -42\n    assert distance(a, b) == -distance(b, a)\n\n\n# ---------------------------------------------------------------------------\n# 异常路径\n# ---------------------------------------------------------------------------\n\ndef test_distance_non_int_raises_type_error():\n    \"\"\"异常路径：传入字符串时 Python 会抛出 TypeError。\n\n    期望值来源不明（规约未定义类型校验行为），仅验证异常路径存在，\n    具体异常类型需人工确认。\n    \"\"\"\n    with pytest.raises(TypeError):\n        distance(\"5\", 3)",
