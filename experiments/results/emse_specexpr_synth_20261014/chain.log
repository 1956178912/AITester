          "generated_test": "import pytest\n\nfrom task_0051 import aggregate\n\n\ndef test_aggregate_returns_mean_of_values():\n    \"\"\"aggregate 应返回列表元素的算术平均值。\n\n    期望值来源：函数实现 sum(values) / len(values)，即算术平均值。\n    \"\"\"\n    result = aggregate([1, 2, 3, 4])\n    assert result == pytest.approx(2.5)\n\n\ndef test_aggregate_single_element():\n    \"\"\"单元素列表的平均值应等于该元素本身。\n\n    期望值来源：算术平均值定义。\n    \"\"\"\n    result = aggregate([7])\n    assert result == pytest.approx(7.0)\n\n\ndef test_aggregate_negative_values():\n    \"\"\"包含负数的列表应正确计算平均值。\n\n    期望值来源：算术平均值定义。\n    \"\"\"\n    result = aggregate([-2, -4, -6])\n    assert result == pytest.approx(-4.0)\n\n\ndef test_aggregate_mixed_sign_values():\n    \"\"\"正负混合列表的平均值应正确。\n\n    期望值来源：算术平均值定义。\n    \"\"\"\n    result = aggregate([-1, 1, -1, 1])\n    assert result == pytest.approx(0.0)\n\n\ndef test_aggregate_float_values():\n    \"\"\"浮点列表的平均值应正确。\n\n    期望值来源：算术平均值定义。\n    \"\"\"\n    result = aggregate([0.5, 1.5, 2.5])\n    assert result == pytest.approx(1.5)\n\n\ndef test_aggregate_returns_float_type():\n    \"\"\"返回值类型应为 float（或与除法结果一致）。\n\n    期望值来源：函数返回类型注解为 float。\n    \"\"\"\n    result = aggregate([1, 2, 3])\n    assert isinstance(result, float)\n\n\ndef test_aggregate_empty_list_raises_zero_division_error():\n    \"\"\"空列表应触发 ZeroDivisionError（历史 bug：空列表除零）。\n\n    期望值来源：实现中 len(values) 为 0 时除法会抛 ZeroDivisionError。\n    \"\"\"\n    with pytest.raises(ZeroDivisionError):\n        aggregate([])\n\n\ndef test_aggregate_large_values():\n    \"\"\"大数值列表的平均值应正确。\n\n    期望值来源：算术平均值定义。\n    \"\"\"\n    result = aggregate([10**6, 2 * 10**6, 3 * 10**6])\n    assert result == pytest.approx(2 * 10**6)\n\n\ndef test_aggregate_does_not_mutate_input():\n    \"\"\"aggregate 不应修改传入的列表。\n\n    期望值来源：函数实现仅读取 values，未做原地修改。\n    \"\"\"\n    values = [1, 2, 3]\n    original = list(values)\n    aggregate(values)\n    assert values == original",
