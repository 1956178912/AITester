          "generated_test": "import pytest\n\nfrom task_0054 import first_item\n\n\n@pytest.fixture\ndef restore_global_list():\n    \"\"\"保存并恢复被测模块的全局 list，避免测试间相互污染。\"\"\"\n    import task_0054\n\n    original = getattr(task_0054, \"list\", None)\n    had_attr = hasattr(task_0054, \"list\")\n    yield task_0054\n    if had_attr:\n        task_0054.list = original\n    else:\n        try:\n            del task_0054.list\n        except AttributeError:\n            pass\n\n\ndef test_first_item_returns_first_element_of_default_list(restore_global_list):\n    \"\"\"正常路径：默认全局 list=[\"a\",\"b\",\"c\"] 时返回首元素 \"a\"。\n\n    期望值来源：测试计划 normal 用例 expected_output=\"a\"。\n    \"\"\"\n    module = restore_global_list\n    module.list = [\"a\", \"b\", \"c\"]\n    assert first_item() == \"a\"\n\n\ndef test_first_item_does_not_modify_global_list(restore_global_list):\n    \"\"\"后置条件：调用后不修改全局 list。\n\n    期望值来源：规约后置条件\"不修改 list\"。\n    \"\"\"\n    module = restore_global_list\n    module.list = [\"a\", \"b\", \"c\"]\n    snapshot = list(module.list)\n    first_item()\n    assert module.list == snapshot\n\n\ndef test_first_item_returns_new_first_element_after_mutation(restore_global_list):\n    \"\"\"边界：全局 list 被修改为 [\"x\",\"y\"] 后返回新的首元素 \"x\"。\n\n    期望值来源：测试计划 boundary 用例 expected_output=\"x\"。\n    \"\"\"\n    module = restore_global_list\n    module.list = [\"x\", \"y\"]\n    assert first_item() == \"x\"\n\n\ndef test_first_item_returns_str_type(restore_global_list):\n    \"\"\"后置条件：返回值为 str 类型（签名约定 -> str）。\n\n    期望值来源：函数签名 `def first_item() -> str`。\n    \"\"\"\n    module = restore_global_list\n    module.list = [\"a\", \"b\", \"c\"]\n    assert isinstance(first_item(), str)\n\n\ndef test_first_item_raises_index_error_on_empty_list(restore_global_list):\n    \"\"\"边界：全局 list 为空时触发 IndexError。\n\n    期望值来源：规约边界情况\"list 为空时触发 IndexError\"。\n    具体异常消息未知，仅断言异常类型。\n    \"\"\"\n    module = restore_global_list\n    module.list = []\n    with pytest.raises(IndexError):\n       