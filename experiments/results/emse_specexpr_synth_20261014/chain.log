          "generated_test": "import pytest\n\nfrom task_0065 import first_item\n\n\n@pytest.fixture\ndef restore_global_list():\n    \"\"\"保存并恢复被测模块的全局 list，避免测试间相互污染。\"\"\"\n    import task_0065\n\n    original = task_0065.list\n    yield task_0065\n    task_0065.list = original\n\n\ndef test_first_item_returns_first_element_of_default_list(restore_global_list):\n    \"\"\"默认全局 list=[\"a\",\"b\",\"c\"] 下，返回值应等于 list[0]。\n\n    期望值来源：规约后置条件 result == list[0]。\n    \"\"\"\n    module = restore_global_list\n    module.list = [\"a\", \"b\", \"c\"]\n    result = first_item()\n    assert result == module.list[0]\n    assert result == \"a\"\n\n\ndef test_first_item_returns_str_type(restore_global_list):\n    \"\"\"在当前全局数据（字符串元素）下，返回值类型应为 str。\n\n    期望值来源：规约后置条件“返回值类型为 str（在当前全局数据下）”。\n    \"\"\"\n    module = restore_global_list\n    module.list = [\"a\", \"b\", \"c\"]\n    result = first_item()\n    assert isinstance(result, str)\n\n\ndef test_first_item_single_element_list(restore_global_list):\n    \"\"\"全局 list 为单元素 [\"a\"] 时，应返回 \"a\"。\n\n    期望值来源：规约前置 len(list) > 0 的最小满足情形 + 后置 result == list[0]。\n    \"\"\"\n    module = restore_global_list\n    module.list = [\"a\"]\n    result = first_item()\n    assert result == module.list[0]\n    assert result == \"a\"\n\n\ndef test_first_item_empty_list_raises_index_error(restore_global_list):\n    \"\"\"全局 list 为空列表时，应抛出 IndexError。\n\n    期望值来源：规约边界情况“全局 list 为空列表时触发 IndexError”。\n    具体异常消息未知，故仅断言异常类型。\n    \"\"\"\n    module = restore_global_list\n    module.list = []\n    with pytest.raises(IndexError):\n        first_item()\n\n\ndef test_first_item_reflects_rebound_global_list(restore_global_list):\n    \"\"\"全局 list 被重新绑定后，返回值应随之变化。\n\n    期望值来源：规约边界情况“全局 list 被重新绑定或修改后返回值随之变化”\n    + 后置 result == list[0]。\n    \"\"\"\n    module = restore_global_list\n    module.list = [\"x\", \"y\", \"z\"]\n    result = first_item()\n    assert result == module.list[0]\n    assert result == \"x\"\n\n\ndef test_first_item_reflects_mutated_global_list(restore_global_list):\n    \"\"\"全局 list 被原地修改后，返回值应随之变化。\n\n    期望值来源：规约边界情况“全局 list 被重新绑定或修改后返回值随之变化”\n    + 后置 result == list[0]。\n    \"\"\"\n    module = restore_global_list\n    module.list = [\"a\", \"b\", \"c\"]\n    module.list[0] = \"z\"\n    result = first_item()\n    assert result == module.list[0]\n    assert result == \"z\"\n\n\ndef test_first_item_non_str_element_type_mismatch(restore_global_list):\n    \"\"\"全局 list 元素非字符串时，返回类型与注解不符。\n\n    期望值来源：规约边界情况“全局 list 元素非字符串时返回类型与注解不符”。\n    规约未规定具体返回值，故仅记录实际行为并断言其等于 list[0]。\n    期望值来源不明，需人工确认。\n    \"\"\"\n    module = restore_global_list\n    module.list = [123, \"b\", \"c\"]\n    result = first_item()\n    assert result == module.list[0]\n    assert not isinstance(result, str)",
