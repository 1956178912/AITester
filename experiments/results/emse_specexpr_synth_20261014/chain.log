          "generated_test": "import pytest\n\nfrom task_0058 import is_palindrome\n\n\nclass TestIsPalindromeNormal:\n    \"\"\"普通用例：验证 is_palindrome 在常规回文/非回文输入下的返回值。\"\"\"\n\n    def test_is_palindrome_even_length_palindrome(self):\n        \"\"\"偶数长度回文 'abba'，规约：s == s[::-1] 为真，返回 True。\"\"\"\n        assert is_palindrome(\"abba\") is True\n\n    def test_is_palindrome_even_length_non_palindrome(self):\n        \"\"\"偶数长度非回文 'abcd'，规约：s != s[::-1]，返回 False。\"\"\"\n        assert is_palindrome(\"abcd\") is False\n\n    def test_is_palindrome_odd_length_palindrome(self):\n        \"\"\"奇数长度回文 'abcba'，规约：s == s[::-1] 为真，返回 True。\"\"\"\n        assert is_palindrome(\"abcba\") is True\n\n    def test_is_palindrome_odd_length_non_palindrome(self):\n        \"\"\"奇数长度非回文 'abcde'，规约：s != s[::-1]，返回 False。\"\"\"\n        assert is_palindrome(\"abcde\") is False\n\n\nclass TestIsPalindromeBoundary:\n    \"\"\"边界用例：空串、单字符、全相同字符、大小写敏感、含空格标点。\"\"\"\n\n    def test_is_palindrome_empty_string(self):\n        \"\"\"空字符串 '' 反转仍为 ''，规约明确为回文，返回 True。\"\"\"\n        assert is_palindrome(\"\") is True\n\n    def test_is_palindrome_single_character(self):\n        \"\"\"单字符 'a' 反转等于自身，规约明确为回文，返回 True。\"\"\"\n        assert is_palindrome(\"a\") is True\n\n    def test_is_palindrome_all_same_characters(self):\n        \"\"\"全相同字符 'aaaa' 反转后相等，规约明确为回文，返回 True。\"\"\"\n        assert is_palindrome(\"aaaa\") is True\n\n    def test_is_palindrome_case_sensitive(self):\n        \"\"\"大小写敏感：'AbBa' 反转 'aBbA' 不相等，规约明确返回 False。\"\"\"\n        assert is_palindrome(\"AbBa\") is False\n\n    def test_is_palindrome_with_spaces_and_punctuation(self):\n        \"\"\"含空格标点：'A man, a plan, a canal: Panama' 反转后不相等，规约明确返回 False。\"\"\"\n        assert is_palindrome(\"A man, a plan, a canal: Panama\") is False\n\n\nclass TestIsPalindromeError:\n    \"\"\"异常用例：非字符串入参触发 TypeError（规约明确异常路径）。\"\"\"\n\n    def test_is_palindrome_none_raises_type_error(self):\n        \"\"\"入参为 None 时，规约声明触发 TypeError（None 不支持切片反转）。\"\"\"\n        with pytest.raises(TypeError):\n            is_palindrome(None)\n\n    def test_is_palindrome_int_raises_type_error(self):\n        \"\"\"入参为 int 时，规约声明触发 TypeError（int 不支持切片操作）。\"\"\"\n        with pytest.raises(TypeError):\n            is_palindrome(12321)\n\n\nclass TestIsPalindromePostcondition:\n    \"\"\"后置条件不变量：返回值与 s == s[::-1] 严格等价。\"\"\"\n\n    @pytest.mark.parametrize(\n        \"s\",\n        [\n            \"\",\n            \"a\",\n            \"aa\",\n            \"ab\",\n            \"aba\",\n            \"abba\",\n            \"abcba\",\n            \"abcd\",\n            \"aaaa\",\n            \"AbBa\",\n            \"A man, a plan, a canal: Panama\",\n            \"racecar\",\n            \"hello\",\n            \"12321\",\n            \"12345\",\n        ],\n    )\n    def test_is_palindrome_matches_reverse_equality(self, s):\n        \"\"\"后置条件：is_palindrome(s) 当且仅当 s == s[::-1] 时为 True。\"\"\"\n        assert is_palindrome(s) is (s == s[::-1])",
