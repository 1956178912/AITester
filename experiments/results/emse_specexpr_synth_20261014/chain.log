          "generated_test": "import datetime\n\nimport pytest\n\nfrom task_0033 import days_until\n\n\ndef _expected_days(target: str) -> int:\n    \"\"\"根据规约计算期望天数：解析成功用解析日期，失败用 datetime.min。\"\"\"\n    try:\n        parsed = datetime.datetime.strptime(target, \"%Y-%m-%d\")\n    except ValueError:\n        parsed = datetime.datetime.min\n    return (parsed - datetime.datetime.now()).days\n\n\ndef test_days_until_returns_int_for_valid_date():\n    \"\"\"合法日期应返回 int 类型（后置条件：isinstance(result, int)）。\"\"\"\n    result = days_until(\"2999-12-31\")\n    assert isinstance(result, int)\n\n\ndef test_days_until_future_date_positive():\n    \"\"\"未来日期应返回正天数（规约：未来日期为正数）。\"\"\"\n    result = days_until(\"2999-12-31\")\n    assert result > 0\n\n\ndef test_days_until_past_date_negative():\n    \"\"\"过去日期应返回负天数（规约：过去日期为负数）。\"\"\"\n    result = days_until(\"1970-01-01\")\n    assert result < 0\n\n\ndef test_days_until_min_date_matches_spec():\n    \"\"\"极端下界日期 \"0001-01-01\" 应等于 (datetime.min - now).days。\"\"\"\n    result = days_until(\"0001-01-01\")\n    assert result == _expected_days(\"0001-01-01\")\n\n\ndef test_days_until_max_date_matches_spec():\n    \"\"\"极端上界日期 \"9999-12-31\" 应等于 (解析日期 - now).days。\"\"\"\n    result = days_until(\"9999-12-31\")\n    assert result == _expected_days(\"9999-12-31\")\n\n\ndef test_days_until_today_near_zero():\n    \"\"\"当天日期结果约为 0，受当前时刻影响可能为 -1 或 0。\"\"\"\n    today = datetime.datetime.now().strftime(\"%Y-%m-%d\")\n    result = days_until(today)\n    assert result in (-1, 0)\n\n\n@pytest.mark.parametrize(\n    \"target\",\n    [\"\", \"2024/01/01\", \"20240101\", \"abc\", \"not-a-date\"],\n)\ndef test_days_until_invalid_string_falls_back_to_datetime_min(target):\n    \"\"\"解析失败的字符串应走 except 分支，返回 (datetime.min - now).days。\"\"\"\n    result = days_until(target)\n    assert isinstance(result, int)\n    assert result == _expected_days(target)\n\n\n@pytest.mark.parametrize(\n    \"target\",\n    [None, 123, 1.5, [\"2024-01-01\"]],\n)\ndef test_days_until_non_string_raises_type_error(target):\n    \"\"\"非字符串输入触发 TypeError，未被 except ValueError 捕获。\"\"\"\n    with pytest.raises(TypeError):\n        days_until(target)",
