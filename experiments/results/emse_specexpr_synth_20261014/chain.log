          "generated_test": "import pytest\n\nfrom task_0084 import fibonacci\n\n\ndef test_fibonacci_n2_recursive_normal_path():\n    \"\"\"n=2 时命中 n>=2 递归分支，规约约定返回 fibonacci(1)+fibonacci(0)=1+1=2。\"\"\"\n    assert fibonacci(2) == 2\n\n\ndef test_fibonacci_n3_recursive_normal_path():\n    \"\"\"n=3 时命中 n>=2 递归分支，规约约定返回 fibonacci(2)+fibonacci(1)=2+1=3。\"\"\"\n    assert fibonacci(3) == 3\n\n\ndef test_fibonacci_n0_boundary_returns_one():\n    \"\"\"n=0 命中 n<=0 分支，规约约定返回 1。\"\"\"\n    assert fibonacci(0) == 1\n\n\ndef test_fibonacci_n1_boundary_returns_one():\n    \"\"\"n=1 命中 n==1 分支，规约约定返回 1。\"\"\"\n    assert fibonacci(1) == 1\n\n\ndef test_fibonacci_negative_boundary_returns_one():\n    \"\"\"n=-1 命中 n<=0 分支，规约约定返回 1。\"\"\"\n    assert fibonacci(-1) == 1\n\n\n@pytest.mark.parametrize(\"n\", [-100, -2, -1, 0])\ndef test_fibonacci_non_positive_returns_one(n):\n    \"\"\"所有 n<=0 的输入均命中 n<=0 分支，规约约定统一返回 1。\"\"\"\n    assert fibonacci(n) == 1\n\n\ndef test_fibonacci_n4_matches_recursive_definition():\n    \"\"\"n=4 时按规约 fibonacci(3)+fibonacci(2)=3+2=5，验证递归定义一致性。\"\"\"\n    assert fibonacci(4) == 5\n\n\ndef test_fibonacci_n5_matches_recursive_definition():\n    \"\"\"n=5 时按规约 fibonacci(4)+fibonacci(3)=5+3=8，验证多层递归累加。\"\"\"\n    assert fibonacci(5) == 8\n\n\ndef test_fibonacci_recursive_relation_holds():\n    \"\"\"对 n>=2，规约要求 fibonacci(n) == fibonacci(n-1) + fibonacci(n-2)。\"\"\"\n    for n in range(2, 8):\n        assert fibonacci(n) == fibonacci(n - 1) + fibonacci(n - 2)\n\n\ndef test_fibonacci_large_n_records_actual_behavior():\n    \"\"\"n=1000 的期望值规约未定义（可能触发 RecursionError）。\n\n    期望值来源不明，需人工确认：此处仅记录实际行为，\n    接受正常返回 int 或抛出 RecursionError 两种结果，不做具体值断言。\n    \"\"\"\n    try:\n        result = fibonacci(1000)\n    except RecursionError:\n        return\n    assert isinstance(result, int)",
