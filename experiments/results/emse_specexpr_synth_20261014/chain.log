rns_infinity():\n    \"\"\"规约：inf == 0 为 False，inf ** 0.5 返回 inf。\"\"\"\n    result = sqrt(float(\"inf\"))\n    assert math.isinf(result)\n    assert result > 0\n\n\ndef test_sqrt_negative_infinity_returns_complex():\n    \"\"\"规约：-inf == 0 为 False，(-inf) ** 0.5 返回复数 inf*j。\n\n    期望值来源：规约明确说明返回复数 inf*j；具体数值未在规约中给出，\n    因此仅断言类型为 complex 且虚部为无穷，供人工确认。\n    \"\"\"\n    result = sqrt(float(\"-inf\"))\n    assert isinstance(result, complex)\n    assert math.isinf(result.imag)",
