assert result == {}\n    assert isinstance(result, dict)\n\n\ndef test_compute_scores_missing_name_defaults_to_unknown():\n    \"\"\"边界：record 缺少 \"name\" 键时，键应为 \"unknown\"。\n\n    期望值来源：规约边界情况 record 缺少 \"name\" 键 → 键为 \"unknown\"。\n    \"\"\"\n    records = [{\"value\": 5}]\n    result = compute_scores(records)\n    assert result == {\"unknown\": 5}\n\n\ndef test_compute_scores_missing_value_defaults_to_zero():\n    \"\"\"边界：record 缺少 \"value\" 键时，值应为 0。\n\n    期望值来源：规约边界情况 record 缺少 \"value\" 键 → 值为 0。\n    \"\"\"\n    records = [{\"name\": \"x\"}]\n    result = compute_scores(records)\n    assert result == {\"x\": 0}\n\n\ndef test_compute_scores_duplicate_name_last_wins():\n    \"\"\"边界：多条记录 name 相同时，后写覆盖前写。\n\n    期望值来源：规约边界情况 多条记录 name 相同 → 后写覆盖前写。\n    \"\"\"\n    records = [\n        {\"name\": \"a\", \"value\": 1},\n        {\"name\": \"a\", \"value\": 9},\n    ]\n    result = compute_scores(records)\n    assert result == {\"a\": 9}\n\n\ndef test_compute_scores_value_zero_preserved():\n    \"\"\"边界：value 为 0 时应原样保留（不被缺省逻辑覆盖）。\n\n    期望值来源：规约边界情况 record 的 value 为 0 或负数。\n    \"\"\"\n    records = [{\"name\": \"z\", \"value\": 0}]\n    result = compute_scores(records)\n    assert result == {\"z\": 0}\n\n\ndef test_compute_scores_value_negative_preserved():\n    \"\"\"边界：value 为负数时应原样保留。\n\n    期望值来源：规约边界情况 record 的 value 为 0 或负数。\n    \"\"\"\n    records = [{\"name\": \"n\", \"value\": -3}]\n    result = compute_scores(records)\n    assert result == {\"n\": -3}\n\n\ndef test_compute_scores_missing_both_keys():\n    \"\"\"边界：record 同时缺少 name 与 value 时，应为 {\"unknown\": 0}。\n\n    期望值来源：规约边界情况（缺省 name -> \"unknown\"，缺省 value -> 0）。\n    \"\"\"\n    records = [{}]\n    result = compute_scores(records)\n    assert result == {\"unknown\": 0}\n\n\n# ---------------------------------------------------------------------------\n# Error / precondition-violation cases\n# ---------------------------------------------------------------------------\n\ndef test_compute_scor