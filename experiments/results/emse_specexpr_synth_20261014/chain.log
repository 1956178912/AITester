          "generated_test": "import pytest\n\nfrom task_0083 import first_item\n\n\n@pytest.fixture\ndef restore_global_list():\n    \"\"\"保存并恢复被测模块的全局 list，避免测试间相互污染。\"\"\"\n    import task_0083\n\n    original = getattr(task_0083, \"list\", None)\n    had_attr = hasattr(task_0083, \"list\")\n    yield task_0083\n    if had_attr:\n        task_0083.list = original\n    elif hasattr(task_0083, \"list\"):\n        delattr(task_0083, \"list\")\n\n\ndef test_first_item_returns_first_element_of_default_list(restore_global_list):\n    \"\"\"默认全局 list 非空时，first_item 返回其第一个元素。\n\n    期望值来源：规约后置条件「返回 list 的第一个元素」。\n    \"\"\"\n    module = restore_global_list\n    module.list = [\"a\", \"b\", \"c\"]\n    assert first_item() == \"a\"\n\n\ndef test_first_item_does_not_modify_global_list(restore_global_list):\n    \"\"\"first_item 调用后不得修改全局 list（后置不变量）。\n\n    期望值来源：规约后置条件「不修改 list」。\n    \"\"\"\n    module = restore_global_list\n    module.list = [\"a\", \"b\", \"c\"]\n    snapshot = list(module.list)\n    first_item()\n    assert module.list == snapshot\n\n\ndef test_first_item_single_element_list(restore_global_list):\n    \"\"\"单元素列表时返回该唯一元素。\n\n    期望值来源：规约边界情况「list 只有一个元素」+ 后置条件。\n    \"\"\"\n    module = restore_global_list\n    module.list = [\"x\"]\n    assert first_item() == \"x\"\n\n\ndef test_first_item_empty_list_raises_index_error(restore_global_list):\n    \"\"\"空列表时触发 IndexError。\n\n    期望值来源：规约边界情况「list 为空时触发 IndexError」。\n    \"\"\"\n    module = restore_global_list\n    module.list = []\n    with pytest.raises(IndexError):\n        first_item()\n\n\ndef test_first_item_non_list_object_behavior(restore_global_list):\n    \"\"\"全局 list 被重新赋值为非列表对象时的行为记录。\n\n    期望值来源不明，需人工确认：规约仅列出该边界情况，未约定具体\n    异常类型或返回值，故此处仅记录实际行为，不做具体值断言。\n    \"\"\"\n    module = restore_global_list\n    module.list = 12345\n    try:\n        result = first_item()\n    except Exception as exc:  # noqa: BLE001 - 探索性记录实际行为\n        assert exc is not None\n    else:\n        # 未抛异常时仅记录返回值存在，不