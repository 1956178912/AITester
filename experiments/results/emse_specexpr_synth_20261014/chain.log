    \"\"\"两字符不同 'ab' 应返回 False。\n\n    期望值来源：规约边界情况「两字符不同 \"ab\"：应返回 False」。\n    \"\"\"\n    s = \"ab\"\n    result = is_palindrome(s)\n    assert result is False\n    assert result == (s == s[::-1])\n\n\ndef test_is_palindrome_with_spaces():\n    \"\"\"含空格但严格字符序列对称的 'a b a' 应返回 True。\n\n    期望值来源：规约边界情况「含空格/标点的回文如 \"a b a\"：按字符严格比较，应返回 True」。\n    \"\"\"\n    s = \"a b a\"\n    result = is_palindrome(s)\n    assert result is True\n    assert result == (s == s[::-1])\n\n\ndef test_is_palindrome_case_sensitive():\n    \"\"\"大小写敏感：'Aa' 逆序为 'aA' 不相等，应返回 False。\n\n    期望值来源：规约边界情况「大小写混合如 \"Aa\"：区分大小写，应返回 False」。\n    \"\"\"\n    s = \"Aa\"\n    result = is_palindrome(s)\n    assert result is False\n    assert result == (s == s[::-1])\n\n\ndef test_is_palindrome_non_ascii():\n    \"\"\"非 ASCII 回文 '上海海上' 按字符比较应返回 True。\n\n    期望值来源：规约边界情况「非 ASCII 字符如 \"上海海上\"：按字符比较，应返回 True」。\n    \"\"\"\n    s = \"上海海上\"\n    result = is_palindrome(s)\n    assert result is True\n    assert result == (s == s[::-1])\n\n\ndef test_is_palindrome_long_string():\n    \"\"\"超长回文字符串应返回 True，验证正确性边界。\n\n    期望值来源：规约边界情况「超长字符串：性能与正确性边界」，\n    以及后置条件 result == (s == s[::-1])。\n    \"\"\"\n    half = \"abcdefghij\" * 1000\n    s = half + half[::-1]\n    result = is_palindrome(s)\n    assert result is True\n    assert result == (s == s[::-1])\n\n\ndef test_is_palindrome_long_non_palindrome():\n    \"\"\"超长非回文字符串应返回 False，验证正确性边界。\n\n    期望值来源：规约边界情况「超长字符串：性能与正确性边界」，\n    以及后置条件 result == (s == s[::-1])。\n    \"\"\"\n    s = (\"abcdefghij\" * 1000) + \"X\"\n    result = is_palindrome(s)\n    assert result is False\n    assert result == (s == s[::-1])\n\n\n# ---------------------------------------------------------------------------\n# 后置条件：返回类型\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\n    \"s\",\n    [\"\", \"a\", \"aa\", \"ab\", \"abcba\", \"abba\", \"hello\", \"a b a\", \"Aa\", \"上海海上\"],\n)\ndef test_is_palindrome_returns_bool(s):