          "generated_test": "import sys\nimport pytest\n\nfrom task_0060 import factorial\n\n\ndef test_factorial_n_zero_returns_one():\n    \"\"\"规约：n == 0 时返回 1（递归基例）。期望值来源：后置条件 n != 0 or result == 1。\"\"\"\n    assert factorial(0) == 1\n\n\ndef test_factorial_n_one_returns_one():\n    \"\"\"规约：n == 1 时返回 1（最小递归情形，1 * factorial(0) = 1）。期望值来源：后置条件 n! 定义。\"\"\"\n    assert factorial(1) == 1\n\n\ndef test_factorial_n_five_returns_120():\n    \"\"\"规约：n > 0 时返回 n!。期望值来源：后置条件 n == 0 or result == n * factorial(n - 1)，5! = 120。\"\"\"\n    assert factorial(5) == 120\n\n\ndef test_factorial_n_ten_returns_3628800():\n    \"\"\"规约：n > 0 时返回 n!。期望值来源：后置条件递归定义，10! = 3628800。\"\"\"\n    assert factorial(10) == 3628800\n\n\n@pytest.mark.parametrize(\"n, expected\", [\n    (0, 1),\n    (1, 1),\n    (2, 2),\n    (3, 6),\n    (4, 24),\n    (5, 120),\n    (6, 720),\n    (7, 5040),\n])\ndef test_factorial_matches_recursive_postcondition(n, expected):\n    \"\"\"规约：n == 0 时返回 1，n > 0 时返回 n * factorial(n-1)。\n    期望值来源：后置条件可执行子句，逐项展开递归定义。\"\"\"\n    assert factorial(n) == expected\n\n\ndef test_factorial_postcondition_relation_for_positive_n():\n    \"\"\"规约：n > 0 时 result == n * factorial(n - 1)。\n    期望值来源：后置条件可执行子句 n == 0 or result == n * factorial(n - 1)。\"\"\"\n    n = 6\n    assert factorial(n) == n * factorial(n - 1)\n\n\ndef test_factorial_negative_n_raises_recursion_error():\n    \"\"\"规约：n < 0 时无正常返回，递归不收敛。\n    期望值来源：边界情况说明（负整数无基例命中，无限递归）。\n    仅验证异常路径被触发，不臆造具体返回值。\"\"\"\n    with pytest.raises(RecursionError):\n        factorial(-1)\n\n\ndef test_factorial_large_n_raises_recursion_error():\n    \"\"\"规约：n 很大时递归深度约 n，可能触发 RecursionError。\n    期望值来源：边界情况说明（受解释器递归深度限制）。\n    仅验证深度溢出异常路径，不臆造具体返回值。\"\"\"\n    with pytest.raises(RecursionError):\n        factorial(100000)\n\n\ndef test_factorial_input_type_is_int():\n    \"\"\"规约：前置条件 n 为 int 类型。\n    期望值来源：前置条件 isinstance(n, int)。\n    探索性断言：仅确认合法 int 输入下函数可被调用并返回 int，需人工确认。\"\"\"\n    result = factorial(3)\n    assert isinstance(result, int)",
