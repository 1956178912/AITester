          "generated_test": "import pytest\n\nfrom task_0059 import aggregate\n\n\nclass TestAggregateNormal:\n    \"\"\"正常路径测试：非空列表返回 sum(values)/len(values)。\"\"\"\n\n    def test_aggregate_multi_element_integers(self):\n        \"\"\"多元素整数列表：期望值来自规约 sum/len = (1+2+3+4)/4 = 2.5。\"\"\"\n        result = aggregate([1, 2, 3, 4])\n        assert result == pytest.approx(2.5)\n        assert isinstance(result, float)\n\n    def test_aggregate_single_element(self):\n        \"\"\"单元素列表 [5]：期望值来自规约 x/1 = 5.0。\"\"\"\n        result = aggregate([5])\n        assert result == pytest.approx(5.0)\n        assert isinstance(result, float)\n\n    def test_aggregate_float_elements(self):\n        \"\"\"浮点列表 [1.5, 2.5]：期望值来自规约 (1.5+2.5)/2 = 2.0。\"\"\"\n        result = aggregate([1.5, 2.5])\n        assert result == pytest.approx(2.0)\n        assert isinstance(result, float)\n\n    def test_aggregate_returns_float_type(self):\n        \"\"\"返回类型应为 float（规约：返回浮点结果）。\"\"\"\n        result = aggregate([2, 4])\n        assert isinstance(result, float)\n\n\nclass TestAggregateBoundary:\n    \"\"\"边界路径测试：负数、零值、混合值。\"\"\"\n\n    def test_aggregate_negative_elements(self):\n        \"\"\"负数列表 [-1, -2, -3]：期望值来自规约 (-1-2-3)/3 = -2.0。\"\"\"\n        result = aggregate([-1, -2, -3])\n        assert result == pytest.approx(-2.0)\n\n    def test_aggregate_all_zeros(self):\n        \"\"\"全零列表 [0, 0, 0]：期望值来自规约 0/3 = 0.0。\"\"\"\n        result = aggregate([0, 0, 0])\n        assert result == pytest.approx(0.0)\n\n    def test_aggregate_zero_and_positive_mixed(self):\n        \"\"\"含零与正数混合 [0, 10]：期望值来自规约 (0+10)/2 = 5.0。\"\"\"\n        result = aggregate([0, 10])\n        assert result == pytest.approx(5.0)\n\n    def test_aggregate_negative_and_positive_mixed(self):\n        \"\"\"正负混合 [-5, 5]：期望值来自规约 (-5+5)/2 = 0.0。\"\"\"\n        result = aggregate([-5, 5])\n        assert result == pytest.approx(0.0)\n\n    def test_aggregate_large_values(self):\n        \"\"\"大数值列表：规约仅说明可能溢出/精度丢失，未给出具体期望值。\n\n        期望值来源不明，需人工确认。此处仅记录实际行为并断言与\n        sum/len 的浮点结果一致（探索性断言）。\n        \"\"\"\n        values = [10**15, 10**15, 10**15]\n        result = aggregate(values)\n        assert result == pytest.approx(sum(values) / len(values))\n\n\nclass TestAggregateErrors:\n    \"\"\"异常路径测试。\"\"\"\n\n    def test_aggregate_empty_list_raises_zero_division(self):\n        \"\"\"空列表 []：规约明确抛出 ZeroDivisionError（历史 bug：空列表除零）。\"\"\"\n        with pytest.raises(ZeroDivisionError):\n            aggregate([])\n\n    def test_aggregate_non_numeric_elements_raises_type_error(self):\n        \"\"\"非数值元素 ['a', 'b']：规约明确 sum 抛 TypeError。\"\"\"\n        with pytest.raises(TypeError):\n            aggregate([\"a\", \"b\"])\n\n\nclass TestAggregateInvariants:\n    \"\"\"不变量测试：不修改入参。\"\"\"\n\n    def test_aggregate_does_not_mutate_input(self):\n        \"\"\"规约：不修改入参 values。\"\"\"\n        values = [1, 2, 3, 4]\n        snapshot = list(values)\n        aggregate(values)\n        assert values == snapshot\n\n    def test_aggregate_does_not_mutate_input_on_error(self):\n        \"\"\"规约：不修改入参 values（异常路径下同样不应修改）。\"\"\"\n        values = []\n        snapshot = list(values)\n        with pytest.raises(ZeroDivisionError):\n            aggregate(values)\n        assert values == snapshot",
