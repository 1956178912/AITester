          "generated_test": "import pytest\n\nfrom task_0078 import normalize, aggregate, report\n\n\nclass TestNormalize:\n    \"\"\"Tests for normalize function.\"\"\"\n\n    def test_normalize_empty_list(self):\n        \"\"\"normalize([]) should return [] since list comprehension over empty list yields [].\"\"\"\n        assert normalize([]) == []\n\n    def test_normalize_single_element(self):\n        \"\"\"normalize([3]) should return [6] since each element is multiplied by 2.\"\"\"\n        assert normalize([3]) == [6]\n\n    def test_normalize_multiple_elements(self):\n        \"\"\"normalize([1, 2, 3]) should return [2, 4, 6].\"\"\"\n        assert normalize([1, 2, 3]) == [2, 4, 6]\n\n    def test_normalize_negative_numbers(self):\n        \"\"\"normalize([-1, -2]) should return [-2, -4].\"\"\"\n        assert normalize([-1, -2]) == [-2, -4]\n\n    def test_normalize_zero(self):\n        \"\"\"normalize([0]) should return [0].\"\"\"\n        assert normalize([0]) == [0]\n\n    def test_normalize_returns_new_list(self):\n        \"\"\"normalize should return a new list, not mutate the input.\"\"\"\n        original = [1, 2, 3]\n        result = normalize(original)\n        assert result == [2, 4, 6]\n        assert original == [1, 2, 3]\n\n    def test_normalize_floats(self):\n        \"\"\"normalize([1.5, 2.5]) should return [3.0, 5.0].\"\"\"\n        assert normalize([1.5, 2.5]) == [3.0, 5.0]\n\n\nclass TestAggregate:\n    \"\"\"Tests for aggregate function.\"\"\"\n\n    def test_aggregate_empty_list(self):\n        \"\"\"aggregate([]) should return {'count': 0, 'total': 0} per docstring/implementation.\"\"\"\n        assert aggregate([]) == {\"count\": 0, \"total\": 0}\n\n    def test_aggregate_single_element(self):\n        \"\"\"aggregate([5]) should return {'count': 1, 'total': 5}.\"\"\"\n        assert aggregate([5]) == {\"count\": 1, \"total\": 5}\n\n    def test_aggregate_multiple_elements(self):\n        \"\"\"aggregate([1, 2, 3]) should return {'count': 3, 'total': 6}.\"\"\"\n        assert aggregate([1, 2, 3]) == {\"count\": 3, \"total\": 6}\n\n    def test_aggregate_negative_numbers(self):\n        \"\"\"aggregate([-1, -2, -3]) should return {'count': 3, 'total': -6}.\"\"\"\n        assert aggregate([-1, -2, -3]) == {\"count\": 3, \"total\": -6}\n\n    def test_aggregate_mixed_signs(self):\n        \"\"\"aggregate([-1, 1]) should return {'count': 2, 'total': 0}.\"\"\"\n        assert aggregate([-1, 1]) == {\"count\": 2, \"total\": 0}\n\n    def test_aggregate_returns_dict(self):\n        \"\"\"aggregate should return a dict with keys 'count' and 'total'.\"\"\"\n        result = aggregate([1, 2])\n        assert isinstance(result, dict)\n        assert set(result.keys()) == {\"count\", \"total\"}\n\n    def test_aggregate_zeros(self):\n        \"\"\"aggregate([0, 0, 0]) should return {'count': 3, 'total': 0}.\"\"\"\n        assert aggregate([0, 0, 0]) == {\"count\": 3, \"total\": 0}\n\n\nclass TestReport:\n    \"\"\"Tests for report function.\"\"\"\n\n    def test_report_empty_list(self):\n        \"\"\"report([]) should return 'count=0 total=0' since normalize([]) == [] and aggregate([]) == {'count': 0, 'total': 0}.\"\"\"\n        assert report([]) == \"count=0 total=0\"\n\n    def test_report_single_element(self):\n        \"\"\"report([1]) -> normalize -> [2] -> aggregate -> {'count': 1, 'total': 2} -> 'count=1 total=2'.\"\"\"\n        assert report([1]) == \"count=1 total=2\"\n\n    def test_report_multiple_elements(self):\n        \"\"\"report([1, 2, 3]) -> normalize -> [2, 4, 6] -> aggregate -> {'count': 3, 'total': 12} -> 'count=3 total=12'.\"\"\"\n        assert report([1, 2, 3]) == \"count=3 total=12\"\n\n    def test_report_negative_numbers(self):\n        \"\"\"report([-1, -2]) -> normalize -> [-2, -4] -> aggregate -> {'count': 2, 'total': -6} -> 'count=2 total=-6'.\"\"\"\n        assert report([-1, -2]) == \"count=2 total=-6\"\n\n    def test_report_zeros(self):\n        \"\"\"report([0, 0]) -> normalize -> [0, 0] -> aggregate -> {'count': 2, 'total': 0} -> 'count=2 total=0'.\"\"\"\n        assert report([0, 0]) == \"count=2 total=0\"\n\n    def test_report_returns_string(self):\n        \"\"\"report should return a string.\"\"\"\n        result = report([1, 2])\n        assert isinstance(result, str)\n\n    def test_report_format(self):\n        \"\"\"report output should match the format 'count=<n> total=<m>'.\"\"\"\n        result = report([5])\n        assert result.startswith(\"count=\")\n        assert \" total=\" in result\n        parts = result.split(\" total=\")\n        assert parts[0].startswith(\"count=\")\n        assert parts[0][len(\"count=\"):].isdigit()\n        assert parts[1].lstrip(\"-\").isdigit()",
