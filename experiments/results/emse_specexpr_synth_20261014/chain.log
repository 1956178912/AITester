          "generated_test": "import pytest\n\nfrom task_0077 import aggregate\n\n\ndef test_aggregate_normal_integer_list():\n    \"\"\"正常多元素整数列表：返回值应为 sum/len。\n\n    期望值来源：规约后置条件 sum(values)/len(values)。\n    \"\"\"\n    values = [1, 2, 3, 4]\n    result = aggregate(values)\n    assert result == pytest.approx(2.5)\n\n\ndef test_aggregate_single_element_returns_element():\n    \"\"\"单元素列表：返回该元素本身。\n\n    期望值来源：规约边界情况\"单元素列表：返回该元素本身\"。\n    \"\"\"\n    values = [5]\n    result = aggregate(values)\n    assert result == pytest.approx(5.0)\n\n\ndef test_aggregate_all_zero_elements():\n    \"\"\"含 0 元素列表：全零输入的平均值为 0。\n\n    期望值来源：规约后置条件 sum/len，sum([0,0,0])==0。\n    \"\"\"\n    values = [0, 0, 0]\n    result = aggregate(values)\n    assert result == pytest.approx(0.0)\n\n\ndef test_aggregate_negative_elements():\n    \"\"\"含负数元素列表：负数累加后求平均。\n\n    期望值来源：规约后置条件 sum/len，sum([-1,-2,-3])==-6，len==3。\n    \"\"\"\n    values = [-1, -2, -3]\n    result = aggregate(values)\n    assert result == pytest.approx(-2.0)\n\n\ndef test_aggregate_float_elements():\n    \"\"\"含浮点数元素列表：浮点累加后求平均。\n\n    期望值来源：规约后置条件 sum/len，sum([1.5,2.5])==4.0，len==2。\n    \"\"\"\n    values = [1.5, 2.5]\n    result = aggregate(values)\n    assert result == pytest.approx(2.0)\n\n\ndef test_aggregate_empty_list_raises_zero_division():\n    \"\"\"空列表：len 为 0，触发 ZeroDivisionError。\n\n    期望值来源：规约边界情况\"空列表 []：len 为 0，触发 ZeroDivisionError\"。\n    \"\"\"\n    with pytest.raises(ZeroDivisionError):\n        aggregate([])\n\n\ndef test_aggregate_does_not_modify_input():\n    \"\"\"后置条件：不修改入参 values。\n\n    期望值来源：规约后置条件\"不修改入参 values\"。\n    \"\"\"\n    values = [1, 2, 3, 4]\n    snapshot = list(values)\n    aggregate(values)\n    assert values == snapshot\n\n\ndef test_aggregate_large_values_behavior():\n    \"\"\"大数值边界：记录实际行为，期望值来源不明，需人工确认。\n\n    规约仅说明\"大数值可能溢出或精度损失\"，未约定具体返回值，\n    因此仅断言结果与 sum/len 的浮点语义一致（探索性断言）。\n    \"\"\"\n    values = [1e308, 1e308]\n    result = aggregate(values)\n    # 期望值来源不明，需人工确认：仅校验与