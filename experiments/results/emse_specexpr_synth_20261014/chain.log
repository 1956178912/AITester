          "generated_test": "import pytest\n\nfrom task_0035 import initials\n\n\n# ---------------------------------------------------------------------------\n# 正常路径\n# ---------------------------------------------------------------------------\n\ndef test_initials_two_word_name():\n    \"\"\"普通双词姓名：每个部分取首字符大写，用 '.' 连接。\n\n    期望值来源：规约后置条件（每个组成部分仅保留首字符并转为大写，\n    以 '.' 连接）。\n    \"\"\"\n    assert initials(\"john doe\") == \"J.D\"\n\n\ndef test_initials_single_word_name():\n    \"\"\"单词姓名：只返回一个首字母。\n\n    期望值来源：规约后置条件（每个组成部分仅保留首字符并转为大写）。\n    \"\"\"\n    assert initials(\"alice\") == \"A\"\n\n\ndef test_initials_three_word_name():\n    \"\"\"三个单词姓名：多元素 parts 连接结果。\n\n    期望值来源：规约后置条件。\n    \"\"\"\n    assert initials(\"john ronald reuel tolkien\") == \"J.R.R.T\"\n\n\n# ---------------------------------------------------------------------------\n# 边界情况\n# ---------------------------------------------------------------------------\n\ndef test_initials_empty_string_returns_empty():\n    \"\"\"空字符串输入返回空字符串。\n\n    期望值来源：规约边界情况（full_name 为空字符串 '' 时返回 ''）。\n    \"\"\"\n    assert initials(\"\") == \"\"\n\n\ndef test_initials_whitespace_only_returns_empty():\n    \"\"\"仅含空白字符时返回空字符串。\n\n    期望值来源：规约边界情况（full_name 仅含空白时返回 ''）。\n    \"\"\"\n    assert initials(\"   \") == \"\"\n\n\ndef test_initials_extra_whitespace_ignored():\n    \"\"\"前后及中间多余空白被 split() 忽略。\n\n    期望值来源：规约边界情况（多个连续空白按 split() 规则忽略空段）。\n    \"\"\"\n    assert initials(\"  john   doe  \") == \"J.D\"\n\n\n# ---------------------------------------------------------------------------\n# 后置条件 / 不变量\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\n    \"full_name\",\n    [\"john doe\", \"alice\", \"john ronald reuel tolkien\", \"\", \"   \", \"  john   doe  \"],\n)\ndef test_initials_returns_str_type(full_name):\n    \"\"\"返回值类型必须为 str。\n\n    期望值来源：规约后置条件（返回值为 str 类型）。\n    \"\"\"\n    result = initials(full_name)\n    assert isinstance(result, str)\n\n\n@pytest.mark.parametrize(\n    \"full_name\",\n    [\"john doe\", \"alice\", \"john ronald reuel tolkien\", \"  john   doe  \"],\n)\ndef test_initials_result_contains_no_whitespace(full_name):\n    \"\"\"返回字符串中不包含原始空白字符。\n\n    期望值来源：规约后置条件（返回字符串中不包含原始空白字符）。\n    \"\"\"\n    result = initials(full_name)\n    assert not any(ch.isspace() for ch in result)\n\n\n@pytest.mark.parametrize(\n    \"full_name, expected\",\n    [\n        (\"john doe\", \"J.D\"),\n        (\"alice\", \"A\"),\n        (\"john ronald reuel tolkien\", \"J.R.R.T\"),\n    ],\n)\ndef test_initials_each_part_is_uppercase_first_char(full_name, expected):\n    \"\"\"每个组成部分仅保留首字符并转为大写。\n\n    期望值来源：规约后置条件；通过对比完整期望字符串间接验证。\n    \"\"\"\n    result = initials(full_name)\n    assert result == expected\n    # 每个以 '.' 分隔的片段应为单个大写字符\n    for part in result.split(\".\"):\n        assert len(part) == 1\n        assert part == part.upper()\n\n\n# ---------------------------------------------------------------------------\n# 异常路径\n# ---------------------------------------------------------------------------\n\ndef test_initials_none_raises_attribute_error():\n    \"\"\"None 输入会抛出 AttributeError。\n\n    期望值来源：规约边界情况（full_name 为 None 时调用 split() 会抛出\n    AttributeError）。具体异常信息取决于运行时，不做断言。\n    \"\"\"\n    with pytest.raises(AttributeError):\n        initials(None)\n\n\ndef test_initials_non_string_raises_attribute_error():\n    \"\"\"非字符串输入（int）会抛出 AttributeError。\n\n    期望值来源：规约边界情况（None.split() 抛 AttributeError）；\n    类型注解限定 str | None，传入 int 同样触发 AttributeError。\n    具体异常信息取决于运行时，不做断言。\n    \"\"\"\n    with pytest.raises(AttributeError):\n        initials(123)\n\n\n# ---------------------------------------------------------------------------\n# 非 ASCII 行为（探索性：期望值来源不明，需人工确认）\n# ---------------------------------------------------------------------------\n\ndef test_initials_non_ascii_uppercase_behavior():\n    \"\"\"非 ASCII 字符的首字符大写行为依赖 str.upper()。\n\n    期望值来源不明，需人工确认：规约仅说明\"依赖 str.upper()\"，\n    未给出具体期望值。此处记录实际行为，仅断言与 str.upper() 一致。\n    \"\"\"\n    full_name = \"élise dupont\"\n    result = initials(full_name)\n    parts = full_name.split()\n    expected = \".\".join(p[0].upper() for p in parts)\n    assert result == expected",
