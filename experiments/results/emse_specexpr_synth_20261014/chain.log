          "generated_test": "import datetime\n\nimport pytest\n\nfrom task_0064 import parse_date\n\n\ndef test_parse_date_normal_date():\n    \"\"\"合法日期字符串应被正确解析为对应 datetime。\n\n    期望值来源：规约后置条件\"合法格式返回对应 datetime\"。\n    \"\"\"\n    result = parse_date(\"2023-01-15\")\n    assert result == datetime.datetime(2023, 1, 15, 0, 0)\n    assert isinstance(result, datetime.datetime)\n\n\ndef test_parse_date_leap_year_boundary():\n    \"\"\"闰年 2 月 29 日为合法日期，应正确解析。\n\n    期望值来源：规约边界情况\"闰年边界 '2024-02-29'\"。\n    \"\"\"\n    result = parse_date(\"2024-02-29\")\n    assert result == datetime.datetime(2024, 2, 29, 0, 0)\n\n\ndef test_parse_date_empty_string_returns_min():\n    \"\"\"空字符串触发 ValueError，应返回 datetime.datetime.min。\n\n    期望值来源：规约后置条件\"格式不匹配或日期非法时返回 datetime.datetime.min\"\n    及边界情况\"空字符串 ''\"。\n    \"\"\"\n    result = parse_date(\"\")\n    assert result == datetime.datetime.min\n\n\ndef test_parse_date_invalid_day_returns_min():\n    \"\"\"格式正确但日期非法（2 月 30 日）应返回 datetime.datetime.min。\n\n    期望值来源：规约边界情况\"格式正确但日期非法如 '2023-02-30'\"。\n    \"\"\"\n    result = parse_date(\"2023-02-30\")\n    assert result == datetime.datetime.min\n\n\ndef test_parse_date_wrong_separator_returns_min():\n    \"\"\"格式错误（使用 '/' 分隔符）应返回 datetime.datetime.min。\n\n    期望值来源：规约边界情况\"格式错误如 '2023/01/01'\"。\n    \"\"\"\n    result = parse_date(\"2023/01/01\")\n    assert result == datetime.datetime.min\n\n\ndef test_parse_date_does_not_raise_value_error_on_invalid_format():\n    \"\"\"非法格式不应抛出 ValueError（被内部捕获）。\n\n    期望值来源：规约后置条件\"不抛出 ValueError（被内部捕获）\"。\n    \"\"\"\n    # 不应抛出异常\n    parse_date(\"not-a-date\")\n    parse_date(\"2023-13-01\")\n    parse_date(\"2023-00-10\")\n\n\ndef test_parse_date_none_input_behavior():\n    \"\"\"非字符串输入 None 的行为记录（探索性）。\n\n    期望值来源不明，需人工确认：规约指出 None 会触发 TypeError 而非\n    ValueError，不被内部捕获，但未明确最终行为。此处仅记录实际行为，\n    不臆造具体返回值。\n    \"\"\"\n    try:\n        result = parse_date(None)\n    except TypeError:\n        # 规约描述：TypeError 不被捕获，符合预期\n        return\n    except ValueError:\n        pytest.fail(\"规约指出 None 不应触发 ValueError\")\n    # 若未抛异常，则记录实际返回值类型，供人工确认\n    assert isinstance(result, datetime.datetime)\n\n\ndef test_parse_date_int_input_behavior():\n    \"\"\"非字符串输入 int 的行为记录（探索性）。\n\n    期望值来源不明，需人工确认：规约指出 int 会触发 TypeError 而非\n    ValueError，不被内部捕获，但未明确最终行为。此处仅记录实际行为，\n    不臆造具体返回值。\n    \"\"\"\n    try:\n        result = parse_date(20230115)\n    except TypeError:\n        # 规约描述：TypeError 不被捕获，符合预期\n        return\n    except ValueError:\n        pytest.fail(\"规约指出 int 不应触发 ValueError\")\n    # 若未抛异常，则记录实际返回值类型，供人工确认\n    assert isinstance(result, datetime.datetime)",
