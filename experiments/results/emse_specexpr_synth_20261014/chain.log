          "generated_test": "import pytest\n\nfrom task_0082 import clamp\n\n\n# ---------------------------------------------------------------------------\n# 正常分支覆盖\n# ---------------------------------------------------------------------------\n\ndef test_clamp_value_less_than_high_returns_high():\n    \"\"\"规约：若 value < high 成立，返回 high。\"\"\"\n    assert clamp(1, 0, 10) == 10\n\n\ndef test_clamp_value_not_less_than_high_and_greater_than_low_returns_low():\n    \"\"\"规约：若 value < high 不成立且 value > low 成立，返回 low。\"\"\"\n    assert clamp(20, 0, 10) == 0\n\n\ndef test_clamp_both_conditions_false_returns_value():\n    \"\"\"规约：若两个条件均不成立，返回 value。\"\"\"\n    assert clamp(5, 10, 0) == 5\n\n\n# ---------------------------------------------------------------------------\n# 边界情况\n# ---------------------------------------------------------------------------\n\ndef test_clamp_value_equals_high():\n    \"\"\"边界：value == high 时 value < high 为假，value > low 为真，返回 low。\"\"\"\n    assert clamp(10, 0, 10) == 0\n\n\ndef test_clamp_value_equals_low():\n    \"\"\"边界：value == low 时 value < high 为真，返回 high。\"\"\"\n    assert clamp(0, 0, 10) == 10\n\n\ndef test_clamp_low_equals_high_and_value_equals_both():\n    \"\"\"边界：low == high == value 时两条件均不成立，返回 value。\"\"\"\n    assert clamp(5, 5, 5) == 5\n\n\ndef test_clamp_value_is_zero():\n    \"\"\"边界：value 为 0，value < high 为真，返回 high。\"\"\"\n    assert clamp(0, -10, 10) == 10\n\n\ndef test_clamp_negative_range():\n    \"\"\"边界：全负数区间，value < high 为真，返回 high。\"\"\"\n    assert clamp(-5, -10, -1) == -1\n\n\ndef test_clamp_max_int_value():\n    \"\"\"边界：value 为极大整数，value < high 为假且 value > low 为真，返回 low。\"\"\"\n    assert clamp(9223372036854775807, 0, 10) == 0\n\n\ndef test_clamp_min_int_value():\n    \"\"\"边界：value 为极小整数，value < high 为真，返回 high。\"\"\"\n    assert clamp(-9223372036854775808, 0, 10) == 10\n\n\n# ---------------------------------------------------------------------------\n# 非法 / 语义异常区间\n# ---------------------------------------------------------------------------\n\ndef test_clamp_low_greater_than_high_invalid_range():\n    \"\"\"非法区间 low > high：两条件均不成立，按规约返回 value。\"\"\"\n    assert clamp(5, 10, 0) == 5\n\n\ndef test_clamp_value_between_low_and_high_returns_high():\n    \"\"\"语义异常：value 位于 low 与 high 之间时，按规约 value < high 为真，返回 high。\"\"\"\n    assert clamp(5, 0, 10) == 10\n\n\n# ---------------------------------------------------------------------------\n# 参数化补充覆盖\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\n    \"value, low, high, expected\",\n    [\n        (1, 0, 10, 10),\n        (20, 0, 10, 0),\n        (5, 10, 0, 5),\n        (10, 0, 10, 0),\n        (0, 0, 10, 10),\n        (5, 5, 5, 5),\n        (0, -10, 10, 10),\n        (-5, -10, -1, -1),\n        (9223372036854775807, 0, 10, 0),\n        (-9223372036854775808, 0, 10, 10),\n        (5, 10, 0, 5),\n        (5, 0, 10, 10),\n    ],\n)\ndef test_clamp_parametrized(value, low, high, expected):\n    \"\"\"参数化覆盖规约中的各分支与边界，期望值均来自规约后置条件。\"\"\"\n    assert clamp(value, low, high) == expected",
