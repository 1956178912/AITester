          "generated_test": "import pytest\n\nfrom task_0053 import mark_positions\n\n\n# ---------------------------------------------------------------------------\n# 辅助：依据规约推导期望值（仅使用规约中明确给出的语义）\n# ---------------------------------------------------------------------------\ndef _expected_by_spec(text: str, ch: str) -> list:\n    \"\"\"依据规约推导期望输出。\n\n    规约：遍历 text 的前 len(text)-1 个字符，若 text[i] == ch 记录 i，否则 -1。\n    返回长度 max(len(text) - 1, 0)。\n    \"\"\"\n    n = max(len(text) - 1, 0)\n    return [i if text[i] == ch else -1 for i in range(n)]\n\n\n# ---------------------------------------------------------------------------\n# 后置条件 / 不变量：通用性质检查\n# ---------------------------------------------------------------------------\n@pytest.mark.parametrize(\n    \"text, ch\",\n    [\n        (\"abcabc\", \"a\"),\n        (\"aaaa\", \"a\"),\n        (\"abcd\", \"z\"),\n        (\"\", \"a\"),\n        (\"a\", \"a\"),\n        (\"abca\", \"a\"),\n        (\"abc\", \"\"),\n        (\"abcabc\", \"ab\"),\n        (\"hello world\", \"o\"),\n        (\"xyz\", \"x\"),\n    ],\n)\ndef test_mark_positions_returns_list_and_length_invariant(text, ch):\n    \"\"\"后置条件：返回值为 list，且 len(result) == max(len(text) - 1, 0)。\"\"\"\n    result = mark_positions(text, ch)\n    assert isinstance(result, list)\n    assert len(result) == max(len(text) - 1, 0)\n\n\n@pytest.mark.parametrize(\n    \"text, ch\",\n    [\n        (\"abcabc\", \"a\"),\n        (\"aaaa\", \"a\"),\n        (\"abcd\", \"z\"),\n        (\"\", \"a\"),\n        (\"a\", \"a\"),\n        (\"abca\", \"a\"),\n        (\"abc\", \"\"),\n        (\"abcabc\", \"ab\"),\n        (\"hello world\", \"o\"),\n        (\"xyz\", \"x\"),\n    ],\n)\ndef test_mark_positions_elements_are_index_or_minus_one(text, ch):\n    \"\"\"后置条件：每个元素要么等于其下标 i，要么等于 -1。\"\"\"\n    result = mark_positions(text, ch)\n    assert all(result[i] == i or result[i] == -1 for i in range(len(result)))\n\n\n@pytest.mark.parametrize(\n    \"text, ch\",\n    [\n        (\"abc