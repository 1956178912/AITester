          "generated_test": "import pytest\n\nfrom task_0071 import lookup\n\n\n# 规约中声明的模块级常量字典（用于推导期望值，不依赖实现内部符号）\n_TABLE = {\"alpha\": 1, \"beta\": 2, \"gamma\": 3}\n\n\n@pytest.mark.parametrize(\n    \"key, expected\",\n    [\n        (\"alpha\", 1),\n        (\"beta\", 2),\n        (\"gamma\", 3),\n    ],\n)\ndef test_lookup_hit_existing_key_returns_table_value(key, expected):\n    \"\"\"命中 _TABLE 中的键时，返回值应等于 _TABLE[key]。\n\n    期望值来源：规约「若 key 在 _TABLE 中，返回值等于 _TABLE[key]」。\n    \"\"\"\n    result = lookup(key)\n    assert result == expected\n    assert result == _TABLE[key]\n\n\n@pytest.mark.parametrize(\n    \"key\",\n    [\"delta\", \"\", \"Alpha\", \"ALPHA\", \"Beta\", \"gamma \", \" gamma\"],\n)\ndef test_lookup_miss_returns_zero(key):\n    \"\"\"未命中 _TABLE 的字符串键应返回 0。\n\n    期望值来源：规约「若 key 不在 _TABLE 中，返回值为 0」，\n    以及边界情况「空字符串」「大小写变体」。\n    \"\"\"\n    assert key not in _TABLE\n    assert lookup(key) == 0\n\n\ndef test_lookup_empty_string_returns_zero():\n    \"\"\"空字符串键未命中，返回 0。\n\n    期望值来源：边界情况「key 为空字符串 \"\"（未命中，返回 0）」。\n    \"\"\"\n    assert lookup(\"\") == 0\n\n\ndef test_lookup_case_sensitive_returns_zero():\n    \"\"\"键匹配大小写敏感，\"Alpha\" 未命中返回 0。\n\n    期望值来源：边界情况「key 为大小写变体如 \"Alpha\"（未命中，返回 0）」。\n    \"\"\"\n    assert lookup(\"Alpha\") == 0\n\n\ndef test_lookup_none_key_returns_zero_without_exception():\n    \"\"\"None 作为键时未命中返回 0，且不抛异常。\n\n    期望值来源：边界情况「key 为 None 或非 str 类型（dict.get 可接受任意\n    可哈希对象，返回 0，不抛异常）」。\n    \"\"\"\n    result = lookup(None)\n    assert result == 0\n\n\n@pytest.mark.parametrize(\"key\", [1, 2.5, (\"alpha\",), frozenset({\"alpha\"})])\ndef test_lookup_non_str_hashable_key_returns_zero(key):\n    \"\"\"非 str 的可哈希对象作为键时未命中返回 0，且不抛异常。\n\n    期望值来源：边界情况「key 为 None 或非 str 类型（dict.get 可接受任意\n    可哈希对象，返回 0，不抛异常）」。\n    \"\"\"\n    assert lookup(key) == 0\n\n\n@pytest.mark.parametrize(\n    \"key\",\n    [\"alpha\", \"beta\", \"gamma\", \"delta\", \"\", \"Alpha\", None],\n)\ndef test_lookup_return_type_is_int(key):\n    \"\"\"返回值类型必须为 int，且满足 result >= 0。\n\n    期望值来源：后置条件「返回值类型为 int」「result >= 0」。\n    \"\"\"\n    result = lookup(key)\n    assert isinstance(result, int)\n    assert result >= 0\n\n\n@pytest.mark.parametrize(\n    \"key\",\n    [\"alpha\", \"beta\", \"gamma\", \"delta\", \"\", \"Alpha\", None],\n)\ndef test_lookup_result_matches_spec_contract(key):\n    \"\"\"综合校验：命中返回 _TABLE[key]，未命中返回 0。\n\n    期望值来源：规约中「若 key 在 _TABLE 中，返回值等于 _TABLE[key]；\n    若 key 不在 _TABLE 中，返回值为 0」。\n    \"\"\"\n    result = lookup(key)\n    if key in _TABLE:\n        assert result == _TABLE[key]\n    else:\n        assert result == 0",
