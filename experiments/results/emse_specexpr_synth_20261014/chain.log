          "generated_test": "import pytest\n\nfrom task_0032 import get_second\n\n\nclass TestGetSecondNormal:\n    \"\"\"正常场景：列表长度大于 1 时返回第二个元素。\"\"\"\n\n    def test_get_second_multi_element_list(self):\n        \"\"\"规约：返回值为 lst 的第二个元素。输入 [1, 2, 3] 期望 2。\"\"\"\n        assert get_second([1, 2, 3]) == 2\n\n    def test_get_second_exactly_two_elements(self):\n        \"\"\"规约：恰好两个元素时返回第二个元素。输入 [\"a\", \"b\"] 期望 \"b\"。\"\"\"\n        assert get_second([\"a\", \"b\"]) == \"b\"\n\n    def test_get_second_returns_second_not_first(self):\n        \"\"\"规约：返回第二个元素而非第一个。输入 [10, 20] 期望 20。\"\"\"\n        assert get_second([10, 20]) == 20\n\n    def test_get_second_second_element_is_none(self):\n        \"\"\"规约：第二个元素本身为 None 时原样返回 None（与长度不足返回 None 区分）。\"\"\"\n        assert get_second([1, None, 3]) is None\n\n    def test_get_second_second_element_is_mutable_object(self):\n        \"\"\"规约：元素为可变对象时返回该对象本身（同一引用）。\"\"\"\n        inner = [1, 2]\n        result = get_second([0, inner, 3])\n        assert result is inner\n\n\nclass TestGetSecondBoundary:\n    \"\"\"边界场景：长度不超过 1 时返回 None。\"\"\"\n\n    def test_get_second_empty_list(self):\n        \"\"\"规约：空列表返回 None。\"\"\"\n        assert get_second([]) is None\n\n    def test_get_second_single_element_list(self):\n        \"\"\"规约：单元素列表返回 None。输入 [42] 期望 None。\"\"\"\n        assert get_second([42]) is None\n\n    def test_get_second_single_none_element_list(self):\n        \"\"\"规约：单元素列表（元素为 None）返回 None。\"\"\"\n        assert get_second([None]) is None\n\n\nclass TestGetSecondInvariants:\n    \"\"\"不变量：不修改入参 lst。\"\"\"\n\n    def test_get_second_does_not_modify_input_multi(self):\n        \"\"\"规约：不修改入参。多元素列表调用后内容与长度不变。\"\"\"\n        lst = [1, 2, 3]\n        snapshot = list(lst)\n        get_second(lst)\n        assert lst == snapshot\n\n    def test_get_second_does_not_modify_input_empty(self):\n        \"\"\"规约：不修改入参。空列表调用后仍为空。\"\"\"\n        lst = []\n        get_second(lst)\n        assert lst == []\n\n    def test_get_second_does_not_modify_input_single(self):\n        \"\"\"规约：不修改入参。单元素列表调用后内容不变。\"\"\"\n        lst = [42]\n        get_second(lst)\n        assert lst == [42]\n\n\nclass TestGetSecondError:\n    \"\"\"错误场景：不满足前置条件的输入。\n\n    规约仅声明前置条件为「可调用 len() 且支持下标访问的对象（类型注解为 list）」，\n    未约定传入非列表时的异常类型，故此处仅记录实际行为，需人工确认。\n    \"\"\"\n\n    def test_get_second_non_list_int_input(self):\n        \"\"\"期望值来源不明，需人工确认：传入 int 时规约未约定异常类型。\n\n        仅断言调用会抛出异常（TypeError 或其它），不臆造具体异常类型。\n        \"\"\"\n        with pytest.raises(Exception):\n            get_second(123)\n\n    def test_get_second_none_input(self):\n        \"\"\"期望值来源不明，需人工确认：传入 None 时规约未约定异常类型。\n\n        仅断言调用会抛出异常（TypeError 或其它），不臆造具体异常类型。\n        \"\"\"\n        with pytest.raises(Exception):\n            get_second(None)",
