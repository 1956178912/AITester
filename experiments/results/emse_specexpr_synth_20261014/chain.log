          "generated_test": "import pytest\n\nfrom task_0009 import initials\n\n\n# ---------------------------------------------------------------------------\n# 正常路径\n# ---------------------------------------------------------------------------\n\ndef test_initials_multiple_words():\n    \"\"\"多部分姓名：每个部分取首字符大写，用 '.' 连接。\n\n    期望值来源：规约后置条件「返回字符串由各部分首字符大写以 '.' 连接」。\n    \"\"\"\n    assert initials(\"john doe smith\") == \"J.D.S\"\n\n\ndef test_initials_single_word():\n    \"\"\"单个单词：只返回一个首字母（大写）。\n\n    期望值来源：规约后置条件 + 边界情况「单个单词」。\n    \"\"\"\n    assert initials(\"alice\") == \"A\"\n\n\ndef test_initials_non_ascii():\n    \"\"\"非 ASCII 字符：首字符大写后以 '.' 连接。\n\n    期望值来源：规约边界情况「非 ASCII 字符」。\n    \"\"\"\n    assert initials(\"josé maría\") == \"J.M\"\n\n\n# ---------------------------------------------------------------------------\n# 边界路径\n# ---------------------------------------------------------------------------\n\ndef test_initials_empty_string():\n    \"\"\"空字符串：split 后无部分，返回空字符串。\n\n    期望值来源：规约后置条件「空字符串/纯空白返回空字符串」。\n    \"\"\"\n    assert initials(\"\") == \"\"\n\n\ndef test_initials_whitespace_only():\n    \"\"\"纯空白字符串：split 后无部分，返回空字符串。\n\n    期望值来源：规约后置条件「空字符串/纯空白返回空字符串」。\n    \"\"\"\n    assert initials(\"   \") == \"\"\n\n\ndef test_initials_leading_trailing_spaces():\n    \"\"\"前导/尾随空格：应被忽略，仅取有效部分首字符。\n\n    期望值来源：规约边界情况「前导/尾随空格」+ 后置条件。\n    \"\"\"\n    assert initials(\"  john doe  \") == \"J.D\"\n\n\ndef test_initials_multiple_consecutive_spaces():\n    \"\"\"多个连续空格：视为单一分隔符。\n\n    期望值来源：规约边界情况「多个连续空格」+ 后置条件。\n    \"\"\"\n    assert initials(\"john   doe\") == \"J.D\"\n\n\ndef test_initials_tabs_and_newlines():\n    \"\"\"含制表符/换行符：任意空白字符均作为分隔符。\n\n    期望值来源：规约边界情况「含制表符/换行符」+ 后置条件。\n    \"\"\"\n    assert initials(\"john\\tdoe\\nsmith\") == \"J.D.S\"\n\n\ndef test_initials_digit_start():\n    \"\"\"数字开头：数字部分首字符大写（数字不变）。\n\n    期望值来源：规约边界情况「数字或符号开头」+ 后置条件。\n    \"\"\"\n    assert initials(\"123 abc\") == \"1.A\"\n\n\n# ------------------------------------