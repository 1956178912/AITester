egative_values():\n    \"\"\"边界：value 为 0 与负数，期望值来自规约边界情况。\"\"\"\n    records = [\n        {\"name\": \"z\", \"value\": 0},\n        {\"name\": \"n\", \"value\": -5},\n    ]\n    result = compute_scores(records)\n    assert isinstance(result, dict)\n    assert result == {\"z\": 0, \"n\": -5}\n    assert len(result) <= len(records)\n\n\ndef test_compute_scores_boundary_large_value():\n    \"\"\"边界：value 为大数，期望值来自规约边界情况。\"\"\"\n    big = 10 ** 18\n    records = [{\"name\": \"big\", \"value\": big}]\n    result = compute_scores(records)\n    assert isinstance(result, dict)\n    assert result == {\"big\": big}\n    assert len(result) <= len(records)\n\n\ndef test_compute_scores_postcondition_len_not_exceed_input():\n    \"\"\"后置条件：结果长度不超过输入记录数（含重复键场景）。\"\"\"\n    records = [\n        {\"name\": \"a\", \"value\": 1},\n        {\"name\": \"a\", \"value\": 2},\n        {\"name\": \"b\", \"value\": 3},\n    ]\n    result = compute_scores(records)\n    assert isinstance(result, dict)\n    assert len(result) <= len(records)\n\n\ndef test_compute_scores_invariant_keys_are_strings():\n    \"\"\"不变量：结果键均为字符串（规约不变量子句）。\"\"\"\n    records = [\n        {\"name\": \"a\", \"value\": 1},\n        {},\n        {\"name\": \"b\", \"value\": 2},\n    ]\n    result = compute_scores(records)\n    assert isinstance(result, dict)\n    assert all(isinstance(k, str) for k in result)\n\n\ndef test_compute_scores_error_element_without_get():\n    \"\"\"异常：元素无 get 方法时预期抛 AttributeError。\n\n    期望值来源：规约边界情况明确说明 record 缺少 get 方法 → AttributeError。\n    \"\"\"\n    records = [123]\n    with pytest.raises(AttributeError):\n        compute_scores(records)",
