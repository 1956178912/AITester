          "generated_test": "import datetime\n\nimport pytest\n\nfrom task_0064 import days_until\n\n\ndef _expected_days(target: str) -> int:\n    \"\"\"依据规约计算期望值：parse_date(target) - now 的 days 分量。\n\n    规约说明非法日期时 parse_date 返回 datetime.min，因此这里对非法\n    输入也按 datetime.min 处理，与规约描述一致。\n    \"\"\"\n    try:\n        parsed = datetime.datetime.strptime(target, \"%Y-%m-%d\")\n    except ValueError:\n        parsed = datetime.datetime.min\n    return (parsed - datetime.datetime.now()).days\n\n\ndef test_days_until_returns_int_for_future_date():\n    \"\"\"未来日期应返回 int 且为正数（规约：未来日期返回正数）。\"\"\"\n    result = days_until(\"2999-12-31\")\n    assert isinstance(result, int)\n    assert result > 0\n\n\ndef test_days_until_returns_int_for_past_date():\n    \"\"\"过去日期应返回 int 且为负数（规约：过去日期返回负数）。\"\"\"\n    result = days_until(\"1970-01-01\")\n    assert isinstance(result, int)\n    assert result < 0\n\n\ndef test_days_until_today_boundary_is_zero_or_negative_one():\n    \"\"\"今天日期边界：days 可能为 0 或 -1，取决于当前时刻。\n\n    期望值来源：规约边界情况描述。\n    \"\"\"\n    today = datetime.datetime.now().strftime(\"%Y-%m-%d\")\n    result = days_until(today)\n    assert isinstance(result, int)\n    assert result in (0, -1)\n\n\ndef test_days_until_min_date_returns_large_negative():\n    \"\"\"最小日期 \"0001-01-01\" 应返回极大负数。\n\n    期望值来源：规约边界情况描述（datetime.min 对应日期）。\n    \"\"\"\n    result = days_until(\"0001-01-01\")\n    assert isinstance(result, int)\n    assert result < 0\n    # 与 datetime.min 到当前时刻的天数一致\n    expected = (datetime.datetime.min - datetime.datetime.now()).days\n    assert result == expected\n\n\ndef test_days_until_empty_string_uses_min_date_path():\n    \"\"\"空字符串触发 ValueError 异常路径，parse_date 返回 datetime.min。\n\n    期望值来源：规约边界情况描述（非法日期走 datetime.min 路径）。\n    \"\"\"\n    result = days_until(\"\")\n    assert isinstance(result, int)\n    assert result == _expected_days(\"\")\n\n\ndef test_days_until_invalid_text_uses_min_date_path():\n    \"\"\"非日期文本触发 ValueError 异常路径，返回 datetime.min 对应天数。\n\n