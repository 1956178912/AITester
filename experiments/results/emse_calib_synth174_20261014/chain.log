          "generated_test": "import math\n\nimport pytest\n\nfrom task_0026 import rounded_ratio\n\n\ndef test_rounded_ratio_zero_total_returns_zero():\n    \"\"\"total 为 0 时应返回 0.0（依据源码分支 total == 0 -> return 0.0）。\"\"\"\n    assert rounded_ratio(0, 0) == 0.0\n    assert rounded_ratio(5, 0) == 0.0\n    assert rounded_ratio(100, 0) == 0.0\n\n\ndef test_rounded_ratio_returns_float_type():\n    \"\"\"返回值类型应为 float（依据类型注解 -> float）。\"\"\"\n    result = rounded_ratio(1, 2)\n    assert isinstance(result, float)\n\n\ndef test_rounded_ratio_full_hit_returns_one():\n    \"\"\"hit == total 时 hit/total*100 == 100，floor(100)/100 == 1.0。\"\"\"\n    assert rounded_ratio(10, 10) == 1.0\n    assert rounded_ratio(1, 1) == 1.0\n    assert rounded_ratio(100, 100) == 1.0\n\n\ndef test_rounded_ratio_zero_hit_returns_zero():\n    \"\"\"hit 为 0 且 total 非 0 时结果为 0.0。\"\"\"\n    assert rounded_ratio(0, 10) == 0.0\n    assert rounded_ratio(0, 1) == 0.0\n\n\ndef test_rounded_ratio_floors_to_two_decimals():\n    \"\"\"结果应为向下取整到两位小数（依据 math.floor(x*100)/100 实现）。\n\n    1/3 * 100 = 33.333... -> floor -> 33 -> 0.33\n    \"\"\"\n    assert rounded_ratio(1, 3) == 0.33\n    assert rounded_ratio(2, 3) == 0.66\n\n\ndef test_rounded_ratio_floor_not_round():\n    \"\"\"验证是向下取整而非四舍五入。\n\n    2/3 * 100 = 66.666... 四舍五入为 0.67，向下取整为 0.66。\n    \"\"\"\n    assert rounded_ratio(2, 3) == 0.66\n    assert rounded_ratio(2, 3) != 0.67\n\n\ndef test_rounded_ratio_exact_two_decimals():\n    \"\"\"恰好两位小数时结果保持精确值。\"\"\"\n    assert rounded_ratio(1, 4) == 0.25\n    assert rounded_ratio(3, 4) == 0.75\n    assert rounded_ratio(1, 2) == 0.5\n\n\ndef test_rounded_ratio_result_within_zero_one_range():\n    \"\"\"当 0 <= hit <= total 时结果应落在 [0.0, 1.0] 区间。\"\"\"\n    for hit, total in [(0, 5), (1, 5), (2, 5), (3, 5), (4, 5), (5, 5)]:\n        result = rounded_ratio(hit, total)\n        assert 0.0 <= result <= 1.0\n\n\n@pytest.mark.parametrize(\n    \"hit,total,expected\",\n    [\n        (0, 0, 0.0),\n        (1, 1, 1.0),\n        (0, 1, 0.0),\n        (1, 2, 0.5),\n        (1, 4, 0.25),\n        (3, 4, 0.75),\n        (1, 3, 0.33),\n        (2, 3, 0.66),\n        (1, 10, 0.1),\n        (9, 10, 0.9),\n    ],\n)\ndef test_rounded_ratio_parametrized(hit, total, expected):\n    \"\"\"参数化验证常见输入下的向下取整结果。\n\n    期望值来源：由源码 math.floor(hit / total * 100) / 100 直接推导。\n    \"\"\"\n    assert rounded_ratio(hit, total) == expected\n\n\ndef test_rounded_ratio_floor_matches_manual_computation():\n    \"\"\"结果应与手工按 floor 公式计算一致（探索性一致性校验）。\"\"\"\n    for hit, total in [(7, 9), (13, 17), (22, 7), (5, 8), (99, 100)]:\n        expected = math.floor(hit / total * 100) / 100\n        assert rounded_ratio(hit, total) == expected",
