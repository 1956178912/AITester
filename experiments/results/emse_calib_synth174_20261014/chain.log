          "generated_test": "import pytest\nfrom collections import OrderedDict, defaultdict\nfrom task_0029 import compute_scores\n\n\n# ---------------------------------------------------------------------------\n# 正常路径\n# ---------------------------------------------------------------------------\n\ndef test_compute_scores_normal_multiple_records():\n    \"\"\"正常多记录：验证常规输入下正确构建字典。\n\n    期望值来源：规约后置条件 result[record.get(\"name\",\"unknown\")] == record.get(\"value\",0)\n    \"\"\"\n    records = [{\"name\": \"a\", \"value\": 1}, {\"name\": \"b\", \"value\": 2}]\n    result = compute_scores(records)\n    assert isinstance(result, dict)\n    assert result == {\"a\": 1, \"b\": 2}\n\n\ndef test_compute_scores_returns_dict_type():\n    \"\"\"后置条件：返回值类型为 dict。\"\"\"\n    result = compute_scores([{\"name\": \"a\", \"value\": 1}])\n    assert isinstance(result, dict)\n\n\ndef test_compute_scores_len_not_greater_than_records():\n    \"\"\"后置条件：len(result) <= len(records)。\"\"\"\n    records = [{\"name\": \"a\", \"value\": 1}, {\"name\": \"b\", \"value\": 2}]\n    result = compute_scores(records)\n    assert len(result) <= len(records)\n\n\ndef test_compute_scores_keys_are_str_invariant():\n    \"\"\"不变量：所有键均为 str 类型。\"\"\"\n    records = [{\"name\": \"a\", \"value\": 1}, {\"value\": 2}]\n    result = compute_scores(records)\n    assert all(isinstance(k, str) for k in result)\n\n\n# ---------------------------------------------------------------------------\n# 边界情况\n# ---------------------------------------------------------------------------\n\ndef test_compute_scores_empty_list_returns_empty_dict():\n    \"\"\"边界：records 为空列表 → 返回 {}。\"\"\"\n    result = compute_scores([])\n    assert result == {}\n    assert isinstance(result, dict)\n\n\ndef test_compute_scores_missing_name_defaults_unknown():\n    \"\"\"边界：record 缺少 \"name\" 键 → 键为 \"unknown\"。\"\"\"\n    result = compute_scores([{\"value\": 5}])\n    assert result == {\"unknown\": 5}\n\n\ndef test_compute_scores_missing_value_defaults_zero():\n    \"\"\"边界：record 缺少 \"value\" 键 → 值为 0。\"\"\"\n    result = compute_scores([{\"name\": \"a\"}])\n    assert result == {\"a\": 0}\n\n\ndef test_compute_scores_duplicate_name_last_wins():\n    \"\"\"边界：多条记录 name 相同 → 后值覆盖前值。\"\"\"\n    records = [{\"name\": \"a\", \"value\": 1}, {\"name\": \"a\", \"value\": 2}]\n    result = compute_scores(records)\n    assert result == {\"a\": 2}\n\n\ndef test_compute_scores_value_zero_preserved():\n    \"\"\"边界：value 为 0 时原样保留（0 不应被当作缺省处理）。\"\"\"\n    result = compute_scores([{\"name\": \"a\", \"value\": 0}])\n    assert result == {\"a\": 0}\n\n\ndef test_compute_scores_value_negative_preserved():\n    \"\"\"边界：value 为负数时原样保留。\"\"\"\n    result = compute_scores([{\"name\": \"a\", \"value\": -3}])\n    assert result == {\"a\": -3}\n\n\ndef test_compute_scores_value_large_number_preserved():\n    \"\"\"边界：value 为大数时原样保留。\"\"\"\n    big = 10 ** 18\n    result = compute_scores([{\"name\": \"a\", \"value\": big}])\n    assert result == {\"a\": big}\n\n\ndef test_compute_scores_missing_both_keys():\n    \"\"\"边界：record 同时缺少 name 与 value → {\"unknown\": 0}。\"\"\"\n    result = compute_scores([{}])\n    assert result == {\"unknown\": 0}\n\n\ndef test_compute_scores_other_mapping_type_ordereddict():\n    \"\"\"边界：record 为其他映射类型（OrderedDict）也应支持 get。\"\"\"\n    records = [OrderedDict([(\"name\", \"a\"), (\"value\", 1)])]\n    result = compute_scores(records)\n    assert result == {\"a\": 1}\n\n\ndef test_compute_scores_other_mapping_type_defaultdict():\n    \"\"\"边界：record 为 defaultdict 也应支持 get。\"\"\"\n    d = defaultdict(int)\n    d[\"name\"] = \"a\"\n    d[\"value\"] = 7\n    result = compute_scores([d])\n    assert result == {\"a\": 7}\n\n\n# ---------------------------------------------------------------------------\n# 异常路径（前置条件不满足）\n# ---------------------------------------------------------------------------\n\ndef test_compute_scores_record_without_get_raises():\n    \"\"\"异常：record 无 get 方法（非映射）→ 期望抛出 AttributeError。\n\n    期望值来源：规约前置条件要求每个 record 支持 get 方法；\n    违反前件时行为未在规约中定义，此处仅验证其不会静默返回错误结果。\n    \"\"\"\n    with pytest.raises(AttributeError):\n        compute_scores([123])\n\n\ndef test_compute_scores_records_none_raises():\n    \"\"\"异常：records 为 None（不可迭代）→ 期望抛出 TypeError。\n\n    期望值来源：规约前置条件要求 records 为可迭代对象；\n    违反前件时行为未在规约中定义，此处仅验证其不会静默返回错误结果。\n    \"\"\"\n    with pytest.raises(TypeError):\n        compute_scores(None)",
