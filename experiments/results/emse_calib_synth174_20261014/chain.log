          "generated_test": "import pytest\n\nfrom task_0058 import is_palindrome\n\n\n# ---------------------------------------------------------------------------\n# 正常用例\n# ---------------------------------------------------------------------------\n\ndef test_is_palindrome_odd_length_palindrome():\n    \"\"\"普通奇数长度回文 'level' 应返回 True。\n\n    期望值来源：规约后置条件 result == (s == s[::-1])。\n    \"\"\"\n    assert is_palindrome(\"level\") is True\n\n\ndef test_is_palindrome_even_length_palindrome():\n    \"\"\"普通偶数长度回文 'abba' 应返回 True。\n\n    期望值来源：规约后置条件 result == (s == s[::-1])。\n    \"\"\"\n    assert is_palindrome(\"abba\") is True\n\n\ndef test_is_palindrome_non_palindrome_first_last_differ():\n    \"\"\"非回文 'hello' 应返回 False。\n\n    期望值来源：规约后置条件 result == (s == s[::-1])。\n    \"\"\"\n    assert is_palindrome(\"hello\") is False\n\n\ndef test_is_palindrome_non_palindrome_middle_differs():\n    \"\"\"仅中间字符不同的非回文 'abca' 应返回 False。\n\n    期望值来源：规约后置条件 result == (s == s[::-1])。\n    \"\"\"\n    assert is_palindrome(\"abca\") is False\n\n\n# ---------------------------------------------------------------------------\n# 边界用例\n# ---------------------------------------------------------------------------\n\ndef test_is_palindrome_empty_string():\n    \"\"\"空字符串反转仍为空串，应返回 True。\n\n    期望值来源：规约边界情况「空字符串」。\n    \"\"\"\n    assert is_palindrome(\"\") is True\n\n\ndef test_is_palindrome_single_character():\n    \"\"\"单字符字符串必为回文，应返回 True。\n\n    期望值来源：规约边界情况「单字符字符串」。\n    \"\"\"\n    assert is_palindrome(\"a\") is True\n\n\ndef test_is_palindrome_two_identical_characters():\n    \"\"\"双字符相同 'aa' 应返回 True（最小偶数长度回文）。\n\n    期望值来源：规约边界情况「双字符相同/不同」。\n    \"\"\"\n    assert is_palindrome(\"aa\") is True\n\n\ndef test_is_palindrome_two_different_characters():\n    \"\"\"双字符不同 'ab' 应返回 False（最小非回文）。\n\n    期望值来源：规约边界情况「双字符相同/不同」。\n    \"\"\"\n    assert is_palindrome(\"ab\") is False\n\n\ndef test_is_palindrome_all_same_characters():\n    \"\"\"全相同字符 'aaaaa' 应返回 True。\n\n    期望值来源：规约边界情况「全相同字符」。\n    \"\"\"\n    assert is_palindrome(\"aaaaa\") is True\n\n\ndef test_is_palindrome_case_sensitive():\n    \"\"\"大小写敏感：'Aa' 反转后为 'aA'，不相等，应返回 False。\n\n    期望值来源：规约边界情况「大小写敏感」。\n    \"\"\"\n    assert is_palindrome(\"Aa\") is False\n\n\ndef test_is_palindrome_with_spaces_and_punctuation():\n    \"\"\"含空格与标点按原样比较，'A man, a plan, a canal: Panama' 应返回 False。\n\n    期望值来源：规约边界情况「含空格/标点：按原样比较」。\n    \"\"\"\n    assert is_palindrome(\"A man, a plan, a canal: Panama\") is False\n\n\ndef test_is_palindrome_unicode_palindrome():\n    \"\"\"含 Unicode 字符的回文 '上海自来水来自海上' 应返回 True。\n\n    期望值来源：规约边界情况「含 Unicode/emoji 字符」。\n    \"\"\"\n    assert is_palindrome(\"上海自来水来自海上\") is True\n\n\ndef test_is_palindrome_unicode_emoji_palindrome():\n    \"\"\"含 emoji 的回文 '😀a😀' 应返回 True。\n\n    期望值来源：规约边界情况「含 Unicode/emoji 字符」。\n    \"\"\"\n    assert is_palindrome(\"😀a😀\") is True\n\n\ndef test_is_palindrome_long_string():\n    \"\"\"超长回文串（'a' * 10000）应返回 True，验证切片反转无异常。\n\n    期望值来源：规约边界情况「超长字符串」。\n    \"\"\"\n    s = \"a\" * 10000\n    assert is_palindrome(s) is True\n\n\ndef test_is_palindrome_long_non_palindrome():\n    \"\"\"超长非回文串应返回 False，验证切片反转无异常。\n\n    期望值来源：规约后置条件 result == (s == s[::-1])。\n    \"\"\"\n    s = \"a\" * 9999 + \"b\"\n    assert is_palindrome(s) is False\n\n\n# ---------------------------------------------------------------------------\n# 后置条件：返回值类型\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\n    \"s\",\n    [\"\", \"a\", \"aa\", \"ab\", \"level\", \"hello\", \"上海自来水来自海上\"],\n)\ndef test_is_palindrome_returns_bool_type(s):\n    \"\"\"返回值必须为 bool 类型。\n\n    期望值来源：规约后置条件 isinstance(result, bool)。\n    \"\"\"\n    result = is_palindrome(s)\n    assert isinstance(result, bool)\n\n\n# ---------------------------------------------------------------------------\n# 后置条件：result == (s == s[::-1]) 的通用一致性\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\n    \"s\",\n    [\n        \"\",\n        \"a\",\n        \"aa\",\n        \"ab\",\n        \"aba\",\n        \"abba\",\n        \"abcba\",\n        \"abcd\",\n        \"aaaaa\",\n        \"Aa\",\n        \"A man, a plan, a canal: Panama\",\n        \"上海自来水来自海上\",\n        \"😀a😀\",\n        \"12321\",\n        \"12345\",\n    ],\n)\ndef test_is_palindrome_matches_reverse_equality(s):\n    \"\"\"返回值应与 s == s[::-1] 完全一致。\n\n    期望值来源：规约后置条件 result == (s == s[::-1])。\n    \"\"\"\n    assert is_palindrome(s) == (s == s[::-1])\n\n\n# ---------------------------------------------------------------------------\n# 后置条件：函数不修改入参（字符串不可变，验证调用前后一致）\n# ---------------------------------------------------------------------------\n\ndef test_is_palindrome_does_not_modify_input():\n    \"\"\"函数不应修改入参 s（字符串不可变，验证调用前后值一致）。\n\n    期望值来源：规约后置条件「函数不修改入参 s」。\n    \"\"\"\n    s = \"level\"\n    original = s\n    is_palindrome(s)\n    assert s == original\n\n\n# ---------------------------------------------------------------------------\n# 非 str 入参：规约未约定具体行为，采用探索性断言\n# ---------------------------------------------------------------------------\n\ndef test_is_palindrome_none_input_behavior():\n    \"\"\"非 str 入参 None 的行为探索。\n\n    期望值来源不明，需人工确认：规约仅声明前置条件 isinstance(s, str)，\n    未约定非 str 入参的具体行为（可能抛 TypeError 或返回非预期结果）。\n    此处记录实际行为，不做具体值断言。\n    \"\"\"\n    try:\n        result = is_palindrome(None)\n    except TypeError:\n        # 抛 TypeError 是可接受的行为之一\n        return\n    # 若未抛异常，则记录实际返回值（不臆造期望值）\n    assert result is not None or result is None\n\n\ndef test_is_palindrome_int_input_behavior():\n    \"\"\"非 str 入参 int 的行为探索。\n\n    期望值来源不明，需人工确认：规约仅声明前置条件 isinstance(s, str)，\n    未约定非 str 入参的具体行为。此处记录实际行为，不做具体值断言。\n    \"\"\"\n    try:\n        result = is_palindrome(12321)\n    except TypeError:\n        return\n    assert isinstance(result, (bool, type(None))) or result is not None\n\n\ndef test_is_palindrome_list_input_behavior():\n    \"\"\"非 str 入参 list 的行为探索。\n\n    期望值来源不明，需人工确认：规约仅声明前置条件 isinstance(s, str)，\n    未约定非 str 入参的具体行为（list 支持切片反转，可能返回 True）。\n    此处记录实际行为，不做具体值断言。\n    \"\"\"\n    try:\n        result = is_palindrome([1, 2, 1])\n    except TypeError:\n        return\n    assert result is not None or result is None",
