ult >= 1\n\n\n# ---------------------------------------------------------------------------\n# 后置条件：递归关系自洽性（不依赖具体数值）\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\"n\", [2, 3, 4, 5, 6, 7])\ndef test_fibonacci_recursive_relation_consistency(n):\n    \"\"\"规约后置条件：n >= 2 时 result == fibonacci(n-1) + fibonacci(n-2)。\n\n    期望值来源：可执行规约中的递归关系子句，直接以被测函数自身验证。\n    \"\"\"\n    result = fibonacci(n)\n    assert result == fibonacci(n - 1) + fibonacci(n - 2)\n\n\n# ---------------------------------------------------------------------------\n# 前置条件违反：非 int 输入\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\"bad_input\", [\"3\", None, 3.5, [3]])\ndef test_fibonacci_non_int_input_raises(bad_input):\n    \"\"\"前置条件：n 必须为 int（isinstance(n, int)）。\n\n    规约未约定非 int 输入的具体异常类型，仅约定前置条件被违反；\n    此处以 pytest.raises(Exception) 记录实际行为，需人工确认具体异常类型。\n    \"\"\"\n    with pytest.raises(Exception):\n        fibonacci(bad_input)",
