置条件 \"未命中返回 0\"。\n    \"\"\"\n    long_key = \"a\" * 1000\n    result = lookup(long_key)\n    assert result == 0\n\n\n# ---------------------------------------------------------------------------\n# 类型注解外的输入：None 与 int\n# 规约明确说明 dict.get 对这类键不抛异常并返回 0。\n# ---------------------------------------------------------------------------\ndef test_lookup_none_key_returns_zero():\n    \"\"\"None 作为键（类型注解外）应返回 0。\n\n    期望值来源：规约边界情况 \"None 作为键（类型注解外，dict.get 可处理但返回 0）\"。\n    \"\"\"\n    result = lookup(None)\n    assert result == 0\n\n\ndef test_lookup_int_key_returns_zero():\n    \"\"\"整数作为键（类型注解外）应返回 0。\n\n    期望值来源：规约边界情况 \"非字符串键如 1（类型注解外）\"。\n    \"\"\"\n    result = lookup(1)\n    assert result == 0\n\n\n# ---------------------------------------------------------------------------\n# 后置条件 / 不变量：返回值类型与取值范围\n# ---------------------------------------------------------------------------\n@pytest.mark.parametrize(\n    \"key\",\n    [\"alpha\", \"beta\", \"gamma\", \"delta\", \"\", \"Alpha\", \"a\" * 1000],\n)\ndef test_lookup_result_is_int_and_in_invariant_range(key):\n    \"\"\"返回值恒为 int，且满足不变量 result in (0, 1, 2, 3) 与 result >= 0。\n\n    期望值来源：规约后置条件 \"返回值恒为 int\"、\"result >= 0\"，\n    以及不变量 \"result in (0, 1, 2, 3)\"。\n    \"\"\"\n    result = lookup(key)\n    assert isinstance(result, int)\n    assert result >= 0\n    assert result in (0, 1, 2, 3)",
