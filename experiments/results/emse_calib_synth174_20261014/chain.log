          "patch": "python\ndef first_n_chars(s: str, n: int) -> str:\n    if n <= 0:\n        return \"\"\n    return s[:n]\n# noise_seed=4840\n",
          "generated_test": "import pytest\n\nfrom task_0028 import first_n_chars\n\n\n# ---------------------------------------------------------------------------\n# 正常 / 边界用例（期望值来自规约：n > 0 -> s[:n-1]；n <= 0 -> \"\"）\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\n    \"s, n, expected\",\n    [\n        (\"hello\", 4, \"hel\"),          # 正常截取\n        (\"hello\", 1, \"\"),             # n == 1 边界，切片为空串\n        (\"hello\", 0, \"\"),             # n == 0 边界，n <= 0 分支\n        (\"hello\", -3, \"\"),            # n 为负数，n <= 0 分支\n        (\"hi\", 10, \"h\"),              # n 大于 len(s)，s[:9] == \"h\"\n        (\"\", 5, \"\"),                  # 空字符串输入\n        (\"abc\", 1000000, \"ab\"),       # n 为极大值，s[:999999] == \"ab\"\n    ],\n)\ndef test_first_n_chars_expected_output(s, n, expected):\n    \"\"\"规约后置条件：n <= 0 返回 \"\"；n > 0 返回 s[:n-1]。\"\"\"\n    assert first_n_chars(s, n) == expected\n\n\n# ---------------------------------------------------------------------------\n# 后置条件（可执行子句）逐条验证\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\n    \"s, n\",\n    [\n        (\"hello\", 4),\n        (\"hello\", 1),\n        (\"hello\", 0),\n        (\"hello\", -3),\n        (\"hi\", 10),\n        (\"\", 5),\n        (\"abc\", 1000000),\n        (\"python\", 3),\n    ],\n)\ndef test_first_n_chars_postcondition_slice(s, n):\n    \"\"\"后置条件：n <= 0 or result == s[:n - 1]。\"\"\"\n    result = first_n_chars(s, n)\n    assert n <= 0 or result == s[: n - 1]\n\n\n@pytest.mark.parametrize(\n    \"s, n\",\n    [\n        (\"hello\", 4),\n        (\"hello\", 1),\n        (\"hello\", 0),\n        (\"hello\", -3),\n        (\"hi\", 10),\n        (\"\", 5),\n        (\"abc\", 1000000),\n        (\"python\", 3),\n    ],\n)\ndef test_first_n_chars_postcondition_empty_when_nonpositive(s, n):\n    \"\"\"后置条件：n > 0 or result == \"\"。\"\"\"\n    result = first_n_chars(s, n)\n    assert n > 0 or result == \"\"\n\n\n@pytest.mark.parametrize(\n    \"s, n\",\n    [\n        (\"hello\", 4),\n        (\"hello\", 1),\n        (\"hello\", 0),\n        (\"hello\", -3),\n        (\"hi\", 10),\n        (\"\", 5),\n        (\"abc\", 1000000),\n        (\"python\", 3),\n    ],\n)\ndef test_first_n_chars_invariant_length(s, n):\n    \"\"\"不变量：len(result) <= max(0, n - 1)。\"\"\"\n    result = first_n_chars(s, n)\n    assert len(result) <= max(0, n - 1)\n\n\n# ---------------------------------------------------------------------------\n# 返回值类型不变量（规约声明返回 str）\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\n    \"s, n\",\n    [\n        (\"hello\", 4),\n        (\"hello\", 0),\n        (\"hello\", -3),\n        (\"\", 5),\n        (\"abc\", 1000000),\n    ],\n)\ndef test_first_n_chars_returns_str(s, n):\n    \"\"\"规约声明返回类型为 str。\"\"\"\n    assert isinstance(first_n_chars(s, n), str)\n\n\n# ---------------------------------------------------------------------------\n# 前置条件被违反的输入：规约未定义行为，仅记录实际行为，需人工确认\n# ---------------------------------------------------------------------------\n\ndef test_first_n_chars_non_int_n_behavior():\n    \"\"\"前置条件要求 n 为 int；传入 str 违反前置，规约未定义行为。\n\n    期望值来源不明，需人工确认。此处仅记录实际行为：\n    若实现抛 TypeError 则通过；若返回某值则记录该值。\n    \"\"\"\n    try:\n        result = first_n_chars(\"hello\", \"4\")\n    except TypeError:\n        # 违反前置条件导致 TypeError，属可接受的实际行为\n        return\n    # 未抛异常时，仅记录实际返回值，不做具体值断言\n    assert isinstance(result, str)\n\n\ndef test_first_n_chars_non_str_s_behavior():\n    \"\"\"前置条件要求 s 为 str；传入 int 违反前置，规约未定义行为。\n\n    期望值来源不明，需人工确认。此处仅记录实际行为：\n    若实现抛 TypeError 则通过；若返回某值则记录该值。\n    \"\"\"\n    try:\n        result = first_n_chars(123, 2)\n    except TypeError:\n        # 违反前置条件导致 TypeError，属可接受的实际行为\n        return\n    # 未抛异常时，仅记录实际返回值，不做具体值断言\n    assert isinstance(result, str)",
