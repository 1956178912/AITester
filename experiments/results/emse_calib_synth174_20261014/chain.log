          "generated_test": "import pytest\n\nfrom task_0049 import compute_scores\n\n\ndef test_compute_scores_normal_multiple_records():\n    \"\"\"正常多记录：验证正常记录被正确映射为字典。\n\n    期望值来源：规约后置条件（键集合等于各记录 name，值等于各记录 value）。\n    \"\"\"\n    records = [{\"name\": \"a\", \"value\": 1}, {\"name\": \"b\", \"value\": 2}]\n    result = compute_scores(records)\n    assert isinstance(result, dict)\n    assert result == {\"a\": 1, \"b\": 2}\n\n\ndef test_compute_scores_empty_list():\n    \"\"\"空列表：验证空输入返回空字典。\n\n    期望值来源：规约边界情况（records 为空列表 → 返回 {}）。\n    \"\"\"\n    result = compute_scores([])\n    assert isinstance(result, dict)\n    assert result == {}\n\n\ndef test_compute_scores_missing_keys_default():\n    \"\"\"缺省键：验证 name 缺省为 unknown、value 缺省为 0，且同名键覆盖。\n\n    期望值来源：规约边界情况（缺 name → unknown，缺 value → 0，同名后者覆盖）。\n    \"\"\"\n    records = [{\"value\": 5}, {}]\n    result = compute_scores(records)\n    assert isinstance(result, dict)\n    assert result == {\"unknown\": 0}\n\n\ndef test_compute_scores_duplicate_name_last_wins():\n    \"\"\"重复 name：验证同名键后者覆盖前者。\n\n    期望值来源：规约边界情况（多条记录 name 相同 → 后者覆盖前者）。\n    \"\"\"\n    records = [{\"name\": \"a\", \"value\": 1}, {\"name\": \"a\", \"value\": 9}]\n    result = compute_scores(records)\n    assert isinstance(result, dict)\n    assert result == {\"a\": 9}\n\n\ndef test_compute_scores_zero_and_negative_values():\n    \"\"\"负数与零值：验证 0 与负数 value 被原样保留。\n\n    期望值来源：规约边界情况（value 为 0 或负数）。\n    \"\"\"\n    records = [{\"name\": \"a\", \"value\": 0}, {\"name\": \"b\", \"value\": -3}]\n    result = compute_scores(records)\n    assert isinstance(result, dict)\n    assert result == {\"a\": 0, \"b\": -3}\n\n\ndef test_compute_scores_postcondition_dict_and_length():\n    \"\"\"后置条件：返回值必须是 dict，且长度不超过输入记录数。\n\n    期望值来源：规约可执行后置子句。\n    \"\"\"\n    records = [{\"name\": \"a\", \"value\": 1}, {\"name\": \"a\", \"value\": 2}, {\"name\": \"b\", \"value\": 3}]\n    result = compute_scores(records)\n    assert isinstance(result, dict)\n    assert len(result) <= len(records)\n\n\ndef test_compute_scores_invariant_keys_are_str():\n    \"\"\"不变量：返回字典的所有键均为字符串。\n\n    期望值来源：规约可执行不变量子句。\n    \"\"\"\n    records = [{\"name\": \"a\", \"value\": 1}, {\"value\": 2}, {\"name\": \"b\", \"value\": 3}]\n    result = compute_scores(records)\n    assert isinstance(result, dict)\n    assert all(isinstance(k, str) for k in result)\n\n\ndef test_compute_scores_none_input_raises():\n    \"\"\"非列表输入：None 不满足前置条件，迭代时应抛出 TypeError。\n\n    期望值来源：规约前置条件（records 为可迭代的列表）；\n    None 不满足前件，代码未做类型校验，for 迭代 None 会抛 TypeError。\n    \"\"\"\n    with pytest.raises(TypeError):\n        compute_scores(None)",
