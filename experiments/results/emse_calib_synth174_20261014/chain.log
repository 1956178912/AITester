esult, int)\n    assert result < -100000\n\n\ndef test_days_until_leap_year_date_parses_normally():\n    \"\"\"规约边界：闰年日期 \"2024-02-29\" 正常解析，返回 int（具体数值依赖当前时间）。\"\"\"\n    result = days_until(\"2024-02-29\")\n    assert isinstance(result, int)\n\n\ndef test_days_until_returns_int_type():\n    \"\"\"后置条件（可执行）：返回值类型为 int。\"\"\"\n    result = days_until(\"2999-12-31\")\n    assert isinstance(result, int)",
