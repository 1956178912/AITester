          "patch": "python\ndef compute_scores(records: list) -> dict:\n    scores = {}\n    for record in records:\n        if not isinstance(record, dict):\n            record = {}\n        key = record.get(\"name\", \"unknown\")\n        value = record.get(\"value\", 0)\n        scores[key] = value\n    return scores\n\ndef average(scores: dict) -> float:\n    if not scores:\n        return 0.0\n    total = sum(scores.values())\n    return total / len(scores)\n\ndef rank_top(scores: dict, k: int) -> list:\n    items = sorted(scores.items(), key=lambda kv: kv[1], reverse=True)\n    return items[:k]\n# noise_seed=1349\n",
          "generated_test": "import pytest\n\nfrom task_0054 import compute_scores\n\n\ndef test_compute_scores_normal_multiple_records():\n    \"\"\"正常多记录：两条记录映射为 name->value 字典。\n\n    期望值来源：规约后置条件 result[record.get(\"name\",\"unknown\")] == record.get(\"value\",0)。\n    \"\"\"\n    records = [{\"name\": \"a\", \"value\": 1}, {\"name\": \"b\", \"value\": 2}]\n    result = compute_scores(records)\n    assert isinstance(result, dict)\n    assert result == {\"a\": 1, \"b\": 2}\n\n\ndef test_compute_scores_empty_list_returns_empty_dict():\n    \"\"\"边界：空列表返回 {}。\n\n    期望值来源：规约边界情况“records 为空列表返回 {}”。\n    \"\"\"\n    result = compute_scores([])\n    assert isinstance(result, dict)\n    assert result == {}\n\n\ndef test_compute_scores_missing_name_defaults_unknown():\n    \"\"\"边界：record 缺少 name 键时使用 \"unknown\"。\n\n    期望值来源：规约后置条件 record.get(\"name\",\"unknown\")。\n    \"\"\"\n    records = [{\"value\": 5}]\n    result = compute_scores(records)\n    assert isinstance(result, dict)\n    assert result == {\"unknown\": 5}\n\n\ndef test_compute_scores_missing_value_defaults_zero():\n    \"\"\"边界：record 缺少 value 键时使用 0。\n\n    期望值来源：规约后置条件 record.get(\"value\",0)。\n    \"\"\"\n    records = [{\"name\": \"x\"}]\n    result = compute_scores(records)\n    assert isinstance(result, dict)\n    assert result == {\"x\": 0}\n\n\ndef test_compute_scores_duplicate_name_last_wins():\n    \"\"\"边界：多个 record 同名时后者覆盖前者。\n\n    期望值来源：规约后置条件“同名键后者覆盖前者”。\n    \"\"\"\n    records = [{\"name\": \"a\", \"value\": 1}, {\"name\": \"a\", \"value\": 9}]\n    result = compute_scores(records)\n    assert isinstance(result, dict)\n    assert result == {\"a\": 9}\n\n\ndef test_compute_scores_negative_value_preserved():\n    \"\"\"边界：value 为负数时原样保留。\n\n    期望值来源：规约边界情况“value 为 0 或负数”，后置条件要求值等于 record.get(\"value\",0)。\n    \"\"\"\n    records = [{\"name\": \"a\", \"value\": -3}]\n    result = compute_scores(records)\n    assert isinstance(result, dict)\n    assert result == {\"a\": -3}\n\n\ndef test_compute_scores_zero_value_preserved():\n    \"\"\"边界：value 为 0 时原样保留（0 不应被误判为缺失）。\n\n    期望值来源：规约边界情况“value 为 0 或负数”。\n    \"\"\"\n    records = [{\"name\": \"a\", \"value\": 0}]\n    result = compute_scores(records)\n    assert isinstance(result, dict)\n    assert result == {\"a\": 0}\n\n\ndef test_compute_scores_postcondition_length_bound():\n    \"\"\"后置：结果字典长度不超过输入记录数。\n\n    期望值来源：可执行规约 len(result) <= len(records)。\n    \"\"\"\n    records = [\n        {\"name\": \"a\", \"value\": 1},\n        {\"name\": \"b\", \"value\": 2},\n        {\"name\": \"a\", \"value\": 3},\n    ]\n    result = compute_scores(records)\n    assert isinstance(result, dict)\n    assert len(result) <= len(records)\n\n\ndef test_compute_scores_postcondition_matches_get_semantics():\n    \"\"\"后置：对每个 record，result[record.get(\"name\",\"unknown\")] == record.get(\"value\",0)。\n\n    期望值来源：可执行规约后置条件。\n    \"\"\"\n    records = [\n        {\"name\": \"a\", \"value\": 1},\n        {\"value\": 7},\n        {\"name\": \"b\"},\n        {\"name\": \"a\", \"value\": -2},\n    ]\n    result = compute_scores(records)\n    assert isinstance(result, dict)\n    for record in records:\n        key = record.get(\"name\", \"unknown\")\n        assert result[key] == record.get(\"value\", 0)\n\n\ndef test_compute_scores_invariant_keys_are_hashable():\n    \"\"\"不变量：结果键可哈希（规约不变量 all(isinstance(k, str) or True for k in result)）。\n\n    期望值来源：可执行规约不变量；该不变量恒真，此处仅验证键可哈希且结果可正常索引。\n    \"\"\"\n    records = [{\"name\": \"a\", \"value\": 1}, {\"value\": 2}]\n    result = compute_scores(records)\n    assert isinstance(result, dict)\n    for key in result:\n        assert hash(key) is not None\n\n\ndef test_compute_scores_non_list_input_raises():\n    \"\"\"异常：非列表输入（None）不满足前置条件 isinstance(records, list)。\n\n    期望值来源：规约前置条件要求 records 为列表；具体异常类型未在规约中约定，\n    此处仅断言抛出异常，需人工确认具体异常类型。\n    \"\"\"\n    with pytest.raises(Exception):\n        compute_scores(None)",
