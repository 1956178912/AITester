   parts = full_name.split()\n    result = initials(full_name)\n    if not parts:\n        assert result == \"\"\n    else:\n        assert len(result.split(\".\")) == len(parts)\n\n\n# ---------------------------------------------------------------------------\n# Unicode 字母：规约声明 upper() 结果依赖 Python 版本，不臆造具体值\n# ---------------------------------------------------------------------------\n\ndef test_initials_unicode_letter_behavior():\n    \"\"\"Unicode 字母 'é' 的 upper() 结果依赖 Python 版本。\n\n    期望值来源不明，需人工确认：此处仅记录实际行为，\n    断言其与规约公式 '.'.join(p[0].upper() for p in full_name.split()) 一致。\n    \"\"\"\n    full_name = \"éclair dupont\"\n    expected = \".\".join(p[0].upper() for p in full_name.split())\n    assert initials(full_name) == expected",
