          "generated_test": "import pytest\n\nfrom task_0051 import aggregate\n\n\nclass TestAggregateNormal:\n    \"\"\"正常路径测试：验证 sum(values)/len(values) 与 float 返回类型。\"\"\"\n\n    def test_aggregate_multi_int_list_returns_mean(self):\n        \"\"\"普通多元素整数列表：sum=10, len=4, 期望 2.5（来源：规约后置条件）。\"\"\"\n        values = [1, 2, 3, 4]\n        result = aggregate(values)\n        assert result == sum(values) / len(values)\n        assert result == 2.5\n\n    def test_aggregate_returns_float_for_int_elements(self):\n        \"\"\"元素为 int 时结果仍为 float（来源：规约边界情况）。\"\"\"\n        result = aggregate([1, 2, 3, 4])\n        assert isinstance(result, float)\n\n    def test_aggregate_float_list_returns_mean(self):\n        \"\"\"浮点元素列表：sum=2.0, len=2, 期望 1.0（来源：规约后置条件）。\"\"\"\n        values = [0.5, 1.5]\n        result = aggregate(values)\n        assert result == sum(values) / len(values)\n        assert result == 1.0\n\n    def test_aggregate_does_not_modify_input(self):\n        \"\"\"不修改入参 values（来源：规约后置条件）。\"\"\"\n        values = [1, 2, 3, 4]\n        snapshot = list(values)\n        aggregate(values)\n        assert values == snapshot\n\n\nclass TestAggregateBoundary:\n    \"\"\"边界路径测试：单元素、全零、负数、大数/浮点精度。\"\"\"\n\n    def test_aggregate_single_element_returns_that_value(self):\n        \"\"\"单元素列表 [5] → 5.0（来源：规约边界情况）。\"\"\"\n        result = aggregate([5])\n        assert result == 5.0\n        assert isinstance(result, float)\n\n    def test_aggregate_all_zeros_returns_zero(self):\n        \"\"\"全零列表 [0, 0] → 0.0（来源：规约边界情况）。\"\"\"\n        result = aggregate([0, 0])\n        assert result == 0.0\n        assert isinstance(result, float)\n\n    def test_aggregate_negative_and_positive_cancel(self):\n        \"\"\"含负数 [-1, 1] → 0.0（来源：规约边界情况）。\"\"\"\n        result = aggregate([-1, 1])\n        assert result == 0.0\n        assert isinstance(result, float)\n\n    def test_aggregate_negative_values_mean(self):\n        \"\"\"全负数列表：sum=-6, len=3, 期望 -2.0（来源：规约后置条件）。\"\"\"\n        values = [-1, -2, -3]\n        result = aggregate(values)\n        assert result == sum(values) / len(values)\n        assert result == -2.0\n\n    def test_aggregate_large_numbers(self):\n        \"\"\"大数边界：验证与 sum/len 一致（来源：规约后置条件）。\"\"\"\n        values = [10**15, 10**15 + 2]\n        result = aggregate(values)\n        assert result == sum(values) / len(values)\n\n    def test_aggregate_float_precision_matches_spec(self):\n        \"\"\"浮点精度边界：结果应与 sum(values)/len(values) 完全一致（来源：规约后置条件）。\"\"\"\n        values = [0.1, 0.2, 0.3]\n        result = aggregate(values)\n        assert result == sum(values) / len(values)\n\n\nclass TestAggregateErrors:\n    \"\"\"异常路径测试：空列表除零、非数值元素。\"\"\"\n\n    def test_aggregate_empty_list_raises_zero_division_error(self):\n        \"\"\"空列表 [] → ZeroDivisionError（来源：规约边界情况）。\"\"\"\n        with pytest.raises(ZeroDivisionError):\n            aggregate([])\n\n    def test_aggregate_non_numeric_elements_raises_type_error(self):\n        \"\"\"非数值元素（字符串）不可被 sum 累加，期望 TypeError。\n\n        期望值来源不明，需人工确认：规约仅声明\"元素可被 sum 累加（数值型）\"，\n        未明确约定非数值元素的具体异常类型；此处按 Python 内置 sum 对 str\n        的默认行为记录为 TypeError，若实现另有约定需人工修正。\n        \"\"\"\n        with pytest.raises(TypeError):\n            aggregate([\"a\", \"b\"])",
