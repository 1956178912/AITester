          "generated_test": "import math\n\nimport pytest\n\nfrom task_0013 import sqrt\n\n\n# ---------------------------------------------------------------------------\n# 常规路径：x > 0，走 x ** 0.5 分支\n# ---------------------------------------------------------------------------\n\ndef test_sqrt_positive_perfect_square():\n    \"\"\"x=4.0 时返回 2.0（规约：x>0 返回 x ** 0.5）。\"\"\"\n    result = sqrt(4.0)\n    assert result == pytest.approx(2.0)\n    assert result ** 2 == pytest.approx(4.0)\n\n\ndef test_sqrt_positive_non_perfect_square():\n    \"\"\"x=2.0 时返回 sqrt(2) 的浮点近似值（规约：x>0 返回 x ** 0.5）。\"\"\"\n    result = sqrt(2.0)\n    assert result == pytest.approx(math.sqrt(2.0))\n    assert result ** 2 == pytest.approx(2.0)\n\n\ndef test_sqrt_positive_result_squared_equals_input():\n    \"\"\"规约后置：x>0 时 result ** 2 约等于 x（不变量校验）。\"\"\"\n    for x in (1.0, 9.0, 16.0, 0.25, 100.0):\n        result = sqrt(x)\n        assert result ** 2 == pytest.approx(x)\n\n\ndef test_sqrt_positive_returns_float_type():\n    \"\"\"规约后置：返回值类型注解为 float，x>0 时应返回 float。\"\"\"\n    result = sqrt(9.0)\n    assert isinstance(result, float)\n\n\n# ---------------------------------------------------------------------------\n# 边界：x == 0，命中分支 1 直接返回 0\n# ---------------------------------------------------------------------------\n\ndef test_sqrt_zero_int_returns_zero():\n    \"\"\"x=0 时命中分支 1，直接返回 0（规约后置 + 不变量）。\"\"\"\n    result = sqrt(0)\n    assert result == 0\n\n\ndef test_sqrt_zero_float_returns_zero():\n    \"\"\"x=0.0 与 0 等价，命中分支 1 返回 0（规约后置 + 不变量）。\"\"\"\n    result = sqrt(0.0)\n    assert result == 0\n\n\n# ---------------------------------------------------------------------------\n# 边界：极小正数 / 极大数\n# ---------------------------------------------------------------------------\n\ndef test_sqrt_tiny_positive():\n    \"\"\"x=1e-300 为极小正数，走开方分支，结果非 0 且平方约等于 x。\"\"\"\n    x = 1e-300\n    result = sqrt(x)\n    assert result != 0\n    assert result ** 2 == pytest.approx(x)\n\n\ndef test_sqrt_huge_positive():\n    \"\"\"x=1e308 为极大数，走开方分支，结果平方约等于 x（规约允许溢出为 inf）。\"\"\"\n    x = 1e308\n    result = sqrt(x)\n    # 规约说明可能溢出为 inf，故仅断言与 x ** 0.5 一致\n    assert result == pytest.approx(x ** 0.5)\n\n\n# ---------------------------------------------------------------------------\n# 边界：bool 是 int 子类\n# ---------------------------------------------------------------------------\n\ndef test_sqrt_bool_true():\n    \"\"\"True 是 int 子类，值等价于 1，走开方分支返回 1.0。\"\"\"\n    result = sqrt(True)\n    assert result == pytest.approx(1.0)\n\n\ndef test_sqrt_bool_false():\n    \"\"\"False 是 int 子类，值等价于 0，命中分支 1 返回 0。\"\"\"\n    result = sqrt(False)\n    assert result == 0\n\n\n# ---------------------------------------------------------------------------\n# 异常 / 未定义行为：期望值来源不明，需人工确认\n# ---------------------------------------------------------------------------\n\ndef test_sqrt_negative_input_behavior():\n    \"\"\"负数输入：规约未定义行为，期望值来源不明，需人工确认。\n\n    规约仅声明 x 应 >= 0，代码未强制校验；此处记录实际行为，\n    不臆造具体返回值。若实现返回复数则与 float 注解不符。\n    \"\"\"\n    x = -4.0\n    try:\n        result = sqrt(x)\n    except Exception as exc:  # noqa: BLE001 - 记录实际抛出的异常类型\n        # 实现选择抛异常也是可接受的未定义行为表现\n        assert exc is not None\n        return\n    # 若未抛异常，记录实际返回类型（期望值来源不明，需人工确认）\n    assert result is not None\n\n\ndef test_sqrt_nan_input_behavior():\n    \"\"\"NaN 输入：规约未定义行为，期望值来源不明，需人工确认。\n\n    NaN 不满足 x == 0，会走 x ** 0.5 分支；具体表示依赖运行环境，\n    此处仅记录实际行为，不臆造具体值。\n    \"\"\"\n    x = float(\"nan\")\n    try:\n        result = sqrt(x)\n    except Exception as exc:  # noqa: BLE001\n        assert exc is not None\n        return\n    # 若未抛异常，记录实际返回（NaN 的相等性特殊，不做等值断言）\n    assert result is not None\n\n\ndef test_sqrt_inf_input_behavior():\n    \"\"\"inf 输入：规约未定义行为，期望值来源不明，需人工确认。\n\n    inf 不满足 x == 0，会走 x ** 0.5 分支；具体表示依赖运行环境，\n    此处仅记录实际行为，不臆造具体值。\n    \"\"\"\n    x = float(\"inf\")\n    try:\n        result = sqrt(x)\n    except Exception as exc:  # noqa: BLE001\n        assert exc is not None\n        return\n    assert result is not None",
