dd_item(5, 1000000000000)\n    assert result is None\n    assert task_0002._STOCK[5] == 1000000000000\n\n\ndef test_add_item_bool_sku_as_int_subclass():\n    \"\"\"边界：sku 为 bool（bool 是 int 子类，可作键）。\n\n    期望值来源：规约边界情况 sku 为 bool；后置条件 _STOCK[sku] == qty。\n    注意：True == 1，故键 True 与 1 在字典中视为同一键。\n    \"\"\"\n    result = add_item(True, 3)\n    assert result is None\n    assert task_0002._STOCK[True] == 3\n\n\ndef test_add_item_invalid_qty_type_exploratory():\n    \"\"\"异常路径探索：qty 非 int（字符串）。\n\n    期望值来源不明，需人工确认：规约前置条件要求 isinstance(qty, int)，\n    但未规定违反前件时的行为。此处记录实际行为，不做具体值断言。\n    \"\"\"\n    try:\n        result = add_item(6, \"abc\")\n    except Exception as exc:  # noqa: BLE001\n        # 实现可能抛异常，记录实际行为\n        assert exc is not None\n        return\n    # 若未抛异常，则记录实际写入值（探索性，不臆造期望）\n    assert result is None\n    assert 6 in task_0002._STOCK\n\n\ndef test_add_item_unhashable_sku_raises():\n    \"\"\"异常路径：sku 为不可哈希类型（list），_STOCK[sku] = qty 应抛 TypeError。\n\n    期望值来源：规约前置条件要求 isinstance(sku, int)；list 不可哈希，\n    字典写入必然抛 TypeError（Python 语言语义，非实现臆测）。\n    \"\"\"\n    with pytest.raises(TypeError):\n        add_item([1, 2], 1)",
