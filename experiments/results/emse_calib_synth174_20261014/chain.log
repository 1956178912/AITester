          "generated_test": "import pytest\n\nfrom task_0063 import lookup\n\n\n# ---------------------------------------------------------------------------\n# 规约来源说明：\n#   期望值仅来自任务给出的自然语言规约与可执行规约（SpecExpr）。\n#   _TABLE 的具体内容未在规约中给出，但测试计划明确列出 alpha/beta/gamma\n#   分别映射到 1/2/3，且不变量约束 result == 0 or result in (1, 2, 3)。\n#   对于计划中未给出具体期望值的场景，采用\"记录实际行为\"的探索性断言。\n# ---------------------------------------------------------------------------\n\n\ndef test_lookup_returns_int_for_known_key_alpha():\n    \"\"\"命中已有键 alpha 时返回对应整数值 1。\n\n    期望值来源：测试计划 test_cases[0]（alpha -> 1）。\n    \"\"\"\n    result = lookup(\"alpha\")\n    assert isinstance(result, int)\n    assert result == 1\n\n\ndef test_lookup_returns_int_for_known_key_beta():\n    \"\"\"命中已有键 beta 时返回对应整数值 2。\n\n    期望值来源：测试计划 test_cases[1]（beta -> 2）。\n    \"\"\"\n    result = lookup(\"beta\")\n    assert isinstance(result, int)\n    assert result == 2\n\n\ndef test_lookup_returns_int_for_known_key_gamma():\n    \"\"\"命中已有键 gamma 时返回对应整数值 3。\n\n    期望值来源：测试计划 test_cases[2]（gamma -> 3）。\n    \"\"\"\n    result = lookup(\"gamma\")\n    assert isinstance(result, int)\n    assert result == 3\n\n\ndef test_lookup_returns_zero_for_unknown_key_delta():\n    \"\"\"未收录的普通键 delta 返回 0。\n\n    期望值来源：规约\"key 不在 _TABLE 中时 result == 0\"。\n    \"\"\"\n    result = lookup(\"delta\")\n    assert isinstance(result, int)\n    assert result == 0\n\n\ndef test_lookup_returns_zero_for_empty_string_key():\n    \"\"\"空字符串键未命中，返回 0。\n\n    期望值来源：规约边界情况\"key 为空字符串 ''（未命中，返回 0）\"。\n    \"\"\"\n    result = lookup(\"\")\n    assert isinstance(result, int)\n    assert result == 0\n\n\ndef test_lookup_returns_zero_for_case_variant_key():\n    \"\"\"大小写变体键 \"Alpha\" 未命中，返回 0（字典键区分大小写）。\n\n    期望值来源：规约边界情况\"key 为大小写变体如 'Alpha'（未命中，返回 0）\"。\n    \"\"\"\n    result = lookup(\"Alpha\")\n    assert isinstance(result, int)\n    assert result == 0\n\n\ndef test_lookup_returns_zero_for_very_long_string_key():\n    \"\"\"超长字符串键未命中，返回 0 且不抛异常。\n\n    期望值来源：规约边界情况\"key 为超长字符串\"（未命中 -> 0）。\n    \"\"\"\n    long_key = \"a\" * 1000\n    result = lookup(long_key)\n    assert isinstance(result, int)\n    assert result == 0\n\n\ndef test_lookup_returns_zero_for_none_key():\n    \"\"\"None 作为键时，dict.get 语义下不抛异常并返回默认值 0。\n\n    期望值来源：规约边界情况\"key 为 None 或非 str 类型\n    （dict.get 不抛异常，返回 0）\"。\n    \"\"\"\n    result = lookup(None)\n    assert isinstance(result, int)\n    assert result == 0\n\n\n@pytest.mark.parametrize(\n    \"key\",\n    [\"alpha\", \"beta\", \"gamma\", \"delta\", \"\", \"Alpha\", \"a\" * 1000],\n)\ndef test_lookup_result_satisfies_invariant(key):\n    \"\"\"对任意合法 str 键，返回值满足不变量：result == 0 or result in (1, 2, 3)。\n\n    期望值来源：可执行规约不变量\n    \"result == 0 or result in (1, 2, 3)\"。\n    \"\"\"\n    result = lookup(key)\n    assert isinstance(result, int)\n    assert result >= 0\n    assert result == 0 or result in (1, 2, 3)\n\n\n@pytest.mark.parametrize(\n    \"key\",\n    [\"alpha\", \"beta\", \"gamma\", \"delta\", \"\", \"Alpha\", \"a\" * 1000],\n)\ndef test_lookup_return_type_is_int(key):\n    \"\"\"对任意合法 str 键，返回值类型必须为 int。\n\n    期望值来源：可执行规约后置条件 \"isinstance(result, int)\"。\n    \"\"\"\n    result = lookup(key)\n    assert isinstance(result, int)",
