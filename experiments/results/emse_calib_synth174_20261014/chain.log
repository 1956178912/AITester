          "generated_test": "import pytest\n\nfrom task_0005 import aggregate\n\n\nclass TestAggregateNormal:\n    \"\"\"正常路径测试：满足前置条件 len(values) > 0 的常规输入。\"\"\"\n\n    def test_aggregate_positive_int_list(self):\n        \"\"\"正整数列表：期望 sum/len = 15/5 = 3.0（来源：规约后置条件）。\"\"\"\n        values = [1, 2, 3, 4, 5]\n        result = aggregate(values)\n        assert result == sum(values) / len(values)\n        assert result == 3.0\n\n    def test_aggregate_single_element_returns_float(self):\n        \"\"\"单元素列表 [7]：期望 float(7) == 7.0（来源：边界情况规约）。\"\"\"\n        result = aggregate([7])\n        assert result == 7.0\n        assert isinstance(result, float)\n\n    def test_aggregate_negative_elements(self):\n        \"\"\"含负数元素：期望负平均值 -2.0（来源：边界情况规约）。\"\"\"\n        values = [-1, -2, -3]\n        result = aggregate(values)\n        assert result == sum(values) / len(values)\n        assert result == -2.0\n\n    def test_aggregate_zero_elements(self):\n        \"\"\"全零列表：期望 0.0（来源：边界情况规约）。\"\"\"\n        result = aggregate([0, 0, 0])\n        assert result == 0.0\n\n    def test_aggregate_mixed_int_and_float(self):\n        \"\"\"int 与 float 混合：期望 float 且等于 sum/len（来源：规约后置条件）。\"\"\"\n        values = [1, 2.5, 3]\n        result = aggregate(values)\n        assert result == sum(values) / len(values)\n        assert isinstance(result, float)\n\n    def test_aggregate_returns_float_type(self):\n        \"\"\"返回值类型必须为 float（来源：规约后置条件）。\"\"\"\n        result = aggregate([1, 2, 3])\n        assert isinstance(result, float)\n\n\nclass TestAggregateBoundary:\n    \"\"\"边界路径测试。\"\"\"\n\n    def test_aggregate_empty_list_raises_zero_division(self):\n        \"\"\"空列表 []：len(values)==0，触发 ZeroDivisionError（来源：前置条件/边界规约）。\"\"\"\n        with pytest.raises(ZeroDivisionError):\n            aggregate([])\n\n    def test_aggregate_tiny_values(self):\n        \"\"\"极小数值列表：期望 1e-308（来源：边界情况规约）。\"\"\"\n        values = [1e-308, 1e-308]\n        result = aggregate(values)\n        assert result == 1e-308\n\n    def test_aggregate_large_values_records_actual_behavior(self):\n        \"\"\"大数值列表 [1e308, 1e308]：规约仅说明\"可能触发浮点溢出/精度损失\"，\n        未给出确定期望值。期望值来源不明，需人工确认。\n        此处记录实际行为：断言结果等于 sum/len 的浮点计算结果（含 inf 情形）。\n        \"\"\"\n        values = [1e308, 1e308]\n        result = aggregate(values)\n        # 探索性断言：与规约后置条件 result == sum(values)/len(values) 保持一致\n        assert result == sum(values) / len(values)\n        # 记录实际返回值类型，便于人工确认溢出行为\n        assert isinstance(result, float)",
