          "patch": "python\ndef clamp(value: float, min_val: float, max_val: float) -> float:\n    # 无效区间：min_val > max_val 时，规范化返回 max_val\n    if min_val > max_val:\n        return max_val\n    if value < min_val:\n        return min_val\n    if value > max_val:\n        return max_val\n    return value\n# noise_seed=4677\n",
          "generated_test": "import math\n\nimport pytest\n\nfrom task_0040 import clamp\n\n\n# ---------------------------------------------------------------------------\n# 正常路径：value 位于区间内部\n# ---------------------------------------------------------------------------\n\ndef test_clamp_value_inside_interval_returns_value():\n    \"\"\"规约后置：min_val <= value <= max_val 时返回 value。\"\"\"\n    result = clamp(5.0, 0.0, 10.0)\n    assert result == 5.0\n\n\ndef test_clamp_value_below_min_returns_min():\n    \"\"\"规约后置：value < min_val 时返回 min_val。\"\"\"\n    result = clamp(-3.0, 0.0, 10.0)\n    assert result == 0.0\n\n\ndef test_clamp_value_above_max_returns_max():\n    \"\"\"规约后置：value > max_val 时返回 max_val。\"\"\"\n    result = clamp(42.0, 0.0, 10.0)\n    assert result == 10.0\n\n\n# ---------------------------------------------------------------------------\n# 边界：value 等于下界 / 上界\n# ---------------------------------------------------------------------------\n\ndef test_clamp_value_equals_min_returns_value():\n    \"\"\"边界：value == min_val 不触发第一分支，返回 value（等于 min_val）。\"\"\"\n    result = clamp(0.0, 0.0, 10.0)\n    assert result == 0.0\n\n\ndef test_clamp_value_equals_max_returns_value():\n    \"\"\"边界：value == max_val 不触发第二分支，返回 value（等于 max_val）。\"\"\"\n    result = clamp(10.0, 0.0, 10.0)\n    assert result == 10.0\n\n\ndef test_clamp_degenerate_interval_single_point():\n    \"\"\"边界：min_val == max_val，区间退化为单点，value 大于上界返回 max_val。\"\"\"\n    result = clamp(7.0, 5.0, 5.0)\n    assert result == 5.0\n\n\ndef test_clamp_degenerate_interval_value_equals_point():\n    \"\"\"边界：min_val == max_val 且 value 等于该点，返回 value。\"\"\"\n    result = clamp(5.0, 5.0, 5.0)\n    assert result == 5.0\n\n\n# ---------------------------------------------------------------------------\n# 边界：0、负数、极大/极小浮点数\n# ---------------------------------------------------------------------------\n\ndef test_clamp_zero_value_inside_interval():\n    \"\"\"边界：value 为 0 且区间含 0，返回 0。\"\"\"\n    result = clamp(0.0, -1.0, 1.0)\n    assert result == 0.0\n\n\ndef test_clamp_all_negative_interval_inside():\n    \"\"\"边界：全负数区间内 value 原样返回。\"\"\"\n    result = clamp(-5.0, -10.0, -1.0)\n    assert result == -5.0\n\n\ndef test_clamp_value_below_negative_min_returns_min():\n    \"\"\"边界：value 低于负数下界，返回 min_val。\"\"\"\n    result = clamp(-100.0, -10.0, -1.0)\n    assert result == -10.0\n\n\ndef test_clamp_huge_float_above_max_returns_max():\n    \"\"\"边界：极大浮点数超过上界，返回 max_val，且无溢出异常。\"\"\"\n    result = clamp(1e308, 0.0, 1.0)\n    assert result == 1.0\n\n\ndef test_clamp_tiny_float_below_min_returns_min():\n    \"\"\"边界：极小（负）浮点数低于下界，返回 min_val。\"\"\"\n    result = clamp(-1e308, -1.0, 1.0)\n    assert result == -1.0\n\n\n# ---------------------------------------------------------------------------\n# 不变量：返回值必为 min_val / max_val / value 之一\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\n    \"value, min_val, max_val\",\n    [\n        (5.0, 0.0, 10.0),\n        (-3.0, 0.0, 10.0),\n        (42.0, 0.0, 10.0),\n        (0.0, 0.0, 10.0),\n        (10.0, 0.0, 10.0),\n        (7.0, 5.0, 5.0),\n        (0.0, -1.0, 1.0),\n        (-5.0, -10.0, -1.0),\n        (-100.0, -10.0, -1.0),\n        (1e308, 0.0, 1.0),\n    ],\n)\ndef test_clamp_invariant_result_is_one_of_inputs(value, min_val, max_val):\n    \"\"\"不变量：返回值必等于 min_val、max_val 或 value 之一。\"\"\"\n    result = clamp(value, min_val, max_val)\n    assert result == min_val or result == max_val or result == value\n\n\n@pytest.mark.parametrize(\n    \"value, min_val, max_val\",\n    [\n        (5.0, 0.0, 10.0),\n        (-3.0, 0.0, 10.0),\n        (42.0, 0.0, 10.0),\n        (0.0, 0.0, 10.0),\n        (10.0, 0.0, 10.0),\n        (7.0, 5.0, 5.0),\n        (0.0, -1.0, 1.0),\n        (-5.0, -10.0, -1.0),\n        (-100.0, -10.0, -1.0),\n        (1e308, 0.0, 1.0),\n    ],\n)\ndef test_clamp_postcondition_result_within_bounds(value, min_val, max_val):\n    \"\"\"后置：当 min_val <= max_val 时，返回值满足 min_val <= result <= max_val。\"\"\"\n    result = clamp(value, min_val, max_val)\n    assert min_val <= result <= max_val\n\n\n# ---------------------------------------------------------------------------\n# 非法区间（min_val > max_val）：行为由分支顺序决定\n# ---------------------------------------------------------------------------\n\ndef test_clamp_invalid_interval_value_below_min_returns_min():\n    \"\"\"非法区间 min_val > max_val 且 value < min_val：第一分支优先，返回 min_val。\n\n    期望值来源：规约边界情况「第一分支优先返回 min_val」。\n    \"\"\"\n    result = clamp(-5.0, 10.0, 0.0)\n    assert result == 10.0\n\n\ndef test_clamp_invalid_interval_value_above_max_returns_max():\n    \"\"\"非法区间 min_val > max_val 且 value > max_val：命中第二分支，返回 max_val。\n\n    期望值来源：规约边界情况「命中第二分支返回 max_val」。\n    \"\"\"\n    result = clamp(5.0, 10.0, 0.0)\n    assert result == 0.0\n\n\ndef test_clamp_invalid_interval_invariant_holds():\n    \"\"\"非法区间下不变量仍成立：返回值必为 min_val / max_val / value 之一。\"\"\"\n    result = clamp(-5.0, 10.0, 0.0)\n    assert result == 10.0 or result == 0.0 or result == -5.0\n\n\n# ---------------------------------------------------------------------------\n# 前置条件：输入类型为数值\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\n    \"value, min_val, max_val\",\n    [\n        (5, 0, 10),\n        (5.0, 0, 10),\n        (5, 0.0, 10.0),\n    ],\n)\ndef test_clamp_accepts_numeric_types(value, min_val, max_val):\n    \"\"\"前置：value、min_val、max_val 均为数值（int/float）时正常返回。\"\"\"\n    result = clamp(value, min_val, max_val)\n    assert result == 5\n\n\ndef test_clamp_returns_float_type():\n    \"\"\"后置：返回值为 float 类型（签名约定）。\"\"\"\n    result = clamp(5.0, 0.0, 10.0)\n    assert isinstance(result, float)",
