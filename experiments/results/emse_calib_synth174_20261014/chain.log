          "generated_test": "import pytest\n\nfrom task_0084 import fibonacci\n\n\n# ---------------------------------------------------------------------------\n# 正常路径：n >= 2 的递归返回路径\n# ---------------------------------------------------------------------------\n\ndef test_fibonacci_n_equals_2_minimal_recursion():\n    \"\"\"n == 2 为最小递归情形。\n\n    规约：n >= 2 时返回 fibonacci(n-1) + fibonacci(n-2)。\n    期望值来源：规约后置条件 + 边界情况 n == 2。\n    fibonacci(1) = 1（n == 1 分支），fibonacci(0) = 1（n <= 0 分支），\n    故 fibonacci(2) = 1 + 1 = 2。\n    \"\"\"\n    assert fibonacci(2) == 2\n\n\ndef test_fibonacci_n_equals_5_regular_recursion():\n    \"\"\"n == 5 的常规多级递归。\n\n    规约：n >= 2 时返回 fibonacci(n-1) + fibonacci(n-2)。\n    期望值来源：规约后置条件逐层展开。\n    fib(0)=1, fib(1)=1, fib(2)=2, fib(3)=3, fib(4)=5, fib(5)=8。\n    \"\"\"\n    assert fibonacci(5) == 8\n\n\ndef test_fibonacci_n_equals_3_recursion():\n    \"\"\"n == 3 的递归返回路径。\n\n    规约：n >= 2 时返回 fibonacci(n-1) + fibonacci(n-2)。\n    期望值来源：规约后置条件。fib(3) = fib(2) + fib(1) = 2 + 1 = 3。\n    \"\"\"\n    assert fibonacci(3) == 3\n\n\ndef test_fibonacci_n_equals_4_recursion():\n    \"\"\"n == 4 的递归返回路径。\n\n    规约：n >= 2 时返回 fibonacci(n-1) + fibonacci(n-2)。\n    期望值来源：规约后置条件。fib(4) = fib(3) + fib(2) = 3 + 2 = 5。\n    \"\"\"\n    assert fibonacci(4) == 5\n\n\n# ---------------------------------------------------------------------------\n# 边界路径：n <= 0 与 n == 1\n# ---------------------------------------------------------------------------\n\ndef test_fibonacci_n_equals_0_boundary():\n    \"\"\"n == 0 落入 n <= 0 分支。\n\n    规约：n <= 0 时返回 1。\n    期望值来源：规约后置条件 + 边界情况 n == 0。\n    \"\"\"\n    assert fibonacci(0) == 1\n\n\ndef test_fibonacci_n_equals_1_boundary():\n    \"\"\"n == 1 命中第二分支。\n\n    规约：n == 1 时返回 1。\n    期望值来源：规约后置条件 + 边界情况 n == 1。\n    \"\"\"\n    assert fibonacci(1) == 1\n\n\n@pytest.mark.parametrize(\"n\", [-1, -2, -10, -100])\ndef test_fibonacci_negative_n_boundary(n):\n    \"\"\"负数输入落入 n <= 0 分支。\n\n    规约：n <= 0 时返回 1。\n    期望值来源：规约后置条件 + 边界