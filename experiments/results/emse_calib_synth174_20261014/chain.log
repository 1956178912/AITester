          "generated_test": "import pytest\n\nfrom task_0082 import clamp\n\n\n# ---------------------------------------------------------------------------\n# 正常路径：覆盖规约中明确给出的后置条件分支\n# ---------------------------------------------------------------------------\n\ndef test_clamp_value_less_than_high_returns_high():\n    \"\"\"规约后置：若 value < high 则返回 high。\n\n    输入 value=1, low=0, high=10，满足 value < high，期望返回 high=10。\n    期望值来源：自然语言规约后置条件。\n    \"\"\"\n    assert clamp(1, 0, 10) == 10\n\n\ndef test_clamp_value_greater_than_low_and_not_less_than_high_returns_low():\n    \"\"\"规约后置：若 value >= high 且 value > low 则返回 low。\n\n    输入 value=20, low=0, high=10，满足 value >= high 且 value > low，\n    期望返回 low=0。期望值来源：自然语言规约后置条件。\n    \"\"\"\n    assert clamp(20, 0, 10) == 0\n\n\ndef test_clamp_value_equals_high_and_equals_low_returns_value():\n    \"\"\"规约后置：若 value >= high 且 value <= low 则返回 value。\n\n    输入 value=10, low=10, high=10，满足 value >= high 且 value <= low，\n    期望返回 value=10。期望值来源：自然语言规约后置条件。\n    \"\"\"\n    assert clamp(10, 10, 10) == 10\n\n\ndef test_clamp_value_equals_low_less_than_high_returns_high():\n    \"\"\"边界：value == low 且 value < high。\n\n    输入 value=0, low=0, high=10，满足 value < high，期望返回 high=10。\n    期望值来源：自然语言规约后置条件（value < high 分支优先）。\n    \"\"\"\n    assert clamp(0, 0, 10) == 10\n\n\ndef test_clamp_value_zero_within_range_returns_high():\n    \"\"\"边界：value 为 0 且区间含 0。\n\n    输入 value=0, low=-5, high=5，满足 value < high，期望返回 high=5。\n    期望值来源：自然语言规约后置条件。\n    \"\"\"\n    assert clamp(0, -5, 5) == 5\n\n\ndef test_clamp_negative_value_returns_high():\n    \"\"\"边界：value 为负数。\n\n    输入 value=-3, low=-10, high=-1，满足 value < high，期望返回 high=-1。\n    期望值来源：自然语言规约后置条件。\n    \"\"\"\n    assert clamp(-3, -10, -1) == -1\n\n\ndef test_clamp_value_between_low_and_high_returns_high():\n    \"\"\"边界：value < high 且 value > low 同时成立。\n\n    输入 value=5, low=0, high=10，两条件同时成立；按规约后置条件\n    \"若 value < high 则返回 high\"，期望返回 high=10。\n    期望值来源：自然语言规约后置条件（体现与常规 clamp 语义的差异）。\n    \"\"\"\n    assert clamp(5, 0, 10) == 10\n\n\n# ---------------------------------------------------------------------------\n# 非法区间：low > high（前置条件未校验，规约未定义具体返回值）\n# ---------------------------------------------------------------------------\n\ndef test_clamp_invalid_range_low_greater_than_high_records_behavior():\n    \"\"\"边界：low > high 的非法区间。\n\n    前置条件声明\"调用方期望 low <= high（代码未校验）\"，规约未对\n    low > high 时的返回值给出确定约定，因此本用例仅断言后置不变式\n    （返回值属于 {high, low, value}），并记录实际行为。\n    期望值来源不明，需人工确认。\n    \"\"\"\n    value, low, high = 5, 10, 0\n    result = clamp(value, low, high)\n    assert result in (high, low, value)\n\n\n# ---------------------------------------------------------------------------\n# 后置不变式：返回值必须属于 {high, low, value}\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\n    \"value, low, high\",\n    [\n        (1, 0, 10),\n        (20, 0, 10),\n        (10, 10, 10),\n        (0, 0, 10),\n        (0, -5, 5),\n        (-3, -10, -1),\n        (5, 0, 10),\n        (-100, -50, 50),\n        (100, -50, 50),\n        (7, 7, 7),\n    ],\n)\ndef test_clamp_result_in_allowed_set(value, low, high):\n    \"\"\"规约后置不变式：返回值属于 {high, low, value} 之一。\n\n    对多组满足前置条件（均为 int，low <= high）的输入，断言返回值\n    必为 high、low 或 value 三者之一。期望值来源：可执行规约后置子句。\n    \"\"\"\n    result = clamp(value, low, high)\n    assert result in (high, low, value)\n\n\n# ---------------------------------------------------------------------------\n# 前置条件：参数均为 int 类型\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\n    \"value, low, high\",\n    [\n        (1, 0, 10),\n        (20, 0, 10),\n        (10, 10, 10),\n        (0, -5, 5),\n        (-3, -10, -1),\n    ],\n)\ndef test_clamp_returns_int(value, low, high):\n    \"\"\"规约前置/后置：参数均为 int，返回值为 int。\n\n    期望值来源：函数签名类型注解与自然语言规约。\n    \"\"\"\n    result = clamp(value, low, high)\n    assert isinstance(result, int)",
