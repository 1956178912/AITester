          "generated_test": "import pytest\n\nfrom task_0022 import add_item\nimport task_0022\n\n\n@pytest.fixture(autouse=True)\ndef clean_stock():\n    \"\"\"每个测试前后清空模块级 _STOCK，保证测试隔离。\"\"\"\n    task_0022._STOCK.clear()\n    yield\n    task_0022._STOCK.clear()\n\n\ndef test_add_item_new_sku_writes_stock():\n    \"\"\"新增 sku 写入库存：_STOCK[1] == 10，返回 None。\"\"\"\n    result = add_item(1, 10)\n    assert result is None\n    assert task_0022._STOCK[1] == 10\n\n\ndef test_add_item_duplicate_sku_overwrites_old_value():\n    \"\"\"重复 sku 覆盖旧值：先写 10 再写 5，_STOCK[1] == 5。\"\"\"\n    add_item(1, 10)\n    result = add_item(1, 5)\n    assert result is None\n    assert task_0022._STOCK[1] == 5\n\n\ndef test_add_item_qty_zero():\n    \"\"\"qty == 0 被正常写入，_STOCK[2] == 0。\"\"\"\n    result = add_item(2, 0)\n    assert result is None\n    assert task_0022._STOCK[2] == 0\n\n\ndef test_add_item_qty_negative():\n    \"\"\"qty < 0 按规约仍被写入，_STOCK[3] == -5，无异常。\"\"\"\n    result = add_item(3, -5)\n    assert result is None\n    assert task_0022._STOCK[3] == -5\n\n\ndef test_add_item_sku_zero():\n    \"\"\"sku == 0 作为合法字典键被写入，_STOCK[0] == 7。\"\"\"\n    result = add_item(0, 7)\n    assert result is None\n    assert task_0022._STOCK[0] == 7\n\n\ndef test_add_item_sku_negative():\n    \"\"\"sku < 0 作为合法字典键被写入，_STOCK[-1] == 3。\"\"\"\n    result = add_item(-1, 3)\n    assert result is None\n    assert task_0022._STOCK[-1] == 3\n\n\ndef test_add_item_sku_large_integer():\n    \"\"\"极大整数 sku 可正常作为键写入，无溢出问题。\"\"\"\n    big_sku = 999999999999999999\n    result = add_item(big_sku, 1)\n    assert result is None\n    assert task_0022._STOCK[big_sku] == 1\n\n\ndef test_add_item_qty_large_integer():\n    \"\"\"极大整数 qty 可正常写入，无溢出问题。\"\"\"\n    big_qty = 999999999999999999\n    result = add_item(4, big_qty)\n    assert result is None\n    assert task_0022._STOCK[4] == big_qty\n\n\ndef test_add_item_other_keys_unchanged():\n    \"\"\"写入新 sku 不影响 _STOCK 中其他键的映射关系。\"\"\"\n    add_item(10, 100)\n    add_item(20, 200)\n    add_item(30, 300)\n    assert task_0022._STOCK[10] == 100\n    assert task_0022._STOCK[20] == 200\n    assert task_0022._STOCK[30] == 300\n\n\ndef test_add_item_non_int_types_exploratory():\n    \"\"\"非 int 类型入参：规约声明类型注解为 int 但运行时不强制校验，\n    期望值来源不明，需人工确认。此处仅记录实际行为，不做具体值断言。\"\"\"\n    try:\n        result = add_item(\"abc\", \"10\")\n    except Exception as exc:  # noqa: BLE001\n        # 记录实际行为：若实现抛异常，则记录异常类型\n        assert exc is not None\n        return\n    # 若未抛异常，仅记录返回值与写入行为，不臆造期望值\n    assert result is None\n    assert \"abc\" in task_0022._STOCK",
