          "generated_test": "import pytest\n\nfrom task_0066 import clamp\n\n\n# ---------------------------------------------------------------------------\n# 正常分支用例\n# ---------------------------------------------------------------------------\n\ndef test_clamp_value_less_than_high_returns_high():\n    \"\"\"规约：当 value < high 成立时返回 high。\"\"\"\n    assert clamp(1, 0, 10) == 10\n\n\ndef test_clamp_value_greater_than_low_and_not_less_than_high_returns_low():\n    \"\"\"规约：value < high 不成立且 value > low 成立时返回 low。\"\"\"\n    assert clamp(5, 3, 4) == 3\n\n\ndef test_clamp_both_branches_false_returns_value():\n    \"\"\"规约：两分支条件均不成立时返回 value。\"\"\"\n    assert clamp(5, 10, 3) == 5\n\n\n# ---------------------------------------------------------------------------\n# 边界用例\n# ---------------------------------------------------------------------------\n\ndef test_clamp_value_equals_high_boundary():\n    \"\"\"边界：value == high 时 value < high 为假，value > low 为真，返回 low。\"\"\"\n    assert clamp(10, 0, 10) == 0\n\n\ndef test_clamp_value_equals_low_boundary():\n    \"\"\"边界：value == low 时 value < high 为真，返回 high。\"\"\"\n    assert clamp(0, 0, 10) == 10\n\n\ndef test_clamp_value_equals_low_equals_high():\n    \"\"\"边界：value == low == high，两分支均为假，返回 value。\"\"\"\n    assert clamp(5, 5, 5) == 5\n\n\ndef test_clamp_value_zero():\n    \"\"\"边界：value 为 0 时 value < high 为真，返回 high。\"\"\"\n    assert clamp(0, -10, 10) == 10\n\n\ndef test_clamp_value_negative():\n    \"\"\"边界：value 为负数且小于 high，返回 high。\"\"\"\n    assert clamp(-5, -10, -1) == -1\n\n\ndef test_clamp_low_greater_than_high_inverted_range():\n    \"\"\"边界：low > high 时两分支均不成立，返回 value；验证实现未校验区间合法性。\"\"\"\n    assert clamp(5, 10, 3) == 5\n\n\ndef test_clamp_max_int():\n    \"\"\"边界：value 为极大整数时 value < high 为假、value > low 为真，返回 low。\"\"\"\n    assert clamp(9223372036854775807, 0, 1) == 1\n\n\ndef test_clamp_min_int():\n    \"\"\"边界：value 为极小整数时 value < high 为真，返回 high。\"\"\"\n    assert clamp(-9223372036854775808, 0, 1) == 1\n\n\