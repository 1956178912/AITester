          "generated_test": "import pytest\n\nfrom task_0052 import factorial\n\n\nclass TestFactorialBoundary:\n    \"\"\"边界用例：递归基例与最小递归情形。\"\"\"\n\n    def test_factorial_n_zero_returns_one(self):\n        \"\"\"n == 0 时返回 1（规约：n == 0 时返回 1）。\"\"\"\n        result = factorial(0)\n        assert result == 1\n        assert isinstance(result, int)\n\n    def test_factorial_n_one_returns_one(self):\n        \"\"\"n == 1 时返回 1（规约：n > 0 时返回 n!，1! == 1）。\"\"\"\n        result = factorial(1)\n        assert result == 1\n        assert isinstance(result, int)\n\n\nclass TestFactorialNormal:\n    \"\"\"正常路径：验证 n! 的递归主路径。\"\"\"\n\n    @pytest.mark.parametrize(\n        \"n, expected\",\n        [\n            (2, 2),\n            (3, 6),\n            (5, 120),\n            (10, 3628800),\n        ],\n    )\n    def test_factorial_positive_returns_factorial(self, n, expected):\n        \"\"\"n > 0 时返回 n!（规约：n > 0 时返回 n * factorial(n-1)）。\"\"\"\n        result = factorial(n)\n        assert result == expected\n        assert isinstance(result, int)\n\n    def test_factorial_result_is_int_and_at_least_one(self):\n        \"\"\"后置条件：返回值类型为 int 且 result >= 1。\"\"\"\n        for n in (0, 1, 2, 3, 4, 5):\n            result = factorial(n)\n            assert isinstance(result, int)\n            assert result >= 1\n\n    def test_factorial_matches_iterative_reference(self):\n        \"\"\"与独立迭代实现对照，验证 n! 数值（规约：n > 0 时返回 n!）。\"\"\"\n        for n in range(0, 13):\n            expected = 1\n            for k in range(2, n + 1):\n                expected *= k\n            assert factorial(n) == expected\n\n\nclass TestFactorialError:\n    \"\"\"错误路径：违反前置条件或超出递归深度。\"\"\"\n\n    def test_factorial_negative_raises_recursion_error(self):\n        \"\"\"n 为负数时无基例可达，预期抛出 RecursionError。\n\n        期望值来源：规约边界情况「n 为负数（无基例可达，无限递归导致\n        RecursionError）」。具体异常信息由解释器决定，不做断言。\n        \"\"\"\n        with pytest.raises(RecursionError):\n            factorial(-1)\n\n    def test_factorial_large_n_raises_recursion_error(self):\n        \"\"\"n 较大（如 1000）时递归深度超限，预期抛出 RecursionError。\n\n        期望值来源：规约边界情况「n 较大（如 1000）时递归深度超限，\n        触发 RecursionError」。具体阈值依赖解释器配置，不做断言。\n        \"\"\"\n        with pytest.raises(RecursionError):\n            factorial(1000)",
