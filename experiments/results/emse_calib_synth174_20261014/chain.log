          "generated_test": "import pytest\n\nfrom task_0034 import pick_label\n\n\n# ---------------------------------------------------------------------------\n# 正常分支\n# ---------------------------------------------------------------------------\n\ndef test_pick_label_high_score_returns_excellent():\n    \"\"\"score>=90 时应返回 \"excellent\"（后置条件：score >= 90 -> \"excellent\"）。\"\"\"\n    assert pick_label(95) == \"excellent\"\n\n\ndef test_pick_label_mid_score_returns_pass():\n    \"\"\"60<=score<90 时应返回 \"pass\"（后置条件：60 <= score < 90 -> \"pass\"）。\"\"\"\n    assert pick_label(75) == \"pass\"\n\n\ndef test_pick_label_low_score_returns_none():\n    \"\"\"score<60 时函数无显式 return，隐式返回 None（后置条件：score < 60 -> None）。\"\"\"\n    assert pick_label(30) is None\n\n\n# ---------------------------------------------------------------------------\n# 边界分支\n# ---------------------------------------------------------------------------\n\ndef test_pick_label_boundary_90_returns_excellent():\n    \"\"\"score=90 为 excellent 分支的等号边界，应返回 \"excellent\"。\"\"\"\n    assert pick_label(90) == \"excellent\"\n\n\ndef test_pick_label_boundary_89_returns_pass():\n    \"\"\"score=89 紧邻 90 下方，应落入 pass 分支，返回 \"pass\"。\"\"\"\n    assert pick_label(89) == \"pass\"\n\n\ndef test_pick_label_boundary_60_returns_pass():\n    \"\"\"score=60 为 pass 分支的等号边界，应返回 \"pass\"。\"\"\"\n    assert pick_label(60) == \"pass\"\n\n\ndef test_pick_label_boundary_59_returns_none():\n    \"\"\"score=59 紧邻 60 下方，应落入隐式 None 分支，返回 None。\"\"\"\n    assert pick_label(59) is None\n\n\ndef test_pick_label_zero_returns_none():\n    \"\"\"score=0 落入 score<60 分支，应返回 None。\"\"\"\n    assert pick_label(0) is None\n\n\ndef test_pick_label_negative_returns_none():\n    \"\"\"负数 score 落入 score<60 分支，应返回 None。\"\"\"\n    assert pick_label(-10) is None\n\n\ndef test_pick_label_large_integer_returns_excellent():\n    \"\"\"极大整数 score 不溢出且 score>=90，应返回 \"excellent\"。\"\"\"\n    assert pick_label(10 ** 12) == \"excellent\"\n\n\n# ---------------------------------------------------------------------------\n# 前置条件违反（非 int 输入）\n# ---------------------------------------------------------------------------\n\ndef test_pick_label_str_input_raises_type_error():\n    \"\"\"前置条件要求 score 为 int；传入 str 时比较运算会抛 TypeError。\n\n    期望异常类型来源：规约前置条件 isinstance(score, int) 被违反，\n    具体异常类型由运行时比较运算决定，此处按 Python 语义断言 TypeError。\n    \"\"\"\n    with pytest.raises(TypeError):\n        pick_label(\"90\")\n\n\ndef test_pick_label_none_input_raises_type_error():\n    \"\"\"前置条件要求 score 为 int；传入 None 时比较运算会抛 TypeError。\n\n    期望异常类型来源：规约前置条件 isinstance(score, int) 被违反，\n    具体异常类型由运行时比较运算决定，此处按 Python 语义断言 TypeError。\n    \"\"\"\n    with pytest.raises(TypeError):\n        pick_label(None)\n\n\n# ---------------------------------------------------------------------------\n# 参数化覆盖（规约可判定的后置条件）\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\n    \"score, expected\",\n    [\n        (100, \"excellent\"),\n        (90, \"excellent\"),\n        (89, \"pass\"),\n        (60, \"pass\"),\n        (59, None),\n        (0, None),\n        (-1, None),\n    ],\n)\ndef test_pick_label_postcondition_branches(score, expected):\n    \"\"\"参数化验证各分支后置条件：>=90 -> excellent，60~89 -> pass，<60 -> None。\"\"\"\n    assert pick_label(score) == expected",
