          "generated_test": "import math\n\nimport pytest\n\nfrom task_0073 import sqrt\n\n\n# ---------------------------------------------------------------------------\n# 正常路径 / 边界：完全平方数、不动点、零\n# ---------------------------------------------------------------------------\n\ndef test_sqrt_zero_returns_zero():\n    \"\"\"x == 0 时，规约约定直接返回 0（显式分支）。\"\"\"\n    result = sqrt(0.0)\n    assert result == 0\n\n\ndef test_sqrt_four_returns_two():\n    \"\"\"x == 4 时，规约约定返回 x ** 0.5 == 2.0。\"\"\"\n    result = sqrt(4.0)\n    assert result == 2.0\n\n\ndef test_sqrt_nine_returns_three():\n    \"\"\"x == 9 时，规约约定返回 x ** 0.5 == 3.0。\"\"\"\n    result = sqrt(9.0)\n    assert result == 3.0\n\n\ndef test_sqrt_one_is_fixed_point():\n    \"\"\"x == 1 为不动点，规约约定返回 1.0。\"\"\"\n    result = sqrt(1.0)\n    assert result == 1.0\n\n\n# ---------------------------------------------------------------------------\n# 后置条件：result == x ** 0.5（x != 0）\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\"x\", [2.0, 3.0, 5.0, 16.0, 25.0, 0.25, 0.01])\ndef test_sqrt_matches_power_half(x):\n    \"\"\"x != 0 时，规约约定 result == x ** 0.5。\"\"\"\n    result = sqrt(x)\n    assert result == x ** 0.5\n\n\n@pytest.mark.parametrize(\"x\", [2.0, 3.0, 5.0, 16.0, 25.0, 0.25, 0.01])\ndef test_sqrt_square_roundtrip(x):\n    \"\"\"后置条件：result * result 约等于 x（浮点误差内）。\"\"\"\n    result = sqrt(x)\n    assert math.isclose(result * result, x, rel_tol=1e-9, abs_tol=1e-12)\n\n\n# ---------------------------------------------------------------------------\n# 边界：极小正数 / 极大值\n# 期望值来源不明（docstring 未约定下溢 / 溢出行为），\n# 仅断言规约中可判定的后置条件，并记录实际行为，需人工确认。\n# ---------------------------------------------------------------------------\n\ndef test_sqrt_tiny_positive_boundary():\n    \"\"\"x 为极小正数 1e-308。\n\n    期望值来源不明，需人工确认：docstring 未约定浮点下溢行为。\n    此处仅断言规约后置条件 result == x ** 0.5（x != 0 分支）。\n    \"\"\"\n    x = 1e-308\n    result = sqrt(x)\n    assert result == x ** 0.5\n\n\ndef test_sqrt_huge_value_boundary():\n    \"\"\"x 为极大值 1e308。\n\n    期望值来源不明，需人工确认：docstring 未约定溢出行为。\n    此处仅断言规约后置条件 result == x ** 0.5（x != 0 分支）。\n    \"\"\"\n    x = 1e308\n    result = sqrt(x)\n    assert result == x ** 0.5\n\n\n# ---------------------------------------------------------------------------\n# 异常 / 未约定路径：负数、NaN、inf\n# 规约未约定这些输入的具体返回值，禁止臆造具体值；\n# 采用探索性断言：记录实际行为，并标注需人工确认。\n# ---------------------------------------------------------------------------\n\ndef test_sqrt_negative_input_behavior():\n    \"\"\"x 为负数（-4.0）。\n\n    期望值来源不明，需人工确认：docstring 未约定负数行为，\n    且代码未做校验。规约仅说明 x ** 0.5 在 Python 中返回复数，\n    与 float 返回注解不符。此处记录实际行为，不臆造具体值。\n    \"\"\"\n    x = -4.0\n    result = sqrt(x)\n    # 记录实际行为：若实现按 x ** 0.5 计算，结果为复数 (2j)。\n    # 仅断言与规约描述一致：结果等于 x ** 0.5。\n    assert result == x ** 0.5\n\n\ndef test_sqrt_nan_input_behavior():\n    \"\"\"x 为 NaN。\n\n    期望值来源不明，需人工确认：docstring 未约定 NaN 行为。\n    此处记录实际行为：NaN != 0，走 x ** 0.5 分支。\n    \"\"\"\n    x = float(\"nan\")\n    result = sqrt(x)\n    # NaN 的平方根仍为 NaN；断言与规约后置条件 result == x ** 0.5 一致。\n    assert math.isnan(result) == math.isnan(x ** 0.5)\n\n\ndef test_sqrt_inf_input_behavior():\n    \"\"\"x 为 inf。\n\n    期望值来源不明，需人工确认：docstring 未约定 inf 行为。\n    此处记录实际行为：inf != 0，走 x ** 0.5 分支。\n    \"\"\"\n    x = float(\"inf\")\n    result = sqrt(x)\n    # 仅断言与规约后置条件 result == x ** 0.5 一致。\n    assert result == x ** 0.5",
