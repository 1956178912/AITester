r。\n\n    期望值来源：规约后置条件「int 无 strip 方法，故实际执行必然抛 AttributeError」。\n    具体异常消息未知，仅断言异常类型。\n    \"\"\"\n    with pytest.raises(AttributeError):\n        display(\"alpha\")\n\n\ndef test_display_success_path_contract_if_no_exception():\n    \"\"\"探索性用例：若实现被修复（不再抛异常），则校验规约声明的成功路径后置条件。\n\n    期望值来源：规约后置条件「返回值以 \"name=\" + name + \" \" 开头」。\n    当前实现按规约必然抛 AttributeError，因此本用例在缺陷存在时跳过，\n    不掩盖问题，也不恒失败。\n    \"\"\"\n    name = \"alpha\"\n    try:\n        result = display(name)\n    except AttributeError:\n        pytest.skip(\n            \"当前实现按规约抛 AttributeError（int 无 strip 方法），\"\n            \"成功路径后置条件无法验证；期望值来源：规约后置条件。\"\n        )\n    assert isinstance(result, str)\n    assert result.startswith(\"name=\" + name + \" \")",
