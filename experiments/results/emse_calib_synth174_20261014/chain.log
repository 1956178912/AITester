          "generated_test": "import pytest\n\nfrom task_0061 import compute_scores\n\n\ndef test_compute_scores_normal_multiple_records():\n    \"\"\"正常多记录：验证基本映射构建。\n\n    期望值来源：规约「返回字典的键集合等于各记录 name 的集合」。\n    \"\"\"\n    records = [{\"name\": \"a\", \"value\": 1}, {\"name\": \"b\", \"value\": 2}]\n    result = compute_scores(records)\n    assert isinstance(result, dict)\n    assert result == {\"a\": 1, \"b\": 2}\n\n\ndef test_compute_scores_empty_list():\n    \"\"\"空列表：验证空输入返回空字典。\n\n    期望值来源：规约边界「records 为空列表 → 返回 {}」。\n    \"\"\"\n    result = compute_scores([])\n    assert isinstance(result, dict)\n    assert result == {}\n\n\ndef test_compute_scores_missing_name_and_value():\n    \"\"\"缺省 name 与 value：验证 get 默认值分支。\n\n    期望值来源：规约边界「记录缺少 name 键 → 键为 \"unknown\"」、\n    「记录缺少 value 键 → 值为 0」。\n    \"\"\"\n    result = compute_scores([{}])\n    assert isinstance(result, dict)\n    assert result == {\"unknown\": 0}\n\n\ndef test_compute_scores_missing_name_only():\n    \"\"\"仅缺省 name：键应为 \"unknown\"，值保留。\n\n    期望值来源：规约边界「记录缺少 name 键 → 键为 \"unknown\"」。\n    \"\"\"\n    result = compute_scores([{\"value\": 7}])\n    assert isinstance(result, dict)\n    assert result == {\"unknown\": 7}\n\n\ndef test_compute_scores_missing_value_only():\n    \"\"\"仅缺省 value：值应为 0，键保留。\n\n    期望值来源：规约边界「记录缺少 value 键 → 值为 0」。\n    \"\"\"\n    result = compute_scores([{\"name\": \"a\"}])\n    assert isinstance(result, dict)\n    assert result == {\"a\": 0}\n\n\ndef test_compute_scores_duplicate_name_overwrite():\n    \"\"\"同名覆盖：验证重复键后者覆盖前者。\n\n    期望值来源：规约边界「多条记录同名 → 后出现者覆盖」。\n    \"\"\"\n    records = [{\"name\": \"a\", \"value\": 1}, {\"name\": \"a\", \"value\": 9}]\n    result = compute_scores(records)\n    assert isinstance(result, dict)\n    assert result == {\"a\": 9}\n\n\ndef test_compute_scores_zero_and_negative_values():\n    \"\"\"value 为负数与零：验证 0 与负数不被默认值替换。\n\n    期望值来源：规约边界「value 为 0 / 负数 / 大数」。\n    \"\"\"\n    records = [{\"name\": \"a\", \"value\": 0}, {\"name\": \"b\", \"value\": -5}]\n    result = compute_scores(records)\n    assert isinstance(result, dict)\n    assert result == {\"a\": 0, \"b\": -5}\n\n\ndef test_compute_scores_large_value():\n    \"\"\"value 为大数：验证大数被原样保留。\n\n    期望值来源：规约边界「value 为 0 / 负数 / 大数」。\n    \"\"\"\n    big = 10 ** 18\n    result = compute_scores([{\"name\": \"big\", \"value\": big}])\n    assert isinstance(result, dict)\n    assert result == {\"big\": big}\n\n\ndef test_compute_scores_postcondition_dict_and_length():\n    \"\"\"后置条件：返回值为 dict 且 len(result) <= len(records)。\n\n    期望值来源：可执行规约后置子句。\n    \"\"\"\n    records = [\n        {\"name\": \"a\", \"value\": 1},\n        {\"name\": \"a\", \"value\": 2},\n        {\"name\": \"b\", \"value\": 3},\n    ]\n    result = compute_scores(records)\n    assert isinstance(result, dict)\n    assert len(result) <= len(records)\n\n\ndef test_compute_scores_invariant_keys_are_str():\n    \"\"\"不变量：返回字典所有键均为 str。\n\n    期望值来源：可执行规约不变量子句。\n    \"\"\"\n    records = [{\"name\": \"a\", \"value\": 1}, {}, {\"value\": 2}]\n    result = compute_scores(records)\n    assert all(isinstance(k, str) for k in result)\n\n\ndef test_compute_scores_keys_match_names():\n    \"\"\"后置条件：返回字典的键集合等于各记录 name（缺省 \"unknown\"）的集合。\n\n    期望值来源：可执行规约后置子句。\n    \"\"\"\n    records = [\n        {\"name\": \"a\", \"value\": 1},\n        {\"value\": 2},\n        {\"name\": \"b\", \"value\": 3},\n    ]\n    result = compute_scores(records)\n    expected_keys = {r.get(\"name\", \"unknown\") for r in records}\n    assert set(result.keys()) == expected_keys\n\n\ndef test_compute_scores_non_list_input_raises():\n    \"\"\"非列表输入：None 不满足前置条件 isinstance(records, list)。\n\n    期望值来源：规约前置条件；具体异常类型未在规约中明确，\n    此处仅断言抛出异常（Exception 子类），需人工确认具体类型。\n    \"\"\"\n    with pytest.raises(Exception):\n        compute_scores(None)",
