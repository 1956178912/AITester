          "generated_test": "import pytest\n\nfrom task_0019 import lookup\n\n\n# 规约中声明的模块级常量字典（用于推导期望值，不依赖实现内部细节）\n_TABLE = {\"alpha\": 1, \"beta\": 2, \"gamma\": 3}\n\n\n@pytest.mark.parametrize(\n    \"key, expected\",\n    [\n        (\"alpha\", 1),\n        (\"beta\", 2),\n        (\"gamma\", 3),\n    ],\n)\ndef test_lookup_hit_returns_table_value(key, expected):\n    \"\"\"命中 _TABLE 的键应返回对应整数值。\n\n    期望值来源：规约后置条件 result == _TABLE[key]。\n    \"\"\"\n    result = lookup(key)\n    assert isinstance(result, int)\n    assert result == expected\n    assert result == _TABLE[key]\n\n\n@pytest.mark.parametrize(\n    \"key\",\n    [\"delta\", \"\", \"Alpha\", \"ALPHA\", \" alpha\", \"alpha \", \"a\" * 10000],\n)\ndef test_lookup_miss_returns_zero(key):\n    \"\"\"未命中 _TABLE 的键应返回默认值 0。\n\n    期望值来源：规约后置条件 key 不在 _TABLE 中时返回 0，\n    以及边界情况（空字符串、大小写变体、带空白、超长字符串）。\n    \"\"\"\n    result = lookup(key)\n    assert isinstance(result, int)\n    assert result == 0\n\n\ndef test_lookup_none_key_returns_zero():\n    \"\"\"None 键未命中应返回 0。\n\n    期望值来源：规约边界情况——dict.get 可接受任意可哈希对象，\n    None 未命中返回 0；类型注解未约束运行时行为。\n    \"\"\"\n    result = lookup(None)\n    assert isinstance(result, int)\n    assert result == 0\n\n\ndef test_lookup_unhashable_key_raises_type_error():\n    \"\"\"不可哈希的键（如 list）应抛出 TypeError。\n\n    期望值来源：规约边界情况——dict.get 对不可哈希对象会抛 TypeError，\n    代码未捕获异常，故走异常路径。\n    \"\"\"\n    with pytest.raises(TypeError):\n        lookup([\"alpha\"])\n\n\n@pytest.mark.parametrize(\n    \"key\",\n    [\"alpha\", \"beta\", \"gamma\", \"delta\", \"\", \"Alpha\", \" alpha\", \"a\" * 10000],\n)\ndef test_lookup_result_invariant(key):\n    \"\"\"返回值恒为 int 且落在不变量集合 (0, 1, 2, 3) 内。\n\n    期望值来源：规约后置条件 isinstance(result, int)、result >= 0，\n    以及不变量 result in (0, 1, 2, 3)。\n    \"\"\"\n    result = lookup(key)\n    assert isinstance(result, int)\n    assert result >= 0\n    assert result in (0, 1, 2, 3)\n\n\n@pytest.mark.parametrize(\n    \"key\",\n    [\"alpha\", \"beta\", \"gamma\", \"delta\", \"\", \"Alpha\", \" alpha\", \"a\" * 10000],\n)\ndef test_lookup_matches_table_get_semantics(key):\n    \"\"\"返回值应与 _TABLE.get(key, 0) 语义一致。\n\n    期望值来源：规约后置条件 result == _TABLE.get(key, 0)。\n    \"\"\"\n    result = lookup(key)\n    assert result == _TABLE.get(key, 0)",
