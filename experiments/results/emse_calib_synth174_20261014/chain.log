          "generated_test": "import math\n\nimport pytest\n\nfrom task_0086 import divide\n\n\nclass TestDivideNormal:\n    \"\"\"正常除法场景测试。\"\"\"\n\n    def test_divide_positive_numbers(self):\n        \"\"\"验证基本正数除法返回正确商：6.0 / 3.0 == 2.0。\"\"\"\n        result = divide(6.0, 3.0)\n        assert result == 2.0\n\n    def test_divide_negative_dividend(self):\n        \"\"\"验证负数被除数的商为负：-6.0 / 3.0 == -2.0。\"\"\"\n        result = divide(-6.0, 3.0)\n        assert result == -2.0\n\n    def test_divide_negative_divisor(self):\n        \"\"\"验证负数除数的商为负：6.0 / -3.0 == -2.0。\"\"\"\n        result = divide(6.0, -3.0)\n        assert result == -2.0\n\n    def test_divide_both_negative(self):\n        \"\"\"验证双负数相除返回正商：-6.0 / -3.0 == 2.0。\"\"\"\n        result = divide(-6.0, -3.0)\n        assert result == 2.0\n\n    def test_divide_non_exact_quotient(self):\n        \"\"\"验证非整除时返回浮点近似商：1.0 / 3.0 == 0.3333333333333333。\"\"\"\n        result = divide(1.0, 3.0)\n        assert result == 0.3333333333333333\n\n\nclass TestDivideBoundary:\n    \"\"\"边界场景测试。\"\"\"\n\n    def test_divide_zero_dividend(self):\n        \"\"\"验证被除数为 0 时返回 0.0：0.0 / 5.0 == 0.0。\"\"\"\n        result = divide(0.0, 5.0)\n        assert result == 0.0\n\n    def test_divide_zero_dividend_negative_divisor(self):\n        \"\"\"验证被除数为 0 且除数为负时返回 0.0：0.0 / -5.0 == 0.0。\"\"\"\n        result = divide(0.0, -5.0)\n        assert result == 0.0\n\n    def test_divide_overflow_to_inf(self):\n        \"\"\"验证极大值溢出：1e308 / 1e-308 结果超出 float 范围，返回 inf。\n\n        期望值来源：规约边界情况\"极大值/极小值导致溢出为 inf\"。\n        \"\"\"\n        result = divide(1e308, 1e-308)\n        assert math.isinf(result)\n\n    def test_divide_underflow_to_zero(self):\n        \"\"\"验证极小值下溢：1e-308 / 1e308 结果下溢为 0.0。\n\n        期望值来源：规约边界情况\"极大值/极小值导致溢出为 inf 或下溢为 0.0\"。\n        \"\"\"\n        result = divide(1e-308, 1e308)\n        assert result == 0.0\n\n\nclass TestDivideSpecialValues:\n    \"\"\"NaN / Inf 特殊值场景测试。\"\"\"\n\n    def test_divide_nan_dividend(self):\n        \"\"\"验证被除数为 NaN 时结果为 NaN。\n\n        期望值来源：规约边界情况\"a 或 b 为 NaN/Inf 时结果为 NaN/Inf\"。\n        \"\"\"\n        result = divide(float(\"nan\"), 2.0)\n        assert math.isnan(result)\n\n    def test_divide_nan_divisor(self):\n        \"\"\"验证除数为 NaN 时结果为 NaN。\n\n        期望值来源：规约边界情况\"a 或 b 为 NaN/Inf 时结果为 NaN/Inf\"。\n        \"\"\"\n        result = divide(2.0, float(\"nan\"))\n        assert math.isnan(result)\n\n    def test_divide_inf_dividend(self):\n        \"\"\"验证被除数为 Inf 时结果为正无穷。\n\n        期望值来源：规约边界情况\"a 或 b 为 NaN/Inf 时结果为 NaN/Inf\"。\n        \"\"\"\n        result = divide(float(\"inf\"), 2.0)\n        assert math.isinf(result)\n        assert result > 0\n\n    def test_divide_inf_divisor(self):\n        \"\"\"验证除数为 Inf 时结果趋近于 0.0。\n\n        期望值来源：规约边界情况\"a 或 b 为 NaN/Inf 时结果为 NaN/Inf\"。\n        \"\"\"\n        result = divide(2.0, float(\"inf\"))\n        assert result == 0.0\n\n\nclass TestDivideError:\n    \"\"\"异常场景测试。\"\"\"\n\n    def test_divide_by_zero_raises(self):\n        \"\"\"验证除数为 0 时触发 ZeroDivisionError。\n\n        期望值来源：前置条件\"b 不为 0（否则触发 ZeroDivisionError）\"。\n        \"\"\"\n        with pytest.raises(ZeroDivisionError):\n            divide(1.0, 0.0)\n\n    def test_divide_zero_by_zero_raises(self):\n        \"\"\"验证 0.0 / 0.0 同样触发 ZeroDivisionError。\n\n        期望值来源：前置条件\"b 不为 0（否则触发 ZeroDivisionError）\"。\n        \"\"\"\n        with pytest.raises(ZeroDivisionError):\n            divide(0.0, 0.0)\n\n\nclass TestDividePostcondition:\n    \"\"\"后置条件验证：result * b 约等于 a。\"\"\"\n\n    @pytest.mark.parametrize(\n        \"a, b\",\n        [\n            (6.0, 3.0),\n            (-6.0, 3.0),\n            (6.0, -3.0),\n            (-6.0, -3.0),\n            (1.0, 3.0),\n            (0.0, 5.0),\n            (2.5, 0.5),\n        ],\n    )\n    def test_divide_result_times_divisor_approx_dividend(self, a, b):\n        \"\"\"验证后置条件：当 b != 0 时 result * b 约等于 a。\n\n        期望值来源：后置条件\"当 b != 0 时 result * b 约等于 a\"。\n        \"\"\"\n  