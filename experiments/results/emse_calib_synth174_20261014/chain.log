          "generated_test": "import pytest\n\nfrom task_0002 import is_valid_username\n\n\nclass TestIsValidUsername:\n    \"\"\"Tests for is_valid_username.\n\n    Note: the function name suggests it should return True for valid usernames,\n    but the implementation returns `not ok`, i.e. it returns True for INVALID\n    usernames. The tests below document the actual behavior of the\n    implementation (which is the source of truth here), and the docstring of\n    each test flags the naming/behavior mismatch where relevant.\n    \"\"\"\n\n    def test_is_valid_username_returns_true_for_empty_string(self):\n        \"\"\"Empty string: bool('') is False -> ok is False -> returns True.\n\n        Expected value derived from the implementation logic\n        (bool(name) and name.isalnum() and len(name) <= 20).\n        \"\"\"\n        assert is_valid_username(\"\") is True\n\n    def test_is_valid_username_returns_false_for_simple_alnum_name(self):\n        \"\"\"A short alphanumeric name makes ok True, so the function returns False.\n\n        Expected value derived from the implementation logic.\n        \"\"\"\n        assert is_valid_username(\"alice\") is False\n\n    def test_is_valid_username_returns_false_for_single_char(self):\n        \"\"\"Single alphanumeric character: ok is True -> returns False.\"\"\"\n        assert is_valid_username(\"a\") is False\n\n    def test_is_valid_username_returns_false_for_digits_only(self):\n        \"\"\"Digits are alphanumeric, so ok is True -> returns False.\"\"\"\n        assert is_valid_username(\"12345\") is False\n\n    def test_is_valid_username_returns_false_for_mixed_alnum(self):\n        \"\"\"Mixed letters and digits are alphanumeric -> returns False.\"\"\"\n        assert is_valid_username(\"user123\") is False\n\n    def test_is_valid_username_returns_false_for_exactly_20_chars(self):\n        \"\"\"Boundary: length exactly 20 with alnum content -> ok True -> False.\n\n        Boundary value (20) comes from the `len(name) <= 20` check in the\n        implementation.\n        \"\"\"\n        name = \"a\" * 20\n        assert len(name) == 20\n        assert is_valid_username(name) is False\n\n    def test_is_valid_username_returns_true_for_21_chars(self):\n        \"\"\"Boundary: length 21 exceeds the <= 20 limit -> ok False -> True.\n\n        Boundary value (21) comes from the `len(name) <= 20` check.\n        \"\"\"\n        name = \"a\" * 21\n        assert len(name) == 21\n        assert is_valid_username(name) is True\n\n    def test_is_valid_username_returns_true_for_long_alnum_name(self):\n        \"\"\"A long alphanumeric name (> 20 chars) -> ok False -> True.\"\"\"\n        assert is_valid_username(\"a\" * 100) is True\n\n    def test_is_valid_username_returns_true_for_name_with_space(self):\n        \"\"\"A space is not alphanumeric -> ok False -> True.\"\"\"\n        assert is_valid_username(\"user name\") is True\n\n    def test_is_valid_username_returns_true_for_name_with_underscore(self):\n        \"\"\"Underscore is not alphanumeric -> ok False -> True.\"\"\"\n        assert is_valid_username(\"user_name\") is True\n\n    def test_is_valid_username_returns_true_for_name_with_hyphen(self):\n        \"\"\"Hyphen is not alphanumeric -> ok False -> True.\"\"\"\n        assert is_valid_username(\"user-name\") is True\n\n    def test_is_valid_username_returns_true_for_name_with_special_chars(self):\n        \"\"\"Special characters are not alphanumeric -> ok False -> True.\"\"\"\n        assert is_valid_username(\"user@name!\") is True\n\n    def test_is_valid_username_returns_true_for_whitespace_only(self):\n        \"\"\"Whitespace-only string: bool is True but isalnum() is False -> True.\"\"\"\n        assert is_valid_username(\"   \") is True\n\n    def test_is_valid_username_returns_true_for_unicode_letters(self):\n        \"\"\"Unicode letters are alphanumeric per str.isalnum() -> ok True -> False.\n\n        Expected value derived from Python's str.isalnum() semantics.\n        \"\"\"\n        assert is_valid_username(\"café\") is False\n\n    def test_is_valid_username_returns_true_for_unicode_digits(self):\n        \"\"\"Unicode digits are alphanumeric per str.isalnum() -> ok True -> False.\"\"\"\n        assert is_valid_username(\"١٢٣\") is False\n\n    def test_is_valid_username_returns_bool_type(self):\n        \"\"\"The return value is always a bool instance.\"\"\"\n        result = is_valid_username(\"alice\")\n        assert isinstance(result, bool)\n\n    @pytest.mark.parametrize(\n        \"name, expected\",\n        [\n            (\"\", True),\n            (\"a\", False),\n            (\"abc123\", False),\n            (\"a\" * 20, False),\n            (\"a\" * 21, True),\n            (\"user name\", True),\n            (\"user_name\", True),\n            (\"user-name\", True),\n            (\"   \", True),\n        ],\n    )\n    def test_is_valid_username_parametrized(self, name, expected):\n        \"\"\"Parametrized check of the actual (inverted) behavior.\n\n        Expected values are derived from the implementation logic:\n        returns `not (bool(name) and name.isalnum() and len(name) <= 20)`.\n        \"\"\"\n        assert is_valid_username(name) is expected\n\n    def test_is_valid_username_does_not_raise_on_non_string(self):\n        \"\"\"Non-string input raises AttributeError because of name.isalnum().\n\n        The type annotation says `name: str`, so passing a non-str is a\n        contract violation; we document the actual failure mode.\n        \"\"\"\n        with pytest.raises(AttributeError):\n            is_valid_username(123)\n\n    def test_is_valid_username_raises_on_none(self):\n        \"\"\"None input: bool(None) is False, short-circuits before isalnum().\n\n        Because `bool(name)` is False, the `and` chain short-circuits and\n        returns True without touching `name.isalnum()`.\n        \"\"\"\n        assert is_valid_username(None) is True",
