          "generated_test": "import pytest\n\nfrom task_0025 import compute_scores\n\n\ndef test_compute_scores_normal_multiple_records():\n    \"\"\"正常多记录：验证基本映射构建，键来自 name，值来自 value。\"\"\"\n    records = [\n        {\"name\": \"a\", \"value\": 1},\n        {\"name\": \"b\", \"value\": 2},\n    ]\n    result = compute_scores(records)\n    assert isinstance(result, dict)\n    assert result == {\"a\": 1, \"b\": 2}\n\n\ndef test_compute_scores_empty_list_returns_empty_dict():\n    \"\"\"边界：空列表返回 {}。\"\"\"\n    result = compute_scores([])\n    assert isinstance(result, dict)\n    assert result == {}\n\n\ndef test_compute_scores_missing_name_defaults_to_unknown():\n    \"\"\"边界：记录缺少 name 键时键为 \"unknown\"。\"\"\"\n    records = [{\"value\": 5}]\n    result = compute_scores(records)\n    assert isinstance(result, dict)\n    assert result == {\"unknown\": 5}\n\n\ndef test_compute_scores_missing_value_defaults_to_zero():\n    \"\"\"边界：记录缺少 value 键时值为 0。\"\"\"\n    records = [{\"name\": \"x\"}]\n    result = compute_scores(records)\n    assert isinstance(result, dict)\n    assert result == {\"x\": 0}\n\n\ndef test_compute_scores_duplicate_name_last_wins():\n    \"\"\"边界：多条记录 name 相同则后者覆盖前者。\"\"\"\n    records = [\n        {\"name\": \"a\", \"value\": 1},\n        {\"name\": \"a\", \"value\": 9},\n    ]\n    result = compute_scores(records)\n    assert isinstance(result, dict)\n    assert result == {\"a\": 9}\n\n\ndef test_compute_scores_negative_value_preserved():\n    \"\"\"边界：value 为负数时原样保留。\"\"\"\n    records = [{\"name\": \"n\", \"value\": -3}]\n    result = compute_scores(records)\n    assert isinstance(result, dict)\n    assert result == {\"n\": -3}\n\n\ndef test_compute_scores_zero_value_preserved():\n    \"\"\"边界：value 为 0 时原样保留（0 是合法值，不应被默认值替换）。\"\"\"\n    records = [{\"name\": \"z\", \"value\": 0}]\n    result = compute_scores(records)\n    assert isinstance(result, dict)\n    assert result == {\"z\": 0}\n\n\ndef test_compute_scores_large_value_preserved():\n    \"\