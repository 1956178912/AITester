          "generated_test": "import pytest\n\nfrom task_0075 import pick_label\n\n\n# ---------------------------------------------------------------------------\n# 正常分支\n# ---------------------------------------------------------------------------\n\ndef test_pick_label_excellent_typical():\n    \"\"\"score=95 命中 score>=90 分支，规约要求返回 \"excellent\"。\"\"\"\n    assert pick_label(95) == \"excellent\"\n\n\ndef test_pick_label_pass_typical():\n    \"\"\"score=75 命中 60<=score<90 分支，规约要求返回 \"pass\"。\"\"\"\n    assert pick_label(75) == \"pass\"\n\n\n# ---------------------------------------------------------------------------\n# 边界值\n# ---------------------------------------------------------------------------\n\ndef test_pick_label_excellent_lower_boundary_90():\n    \"\"\"score==90 为 excellent 下边界（取等），规约要求返回 \"excellent\"。\"\"\"\n    assert pick_label(90) == \"excellent\"\n\n\ndef test_pick_label_pass_upper_boundary_89():\n    \"\"\"score==89 为 pass 上边界，规约要求返回 \"pass\"。\"\"\"\n    assert pick_label(89) == \"pass\"\n\n\ndef test_pick_label_pass_lower_boundary_60():\n    \"\"\"score==60 为 pass 下边界（取等），规约要求返回 \"pass\"。\"\"\"\n    assert pick_label(60) == \"pass\"\n\n\ndef test_pick_label_no_return_boundary_59():\n    \"\"\"score==59 落入 score<60 分支，规约声明隐式返回 None。\"\"\"\n    assert pick_label(59) is None\n\n\ndef test_pick_label_zero():\n    \"\"\"score==0 落入 score<60 分支，规约声明隐式返回 None。\"\"\"\n    assert pick_label(0) is None\n\n\ndef test_pick_label_negative():\n    \"\"\"score=-1 落入 score<60 分支，规约声明隐式返回 None。\"\"\"\n    assert pick_label(-1) is None\n\n\ndef test_pick_label_large_value():\n    \"\"\"score=10**18 命中 score>=90 分支，规约要求返回 \"excellent\"。\"\"\"\n    assert pick_label(10**18) == \"excellent\"\n\n\n# ---------------------------------------------------------------------------\n# 参数化：覆盖规约后置条件的完整分区\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\n    \"score, expected\",\n    [\n        (90, \"excellent\"),\n        (100, \"excellent\"),\n        (10**18, \"excellent\"),\n        (60, \"pass\"),\n        (75, \"pass\"),\n        (89, \"pass\"),\n        (59, None),\n        (0, None),\n        (-1, None),\n        (-100, None),\n    ],\n)\ndef test_pick_label_postcondition_partition(score, expected):\n    \"\"\"按规约后置条件对输入分区逐一验证返回值。\n\n    期望值来源：规约后置条件\n      - score >= 90 -> \"excellent\"\n      - 60 <= score < 90 -> \"pass\"\n      - score < 60 -> None（隐式）\n    \"\"\"\n    assert pick_label(score) == expected\n\n\n# ---------------------------------------------------------------------------\n# 前置条件违反：非 int 输入\n# ---------------------------------------------------------------------------\n\ndef test_pick_label_non_int_raises():\n    \"\"\"前置条件要求 score 为 int；传入字符串违反前置条件。\n\n    期望值来源不明（规约未声明具体异常类型），仅验证异常路径被触发，\n    需人工确认实际异常类型是否为 TypeError。\n    \"\"\"\n    with pytest.raises((TypeError, ValueError)):\n        pick_label(\"90\")",
