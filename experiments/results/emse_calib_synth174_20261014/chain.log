          "generated_test": "import math\n\nimport pytest\n\nfrom task_0027 import divide\n\n\nclass TestDivideNormal:\n    \"\"\"正常路径：验证后置条件 result == a / b。\"\"\"\n\n    def test_divide_positive_exact_quotient(self):\n        \"\"\"规约后置条件：返回值为 a / b 的浮点商（6.0 / 3.0 == 2.0）。\"\"\"\n        result = divide(6.0, 3.0)\n        assert result == 6.0 / 3.0\n        assert result == 2.0\n\n    def test_divide_positive_fractional_quotient(self):\n        \"\"\"规约后置条件：返回值为 a / b 的浮点商（1.0 / 2.0 == 0.5）。\"\"\"\n        result = divide(1.0, 2.0)\n        assert result == 1.0 / 2.0\n        assert result == 0.5\n\n    @pytest.mark.parametrize(\n        \"a, b\",\n        [\n            (6.0, 3.0),\n            (1.0, 2.0),\n            (10.0, 4.0),\n            (7.5, 2.5),\n            (100.0, 8.0),\n        ],\n    )\n    def test_divide_returns_float_quotient(self, a, b):\n        \"\"\"规约后置条件：对任意满足前置条件 b != 0 的输入，返回 a / b。\"\"\"\n        assert b != 0\n        result = divide(a, b)\n        assert result == a / b\n        assert isinstance(result, float)\n\n\nclass TestDivideBoundary:\n    \"\"\"边界情况：a == 0、负数入参、极大/极小浮点数。\"\"\"\n\n    def test_divide_zero_dividend_returns_zero(self):\n        \"\"\"规约边界：a == 0 时结果为 0.0。\"\"\"\n        result = divide(0.0, 5.0)\n        assert result == 0.0\n        assert result == 0.0 / 5.0\n\n    def test_divide_negative_dividend_sign(self):\n        \"\"\"规约边界：负数入参符号处理（-6.0 / 3.0 == -2.0）。\"\"\"\n        result = divide(-6.0, 3.0)\n        assert result == -6.0 / 3.0\n        assert result == -2.0\n\n    def test_divide_negative_divisor_sign(self):\n        \"\"\"规约边界：负数入参符号处理（6.0 / -3.0 == -2.0）。\"\"\"\n        result = divide(6.0, -3.0)\n        assert result == 6.0 / -3.0\n        assert result == -2.0\n\n    def test_divide_both_negative_sign(self):\n        \"\"\"规约边界：负数入参符号处理（-6.0 / -3.0 == 2.0）。\"\"\"\n        result = divide(-6.0, -3.0)\n        assert result == -6.0 / -3.0\n        assert result == 2.0\n\n    def test_divide_overflow_to_inf(self):\n        \"\"\"规约边界：极大数除以极小非零数导致结果溢出为 inf。\n\n        规约明确约定溢出为 inf，故断言 math.isinf 且符号为正。\n        \"\"\"\n        result = divide(1e308, 1e-10)\n        assert math.isinf(result)\n        assert result > 0\n\n    def test_divide_underflow_to_zero(self):\n        \"\"\"规约边界：极小浮点数相除下溢为 0.0。\n\n        规约约定下溢为 0.0，故断言结果为 0.0。\n        \"\"\"\n        result = divide(1e-308, 1e308)\n        assert result == 0.0\n\n    def test_divide_tiny_nonzero_divisor_overflow(self):\n        \"\"\"规约边界：b 为极小非零数导致结果溢出为 inf。\"\"\"\n        result = divide(1.0, 5e-324)\n        assert math.isinf(result)\n        assert result > 0\n\n\nclass TestDivideErrors:\n    \"\"\"异常路径：b == 0 时应抛出 ZeroDivisionError 而非返回。\"\"\"\n\n    def test_divide_by_zero_raises(self):\n        \"\"\"规约后置条件：b == 0 时抛出 ZeroDivisionError。\"\"\"\n        with pytest.raises(ZeroDivisionError):\n            divide(1.0, 0.0)\n\n    def test_divide_zero_by_zero_raises(self):\n        \"\"\"规约边界：0.0 / 0.0 同样抛出 ZeroDivisionError。\"\"\"\n        with pytest.raises(ZeroDivisionError):\n            divide(0.0, 0.0)\n\n    def test_divide_negative_by_zero_raises(self):\n        \"\"\"规约边界：负数除以 0 抛出 ZeroDivisionError。\"\"\"\n        with pytest.raises(ZeroDivisionError):\n            divide(-1.0, 0.0)\n\n    def test_divide_by_negative_zero_raises(self):\n        \"\"\"规约边界：除以 -0.0 抛出 ZeroDivisionError。\"\"\"\n        with pytest.raises(ZeroDivisionError):\n            divide(1.0, -0.0)",
