          "generated_test": "import pytest\n\nfrom task_0086 import best_score\n\n\n# ---------------------------------------------------------------------------\n# 规约驱动的性质断言辅助函数\n# ---------------------------------------------------------------------------\n\ndef _assert_best_score_postconditions(scores, result):\n    \"\"\"断言 best_score 的后置条件与不变量（来自规约，非实现臆测）。\"\"\"\n    # 后置：result in scores\n    assert result in scores\n    # 后置 / 不变量：result 不小于任意元素\n    assert all(result >= s for s in scores)\n\n\n# ---------------------------------------------------------------------------\n# 正常路径\n# ---------------------------------------------------------------------------\n\ndef test_best_score_single_element():\n    \"\"\"单元素列表：best 应为该唯一元素（规约边界：best==worst==该元素）。\"\"\"\n    scores = [5]\n    result = best_score(scores)\n    assert result == 5\n    _assert_best_score_postconditions(scores, result)\n\n\ndef test_best_score_ascending():\n    \"\"\"升序多元素：最大值在末尾，应为 5。\"\"\"\n    scores = [1, 2, 3, 4, 5]\n    result = best_score(scores)\n    assert result == 5\n    _assert_best_score_postconditions(scores, result)\n\n\ndef test_best_score_descending():\n    \"\"\"降序多元素：最大值在首位，应为 5。\"\"\"\n    scores = [5, 4, 3, 2, 1]\n    result = best_score(scores)\n    assert result == 5\n    _assert_best_score_postconditions(scores, result)\n\n\ndef test_best_score_with_negatives():\n    \"\"\"含负数：最大值应为 -1。\"\"\"\n    scores = [-3, -1, -7]\n    result = best_score(scores)\n    assert result == -1\n    _assert_best_score_postconditions(scores, result)\n\n\ndef test_best_score_with_zero():\n    \"\"\"含 0 的边界：最大值应为 3。\"\"\"\n    scores = [0, -5, 3]\n    result = best_score(scores)\n    assert result == 3\n    _assert_best_score_postconditions(scores, result)\n\n\n# ---------------------------------------------------------------------------\n# 边界情况\n# ---------------------------------------------------------------------------\n\ndef test_best_score_all_equal():\n    \"\"\"全部元素相等：应返回该公共值 7。\"\"\"\