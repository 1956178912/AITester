          "patch": "python\ndef rounded_ratio(hit: int, total: int) -> float:\n    if total == 0:\n        return 0.0\n    import math\n    return math.trunc(hit / total * 100) / 100\n# noise_seed=5517\n",
          "generated_test": "import math\n\nimport pytest\n\nfrom task_0079 import rounded_ratio\n\n\n# ---------------------------------------------------------------------------\n# 辅助：根据规约计算期望值（期望值唯一合法来源：规约后置条件）\n# ---------------------------------------------------------------------------\ndef _spec_expected(hit: int, total: int) -> float:\n    \"\"\"依据规约后置条件计算期望值。\n\n    - total == 0 -> 0.0\n    - total != 0 -> math.floor(hit / total * 100) / 100\n    \"\"\"\n    if total == 0:\n        return 0.0\n    return math.floor(hit / total * 100) / 100\n\n\n# ---------------------------------------------------------------------------\n# 边界：total == 0 分支\n# ---------------------------------------------------------------------------\ndef test_rounded_ratio_total_zero_returns_zero():\n    \"\"\"规约：total == 0 时返回 0.0（除零保护分支）。\"\"\"\n    result = rounded_ratio(5, 0)\n    assert result == 0.0\n    assert isinstance(result, float)\n\n\ndef test_rounded_ratio_hit_zero_and_total_zero_returns_zero():\n    \"\"\"规约：hit == 0 且 total == 0 时仍走 total==0 分支返回 0.0。\"\"\"\n    result = rounded_ratio(0, 0)\n    assert result == 0.0\n    assert isinstance(result, float)\n\n\n# ---------------------------------------------------------------------------\n# 边界：hit == 0 / hit == total\n# ---------------------------------------------------------------------------\ndef test_rounded_ratio_hit_zero_returns_zero():\n    \"\"\"规约：hit == 0（total != 0）时结果为 0.0。\"\"\"\n    result = rounded_ratio(0, 10)\n    assert result == 0.0\n    assert isinstance(result, float)\n\n\ndef test_rounded_ratio_hit_equals_total_returns_one():\n    \"\"\"规约：hit == total 时结果为 1.0。\"\"\"\n    result = rounded_ratio(10, 10)\n    assert result == 1.0\n    assert isinstance(result, float)\n\n\n# ---------------------------------------------------------------------------\n# 常规比例（含向下取整）\n# ---------------------------------------------------------------------------\n@pytest.mark.parametrize(\n    \"hit, total\",\n    [\n        (1, 3),      # 33.333... -> 0.33\n        (1, 4),      # 25.0 整除，floor 不改变值 -> 0.25\n        (5, 2),      # 250.0 -> 2.5\n        (2, 3),      # 66.666... -> 0.66\n        (1, 6),      # 16.666... -> 0.16\n        (7, 8),      # 87.5 -> 0.87\n    ],\n)\ndef test_rounded_ratio_normal_floor_behavior(hit, total):\n    \"\"\"规约：total != 0 时返回 math.floor(hit/total*100)/100（向下取整到两位小数）。\"\"\"\n    expected = _spec_expected(hit, total)\n    result = rounded_ratio(hit, total)\n    assert result == expected\n    assert isinstance(result, float)\n\n\n# ---------------------------------------------------------------------------\n# 负数场景：floor 向负无穷取整\n# ---------------------------------------------------------------------------\n@pytest.mark.parametrize(\n    \"hit, total\",\n    [\n        (-1, 3),     # -33.333... -> floor -> -34 -> -0.34\n        (1, -3),     # -33.333... -> floor -> -34 -> -0.34\n        (-1, -3),    # 33.333...  -> floor -> 33  -> 0.33\n        (-5, 2),     # -250.0 -> -2.5\n        (-1, 4),     # -25.0 -> -0.25\n        (-2, 3),     # -66.666... -> floor -> -67 -> -0.67\n    ],\n)\ndef test_rounded_ratio_negative_floor_toward_negative_infinity(hit, total):\n    \"\"\"规约：hit/total*100 为负数时 floor 向负无穷取整。\"\"\"\n    expected = _spec_expected(hit, total)\n    result = rounded_ratio(hit, total)\n    assert result == expected\n    assert isinstance(result, float)\n\n\n# ---------------------------------------------------------------------------\n# 返回值类型\n# ---------------------------------------------------------------------------\n@pytest.mark.parametrize(\n    \"hit, total\",\n    [\n        (0, 0),\n        (5, 0),\n        (0, 10),\n        (10, 10),\n        (1, 3),\n        (-1, 3),\n        (1, -3),\n        (-1, -3),\n    ],\n)\ndef test_rounded_ratio_returns_float(hit, total):\n    \"\"\"规约：返回值类型为 float。\"\"\"\n    result = rounded_ratio(hit, total)\n    assert isinstance(result, float)\n\n\n# --------------------------------------------------------------