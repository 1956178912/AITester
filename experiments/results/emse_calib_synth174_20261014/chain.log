          "rag_stats": null,
          "patch": "python\ndef fibonacci(n: int) -> int:\n    if n <= 0:\n        return 0\n    if n == 1:\n        return 1\n    return fibonacci(n - 1) + fibonacci(n - 2)\n# noise_seed=1032\n",
          "generated_test": "import pytest\n\nfrom task_0011 import fibonacci\n\n\n# ---------------------------------------------------------------------------\n# 正常用例：n >= 2 走递归分支\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\n    \"n, expected\",\n    [\n        (2, 2),   # fibonacci(1) + fibonacci(0) = 1 + 1 = 2\n        (3, 3),   # fibonacci(2) + fibonacci(1) = 2 + 1 = 3\n        (5, 8),   # fibonacci(4) + fibonacci(3) = 5 + 3 = 8\n    ],\n)\ndef test_fibonacci_normal_recursive(n, expected):\n    \"\"\"n>=2 时按规约返回 fibonacci(n-1)+fibonacci(n-2)。\n\n    期望值来源：规约后置条件 \"n>=2 时返回 fibonacci(n-1)+fibonacci(n-2)\"\n    以及边界情况 n=2 的递归最小情形。\n    \"\"\"\n    assert fibonacci(n) == expected\n\n\n# ---------------------------------------------------------------------------\n# 边界用例：n<=0 与 n==1 均返回 1\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\n    \"n, expected\",\n    [\n        (0, 1),      # n<=0 分支\n        (1, 1),      # n==1 分支\n        (-1, 1),     # 负数走 n<=0 分支\n        (-100, 1),   # 大负数仍走 n<=0 分支\n    ],\n)\ndef test_fibonacci_boundary_returns_one(n, expected):\n    \"\"\"n<=0 或 n==1 时按规约返回 1。\n\n    期望值来源：规约后置条件 \"n<=0 时返回 1\"、\"n==1 时返回 1\"\n    以及边界情况 n=0 / n=1 / n 为负数。\n    \"\"\"\n    assert fibonacci(n) == expected\n\n\n# ---------------------------------------------------------------------------\n# 后置条件：返回值类型为 int\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\"n\", [0, 1, 2, 3, 5, -1, -100])\ndef test_fibonacci_returns_int(n):\n    \"\"\"返回值必须为 int（规约后置条件 isinstance(result, int)）。\n\n    期望值来源：规约后置条件 \"返回值为整数\"。\n    \"\"\"\n    result = fibonacci(n)\n    assert isinstance(result, int)\n\n\n# ---------------------------------------------------------------------------\n# 后置条件（可执行子句）转写\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\"n\", [0, 1, 2, 3, 5, -1, -100])\ndef test_fibonacci_postcondition_n_le_zero_or_result_one(n):\n    \"\"\"规约可执行子句：n <= 0 or result == 1。\n\n    期望值来源：SpecExpr 后置子句 \"n <= 0 or result == 1\"。\n    \"\"\"\n    result = fibonacci(n)\n    assert n <= 0 or result == 1\n\n\n@pytest.mark.parametrize(\"n\", [0, 1, 2, 3, 5, -1, -100])\ndef test_fibonacci_postcondition_n_ge_two_or_result_one(n):\n    \"\"\"规约可执行子句：n >= 2 or result == 1。\n\n    期望值来源：SpecExpr 后置子句 \"n >= 2 or result == 1\"。\n    \"\"\"\n    result = fibonacci(n)\n    assert n >= 2 or result == 1\n\n\n# ---------------------------------------------------------------------------\n# 错误 / 未约定行为：类型前置条件被违反\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\"bad_input\", [1.5, \"2\", None])\ndef test_fibonacci_invalid_type_behavior(bad_input):\n    \"\"\"类型前置条件 isinstance(n, int) 被违反时的行为未在规约中约定。\n\n    期望值来源不明，需人工确认：规约仅声明前置条件为 int，\n    未约定非 int 输入的具体异常类型或返回值。\n    本用例仅记录实际行为，不做具体值断言，避免臆造 oracle。\n    \"\"\"\n    try:\n        result = fibonacci(bad_input)\n    except Exception as exc:  # noqa: BLE001 - 记录实际抛出的异常类型\n        # 记录实际行为：任何异常都视为可接受（规约未约定）\n        assert exc is not None\n    else:\n        # 若未抛异常，仅记录返回值类型，不臆造具体值\n        assert result is not None or result is None\n\n\n# ---------------------------------------------------------------------------\n# 边界：n 很大（递归深度 / 指数级耗时）\n# ---------------------------------------------------------------------------\n\ndef test_fibonacci_large_n_behavior():\n    \"\"\"n 很大时的行为未在规约中约定具体阈值。\n\n    期望值来源不明，需人工确认：规约仅提示可能栈溢出/超时，\n    未约定 RecursionError 的具体阈值或返回值。\n    本用例仅记录实际行为，不做具体值断言。\n    \"\"\"\n    try:\n        result = fibonacci(1000)\n    except RecursionError:\n        # 规约提示可能栈溢出，RecursionError 属可接受行为\n        assert True\n    except Exception as exc:  # noqa: BLE001 - 记录其他异常\n        assert exc is not None\n    else:\n        # 若成功返回，仅校验类型符合后置条件\n        assert isinstance(result, int)",
