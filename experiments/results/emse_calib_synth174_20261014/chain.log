ookup(\"Alpha\") == 0\n\n\n# ---------------------------------------------------------------------------\n# 不变量与后置条件：对所有合法输入成立\n# ---------------------------------------------------------------------------\n@pytest.mark.parametrize(\n    \"key\",\n    [\"alpha\", \"beta\", \"gamma\", \"delta\", \"\", \"Alpha\", \"unknown_key\"],\n)\ndef test_lookup_result_is_non_negative_int(key):\n    \"\"\"规约后置条件：返回值类型为 int 且 result >= 0。\"\"\"\n    result = lookup(key)\n    assert isinstance(result, int)\n    assert result >= 0\n\n\n@pytest.mark.parametrize(\n    \"key\",\n    [\"alpha\", \"beta\", \"gamma\", \"delta\", \"\", \"Alpha\", \"unknown_key\"],\n)\ndef test_lookup_invariant_result_in_known_range(key):\n    \"\"\"规约不变量：result == 0 or result in (1, 2, 3)。\"\"\"\n    result = lookup(key)\n    assert result == 0 or result in (1, 2, 3)\n\n\n# ---------------------------------------------------------------------------\n# 边界情况：非 str 类型入参（违反类型注解）\n# ---------------------------------------------------------------------------\ndef test_lookup_none_key_behavior():\n    \"\"\"边界情况：key 为 None。\n\n    规约说明：dict.get 可接受任意可哈希对象，None 可哈希且不在表中，\n    故期望返回 0。期望值来源：规约中 dict.get 语义描述。\n    \"\"\"\n    result = lookup(None)\n    assert result == 0\n\n\ndef test_lookup_non_str_hashable_key_behavior():\n    \"\"\"边界情况：key 为非 str 但可哈希的对象（如 int）。\n\n    规约说明：dict.get 可接受任意可哈希对象，非表中键返回 0。\n    期望值来源：规约中 dict.get 语义描述。\n    \"\"\"\n    result = lookup(12345)\n    assert result == 0",
