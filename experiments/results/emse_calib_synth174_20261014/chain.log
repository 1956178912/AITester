aggregate_with_zeros(self):\n        \"\"\"aggregate([0, 0, 0]) should return {'count': 3, 'total': 0}.\"\"\"\n        assert aggregate([0, 0, 0]) == {\"count\": 3, \"total\": 0}\n\n    def test_aggregate_with_negatives(self):\n        \"\"\"aggregate([-1, -2, -3]) should return {'count': 3, 'total': -6}.\"\"\"\n        assert aggregate([-1, -2, -3]) == {\"count\": 3, \"total\": -6}\n\n    def test_aggregate_mixed_signs(self):\n        \"\"\"aggregate([-1, 1, -2, 2]) should return {'count': 4, 'total': 0}.\"\"\"\n        assert aggregate([-1, 1, -2, 2]) == {\"count\": 4, \"total\": 0}\n\n    def test_aggregate_returns_dict_with_expected_keys(self):\n        \"\"\"aggregate result should contain 'count' and 'total' keys.\"\"\"\n        result = aggregate([1, 2, 3])\n        assert set(result.keys()) == {\"count\", \"total\"}\n\n\nclass TestReport:\n    \"\"\"Tests for report function.\"\"\"\n\n    def test_report_empty_list(self):\n        \"\"\"report([]) should return 'count=0 total=0'.\"\"\"\n        assert report([]) == \"count=0 total=0\"\n\n    def test_report_single_element(self):\n        \"\"\"report([1]) -> normalize=[2], aggregate={'count':1,'total':2} -> 'count=1 total=2'.\"\"\"\n        assert report([1]) == \"count=1 total=2\"\n\n    def test_report_multiple_elements(self):\n        \"\"\"report([1, 2, 3]) -> normalize=[2,4,6], aggregate={'count':3,'total':12} -> 'count=3 total=12'.\"\"\"\n        assert report([1, 2, 3]) == \"count=3 total=12\"\n\n    def test_report_with_zeros(self):\n        \"\"\"report([0, 0]) -> normalize=[0,0], aggregate={'count':2,'total':0} -> 'count=2 total=0'.\"\"\"\n        assert report([0, 0]) == \"count=2 total=0\"\n\n    def test_report_with_negatives(self):\n        \"\"\"report([-1, -2]) -> normalize=[-2,-4], aggregate={'count':2,'total':-6} -> 'count=2 total=-6'.\"\"\"\n        assert report([-1, -2]) == \"count=2 total=-6\"\n\n    def test_report_returns_string(self):\n        \"\"\"report should return a string.\"\"\"\n        result = report([1, 2])\n        assert isinstance(result, str)\n\n    def test_report_format_contains_count_and_total(self):\n        \"\"\"report output should contain 'count=' and 'total=' substrings.\"\"\"\n        result = report([5])\n        assert \"count=\" in result\n        assert \"total=\" in result",
