          "generated_test": "import pytest\n\nfrom task_0059 import aggregate\n\n\n# ---------------------------------------------------------------------------\n# 正常路径 / 主路径\n# ---------------------------------------------------------------------------\n\ndef test_aggregate_multi_element_integers():\n    \"\"\"规约后置：返回值等于 sum(values)/len(values)。输入 [1,2,3,4] → 2.5。\"\"\"\n    values = [1, 2, 3, 4]\n    result = aggregate(values)\n    assert result == sum(values) / len(values)\n    assert result == 2.5\n\n\ndef test_aggregate_negative_values():\n    \"\"\"规约边界：含负数列表返回负平均值。输入 [-1,-2,-3] → -2。\"\"\"\n    values = [-1, -2, -3]\n    result = aggregate(values)\n    assert result == sum(values) / len(values)\n    assert result == -2\n\n\ndef test_aggregate_float_values():\n    \"\"\"规约边界：含浮点数列表返回 float。输入 [1.5,2.5] → 2.0。\"\"\"\n    values = [1.5, 2.5]\n    result = aggregate(values)\n    assert result == sum(values) / len(values)\n    assert result == 2.0\n    assert isinstance(result, float)\n\n\ndef test_aggregate_mixed_int_float():\n    \"\"\"规约后置：混合数值列表返回值等于 sum/len。\"\"\"\n    values = [1, 2.5, 3]\n    result = aggregate(values)\n    assert result == sum(values) / len(values)\n\n\n# ---------------------------------------------------------------------------\n# 边界情况\n# ---------------------------------------------------------------------------\n\ndef test_aggregate_single_element_returns_element():\n    \"\"\"规约边界：单元素列表 [x] → 返回 x。输入 [5] → 5。\"\"\"\n    values = [5]\n    result = aggregate(values)\n    assert result == 5\n    assert result == sum(values) / len(values)\n\n\ndef test_aggregate_all_zeros():\n    \"\"\"规约边界：全 0 列表 → 返回 0。\"\"\"\n    values = [0, 0, 0]\n    result = aggregate(values)\n    assert result == 0\n    assert result == sum(values) / len(values)\n\n\ndef test_aggregate_result_within_min_max():\n    \"\"\"规约后置：数值列表返回值介于 min(values) 与 max(values) 之间。\"\"\"\n    values = [-10, 0, 5, 20, 3]\n    result = aggregate(values)\n    assert min(values) <= result <= max(values)\n\n\ndef test_aggregate_result_is_numeric_type():\n    \"\"\"规约后置：返回值类型为数值（int 或 float）。\"\"\"\n    result = aggregate([1, 2, 3])\n    assert isinstance(result, (int, float))\n\n\n# ---------------------------------------------------------------------------\n# 异常路径\n# ---------------------------------------------------------------------------\n\ndef test_aggregate_empty_list_raises_zero_division():\n    \"\"\"规约边界：空列表 [] → ZeroDivisionError（历史 bug）。\"\"\"\n    with pytest.raises(ZeroDivisionError):\n        aggregate([])\n\n\ndef test_aggregate_string_elements_raises_type_error():\n    \"\"\"规约边界：元素为不可加类型（如 str）→ TypeError。\"\"\"\n    with pytest.raises(TypeError):\n        aggregate([\"a\", \"b\"])\n\n\n# ---------------------------------------------------------------------------\n# 探索性用例（期望值来源不明，需人工确认）\n# ---------------------------------------------------------------------------\n\ndef test_aggregate_large_values_exploratory():\n    \"\"\"规约边界：极大数值列表可能溢出/精度损失。\n\n    期望值来源不明，需人工确认：规约仅说明\"可能溢出/精度损失\"，\n    未约定具体返回值。此处记录实际行为，仅断言与 sum/len 一致。\n    \"\"\"\n    values = [1e308, 1e308]\n    result = aggregate(values)\n    # 记录实际行为：与 sum(values)/len(values) 保持一致\n    assert result == sum(values) / len(values)",
