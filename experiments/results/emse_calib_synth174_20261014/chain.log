ku 参数类型注解为 str，字符串键应可正常查询。\n\n    期望值来源：类型注解 sku: str；此处记录实际行为。\n    \"\"\"\n    assert stock_of(\"abc\") == 0\n\n\ndef test_stock_of_accepts_int_sku():\n    \"\"\"stock_of 传入 int 时按字典键查询，未命中返回 0。\n\n    期望值来源：实现 _STOCK.get(sku, 0)；此处记录实际行为。\n    \"\"\"\n    assert stock_of(123) == 0\n\n\ndef test_stock_of_does_not_modify_stock():\n    \"\"\"stock_of 查询不应改变库存内容。\n\n    期望值来源：实现为只读的 _STOCK.get。\n    \"\"\"\n    add_item(1, 4)\n    stock_of(1)\n    stock_of(999)\n    assert _STOCK == {1: 4}",
