-----------------------------\n# 边界情况\n# ---------------------------------------------------------------------------\ndef test_binary_search_empty_list():\n    \"\"\"空列表边界。\n\n    规约将「arr 为空列表」列为边界情况，但未规定空列表的返回语义。\n    期望值来源不明，需人工确认：此处仅记录实际行为，不做具体值断言。\n    若实现返回 -1，则符合「未命中返回 -1」的通用约定；\n    若实现抛异常，则说明空列表未被处理。\n    \"\"\"\n    arr = []\n    target = 1\n    try:\n        result = binary_search(arr, target)\n    except Exception as exc:  # noqa: BLE001 - 记录实际行为\n        # 期望值来源不明，需人工确认：空列表行为未在规约中定义\n        assert isinstance(exc, Exception)\n        return\n    # 若未抛异常，则返回值应为 int；空列表下唯一合理的未命中结果是 -1\n    assert isinstance(result, int)\n    assert result == -1\n\n\ndef test_binary_search_single_element_hit():\n    \"\"\"单元素列表命中：最小非空集合命中。\n\n    期望值来源：规约后置条件，唯一命中下标为 0。\n    \"\"\"\n    arr = [7]\n    target = 7\n    result = binary_search(arr, target)\n    _assert_postconditions(arr, target, result)\n    assert result == 0\n\n\ndef test_binary_search_single_element_miss():\n    \"\"\"单元素列表未命中：最小非空集合未命中。\n\n    期望值来源：规约后置条件，未命中返回 -1。\n    \"\"\"\n    arr = [7]\n    target = 3\n    result = binary_search(arr, target)\n    _assert_postconditions(arr, target, result)\n    assert result == -1\n\n\ndef test_binary_search_target_below_all_elements():\n    \"\"\"目标小于所有元素：下界外目标。\n\n    期望值来源：规约后置条件，未命中返回 -1。\n    \"\"\"\n    arr = [10, 20, 30]\n    target = 0\n    result = binary_search(arr, target)\n    _assert_postconditions(arr, target, result)\n    assert result == -1\n\n\ndef test_binary_search_target_above_all_elements():\n    \"\"\"目标大于所有元素：上界外目标。\n\n    期望值来源：规约后置条件，未命中返回 -1。\n    \"\"\"\n    arr = [10, 20, 30]\n    target = 100\n    result = binary_search(arr, target)\n    _assert_postconditions(arr, target, result)\n    assert result == -1\n\n\ndef test_binary_search_duplicate_elements():\n    \"\"\"含重复元素：规约允许返回任一匹配下标。\n\n    期望值来源：规约边界情况「arr 含重复元素（返回任一匹配下标）」。\n    因此不断言具体下标，只断言后置条件（命中且 arr[result] == target）。\n    \"\"\"\n    arr = [2, 2, 2, 2]\n    target = 2\n    resul