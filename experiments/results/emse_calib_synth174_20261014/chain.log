          "generated_test": "import pytest\n\nfrom task_0053 import mark_positions\n\n\n# ---------------------------------------------------------------------------\n# 辅助断言：直接转写规约中的可执行后置条件与不变量\n# ---------------------------------------------------------------------------\n\ndef _assert_spec_postconditions(text, ch, result):\n    \"\"\"断言规约中所有可执行后置条件与不变量。\"\"\"\n    # 后置：返回值为 list\n    assert isinstance(result, list)\n    # 后置 / 不变量：长度 == max(len(text) - 1, 0)\n    assert len(result) == max(len(text) - 1, 0)\n    # 后置：每个元素要么等于自身下标，要么为 -1\n    assert all(result[i] == i or result[i] == -1 for i in range(len(result)))\n    # 后置：非 -1 元素对应的 text 位置确实等于 ch\n    assert all(result[i] == -1 or text[result[i]] == ch for i in range(len(result)))\n    # 后置：非 -1 元素范围约束\n    assert all(\n        result[i] == -1 or 0 <= result[i] <= len(text) - 2\n        for i in range(len(result))\n    )\n\n\n# ---------------------------------------------------------------------------\n# 普通用例\n# ---------------------------------------------------------------------------\n\ndef test_mark_positions_middle_char_match():\n    \"\"\"普通匹配：中间字符。\n\n    期望值来源：规约后置条件（result[i] == i 当且仅当 text[i] == ch，否则 -1）\n    以及边界情况（末字符不参与检查）。\n    \"\"\"\n    text, ch = \"abcabc\", \"b\"\n    result = mark_positions(text, ch)\n    assert result == [-1, 1, -1, -1, 4]\n    _assert_spec_postconditions(text, ch, result)\n\n\ndef test_mark_positions_all_match():\n    \"\"\"全部匹配：返回连续下标 [0, 1, ..., len(text)-2]。\n\n    期望值来源：边界情况「text 全部字符等于 ch：返回 [0, 1, ..., len(text)-2]」。\n    \"\"\"\n    text, ch = \"aaaa\", \"a\"\n    result = mark_positions(text, ch)\n    assert result == [0, 1, 2]\n    _assert_spec_postconditions(text, ch, result)\n\n\ndef test_mark_positions_no_match():\n    \"\"\"全部不匹配：返回全 -1 列表。\n\n    期望值来源：边界情况「text 中无字符等于 ch：返回全 -1 列表」。\n    \"\"\"\n    text, ch = \"abcd\", \"z\"\n    result = mark_positions(text, ch)\n    assert result == [-1, -1, -1]\n    _assert_spec_postconditions(text, ch, result)\n\n\ndef test_mark_positions_repeated_and_special_chars():\n    \"\"\"含重复字符与空格：匹配记录下标，非匹配记录 -1。\n\n    期望值来源：规约后置条件（逐位判定 text[i] == ch）。\n    \"\"\"\n    text, ch = \"a a a\", \"a\"\n    result = mark_positions(text, ch)\n    assert result == [0, 2, 4]\n    _assert_spec_postconditions(text, ch, result)\n\n\n# ---------------------------------------------------------------------------\n# 边界用例\n# ---------------------------------------------------------------------------\n\ndef test_mark_positions_empty_text():\n    \"\"\"空字符串：range(-1) 不迭代，返回 []。\n\n    期望值来源：边界情况「text 为空串：返回 []」。\n    \"\"\"\n    text, ch = \"\", \"a\"\n    result = mark_positions(text, ch)\n    assert result == []\n    _assert_spec_postconditions(text, ch, result)\n\n\ndef test_mark_positions_single_char_text():\n    \"\"\"单字符字符串：range(0) 不迭代，返回 []（末字符永不参与匹配）。\n\n    期望值来源：边界情况「text 长度为 1：返回 []」。\n    \"\"\"\n    text, ch = \"a\", \"a\"\n    result = mark_positions(text, ch)\n    assert result == []\n    _assert_spec_postconditions(text, ch, result)\n\n\ndef test_mark_positions_two_char_text_first_match():\n    \"\"\"双字符字符串，首字符匹配：只检查下标 0，返回 [0]。\n\n    期望值来源：边界情况「text 长度为 2：只检查下标 0」。\n    \"\"\"\n    text, ch = \"ab\", \"a\"\n    result = mark_positions(text, ch)\n    assert result == [0]\n    _assert_spec_postconditions(text, ch, result)\n\n\ndef test_mark_positions_two_char_text_last_match():\n    \"\"\"双字符字符串，末字符匹配：末字符不被记录，返回 [-1]。\n\n    期望值来源：边界情况「text 最后一个字符等于 ch：该位置不被记录」。\n    \"\"\"\n    text, ch = \"ab\", \"b\"\n    result = mark_positions(text, ch)\n    assert result == [-1]\n    _assert_spec_postconditions(text, ch, result)\n\n\ndef test_mark_positions_empty_ch():\n    \"\"\"ch 为空串：text[i] == \"\" 恒为 False，返回全 -1 列表。\n\n    期望值来源：边界情况「ch 为空串：返回全 -1 列表」。\n    \"\"\"\n    text, ch = \"abc\", \"\"\n    result = mark_positions(text, ch)\n    assert result == [-1, -1]\n    _assert_spec_postconditions(text, ch, result)\n\n\ndef test_mark_positions_multichar_ch():\n    \"\"\"ch 为多字符且与单字符 text[i] 不等：按字符