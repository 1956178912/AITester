          "generated_test": "import pytest\n\nfrom task_0068 import pick_label\n\n\n# ---------------------------------------------------------------------------\n# 正常路径 / 后置条件覆盖\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\n    \"score, expected\",\n    [\n        (100, \"excellent\"),\n        (90, \"excellent\"),\n        (89, \"pass\"),\n        (75, \"pass\"),\n        (60, \"pass\"),\n        (10 ** 18, \"excellent\"),\n    ],\n)\ndef test_pick_label_postcondition_returns_expected_label(score, expected):\n    \"\"\"后置条件：score >= 90 -> \"excellent\"；60 <= score < 90 -> \"pass\"。\n\n    期望值来源：自然语言规约与可执行后置子句。\n    \"\"\"\n    result = pick_label(score)\n    assert result == expected\n\n\n@pytest.mark.parametrize(\"score\", [59, 0, -1, -100])\ndef test_pick_label_postcondition_below_60_returns_none(score):\n    \"\"\"后置条件：score < 60 时返回 None（隐式）。\n\n    期望值来源：可执行后置子句 `score < 60 and result is None`。\n    \"\"\"\n    result = pick_label(score)\n    assert result is None\n\n\n# ---------------------------------------------------------------------------\n# 边界情况\n# ---------------------------------------------------------------------------\n\ndef test_pick_label_boundary_score_90_is_excellent():\n    \"\"\"边界：score == 90 为 excellent 分支下边界，验证使用 >= 而非 >。\n\n    期望值来源：规约边界情况 + 后置子句。\n    \"\"\"\n    assert pick_label(90) == \"excellent\"\n\n\ndef test_pick_label_boundary_score_89_is_pass():\n    \"\"\"边界：score == 89 为 pass 分支上边界。\n\n    期望值来源：规约边界情况 + 后置子句。\n    \"\"\"\n    assert pick_label(89) == \"pass\"\n\n\ndef test_pick_label_boundary_score_60_is_pass():\n    \"\"\"边界：score == 60 为 pass 分支下边界，验证使用 >= 而非 >。\n\n    期望值来源：规约边界情况 + 后置子句。\n    \"\"\"\n    assert pick_label(60) == \"pass\"\n\n\ndef test_pick_label_boundary_score_59_is_none():\n    \"\"\"边界：score == 59 落入隐式 None 分支。\n\n    期望值来源：规约边界情况 + 后置子句。\n    \"\"\"\n    assert pick_label(59) is None\n\n\ndef test_pick_label_boundary_score_zero_is_none():\n    \"\"\"边界：score == 0 落入隐式 None 分支。\n\n    期望值来源：规约边界情况 + 后置子句。\n    \"\"\"\n    assert pick_label(0) is None\n\n\ndef test_pick_label_boundary_negative_score_is_none():\n    \"\"\"边界：负数输入落入隐式 None 分支。\n\n    期望值来源：规约边界情况 + 后置子句。\n    \"\"\"\n    assert pick_label(-1) is None\n\n\ndef test_pick_label_boundary_large_score_is_excellent():\n    \"\"\"边界：极大整数（10**18）仍走 excellent 分支。\n\n    期望值来源：规约边界情况 + 后置子句。\n    \"\"\"\n    assert pick_label(10 ** 18) == \"excellent\"\n\n\n# ---------------------------------------------------------------------------\n# 不变量\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\n    \"score\",\n    [100, 90, 89, 75, 60, 59, 0, -1, 10 ** 18],\n)\ndef test_pick_label_invariant_result_in_allowed_set(score):\n    \"\"\"不变量：返回值恒为 \"excellent\"、\"pass\" 或 None。\n\n    期望值来源：可执行不变量子句。\n    \"\"\"\n    result = pick_label(score)\n    assert result == \"excellent\" or result == \"pass\" or result is None\n\n\n# ---------------------------------------------------------------------------\n# 违反前置条件的输入（类型契约）\n# ---------------------------------------------------------------------------\n\ndef test_pick_label_non_int_float_behavior():\n    \"\"\"前置条件要求 score 为 int；传入 float 违反类型契约。\n\n    规约未定义 float 输入的行为，期望值不明，需人工确认。\n    此处仅记录实际行为，不做具体值断言。\n    \"\"\"\n    try:\n        result = pick_label(90.5)\n    except TypeError:\n        # 运行时拒绝非 int 输入也是可接受的契约实现方式\n        return\n    # 期望值来源不明，需人工确认：仅记录实际返回值\n    assert result in (\"excellent\", \"pass\", None)\n\n\ndef test_pick_label_none_input_raises_or_records():\n    \"\"\"前置条件要求 score 为 int；传入 None 违反类型契约。\n\n    规约未定义 None 输入的行为，期望值不明，需人工确认。\n    比较运算可能抛 TypeError，也可能被实现以其他方式处理。\n    \"\"\"\n    try:\n        result = pick_label(None)\n    except TypeError:\n        return\n    # 期望值来源不明，需人工确认：仅记录实际返回值\n    assert result in (\"excellent\", \"pass\", None)",
