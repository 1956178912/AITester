ted value derived from len() and sum() semantics.\n        \"\"\"\n        assert aggregate([0, 0, 0]) == {\"count\": 3, \"total\": 0}\n\n\nclass TestReport:\n    \"\"\"Tests for the report function.\"\"\"\n\n    def test_report_empty_list(self):\n        \"\"\"report([]) should return 'count=0 total=0'.\n\n        Expected value derived from composition: normalize([]) == [],\n        aggregate([]) == {'count': 0, 'total': 0}, and the format string\n        'count={0} total={1}'.\n        \"\"\"\n        assert report([]) == \"count=0 total=0\"\n\n    def test_report_single_element(self):\n        \"\"\"report([3]) should return 'count=1 total=6'.\n\n        Expected value derived from composition: normalize([3]) == [6],\n        aggregate([6]) == {'count': 1, 'total': 6}.\n        \"\"\"\n        assert report([3]) == \"count=1 total=6\"\n\n    def test_report_multiple_elements(self):\n        \"\"\"report([1, 2, 3]) should return 'count=3 total=12'.\n\n        Expected value derived from composition: normalize([1, 2, 3]) == [2, 4, 6],\n        aggregate([2, 4, 6]) == {'count': 3, 'total': 12}.\n        \"\"\"\n        assert report([1, 2, 3]) == \"count=3 total=12\"\n\n    def test_report_negative_numbers(self):\n        \"\"\"report([-1, -2]) should return 'count=2 total=-6'.\n\n        Expected value derived from composition: normalize([-1, -2]) == [-2, -4],\n        aggregate([-2, -4]) == {'count': 2, 'total': -6}.\n        \"\"\"\n        assert report([-1, -2]) == \"count=2 total=-6\"\n\n    def test_report_zeros(self):\n        \"\"\"report([0, 0]) should return 'count=2 total=0'.\n\n        Expected value derived from composition: normalize([0, 0]) == [0, 0],\n        aggregate([0, 0]) == {'count': 2, 'total': 0}.\n        \"\"\"\n        assert report([0, 0]) == \"count=2 total=0\"\n\n    def test_report_returns_string(self):\n        \"\"\"report should return a string.\n\n        Expected value derived from the function body which returns a\n        form