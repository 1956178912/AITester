          "generated_test": "import pytest\n\nfrom task_0020 import compare\n\n\n# ---------------------------------------------------------------------------\n# 正常分支用例\n# ---------------------------------------------------------------------------\n\ndef test_compare_a_greater_than_b_returns_1():\n    \"\"\"规约：a > b 时返回 1。输入 (5, 3)。\"\"\"\n    assert compare(5, 3) == 1\n\n\ndef test_compare_a_less_than_b_returns_minus_1():\n    \"\"\"规约：a < b 时返回 -1。输入 (3, 5)。\"\"\"\n    assert compare(3, 5) == -1\n\n\ndef test_compare_a_equal_to_b_returns_0():\n    \"\"\"规约：a == b 时返回 0。输入 (4, 4)。\"\"\"\n    assert compare(4, 4) == 0\n\n\n# ---------------------------------------------------------------------------\n# 边界用例\n# ---------------------------------------------------------------------------\n\ndef test_compare_adjacent_integers_a_greater():\n    \"\"\"边界：a 与 b 相差 1，a > b 分支。输入 (1, 0)，期望 1。\"\"\"\n    assert compare(1, 0) == 1\n\n\ndef test_compare_adjacent_integers_a_less():\n    \"\"\"边界：a 与 b 相差 1，a < b 分支。输入 (0, 1)，期望 -1。\"\"\"\n    assert compare(0, 1) == -1\n\n\ndef test_compare_a_is_zero_greater():\n    \"\"\"边界：a 为 0 且大于 b。输入 (0, -1)，期望 1。\"\"\"\n    assert compare(0, -1) == 1\n\n\ndef test_compare_b_is_zero_less():\n    \"\"\"边界：b 为 0 且 a 小于 b。输入 (-1, 0)，期望 -1。\"\"\"\n    assert compare(-1, 0) == -1\n\n\ndef test_compare_both_zero_returns_0():\n    \"\"\"边界：a 与 b 均为 0，返回 0。输入 (0, 0)。\"\"\"\n    assert compare(0, 0) == 0\n\n\ndef test_compare_both_negative_a_greater():\n    \"\"\"边界：两负数比较，a > b 分支。输入 (-2, -7)，期望 1。\"\"\"\n    assert compare(-2, -7) == 1\n\n\ndef test_compare_both_negative_a_less():\n    \"\"\"边界：两负数比较，a < b 分支。输入 (-7, -2)，期望 -1。\"\"\"\n    assert compare(-7, -2) == -1\n\n\ndef test_compare_extreme_max_vs_min_returns_1():\n    \"\"\"边界：极大整数与极小整数比较，a > b 分支，期望 1。\"\"\"\n    assert compare(9223372036854775807, -9223372036854775808) == 1\n\n\ndef test_compare_extreme_min_vs_max_returns_minus_1():\n    \"\"\"边界：极小整数与极大整数比较，a < b 分支，期望 -1。\"\"\"\n    assert compare(-9223372036854775808, 9223372036854775807) == -1\n\n\n# ---------------------------------------------------------------------------\n# 可执行规约：返回值必须属于 {1, -1, 0}\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\n    \"a, b\",\n    [\n        (5, 3),\n        (3, 5),\n        (4, 4),\n        (0, 0),\n        (0, -1),\n        (-1, 0),\n        (-2, -7),\n        (9223372036854775807, -9223372036854775808),\n        (-9223372036854775808, 9223372036854775807),\n    ],\n)\ndef test_compare_result_in_valid_output_domain(a, b):\n    \"\"\"可执行规约：result == 1 or result == -1 or result == 0。\"\"\"\n    result = compare(a, b)\n    assert result in (1, -1, 0)\n\n\n# ---------------------------------------------------------------------------\n# 对称性 / 一致性（由规约三后置条件可推导）\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\n    \"a, b\",\n    [\n        (5, 3),\n        (3, 5),\n        (4, 4),\n        (0, -1),\n        (-1, 0),\n        (-2, -7),\n        (9223372036854775807, -9223372036854775808),\n    ],\n)\ndef test_compare_antisymmetry(a, b):\n    \"\"\"规约推导：compare(a, b) == -compare(b, a)。\"\"\"\n    assert compare(a, b) == -compare(b, a)",
