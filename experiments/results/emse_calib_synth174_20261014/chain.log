          "generated_test": "import math\n\nimport pytest\n\nfrom task_0010 import factorial\n\n\nclass TestFactorialBoundary:\n    \"\"\"边界用例：递归基例与最小非基例。\"\"\"\n\n    def test_factorial_zero_returns_one(self):\n        \"\"\"n == 0 为递归基例，规约明确返回 1。\"\"\"\n        result = factorial(0)\n        assert result == 1\n        assert isinstance(result, int)\n\n    def test_factorial_one_returns_one(self):\n        \"\"\"n == 1 为最小非基例，规约约定 1! == 1。\"\"\"\n        result = factorial(1)\n        assert result == 1\n        assert isinstance(result, int)\n\n\nclass TestFactorialNormal:\n    \"\"\"正常输入用例：验证 n! 的数值与返回类型。\"\"\"\n\n    @pytest.mark.parametrize(\n        \"n, expected\",\n        [\n            (2, 2),\n            (3, 6),\n            (5, 120),\n            (10, 3628800),\n        ],\n    )\n    def test_factorial_positive_returns_factorial(self, n, expected):\n        \"\"\"n > 0 时规约要求返回 n 的阶乘，期望值来自数学定义与测试计划。\"\"\"\n        result = factorial(n)\n        assert result == expected\n        assert isinstance(result, int)\n\n    def test_factorial_matches_math_factorial(self):\n        \"\"\"对一组满足前置条件的 n，返回值应与 math.factorial 一致。\"\"\"\n        for n in range(0, 15):\n            assert factorial(n) == math.factorial(n)\n\n    def test_factorial_result_is_int_and_at_least_one(self):\n        \"\"\"后置条件：返回值类型为 int 且 result >= 1。\"\"\"\n        for n in range(0, 10):\n            result = factorial(n)\n            assert isinstance(result, int)\n            assert result >= 1\n\n\nclass TestFactorialError:\n    \"\"\"异常路径：负数与超大 n 触发 RecursionError。\"\"\"\n\n    def test_factorial_negative_raises_recursion_error(self):\n        \"\"\"负数无基例可达，规约说明会无限递归直至 RecursionError。\n\n        期望值来源：规约边界情况描述（负数 → RecursionError）。\n        \"\"\"\n        with pytest.raises(RecursionError):\n            factorial(-1)\n\n    def test_factorial_large_n_raises_recursion_error(self):\n        \"\"\"n == 1000 时递归深度超限，规约说明预期抛出 RecursionError。\n\n        期望值来源：规约边界情况描述（n 较大 → RecursionError）。\n        \"\"\"\n        with pytest.raises(RecursionError):\n            factorial(1000)\n\n\nclass TestFactorialUndefinedBehavior:\n    \"\"\"规约未定义的行为：非 int 输入，仅记录实际行为，需人工确认。\"\"\"\n\n    def test_factorial_non_int_input_behavior_unknown(self):\n        \"\"\"n 非 int（如 float/str）时行为未定义。\n\n        期望值来源不明，需人工确认：此处仅记录实际行为，\n        不臆造具体返回值或异常类型。\n        \"\"\"\n        for bad_input in (2.0, \"3\"):\n            try:\n                result = factorial(bad_input)\n            except Exception as exc:  # noqa: BLE001 - 记录未定义行为\n                # 记录实际抛出的异常类型，供人工确认\n                assert exc is not None\n            else:\n                # 记录实际返回值，供人工确认\n                assert result is not None",
