          "generated_test": "import pytest\n\nfrom task_0053 import is_palindrome\n\n\n# ---------------------------------------------------------------------------\n# 正常用例\n# ---------------------------------------------------------------------------\n\ndef test_is_palindrome_even_length_palindrome():\n    \"\"\"普通偶数长度回文 \"abba\" 应返回 True。\n\n    期望值来源：规约后置条件 result == (s == s[::-1])。\n    \"\"\"\n    s = \"abba\"\n    result = is_palindrome(s)\n    assert isinstance(result, bool)\n    assert result == (s == s[::-1])\n    assert result is True\n\n\ndef test_is_palindrome_odd_length_palindrome():\n    \"\"\"普通奇数长度回文 \"abcba\" 应返回 True。\n\n    期望值来源：规约后置条件 result == (s == s[::-1])。\n    \"\"\"\n    s = \"abcba\"\n    result = is_palindrome(s)\n    assert isinstance(result, bool)\n    assert result == (s == s[::-1])\n    assert result is True\n\n\ndef test_is_palindrome_non_palindrome():\n    \"\"\"普通非回文 \"hello\" 应返回 False。\n\n    期望值来源：规约后置条件 result == (s == s[::-1])。\n    \"\"\"\n    s = \"hello\"\n    result = is_palindrome(s)\n    assert isinstance(result, bool)\n    assert result == (s == s[::-1])\n    assert result is False\n\n\n# ---------------------------------------------------------------------------\n# 边界用例\n# ---------------------------------------------------------------------------\n\ndef test_is_palindrome_empty_string():\n    \"\"\"空字符串 \"\" 逆序仍为空串，应返回 True。\n\n    期望值来源：规约边界情况「空字符串 \"\"（逆序仍为空串，应为 True）」。\n    \"\"\"\n    s = \"\"\n    result = is_palindrome(s)\n    assert isinstance(result, bool)\n    assert result == (s == s[::-1])\n    assert result is True\n\n\ndef test_is_palindrome_single_character():\n    \"\"\"单字符 \"a\" 逆序等于自身，应返回 True。\n\n    期望值来源：规约边界情况「单字符字符串（逆序等于自身，应为 True）」。\n    \"\"\"\n    s = \"a\"\n    result = is_palindrome(s)\n    assert isinstance(result, bool)\n    assert result == (s == s[::-1])\n    assert result is True\n\n\ndef test_is_palindrome_two_identical_characters():\n    \"\"\"两字符相同 \"aa\" 是最短偶数长度回文，应返回 True。\n\n    期望值来源：规约边界情况「两字符相同/不同」。\n    \"\"\"\n    s = \"aa\"\n    result = is_palindrome(s)\n    assert isinstance(result, bool)\n    assert result == (s == s[::-1])\n    assert result is True\n\n\ndef test_is_palindrome_two_different_characters():\n    \"\"\"两字符不同 \"ab\" 是最短非回文，应返回 False。\n\n    期望值来源：规约边界情况「两字符相同/不同」。\n    \"\"\"\n    s = \"ab\"\n    result = is_palindrome(s)\n    assert isinstance(result, bool)\n    assert result == (s == s[::-1])\n    assert result is False\n\n\ndef test_is_palindrome_with_spaces():\n    \"\"\"含空格的回文 \"a b a\" 按原样比较，应返回 True（不做预处理）。\n\n    期望值来源：规约边界情况「含空格或标点的回文（如 \"a b a\"）」。\n    \"\"\"\n    s = \"a b a\"\n    result = is_palindrome(s)\n    assert isinstance(result, bool)\n    assert result == (s == s[::-1])\n    assert result is True\n\n\ndef test_is_palindrome_mixed_case():\n    \"\"\"大小写混合 \"Aa\" 因区分大小写应返回 False（不做 lower 归一化）。\n\n    期望值来源：规约边界情况「大小写混合（如 \"Aa\"，因区分大小写应为 False）」。\n    \"\"\"\n    s = \"Aa\"\n    result = is_palindrome(s)\n    assert isinstance(result, bool)\n    assert result == (s == s[::-1])\n    assert result is False\n\n\ndef test_is_palindrome_unicode_chinese():\n    \"\"\"Unicode 中文回文 \"上海自来水来自海上\" 应返回 True。\n\n    期望值来源：规约边界情况「非 ASCII/Unicode 字符（如中文、emoji）」。\n    \"\"\"\n    s = \"上海自来水来自海上\"\n    result = is_palindrome(s)\n    assert isinstance(result, bool)\n    assert result == (s == s[::-1])\n    assert result is True\n\n\ndef test_is_palindrome_unicode_emoji():\n    \"\"\"Unicode emoji 回文 \"😀😀\" 应返回 True。\n\n    期望值来源：规约边界情况「非 ASCII/Unicode 字符（如中文、emoji）」。\n    \"\"\"\n    s = \"😀😀\"\n    result = is_palindrome(s)\n    assert isinstance(result, bool)\n    assert result == (s == s[::-1])\n    assert result is True\n\n\ndef test_is_palindrome_long_string():\n    \"\"\"超长回文字符串应返回 True（仅线性比较，无递归/性能约束）。\n\n    期望值来源：规约边界情况「超长字符串（性能/递归无关，仅线性比较）」。\n    \"\"\"\n    half = \"abcdefghij\" * 1000\n    s = half + half[::-1]\n    result = is_palindrome(s)\n    assert isinstance(result, bool)\n    assert result == (s =