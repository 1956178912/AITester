          "generated_test": "import pytest\n\nfrom task_0009 import lookup\n\n\n# 规约中约定的模块级常量字典\n_TABLE = {\"alpha\": 1, \"beta\": 2, \"gamma\": 3}\n\n\n@pytest.mark.parametrize(\n    \"key, expected\",\n    [\n        (\"alpha\", 1),\n        (\"beta\", 2),\n        (\"gamma\", 3),\n    ],\n)\ndef test_lookup_hit_returns_table_value(key, expected):\n    \"\"\"命中 _TABLE 的键应返回 _TABLE[key]。\n\n    期望值来源：规约「key 在 _TABLE 中时返回值等于 _TABLE[key]」。\n    \"\"\"\n    result = lookup(key)\n    assert result == expected\n    assert result == _TABLE[key]\n\n\n@pytest.mark.parametrize(\n    \"key\",\n    [\"delta\", \"\", \"Alpha\", \"ALPHA\", \"Beta\", \"gamma \", \" gamma\", \"unknown\"],\n)\ndef test_lookup_miss_returns_zero(key):\n    \"\"\"未命中 _TABLE 的键应返回默认值 0。\n\n    期望值来源：规约「key 不在 _TABLE 中时返回 0」及边界情况\n    （空字符串、大小写变体、普通不存在字符串）。\n    \"\"\"\n    assert key not in _TABLE\n    assert lookup(key) == 0\n\n\ndef test_lookup_long_string_miss_returns_zero():\n    \"\"\"超长字符串键未命中，应返回 0 且不抛异常。\n\n    期望值来源：规约「key 不在 _TABLE 中时返回 0」。\n    \"\"\"\n    key = \"a\" * 1000\n    assert key not in _TABLE\n    assert lookup(key) == 0\n\n\ndef test_lookup_none_key_returns_zero():\n    \"\"\"None 键未命中，dict.get 不抛异常，返回 0。\n\n    期望值来源：规约边界情况「key 为 None 或非 str 类型\n    （dict.get 不抛异常，返回 0）」。\n    \"\"\"\n    assert lookup(None) == 0\n\n\ndef test_lookup_unhashable_key_raises_type_error():\n    \"\"\"不可哈希键（list）应触发 TypeError。\n\n    期望值来源：规约边界情况说明 dict.get 对不可哈希键会抛异常；\n    具体异常类型未在 docstring 中明确约定，此处按 Python 语义\n    记录实际行为，需人工确认。\n    \"\"\"\n    with pytest.raises(TypeError):\n        lookup([\"alpha\"])\n\n\n@pytest.mark.parametrize(\n    \"key\",\n    [\"alpha\", \"beta\", \"gamma\", \"delta\", \"\", \"Alpha\", \"unknown\"],\n)\ndef test_lookup_result_is_int_and_non_negative(key):\n    \"\"\"返回值恒为 int 且 >= 0，且满足不变量 result in {0,1,2,3}。\n\n    期望值来源：规约后置条件「返回值恒为 int」「result >= 0」\n    与不变量「result == 0 or 1 or 2 or 3」。\n    \"\"\"\n    result = lookup(key)\n    assert isinstance(result, int)\n    assert result >= 0\n    assert result in (0, 1, 2, 3)\n\n\ndef test_lookup_result_matches_table_membership():\n    \"\"\"返回值与键是否在 _TABLE 中保持一致。\n\n    期望值来源：规约后置条件「命中返回 _TABLE[key]，未命中返回 0」。\n    \"\"\"\n    for key in [\"alpha\", \"beta\", \"gamma\", \"delta\", \"\", \"Alpha\"]:\n        result = lookup(key)\n        if key in _TABLE:\n            assert result == _TABLE[key]\n        else:\n            assert result == 0",
