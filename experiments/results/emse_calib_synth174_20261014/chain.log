          "patch": "python\ndef clamp(value: int, low: int, high: int) -> int:\n    if value < low:\n        return low\n    if value > high:\n        return high\n    return value\n# noise_seed=5970\n",
          "generated_test": "import pytest\n\nfrom task_0023 import clamp\n\n\n# ---------------------------------------------------------------------------\n# 规约来源说明（所有期望值均来自自然语言规约 / SpecExpr，不来自实现猜测）\n#   后置1: result == value or result == low or result == high\n#   后置2: 若 value < high 则返回 high\n#   后置3: 若 value >= high 且 value > low 则返回 low\n#   后置4: 若 value >= high 且 value <= low 则返回 value\n# ---------------------------------------------------------------------------\n\n\ndef test_clamp_value_less_than_high_returns_high():\n    \"\"\"规约后置2：value < high 时应返回 high。\n\n    输入 value=1, low=0, high=10，1 < 10 成立，期望返回 high=10。\n    期望值来源：规约后置条件「若 value < high 则返回 high」。\n    \"\"\"\n    result = clamp(1, 0, 10)\n    assert result == 10\n\n\ndef test_clamp_value_greater_than_low_and_not_less_than_high_returns_low():\n    \"\"\"规约后置3：value >= high 且 value > low 时应返回 low。\n\n    输入 value=5, low=0, high=3，5 >= 3 且 5 > 0，期望返回 low=0。\n    期望值来源：规约后置条件「若 value >= high 且 value > low 则返回 low」。\n    \"\"\"\n    result = clamp(5, 0, 3)\n    assert result == 0\n\n\ndef test_clamp_value_equals_high_and_greater_than_low_returns_low():\n    \"\"\"边界：value == high 时不满足 value < high，进入第二分支判定。\n\n    输入 value=10, low=0, high=10，10 >= 10 且 10 > 0，期望返回 low=0。\n    期望值来源：规约后置条件「若 value >= high 且 value > low 则返回 low」。\n    \"\"\"\n    result = clamp(10, 0, 10)\n    assert result == 0\n\n\ndef test_clamp_value_equals_low_returns_value():\n    \"\"\"边界：value == low 时不满足 value > low，返回 value 本身。\n\n    输入 value=0, low=0, high=10，0 >= 10 为假，故不进入第二分支；\n    0 > 0 为假，故不进入第三分支，返回 value=0。\n    期望值来源：规约后置条件「若 value >= high 且 value <= low 则返回 value」。\n    \"\"\"\n    result = clamp(0, 0, 10)\n    assert result == 0\n\n\ndef test_clamp_value_between_low_and_high_returns_low():\n    \"\"\"value 介于 low 与 high 之间时，按规约返回 low（非直觉 clamp 行为）。\n\n    输入 value=5, low=0, high=10，5 >= 10 为假，故不进入第三分支；\n    5 < 10 为假，故不进入第一分支；5 > 0 为真，进入第二分支，返回 low=0。\n    期望值来源：规约后置条件「若 value >= high 且 value > low 则返回 low」。\n    \"\"\"\n    result = clamp(5, 0, 10)\n    assert result == 0\n\n\ndef test_clamp_value_zero_with_negative_low_returns_high():\n    \"\"\"边界：value=0 且 low 为负数，value < high 成立时返回 high。\n\n    输入 value=0, low=-5, high=3，0 < 3 成立，期望返回 high=3。\n    期望值来源：规约后置条件「若 value < high 则返回 high」。\n    \"\"\"\n    result = clamp(0, -5, 3)\n    assert result == 3\n\n\ndef test_clamp_reversed_interval_returns_value():\n    \"\"\"边界：low > high（区间反转）时，两个分支均不成立，返回 value。\n\n    输入 value=5, low=10, high=0，5 < 0 为假，5 > 10 为假，\n    故返回 value=5。\n    期望值来源：规约后置条件「若 value >= high 且 value <= low 则返回 value」。\n    \"\"\"\n    result = clamp(5, 10, 0)\n    assert result == 5\n\n\ndef test_clamp_negative_value_less_than_high_returns_high():\n    \"\"\"边界：value 为负数且小于 high 时返回 high。\n\n    输入 value=-3, low=-10, high=-1，-3 < -1 成立，期望返回 high=-1。\n    期望值来源：规约后置条件「若 value < high 则返回 high」。\n    \"\"\"\n    result = clamp(-3, -10, -1)\n    assert result == -1\n\n\ndef test_clamp_value_far_greater_than_high_returns_low():\n    \"\"\"边界：value 远大于 high 时，第一分支为假，第二分支为真，返回 low。\n\n    输入 value=1000000, low=0, high=10，1000000 >= 10 且 1000000 > 0，\n    期望返回 low=0。\n    期望值来源：规约后置条件「若 value >= high 且 value > low 则返回 low」。\n    \"\"\"\n    result = clamp(1000000, 0, 10)\n    assert result == 0\n\n\ndef test_clamp_low_equals_high_returns_value():\n    \"\"\"边界：low == high 时，value 不小于 high 且不大于 low，返回 value。\n\n    输入 value=5, low=5, high=5，5 < 5 为假，5 > 5 为假，返回 value=5。\n    期望值来源：规约后置条件「若 value >= high 且 value <= low 则返回 value」。\n    \"\"\"\n    result = clamp(5, 5, 5)\n    assert result == 5\n\n\n@pytest.mark.parametrize(\n    \"value, low, high\",\n    [\n        (1, 0, 10),\n        (5, 0, 3),\n        (10, 0, 10),\n        (0, 0, 10),\n        (5, 0, 10),\n        (0, -5, 3),\n        (5, 10, 0),\n        (-3, -10, -1),\n        (1000000, 0, 10),\n        (5, 5, 5),\n        (-1000000, -5, 5),\n        (0, 0, 0),\n    ],\n)\ndef test_clamp_result_in_value_low_high(value, low, high):\n    \"\"\"规约后置1：返回值必须属于 {value, low, high} 三者之一。\n\n    该性质对任意满足前置条件的整数输入均成立。\n    期望值来源：规约后置条件「result == value or result == low or result == high」。\n    \"\"\"\n    result = clamp(value, low, high)\n    assert result in (value, low, high)\n\n\n@pytest.mark.parametrize(\n    \"value, low, high\",\n    [\n        (1, 0, 10),\n        (5, 0, 3),\n        (10, 0, 10),\n        (0, 0, 10),\n        (5, 0, 10),\n        (0, -5, 3),\n        (5, 10, 0),\n        (-3, -10, -1),\n        (1000000, 0, 10),\n        (5, 5, 5),\n    ],\n)\ndef test_clamp_returns_int(value, low, high):\n    \"\"\"返回值类型应为 int（与签名返回注解一致）。\n\n    期望值来源：函数签名 `def clamp(value: int, low: int, high: int) -> int`。\n    \"\"\"\n    result = clamp(value, low, high)\n    assert isinstance(result, int)",
