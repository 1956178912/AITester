          "patch": "python\ndef factorial(n: int) -> int:\n    if not isinstance(n, int) or isinstance(n, bool):\n        raise TypeError(f\"factorial() only accepts integers, got {type(n).__name__}\")\n    if n < 0:\n        raise ValueError(\"factorial() not defined for negative values\")\n    if n == 0:\n        return 1\n    return n * factorial(n - 1)\n# noise_seed=8575\n",
          "generated_test": "import math\nimport pytest\n\nfrom task_0081 import factorial\n\n\n# ---------------------------------------------------------------------------\n# 正常 / 边界用例：期望值来自规约（n==0 -> 1；n>0 -> n!）\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\n    \"n, expected\",\n    [\n        (0, 1),          # 基准情形\n        (1, 1),          # 最小递归情形\n        (2, 2),\n        (3, 6),\n        (5, 120),\n        (10, 3628800),\n    ],\n)\ndef test_factorial_returns_expected_value(n, expected):\n    \"\"\"规约：n==0 返回 1；n>0 返回 n 的阶乘。期望值来自规约与数学定义。\"\"\"\n    assert factorial(n) == expected\n\n\n@pytest.mark.parametrize(\"n\", [0, 1, 2, 5, 10])\ndef test_factorial_return_type_is_int(n):\n    \"\"\"后置条件（可执行）：isinstance(result, int)。\"\"\"\n    result = factorial(n)\n    assert isinstance(result, int)\n\n\n@pytest.mark.parametrize(\"n\", [0, 1, 2, 5, 10])\ndef test_factorial_result_at_least_one(n):\n    \"\"\"后置条件（可执行）：result >= 1。\"\"\"\n    assert factorial(n) >= 1\n\n\ndef test_factorial_zero_is_base_case():\n    \"\"\"边界：n == 0 为基准情形，规约明确返回 1。\"\"\"\n    assert factorial(0) == 1\n\n\ndef test_factorial_one_is_minimal_recursion():\n    \"\"\"边界：n == 1 为最小递归情形，规约明确返回 1。\"\"\"\n    assert factorial(1) == 1\n\n\ndef test_factorial_matches_math_factorial_for_moderate_n():\n    \"\"\"规约：n>0 返回 n 的阶乘。用 math.factorial 作为独立参照（n 较小）。\"\"\"\n    for n in range(0, 15):\n        assert factorial(n) == math.factorial(n)\n\n\n# ---------------------------------------------------------------------------\n# 异常路径：负数 / 过大 n\n# 规约说明：负数无基准情形，递归不终止；n 较大时递归深度超限。\n# 具体异常类型由 Python 运行时决定（RecursionError），期望值来源为规约描述。\n# ---------------------------------------------------------------------------\n\ndef test_factorial_negative_input_raises_recursion_error():\n    \"\"\"边界：n 为负数时无基准情形，规约指出递归不终止 -> RecursionError。\"\"\"\n    with pytest.raises(RecursionError):\n        factorial(-1)\n\n\ndef test_factorial_large_n_raises_recursion_error():\n    \"\"\"边界：n 较大（如 1000）时递归深度超限 -> RecursionError。\"\"\"\n    with pytest.raises(RecursionError):\n        factorial(1000)\n\n\n# ---------------------------------------------------------------------------\n# 非 int 输入：规约称\"行为未定义\"，仅记录实际行为，不做具体值断言。\n# ---------------------------------------------------------------------------\n\ndef test_factorial_non_int_input_behavior_recorded():\n    \"\"\"边界：n 为浮点数时规约称行为未定义。\n\n    期望值来源不明，需人工确认：此处仅记录实际行为，\n    断言\"要么返回 int，要么抛出异常\"，不臆造具体返回值。\n    \"\"\"\n    try:\n        result = factorial(5.0)\n    except Exception:\n        # 行为未定义，抛出任何异常均视为可接受\n        return\n    assert isinstance(result, int)",
