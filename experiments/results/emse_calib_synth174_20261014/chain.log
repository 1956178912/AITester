          "generated_test": "import pytest\n\nfrom task_0044 import lookup\n\n\n# 规约中明确给出的 _TABLE 内容（作为期望值的唯一合法来源）\n_TABLE_SPEC = {\"alpha\": 1, \"beta\": 2, \"gamma\": 3}\n\n\n@pytest.mark.parametrize(\n    \"key, expected\",\n    [\n        (\"alpha\", 1),\n        (\"beta\", 2),\n        (\"gamma\", 3),\n    ],\n)\ndef test_lookup_hit_existing_keys(key, expected):\n    \"\"\"命中 _TABLE 中已有键时，返回值应等于 _TABLE[key]。\n\n    期望值来源：规约「若 key 在 _TABLE 中，返回值等于 _TABLE[key]」。\n    \"\"\"\n    result = lookup(key)\n    assert result == expected\n    assert result == _TABLE_SPEC[key]\n\n\n@pytest.mark.parametrize(\n    \"key\",\n    [\"alpha\", \"beta\", \"gamma\"],\n)\ndef test_lookup_hit_returns_int_type(key):\n    \"\"\"命中分支返回值类型应为 int。\n\n    期望值来源：规约「返回值类型为 int」。\n    \"\"\"\n    result = lookup(key)\n    assert isinstance(result, int)\n\n\n@pytest.mark.parametrize(\n    \"key\",\n    [\"delta\", \"\", \"Alpha\", \"BETA\", \"Gamma \", \" alpha\", \"alpha\\n\", \"αβγ\"],\n)\ndef test_lookup_miss_returns_zero(key):\n    \"\"\"未命中 _TABLE 的键应返回默认值 0。\n\n    期望值来源：规约「若 key 不在 _TABLE 中，返回值为 0」。\n    覆盖：普通未命中键、空串、大小写不同、含空白/特殊字符、非 ASCII。\n    \"\"\"\n    assert key not in _TABLE_SPEC\n    result = lookup(key)\n    assert result == 0\n\n\ndef test_lookup_miss_empty_string_returns_zero():\n    \"\"\"空字符串键未命中，返回 0。\n\n    期望值来源：规约边界情况「key 为空字符串 \"\"（未命中，返回 0）」。\n    \"\"\"\n    result = lookup(\"\")\n    assert result == 0\n\n\ndef test_lookup_miss_case_sensitive_returns_zero():\n    \"\"\"字典键大小写敏感，\"Alpha\" 与 \"alpha\" 不同，应返回 0。\n\n    期望值来源：规约边界情况「key 大小写不同（如 \"Alpha\"，未命中，返回 0）」。\n    \"\"\"\n    assert \"Alpha\" not in _TABLE_SPEC\n    result = lookup(\"Alpha\")\n    assert result == 0\n\n\ndef test_lookup_miss_long_string_returns_zero():\n    \"\"\"超长字符串键未命中，返回 0。\n\n    期望值来源：规约边界情况「key 为超长字符串或含特殊字符（未命中，返回 0）」。\n    \"\"\"\n    long_key = \"a\" * 1000\n    assert long_key not in _TABLE_SPEC\n    result = lookup(long_key)\n    assert result == 0\n\n\ndef test_lookup_miss_special_chars_returns_zero():\n    \"\"\"含特殊字符的字符串键未命中，返回 0。\n\n    期望值来源：规约边界情况「key 为超长字符串或含特殊字符（未命中，返回 0）」。\n    \"\"\"\n    special_key = \"!@#$%^&*()_+-=[]{}|;':\\\",./<>?`~\\\\\"\n    assert special_key not in _TABLE_SPEC\n    result = lookup(special_key)\n    assert result == 0\n\n\ndef test_lookup_none_key_returns_zero():\n    \"\"\"None 可哈希且不在 _TABLE 中，应返回默认值 0。\n\n    期望值来源：规约边界情况「key 为 None（可哈希，未命中，返回 0）」。\n    \"\"\"\n    result = lookup(None)\n    assert result == 0\n\n\ndef test_lookup_unhashable_key_raises_type_error():\n    \"\"\"不可哈希对象（list）作为键时，dict.get 会抛 TypeError。\n\n    期望值来源：规约边界情况「key 为不可哈希对象（如 list）时 dict.get 会抛 TypeError」。\n    \"\"\"\n    with pytest.raises(TypeError):\n        lookup([\"alpha\"])\n\n\n@pytest.mark.parametrize(\n    \"key\",\n    [\"alpha\", \"beta\", \"gamma\", \"delta\", \"\", \"Alpha\", None],\n)\ndef test_lookup_result_is_int_and_non_negative(key):\n    \"\"\"返回值应为 int 且满足不变量 result >= 0。\n\n    期望值来源：规约后置「返回值类型为 int」与不变量「result >= 0」。\n    \"\"\"\n    result = lookup(key)\n    assert isinstance(result, int)\n    assert result >= 0\n\n\n@pytest.mark.parametrize(\n    \"key\",\n    [\"alpha\", \"beta\", \"gamma\", \"delta\", \"\", \"Alpha\", None],\n)\ndef test_lookup_result_in_spec_range(key):\n    \"\"\"返回值应落在规约允许的取值集合 {0, 1, 2, 3} 内。\n\n    期望值来源：规约后置「result == 0 or result == 1 or result == 2 or result == 3」。\n    \"\"\"\n    result = lookup(key)\n    assert result in (0, 1, 2, 3)",
