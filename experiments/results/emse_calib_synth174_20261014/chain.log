          "generated_test": "import pytest\n\nfrom task_0055 import lookup\n\n\n# ---------------------------------------------------------------------------\n# 规约常量（来自自然语言规约 / SpecExpr，非实现臆测）\n# ---------------------------------------------------------------------------\n_TABLE_SPEC = {\"alpha\": 1, \"beta\": 2, \"gamma\": 3}\n_KNOWN_KEYS = [\"alpha\", \"beta\", \"gamma\"]\n\n\n# ---------------------------------------------------------------------------\n# 正常路径：命中 _TABLE\n# ---------------------------------------------------------------------------\n@pytest.mark.parametrize(\n    \"key, expected\",\n    [\n        (\"alpha\", 1),\n        (\"beta\", 2),\n        (\"gamma\", 3),\n    ],\n)\ndef test_lookup_existing_key_returns_table_value(key, expected):\n    \"\"\"规约：key 在 _TABLE 中时返回值等于 _TABLE[key]。\n\n    期望值来源：自然语言规约中 _TABLE 常量定义。\n    \"\"\"\n    result = lookup(key)\n    assert result == expected\n    assert result == _TABLE_SPEC[key]\n\n\n# ---------------------------------------------------------------------------\n# 正常路径：未命中 _TABLE\n# ---------------------------------------------------------------------------\n@pytest.mark.parametrize(\n    \"key\",\n    [\n        \"delta\",\n        \"ALPHA\",\n        \"alpha \",\n        \"alpha1\",\n        \"0\",\n    ],\n)\ndef test_lookup_missing_key_returns_zero(key):\n    \"\"\"规约：key 不在 _TABLE 中时返回 0。\n\n    期望值来源：自然语言规约后置条件。\n    \"\"\"\n    result = lookup(key)\n    assert result == 0\n\n\n# ---------------------------------------------------------------------------\n# 边界：空字符串\n# ---------------------------------------------------------------------------\ndef test_lookup_empty_string_key_returns_zero():\n    \"\"\"边界：key 为空字符串 \"\"，未收录于 _TABLE，应返回 0。\n\n    期望值来源：规约边界情况 + 后置条件（未命中返回 0）。\n    \"\"\"\n    result = lookup(\"\")\n    assert result == 0\n\n\n# ---------------------------------------------------------------------------\n# 边界：大小写变体\n# ---------------------------------------------------------------------------\ndef test_lookup_case_variant_key_returns_zero():\n    \"\"\"边界：key 为 \"Alpha\"，字典键区分大小写，未收录，应返回 0。\n\n    期望值来源：规约边界情况 + 后置条件（未命中返回 0）。\n    \"\"\"\n    result = lookup(\"Alpha\")\n    assert result == 0\n\n\n# ---------------------------------------------------------------------------\n# 边界：超长字符串\n# ---------------------------------------------------------------------------\ndef test_lookup_very_long_string_key_returns_zero():\n    \"\"\"边界：超长字符串未收录，应返回 0 且不抛异常。\n\n    期望值来源：规约边界情况 + 后置条件（未命中返回 0）。\n    \"\"\"\n    long_key = \"a\" * 1000\n    result = lookup(long_key)\n    assert result == 0\n\n\n# ---------------------------------------------------------------------------\n# 边界：None（类型注解外）\n# ---------------------------------------------------------------------------\ndef test_lookup_none_key_returns_zero():\n    \"\"\"边界：key 为 None（违反 str 类型注解）。\n\n    规约明确说明：dict.get 可接受 None 并返回 0。\n    期望值来源：规约边界情况描述。\n    \"\"\"\n    result = lookup(None)\n    assert result == 0\n\n\n# ---------------------------------------------------------------------------\n# 错误路径：不可哈希键（list）\n# ---------------------------------------------------------------------------\ndef test_lookup_unhashable_key_raises_type_error():\n    \"\"\"错误路径：传入不可哈希键（list），违反 str 类型注解。\n\n    规约未定义异常处理；list 不可哈希，dict.get 会抛 TypeError。\n    期望值来源：规约边界情况描述（异常路径未捕获 TypeError）。\n    \"\"\"\n    with pytest.raises(TypeError):\n        lookup([\"alpha\"])\n\n\n# ---------------------------------------------------------------------------\n# 后置条件 / 不变量：对已收录键统一校验\n# ---------------------------------------------------------------------------\n@pytest.mark.parametrize(\"key\", _KNOWN_KEYS)\ndef test_lookup_postcondition_result_is_int_and_non_negative(key):\n    \"\"\"后置条件：返回值恒为 int 且 result >= 0。\n\n    期望值来源：SpecExpr 后置子句。\n    \"\"\"\n    result = lookup(key)\n    assert isinstance(result, int)\n    assert result >= 0\n\n\n@pytest.mark.parametrize(\"key\", _KNOWN_KEYS)\ndef test_lookup_invariant_result_in_known_range(key):\n    \"\"\"不变量：result == 0 or result in [1, 2, 3]。\n\n    期望值来源：SpecExpr 不变量子句。\n    \"\"\"\n    result = lookup(key)\n    assert result == 0 or result in [1, 2, 3]\n\n\n@pytest.mark.parametrize(\n    \"key\",\n    [\"alpha\", \"beta\", \"gamma\", \"delta\", \"\", \"Alpha\", \"unknown\"],\n)\ndef test_lookup_postcondition_known_key_or_zero(key):\n    \"\"\"后置条件：key in [\"alpha\",\"beta\",\"gamma\"] or result == 0。\n\n    期望值来源：SpecExpr 后置子句。\n    \"\"\"\n    result = lookup(key)\n    assert key in _KNOWN_KEYS or result == 0",
