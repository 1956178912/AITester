          "generated_test": "import math\n\nimport pytest\n\nfrom task_0051 import rounded_ratio\n\n\n# ---------------------------------------------------------------------------\n# 正常用例\n# ---------------------------------------------------------------------------\n\ndef test_rounded_ratio_normal_one_over_four():\n    \"\"\"1/4 = 25.0% -> 0.25（规约：math.floor(hit/total*100)/100）。\"\"\"\n    result = rounded_ratio(1, 4)\n    assert isinstance(result, float)\n    assert result == 0.25\n\n\ndef test_rounded_ratio_normal_one_over_three():\n    \"\"\"1/3 = 33.333...% 向下取整到两位小数 -> 0.33。\"\"\"\n    result = rounded_ratio(1, 3)\n    assert isinstance(result, float)\n    assert result == 0.33\n\n\ndef test_rounded_ratio_normal_all_hit():\n    \"\"\"hit == total 时返回 1.0（边界情况约定）。\"\"\"\n    result = rounded_ratio(5, 5)\n    assert isinstance(result, float)\n    assert result == 1.0\n\n\n# ---------------------------------------------------------------------------\n# 边界用例\n# ---------------------------------------------------------------------------\n\ndef test_rounded_ratio_boundary_total_zero():\n    \"\"\"total == 0 时按规约返回 0.0，不触发除零。\"\"\"\n    result = rounded_ratio(10, 0)\n    assert isinstance(result, float)\n    assert result == 0.0\n\n\ndef test_rounded_ratio_boundary_hit_zero():\n    \"\"\"hit == 0 时返回 0.0。\"\"\"\n    result = rounded_ratio(0, 7)\n    assert isinstance(result, float)\n    assert result == 0.0\n\n\ndef test_rounded_ratio_boundary_both_zero():\n    \"\"\"hit == 0 且 total == 0 时，total==0 分支优先返回 0.0。\"\"\"\n    result = rounded_ratio(0, 0)\n    assert isinstance(result, float)\n    assert result == 0.0\n\n\ndef test_rounded_ratio_boundary_negative_hit():\n    \"\"\"hit 为负数：-1/4 = -25.0% -> -0.25（floor 对负数的行为）。\"\"\"\n    result = rounded_ratio(-1, 4)\n    assert isinstance(result, float)\n    assert result == -0.25\n\n\ndef test_rounded_ratio_boundary_negative_total():\n    \"\"\"total 为负数：1/-4 = -25.0% -> -0.25。\"\"\"\n    result = rounded_ratio(1, -4)\n    assert isinstance(result, float)\n    assert result == -0.25\n\n\ndef test_rounded_ratio_boundary_large_integers():\n    \"\"\"大整数除法可能引入浮点精度误差。\n\n    期望值来源不明（规约仅给出 math.floor(hit/total*100)/100 公式，\n    未给出该具体输入的精确结果），需人工确认。\n    此处仅验证：不抛异常、返回 float、且与规约公式一致。\n    \"\"\"\n    hit = 1000000000000\n    total = 3\n    result = rounded_ratio(hit, total)\n    assert isinstance(result, float)\n    # 与规约公式保持一致（探索性断言，期望值需人工确认）\n    assert result == float(int(hit / total * 100)) / 100\n\n\n# ---------------------------------------------------------------------------\n# 错误用例\n# ---------------------------------------------------------------------------\n\ndef test_rounded_ratio_error_non_integer_hit():\n    \"\"\"传入非整数 hit（字符串）违反前置条件，期望抛出 TypeError。\n\n    期望值来源：前置条件要求 hit 为 int；字符串参与除法会触发 TypeError。\n    \"\"\"\n    with pytest.raises(TypeError):\n        rounded_ratio(\"1\", 4)\n\n\ndef test_rounded_ratio_error_non_integer_total():\n    \"\"\"传入非整数 total（字符串）违反前置条件，期望抛出 TypeError。\"\"\"\n    with pytest.raises(TypeError):\n        rounded_ratio(1, \"4\")\n\n\n# ---------------------------------------------------------------------------\n# 规约性质（后置 / 不变量）参数化验证\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\n    \"hit, total\",\n    [\n        (1, 4),\n        (1, 3),\n        (5, 5),\n        (0, 7),\n        (10, 0),\n        (0, 0),\n        (-1, 4),\n        (1, -4),\n        (7, 2),\n        (2, 7),\n    ],\n)\ndef test_rounded_ratio_postcondition_formula(hit, total):\n    \"\"\"后置条件：total==0 返回 0.0；否则等于 math.floor(hit/total*100)/100。\"\"\"\n    result = rounded_ratio(hit, total)\n    assert isinstance(result, float)\n    if total == 0:\n        assert result == 0.0\n    else:\n        assert result == float(int(hit / total * 100)) / 100\n\n\n@pytest.mark.parametrize(\n    \"hit, total\",\n    [\n        (1, 4),\n        (5, 5),\n        (0, 7),\n        (10, 0),\n        (0, 0),\n        (7, 2),\n    ],\n)\ndef test_rounded_ratio_invariant_non_negative(hit, total):\n    \"\"\"不变量：result >= 0.0 或 hit < 0 或 total < 0。\"\"\"\n    result = rounded_ratio(hit, total)\n    assert result >= 0.0 or hit < 0 or total < 0",
