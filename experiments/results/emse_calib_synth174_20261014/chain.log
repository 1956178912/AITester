          "generated_test": "import pytest\n\nfrom task_0012 import split_words\n\n\n# ---------------------------------------------------------------------------\n# 规约（Spec）辅助断言\n# ---------------------------------------------------------------------------\n\ndef assert_spec_postconditions(text, result):\n    \"\"\"校验规约中所有可执行后置条件与不变量。\"\"\"\n    assert isinstance(result, list), \"后置条件：返回值必须为 list\"\n    assert all(isinstance(item, str) for item in result), \"后置条件：元素必须均为 str\"\n    assert \" \".join(result) == text, \"后置条件：按单空格 join 必须无损还原\"\n    assert len(result) == text.count(\" \") + 1, \"不变量：元素个数 == 空格数 + 1\"\n\n\n# ---------------------------------------------------------------------------\n# 正常路径\n# ---------------------------------------------------------------------------\n\ndef test_split_words_normal_sentence():\n    \"\"\"普通多词句子：按单空格切分为三元素列表。\n\n    期望值来源：规约边界/后置条件（\" \".join(result) == text 且 len == count+1）。\n    \"\"\"\n    text = \"hello world foo\"\n    result = split_words(text)\n    assert result == [\"hello\", \"world\", \"foo\"]\n    assert_spec_postconditions(text, result)\n\n\ndef test_split_words_single_word_no_space():\n    \"\"\"无空格输入返回单元素列表。\n\n    期望值来源：规约不变量 len(result) == text.count(\" \") + 1 == 1。\n    \"\"\"\n    text = \"hello\"\n    result = split_words(text)\n    assert result == [\"hello\"]\n    assert_spec_postconditions(text, result)\n\n\ndef test_split_words_unicode_and_emoji():\n    \"\"\"Unicode 与 emoji 按空格正常分割且原样保留。\n\n    期望值来源：规约边界情况（Unicode/emoji 按字符原样保留）。\n    \"\"\"\n    text = \"你好 世界 😀\"\n    result = split_words(text)\n    assert result == [\"你好\", \"世界\", \"😀\"]\n    assert_spec_postconditions(text, result)\n\n\n# ---------------------------------------------------------------------------\n# 边界路径\n# ---------------------------------------------------------------------------\n\ndef test_split_words_empty_string():\n    \"\"\"空串输入返回 [\"\"]（长度 1，非空列表）。\n\n    期望值来源：规约边界情况 text == \"\" → 返回 [\"\"]。\n    \"\"\"\n    text = \"\"\n    result = split_words(text)\n    assert result == [\"\"]\n    assert_spec_postconditions(text, result)\n\n\ndef test_split_words_all_spaces():\n    \"\"\"纯空格串 \"   \" 返回 4 个空串元素（不合并、不剥离）。\n\n    期望值来源：规约边界情况 text 全为空格 → [\"\", \"\", \"\", \"\"]。\n    \"\"\"\n    text = \"   \"\n    result = split_words(text)\n    assert result == [\"\", \"\", \"\", \"\"]\n    assert_spec_postconditions(text, result)\n\n\ndef test_split_words_leading_trailing_spaces():\n    \"\"\"首尾空格各产生一个空串元素，不做 strip。\n\n    期望值来源：规约边界情况（首/尾产生空串元素，不被剥离）。\n    \"\"\"\n    text = \" a b \"\n    result = split_words(text)\n    assert result == [\"\", \"a\", \"b\", \"\"]\n    assert_spec_postconditions(text, result)\n\n\ndef test_split_words_consecutive_spaces():\n    \"\"\"连续两个空格产生一个空串元素（与无参 str.split() 行为不同）。\n\n    期望值来源：规约边界情况（每个空格都切一刀，产生空串元素）。\n    \"\"\"\n    text = \"a  b\"\n    result = split_words(text)\n    assert result == [\"a\", \"\", \"b\"]\n    assert_spec_postconditions(text, result)\n\n\ndef test_split_words_tab_and_newline_not_split():\n    \"\"\"制表符与换行等非空格空白不参与分割，整体作为单元素返回。\n\n    期望值来源：规约边界情况（仅按 \" \" 分割，非空格空白原样保留）。\n    \"\"\"\n    text = \"a\\tb\\nc\"\n    result = split_words(text)\n    assert result == [\"a\\tb\\nc\"]\n    assert_spec_postconditions(text, result)\n\n\ndef test_split_words_long_string():\n    \"\"\"大量空格时元素数量线性增长，无长度上限问题。\n\n    期望值来源：规约不变量 len(result) == text.count(\" \") + 1 == 11。\n    \"\"\"\n    text = \"a a a a a a a a a a\"\n    result = split_words(text)\n    assert result == [\"a\"] * 10\n    assert_spec_postconditions(text, result)\n\n\n# ---------------------------------------------------------------------------\n# 异常路径（违反前置条件 isinstance(text, str)）\n# ---------------------------------------------------------------------------\n\ndef test_split_words_none_raises():\n    \"\"\"传入 None 违反前置条件，应抛出异常。\n\n    期望值来源：规约前置条件 isinstance(text, str)；具体异常类型未在规约中声明，\n    此处仅断言抛出异常（AttributeError 为 Python 语义推断，需人工确认）。\n    \"\"\"\n    with pytest.raises(