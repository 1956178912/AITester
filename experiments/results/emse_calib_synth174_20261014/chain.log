          "generated_test": "import importlib\nimport pytest\n\nimport task_0017\nfrom task_0017 import first_item\n\n\n@pytest.fixture\ndef restore_global_list():\n    \"\"\"保存并恢复 task_0017 模块级全局变量 list，避免测试间相互污染。\"\"\"\n    original = getattr(task_0017, \"list\", None)\n    had_attr = hasattr(task_0017, \"list\")\n    yield\n    if had_attr:\n        task_0017.list = original\n    else:\n        if hasattr(task_0017, \"list\"):\n            delattr(task_0017, \"list\")\n\n\ndef test_first_item_returns_first_element_of_default_global_list(restore_global_list):\n    \"\"\"正常取首元素：默认全局 list=[\"a\",\"b\",\"c\"] 时，返回值应等于 list[0]。\n\n    期望值来源：规约后置条件 result == list[0]。\n    \"\"\"\n    task_0017.list = [\"a\", \"b\", \"c\"]\n    result = first_item()\n    assert result == task_0017.list[0]\n    assert result == \"a\"\n\n\ndef test_first_item_returns_str_type_for_current_global_data(restore_global_list):\n    \"\"\"后置条件：在当前全局数据（首元素为 str）下，返回值类型为 str。\n\n    期望值来源：规约后置条件「返回值类型为 str（在当前全局数据下）」。\n    \"\"\"\n    task_0017.list = [\"a\", \"b\", \"c\"]\n    result = first_item()\n    assert isinstance(result, str)\n\n\ndef test_first_item_single_element_list_boundary(restore_global_list):\n    \"\"\"边界：全局 list 为单元素 [\"a\"] 时，仍应返回 \"a\"。\n\n    期望值来源：规约前置 len(list) > 0 的下界 + 后置 result == list[0]。\n    \"\"\"\n    task_0017.list = [\"a\"]\n    result = first_item()\n    assert result == task_0017.list[0]\n    assert result == \"a\"\n\n\ndef test_first_item_empty_list_raises_index_error(restore_global_list):\n    \"\"\"异常路径：全局 list 为空列表时，应抛出 IndexError。\n\n    期望值来源：规约边界情况「全局 list 为空列表时触发 IndexError」。\n    异常消息文本规约未约定，故不校验消息内容。\n    \"\"\"\n    task_0017.list = []\n    with pytest.raises(IndexError):\n        first_item()\n\n\ndef test_first_item_reflects_rebound_global_list(restore_global_list):\n    \"\"\"边界：全局 list 被重新绑定后，返回值应随之变化。\n\n    期望值来源：规约边界情况「全局 list 被重新绑定或修改后返回值随之变化」\n    + 后置 result == list[0]。\n    \"\"\"\n    task_0017.list = [\"x\", \"y\", \"z\"]\n    result = first_item()\n    assert result == task_0017.list[0]\n    assert result == \"x\"\n\n\ndef test_first_item_reflects_mutated_global_list(restore_global_list):\n    \"\"\"边界：全局 list 被原地修改后，返回值应随之变化。\n\n    期望值来源：规约边界情况「全局 list 被重新绑定或修改后返回值随之变化」\n    + 后置 result == list[0]。\n    \"\"\"\n    task_0017.list = [\"a\", \"b\", \"c\"]\n    task_0017.list[0] = \"z\"\n    result = first_item()\n    assert result == task_0017.list[0]\n    assert result == \"z\"\n\n\ndef test_first_item_non_str_first_element_behavior(restore_global_list):\n    \"\"\"边界：全局 list 首元素为非 str 类型时，记录实际返回行为。\n\n    期望值来源：规约仅声明「首元素为其他类型时返回类型注解不成立」，\n    未约定具体返回值，故此处仅断言 result == list[0]（后置条件），\n    不臆造具体值。类型注解不成立的具体表现需人工确认。\n    \"\"\"\n    task_0017.list = [123, \"b\", \"c\"]\n    result = first_item()\n    assert result == task_0017.list[0]",
