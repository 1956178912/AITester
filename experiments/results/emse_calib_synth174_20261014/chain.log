          "generated_test": "import pytest\n\nfrom task_0062 import display\n\n\n# ---------------------------------------------------------------------------\n# 规约要点（期望值唯一合法来源）：\n#   - 前置：name 为 str 类型\n#   - 前置：_TABLE = {\"alpha\": 1, \"beta\": 2, \"gamma\": 3}\n#   - 后置：若 lookup(name) 返回 str，则可返回\n#           \"name=\" + name + \" \" + value.strip().upper()\n#   - 后置：实际 lookup 返回 int，故正常路径无法产生返回值\n#   - 边界：\"\"、alpha/beta/gamma、未命中键、非 str、大小写变体\n#\n# 说明：规约明确指出 lookup 返回 int，而 display 对其调用 .strip()，\n# 因此正常路径无法产生返回值。以下用例对\"命中/未命中/边界\"输入\n# 采用\"记录实际行为\"的探索性断言：要么返回符合后置格式的字符串，\n# 要么抛出 AttributeError（int 无 strip）。期望值来源不明处已标注。\n# ---------------------------------------------------------------------------\n\n\ndef _assert_display_behavior(name):\n    \"\"\"探索性断言：display 要么返回符合后置格式的字符串，要么抛 AttributeError。\n\n    期望值来源：规约后置条件（lookup 返回 int 时正常路径无法产生返回值）。\n    不臆造具体返回值，仅校验可判定的性质。\n    \"\"\"\n    try:\n        result = display(name)\n    except AttributeError:\n        # 规约预期：lookup 返回 int，对其调用 .strip() 触发 AttributeError\n        return\n    # 若未抛异常，则返回值必须符合后置格式约定\n    assert isinstance(result, str)\n    assert result.startswith(\"name=\" + str(name) + \" \")\n\n\n@pytest.mark.parametrize(\"name\", [\"alpha\", \"beta\", \"gamma\"])\ndef test_display_table_hit_keys(name):\n    \"\"\"_TABLE 中存在的键（alpha/beta/gamma）。\n\n    规约：lookup 命中返回 int，display 对其调用 .strip()，\n    正常路径无法产生返回值。期望值来源：规约后置条件。\n    \"\"\"\n    _assert_display_behavior(name)\n\n\ndef test_display_missing_key():\n    \"\"\"未命中键（如 \"delta\"）。\n\n    规约：lookup 返回默认值 0（int），.strip() 触发异常。\n    期望值来源：规约后置条件。\n    \"\"\"\n    _assert_display_behavior(\"delta\")\n\n\ndef test_display_empty_string():\n    \"\"\"边界：name 为空字符串 \"\"。\n\n    规约：lookup 返回 0（int），拼接前缀为 \"name= \"。\n    期望值来源：规约边界情况 + 后置条件。\n    \"\"\"\n    _assert_display_behavior(\"\")\n\n\ndef test_display_case_variant_key():\n    \"\"\"边界：大小写变体键 \"Alpha\"。\n\n    规约：_TABLE 键区分大小写，\"Alpha\" 未命中返回 0。\n    期望值来源：规约边界情况。\n    \"\"\"\n    _assert_display_behavior(\"Alpha\")\n\n\ndef test_display_non_string_none():\n    \"\"\"异常路径：name 为 None（不满足前置 isinstance(name, str)）。\n\n    规约：非字符串类型输入。期望值来源：规约边界情况。\n    期望值来源不明，需人工确认：此处仅记录实际行为。\n    \"\"\"\n    _assert_display_behavior(None)\n\n\ndef test_display_non_string_int():\n    \"\"\"异常路径：name 为 int（不满足前置 isinstance(name, str)）。\n\n    规约：非字符串类型输入。期望值来源：规约边界情况。\n    期望值来源不明，需人工确认：此处仅记录实际行为。\n    \"\"\"\n    _assert_display_behavior(123)\n\n\ndef test_display_lookup_int_causes_strip_error():\n    \"\"\"核心缺陷验证：lookup 返回 int 时 value.strip() 必然抛 AttributeError。\n\n    规约：实际 lookup 返回 int，故正常路径无法产生返回值。\n    期望值来源：规约后置条件。使用 gamma（命中键，lookup 返回 3）。\n    \"\"\"\n    with pytest.raises(AttributeError):\n        display(\"gamma\")",
