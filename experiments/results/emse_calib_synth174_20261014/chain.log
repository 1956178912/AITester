          "generated_test": "import pytest\n\nfrom task_0064 import lookup, _TABLE\n\n\nclass TestLookupNormal:\n    \"\"\"正常路径：命中 _TABLE 中的键。\"\"\"\n\n    @pytest.mark.parametrize(\n        \"key, expected\",\n        [\n            (\"alpha\", 1),\n            (\"beta\", 2),\n            (\"gamma\", 3),\n        ],\n    )\n    def test_lookup_hit_known_keys(self, key, expected):\n        \"\"\"命中 _TABLE 中的键时，返回值应等于 _TABLE[key]。\n\n        期望值来源：规约后置条件 result == _TABLE[key]（key 存在于 _TABLE 中）。\n        \"\"\"\n        result = lookup(key)\n        assert result == expected\n        assert result == _TABLE[key]\n\n    def test_lookup_miss_returns_zero(self):\n        \"\"\"未命中 _TABLE 的普通字符串键应返回 0。\n\n        期望值来源：规约后置条件 key 不存在 -> result == 0。\n        \"\"\"\n        assert lookup(\"delta\") == 0\n\n    def test_lookup_result_is_int(self):\n        \"\"\"返回值恒为 int 类型。\n\n        期望值来源：规约后置条件 isinstance(result, int)。\n        \"\"\"\n        assert isinstance(lookup(\"alpha\"), int)\n        assert isinstance(lookup(\"no_such_key\"), int)\n\n    def test_lookup_result_non_negative(self):\n        \"\"\"返回值恒满足不变量 result >= 0。\n\n        期望值来源：规约不变量 result >= 0。\n        \"\"\"\n        assert lookup(\"alpha\") >= 0\n        assert lookup(\"beta\") >= 0\n        assert lookup(\"gamma\") >= 0\n        assert lookup(\"no_such_key\") >= 0\n\n\nclass TestLookupBoundary:\n    \"\"\"边界情况。\"\"\"\n\n    def test_lookup_empty_string_returns_zero(self):\n        \"\"\"空字符串键未命中，返回 0。\n\n        期望值来源：规约边界情况 key == \"\" -> 返回 0。\n        \"\"\"\n        assert lookup(\"\") == 0\n\n    def test_lookup_case_variant_returns_zero(self):\n        \"\"\"大小写变体 \"Alpha\" 未命中，返回 0（大小写敏感）。\n\n        期望值来源：规约边界情况 \"Alpha\" -> 返回 0。\n        \"\"\"\n        assert lookup(\"Alpha\") == 0\n\n    def test_lookup_very_long_string_returns_zero(self):\n        \"\"\"超长字符串键未命中，返回 0，且不抛异常。\n\n        期望值来源：规约边界情况（不存在的普通字符串）-> 返回 0。\n        \"\"\"\n        long_key = \"a\" * 10000\n        assert lookup(long_key) == 0\n\n\nclass TestLookupTypeViolation:\n    \"\"\"违反类型注解的输入路径。\"\"\"\n\n    def test_lookup_none_key_returns_zero(self):\n        \"\"\"None 作为键：dict.get 接受任意可哈希对象，未命中返回 0。\n\n        期望值来源：规约边界情况（None 或非 str 类型 -> 返回 0）。\n        注意：该输入违反 key: str 类型注解，但规约明确其返回 0。\n        \"\"\"\n        assert lookup(None) == 0\n\n    def test_lookup_unhashable_key_raises(self):\n        \"\"\"不可哈希对象（list）作为键应抛出 TypeError。\n\n        期望值来源：规约边界情况说明 list 不可哈希，dict.get 会抛 TypeError；\n        具体异常类型由 Python 运行时决定，此处断言 TypeError。\n        \"\"\"\n        with pytest.raises(TypeError):\n            lookup([1, 2, 3])",
