          "generated_test": "import datetime\n\nimport pytest\n\nfrom task_0026 import days_until\n\n\ndef _today_str() -> str:\n    return datetime.datetime.now().strftime(\"%Y-%m-%d\")\n\n\ndef _tomorrow_str() -> str:\n    return (datetime.datetime.now() + datetime.timedelta(days=1)).strftime(\"%Y-%m-%d\")\n\n\ndef _yesterday_str() -> str:\n    return (datetime.datetime.now() - datetime.timedelta(days=1)).strftime(\"%Y-%m-%d\")\n\n\ndef test_days_until_future_date_returns_positive():\n    \"\"\"规约：目标日期在未来时返回正的天数（具体数值依赖运行时刻，仅断言 > 0）。\"\"\"\n    result = days_until(\"2999-01-01\")\n    assert isinstance(result, int)\n    assert result > 0\n\n\ndef test_days_until_past_date_returns_negative():\n    \"\"\"规约：目标日期在过去时返回负的天数（具体数值依赖运行时刻，仅断言 < 0）。\"\"\"\n    result = days_until(\"2000-01-01\")\n    assert isinstance(result, int)\n    assert result < 0\n\n\ndef test_days_until_today_boundary():\n    \"\"\"规约边界：目标为今天，结果应为 0 或 -1（取决于当前时刻）。\"\"\"\n    result = days_until(_today_str())\n    assert isinstance(result, int)\n    assert result in (0, -1)\n\n\ndef test_days_until_tomorrow_boundary():\n    \"\"\"规约边界：目标为明天，结果应为 0 或 1。\"\"\"\n    result = days_until(_tomorrow_str())\n    assert isinstance(result, int)\n    assert result in (0, 1)\n\n\ndef test_days_until_yesterday_boundary():\n    \"\"\"规约边界：目标为昨天，结果应为 -1 或 -2。\"\"\"\n    result = days_until(_yesterday_str())\n    assert isinstance(result, int)\n    assert result in (-1, -2)\n\n\ndef test_days_until_datetime_min_date():\n    \"\"\"规约边界：'0001-01-01' 为 datetime.min 日期，结果约 -73 万天（仅断言 < -700000）。\"\"\"\n    result = days_until(\"0001-01-01\")\n    assert isinstance(result, int)\n    assert result < -700000\n\n\ndef test_days_until_datetime_max_date():\n    \"\"\"规约边界：'9999-12-31' 为 datetime.max 日期，结果约 +290 万天（仅断言 > 2000000）。\"\"\"\n    result = days_until(\"9999-12-31\")\n    assert isinstance(result, int)\n    assert result > 2000000\n\n\ndef test_days_until_invalid_format_string():\n    \"\"\"规约：非法格式解析失败时返回 (datetime.min - now).days，约 -73 万天（仅断言 < -700000）。\"\"\"\n    result = days_until(\"not-a-date\")\n    assert isinstance(result, int)\n    assert result < -700000\n\n\ndef test_days_until_empty_string():\n    \"\"\"规约：空字符串解析失败时返回 (datetime.min - now).days，约 -73 万天（仅断言 < -700000）。\"\"\"\n    result = days_until(\"\")\n    assert isinstance(result, int)\n    assert result < -700000\n\n\ndef test_days_until_out_of_range_date():\n    \"\"\"规约：月份/日期越界解析失败时返回 (datetime.min - now).days，约 -73 万天（仅断言 < -700000）。\"\"\"\n    result = days_until(\"2024-13-45\")\n    assert isinstance(result, int)\n    assert result < -700000\n\n\ndef test_days_until_none_input_raises():\n    \"\"\"规约边界：None 传入 strptime 抛 TypeError，不被 except ValueError 捕获，应向上抛出。\n\n    期望值来源：规约明确说明 None 会触发 TypeError 且未被捕获。\n    \"\"\"\n    with pytest.raises(TypeError):\n        days_until(None)\n\n\ndef test_days_until_returns_int_type():\n    \"\"\"规约后置：返回值类型为 int。\"\"\"\n    result = days_until(\"2999-01-01\")\n    assert isinstance(result, int)\n\n\ndef test_days_until_matches_spec_formula_for_future_date():\n    \"\"\"规约后置：返回值等于 (parse_date(target) - datetime.datetime.now()).days。\n\n    期望值来源：规约后置条件。使用 datetime.strptime 复现 parse_date 的解析语义，\n    允许因运行时刻差异导致的 ±1 天误差。\n    \"\"\"\n    target = \"2999-01-01\"\n    parsed = datetime.datetime.strptime(target, \"%Y-%m-%d\")\n    expected = (parsed - datetime.datetime.now()).days\n    result = days_until(target)\n    assert abs(result - expected) <= 1\n\n\ndef test_days_until_matches_spec_formula_for_invalid_input():\n    \"\"\"规约后置：解析失败时返回值等于 (datetime.min - datetime.datetime.now()).days。\n\n    期望值来源：规约后置条件。允许因运行时刻差异导致的 ±1 天误差。\n    \"\"\"\n    expected = (datetime.datetime.min - datetime.datetime.now()).days\n    result = days_until(\"not-a-date\")\n    assert abs(result - expected) <= 1",
