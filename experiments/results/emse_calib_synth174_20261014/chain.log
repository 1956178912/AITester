          "generated_test": "import pytest\n\nfrom task_0021 import split_words\n\n\n# ---------------------------------------------------------------------------\n# 正常路径\n# ---------------------------------------------------------------------------\n\ndef test_split_words_normal_multi_word():\n    \"\"\"普通多词字符串：'hello world foo' → ['hello', 'world', 'foo']。\n\n    期望值来源：规约边界/后置条件（\" \".join 还原、len == count+1）。\n    \"\"\"\n    result = split_words(\"hello world foo\")\n    assert result == [\"hello\", \"world\", \"foo\"]\n    assert isinstance(result, list)\n    assert \" \".join(result) == \"hello world foo\"\n    assert len(result) == \"hello world foo\".count(\" \") + 1\n\n\ndef test_split_words_no_space_single_word():\n    \"\"\"无空格单词：'hello' → ['hello']。\n\n    期望值来源：规约后置条件 len(result) == text.count(\" \") + 1。\n    \"\"\"\n    result = split_words(\"hello\")\n    assert result == [\"hello\"]\n    assert isinstance(result, list)\n    assert \" \".join(result) == \"hello\"\n    assert len(result) == \"hello\".count(\" \") + 1\n\n\ndef test_split_words_unicode_characters():\n    \"\"\"Unicode 字符：'你好 世界' → ['你好', '世界']。\n\n    期望值来源：规约 input_domain 含 Unicode，按字面空格切分。\n    \"\"\"\n    result = split_words(\"你好 世界\")\n    assert result == [\"你好\", \"世界\"]\n    assert isinstance(result, list)\n    assert \" \".join(result) == \"你好 世界\"\n    assert len(result) == \"你好 世界\".count(\" \") + 1\n\n\n# ---------------------------------------------------------------------------\n# 边界情况\n# ---------------------------------------------------------------------------\n\ndef test_split_words_empty_string():\n    \"\"\"空字符串：'' → ['']（而非 []）。\n\n    期望值来源：规约边界情况明确约定。\n    \"\"\"\n    result = split_words(\"\")\n    assert result == [\"\"]\n    assert isinstance(result, list)\n    assert \" \".join(result) == \"\"\n    assert len(result) == \"\".count(\" \") + 1\n\n\ndef test_split_words_single_space():\n    \"\"\"单个空格：' ' → ['', '']。\n\n    期望值来源：规约边界情况明确约定。\n    \"\"\"\n    result = split_words(\" \")\n    assert result == [\"\", \"\"]\n    assert isinstance(result, list)\n    assert \" \".join(result) == \" \"\n    assert len(result) == \" \".count(\" \") + 1\n\n\ndef test_split_words_consecutive_spaces():\n    \"\"\"连续空格：'a  b' → ['a', '', 'b']（不合并分隔符）。\n\n    期望值来源：规约边界情况明确约定。\n    \"\"\"\n    result = split_words(\"a  b\")\n    assert result == [\"a\", \"\", \"b\"]\n    assert isinstance(result, list)\n    assert \" \".join(result) == \"a  b\"\n    assert len(result) == \"a  b\".count(\" \") + 1\n    assert all(\" \" not in item for item in result)\n\n\ndef test_split_words_leading_and_trailing_spaces():\n    \"\"\"首尾空格：' a ' → ['', 'a', '']。\n\n    期望值来源：规约边界情况明确约定。\n    \"\"\"\n    result = split_words(\" a \")\n    assert result == [\"\", \"a\", \"\"]\n    assert isinstance(result, list)\n    assert \" \".join(result) == \" a \"\n    assert len(result) == \" a \".count(\" \") + 1\n\n\ndef test_split_words_non_space_whitespace_only():\n    \"\"\"仅含制表符/换行：'\\\\t\\\\n' → ['\\\\t\\\\n']（分隔符仅为字面空格）。\n\n    期望值来源：规约边界情况明确约定。\n    \"\"\"\n    result = split_words(\"\\t\\n\")\n    assert result == [\"\\t\\n\"]\n    assert isinstance(result, list)\n    assert \" \".join(result) == \"\\t\\n\"\n    assert len(result) == \"\\t\\n\".count(\" \") + 1\n\n\n# ---------------------------------------------------------------------------\n# 错误路径（违反前置条件 isinstance(text, str)）\n# ---------------------------------------------------------------------------\n\ndef test_split_words_none_raises_attribute_error():\n    \"\"\"传入 None：违反前置条件，触发 AttributeError。\n\n    期望值来源：规约边界情况约定非 str 入参触发 AttributeError；\n    具体异常消息未约定，故仅断言异常类型。\n    \"\"\"\n    with pytest.raises(AttributeError):\n        split_words(None)\n\n\ndef test_split_words_int_raises_attribute_error():\n    \"\"\"传入整数：违反前置条件，触发 AttributeError。\n\n    期望值来源：规约边界情况约定非 str 入参触发 AttributeError；\n    具体异常消息未约定，故仅断言异常类型。\n    \"\"\"\n    with pytest.raises(AttributeError):\n        split_words(123)\n\n\n# ---------------------------------------------------------------------------\n# 参数化：后置条件与不变量（覆盖多组输入）\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\n    \"text\",\n    [\n        \"hello world foo\",\n        \"hello\",\n        \"\",\n        \" \",\n        \"a  b\",\n        \" a \",\n        \"\\t\\n\",\n        \"你好 世界\",\n        \"a b c d e\",\n        \"  leading\",\n        \"trailing  \",\n        \"a\\tb c\\nd\",\n    ],\n)\ndef test_split_words_postconditions_and_invariants(text):\n    \"\"\"对多组输入验证后置条件与不变量。\n\n    期望值来源：规约后置条件与不变量（可执行子句）。\n    \"\"\"\n    result = split_words(text)\n    assert isinstance(result, list)\n    assert \" \".join(result) == text\n    assert len(result) == text.count(\" \") + 1\n    assert all(\" \" not in item for item in result)\n    assert all(isinstance(item, str) for item in result)",
