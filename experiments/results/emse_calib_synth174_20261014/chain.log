          "generated_test": "import pytest\n\nfrom task_0036 import is_valid_username\n\n\n# ---------------------------------------------------------------------------\n# 规约（Spec）：\n#   def is_valid_username(name: str) -> bool\n#   返回 True 当且仅当 name 为空、或 name 含非字母数字字符、或 len(name) > 20\n#   返回 False 当且仅当 name 非空、name.isalnum() 为 True 且 len(name) <= 20\n# ---------------------------------------------------------------------------\n\n\ndef _spec_expected(name: str) -> bool:\n    \"\"\"根据规约计算期望值：True 表示无效。\"\"\"\n    return not (bool(name) and name.isalnum() and len(name) <= 20)\n\n\n# ---------------------------------------------------------------------------\n# 正常用例\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\n    \"name\",\n    [\n        \"alice\",\n        \"user123\",\n        \"12345\",\n    ],\n)\ndef test_is_valid_username_valid_names_return_false(name):\n    \"\"\"正常有效用户名：非空、纯字母数字、长度合规，应返回 False（有效）。\n\n    期望值来源：规约后置条件 result == (not (bool(name) and name.isalnum() and len(name) <= 20))\n    \"\"\"\n    result = is_valid_username(name)\n    assert isinstance(result, bool)\n    assert result is False\n    assert result == _spec_expected(name)\n\n\n# ---------------------------------------------------------------------------\n# 边界用例\n# ---------------------------------------------------------------------------\n\ndef test_is_valid_username_empty_string_returns_true():\n    \"\"\"边界：空字符串使 bool(name) 为 False，短路后应返回 True（无效）。\n\n    期望值来源：规约边界情况「空字符串 \"\"（bool(\"\") 为 False，短路后 ok=False，返回 True）」\n    \"\"\"\n    result = is_valid_username(\"\")\n    assert isinstance(result, bool)\n    assert result is True\n    assert result == _spec_expected(\"\")\n\n\ndef test_is_valid_username_length_exactly_20_returns_false():\n    \"\"\"边界：长度恰为 20 的纯字母数字串，len <= 20 成立，应返回 False（有效）。\n\n    期望值来源：规约边界情况「长度恰为 20 的纯字母数字串（len <= 20 成立，返回 False）」\n    \"\"\"\n    name = \"a2345678901234567890\"\n    assert len(name) == 20\n    result = is_valid_username(name)\n    assert isinstance(result, bool)\n    assert result is False\n    assert result == _spec_expected(name)\n\n\ndef test_is_valid_username_length_exactly_21_returns_true():\n    \"\"\"边界：长度恰为 21 的纯字母数字串，len <= 20 不成立，应返回 True（无效）。\n\n    期望值来源：规约边界情况「长度恰为 21 的纯字母数字串（len <= 20 不成立，返回 True）」\n    \"\"\"\n    name = \"a23456789012345678901\"\n    assert len(name) == 21\n    result = is_valid_username(name)\n    assert isinstance(result, bool)\n    assert result is True\n    assert result == _spec_expected(name)\n\n\ndef test_is_valid_username_overlong_string_returns_true():\n    \"\"\"边界：超长串（1000 字符），len > 20，应返回 True（无效）。\n\n    期望值来源：规约边界情况「超长串（如 1000 字符，len > 20，返回 True）」\n    \"\"\"\n    name = \"a\" * 1000\n    assert len(name) > 20\n    result = is_valid_username(name)\n    assert isinstance(result, bool)\n    assert result is True\n    assert result == _spec_expected(name)\n\n\n# ---------------------------------------------------------------------------\n# 错误 / 非法字符用例\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\n    \"name\",\n    [\n        \"user name\",\n        \"user_name\",\n        \"user-name\",\n        \"user!\",\n    ],\n)\ndef test_is_valid_username_non_alnum_ascii_returns_true(name):\n    \"\"\"错误：含空格/下划线/连字符/标点等非字母数字字符，isalnum 为 False，应返回 True（无效）。\n\n    期望值来源：规约边界情况「含空格、下划线、连字符、标点、中文等非字母数字字符的串\n    （isalnum 为 False，返回 True）」以及后置条件。\n    \"\"\"\n    assert not name.isalnum()\n    result = is_valid_username(name)\n    assert isinstance(result, bool)\n    assert result is True\n    assert result == _spec_expected(name)\n\n\ndef test_is_valid_username_chinese_characters_behavior():\n    \"\"\"探索性用例：含中文字符串 \"用户名\"。\n\n    规约边界情况将「中文」列为「非字母数字字符」，但 Python 中汉字属于 Unicode 字母，\n    str.isalnum() 对 \"用户名\" 返回 True，长度 3 也合规，因此按可执行规约\n    result == (not (bool(name) and name.isalnum() and len(name) <= 20)) 计算期望为 False。\n    规约文字描述与可执行子句在此处存在冲突，期望值来源不明，需人工确认。\n    本用例仅记录实际行为并与可执行规约子句比对，不臆造具体值。\n    \"\"\"\n    name = \"用户名\"\n    result = is_valid_username(name)\n    assert isinstance(result, bool)\n    # 记录实际行为，并与可执行规约子句比对（需人工确认规约文字与子句的一致性）\n    assert result == _spec_expected(name)\n\n\n# ---------------------------------------------------------------------------\n# 后置条件：返回值类型\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\n    \"name\",\n    [\n        \"\",\n        \"alice\",\n        \"user123\",\n        \"12345\",\n        \"a2345678901234567890\",\n        \"a23456789012345678901\",\n        \"a\" * 1000,\n        \"user name\",\n        \"user_name\",\n        \"user-name\",\n        \"user!\",\n    ],\n)\ndef test_is_valid_username_returns_bool_and_matches_spec(name):\n    \"\"\"后置条件：返回值必须为 bool，且等于规约表达式的结果。\n\n    期望值来源：规约后置条件\n      - isinstance(result, bool)\n      - result == (not (bool(name) and name.isalnum() and len(name) <= 20))\n    \"\"\"\n    result = is_valid_username(name)\n    assert isinstance(result, bool)\n    assert result == _spec_expected(name)",
