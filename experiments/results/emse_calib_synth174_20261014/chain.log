          "generated_test": "import pytest\n\nfrom task_0080 import normalize, aggregate, report\n\n\nclass TestNormalize:\n    \"\"\"Tests for the normalize function.\"\"\"\n\n    def test_normalize_empty_list(self):\n        \"\"\"normalize([]) should return an empty list.\"\"\"\n        assert normalize([]) == []\n\n    def test_normalize_single_element(self):\n        \"\"\"normalize([3]) should return [6] (each element doubled).\"\"\"\n        assert normalize([3]) == [6]\n\n    def test_normalize_positive_integers(self):\n        \"\"\"normalize([1, 2, 3]) should return [2, 4, 6].\"\"\"\n        assert normalize([1, 2, 3]) == [2, 4, 6]\n\n    def test_normalize_negative_integers(self):\n        \"\"\"normalize([-1, -2, -3]) should return [-2, -4, -6].\"\"\"\n        assert normalize([-1, -2, -3]) == [-2, -4, -6]\n\n    def test_normalize_mixed_signs(self):\n        \"\"\"normalize([-1, 0, 1]) should return [-2, 0, 2].\"\"\"\n        assert normalize([-1, 0, 1]) == [-2, 0, 2]\n\n    def test_normalize_floats(self):\n        \"\"\"normalize([1.5, 2.5]) should return [3.0, 5.0].\"\"\"\n        assert normalize([1.5, 2.5]) == [3.0, 5.0]\n\n    def test_normalize_does_not_mutate_input(self):\n        \"\"\"normalize should not mutate the input list.\"\"\"\n        data = [1, 2, 3]\n        normalize(data)\n        assert data == [1, 2, 3]\n\n    def test_normalize_returns_new_list(self):\n        \"\"\"normalize should return a new list object, not the input.\"\"\"\n        data = [1, 2, 3]\n        result = normalize(data)\n        assert result is not data\n\n\nclass TestAggregate:\n    \"\"\"Tests for the aggregate function.\"\"\"\n\n    def test_aggregate_empty_list(self):\n        \"\"\"aggregate([]) should return {'count': 0, 'total': 0}.\"\"\"\n        assert aggregate([]) == {\"count\": 0, \"total\": 0}\n\n    def test_aggregate_single_element(self):\n        \"\"\"aggregate([5]) should return {'count': 1, 'total': 5}.\"\"\"\n        assert aggregate([5]) == {\"count\": 1, \"total\": 5}\n\n    def test_aggregate_multiple_elements(self):\n        \"\"\"aggregate([1, 2, 3]) should return {'count': 3, 'total': 6}.\"\"\"\n        assert aggregate([1, 2, 3]) == {\"count\": 3, \"total\": 6}\n\n    def test_aggregate_negative_numbers(self):\n        \"\"\"aggregate([-1, -2, -3]) should return {'count': 3, 'total': -6}.\"\"\"\n        assert aggregate([-1, -2, -3]) == {\"count\": 3, \"total\": -6}\n\n    def test_aggregate_mixed_signs(self):\n        \"\"\"aggregate([-1, 0, 1]) should return {'count': 3, 'total': 0}.\"\"\"\n        assert aggregate([-1, 0, 1]) == {\"count\": 3, \"total\": 0}\n\n    def test_aggregate_returns_dict(self):\n        \"\"\"aggregate should return a dict.\"\"\"\n        assert isinstance(aggregate([1, 2]), dict)\n\n    def test_aggregate_keys(self):\n        \"\"\"aggregate result should contain exactly 'count' and 'total' keys.\"\"\"\n        result = aggregate([1, 2, 3])\n        assert set(result.keys()) == {\"count\", \"total\"}\n\n\nclass TestReport:\n    \"\"\"Tests for the report function.\"\"\"\n\n    def test_report_empty_list(self):\n        \"\"\"report([]) should return 'count=0 total=0'.\"\"\"\n        assert report([]) == \"count=0 total=0\"\n\n    def test_report_single_element(self):\n        \"\"\"report([1]) -> normalize=[2], aggregate={'count':1,'total':2} -> 'count=1 total=2'.\"\"\"\n        assert report([1]) == \"count=1 total=2\"\n\n    def test_report_multiple_elements(self):\n        \"\"\"report([1, 2, 3]) -> normalize=[2,4,6], aggregate={'count':3,'total':12} -> 'count=3 total=12'.\"\"\"\n        assert report([1, 2, 3]) == \"count=3 total=12\"\n\n    def test_report_negative_numbers(self):\n        \"\"\"report([-1, -2]) -> normalize=[-2,-4], aggregate={'count':2,'total':-6} -> 'count=2 total=-6'.\"\"\"\n        assert report([-1, -2]) == \"count=2 total=-6\"\n\n    def test_report_mixed_signs(self):\n        \"\"\"report([-1, 0, 1]) -> normalize=[-2,0,2], aggregate={'count':3,'total':0} -> 'count=3 total=0'.\"\"\"\n        assert report([-1, 0, 1]) == \"count=3 total=0\"\n\n    def test_report_returns_str(self):\n        \"\"\"report should return a string.\"\"\"\n        assert isinstance(report([1, 2, 3]), str)\n\n    def test_report_does_not_mutate_input(self):\n        \"\"\"report should not mutate the input list.\"\"\"\n        data = [1, 2, 3]\n        report(data)\n        assert data == [1, 2, 3]",
