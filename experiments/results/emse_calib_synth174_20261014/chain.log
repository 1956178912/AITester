          "generated_test": "import pytest\n\nfrom task_0072 import add_item\nimport task_0072\n\n\n@pytest.fixture(autouse=True)\ndef clean_stock():\n    \"\"\"每个测试前后清理模块级 _STOCK，避免测试间相互污染。\"\"\"\n    original = dict(task_0072._STOCK)\n    task_0072._STOCK.clear()\n    yield\n    task_0072._STOCK.clear()\n    task_0072._STOCK.update(original)\n\n\ndef test_add_item_normal_positive_qty():\n    \"\"\"正常写入正整数库存：_STOCK[sku] == qty 且返回 None。\n\n    期望值来源：规约后置条件 _STOCK[sku] == qty、result is None。\n    \"\"\"\n    result = add_item(1, 10)\n    assert result is None\n    assert task_0072._STOCK[1] == 10\n\n\ndef test_add_item_boundary_qty_zero():\n    \"\"\"qty == 0 边界：库存清零仍写入 0，返回 None。\n\n    期望值来源：规约边界情况 qty == 0 与后置条件。\n    \"\"\"\n    result = add_item(2, 0)\n    assert result is None\n    assert task_0072._STOCK[2] == 0\n\n\ndef test_add_item_boundary_negative_qty():\n    \"\"\"qty < 0 边界：负库存被原样写入（代码未校验），返回 None。\n\n    期望值来源：规约边界情况 qty < 0 与后置条件。\n    \"\"\"\n    result = add_item(3, -5)\n    assert result is None\n    assert task_0072._STOCK[3] == -5\n\n\ndef test_add_item_boundary_sku_zero():\n    \"\"\"sku == 0 边界：被接受并写入，返回 None。\n\n    期望值来源：规约边界情况 sku == 0 与后置条件。\n    \"\"\"\n    result = add_item(0, 7)\n    assert result is None\n    assert task_0072._STOCK[0] == 7\n\n\ndef test_add_item_boundary_negative_sku():\n    \"\"\"sku < 0 边界：非法 SKU 未校验，被接受并写入，返回 None。\n\n    期望值来源：规约边界情况 sku < 0 与后置条件。\n    \"\"\"\n    result = add_item(-1, 4)\n    assert result is None\n    assert task_0072._STOCK[-1] == 4\n\n\ndef test_add_item_overwrite_same_sku():\n    \"\"\"同一 sku 重复调用：覆盖旧值，最终 _STOCK[sku] == 最新 qty。\n\n    期望值来源：规约边界情况「同一 sku 重复调用（覆盖旧值）」与后置条件。\n    \"\"\"\n    assert add_item(1, 10) is None\n    assert task_0072._STOCK[1] == 10\n    assert add_item(1, 99) is None\n    assert task_0072._STOCK[1] == 99\n\n\ndef test_add_item_boundary_huge_qty():\n    \"\"\"qty 为极大整数：Python 任意精度，无溢出限制，原样写入。\n\n    期望值来源：规约边界情况「qty 为极大整数（无溢出限制）」与后置条件。\n    \"\"\"\n    huge = 10 ** 100\n    result = add_item(5, huge)\n    assert result is None\n    assert task_0072._STOCK[5] == huge\n\n\ndef test_add_item_non_int_sku_records_actual_behavior():\n    \"\"\"非 int 类型入参（违背前置条件）：记录实际行为，不臆造异常。\n\n    期望值来源不明，需人工确认：规约仅声明前置条件为 isinstance(sku, int)，\n    未规定违背前件时的行为（是否抛异常、是否仍写入）。此处仅断言\n    「要么抛出异常，要么按字典键写入」这一弱性质，避免恒失败/恒真。\n    \"\"\"\n    try:\n        result = add_item(\"abc\", 1)\n    except Exception:\n        # 实现选择抛异常也是可接受的行为，规约未禁止\n        return\n    assert result is None\n    assert task_0072._STOCK[\"abc\"] == 1",
