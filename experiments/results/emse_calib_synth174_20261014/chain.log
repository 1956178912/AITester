          "generated_test": "import pytest\n\nfrom task_0023 import initials\n\n\n# ---------------------------------------------------------------------------\n# 正常路径\n# ---------------------------------------------------------------------------\n\ndef test_initials_two_word_name():\n    \"\"\"规约：按空白切分取每部分首字母大写并以点连接。期望值来源：测试计划。\"\"\"\n    assert initials(\"john doe\") == \"J.D\"\n\n\ndef test_initials_three_word_name():\n    \"\"\"规约：多词姓名逐词取首字母。期望值来源：测试计划。\"\"\"\n    assert initials(\"john ronald reuel tolkien\") == \"J.R.R.T\"\n\n\ndef test_initials_single_word():\n    \"\"\"规约：单个词时无点号。期望值来源：测试计划。\"\"\"\n    assert initials(\"madonna\") == \"M\"\n\n\ndef test_initials_already_uppercase():\n    \"\"\"规约：已大写首字母仍正确（upper 幂等）。期望值来源：测试计划。\"\"\"\n    assert initials(\"John Doe\") == \"J.D\"\n\n\ndef test_initials_lowercase_first_char():\n    \"\"\"规约：首字符为小写字母时应被大写。期望值来源：测试计划。\"\"\"\n    assert initials(\"alice bob\") == \"A.B\"\n\n\n# ---------------------------------------------------------------------------\n# 边界路径\n# ---------------------------------------------------------------------------\n\ndef test_initials_empty_string_returns_empty():\n    \"\"\"规约后置：空串返回 ''。期望值来源：规约。\"\"\"\n    result = initials(\"\")\n    assert result == \"\"\n    assert isinstance(result, str)\n\n\ndef test_initials_whitespace_only_returns_empty():\n    \"\"\"规约后置：纯空白返回 ''。期望值来源：规约。\"\"\"\n    result = initials(\"   \")\n    assert result == \"\"\n    assert isinstance(result, str)\n\n\ndef test_initials_multiple_consecutive_spaces():\n    \"\"\"规约：split 默认按任意空白切分，连续空格不产生空词。期望值来源：测试计划。\"\"\"\n    assert initials(\"john    doe\") == \"J.D\"\n\n\ndef test_initials_tabs_and_newlines():\n    \"\"\"规约：\\\\t 与 \\\\n 同样作为空白切分。期望值来源：测试计划。\"\"\"\n    assert initials(\"john\\tdoe\\nsmith\") == \"J.D.S\"\n\n\ndef test_initials_leading_trailing_whitespace():\n    \"\"\"规约：首尾空白被 split 忽略。期望值来源：测试计划。\"\"\"\n    assert initials(\"  john doe  \") == \"J.D\"\n\n\ndef test_initials_unicode_characters():\n    \"\"\"规约：Unicode 输入（重音字母）首字母大写。期望值来源：测试计划。\"\"\"\n    assert initials(\"josé garcía\") == \"J.G\"\n\n\ndef test_initials_unicode_chinese():\n    \"\"\"规约：Unicode 中文输入，取每词首字符。期望值来源：规约（首字符大写形式）。\"\"\"\n    result = initials(\"张 三\")\n    assert isinstance(result, str)\n    # 中文无大小写概念，upper 后不变；期望值来源：规约，需人工确认\n    assert result == \"张.三\"\n\n\ndef test_initials_word_starting_with_digit():\n    \"\"\"规约：含数字开头的词，取首字符。期望值来源：规约（首字符大写形式）。\"\"\"\n    result = initials(\"1st place\")\n    assert isinstance(result, str)\n    assert result == \"1.P\"\n\n\ndef test_initials_word_starting_with_symbol():\n    \"\"\"规约：含符号开头的词，取首字符。期望值来源：规约（首字符大写形式）。\"\"\"\n    result = initials(\"@home user\")\n    assert isinstance(result, str)\n    assert result == \"@.U\"\n\n\n# ---------------------------------------------------------------------------\n# 后置条件（不依赖具体期望值）\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\n    \"full_name\",\n    [\n        \"john doe\",\n        \"madonna\",\n        \"John Doe\",\n        \"  john doe  \",\n        \"john    doe\",\n        \"john\\tdoe\\nsmith\",\n        \"josé garcía\",\n        \"张 三\",\n        \"1st place\",\n        \"@home user\",\n    ],\n)\ndef test_initials_returns_str_type(full_name):\n    \"\"\"规约后置：返回值必须为 str 类型。\"\"\"\n    result = initials(full_name)\n    assert isinstance(result, str)\n\n\n@pytest.mark.parametrize(\n    \"full_name\",\n    [\n        \"john doe\",\n        \"madonna\",\n        \"John Doe\",\n        \"  john doe  \",\n        \"john    doe\",\n        \"john\\tdoe\\nsmith\",\n    ],\n)\ndef test_initials_result_contains_no_whitespace(full_name):\n    \"\"\"规约后置：返回值中不含空白字符（split 已去除空白）。\"\"\"\n    result = initials(full_name)\n    assert not any(ch.isspace() for ch in result)\n\n\n# ---------------------------------------------------------------------------\n# 异常路径\n# ---------------------------------------------------------------------------\n\ndef test_initials_none_raises_attribute_error():\n    \"\"\"规约边界：None 触发 AttributeError（None 无 split 方法）。\"\"\"\n    with pytest.raises(AttributeError):\n        initials(None)\n\n\ndef test_initials_non_string_int_raises_attribute_error():\n    \"\"\"规约边界：非 str 类型（int）触发 AttributeError（int 无 split 方法）。\"\"\"\n    with pytest.raises(AttributeError):\n        initials(123)",
