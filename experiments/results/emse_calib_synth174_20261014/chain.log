          "generated_test": "import pytest\n\nfrom task_0084 import distance\n\n\n# ---------------------------------------------------------------------------\n# 常规用例\n# ---------------------------------------------------------------------------\n\ndef test_distance_positive_ints():\n    \"\"\"规约后置条件：返回值等于 a - b（常规正整数相减）。\"\"\"\n    assert distance(5, 3) == 2\n\n\ndef test_distance_positive_result_negative():\n    \"\"\"规约后置条件：返回值等于 a - b（被减数小于减数，结果为负）。\"\"\"\n    assert distance(3, 5) == -2\n\n\n# ---------------------------------------------------------------------------\n# 边界用例\n# ---------------------------------------------------------------------------\n\ndef test_distance_equal_operands_returns_zero():\n    \"\"\"边界情况：a == b 时结果为 0。\"\"\"\n    assert distance(7, 7) == 0\n\n\ndef test_distance_a_is_zero():\n    \"\"\"边界情况：a 为 0，返回值等于 0 - b。\"\"\"\n    assert distance(0, 4) == -4\n\n\ndef test_distance_b_is_zero():\n    \"\"\"边界情况：b 为 0，返回值等于 a。\"\"\"\n    assert distance(4, 0) == 4\n\n\ndef test_distance_a_negative():\n    \"\"\"边界情况：a 为负数，返回值等于 a - b。\"\"\"\n    assert distance(-5, 3) == -8\n\n\ndef test_distance_b_negative():\n    \"\"\"边界情况：b 为负数，a - b 等价于 a + |b|。\"\"\"\n    assert distance(5, -3) == 8\n\n\ndef test_distance_both_negative():\n    \"\"\"边界情况：a、b 均为负数，返回值等于 a - b。\"\"\"\n    assert distance(-5, -3) == -2\n\n\ndef test_distance_large_integers():\n    \"\"\"边界情况：极大整数相减，Python 大整数无溢出。\"\"\"\n    a = 1000000000000000000000000000000\n    b = 1\n    assert distance(a, b) == a - b\n\n\ndef test_distance_small_integers():\n    \"\"\"边界情况：极小整数（大负整数）相减。\"\"\"\n    a = -1000000000000000000000000000000\n    b = 1\n    assert distance(a, b) == a - b\n\n\n# ---------------------------------------------------------------------------\n# 后置条件：返回值类型与 a - b 的运算结果类型一致\n# ---------------------------------------------------------------------------\n\ndef test_distance_return_type_matches_operands():\n    \"\"\"规约后置条件：返回值类型与 a - b 的运算结果类型一致（int）。\"\"\"\n    result = distance(10, 4)\n    assert isinstance(result, int)\n    assert type(result) is type(10 - 4)\n\n\n# ---------------------------------------------------------------------------\n# 异常路径\n# ---------------------------------------------------------------------------\n\ndef test_distance_int_and_str_raises_type_error():\n    \"\"\"边界情况：int 与 str 相减触发 TypeError。\n\n    期望值来源：规约明确声明该情形导致 TypeError（异常类型由 Python\n    运行时决定，此处按规约断言 TypeError）。\n    \"\"\"\n    with pytest.raises(TypeError):\n        distance(5, \"3\")\n\n\ndef test_distance_none_operand_raises_type_error():\n    \"\"\"边界情况：传入不支持减法运算的对象（None）触发 TypeError。\n\n    期望值来源：规约明确声明该情形导致 TypeError。\n    \"\"\"\n    with pytest.raises(TypeError):\n        distance(None, 1)",
