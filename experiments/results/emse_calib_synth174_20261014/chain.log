          "generated_test": "import pytest\n\nfrom task_0015 import split_words\n\n\ndef test_split_words_basic_single_space():\n    \"\"\"基本用例：以单个空格分隔的字符串应被拆分为单词列表。\n\n    期望值来源：函数实现 text.split(\" \")，docstring 未提供额外约定。\n    \"\"\"\n    result = split_words(\"hello world\")\n    assert result == [\"hello\", \"world\"]\n\n\ndef test_split_words_no_space_returns_single_element():\n    \"\"\"无空格字符串应返回仅含该字符串的单元素列表。\n\n    期望值来源：str.split(\" \") 的语义。\n    \"\"\"\n    result = split_words(\"hello\")\n    assert result == [\"hello\"]\n\n\ndef test_split_words_empty_string():\n    \"\"\"空字符串按 str.split(\" \") 语义应返回 ['']。\n\n    期望值来源：str.split(\" \") 的语义（与 str.split() 不同）。\n    \"\"\"\n    result = split_words(\"\")\n    assert result == [\"\"]\n\n\ndef test_split_words_leading_space_produces_empty_first_element():\n    \"\"\"前导空格会产生一个空字符串元素。\n\n    期望值来源：str.split(\" \") 的语义。\n    \"\"\"\n    result = split_words(\" hello\")\n    assert result == [\"\", \"hello\"]\n\n\ndef test_split_words_trailing_space_produces_empty_last_element():\n    \"\"\"尾随空格会产生一个空字符串元素。\n\n    期望值来源：str.split(\" \") 的语义。\n    \"\"\"\n    result = split_words(\"hello \")\n    assert result == [\"hello\", \"\"]\n\n\ndef test_split_words_multiple_consecutive_spaces():\n    \"\"\"连续多个空格会产生对应的空字符串元素。\n\n    期望值来源：str.split(\" \") 的语义。\n    \"\"\"\n    result = split_words(\"a  b\")\n    assert result == [\"a\", \"\", \"b\"]\n\n\ndef test_split_words_only_spaces():\n    \"\"\"仅由空格组成的字符串应返回相应数量的空字符串元素。\n\n    期望值来源：str.split(\" \") 的语义。\n    \"\"\"\n    result = split_words(\"   \")\n    assert result == [\"\", \"\", \"\", \"\"]\n\n\ndef test_split_words_tabs_and_newlines_are_not_separators():\n    \"\"\"制表符与换行符不是分隔符，应保留在元素中。\n\n    期望值来源：str.split(\" \") 仅以空格为分隔符。\n    \"\"\"\n    result = split_words(\"a\\tb\\nc\")\n    assert result == [\"a\\tb\\nc\"]\n\n\ndef test_split_words_returns_list_type():\n    \"\"\"返回值类型应为 list。\n\n    期望值来源：函数类型注解 -> list。\n    \"\"\"\n    result = split_words(\"a b c\")\n    assert isinstance(result, list)\n\n\ndef test_split_words_non_string_input_raises():\n    \"\"\"非字符串输入应抛出异常（str.split 不可用）。\n\n    期望值来源：类型注解要求 str；具体异常类型未在 docstring 中约定，\n    此处仅断言抛出异常，不臆造具体异常类型。\n    \"\"\"\n    with pytest.raises(Exception):\n        split_words(123)\n\n\ndef test_split_words_none_input_raises():\n    \"\"\"None 输入应抛出异常。\n\n    期望值来源：类型注解要求 str；具体异常类型未在 docstring 中约定，\n    此处仅断言抛出异常，不臆造具体异常类型。\n    \"\"\"\n    with pytest.raises(Exception):\n        split_words(None)",
