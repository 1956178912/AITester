          "generated_test": "import pytest\n\nfrom task_0079 import process\n\n\ndef test_process_returns_list():\n    \"\"\"process 应返回 list 类型。\n\n    期望值来源：函数签名返回注解 `-> list`。\n    \"\"\"\n    result = process([1, 2, 3])\n    assert isinstance(result, list)\n\n\ndef test_process_appends_zero_at_end():\n    \"\"\"process 结果最后一项应为 0。\n\n    期望值来源：函数体 `+ [0]`，末尾固定追加 0。\n    \"\"\"\n    result = process([1, 2, 3])\n    assert result[-1] == 0\n\n\ndef test_process_increments_each_element_by_one():\n    \"\"\"process 应将每个输入元素加 1 后置于结果前部。\n\n    期望值来源：函数体 `[x + 1 for x in items]`。\n    \"\"\"\n    result = process([1, 2, 3])\n    assert result[:-1] == [2, 3, 4]\n\n\ndef test_process_output_length_is_input_length_plus_one():\n    \"\"\"process 输出长度应为输入长度加 1。\n\n    期望值来源：函数体对每个元素加 1 后追加一个 0。\n    \"\"\"\n    items = [10, 20, 30, 40]\n    result = process(items)\n    assert len(result) == len(items) + 1\n\n\ndef test_process_empty_input_returns_single_zero():\n    \"\"\"空输入时 process 应返回仅含一个 0 的列表。\n\n    期望值来源：列表推导对空列表返回空，再追加 [0]。\n    \"\"\"\n    result = process([])\n    assert result == [0]\n\n\ndef test_process_single_element():\n    \"\"\"单元素输入时 process 应返回 [x+1, 0]。\n\n    期望值来源：函数体逻辑。\n    \"\"\"\n    result = process([5])\n    assert result == [6, 0]\n\n\ndef test_process_negative_numbers():\n    \"\"\"负数输入时 process 应正确加 1。\n\n    期望值来源：函数体 `x + 1` 对负数同样适用。\n    \"\"\"\n    result = process([-1, -2, -3])\n    assert result == [0, -1, -2, 0]\n\n\ndef test_process_float_elements():\n    \"\"\"浮点输入时 process 应正确加 1。\n\n    期望值来源：函数体 `x + 1` 对浮点数同样适用。\n    \"\"\"\n    result = process([1.5, 2.5])\n    assert result == [2.5, 3.5, 0]\n\n\ndef test_process_does_not_mutate_input():\n    \"\"\"process 不应修改传入的原始列表。\n\n    期望值来源：函数体使用列表推导创建新列表，未原地修改。\n    \"\"\"\n    items = [1, 2, 3]\n    original = list(items)\n    process(items)\n    assert items == original\n\n\ndef test_process_returns_new_list_object():\n    \"\"\"process 应返回新的列表对象，而非输入本身。\n\n    期望值来源：函数体构造新列表返回。\n    \"\"\"\n    items = [1, 2, 3]\n    result = process(items)\n    assert result is not items\n\n\ndef test_process_string_elements_raises_type_error():\n    \"\"\"字符串元素与 1 相加应抛出 TypeError。\n\n    期望值来源：Python 中 str + int 会抛 TypeError。\n    \"\"\"\n    with pytest.raises(TypeError):\n        process([\"a\", \"b\"])\n\n\ndef test_process_none_input_raises_type_error():\n    \"\"\"None 作为输入应抛出 TypeError。\n\n    期望值来源：None 不可迭代。\n    \"\"\"\n    with pytest.raises(TypeError):\n        process(None)\n\n\ndef test_process_non_iterable_input_raises_type_error():\n    \"\"\"非可迭代输入（如 int）应抛出 TypeError。\n\n    期望值来源：int 不可迭代。\n    \"\"\"\n    with pytest.raises(TypeError):\n        process(123)\n\n\n@pytest.mark.parametrize(\n    \"items, expected\",\n    [\n        ([0], [1, 0]),\n        ([1, 1, 1], [2, 2, 2, 0]),\n        ([-10, 0, 10], [-9, 1, 11, 0]),\n        ([100], [101, 0]),\n    ],\n)\ndef test_process_parametrized_cases(items, expected):\n    \"\"\"参数化验证 process 在多种输入下的输出。\n\n    期望值来源：函数体 `[x + 1 for x in items] + [0]`。\n    \"\"\"\n    assert process(items) == expected",
