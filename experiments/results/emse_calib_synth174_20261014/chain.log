          "generated_test": "import pytest\n\nfrom task_0062 import report\n\n\n# ---------------------------------------------------------------------------\n# 正常路径\n# ---------------------------------------------------------------------------\n\ndef test_report_normal_typical_list():\n    \"\"\"常规正整数列表：count=len(data)，total=sum(data)*2。\n\n    期望值来源：规约后置条件 count==len(data)、total==sum(data)*2。\n    \"\"\"\n    data = [1, 2, 3]\n    result = report(data)\n    assert result == \"count=3 total=12\"\n\n\ndef test_report_normal_single_element():\n    \"\"\"单元素列表：最小非空输入路径。\n\n    期望值来源：规约后置条件 count==len(data)、total==sum(data)*2。\n    \"\"\"\n    data = [5]\n    result = report(data)\n    assert result == \"count=1 total=10\"\n\n\ndef test_report_normal_negative_values():\n    \"\"\"含负数元素：翻倍与求和需正确处理符号。\n\n    期望值来源：规约后置条件 count==len(data)、total==sum(data)*2。\n    \"\"\"\n    data = [-1, -2, -3]\n    result = report(data)\n    assert result == \"count=3 total=-12\"\n\n\ndef test_report_normal_float_values():\n    \"\"\"含浮点数元素：数值类型兼容。\n\n    期望值来源：规约后置条件 total==sum(data)*2，sum([1.5,2.5])*2==8.0。\n    \"\"\"\n    data = [1.5, 2.5]\n    result = report(data)\n    assert result == \"count=2 total=8.0\"\n\n\n# ---------------------------------------------------------------------------\n# 边界路径\n# ---------------------------------------------------------------------------\n\ndef test_report_boundary_empty_list():\n    \"\"\"空列表：规约明确约定返回 'count=0 total=0'。\n\n    期望值来源：规约边界情况 data=[] → 'count=0 total=0'。\n    \"\"\"\n    data = []\n    result = report(data)\n    assert result == \"count=0 total=0\"\n\n\ndef test_report_boundary_zero_element():\n    \"\"\"含 0 元素：0 不应被误判为空，翻倍后仍为 0。\n\n    期望值来源：规约后置条件 count==len(data)、total==sum(data)*2。\n    \"\"\"\n    data = [0]\n    result = report(data)\n    assert result == \"count=1 total=0\"\n\n\ndef test_report_boundary_large_list():\n    \"\"\"较大数值：观察乘法与求和的溢出/精度边界。\n\n    期望值来源：规约后置条件 count==len(data)、total==sum(data)*2。\n    \"\"\"\n    data = [1000000, 2000000, 3000000]\n    result = report(data)\n    assert result == \"count=3 total=12000000\"\n\n\n# ---------------------------------------------------------------------------\n# 后置条件（可执行规约）通用校验\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\n    \"data\",\n    [\n        [1, 2, 3],\n        [5],\n        [-1, -2, -3],\n        [1.5, 2.5],\n        [],\n        [0],\n        [1000000, 2000000, 3000000],\n    ],\n)\ndef test_report_postconditions_startswith_and_contains(data):\n    \"\"\"可执行规约后置条件：返回值以 'count=' 开头且包含 ' total=' 子串。\n\n    期望值来源：SpecExpr 后置子句 result.startswith(\"count=\")、\" total=\" in result。\n    \"\"\"\n    result = report(data)\n    assert result.startswith(\"count=\")\n    assert \" total=\" in result\n\n\n@pytest.mark.parametrize(\n    \"data\",\n    [\n        [1, 2, 3],\n        [5],\n        [-1, -2, -3],\n        [1.5, 2.5],\n        [],\n        [0],\n        [1000000, 2000000, 3000000],\n    ],\n)\ndef test_report_postconditions_count_and_total(data):\n    \"\"\"可执行规约后置条件：count==len(data) 且 total==sum(data)*2。\n\n    期望值来源：规约后置条件 count 值等于 len(data)、total 值等于 sum(data)*2。\n    \"\"\"\n    result = report(data)\n    expected_count = len(data)\n    expected_total = sum(data) * 2\n    assert result == f\"count={expected_count} total={expected_total}\"\n\n\n# ---------------------------------------------------------------------------\n# 异常路径（输入不满足前置条件）\n# ---------------------------------------------------------------------------\n\ndef test_report_error_non_numeric_element():\n    \"\"\"字符串元素不满足前置条件（元素需支持与 2 相乘并参与 sum 累加）。\n\n    期望值来源：规约未约定异常类型与消息，仅断言抛出异常，需人工确认。\n    \"\"\"\n    data = [\"a\", \"b\"]\n    with pytest.raises(Exception):\n        report(data)\n\n\ndef test_report_error_none_input():\n    \"\"\"None 不满足前置条件（data 需为可迭代对象）。\n\n    期望值来源：规约未约定异常类型与消息，仅断言抛出异常，需人工确认。\n    \"\"\"\n    data = None\n    with pytest.raises(Exception):\n        report(data)\n\n\ndef test_report_error_mixed_types():\n    \"\"\"混合类型元素不满足前置条件（元素需支持 sum 累加）。\n\n    期望值来源：规约未约定异常类型与消息，仅断言抛出异常，需人工确认。\n    \"\"\"\n    data = [1, \"a\"]\n    with pytest.raises(Exception):\n        report(data)",
