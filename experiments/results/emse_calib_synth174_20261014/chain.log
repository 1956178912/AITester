ssert all(isinstance(item, str) for item in result)\n    assert \" \".join(result) == \"\"\n    assert len(result) == \"\".count(\" \") + 1\n    assert len(result) >= 1\n\n\ndef test_split_words_boundary_single_space():\n    \"\"\"单个空格：' ' -> ['', '']。\n\n    期望值来源：规约边界情况。\n    \"\"\"\n    result = split_words(\" \")\n    assert result == [\"\", \"\"]\n    assert isinstance(result, list)\n    assert all(isinstance(item, str) for item in result)\n    assert \" \".join(result) == \" \"\n    assert len(result) == \" \".count(\" \") + 1\n\n\ndef test_split_words_boundary_consecutive_spaces():\n    \"\"\"连续空格：'a  b' -> ['a', '', 'b']（保留空串，不合并）。\n\n    期望值来源：规约边界情况。\n    \"\"\"\n    result = split_words(\"a  b\")\n    assert result == [\"a\", \"\", \"b\"]\n    assert isinstance(result, list)\n    assert all(isinstance(item, str) for item in result)\n    assert \" \".join(result) == \"a  b\"\n    assert len(result) == \"a  b\".count(\" \") + 1\n\n\ndef test_split_words_boundary_leading_trailing_spaces():\n    \"\"\"首尾空格：' a ' -> ['', 'a', '']。\n\n    期望值来源：规约边界情况。\n    \"\"\"\n    result = split_words(\" a \")\n    assert result == [\"\", \"a\", \"\"]\n    assert isinstance(result, list)\n    assert all(isinstance(item, str) for item in result)\n    assert \" \".join(result) == \" a \"\n    assert len(result) == \" a \".count(\" \") + 1\n\n\ndef test_split_words_boundary_non_space_whitespace():\n    \"\"\"仅含制表符/换行：'a\\\\tb\\\\n' -> ['a\\\\tb\\\\n']（不按空白切分）。\n\n    期望值来源：规约边界情况（split(\" \") 与 split() 的差异）。\n    \"\"\"\n    text = \"a\\tb\\n\"\n    result = split_words(text)\n    assert result == [\"a\\tb\\n\"]\n    assert isinstance(result, list)\n    assert all(isinstance(item, str) for item in result)\n    assert \" \".join(result) == text\n    assert len(result) == text.count(\" \") + 1\n\n\n# ---------------------------------------------------------------------------\n# 后置条件 / 不变量（参数化，覆盖多种合法输入）\n# -------------------------------------------------------------------------