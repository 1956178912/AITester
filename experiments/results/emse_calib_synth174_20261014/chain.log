ef test_best_score_empty_list_raises():\n    \"\"\"空列表违反前置条件 len(scores) > 0，应触发 IndexError。\"\"\"\n    with pytest.raises(IndexError):\n        best_score([])\n\n\n@pytest.mark.parametrize(\n    \"scores\",\n    [\n        [5],\n        [1, 2, 3, 4, 5],\n        [5, 4, 3, 2, 1],\n        [-3, -1, -7],\n        [4, 4, 4],\n        [0, -5, 3],\n        [-(10 ** 18), 0, 10 ** 18],\n    ],\n)\ndef test_best_score_postconditions(scores):\n    \"\"\"对多组输入验证后置条件：结果属于 scores 且不小于任意元素。\"\"\"\n    result = best_score(scores)\n    assert result in scores\n    assert all(result >= s for s in scores)\n\n\n# ---------------------------------------------------------------------------\n# worst_score\n# ---------------------------------------------------------------------------\n\ndef test_worst_score_single_element():\n    \"\"\"单元素列表：循环体不执行，直接返回首元素。期望值来源：规约边界情况。\"\"\"\n    scores = [5]\n    result = worst_score(scores)\n    assert result == 5\n    assert result in scores\n    assert all(result <= s for s in scores)\n\n\ndef test_worst_score_ascending():\n    \"\"\"升序列表：最小值应为首元素。期望值来源：规约后置条件。\"\"\"\n    scores = [1, 2, 3, 4, 5]\n    result = worst_score(scores)\n    assert result == 1\n    assert result in scores\n    assert all(result <= s for s in scores)\n\n\ndef test_worst_score_descending():\n    \"\"\"降序列表：最小值应为末元素。期望值来源：规约后置条件。\"\"\"\n    scores = [5, 4, 3, 2, 1]\n    result = worst_score(scores)\n    assert result == 1\n    assert result in scores\n    assert all(result <= s for s in scores)\n\n\ndef test_worst_score_with_negatives():\n    \"\"\"含负数集合：最小值为 -7。期望值来源：规约后置条件。\"\"\"\n    scores = [-3, -1, -7]\n    result = worst_score(scores)\n    assert result == -7\n    assert result in scores\n    assert all(result <= s for s in scores)\n\n\ndef test_worst_score_all_equal():\n    \"\"\"全部元素相等：返回该值。期望值来源：规约边界情况。\"\"\"\n    scores = [4, 4, 4]\n    result = worst_score(scores)\n    assert result == 4\n    assert result in scores\n    assert all(result <= s for s in scores)\n\n\ndef test_worst_score_with_zero():\n    \"\"\"含 0 的混合集合：最小值为 -5。期望值来源：规约后置条件。\"\"\"\n    scores = [0, -5, 3]\n    result = worst_score(scores)\n    assert result == -5\n    assert result in scores\n    assert all(result <= s for s in scores)\n\n\ndef test_worst_score_extreme_values():\n    \"\"\"含极大/极小值：最小值应为极小值。期望值来源：规约后置条件。\"\"\"\n    scores = [-(10 ** 18), 0, 10 ** 18]\n    result = worst_score(scores)\n    assert result == -(10 ** 18)\n    assert result in scores\n    assert all(result <= s for s in scores)\n\n\ndef test_worst_score_empty_list_raises():\n    \"\"\"空列表违反前置条件 len(scores) > 0，应触发 IndexError。\"\"\"\n    with pytest.raises(IndexError):\n        worst_score([])\n\n\n@pytest.mark.parametrize(\n    \"scores\",\n    [\n        [5],\n        [1, 2, 3, 4, 5],\n        [5, 4, 3, 2, 1],\n        [-3, -1, -7],\n        [4, 4, 4],\n        [0, -5, 3],\n        [-(10 ** 18), 0, 10 ** 18],\n    ],\n)\ndef test_worst_score_postconditions(scores):\n    \"\"\"对多组输入验证后置条件：结果属于 scores 且不大于任意元素。\"\"\"\n    result = worst_score(scores)\n    assert result in scores\n    assert all(result <= s for s in scores)",
