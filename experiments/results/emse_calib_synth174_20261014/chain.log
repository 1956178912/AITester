          "generated_test": "import datetime\n\nimport pytest\n\nfrom task_0046 import days_until\n\n\ndef _today_str() -> str:\n    return datetime.datetime.now().strftime(\"%Y-%m-%d\")\n\n\ndef _tomorrow_str() -> str:\n    return (datetime.datetime.now() + datetime.timedelta(days=1)).strftime(\"%Y-%m-%d\")\n\n\ndef _yesterday_str() -> str:\n    return (datetime.datetime.now() - datetime.timedelta(days=1)).strftime(\"%Y-%m-%d\")\n\n\ndef test_days_until_returns_int_for_valid_date():\n    \"\"\"后置条件：合法日期时返回值为 int。\"\"\"\n    result = days_until(\"2024-01-01\")\n    assert isinstance(result, int)\n\n\ndef test_days_until_tomorrow_is_zero_or_one():\n    \"\"\"边界：明天日期差值应为 1 或 0（取决于当前时刻）。\"\"\"\n    result = days_until(_tomorrow_str())\n    assert result in (0, 1)\n\n\ndef test_days_until_yesterday_is_minus_one_or_minus_two():\n    \"\"\"边界：昨天日期差值应为 -1 或 -2（取决于当前时刻）。\"\"\"\n    result = days_until(_yesterday_str())\n    assert result in (-1, -2)\n\n\ndef test_days_until_today_is_zero_or_minus_one():\n    \"\"\"边界：今天日期差值应为 0 或 -1（取决于当前时刻）。\"\"\"\n    result = days_until(_today_str())\n    assert result in (0, -1)\n\n\ndef test_days_until_valid_date_matches_parsed_delta():\n    \"\"\"后置条件：合法日期时返回值等于 (解析日期 - now).days。\"\"\"\n    target = \"2024-06-15\"\n    parsed = datetime.datetime.strptime(target, \"%Y-%m-%d\")\n    now = datetime.datetime.now()\n    expected = (parsed - now).days\n    result = days_until(target)\n    # 允许因 now 在两次调用间跨天导致的 1 天误差\n    assert abs(result - expected) <= 1\n\n\ndef test_days_until_invalid_slash_format_returns_min_delta():\n    \"\"\"异常路径：非法格式 \"2024/01/01\" 触发 ValueError 分支，返回基于 datetime.min 的差值。\"\"\"\n    now = datetime.datetime.now()\n    expected = (datetime.datetime.min - now).days\n    result = days_until(\"2024/01/01\")\n    assert abs(result - expected) <= 1\n\n\ndef test_days_until_empty_string_returns_min_delta():\n    \"\"\"异常路径：空字符串触发 ValueError 分支，返回基于 datetime.min 的差值。\"\"\"\n    now = datetime.datetime.now()\n    expected = (datetime.datetime.min - now).days\n    result = days_until(\"\")\n    assert abs(result - expected) <= 1\n\n\ndef test_days_until_non_date_string_returns_min_delta():\n    \"\"\"异常路径：非日期字符串 \"abc\" 触发 ValueError 分支，返回基于 datetime.min 的差值。\"\"\"\n    now = datetime.datetime.now()\n    expected = (datetime.datetime.min - now).days\n    result = days_until(\"abc\")\n    assert abs(result - expected) <= 1\n\n\ndef test_days_until_none_raises_type_error():\n    \"\"\"边界：None 使 strptime 抛 TypeError，未被 except ValueError 捕获，函数应向上抛出异常。\n\n    期望值来源：规约明确说明 None 会抛 TypeError 且未被捕获。\n    \"\"\"\n    with pytest.raises(TypeError):\n        days_until(None)\n\n\ndef test_days_until_earliest_date_returns_large_negative():\n    \"\"\"边界：极早日期 \"0001-01-01\"，返回极大负数，等于 (datetime(1,1,1) - now).days。\"\"\"\n    now = datetime.datetime.now()\n    expected = (datetime.datetime(1, 1, 1) - now).days\n    result = days_until(\"0001-01-01\")\n    assert abs(result - expected) <= 1\n    assert result < 0\n\n\ndef test_days_until_latest_date_returns_large_positive():\n    \"\"\"边界：极晚日期 \"9999-12-31\"，返回极大正数，等于 (datetime(9999,12,31) - now).days。\"\"\"\n    now = datetime.datetime.now()\n    expected = (datetime.datetime(9999, 12, 31) - now).days\n    result = days_until(\"9999-12-31\")\n    assert abs(result - expected) <= 1\n    assert result > 0\n\n\ndef test_days_until_cross_year_boundary():\n    \"\"\"边界：跨年边界，验证合法日期解析与差值计算一致。\"\"\"\n    target = \"2025-01-01\"\n    parsed = datetime.datetime.strptime(target, \"%Y-%m-%d\")\n    now = datetime.datetime.now()\n    expected = (parsed - now).days\n    result = days_until(target)\n    assert abs(result - expected) <= 1\n\n\ndef test_days_until_cross_month_boundary():\n    \"\"\"边界：跨月边界，验证合法日期解析与差值计算一致。\"\"\"\n    target = \"2024-03-01\"\n    parsed = datetime.datetime.strptime(target, \"%Y-%m-%d\")\n    now = datetime.datetime.now()\n    expected = (parsed - now).days\n    result = days_until(target)\n    assert abs(result - expected) <= 1",
