          "generated_test": "import pytest\n\nfrom task_0085 import mark_positions\n\n\n# ---------------------------------------------------------------------------\n# 辅助：规约后置条件的通用校验\n# ---------------------------------------------------------------------------\n\ndef _assert_spec_postconditions(text, ch, result):\n    \"\"\"校验规约中所有可执行后置条件与不变量。\"\"\"\n    # 后置：返回值为 list\n    assert isinstance(result, list)\n    # 后置：长度 == max(len(text) - 1, 0)\n    assert len(result) == max(len(text) - 1, 0)\n    # 后置：元素取值 ∈ {-1} ∪ {i}\n    assert all(result[i] == i or result[i] == -1 for i in range(len(result)))\n    # 后置：命中位置记录下标\n    assert all(result[i] == i for i in range(len(result)) if text[i] == ch)\n    # 后置：未命中位置记录 -1\n    assert all(result[i] == -1 for i in range(len(result)) if text[i] != ch)\n    # 不变量：result[i] < i + 1\n    assert all(result[i] < i + 1 for i in range(len(result)))\n\n\n# ---------------------------------------------------------------------------\n# 普通用例\n# ---------------------------------------------------------------------------\n\ndef test_mark_positions_normal_middle_match():\n    \"\"\"普通匹配：中间字符命中，非命中记 -1，末位不参与。\n\n    期望值来源：规约后置条件 + 边界情况（末位不检查）。\n    \"\"\"\n    result = mark_positions(\"abcabc\", \"b\")\n    assert result == [-1, 1, -1, -1, 4]\n    _assert_spec_postconditions(\"abcabc\", \"b\", result)\n\n\ndef test_mark_positions_normal_all_match():\n    \"\"\"普通匹配：所有被检查位置均命中，返回递增下标序列。\n\n    期望值来源：边界情况「text 中所有字符都等于 ch（单字符）：\n    返回 [0,1,...,len(text)-2]」。\n    \"\"\"\n    result = mark_positions(\"aaaa\", \"a\")\n    assert result == [0, 1, 2]\n    _assert_spec_postconditions(\"aaaa\", \"a\", result)\n\n\ndef test_mark_positions_normal_no_match():\n    \"\"\"普通匹配：无任何命中，返回全 -1 列表。\n\n    期望值来源：边界情况「text 中无任何字符等于 ch：返回全 -1 列表」。\n    \"\"\"\n    result = mark_positions(\"abcd\", \"z\")\n    assert result == [-1, -1, -1]\n    _assert_spec_postconditions(\"abcd\", \"z\", result)\n\n\n# -------------------------------------------------------------