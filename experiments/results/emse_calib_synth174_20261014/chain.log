值来源：规约后置条件（返回值不小于所有元素）。\n    \"\"\"\n    scores = [1, 3, 5, 9]\n    result = best_score(scores)\n    assert result in scores\n    assert all(result >= s for s in scores)\n    assert result == 9\n\n\ndef test_best_score_empty_list_raises():\n    \"\"\"空列表：违反前置条件 len(scores) > 0，应抛出 IndexError。\n\n    期望值来源：规约边界情况明确说明空列表触发 IndexError。\n    \"\"\"\n    with pytest.raises(IndexError):\n        best_score([])\n\n\n@pytest.mark.parametrize(\n    \"scores, expected\",\n    [\n        ([5], 5),\n        ([3, 1, 4, 1, 5, 9, 2, 6], 9),\n        ([7, 7, 7], 7),\n        ([-5, -1, -9], -1),\n        ([0, -3, 0], 0),\n        ([9, 5, 3, 1], 9),\n        ([1, 3, 5, 9], 9),\n    ],\n)\ndef test_best_score_postconditions_parametrized(scores, expected):\n    \"\"\"参数化验证 best_score 的后置条件与期望最大值。\n\n    期望值来源：规约后置条件（返回值属于 scores 且不小于所有元素）。\n    \"\"\"\n    result = best_score(scores)\n    assert result in scores\n    assert all(result >= s for s in scores)\n    assert result == expected",
