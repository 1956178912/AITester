          "generated_test": "import math\n\nimport pytest\n\nfrom task_0046 import sqrt\n\n\n# ---------------------------------------------------------------------------\n# 正常路径：x > 0，返回值 result 满足 result * result ≈ x\n# ---------------------------------------------------------------------------\n\ndef test_sqrt_positive_perfect_square():\n    \"\"\"规约：x > 0 时 result * result ≈ x。4.0 的平方根应为 2.0。\"\"\"\n    result = sqrt(4.0)\n    assert isinstance(result, float)\n    assert result == pytest.approx(2.0)\n    assert result * result == pytest.approx(4.0)\n\n\ndef test_sqrt_positive_non_perfect_square():\n    \"\"\"规约：x > 0 时 result * result ≈ x。2.0 的平方根约为 1.4142135623730951。\"\"\"\n    result = sqrt(2.0)\n    assert isinstance(result, float)\n    assert result == pytest.approx(math.sqrt(2.0))\n    assert result * result == pytest.approx(2.0)\n\n\n@pytest.mark.parametrize(\"x\", [1.0, 9.0, 16.0, 0.25, 100.0, 1e-10, 1e10])\ndef test_sqrt_positive_various_values_square_roundtrip(x):\n    \"\"\"规约：x > 0 时 result * result ≈ x（对多个正数输入验证往返性质）。\"\"\"\n    result = sqrt(x)\n    assert isinstance(result, float)\n    assert result > 0\n    assert result * result == pytest.approx(x, rel=1e-9)\n\n\n# ---------------------------------------------------------------------------\n# 边界：x == 0 分支，直接返回 0\n# ---------------------------------------------------------------------------\n\ndef test_sqrt_zero_returns_zero():\n    \"\"\"规约：x == 0 时返回 0（可执行后置：x != 0 or result == 0）。\"\"\"\n    result = sqrt(0.0)\n    assert result == 0\n\n\ndef test_sqrt_negative_zero_returns_zero():\n    \"\"\"规约：-0.0 == 0 为真，命中 x == 0 分支，返回 0。\"\"\"\n    result = sqrt(-0.0)\n    assert result == 0\n\n\n# ---------------------------------------------------------------------------\n# 边界：极大 / 极小正数\n# ---------------------------------------------------------------------------\n\ndef test_sqrt_large_value():\n    \"\"\"规约：x > 0 时 result * result ≈ x。1e308 的平方根约为 1e154。\"\"\"\n    result = sqrt(1e308)\n    assert isinstance(result, float)\n    assert result == pytest.approx(1e154, rel=1e-9)\n    assert result * result == pytest.approx(1e308, rel=1e-9)\n\n\ndef test_sqrt_smallest_positive_subnormal():\n    \"\"\"规约：x > 0 时 result * result ≈ x。5e-324 为最小正次正规数，\n    其平方根期望值来源不明（浮点下溢行为），仅记录实际行为并校验往返性质，\n    需人工确认。\"\"\"\n    result = sqrt(5e-324)\n    # 期望值来源不明，需人工确认：仅断言规约中可判定的往返性质。\n    assert result >= 0\n    assert result * result == pytest.approx(5e-324, abs=5e-324)\n\n\n# ---------------------------------------------------------------------------\n# 边界：负数输入 —— 规约声明返回 complex，非 float\n# ---------------------------------------------------------------------------\n\ndef test_sqrt_negative_returns_complex():\n    \"\"\"规约：x < 0 时返回值为复数（complex），非 float。\"\"\"\n    result = sqrt(-1.0)\n    assert isinstance(result, complex)\n    assert not isinstance(result, float)\n    assert result == pytest.approx(1j)\n\n\n@pytest.mark.parametrize(\"x\", [-4.0, -9.0, -2.0])\ndef test_sqrt_negative_various_values_complex(x):\n    \"\"\"规约：x < 0 时返回 complex，且其平方 ≈ x。\"\"\"\n    result = sqrt(x)\n    assert isinstance(result, complex)\n    assert result * result == pytest.approx(complex(x, 0.0))\n\n\n# ---------------------------------------------------------------------------\n# 边界：NaN / inf —— 规约未给出具体期望值，记录实际行为\n# ---------------------------------------------------------------------------\n\ndef test_sqrt_nan_behavior():\n    \"\"\"规约未覆盖 NaN 的具体返回；期望值来源不明，需人工确认。\n    仅记录实际行为：若返回 float 则应为 NaN，若返回 complex 则实部/虚部含 NaN。\"\"\"\n    result = sqrt(float(\"nan\"))\n    if isinstance(result, complex):\n        assert math.isnan(result.real) or math.isnan(result.imag)\n    else:\n        assert math.isnan(result)\n\n\ndef test_sqrt_positive_inf_behavior():\n    \"\"\"规约未覆盖 inf 的具体返回；期望值来源不明，需人工确认。\n    仅记录实际行为：若返回 float 则应为正无穷。\"\"\"\n    result = sqrt(float(\"inf\"))\n    if isinstance(result, complex):\n        assert math.isinf(result.real) or math.isinf(result.imag)\n    else:\n        assert math.isinf(result)\n        assert result > 0\n\n\n# ---------------------------------------------------------------------------\n# 前置条件：入参应为 float（按类型注解）\n# ---------------------------------------------------------------------------\n\ndef test_sqrt_precondition_accepts_float():\n    \"\"\"前置条件：isinstance(x, float)。合法 float 输入应正常返回。\"\"\"\n    x = 4.0\n    assert isinstance(x, float)\n    result = sqrt(x)\n    assert result == pytest.approx(2.0)",
