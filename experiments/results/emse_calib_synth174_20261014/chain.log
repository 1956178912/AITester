ide_huge_overflow(self):\n        \"\"\"规约边界：极大数相除可能溢出为 inf。\n\n        期望值来源：规约明确说明\"极大/极小浮点数（溢出为 inf 或下溢为 0.0）\"，\n        因此断言结果与 Python 原生 a / b 一致，并允许 inf。\n        \"\"\"\n        a, b = 1e308, 1e-308\n        result = divide(a, b)\n        assert result == a / b\n        assert math.isinf(result) or isinstance(result, float)\n\n    def test_divide_tiny_underflow(self):\n        \"\"\"规约边界：极小数相除可能下溢为 0.0。\n\n        期望值来源：规约明确说明\"下溢为 0.0\"，断言与 Python 原生 a / b 一致。\n        \"\"\"\n        a, b = 1e-308, 1e308\n        result = divide(a, b)\n        assert result == a / b\n        assert isinstance(result, float)\n\n\nclass TestDivideErrors:\n    \"\"\"异常场景：除数为 0 时按 Python 语义抛 ZeroDivisionError。\"\"\"\n\n    def test_divide_by_zero(self):\n        \"\"\"规约边界：b == 0 时抛 ZeroDivisionError。\"\"\"\n        with pytest.raises(ZeroDivisionError):\n            divide(1.0, 0.0)\n\n    def test_divide_zero_by_zero(self):\n        \"\"\"规约边界：a == 0 且 b == 0 时抛 ZeroDivisionError。\"\"\"\n        with pytest.raises(ZeroDivisionError):\n            divide(0.0, 0.0)\n\n    def test_divide_negative_by_zero(self):\n        \"\"\"规约边界：b == 0 时无论 a 取值均抛 ZeroDivisionError。\"\"\"\n        with pytest.raises(ZeroDivisionError):\n            divide(-1.0, 0.0)\n\n\nclass TestDividePostcondition:\n    \"\"\"参数化验证后置条件 result == a / b（前件 b != 0）。\"\"\"\n\n    @pytest.mark.parametrize(\n        \"a, b\",\n        [\n            (6.0, 3.0),\n            (-6.0, 3.0),\n            (6.0, -3.0),\n            (-6.0, -3.0),\n            (1.0, 4.0),\n            (0.0, 5.0),\n            (0.0, -5.0),\n            (3.5, 1.5),\n            (-3.5, 1.5),\n            (1e10, 1e-10),\n        ],\n    )\n    def test_divide_postcondition_result_equals_quotient(self, a, b):\n        \"\"\"规约后置条件：result == a / b，且返回类型为 float。\"\"\"\n        result = divide(a, b)\n        assert result == a / b\n        assert isinstance(result, float)",
