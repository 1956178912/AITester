          "generated_test": "import pytest\n\nfrom task_0006 import aggregate\n\n\ndef test_aggregate_normal_integer_list():\n    \"\"\"正常多元素整数列表：期望值来自规约 result == sum(values)/len(values)。\"\"\"\n    values = [1, 2, 3, 4]\n    result = aggregate(values)\n    assert result == sum(values) / len(values)\n    assert result == 2.5\n\n\ndef test_aggregate_normal_float_list():\n    \"\"\"正常浮点列表：期望值来自规约 result == sum(values)/len(values)。\"\"\"\n    values = [1.5, 2.5, 3.0]\n    result = aggregate(values)\n    assert result == sum(values) / len(values)\n    assert result == 2.3333333333333335\n\n\ndef test_aggregate_single_element_list():\n    \"\"\"单元素列表边界：规约约定 [x] → 返回 x/1。\"\"\"\n    values = [7]\n    result = aggregate(values)\n    assert result == sum(values) / len(values)\n    assert result == 7.0\n\n\ndef test_aggregate_negative_elements():\n    \"\"\"含负数元素：期望值来自规约 result == sum(values)/len(values)。\"\"\"\n    values = [-1, -2, -3]\n    result = aggregate(values)\n    assert result == sum(values) / len(values)\n    assert result == -2.0\n\n\ndef test_aggregate_zero_elements():\n    \"\"\"含零元素（全零）：期望值来自规约 result == sum(values)/len(values)。\"\"\"\n    values = [0, 0, 0]\n    result = aggregate(values)\n    assert result == sum(values) / len(values)\n    assert result == 0.0\n\n\ndef test_aggregate_mixed_sign_and_float():\n    \"\"\"混合正负与浮点元素：期望值来自规约 result == sum(values)/len(values)。\"\"\"\n    values = [-1.5, 0, 2.5, 4]\n    result = aggregate(values)\n    assert result == sum(values) / len(values)\n\n\ndef test_aggregate_return_type_is_float():\n    \"\"\"后置条件：返回类型为 float。\"\"\"\n    result = aggregate([1, 2, 3])\n    assert isinstance(result, float)\n\n\ndef test_aggregate_return_type_is_float_single():\n    \"\"\"后置条件：单元素整数列表返回类型为 float。\"\"\"\n    result = aggregate([7])\n    assert isinstance(result, float)\n\n\ndef test_aggregate_empty_list_raises_zero_division():\n    \"\"\"边界：空列表 [] → ZeroDivisionError（规约明确约定）。\"\"\"\n    with pytest.raises(ZeroDivisionError):\