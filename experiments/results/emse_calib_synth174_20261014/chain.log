          "generated_test": "import pytest\n\nfrom task_0021 import pick_label\n\n\n# ---------------------------------------------------------------------------\n# pick_label 正常 / 边界用例\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\n    \"score, expected\",\n    [\n        (90, \"excellent\"),          # excellent 下边界\n        (100, \"excellent\"),         # 高分典型值\n        (10 ** 18, \"excellent\"),    # 极大整数\n    ],\n)\ndef test_pick_label_excellent_branch(score, expected):\n    \"\"\"score >= 90 时应返回 \"excellent\"。\n\n    期望值来源：规约后置条件 `score >= 90 and result == \"excellent\"`。\n    \"\"\"\n    assert isinstance(score, int)\n    assert pick_label(score) == expected\n\n\n@pytest.mark.parametrize(\n    \"score, expected\",\n    [\n        (89, \"pass\"),   # pass 上边界\n        (60, \"pass\"),   # pass 下边界\n        (75, \"pass\"),   # 及格典型值\n    ],\n)\ndef test_pick_label_pass_branch(score, expected):\n    \"\"\"60 <= score < 90 时应返回 \"pass\"。\n\n    期望值来源：规约后置条件 `score >= 60 and score < 90 and result == \"pass\"`。\n    \"\"\"\n    assert isinstance(score, int)\n    assert pick_label(score) == expected\n\n\n@pytest.mark.parametrize(\n    \"score\",\n    [\n        59,     # 落入隐式 None 分支的边界\n        0,      # 数值边界\n        -10,    # 负数\n    ],\n)\ndef test_pick_label_implicit_none_branch(score):\n    \"\"\"score < 60 时函数无 return 语句，隐式返回 None。\n\n    期望值来源：规约后置条件 \"score < 60 时 pick_label 无 return 语句，\n    隐式返回 None\"。\n    \"\"\"\n    assert isinstance(score, int)\n    assert pick_label(score) is None\n\n\n# ---------------------------------------------------------------------------\n# report 相关用例\n# ---------------------------------------------------------------------------\n\n@pytest.mark.parametrize(\n    \"score, expected\",\n    [\n        (95, \"result: EXCELLENT\"),\n        (70, \"result: PASS\"),\n    ],\n)\ndef test_pick_label_report_uppercase_prefix(score, expected):\n    \"\"\"report 返回 \"result: \" + pick_label(score).upper()。\n\n    期望值来源：规约后置条件 \"report 返回 'result: ' + pick_label(score).upper()\"。\n    注意：report 未在签名中给出，若模块未导出该符号则跳过。\n    \"\"\"\n    module = pytest.importorskip(\"task_0021\")\n    report = getattr(module, \"report\", None)\n    if report is None:\n        pytest.skip(\"模块 task_0021 未导出 report，无法验证该后置条件\")\n    assert report(score) == expected\n\n\ndef test_pick_label_report_below_threshold_raises():\n    \"\"\"score < 60 时 report 触发 AttributeError（None.upper()）。\n\n    期望值来源：规约边界情况 \"score < 60 时 report 触发 AttributeError\"。\n    \"\"\"\n    module = pytest.importorskip(\"task_0021\")\n    report = getattr(module, \"report\", None)\n    if report is None:\n        pytest.skip(\"模块 task_0021 未导出 report，无法验证该边界情况\")\n    with pytest.raises(AttributeError):\n        report(30)",
