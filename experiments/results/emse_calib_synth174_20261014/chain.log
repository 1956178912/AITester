          "generated_test": "import pytest\n\nfrom task_0020 import aggregate\n\n\ndef test_aggregate_normal_integer_list():\n    \"\"\"正常整数列表求平均：验证 sum(values)/len(values) 主路径。\n\n    期望值来源：规约后置条件 result == sum(values)/len(values)。\n    \"\"\"\n    values = [1, 2, 3, 4]\n    result = aggregate(values)\n    assert result == sum(values) / len(values)\n    assert result == 2.5\n\n\ndef test_aggregate_normal_float_list():\n    \"\"\"正常浮点列表求平均：验证浮点元素与返回类型。\n\n    期望值来源：规约后置条件 result == sum(values)/len(values)。\n    \"\"\"\n    values = [1.5, 2.5, 3.0]\n    result = aggregate(values)\n    assert result == sum(values) / len(values)\n    assert isinstance(result, float)\n\n\ndef test_aggregate_single_element_list():\n    \"\"\"单元素列表边界：len(values)==1，返回该元素本身。\n\n    期望值来源：规约边界情况「单元素列表 [x] → 返回 x」。\n    \"\"\"\n    values = [7]\n    result = aggregate(values)\n    assert result == 7\n    assert result == sum(values) / len(values)\n\n\ndef test_aggregate_all_zero_list():\n    \"\"\"全零列表边界：sum(values)==0 且 len(values)>0，返回 0.0。\n\n    期望值来源：规约边界情况「全零列表 [0,0] → 返回 0.0」。\n    \"\"\"\n    values = [0, 0, 0]\n    result = aggregate(values)\n    assert result == 0.0\n    assert result == sum(values) / len(values)\n\n\ndef test_aggregate_negative_numbers_list():\n    \"\"\"含负数列表边界：验证负平均值计算正确。\n\n    期望值来源：规约边界情况「含负数列表 [-1,-2] → 返回 -1.5」，\n    此处使用 [-1,-2,-3] 其平均值为 -2.0。\n    \"\"\"\n    values = [-1, -2, -3]\n    result = aggregate(values)\n    assert result == sum(values) / len(values)\n    assert result == -2.0\n\n\ndef test_aggregate_negative_two_elements():\n    \"\"\"含负数列表边界（规约原文示例）：[-1,-2] → -1.5。\n\n    期望值来源：规约边界情况「含负数列表 [-1,-2] → 返回 -1.5」。\n    \"\"\"\n    values = [-1, -2]\n    result = aggregate(values)\n    assert result == -1.5\n\n\ndef test_aggregate_float_pair_boundary():\n    \"\"\"含浮点数列表边界：[1.5,2.5] → 2.0。\n\n    期望值来源：规约边界情况「含浮点数列表 [1.5,2.5] → 返回 2.0」。\n    \"\"\"\n    values = [1.5, 2.5]\n    result = aggregate(values)\n    assert result == 2.0\n\n\ndef test_aggregate_empty_list_raises_zero_division():\n    \"\"\"空列表异常路径：len(values)==0 触发 ZeroDivisionError。\n\n    期望值来源：规约边界情况「空列表 [] → ZeroDivisionError」。\n    \"\"\"\n    with pytest.raises(ZeroDivisionError):\n        aggregate([])\n\n\ndef test_aggregate_string_elements_raises_type_error():\n    \"\"\"元素为不可加类型（str）异常路径：预期 TypeError。\n\n    期望值来源：规约边界情况「元素为不可加类型（如 str）→ TypeError」。\n    \"\"\"\n    with pytest.raises(TypeError):\n        aggregate([\"a\", \"b\"])\n\n\ndef test_aggregate_large_numbers_no_overflow():\n    \"\"\"大数列表边界：接近浮点溢出，验证不抛异常且满足后置条件。\n\n    期望值来源：规约边界情况「大数列表（接近浮点溢出）」，\n    具体数值未在规约中给出，故仅断言后置条件与不变量。\n    \"\"\"\n    values = [1e308, 1e308]\n    result = aggregate(values)\n    assert result == sum(values) / len(values)\n\n\ndef test_aggregate_postcondition_invariant():\n    \"\"\"后置条件与不变量：非空输入时返回值等于 sum/len 且不抛异常。\n\n    期望值来源：规约后置条件与不变量子句。\n    \"\"\"\n    values = [10, 20, 30, 40, 50]\n    assert len(values) > 0\n    result = aggregate(values)\n    assert result == sum(values) / len(values)",
