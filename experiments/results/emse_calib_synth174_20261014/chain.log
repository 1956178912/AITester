          "generated_test": "import pytest\n\nfrom task_0058 import mark_positions\n\n\n# ---------------------------------------------------------------------------\n# 通用规约断言辅助（仅依据规约，不依赖实现细节）\n# ---------------------------------------------------------------------------\n\ndef _assert_postconditions(text: str, ch: str, result):\n    \"\"\"断言规约中所有可判定的后置条件与不变量。\"\"\"\n    # 后置：返回值为 list\n    assert isinstance(result, list)\n    # 后置 / 不变量：长度 == max(len(text) - 1, 0)\n    assert len(result) == max(len(text) - 1, 0)\n    # 后置：每个元素要么是 -1，要么是等于其下标的非负整数\n    assert all(result[i] == i or result[i] == -1 for i in range(len(result)))\n    # 后置：result[i] == i 当且仅当 text[i] == ch（i 在 0..len(text)-2 范围内）\n    for i in range(len(result)):\n        if text[i] == ch:\n            assert result[i] == i\n        else:\n            assert result[i] == -1\n\n\n# ---------------------------------------------------------------------------\n# 普通用例\n# ---------------------------------------------------------------------------\n\ndef test_mark_positions_mixed_hit_and_miss():\n    \"\"\"普通命中与未命中混合：命中处记录下标，未命中处记录 -1。\n\n    期望值来源：规约后置条件 result[i] == i 当且仅当 text[i] == ch。\n    \"\"\"\n    text, ch = \"abcabc\", \"a\"\n    result = mark_positions(text, ch)\n    _assert_postconditions(text, ch, result)\n    assert result == [0, -1, -1, 3, -1]\n\n\ndef test_mark_positions_all_hit():\n    \"\"\"全部命中：返回递增下标序列 [0, 1, ..., len(text)-2]。\n\n    期望值来源：规约边界情况\"text 中所有字符都等于 ch\"。\n    \"\"\"\n    text, ch = \"aaaa\", \"a\"\n    result = mark_positions(text, ch)\n    _assert_postconditions(text, ch, result)\n    assert result == [0, 1, 2]\n\n\ndef test_mark_positions_all_miss():\n    \"\"\"全部未命中：返回全 -1 列表。\n\n    期望值来源：规约边界情况\"text 中无字符等于 ch\"。\n    \"\"\"\n    text, ch = \"abcd\", \"z\"\n    result = mark_positions(text, ch)\n    _assert_postconditions(text, ch, result)\n    assert result == [-1, -1, -1]\n\n\n# ---------------------------------------------------------------------------\n# 边界用例\n# ------