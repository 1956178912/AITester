          "generated_test": "import pytest\n\nfrom task_0045 import lookup\n\n\n# 规约中声明的 _TABLE 内容（期望值的唯一合法来源）\n_SPEC_TABLE = {\"alpha\": 1, \"beta\": 2, \"gamma\": 3}\n\n\n@pytest.mark.parametrize(\n    \"key, expected\",\n    [\n        (\"alpha\", 1),\n        (\"beta\", 2),\n        (\"gamma\", 3),\n    ],\n)\ndef test_lookup_hit_existing_key_returns_table_value(key, expected):\n    \"\"\"命中 _TABLE 中已有键时，返回值应等于 _TABLE[key]。\n\n    期望值来源：规约后置条件 \"key 在 _TABLE 中时返回值等于 _TABLE[key]\"\n    以及 _TABLE 初始化约定 {\"alpha\":1,\"beta\":2,\"gamma\":3}。\n    \"\"\"\n    result = lookup(key)\n    assert result == expected\n    assert result == _SPEC_TABLE[key]\n\n\n@pytest.mark.parametrize(\n    \"key\",\n    [\"delta\", \"\", \"Alpha\", \"ALPHA\", \"Beta\", \"gamma \", \" gamma\"],\n)\ndef test_lookup_miss_key_returns_zero(key):\n    \"\"\"未命中 _TABLE 的键应返回默认值 0。\n\n    期望值来源：规约后置条件 \"key 不在 _TABLE 中时返回值为 0\"。\n    覆盖边界：空字符串、普通不存在字符串、大小写变体、含空白变体。\n    \"\"\"\n    assert key not in _SPEC_TABLE\n    result = lookup(key)\n    assert result == 0\n\n\ndef test_lookup_empty_string_key_returns_zero():\n    \"\"\"边界：空字符串键不在 _TABLE 中，应返回 0。\n\n    期望值来源：规约边界情况 \"key 为空字符串\" 与后置条件未命中返回 0。\n    \"\"\"\n    result = lookup(\"\")\n    assert result == 0\n\n\ndef test_lookup_case_variant_key_returns_zero():\n    \"\"\"边界：大小写变体（如 \"Alpha\"）不在 _TABLE 中，应返回 0。\n\n    期望值来源：规约边界情况 \"key 为大小写不同的变体（如 \"Alpha\"）\"。\n    \"\"\"\n    result = lookup(\"Alpha\")\n    assert result == 0\n\n\ndef test_lookup_none_key_returns_zero():\n    \"\"\"边界：None 作为键（dict.get 可接受任意可哈希对象）应未命中返回 0。\n\n    期望值来源：规约边界情况 \"key 为 None 或非 str 类型（dict.get 可接受\n    任意可哈希对象，返回 0）\"。注意：None 不满足前置条件 isinstance(key, str)，\n    此处为类型契约外的异常路径，按规约约定期望返回 0。\n    \"\"\"\n    result = lookup(None)\n    assert result == 0\n\n\n@pytest.mark.parametrize(\n    \"key\",\n    [\"alpha\", \"beta\", \"gamma\", \"delta\", \"\", \"Alpha\", None],\n)\ndef test_lookup_result_is_int_and_non_negative(key):\n    \"\"\"后置条件：返回值类型为 int 且 result >= 0。\n