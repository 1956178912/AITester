          "generated_test": "import pytest\n\nfrom task_0004 import compare\n\n\nclass TestCompare:\n    \"\"\"compare 函数的测试集合。\"\"\"\n\n    @pytest.mark.parametrize(\n        \"a, b, expected\",\n        [\n            (5, 3, 1),\n            (3, 5, -1),\n            (4, 4, 0),\n            (1, 2, -1),\n            (0, -1, 1),\n            (1000000000000, 999999999999, 1),\n        ],\n    )\n    def test_compare_returns_expected(self, a, b, expected):\n        \"\"\"验证 compare 在各输入下返回预期结果（来源：测试计划）。\"\"\"\n        assert compare(a, b) == expected\n\n    def test_compare_a_greater_than_b(self):\n        \"\"\"验证 a>b 分支返回 1。\"\"\"\n        assert compare(5, 3) == 1\n\n    def test_compare_a_less_than_b(self):\n        \"\"\"验证 a<b 分支返回 -1。\"\"\"\n        assert compare(3, 5) == -1\n\n    def test_compare_a_equal_to_b(self):\n        \"\"\"验证相等时返回 0。\"\"\"\n        assert compare(4, 4) == 0\n\n    def test_compare_adjacent_integers(self):\n        \"\"\"验证相差 1 的边界比较返回 -1。\"\"\"\n        assert compare(1, 2) == -1\n\n    def test_compare_zero_and_negative(self):\n        \"\"\"验证 0 与负数比较返回 1。\"\"\"\n        assert compare(0, -1) == 1\n\n    def test_compare_large_integers(self):\n        \"\"\"验证大整数比较不溢出，返回 1。\"\"\"\n        assert compare(1000000000000, 999999999999) == 1\n\n    def test_compare_negative_numbers(self):\n        \"\"\"验证负数比较：-1 > -5 返回 1。\"\"\"\n        assert compare(-1, -5) == 1\n\n    def test_compare_negative_less_than_negative(self):\n        \"\"\"验证负数比较：-5 < -1 返回 -1。\"\"\"\n        assert compare(-5, -1) == -1\n\n    def test_compare_equal_negative_numbers(self):\n        \"\"\"验证相等负数比较返回 0。\"\"\"\n        assert compare(-7, -7) == 0\n\n    def test_compare_zero_equal_zero(self):\n        \"\"\"验证 0 与 0 比较返回 0。\"\"\"\n        assert compare(0, 0) == 0\n\n    def test_compare_output_in_domain(self):\n        \"\"\"验证返回值始终属于 {1, -1, 0}。\"\"\"\n        assert compare(10, 20) in (1, -1, 0)\n        assert compare(20, 10) in (1, -1, 0)\n        assert compare(10, 10) in (1, -1, 0)\n\n    def test_compare_antisymmetry(self):\n        \"\"\"验证比较的反对称性：compare(a,b) == -compare(b,a)（非相等时）。\"\"\"\n        assert compare(7, 2) == -compare(2, 7)\n        assert compare(-3, 8) == -compare(8, -3)\n\n    def test_compare_returns_int(self):\n        \"\"\"验证返回类型为 int。\"\"\"\n        result = compare(1, 2)\n        assert isinstance(result, int)",
