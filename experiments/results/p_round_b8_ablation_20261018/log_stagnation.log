          "generated_test": "import math\n\nimport pytest\n\nfrom task_0001 import divide\n\n\ndef test_divide_positive_numbers():\n    \"\"\"验证常规正数除法返回正确商：6.0 / 3.0 == 2.0。\"\"\"\n    assert divide(6.0, 3.0) == 2.0\n\n\ndef test_divide_negative_dividend():\n    \"\"\"验证负数被除数的符号处理：-6.0 / 3.0 == -2.0。\"\"\"\n    assert divide(-6.0, 3.0) == -2.0\n\n\ndef test_divide_zero_dividend():\n    \"\"\"验证 a=0 边界返回 0.0：0.0 / 5.0 == 0.0。\"\"\"\n    assert divide(0.0, 5.0) == 0.0\n\n\ndef test_divide_by_zero_raises():\n    \"\"\"验证除数为零时抛出 ZeroDivisionError。\n\n    期望值来源不明，需人工确认：docstring 未声明 b=0 的行为，\n    此处按 Python 原生语义断言 ZeroDivisionError。\n    \"\"\"\n    with pytest.raises(ZeroDivisionError):\n        divide(1.0, 0.0)\n\n\ndef test_divide_overflow_to_inf():\n    \"\"\"验证极大值相除溢出为 inf。\n\n    期望值来源不明，需人工确认：结果超出 float 范围，\n    Python 语义为 inf，但代码未显式约定。\n    \"\"\"\n    result = divide(1e308, 1e-308)\n    assert math.isinf(result)\n\n\n@pytest.mark.parametrize(\n    \"a, b, expected\",\n    [\n        (6.0, 3.0, 2.0),\n        (-6.0, 3.0, -2.0),\n        (0.0, 5.0, 0.0),\n        (-6.0, -3.0, 2.0),\n        (1.0, 4.0, 0.25),\n    ],\n)\ndef test_divide_parametrized(a, b, expected):\n    \"\"\"参数化验证多组常规除法结果与符号处理。\"\"\"\n    assert divide(a, b) == expected\n\n\ndef test_divide_does_not_modify_inputs():\n    \"\"\"验证函数不修改入参（float 不可变，检查值保持一致）。\"\"\"\n    a, b = 7.0, 2.0\n    divide(a, b)\n    assert a == 7.0\n    assert b == 2.0\n\n\ndef test_divide_returns_float():\n    \"\"\"验证返回值为 float 类型。\"\"\"\n    assert isinstance(divide(6.0, 3.0), float)",
