          "generated_test": "import pytest\n\nfrom task_0008 import split_words\n\n\ndef test_split_words_normal_multi_word():\n    \"\"\"验证基本按空格分割功能：'hello world' -> ['hello', 'world']\"\"\"\n    assert split_words(\"hello world\") == [\"hello\", \"world\"]\n\n\ndef test_split_words_single_word_no_space():\n    \"\"\"验证无空格时返回单元素列表：'hello' -> ['hello']\"\"\"\n    assert split_words(\"hello\") == [\"hello\"]\n\n\ndef test_split_words_empty_string():\n    \"\"\"验证空字符串边界，str.split(' ') 返回 ['']\"\"\"\n    assert split_words(\"\") == [\"\"]\n\n\ndef test_split_words_single_space():\n    \"\"\"验证仅空格输入，按空格分割产生两个空串：' ' -> ['', '']\"\"\"\n    assert split_words(\" \") == [\"\", \"\"]\n\n\ndef test_split_words_consecutive_spaces():\n    \"\"\"验证连续空格产生空字符串元素：'a  b' -> ['a', '', 'b']\"\"\"\n    assert split_words(\"a  b\") == [\"a\", \"\", \"b\"]\n\n\ndef test_split_words_leading_trailing_spaces():\n    \"\"\"验证首尾空格产生首尾空字符串元素：' a ' -> ['', 'a', '']\"\"\"\n    assert split_words(\" a \") == [\"\", \"a\", \"\"]\n\n\ndef test_split_words_tab_and_newline_not_split():\n    \"\"\"验证仅按空格分割，制表符/换行符不分割：'a\\\\tb\\\\nc' -> ['a\\\\tb\\\\nc']\"\"\"\n    assert split_words(\"a\\tb\\nc\") == [\"a\\tb\\nc\"]\n\n\ndef test_split_words_returns_list_type():\n    \"\"\"验证返回值类型为 list\"\"\"\n    result = split_words(\"hello world\")\n    assert isinstance(result, list)\n\n\ndef test_split_words_roundtrip_join():\n    \"\"\"验证返回列表元素以 ' ' 连接可还原原字符串\"\"\"\n    text = \"a  b c \"\n    assert \" \".join(split_words(text)) == text\n\n\ndef test_split_words_does_not_modify_input():\n    \"\"\"验证不修改入参（字符串不可变，检查原值保持不变）\"\"\"\n    text = \"hello world\"\n    original = text\n    split_words(text)\n    assert text == original\n\n\ndef test_split_words_unicode():\n    \"\"\"验证含 Unicode 字符的字符串按空格正确分割\"\"\"\n    assert split_words(\"你好 世界\") == [\"你好\", \"世界\"]\n\n\ndef test_split_words_long_string():\n    \"\"\"验证超长字符串（性能/溢出边界）能正确分割\"\"\"\n    n = 10000\n    text = \" \".join([\"word\"] * n)\n    result = split_words(text)\n    assert len(result) == n\n    assert all(item == \"word\" for item in result)\n\n\ndef test_split_words_non_string_int_raises():\n    \"\"\"非字符串入参：传入 int 时调用 int.split 抛 AttributeError。\n\n    期望值来源不明，需人工确认：类型注解声明为 str，代码未约定异常处理，\n    此处仅断言会抛出 AttributeError（Python 运行时行为）。\n    \"\"\"\n    with pytest.raises(AttributeError):\n        split_words(123)\n\n\ndef test_split_words_none_raises():\n    \"\"\"None 入参：调用 None.split 抛 AttributeError。\n\n    期望值来源不明，需人工确认：代码未约定异常处理，\n    此处仅断言会抛出 AttributeError（Python 运行时行为）。\n    \"\"\"\n    with pytest.raises(AttributeError):\n        split_words(None)",
