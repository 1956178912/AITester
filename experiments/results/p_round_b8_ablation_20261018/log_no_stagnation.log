          "generated_test": "import pytest\n\nfrom task_0000 import cumulative\n\n\ndef test_cumulative_empty_list():\n    \"\"\"空列表输入应返回空列表（依据函数实现：循环不执行，out 保持为空）。\"\"\"\n    assert cumulative([]) == []\n\n\ndef test_cumulative_single_element():\n    \"\"\"单元素列表：初始 total 为 -1，加上该元素后返回 [v - 1]。\n\n    期望值来源：函数实现中 total 初始化为 -1，需人工确认该初始值是否为预期行为。\n    \"\"\"\n    assert cumulative([5]) == [4]\n\n\ndef test_cumulative_multiple_elements():\n    \"\"\"多元素列表：累加从 -1 开始，逐项累加并输出。\n\n    期望值来源：函数实现（total 初始 -1），需人工确认初始偏移是否为预期行为。\n    \"\"\"\n    assert cumulative([1, 2, 3]) == [0, 2, 5]\n\n\ndef test_cumulative_negative_values():\n    \"\"\"负数输入：累加结果按实现逻辑计算。\n\n    期望值来源：函数实现（total 初始 -1），需人工确认。\n    \"\"\"\n    assert cumulative([-1, -2, -3]) == [-2, -4, -7]\n\n\ndef test_cumulative_zero_values():\n    \"\"\"全零输入：每项输出均为 -1（因 total 初始为 -1 且不变化）。\n\n    期望值来源：函数实现，需人工确认初始值 -1 是否为预期。\n    \"\"\"\n    assert cumulative([0, 0, 0]) == [-1, -1, -1]\n\n\ndef test_cumulative_mixed_values():\n    \"\"\"混合正负数：按实现逻辑累加。\n\n    期望值来源：函数实现，需人工确认。\n    \"\"\"\n    assert cumulative([10, -5, 3, -8]) == [9, 4, 7, -1]\n\n\ndef test_cumulative_output_length_matches_input():\n    \"\"\"输出列表长度应与输入列表长度一致。\"\"\"\n    values = [1, 2, 3, 4, 5]\n    result = cumulative(values)\n    assert len(result) == len(values)\n\n\ndef test_cumulative_returns_new_list():\n    \"\"\"函数应返回新列表，不修改输入列表。\"\"\"\n    values = [1, 2, 3]\n    original = list(values)\n    result = cumulative(values)\n    assert values == original\n    assert result is not values\n\n\ndef test_cumulative_float_values():\n    \"\"\"浮点数输入：按实现逻辑累加。\n\n    期望值来源：函数实现（total 初始 -1），需人工确认。\n    \"\"\"\n    result = cumulative([1.5, 2.5])\n    assert result == pytest.approx([0.5, 3.0])\n\n\ndef test_cumulative_non_list_iterable_raises():\n    \"\"\"传入非可迭代对象（如整数）应抛出 TypeError。\"\"\"\n    with pytest.raises(TypeError):\n        cumulative(123)\n\n\ndef test_cumulative_none_raises():\n    \"\"\"传入 None 应抛出 TypeError（None 不可迭代）。\"\"\"\n    with pytest.raises(TypeError):\n        cumulative(None)\n\n\ndef test_cumulative_string_elements_raises():\n    \"\"\"字符串元素与整数初始值相加应抛出 TypeError。\"\"\"\n    with pytest.raises(TypeError):\n        cumulative([\"a\", \"b\"])",
