          "generated_test": "import pytest\n\nfrom task_0002 import process\n\n\ndef test_process_normal_integer_list():\n    \"\"\"验证每个元素加1且末尾追加0（主路径）。\"\"\"\n    items = [1, 2, 3]\n    assert process(items) == [2, 3, 4, 0]\n\n\ndef test_process_empty_list():\n    \"\"\"验证空输入时仅返回[0]（循环零次迭代边界）。\"\"\"\n    assert process([]) == [0]\n\n\ndef test_process_single_element_list():\n    \"\"\"验证最小非空输入（循环一次迭代边界）。\"\"\"\n    assert process([5]) == [6, 0]\n\n\ndef test_process_list_with_zero():\n    \"\"\"验证元素为0时的加1结果。\"\"\"\n    assert process([0]) == [1, 0]\n\n\ndef test_process_list_with_negatives():\n    \"\"\"验证负数元素加1。\"\"\"\n    assert process([-1, -5]) == [0, -4, 0]\n\n\ndef test_process_list_with_floats():\n    \"\"\"验证浮点元素加1。\"\"\"\n    assert process([1.5, 2.5]) == [2.5, 3.5, 0]\n\n\ndef test_process_large_integer():\n    \"\"\"验证大整数加1（Python 整数无溢出）。\"\"\"\n    assert process([9223372036854775807]) == [9223372036854775808, 0]\n\n\ndef test_process_string_element_raises_type_error():\n    \"\"\"字符串不支持与整数相加，预期抛出 TypeError。\"\"\"\n    with pytest.raises(TypeError):\n        process([\"a\"])\n\n\ndef test_process_none_element_raises_type_error():\n    \"\"\"None 不支持与整数相加，预期抛出 TypeError。\"\"\"\n    with pytest.raises(TypeError):\n        process([None])\n\n\ndef test_process_does_not_mutate_input():\n    \"\"\"验证返回新列表且不修改原列表。\"\"\"\n    items = [1, 2, 3]\n    original = list(items)\n    result = process(items)\n    assert items == original\n    assert result is not items\n\n\ndef test_process_output_length():\n    \"\"\"验证返回列表长度等于输入长度加1。\"\"\"\n    items = [10, 20, 30, 40]\n    assert len(process(items)) == len(items) + 1\n\n\n@pytest.mark.parametrize(\n    \"items, expected\",\n    [\n        ([1, 2, 3], [2, 3, 4, 0]),\n        ([], [0]),\n        ([5], [6, 0]),\n        ([0], [1, 0]),\n        ([-1, -5], [0, -4, 0]),\n        ([1.5, 2.5], [2.5, 3.5, 0]),\n        ([9223372036854775807], [9223372036854775808, 0]),\n    ],\n)\ndef test_process_parametrized(items, expected):\n    \"\"\"参数化验证各类正常与边界输入。\"\"\"\n    assert process(items) == expected",
