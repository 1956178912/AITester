          "generated_test": "import pytest\n\nfrom task_0004 import compare\n\n\ndef test_compare_a_greater_than_b():\n    \"\"\"验证 a>b 分支返回 1。\"\"\"\n    assert compare(5, 3) == 1\n\n\ndef test_compare_a_less_than_b():\n    \"\"\"验证 a<b 分支返回 -1。\"\"\"\n    assert compare(3, 5) == -1\n\n\ndef test_compare_a_equal_to_b():\n    \"\"\"验证相等时返回 0。\"\"\"\n    assert compare(4, 4) == 0\n\n\ndef test_compare_adjacent_integers():\n    \"\"\"验证相差 1 的边界比较返回 -1。\"\"\"\n    assert compare(1, 2) == -1\n\n\ndef test_compare_zero_and_negative():\n    \"\"\"验证 0 与负数比较返回 1。\"\"\"\n    assert compare(0, -1) == 1\n\n\ndef test_compare_large_integers():\n    \"\"\"验证大整数比较不溢出，返回 1。\"\"\"\n    assert compare(1000000000000, 999999999999) == 1\n\n\n@pytest.mark.parametrize(\n    \"a, b, expected\",\n    [\n        (5, 3, 1),\n        (3, 5, -1),\n        (4, 4, 0),\n        (1, 2, -1),\n        (0, -1, 1),\n        (1000000000000, 999999999999, 1),\n        (-5, -3, -1),\n        (-3, -5, 1),\n        (-1, 0, -1),\n        (0, 0, 0),\n    ],\n)\ndef test_compare_parametrized(a, b, expected):\n    \"\"\"参数化验证 compare 在各输入下的返回值符合后置条件。\"\"\"\n    assert compare(a, b) == expected\n\n\ndef test_compare_output_in_domain():\n    \"\"\"验证返回值始终属于 {1, -1, 0}。\"\"\"\n    result = compare(10, 20)\n    assert result in {1, -1, 0}",
