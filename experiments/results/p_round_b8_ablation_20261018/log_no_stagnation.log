          "generated_test": "import pytest\n\nfrom task_0004 import compare\n\n\ndef test_compare_a_greater_than_b():\n    \"\"\"验证 a>b 分支返回 1（期望值来源：docstring 后置条件）。\"\"\"\n    assert compare(5, 3) == 1\n\n\ndef test_compare_a_less_than_b():\n    \"\"\"验证 a<b 分支返回 -1（期望值来源：docstring 后置条件）。\"\"\"\n    assert compare(3, 5) == -1\n\n\ndef test_compare_a_equal_to_b():\n    \"\"\"验证 a==b 分支返回 0（期望值来源：docstring 后置条件）。\"\"\"\n    assert compare(4, 4) == 0\n\n\ndef test_compare_adjacent_integers():\n    \"\"\"验证相邻整数边界比较返回 -1（期望值来源：docstring 后置条件）。\"\"\"\n    assert compare(1, 2) == -1\n\n\ndef test_compare_with_zero_and_negative():\n    \"\"\"验证 0 与负数比较返回 1（期望值来源：docstring 后置条件）。\"\"\"\n    assert compare(0, -1) == 1\n\n\ndef test_compare_negative_numbers():\n    \"\"\"验证两个负数比较返回 -1（期望值来源：docstring 后置条件）。\"\"\"\n    assert compare(-5, -3) == -1\n\n\ndef test_compare_extreme_integers():\n    \"\"\"验证极大与极小整数比较返回 1（期望值来源：docstring 后置条件）。\"\"\"\n    assert compare(9223372036854775807, -9223372036854775808) == 1\n\n\n@pytest.mark.parametrize(\n    \"a, b, expected\",\n    [\n        (5, 3, 1),\n        (3, 5, -1),\n        (4, 4, 0),\n        (1, 2, -1),\n        (0, -1, 1),\n        (-5, -3, -1),\n        (9223372036854775807, -9223372036854775808, 1),\n        (-9223372036854775808, 9223372036854775807, -1),\n        (0, 0, 0),\n    ],\n)\ndef test_compare_parametrized(a, b, expected):\n    \"\"\"参数化验证 compare 的三分支逻辑（期望值来源：docstring 后置条件）。\"\"\"\n    assert compare(a, b) == expected\n\n\ndef test_compare_output_in_domain():\n    \"\"\"验证返回值始终属于 {1, -1, 0}（期望值来源：docstring 输出域）。\"\"\"\n    for a, b in [(10, 2), (2, 10), (7, 7), (-1, 1), (0, 0)]:\n        assert compare(a, b) in (1, -1, 0)\n\n\ndef test_compare_antisymmetry():\n    \"\"\"验证 compare(a,b) 与 compare(b,a) 互为相反数（期望值来源：docstring 后置条件）。\"\"\"\n    pairs = [(5, 3), (3, 5), (4, 4), (-5, -3), (0, -1)]\n    for a, b in pairs:\n        assert compare(a, b) == -compare(b, a)",
