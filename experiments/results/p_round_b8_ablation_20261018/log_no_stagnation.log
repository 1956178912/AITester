          "generated_test": "import pytest\n\nfrom task_0008 import split_words\n\n\ndef test_split_words_normal_multi_word():\n    \"\"\"验证基本按空格分割行为：'hello world' -> ['hello', 'world']\"\"\"\n    assert split_words(\"hello world\") == [\"hello\", \"world\"]\n\n\ndef test_split_words_single_word_no_space():\n    \"\"\"验证无空格时返回单元素列表：'hello' -> ['hello']\"\"\"\n    assert split_words(\"hello\") == [\"hello\"]\n\n\ndef test_split_words_empty_string():\n    \"\"\"验证空串边界：str.split(' ') 对空串返回 ['']\"\"\"\n    assert split_words(\"\") == [\"\"]\n\n\ndef test_split_words_single_space():\n    \"\"\"验证仅空格边界：按空格分割产生两个空字符串\"\"\"\n    assert split_words(\" \") == [\"\", \"\"]\n\n\ndef test_split_words_consecutive_spaces():\n    \"\"\"验证连续空格产生空字符串元素（与 split() 无参行为不同）\"\"\"\n    assert split_words(\"a  b\") == [\"a\", \"\", \"b\"]\n\n\ndef test_split_words_leading_trailing_spaces():\n    \"\"\"验证首尾空格产生首尾空字符串元素\"\"\"\n    assert split_words(\" a \") == [\"\", \"a\", \"\"]\n\n\ndef test_split_words_tab_and_newline_not_split():\n    \"\"\"验证 split(' ') 不按制表符/换行分割，整体作为单元素\"\"\"\n    assert split_words(\"a\\tb\\nc\") == [\"a\\tb\\nc\"]\n\n\ndef test_split_words_long_string():\n    \"\"\"验证多元素列表输出（规模边界，非数值溢出）\"\"\"\n    assert split_words(\"a a a a a a a a a a\") == [\"a\"] * 10\n\n\ndef test_split_words_none_input_raises():\n    \"\"\"期望值来源不明，需人工确认：类型注解要求 str，传入 None 时\n    str.split 调用将抛 AttributeError，具体异常信息未在代码中约定。\"\"\"\n    with pytest.raises(AttributeError):\n        split_words(None)\n\n\ndef test_split_words_int_input_raises():\n    \"\"\"期望值来源不明，需人工确认：传入 int 时 int 无 split 方法，\n    将抛 AttributeError，异常信息未约定。\"\"\"\n    with pytest.raises(AttributeError):\n        split_words(123)\n\n\ndef test_split_words_returns_list_type():\n    \"\"\"验证返回值为 list 类型\"\"\"\n    result = split_words(\"a b\")\n    assert isinstance(result, list)\n\n\ndef test_split_words_does_not_modify_input():\n    \"\"\"验证不修改入参（str 不可变，验证原字符串值不变）\"\"\"\n    text = \"a b c\"\n    original = text\n    split_words(text)\n    assert text == original\n\n\ndef test_split_words_roundtrip_join():\n    \"\"\"验证返回列表元素以单个空格拼接可还原原字符串\"\"\"\n    text = \"a  b c \"\n    assert \" \".join(split_words(text)) == text",
