          "generated_test": "import math\nimport pytest\n\nfrom task_0003 import rounded_ratio\n\n\nclass TestRoundedRatioNormal:\n    \"\"\"正常比例计算测试\"\"\"\n\n    def test_rounded_ratio_half_hit(self):\n        \"\"\"验证常规比例计算：50/100*100=50，floor(50)/100=0.5\"\"\"\n        assert rounded_ratio(50, 100) == 0.5\n\n    def test_rounded_ratio_non_divisible_floor(self):\n        \"\"\"验证 floor 截断：1/3*100≈33.33，floor→33，/100=0.33\"\"\"\n        assert rounded_ratio(1, 3) == 0.33\n\n\nclass TestRoundedRatioBoundary:\n    \"\"\"边界条件测试\"\"\"\n\n    def test_rounded_ratio_total_zero(self):\n        \"\"\"验证除零保护分支返回 0.0\"\"\"\n        assert rounded_ratio(10, 0) == 0.0\n\n    def test_rounded_ratio_hit_zero(self):\n        \"\"\"验证命中数为0时结果为0.0\"\"\"\n        assert rounded_ratio(0, 100) == 0.0\n\n    def test_rounded_ratio_hit_equals_total(self):\n        \"\"\"验证满命中：100/100*100=100，floor(100)/100=1.0\"\"\"\n        assert rounded_ratio(100, 100) == 1.0\n\n    def test_rounded_ratio_exact_integer_result(self):\n        \"\"\"验证 floor 对整数值无截断：25/100*100=25.0，floor→25，/100=0.25\"\"\"\n        assert rounded_ratio(25, 100) == 0.25\n\n    def test_rounded_ratio_negative_hit(self):\n        \"\"\"验证负数时 floor 向负无穷取整：-1/3*100≈-33.33，floor→-34，/100=-0.34\"\"\"\n        assert rounded_ratio(-1, 3) == -0.34\n\n    def test_rounded_ratio_negative_total(self):\n        \"\"\"验证 total 为负时符号处理：1/-3*100≈-33.33，floor→-34，/100=-0.34\"\"\"\n        assert rounded_ratio(1, -3) == -0.34\n\n    def test_rounded_ratio_large_integers(self):\n        \"\"\"验证大整数下浮点精度影响。\n\n        期望值来源不明，需人工确认：此处仅断言结果与直接按公式\n        math.floor(hit / total * 100) / 100 计算一致，并记录实际行为。\n        \"\"\"\n        hit = 1000000000000000000\n        total = 1000000000000000001\n        expected = math.floor(hit / total * 100) / 100\n        result = rounded_ratio(hit, total)\n        assert result == expected\n        # 结果精度应为 0.01 的整数倍\n        assert round(result * 100) == pytest.approx(result * 100)\n\n\nclass TestRoundedRatioError:\n    \"\"\"异常/类型错误路径测试\"\"\"\n\n    def test_rounded_ratio_non_integer_input(self):\n        \"\"\"验证传入字符串时行为。\n\n        期望值来源不明，需人工确认：代码无类型校验，实际会抛 TypeError，\n        但未在 docstring 中约定。此处记录实际行为为抛出 TypeError。\n        \"\"\"\n        with pytest.raises(TypeError):\n            rounded_ratio(\"10\", 100)",
