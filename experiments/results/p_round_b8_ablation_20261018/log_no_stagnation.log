          "generated_test": "import math\n\nimport pytest\n\nfrom task_0003 import rounded_ratio\n\n\nclass TestRoundedRatioNormal:\n    \"\"\"正常比例计算测试。\"\"\"\n\n    def test_rounded_ratio_half(self):\n        \"\"\"50/100*100=50.0，floor(50.0)/100=0.5。\"\"\"\n        assert rounded_ratio(50, 100) == 0.5\n\n    def test_rounded_ratio_one_third_floor(self):\n        \"\"\"1/3*100≈33.333，floor→33，/100=0.33。\"\"\"\n        assert rounded_ratio(1, 3) == 0.33\n\n    def test_rounded_ratio_hit_equals_total(self):\n        \"\"\"hit==total 时比值为 1.0。\"\"\"\n        assert rounded_ratio(100, 100) == 1.0\n\n\nclass TestRoundedRatioBoundary:\n    \"\"\"边界与特殊值测试。\"\"\"\n\n    def test_rounded_ratio_total_zero(self):\n        \"\"\"total==0 分支返回 0.0，不发生除零异常。\"\"\"\n        assert rounded_ratio(10, 0) == 0.0\n\n    def test_rounded_ratio_hit_zero(self):\n        \"\"\"hit 为 0 时结果为 0.0。\"\"\"\n        assert rounded_ratio(0, 100) == 0.0\n\n    def test_rounded_ratio_both_zero(self):\n        \"\"\"hit 与 total 均为 0 时，total==0 分支优先，返回 0.0。\"\"\"\n        assert rounded_ratio(0, 0) == 0.0\n\n    def test_rounded_ratio_negative_hit(self):\n        \"\"\"-50/100*100=-50.0，floor(-50.0)/100=-0.5。\"\"\"\n        assert rounded_ratio(-50, 100) == -0.5\n\n    def test_rounded_ratio_negative_total(self):\n        \"\"\"50/-100*100=-50.0，floor(-50.0)/100=-0.5。\"\"\"\n        assert rounded_ratio(50, -100) == -0.5\n\n    def test_rounded_ratio_negative_fraction_floor(self):\n        \"\"\"-1/3*100≈-33.333，floor→-34，/100=-0.34。\"\"\"\n        assert rounded_ratio(-1, 3) == -0.34\n\n    def test_rounded_ratio_large_integer_precision(self):\n        \"\"\"大整数输入行为探索性断言。\n\n        期望值来源不明，需人工确认：超出 float 精确表示范围时，\n        结果依赖浮点精度，无法从 docstring 确定具体值。\n        此处仅断言返回值类型为 float 且为 0.01 的整数倍。\n        \"\"\"\n        result = rounded_ratio(9007199254740993, 9007199254740992)\n        assert isinstance(result, float)\n        assert math.isclose(result * 100, round(result * 100), abs_tol=1e-9)\n\n\nclass TestRoundedRatioError:\n    \"\"\"异常路径测试。\"\"\"\n\n    def test_rounded_ratio_non_int_hit(self):\n        \"\"\"非 int 类型入参（字符串）行为探索性断言。\n\n        期望值来源不明，需人工确认：代码无类型校验，\n        字符串与 int 相除会抛 TypeError。\n        \"\"\"\n        with pytest.raises(TypeError):\n            rounded_ratio(\"50\", 100)",
