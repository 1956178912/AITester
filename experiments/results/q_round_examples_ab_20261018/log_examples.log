          "rag_stats": null,
          "patch": "```python\ndef kth(arr, k):\n    if not arr:\n        raise ValueError(\"kth() arg is an empty sequence\")\n    if k < 0 or k >= len(arr):\n        raise IndexError(\"k out of range\")\n\n    pivot = arr[0]\n    below = [x for x in arr if x < pivot]\n    above = [x for x in arr if x > pivot]\n\n    num_less = len(below)\n    num_lessoreq = len(arr) - len(above)\n\n    if k < num_less:\n        return kth(below, k)\n    elif k >= num_lessoreq:\n        return kth(above, k - num_lessoreq)\n    else:\n        return pivot\n\n\n\"\"\"\nQuickSelect\n\nThis is an efficient equivalent to sorted(arr)[k].\n\nInput:\n    arr: A list of ints\n    k: An int\n\nPrecondition:\n    0 <= k < len(arr)\n\nOutput:\n    The kth-lowest element of arr (0-based)\n\"\"\"\n```",
          "generated_test": "import pytest\n\nfrom kth import kth\n\n\nclass TestKthNormal:\n    \"\"\"正常路径测试：满足前置条件 0 <= k < len(arr) 的输入。\"\"\"\n\n    def test_kth_single_element_k0(self):\n        \"\"\"单元素列表 k=0，应返回该唯一元素。\"\"\"\n        assert kth([5], 0) == 5\n\n    def test_kth_k0_returns_min(self):\n        \"\"\"k=0 应返回列表最小值。\"\"\"\n        assert kth([3, 1, 2], 0) == 1\n\n    def test_kth_k_last_returns_max(self):\n        \"\"\"k=len(arr)-1 应返回列表最大值。\"\"\"\n        assert kth([3, 1, 2], 2) == 3\n\n    def test_kth_k_at_pivot_returns_middle(self):\n        \"\"\"k 落在 pivot 位置时应直接返回 pivot 值。\"\"\"\n        assert kth([3, 1, 2], 1) == 2\n\n    def test_kth_with_duplicates(self):\n        \"\"\"含重复元素时第 k 小仍应正确。\"\"\"\n        assert kth([2, 2, 2, 1], 2) == 2\n\n    def test_kth_ascending_list(self):\n        \"\"\"已升序列表取第 3 小（0-based）应为 4。\"\"\"\n        assert kth([1, 2, 3, 4, 5], 3) == 4\n\n    def test_kth_descending_list(self):\n        \"\"\"已降序列表取第 1 小（0-based）应为 2。\"\"\"\n        assert kth([5, 4, 3, 2, 1], 1) == 2\n\n    @pytest.mark.parametrize(\n        \"arr, k\",\n        [\n            ([3, 1, 2], 0),\n            ([3, 1, 2], 1),\n            ([3, 1, 2], 2),\n            ([5], 0),\n            ([2, 2, 2, 1], 2),\n            ([1, 2, 3, 4, 5], 3),\n            ([5, 4, 3, 2, 1], 1),\n            ([10, -3, 7, 0, 7, 2], 4),\n        ],\n    )\n    def test_kth_matches_sorted(self, arr, k):\n        \"\"\"后置条件：返回值应等于 sorted(arr)[k]，且是 arr 中的元素。\"\"\"\n        result = kth(arr, k)\n        assert result == sorted(arr)[k]\n        assert result in arr\n\n\nclass TestKthError:\n    \"\"\"违反前置条件的输入：期望值来源不明，需人工确认。\"\"\"\n\n    def test_kth_negative_k_out_of_range(self):\n        \"\"\"k<0 违反前置条件，行为未定义。\n\n        期望值来源不明，需人工确认：实现可能返回错误元素或抛异常。\n        此处仅记录实际行为，不强制断言具体结果。\n        \"\"\"\n        try:\n            result = kth([1, 2, 3], -1)\n        except Exception as exc:  # noqa: BLE001\n            assert isinstance(exc, Exception)\n        else:\n            # 若未抛异常，仅记录返回值，不做具体值断言\n            assert result is not None or result is None\n\n    def test_kth_k_equals_len_out_of_range(self):\n        \"\"\"k==len(arr) 违反前置条件，行为未定义。\n\n        期望值来源不明，需人工确认：实现可能返回错误元素或抛异常。\n        此处仅记录实际行为，不强制断言具体结果。\n        \"\"\"\n        try:\n            result = kth([1, 2, 3], 3)\n        except Exception as exc:  # noqa: BLE001\n            assert isinstance(exc, Exception)\n        else:\n            assert result is not None or result is None\n\n    def test_kth_empty_list(self):\n        \"\"\"空列表违反前置条件，arr[0] 将抛 IndexError。\n\n        期望值来源不明，需人工确认：异常类型由实现决定。\n        此处仅记录实际行为，不强制断言具体异常类型。\n        \"\"\"\n        try:\n            result = kth([], 0)\n        except Exception as exc:  # noqa: BLE001\n            assert isinstance(exc, Exception)\n        else:\n            assert result is not None or result is None\n\n\n# SpecIR v2 确定性 oracle（compile_readiness=1.00；examples=3）\nimport pytest\nfrom collections.abc import Iterator\nfrom kth import kth\n\ndef _specir_norm_return(value):\n    \"\"\"P-1.1 返回表示归一：tuple/list→list（递归）、iterator→list、str/bytes/dict 不误归。\"\"\"\n    if isinstance(value, tuple):\n        return [_specir_norm_return(item) for item in value]\n    if isinstance(value, list):\n        return [_specir_norm_return(item) for item in value]\n    if isinstance(value, dict):\n        return {key: _specir_norm_return(item) for key, item in value.items()}\n    if isinstance(value, (str, bytes, bytearray)):\n        return value\n    if isinstance(value, Iterator):\n        return [_specir_norm_return(item) for item in value]\n    return value\n\ndef test_specir_v2_oracle():\n    try:\n        # examples（3 条规格可执行示例；期望值来自规约，不是实现）\n        assert _specir_norm_return(kth([3, 1, 2], 0)) == _specir_norm_return(1)\n        assert _specir_norm_return(kth([3, 1, 2], 2)) == _specir_norm_return(3)\n        assert _specir_norm_return(kth([5], 0)) == _specir_norm_return(5)\n    except AssertionError:\n        # 断言失败 = oracle 的语义判定信号，必须保留为 fail（不得 skip）\n        raise\n    except Exception as exc:\n        pytest.skip(f\"oracle-unavailable: {type(exc).__name__}: {exc}\")",
