          "patch": "```python\ndef is_valid_parenthesization(parens):\n    depth = 0\n    for paren in parens:\n        if paren == '(':\n            depth += 1\n        else:\n            depth -= 1\n            if depth < 0:\n                return False\n\n    return depth == 0\n\n\n\"\"\"\nNested Parens\nInput:\n    parens: A string of parentheses\n\nPrecondition:\n    all(paren in '()' for paren in parens)\n\nOutput:\n    Whether the parentheses are properly nested\n\nExamples:\n    >>> is_valid_parenthesization('((()()))()')\n    True\n    >>> is_valid_parenthesization(')()(')\n    False\n\"\"\"\n```",
          "generated_test": "import pytest\n\nfrom is_valid_parenthesization import is_valid_parenthesization\n\n\nclass TestIsValidParenthesizationNormal:\n    \"\"\"正常路径测试：符合规格的合法括号串。\"\"\"\n\n    def test_is_valid_parenthesization_nested_example(self):\n        \"\"\"docstring 示例：'((()()))()' 正确嵌套，应返回 True。\"\"\"\n        assert is_valid_parenthesization(\"((()()))()\") is True\n\n    def test_is_valid_parenthesization_leading_close(self):\n        \"\"\"docstring 示例：')()(' 以 ')' 开头，应返回 False。\"\"\"\n        assert is_valid_parenthesization(\")()(\") is False\n\n    def test_is_valid_parenthesization_alternating(self):\n        \"\"\"'()()' 多次进入退出嵌套，最终深度归零，应返回 True。\"\"\"\n        assert is_valid_parenthesization(\"()()\") is True\n\n    def test_is_valid_parenthesization_simple_pair(self):\n        \"\"\"'()' 是最简单的正确嵌套，应返回 True。\"\"\"\n        assert is_valid_parenthesization(\"()\") is True\n\n    def test_is_valid_parenthesization_deeply_nested(self):\n        \"\"\"'((()))' 深度嵌套且闭合，应返回 True。\"\"\"\n        assert is_valid_parenthesization(\"((()))\") is True\n\n\nclass TestIsValidParenthesizationBoundary:\n    \"\"\"边界条件测试。\"\"\"\n\n    def test_is_valid_parenthesization_empty_string(self):\n        \"\"\"空串不进入循环，深度为 0，应返回 True。\"\"\"\n        assert is_valid_parenthesization(\"\") is True\n\n    def test_is_valid_parenthesization_single_open(self):\n        \"\"\"单个 '(' 未闭合，最终深度为 1，按规格（最终深度必须归零）应返回 False。\n\n        期望值来源：postconditions 明确要求\"最终深度为 0\"，\n        未闭合左括号违反该后置条件，故应为 False。\n        \"\"\"\n        assert is_valid_parenthesization(\"(\") is False\n\n    def test_is_valid_parenthesization_single_close(self):\n        \"\"\"单个 ')' 使深度变为 -1，应返回 False。\"\"\"\n        assert is_valid_parenthesization(\")\") is False\n\n    def test_is_valid_parenthesization_more_open_than_close(self):\n        \"\"\"'(()' 左括号多于右括号，最终深度为 1，按规格应返回 False。\n\n        期望值来源：postconditions 要求最终深度为 0，未闭合左括号违反该条件。\n        \"\"\"\n        assert is_valid_parenthesization(\"(()\") is False\n\n    def test_is_valid_parenthesization_more_close_than_open(self):\n        \"\"\"'())' 第三个字符 ')' 使深度变为 -1，应返回 False。\"\"\"\n        assert is_valid_parenthesization(\"())\") is False\n\n    def test_is_valid_parenthesization_unbalanced_open_only(self):\n        \"\"\"'(((' 全部为左括号，最终深度为 3，按规格应返回 False。\"\"\"\n        assert is_valid_parenthesization(\"(((\") is False\n\n    def test_is_valid_parenthesization_unbalanced_close_only(self):\n        \"\"\"')))' 全部为右括号，首个字符即触发 depth<0，应返回 False。\"\"\"\n        assert is_valid_parenthesization(\")))\") is False\n\n    def test_is_valid_parenthesization_close_then_open(self):\n        \"\"\"')(' 先右后左，首个字符即触发 depth<0，应返回 False。\"\"\"\n        assert is_valid_parenthesization(\")(\") is False\n\n    def test_is_valid_parenthesization_open_close_open(self):\n        \"\"\"'()(' 最终深度为 1，按规格应返回 False。\"\"\"\n        assert is_valid_parenthesization(\"()(\") is False\n\n\nclass TestIsValidParenthesizationPreconditionViolation:\n    \"\"\"前置条件违反路径：字符非括号。规格未定义行为，仅记录实际行为。\"\"\"\n\n    def test_is_valid_parenthesization_invalid_char(self):\n        \"\"\"'(a)' 含非括号字符，违反前置条件。\n\n        期望值来源不明，需人工确认。此处仅断言返回布尔值，\n        不臆造具体 True/False 期望。\n        \"\"\"\n        result = is_valid_parenthesization(\"(a)\")\n        assert isinstance(result, bool)\n\n\n# SpecIR v2 确定性 oracle（compile_readiness=1.00；examples=3）\nimport pytest\nfrom collections.abc import Iterator\nfrom is_valid_parenthesization import is_valid_parenthesization\n\ndef _specir_norm_return(value):\n    \"\"\"P-1.1 返回表示归一：tuple/list→list（递归）、iterator→list、str/bytes/dict 不误归。\"\"\"\n    if isinstance(value, tuple):\n        return [_specir_norm_return(item) for item in value]\n    if isinstance(value, list):\n        return [_specir_norm_return(item) for item in value]\n    if isinstance(value, dict):\n        return {key: _specir_norm_return(item) for key, item in value.items()}\n    if isinstance(value, (str, bytes, bytearray)):\n        return value\n    if isinstance(value, Iterator):\n        return [_specir_norm_return(item) for item in value]\n    return value\n\ndef test_specir_v2_oracle():\n    try:\n        assert _specir_norm_return(is_valid_parenthesization('((()()))()')) == _specir_norm_return(True)\n        assert _specir_norm_return(is_valid_parenthesization(')()(')) == _specir_norm_return(False)\n        assert _specir_norm_return(is_valid_parenthesization('')) == _specir_norm_return(True)\n    except AssertionError:\n        # 断言失败 = oracle 的语义判定信号，必须保留为 fail（不得 skip）\n        raise\n    except Exception as exc:\n        pytest.skip(f\"oracle-unavailable: {type(exc).__name__}: {exc}\")",
