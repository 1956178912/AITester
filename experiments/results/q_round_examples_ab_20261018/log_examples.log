          "rag_stats": null,
          "patch": "```python\nfrom collections import deque as Queue\n\n\ndef breadth_first_search(startnode, goalnode):\n    queue = Queue()\n    queue.append(startnode)\n\n    nodesseen = set()\n    nodesseen.add(startnode)\n\n    while queue:\n        node = queue.popleft()\n\n        if node is goalnode:\n            return True\n\n        for successor in node.successors:\n            if successor not in nodesseen:\n                nodesseen.add(successor)\n                queue.append(successor)\n\n    return False\n\n\n\"\"\"\nBreadth-First Search\n\n\nInput:\n    startnode: A digraph node\n    goalnode: A digraph node\n\nOutput:\n    Whether goalnode is reachable from startnode\n\"\"\"\n```",
          "generated_test": "import pytest\n\nfrom breadth_first_search import breadth_first_search\n\n\nclass Node:\n    \"\"\"简单的有向图节点，用于测试。\"\"\"\n\n    def __init__(self, name, successors=None):\n        self.name = name\n        self.successors = successors if successors is not None else []\n\n    def __repr__(self):\n        return f\"Node({self.name})\"\n\n\ndef test_breadth_first_search_start_equals_goal():\n    \"\"\"起点即终点：startnode 与 goalnode 为同一节点，应返回 True。\"\"\"\n    a = Node(\"A\")\n    assert breadth_first_search(a, a) is True\n\n\ndef test_breadth_first_search_direct_successor():\n    \"\"\"直接后继可达：goalnode 是 startnode 的直接后继，应返回 True。\"\"\"\n    b = Node(\"B\")\n    a = Node(\"A\", [b])\n    assert breadth_first_search(a, b) is True\n\n\ndef test_breadth_first_search_multi_hop():\n    \"\"\"多跳可达：A -> B -> C，应返回 True。\"\"\"\n    c = Node(\"C\")\n    b = Node(\"B\", [c])\n    a = Node(\"A\", [b])\n    assert breadth_first_search(a, c) is True\n\n\ndef test_breadth_first_search_unreachable():\n    \"\"\"不可达：goalnode 不在可达子图中，应返回 False。\"\"\"\n    b = Node(\"B\")\n    a = Node(\"A\", [b])\n    c = Node(\"C\")\n    assert breadth_first_search(a, c) is False\n\n\ndef test_breadth_first_search_start_no_successors_not_goal():\n    \"\"\"起点无后继且非目标：队列耗尽后应返回 False。\"\"\"\n    a = Node(\"A\")\n    b = Node(\"B\")\n    assert breadth_first_search(a, b) is False\n\n\ndef test_breadth_first_search_with_cycle():\n    \"\"\"图中存在环：A <-> B，且 B -> C，应返回 True 且不死循环。\"\"\"\n    a = Node(\"A\")\n    b = Node(\"B\")\n    c = Node(\"C\")\n    a.successors = [b]\n    b.successors = [a, c]\n    assert breadth_first_search(a, c) is True\n\n\ndef test_breadth_first_search_goal_isolated_node():\n    \"\"\"目标为孤立节点：goalnode 无入边，应返回 False。\"\"\"\n    b = Node(\"B\")\n    a = Node(\"A\", [b])\n    c = Node(\"C\")\n    assert breadth_first_search(a, c) is False\n\n\ndef test_breadth_first_search_startnode_none():\n    \"\"\"startnode 为 None：访问 successors 会抛 AttributeError。\n\n    期望值来源不明，需人工确认（docstring 未定义该行为）。\n    \"\"\"\n    a = Node(\"A\")\n    with pytest.raises(AttributeError):\n        breadth_first_search(None, a)\n\n\ndef test_breadth_first_search_goalnode_none():\n    \"\"\"goalnode 为 None：任何节点都不等于它，队列耗尽返回 False。\n\n    期望值来源不明，需人工确认（docstring 未定义该行为）。\n    \"\"\"\n    b = Node(\"B\")\n    a = Node(\"A\", [b])\n    assert breadth_first_search(a, None) is False\n\n\n# SpecIR v2 确定性 oracle（compile_readiness=1.00；examples=1）\nimport pytest\nfrom collections.abc import Iterator\nfrom breadth_first_search import breadth_first_search\n\ndef _specir_norm_return(value):\n    \"\"\"P-1.1 返回表示归一：tuple/list→list（递归）、iterator→list、str/bytes/dict 不误归。\"\"\"\n    if isinstance(value, tuple):\n        return [_specir_norm_return(item) for item in value]\n    if isinstance(value, list):\n        return [_specir_norm_return(item) for item in value]\n    if isinstance(value, dict):\n        return {key: _specir_norm_return(item) for key, item in value.items()}\n    if isinstance(value, (str, bytes, bytearray)):\n        return value\n    if isinstance(value, Iterator):\n        return [_specir_norm_return(item) for item in value]\n    return value\n\ndef test_specir_v2_oracle():\n    try:\n        # examples（1 条规格可执行示例；期望值来自规约，不是实现）\n        assert _specir_norm_return(breadth_first_search({'name': 'A', 'successors': []}, {'name': 'A', 'successors': []})) == _specir_norm_return(True)\n    except AssertionError:\n        # 断言失败 = oracle 的语义判定信号，必须保留为 fail（不得 skip）\n        raise\n    except Exception as exc:\n        pytest.skip(f\"oracle-unavailable: {type(exc).__name__}: {exc}\")",
