t detected!\")\n\n\ndef test_main_case5_single_node(monkeypatch):\n    \"\"\"case5：单节点链表边界，输出 'Cycle not detected!'。\"\"\"\n    lines = _run_main_capture(monkeypatch)\n    assert lines[4].startswith(\"Cycle not detected!\")\n\n\ndef test_main_case6_tail_two_node_cycle(monkeypatch):\n    \"\"\"case6：5 节点尾部 2 节点成环，输出 'Cycle detected!'。\"\"\"\n    lines = _run_main_capture(monkeypatch)\n    assert lines[5].startswith(\"Cycle detected!\")\n\n\ndef test_main_exception_propagation(monkeypatch):\n    \"\"\"异常路径：若 detect_cycle 抛异常，main 未捕获，异常应向上传播。\n\n    期望值来源不明，需人工确认：此处仅验证异常不被 main 吞掉。\n    \"\"\"\n    import detect_cycle_test as mod\n\n    def _raise(_node):\n        raise RuntimeError(\"boom\")\n\n    monkeypatch.setattr(mod, \"detect_cycle\", _raise)\n    with pytest.raises(RuntimeError):\n        main()",
