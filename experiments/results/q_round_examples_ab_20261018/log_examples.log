          "patch": "```python\ndef lcs_length(s, t):\n    from collections import Counter\n\n    dp = Counter()\n\n    for i in range(len(s)):\n        for j in range(len(t)):\n            if s[i] == t[j]:\n                dp[i, j] = dp[i - 1, j - 1] + 1\n\n    return max(dp.values()) if dp else 0\n\n\n\n\"\"\"\nLongest Common Substring\nlongest-common-substring\n\nInput:\n    s: a string\n    t: a string\n\nOutput:\n    Length of the longest substring common to s and t\n\nExample:\n    >>> lcs_length('witch', 'sandwich')\n    2\n    >>> lcs_length('meow', 'homeowner')\n    4\n\"\"\"\n```",
          "generated_test": "import pytest\n\nfrom lcs_length import lcs_length\n\n\nclass TestLcsLengthNormal:\n    \"\"\"正常场景测试。\"\"\"\n\n    def test_lcs_length_docstring_example_witch_sandwich(self):\n        \"\"\"验证 docstring 示例：lcs_length('witch', 'sandwich') == 2。\"\"\"\n        assert lcs_length(\"witch\", \"sandwich\") == 2\n\n    def test_lcs_length_docstring_example_meow_homeowner(self):\n        \"\"\"验证 docstring 示例：lcs_length('meow', 'homeowner') == 4。\"\"\"\n        assert lcs_length(\"meow\", \"homeowner\") == 4\n\n    def test_lcs_length_identical_strings(self):\n        \"\"\"两串完全相同时，最长公共子串为整串，长度为 3。\"\"\"\n        assert lcs_length(\"abc\", \"abc\") == 3\n\n    def test_lcs_length_no_common_characters(self):\n        \"\"\"无任何公共字符时返回 0。\"\"\"\n        assert lcs_length(\"abc\", \"xyz\") == 0\n\n    def test_lcs_length_single_common_character(self):\n        \"\"\"仅公共字符 'c'，最长公共子串长度为 1。\"\"\"\n        assert lcs_length(\"abc\", \"cde\") == 1\n\n\nclass TestLcsLengthBoundary:\n    \"\"\"边界场景测试。\"\"\"\n\n    def test_lcs_length_empty_s(self):\n        \"\"\"s 为空串时返回 0。\"\"\"\n        assert lcs_length(\"\", \"abc\") == 0\n\n    def test_lcs_length_empty_t(self):\n        \"\"\"t 为空串时返回 0。\"\"\"\n        assert lcs_length(\"abc\", \"\") == 0\n\n    def test_lcs_length_both_empty(self):\n        \"\"\"两串均为空串时返回 0。\"\"\"\n        assert lcs_length(\"\", \"\") == 0\n\n    def test_lcs_length_common_substring_at_end(self):\n        \"\"\"公共子串位于字符串末尾时，长度为 2。\"\"\"\n        assert lcs_length(\"xxab\", \"yyab\") == 2\n\n    def test_lcs_length_single_character_same(self):\n        \"\"\"最小非空输入，单字符相同，返回 1。\"\"\"\n        assert lcs_length(\"a\", \"a\") == 1\n\n    def test_lcs_length_repeated_characters(self):\n        \"\"\"重复字符场景，最长公共子串受较短串长度限制，返回 2。\"\"\"\n        assert lcs_length(\"aaaa\", \"aa\") == 2\n\n    def test_lcs_length_large_length_difference(self):\n        \"\"\"长度差异极大时，返回值不超过较短串长度。\"\"\"\n        s = \"a\" * 100\n        t = \"a\"\n        result = lcs_length(s, t)\n        assert result == 1\n        assert result <= min(len(s), len(t))\n\n\nclass TestLcsLengthPostconditions:\n    \"\"\"后置条件与不变量测试。\"\"\"\n\n    @pytest.mark.parametrize(\n        \"s,t\",\n        [\n            (\"witch\", \"sandwich\"),\n            (\"meow\", \"homeowner\"),\n            (\"abc\", \"abc\"),\n            (\"abc\", \"xyz\"),\n            (\"\", \"abc\"),\n            (\"abc\", \"\"),\n            (\"\", \"\"),\n            (\"a\", \"a\"),\n            (\"aaaa\", \"aa\"),\n            (\"xxab\", \"yyab\"),\n        ],\n    )\n    def test_lcs_length_postconditions(self, s, t):\n        \"\"\"返回值应为非负整数，且不超过 min(len(s), len(t))。\"\"\"\n        result = lcs_length(s, t)\n        assert isinstance(result, int)\n        assert result >= 0\n        assert result <= min(len(s), len(t))\n\n    @pytest.mark.parametrize(\n        \"s,t\",\n        [\n            (\"\", \"abc\"),\n            (\"abc\", \"\"),\n            (\"\", \"\"),\n        ],\n    )\n    def test_lcs_length_empty_input_returns_zero(self, s, t):\n        \"\"\"任一串为空串时返回值必须为 0。\"\"\"\n        assert lcs_length(s, t) == 0\n\n\nclass TestLcsLengthError:\n    \"\"\"异常/未定义行为测试。\"\"\"\n\n    def test_lcs_length_non_string_input(self):\n        \"\"\"非字符串入参行为未在规格中定义。\n\n        期望值来源不明，需人工确认。\n        此处仅记录实际行为：若抛出异常则接受，若返回整数则校验基本不变量。\n        \"\"\"\n        try:\n            result = lcs_length(123, \"abc\")\n        except Exception:\n            # 规格未定义该输入行为，抛出异常是可接受的\n            return\n        # 若未抛异常，则至少应满足返回值的基本不变量\n        assert isinstance(result, int)\n        assert result >= 0\n\n\n# SpecIR v2 确定性 oracle（compile_readiness=1.00；examples=3）\nimport pytest\nfrom collections.abc import Iterator\nfrom lcs_length import lcs_length\n\ndef _specir_norm_return(value):\n    \"\"\"P-1.1 返回表示归一：tuple/list→list（递归）、iterator→list、str/bytes/dict 不误归。\"\"\"\n    if isinstance(value, tuple):\n        return [_specir_norm_return(item) for item in value]\n    if isinstance(value, list):\n        return [_specir_norm_return(item) for item in value]\n    if isinstance(value, dict):\n        return {key: _specir_norm_return(item) for key, item in value.items()}\n    if isinstance(value, (str, bytes, bytearray)):\n        return value\n    if isinstance(value, Iterator):\n        return [_specir_norm_return(item) for item in value]\n    return value\n\ndef test_specir_v2_oracle():\n    try:\n        # examples（3 条规格可执行示例；期望值来自规约，不是实现）\n        assert _specir_norm_return(lcs_length('witch', 'sandwich')) == _specir_norm_return(2)\n        assert _specir_norm_return(lcs_length('meow', 'homeowner')) == _specir_norm_return(4)\n        assert _specir_norm_return(lcs_length('', 'abc')) == _specir_norm_return(0)\n    except AssertionError:\n        # 断言失败 = oracle 的语义判定信号，必须保留为 fail（不得 skip）\n        raise\n    except Exception as exc:\n        pytest.skip(f\"oracle-unavailable: {type(exc).__name__}: {exc}\")",
