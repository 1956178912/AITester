          "rag_stats": null,
          "patch": "```python\ndef levenshtein(source, target):\n    if source == '' or target == '':\n        return len(source) or len(target)\n\n    elif source[0] == target[0]:\n        return levenshtein(source[1:], target[1:])\n\n    else:\n        return 1 + min(\n            levenshtein(source,     target[1:]),\n            levenshtein(source[1:], target[1:]),\n            levenshtein(source[1:], target)\n        )\n\n\"\"\"\nLevenshtein Distance\n\n\nCalculates the Levenshtein distance between two strings.  The Levenshtein distance is defined as the minimum amount of single-character edits (either removing a character, adding a character, or changing a character) necessary to transform a source string into a target string.\n\nInput:\n    source: The string you begin with.\n    target: The string to transform into.\n\nOutput:\n    The Levenshtein distance between the source and target.\n\nExample:\n    electron can be transformed into neutron by removing the e, turning the l into n, and turning the c into u.\n    >>> levenshtein(electron, neutron)\n    3\n\"\"\"\n```",
          "generated_test": "import pytest\n\nfrom levenshtein import levenshtein\n\n\ndef test_levenshtein_identical_non_empty_strings():\n    \"\"\"两串完全相同时编辑距离为 0。\"\"\"\n    assert levenshtein(\"abc\", \"abc\") == 0\n\n\ndef test_levenshtein_docstring_example_electron_neutron():\n    \"\"\"验证 docstring 示例：electron -> neutron 距离为 3。\"\"\"\n    assert levenshtein(\"electron\", \"neutron\") == 3\n\n\ndef test_levenshtein_single_char_substitution():\n    \"\"\"单字符不同需一次替换，距离为 1。\"\"\"\n    assert levenshtein(\"a\", \"b\") == 1\n\n\ndef test_levenshtein_empty_source():\n    \"\"\"source 为空串时返回 len(target)。\"\"\"\n    assert levenshtein(\"\", \"abc\") == 3\n\n\ndef test_levenshtein_empty_target():\n    \"\"\"target 为空串时返回 len(source)。\"\"\"\n    assert levenshtein(\"abc\", \"\") == 3\n\n\ndef test_levenshtein_both_empty():\n    \"\"\"两串均为空串时返回 0。\"\"\"\n    assert levenshtein(\"\", \"\") == 0\n\n\ndef test_levenshtein_single_char_identical():\n    \"\"\"最小非空相同串返回 0。\"\"\"\n    assert levenshtein(\"a\", \"a\") == 0\n\n\ndef test_levenshtein_pure_insertion():\n    \"\"\"仅需插入一个字符，距离为 1。\"\"\"\n    assert levenshtein(\"abc\", \"abcd\") == 1\n\n\ndef test_levenshtein_pure_deletion():\n    \"\"\"仅需删除一个字符，距离为 1。\"\"\"\n    assert levenshtein(\"abcd\", \"abc\") == 1\n\n\ndef test_levenshtein_completely_different_equal_length():\n    \"\"\"三个字符全部替换，距离为 3。\"\"\"\n    assert levenshtein(\"abc\", \"xyz\") == 3\n\n\ndef test_levenshtein_non_string_input():\n    \"\"\"非字符串输入：期望值来源不明，需人工确认。\n\n    代码未做类型校验，传入非字符串会在切片/比较处抛异常，\n    具体异常类型未在规格中定义，此处仅记录实际行为。\n    \"\"\"\n    with pytest.raises(Exception):\n        levenshtein(123, \"abc\")\n\n\n@pytest.mark.parametrize(\n    \"source,target,expected\",\n    [\n        (\"abc\", \"abc\", 0),\n        (\"electron\", \"neutron\", 3),\n        (\"a\", \"b\", 1),\n        (\"\", \"abc\", 3),\n        (\"abc\", \"\", 3),\n        (\"\", \"\", 0),\n        (\"a\", \"a\", 0),\n        (\"abc\", \"abcd\", 1),\n        (\"abcd\", \"abc\", 1),\n        (\"abc\", \"xyz\", 3),\n    ],\n)\ndef test_levenshtein_parametrized_cases(source, target, expected):\n    \"\"\"参数化覆盖计划中的正常与边界用例。\"\"\"\n    assert levenshtein(source, target) == expected\n\n\n@pytest.mark.parametrize(\n    \"source,target\",\n    [\n        (\"\", \"\"),\n        (\"abc\", \"abc\"),\n        (\"electron\", \"neutron\"),\n        (\"a\", \"b\"),\n        (\"\", \"abc\"),\n        (\"abc\", \"\"),\n        (\"abc\", \"abcd\"),\n        (\"abcd\", \"abc\"),\n        (\"abc\", \"xyz\"),\n    ],\n)\ndef test_levenshtein_postconditions(source, target):\n    \"\"\"后置条件：返回非负整数，且不超过两串最大长度。\"\"\"\n    result = levenshtein(source, target)\n    assert isinstance(result, int)\n    assert result >= 0\n    assert result <= max(len(source), len(target))\n    if source == target:\n        assert result == 0\n    else:\n        assert result >= 1\n\n\n# SpecIR v2 确定性 oracle（compile_readiness=1.00；examples=3）\nimport pytest\nfrom collections.abc import Iterator\nfrom levenshtein import levenshtein\n\ndef _specir_norm_return(value):\n    \"\"\"P-1.1 返回表示归一：tuple/list→list（递归）、iterator→list、str/bytes/dict 不误归。\"\"\"\n    if isinstance(value, tuple):\n        return [_specir_norm_return(item) for item in value]\n    if isinstance(value, list):\n        return [_specir_norm_return(item) for item in value]\n    if isinstance(value, dict):\n        return {key: _specir_norm_return(item) for key, item in value.items()}\n    if isinstance(value, (str, bytes, bytearray)):\n        return value\n    if isinstance(value, Iterator):\n        return [_specir_norm_return(item) for item in value]\n    return value\n\ndef test_specir_v2_oracle():\n    try:\n        # examples（3 条规格可执行示例；期望值来自规约，不是实现）\n        assert _specir_norm_return(levenshtein('electron', 'neutron')) == _specir_norm_return(3)\n        assert _specir_norm_return(levenshtein('', '')) == _specir_norm_return(0)\n        assert _specir_norm_return(levenshtein('abc', 'abc')) == _specir_norm_return(0)\n    except AssertionError:\n        # 断言失败 = oracle 的语义判定信号，必须保留为 fail（不得 skip）\n        raise\n    except Exception as exc:\n        pytest.skip(f\"oracle-unavailable: {type(exc).__name__}: {exc}\")",
