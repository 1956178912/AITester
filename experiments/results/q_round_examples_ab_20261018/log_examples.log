for x in result)\n\n    if n == 1:\n        assert result == []\n    else:\n        # 乘积等于 n\n        product = 1\n        for x in result:\n            product *= x\n        assert product == n\n\n\ndef test_get_factors_zero_violates_precondition():\n    \"\"\"n=0 违反前置条件 n>=1，期望值来源不明，需人工确认；此处仅记录实际行为。\n\n    期望值来源不明，需人工确认。\n    \"\"\"\n    try:\n        result = get_factors(0)\n    except Exception:\n        # 若实现抛出异常，视为可接受（前置条件被违反）\n        return\n    # 若未抛出异常，仅记录实际返回值，不做强断言\n    assert isinstance(result, list)\n\n\ndef test_get_factors_negative_violates_precondition():\n    \"\"\"n=-5 违反前置条件 n>=1，期望值来源不明，需人工确认；此处仅记录实际行为。\n\n    期望值来源不明，需人工确认。\n    \"\"\"\n    try:\n        result = get_factors(-5)\n    except Exception:\n        # 若实现抛出异常，视为可接受（前置条件被违反）\n        return\n    # 若未抛出异常，仅记录实际返回值，不做强断言\n    assert isinstance(result, list)\n\n\n# SpecIR v2 确定性 oracle（compile_readiness=1.00；examples=3）\nimport pytest\nfrom collections.abc import Iterator\nfrom get_factors import get_factors\n\ndef _specir_norm_return(value):\n    \"\"\"P-1.1 返回表示归一：tuple/list→list（递归）、iterator→list、str/bytes/dict 不误归。\"\"\"\n    if isinstance(value, tuple):\n        return [_specir_norm_return(item) for item in value]\n    if isinstance(value, list):\n        return [_specir_norm_return(item) for item in value]\n    if isinstance(value, dict):\n        return {key: _specir_norm_return(item) for key, item in value.items()}\n    if isinstance(value, (str, bytes, bytearray)):\n        return value\n    if isinstance(value, Iterator):\n        return [_specir_norm_return(item) for item in value]\n    return value\n\ndef test_specir_v2_oracle():\n    try:\n        assert _specir_norm_return(get_factors(1)) == _specir_norm_return([])\n        assert _specir_norm_return(get_factors(100)) == _specir_norm_return([2, 2, 5, 5])\n        assert _specir_norm_return(get_factors(101)) == _specir_norm_return([101])\n    except AssertionError:\n        # 断言失败 = oracle 的语义判定信号，必须保留为 fail（不得 skip）\n      