          "generated_test": "import pytest\n\nfrom gcd import gcd\n\n\nclass TestGcdNormal:\n    \"\"\"正常路径测试。\"\"\"\n\n    def test_gcd_two_positive_integers(self):\n        \"\"\"docstring 示例：gcd(35, 21) 应为 7。\"\"\"\n        assert gcd(35, 21) == 7\n\n    def test_gcd_coprime_numbers(self):\n        \"\"\"互质输入 gcd(9, 28) 应为 1，覆盖 a<b 首次取模交换路径。\"\"\"\n        assert gcd(9, 28) == 1\n\n    def test_gcd_equal_numbers(self):\n        \"\"\"相等输入 gcd(12, 12) 应返回自身 12。\"\"\"\n        assert gcd(12, 12) == 12\n\n\nclass TestGcdBoundary:\n    \"\"\"边界路径测试。\"\"\"\n\n    def test_gcd_b_is_zero(self):\n        \"\"\"b==0 终止分支：gcd(5, 0) 应为 5。\"\"\"\n        assert gcd(5, 0) == 5\n\n    def test_gcd_a_is_zero_b_nonzero(self):\n        \"\"\"a==0 且 b>0：gcd(0, 7) 应为 7。\"\"\"\n        assert gcd(0, 7) == 7\n\n    def test_gcd_a_is_one(self):\n        \"\"\"含 1 时 gcd(1, 100) 应为 1。\"\"\"\n        assert gcd(1, 100) == 1\n\n    def test_gcd_both_zero(self):\n        \"\"\"0 与 0 的最大公约数规格未明确定义，期望值来源不明，需人工确认。\n\n        实现会返回 0，此处记录实际行为并断言与实现一致。\n        \"\"\"\n        result = gcd(0, 0)\n        assert result == 0\n\n\nclass TestGcdPostconditions:\n    \"\"\"后置条件验证。\"\"\"\n\n    @pytest.mark.parametrize(\n        \"a, b\",\n        [\n            (35, 21),\n            (9, 28),\n            (12, 12),\n            (5, 0),\n            (0, 7),\n            (1, 100),\n            (100, 75),\n            (17, 5),\n        ],\n    )\n    def test_gcd_postconditions(self, a, b):\n        \"\"\"返回值应为非负整数，且能整除 a 与 b。\"\"\"\n        result = gcd(a, b)\n        assert isinstance(result, int)\n        assert result >= 0\n        if result != 0:\n            assert a % result == 0\n            assert b % result == 0\n\n\nclass TestGcdError:\n    \"\"\"违反前置条件的输入，规格未定义行为，期望值来源不明，需人工确认。\"\"\"\n\n    def test_gcd_negative_input(self):\n        \"\"\"负数输入违反前置条件 a>=0，规格未定义行为。\n\n        期望值来源不明，需人工确认；此处仅记录实际行为，不强制具体值。\n        \"\"\"\n        try:\n            result = gcd(-4, 6)\n        except Exception:\n            # 实现可能抛出异常，视为可接受\n            return\n        # 若未抛异常，仅记录实际返回值，不做具体值断言\n        assert isinstance(result, int)\n\n    def test_gcd_non_integer_input(self):\n        \"\"\"浮点输入违反前置条件 isinstance(a,int)，规格未定义行为。\n\n        期望值来源不明，需人工确认；此处仅记录实际行为，不强制具体值。\n        \"\"\"\n        try:\n            result = gcd(3.5, 2)\n        except Exception:\n            # 实现可能抛出异常，视为可接受\n            return\n        # 若未抛异常，仅记录实际返回值，不做具体值断言\n        assert result is not None\n\n\n# SpecIR v2 确定性 oracle（compile_readiness=1.00；examples=3）\nimport pytest\nfrom collections.abc import Iterator\nfrom gcd import gcd\n\ndef _specir_norm_return(value):\n    \"\"\"P-1.1 返回表示归一：tuple/list→list（递归）、iterator→list、str/bytes/dict 不误归。\"\"\"\n    if isinstance(value, tuple):\n        return [_specir_norm_return(item) for item in value]\n    if isinstance(value, list):\n        return [_specir_norm_return(item) for item in value]\n    if isinstance(value, dict):\n        return {key: _specir_norm_return(item) for key, item in value.items()}\n    if isinstance(value, (str, bytes, bytearray)):\n        return value\n    if isinstance(value, Iterator):\n        return [_specir_norm_return(item) for item in value]\n    return value\n\ndef test_specir_v2_oracle():\n    try:\n        assert _specir_norm_return(gcd(35, 21)) == _specir_norm_return(7)\n        assert _specir_norm_return(gcd(5, 0)) == _specir_norm_return(5)\n        assert _specir_norm_return(gcd(0, 7)) == _specir_norm_return(7)\n    except AssertionError:\n        # 断言失败 = oracle 的语义判定信号，必须保留为 fail（不得 skip）\n        raise\n    except Exception as exc:\n        pytest.skip(f\"oracle-unavailable: {type(exc).__name__}: {exc}\")",
