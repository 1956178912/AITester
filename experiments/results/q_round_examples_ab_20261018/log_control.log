          "generated_test": "import pytest\n\nfrom detect_cycle import detect_cycle\n\n\nclass Node:\n    \"\"\"单链表节点，具备 successor 属性。\"\"\"\n\n    def __init__(self, successor=None):\n        self.successor = successor\n\n\ndef make_chain(values):\n    \"\"\"根据值列表构造无环链，返回头节点。\"\"\"\n    nodes = [Node() for _ in values]\n    for i in range(len(nodes) - 1):\n        nodes[i].successor = nodes[i + 1]\n    return nodes[0] if nodes else None\n\n\ndef test_detect_cycle_empty_list_returns_false():\n    \"\"\"空链表（node 为 None）按 docstring 语义应返回 False。\n\n    期望值来源：docstring 约定空链表无环。注意实现未对 None 判空，\n    实际可能抛 AttributeError，此处按 docstring 约定断言。\n    \"\"\"\n    assert detect_cycle(None) is False\n\n\ndef test_detect_cycle_single_node_no_cycle():\n    \"\"\"单节点且 successor 为 None，应返回 False。\"\"\"\n    node = Node()\n    assert detect_cycle(node) is False\n\n\ndef test_detect_cycle_single_node_self_loop():\n    \"\"\"单节点自环（successor 指向自身），应返回 True。\"\"\"\n    node = Node()\n    node.successor = node\n    assert detect_cycle(node) is True\n\n\ndef test_detect_cycle_two_nodes_cycle():\n    \"\"\"两节点互指成环 A->B->A，应返回 True。\"\"\"\n    a = Node()\n    b = Node()\n    a.successor = b\n    b.successor = a\n    assert detect_cycle(a) is True\n\n\ndef test_detect_cycle_multi_node_no_cycle():\n    \"\"\"多节点无环链 A->B->C->D->None，应返回 False。\"\"\"\n    head = make_chain([1, 2, 3, 4])\n    assert detect_cycle(head) is False\n\n\ndef test_detect_cycle_cycle_at_tail():\n    \"\"\"环位于尾部 A->B->C->D->B，应返回 True。\"\"\"\n    a = Node()\n    b = Node()\n    c = Node()\n    d = Node()\n    a.successor = b\n    b.successor = c\n    c.successor = d\n    d.successor = b\n    assert detect_cycle(a) is True\n\n\ndef test_detect_cycle_two_nodes_no_cycle():\n    \"\"\"两节点无环 A->B->None，应返回 False。\"\"\"\n    head = make_chain([1, 2])\n    assert detect_cycle(head) is False\n\n\ndef test_detect_cycle_node_missing_successor_raises():\n    \"\"\"节点缺少 successor 属性时，访问 hare.successor 应抛 AttributeError。\n\n    期望值来源不明，