irst_search(simple_graph[\"a\"], simple_graph[\"c\"])\n    assert result is True\n\n\ndef test_depth_first_search_unreachable(simple_graph):\n    \"\"\"不可达节点：goalnode 不在 startnode 的连通分量中，应返回 False。\"\"\"\n    result = depth_first_search(simple_graph[\"a\"], simple_graph[\"x\"])\n    assert result is False\n\n\ndef test_depth_first_search_leaf_start_not_goal():\n    \"\"\"起点无后继且非目标：successors 为空且不是 goalnode，应返回 False。\"\"\"\n    node_leaf = Node(\"leaf\")\n    node_x = Node(\"x\")\n    result = depth_first_search(node_leaf, node_x)\n    assert result is False\n\n\ndef test_depth_first_search_cycle_unreachable(cyclic_graph):\n    \"\"\"图中存在环：搜索需通过 nodesvisited 避免无限递归，最终返回 False。\"\"\"\n    result = depth_first_search(cyclic_graph[\"a\"], cyclic_graph[\"x\"])\n    assert result is False\n\n\ndef test_depth_first_search_cycle_reachable(cyclic_graph):\n    \"\"\"环中可达目标：图中存在环但目标可达，应返回 True。\"\"\"\n    result = depth_first_search(cyclic_graph[\"a\"], cyclic_graph[\"c\"])\n    assert result is True\n\n\ndef test_depth_first_search_branching_second_branch(branching_graph):\n    \"\"\"多分支图目标在第二分支：目标位于非首个分支，应返回 True。\"\"\"\n    result = depth_first_search(branching_graph[\"a\"], branching_graph[\"d\"])\n    assert result is True\n\n\ndef test_depth_first_search_missing_successors_attr():\n    \"\"\"startnode 缺少 successors 属性：访问 node.successors 抛出 AttributeError。\n\n    期望值来源不明，需人工确认：代码未定义异常处理，此处记录实际行为。\n    \"\"\"\n    invalid_node = InvalidNode(\"invalid\")\n    node_b = Node(\"b\")\n    with pytest.raises(AttributeError):\n        depth_first_search(invalid_node, node_b)\n\n\ndef test_depth_first_search_successors_none():\n    \"\"\"successors 为 None：迭代 None 抛出 TypeError。\n\n    期望值来源不明，需人工确认：代码未定义异常处理，此处记录实际行为。\n    \"\"\"\n    node_none_succ = Node(\"none_succ\", successors=None)\n    node_none_succ.successors = None\n    node_b = Node(\"b\")\n    with pytest.raises(TypeError):\n        depth_first_search(node_none_succ, node_b)\n\n\ndef test_depth_first_search_returns_boo