          "rag_stats": null,
          "patch": "```python\ndef kth(arr, k):\n    pivot = arr[0]\n    below = [x for x in arr if x < pivot]\n    above = [x for x in arr if x > pivot]\n\n    num_less = len(below)\n    num_lessoreq = len(arr) - len(above)\n\n    if k < num_less:\n        return kth(below, k)\n    elif k >= num_lessoreq:\n        return kth(above, k - num_lessoreq)\n    else:\n        return pivot\n\n\n\n\"\"\"\nQuickSelect\n\nThis is an efficient equivalent to sorted(arr)[k].\n\nInput:\n    arr: A list of ints\n    k: An int\n\nPrecondition:\n    0 <= k < len(arr)\n\nOutput:\n    The kth-lowest element of arr (0-based)\n\"\"\"\n```",
          "generated_test": "import pytest\n\nfrom kth import kth\n\n\nclass TestKthNormal:\n    \"\"\"正常路径测试。\"\"\"\n\n    def test_kth_single_element(self):\n        \"\"\"单元素列表：最小规模输入，pivot 直接返回。\"\"\"\n        assert kth([5], 0) == 5\n\n    def test_kth_k_zero_returns_min(self):\n        \"\"\"k 为 0 时返回最小值，覆盖递归进入 below 分支。\"\"\"\n        assert kth([3, 1, 2], 0) == 1\n\n    def test_kth_k_last_returns_max(self):\n        \"\"\"k 为末位时返回最大值，覆盖递归进入 above 分支。\"\"\"\n        assert kth([3, 1, 2], 2) == 3\n\n    def test_kth_k_middle_returns_pivot(self):\n        \"\"\"k 为中间值时直接返回 pivot。\"\"\"\n        assert kth([3, 1, 2], 1) == 2\n\n\nclass TestKthBoundary:\n    \"\"\"边界条件测试。\"\"\"\n\n    def test_kth_all_equal_elements(self):\n        \"\"\"全部元素相等：below 与 above 均为空，直接返回 pivot。\"\"\"\n        assert kth([4, 4, 4], 1) == 4\n\n    def test_kth_ascending_list(self):\n        \"\"\"已升序列表下的递归路径。\"\"\"\n        assert kth([1, 2, 3, 4, 5], 3) == 4\n\n    def test_kth_descending_list(self):\n        \"\"\"已降序列表下的递归路径。\"\"\"\n        assert kth([5, 4, 3, 2, 1], 1) == 2\n\n    def test_kth_with_negative_and_zero(self):\n        \"\"\"含负数与 0 参与比较。\"\"\"\n        assert kth([0, -1, 2, -3], 0) == -3\n\n    @pytest.mark.parametrize(\n        \"arr, k\",\n        [\n            ([5], 0),\n            ([3, 1, 2], 0),\n            ([3, 1, 2], 1),\n            ([3, 1, 2], 2),\n            ([4, 4, 4], 1),\n            ([1, 2, 3, 4, 5], 3),\n            ([5, 4, 3, 2, 1], 1),\n            ([0, -1, 2, -3], 0),\n            ([10, -10, 0, 5, 5, 3], 2),\n        ],\n    )\n    def test_kth_matches_sorted(self, arr, k):\n        \"\"\"返回值应等于 sorted(arr)[k]，且是 arr 中的元素。\"\"\"\n        result = kth(arr, k)\n        assert result == sorted(arr)[k]\n        assert result in arr\n\n\nclass TestKthError:\n    \"\"\"违反前置条件的错误用例。\n\n    期望值来源不明，需人工确认：代码未定义越界/空列表行为，\n    可能无限递归、抛异常或返回错误结果。此处仅记录实际行为，\n    不做恒失败断言。\n    \"\"\"\n\n    def test_kth_negative_k_behavior(self):\n        \"\"\"k 为负数越界：记录实际行为（期望值来源不明，需人工确认）。\"\"\"\n        try:\n            result = kth([1, 2, 3], -1)\n        except Exception as exc:  # noqa: BLE001\n            assert isinstance(exc, Exception)\n        else:\n            # 若未抛异常，仅记录结果，不臆造期望值\n            assert result is not None or result is None\n\n    def test_kth_k_equals_length_behavior(self):\n        \"\"\"k 等于长度越界：记录实际行为（期望值来源不明，需人工确认）。\"\"\"\n        try:\n            result = kth([1, 2, 3], 3)\n        except Exception as exc:  # noqa: BLE001\n            assert isinstance(exc, Exception)\n        else:\n            assert result is not None or result is None\n\n    def test_kth_empty_list_raises(self):\n        \"\"\"空列表：arr[0] 将抛 IndexError（期望值来源不明，需人工确认）。\"\"\"\n        with pytest.raises(IndexError):\n            kth([], 0)\n\n\n# SpecIR v2 确定性 oracle（compile_readiness=1.00）\nimport pytest\nfrom kth import kth\n\ndef test_specir_v2_oracle():\n    try:\n        arr, k = 0, 0\n        # [未断言·无满足前件的见证] # pre: len(arr) > 0\n        # [未断言·无满足前件的见证] assert len(arr) > 0\n        # [未断言·无满足前件的见证] # pre: 0 <= k < len(arr)\n        # [未断言·无满足前件的见证] assert 0 <= k < len(arr)\n        r = kth(arr, k)\n        # post: result == sorted(arr)[k]\n        assert r == sorted(arr)[k]\n        # post: result in arr\n        assert r in arr\n    except AssertionError:\n        # 断言失败 = oracle 的语义判定信号，必须保留为 fail（不得 skip）\n        raise\n    except Exception as exc:\n        pytest.skip(f\"oracle-unavailable: {type(exc).__name__}: {exc}\")",
