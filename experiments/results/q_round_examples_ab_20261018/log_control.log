d_x_greater_than_all(self):\n        \"\"\"x 大于所有元素，上界外未命中返回 -1。\"\"\"\n        arr = [2, 3, 4]\n        assert find_first_in_sorted(arr, 9) == -1\n\n    def test_find_first_in_sorted_all_elements_same(self):\n        \"\"\"全部元素相同，验证返回最低索引 0。\"\"\"\n        arr = [5, 5, 5, 5]\n        assert find_first_in_sorted(arr, 5) == 0\n\n    def test_find_first_in_sorted_large_integers(self):\n        \"\"\"大整数边界（Python 无溢出），返回索引 1。\"\"\"\n        arr = [1000000000000000000, 1000000000000000001]\n        assert find_first_in_sorted(arr, 1000000000000000001) == 1\n\n\nclass TestFindFirstInSortedError:\n    \"\"\"错误/未命中路径测试。\"\"\"\n\n    def test_find_first_in_sorted_negative_miss(self):\n        \"\"\"负数未命中路径，返回 -1。\"\"\"\n        arr = [0, 1, 2]\n        assert find_first_in_sorted(arr, -1) == -1\n\n\nclass TestFindFirstInSortedPostconditions:\n    \"\"\"后置条件验证测试。\"\"\"\n\n    @pytest.mark.parametrize(\n        \"arr, x\",\n        [\n            ([3, 4, 5, 5, 5, 5, 6], 5),\n            ([1, 2, 3, 4, 5], 3),\n            ([1, 2, 3], 1),\n            ([1, 2, 3], 3),\n            ([], 1),\n            ([7], 7),\n            ([7], 5),\n            ([2, 3, 4], 1),\n            ([2, 3, 4], 9),\n            ([5, 5, 5, 5], 5),\n            ([1, 2, 2, 2, 3], 2),\n            ([-5, -3, -1, 0], -3),\n            ([0, 1, 2], -1),\n            ([1000000000000000000, 1000000000000000001], 1000000000000000001),\n        ],\n    )\n    def test_find_first_in_sorted_postconditions(self, arr, x):\n        \"\"\"验证后置条件：返回 -1 或返回最低索引且 arr[result] == x。\"\"\"\n        result = find_first_in_sorted(arr, x)\n        assert isinstance(result, int)\n        if result == -1:\n            assert x not in arr\n        else:\n            assert 0 <= result < len(arr)\n            assert arr[result] == x\n            assert result == 0 or arr[result - 1] != x\n\n\n# SpecIR v2 确定性 oracle（compile_readiness=0.67；instrument: no-valid-input）\nimport pytest\nfrom find_first_in_sorted import find_first_in_sorte