          "patch": "```python\nfrom collections import deque as Queue\n\n\ndef breadth_first_search(startnode, goalnode):\n    queue = Queue()\n    queue.append(startnode)\n\n    nodesseen = set()\n    nodesseen.add(startnode)\n\n    while queue:\n        node = queue.popleft()\n\n        if node is goalnode:\n            return True\n        else:\n            for successor in node.successors:\n                if successor not in nodesseen:\n                    nodesseen.add(successor)\n                    queue.append(successor)\n\n    return False\n\n\n\"\"\"\nBreadth-First Search\n\n\nInput:\n    startnode: A digraph node\n    goalnode: A digraph node\n\nOutput:\n    Whether goalnode is reachable from startnode\n\"\"\"\n```",
          "generated_test": "import pytest\n\nfrom breadth_first_search import breadth_first_search\n\n\nclass Node:\n    def __init__(self, name):\n        self.name = name\n        self.successors = []\n\n    def __repr__(self):\n        return f\"Node({self.name})\"\n\n\ndef make_node(name, successors=None):\n    n = Node(name)\n    if successors is not None:\n        n.successors = successors\n    return n\n\n\ndef test_breadth_first_search_start_is_goal():\n    \"\"\"起点即目标：startnode is goalnode 应立即返回 True。\"\"\"\n    a = make_node(\"a\")\n    assert breadth_first_search(a, a) is True\n\n\ndef test_breadth_first_search_direct_successor():\n    \"\"\"直接后继可达：a->b，应返回 True。\"\"\"\n    b = make_node(\"b\")\n    a = make_node(\"a\", [b])\n    assert breadth_first_search(a, b) is True\n\n\ndef test_breadth_first_search_multi_hop():\n    \"\"\"多跳可达：a->b->c，应返回 True。\"\"\"\n    c = make_node(\"c\")\n    b = make_node(\"b\", [c])\n    a = make_node(\"a\", [b])\n    assert breadth_first_search(a, c) is True\n\n\ndef test_breadth_first_search_unreachable_returns_false():\n    \"\"\"不可达目标：目标不在图中，按规约应返回 False（布尔值）。\n\n    期望值来源：docstring 明确 Output 为 Whether goalnode is reachable，\n    不可达时必须返回 False，且必须是 bool 类型。\n    \"\"\"\n    x = make_node(\"x\")\n    a = make_node(\"a\")\n    result = breadth_first_search(a, x)\n    assert result is False\n    assert isinstance(result, bool)\n\n\ndef test_breadth_first_search_empty_successors_non_goal_returns_false():\n    \"\"\"空后继且非目标：a.successors=[] 且 a 不是 b，按规约应返回 False。\n\n    期望值来源：docstring 规约——不可达返回 False。\n    \"\"\"\n    b = make_node(\"b\")\n    a = make_node(\"a\", [])\n    result = breadth_first_search(a, b)\n    assert result is False\n    assert isinstance(result, bool)\n\n\ndef test_breadth_first_search_cycle():\n    \"\"\"含环图：a->b->a，且 b->c，应能去重并最终到达 c 返回 True。\"\"\"\n    c = make_node(\"c\")\n    a = make_node(\"a\")\n    b = make_node(\"b\", [a, c])\n    a.successors = [b]\n    assert breadth_first_search(a, c) is True\n\n\ndef test_breadth_first_search_duplicate_successors():\n    \"\"\"重复后继：successors 含重复节点，去重后仍应正确返回 True。\"\"\"\n    b = make_node(\"b\")\n    a = make_node(\"a\", [b, b, b])\n    assert breadth_first_search(a, b) is True\n\n\ndef test_breadth_first_search_goal_none_returns_false():\n    \"\"\"目标为 None：非图节点，不可达，按规约应返回 False（布尔值）。\n\n    期望值来源：docstring 规约——None 不是可达节点，应返回 False。\n    \"\"\"\n    a = make_node(\"a\")\n    result = breadth_first_search(a, None)\n    assert result is False\n    assert isinstance(result, bool)\n\n\ndef test_breadth_first_search_return_type_is_bool_on_unreachable():\n    \"\"\"不可达时返回值必须是 bool 类型（杀死 return None / return 空容器 变异体）。\"\"\"\n    x = make_node(\"x\")\n    a = make_node(\"a\")\n    result = breadth_first_search(a, x)\n    assert type(result) is bool\n    assert result is False\n\n\ndef test_breadth_first_search_return_type_is_bool_on_reachable():\n    \"\"\"可达时返回值必须是 bool 类型 True。\"\"\"\n    b = make_node(\"b\")\n    a = make_node(\"a\", [b])\n    result = breadth_first_search(a, b)\n    assert type(result) is bool\n    assert result is True\n\n\ndef test_breadth_first_search_unreachable_in_larger_graph():\n    \"\"\"较大图中不可达：a->b->c，目标 x 不在图中，应返回 False。\"\"\"\n    c = make_node(\"c\")\n    b = make_node(\"b\", [c])\n    a = make_node(\"a\", [b])\n    x = make_node(\"x\")\n    result = breadth_first_search(a, x)\n    assert result is False\n    assert isinstance(result, bool)\n\n\ndef test_breadth_first_search_self_loop_unreachable():\n    \"\"\"自环图且目标不可达：a->a，目标 x 不可达，应返回 False。\"\"\"\n    a = make_node(\"a\")\n    a.successors = [a]\n    x = make_node(\"x\")\n    result = breadth_first_search(a, x)\n    assert result is False\n    assert isinstance(result, bool)\n\n\n# SpecIR v2 确定性 oracle（compile_readiness=1.00）\nimport pytest\nfrom breadth_first_search import breadth_first_search\n\ndef test_specir_v2_oracle():\n    try:\n        startnode, goalnode = 0, 0\n        # [未断言·无满足前件的见证] # pre: hasattr(startnode, \"successors\")\n        # [未断言·无满足前件的见证] assert hasattr(startnode, \"successors\")\n        # [未断言·无满足前件的见证] # pre: hasattr(goalnode, \"successors\")\n        # [未断言·无满足前件的见证] assert hasattr(goalnode, \"successors\")\n        r = breadth_first_search(startnode, goalnode)\n        # post: isinstance(result, bool)\n        assert isinstance(r, bool)\n    except AssertionError:\n        # 断言失败 = oracle 的语义判定信号，必须保留为 fail（不得 skip）\n        raise\n    except Exception as exc:\n        pytest.skip(f\"oracle-unavailable: {type(exc).__name__}: {exc}\")",
