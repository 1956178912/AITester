     (\"abc\", \"\"),\n            (\"abc\", \"abc\"),\n            (\"a\", \"b\"),\n            (\"electron\", \"neutron\"),\n            (\"kitten\", \"sitting\"),\n            (\"abc\", \"xyz\"),\n            (\"a\", \"abcdef\"),\n        ],\n    )\n    def test_levenshtein_postconditions(self, source, target):\n        \"\"\"结果应为非负整数，且不超过 max(len(source), len(target))。\"\"\"\n        result = levenshtein(source, target)\n        assert isinstance(result, int)\n        assert result >= 0\n        assert result <= max(len(source), len(target))\n\n    @pytest.mark.parametrize(\n        \"source,target\",\n        [\n            (\"\", \"\"),\n            (\"\", \"abc\"),\n            (\"abc\", \"\"),\n            (\"abc\", \"abc\"),\n            (\"a\", \"b\"),\n            (\"electron\", \"neutron\"),\n            (\"kitten\", \"sitting\"),\n            (\"abc\", \"xyz\"),\n            (\"a\", \"abcdef\"),\n        ],\n    )\n    def test_levenshtein_invariant_length_difference(self, source, target):\n        \"\"\"不变式：结果应不小于两串长度差的绝对值。\"\"\"\n        result = levenshtein(source, target)\n        assert result >= abs(len(source) - len(target))\n\n    @pytest.mark.parametrize(\n        \"source,target\",\n        [\n            (\"\", \"\"),\n            (\"abc\", \"abc\"),\n            (\"a\", \"a\"),\n        ],\n    )\n    def test_levenshtein_identical_returns_zero(self, source, target):\n        \"\"\"source == target 时结果应为 0。\"\"\"\n        assert levenshtein(source, target) == 0\n\n\nclass TestLevenshteinErrors:\n    \"\"\"异常输入测试。\n\n    期望值来源不明，需人工确认：代码未做类型校验，\n    传入非字符串会在 len 或索引处抛异常，具体异常类型未在文档中约定。\n    \"\"\"\n\n    def test_levenshtein_non_string_source_raises(self):\n        \"\"\"非字符串 source 应抛出异常（具体类型未约定，需人工确认）。\"\"\"\n        with pytest.raises(Exception):\n            levenshtein(123, \"abc\")\n\n    def test_levenshtein_none_source_raises(self):\n        \"\"\"None 作为 source 应抛出异常（具体类型未约定，需人工确认）。\"\"\"\n        with pytest.raises(Exception):\n     