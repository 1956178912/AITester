ert lcs_length(\"aaa\", \"aa\") == 2\n\n\nclass TestLcsLengthPostconditions:\n    \"\"\"后置条件与不变量测试。\"\"\"\n\n    @pytest.mark.parametrize(\n        \"s,t\",\n        [\n            (\"witch\", \"sandwich\"),\n            (\"meow\", \"homeowner\"),\n            (\"abc\", \"abc\"),\n            (\"bc\", \"abcd\"),\n            (\"abc\", \"xyz\"),\n            (\"\", \"abc\"),\n            (\"abc\", \"\"),\n            (\"\", \"\"),\n            (\"a\", \"a\"),\n            (\"a\", \"b\"),\n            (\"aaa\", \"aa\"),\n            (\"abab\", \"baba\"),\n        ],\n    )\n    def test_lcs_length_postconditions(self, s, t):\n        \"\"\"返回值应为非负整数，且不超过 min(len(s), len(t))。\"\"\"\n        result = lcs_length(s, t)\n        assert isinstance(result, int)\n        assert result >= 0\n        assert result <= min(len(s), len(t))\n\n    @pytest.mark.parametrize(\n        \"s,t\",\n        [\n            (\"\", \"abc\"),\n            (\"abc\", \"\"),\n            (\"\", \"\"),\n        ],\n    )\n    def test_lcs_length_empty_returns_zero(self, s, t):\n        \"\"\"任一为空串时返回 0。\"\"\"\n        assert lcs_length(s, t) == 0\n\n    @pytest.mark.parametrize(\n        \"s,t\",\n        [\n            (\"abc\", \"abc\"),\n            (\"a\", \"a\"),\n            (\"hello\", \"hello\"),\n        ],\n    )\n    def test_lcs_length_equal_strings_returns_length(self, s, t):\n        \"\"\"s == t 时返回 len(s)。\"\"\"\n        assert lcs_length(s, t) == len(s)\n\n\nclass TestLcsLengthError:\n    \"\"\"异常路径测试。\"\"\"\n\n    def test_lcs_length_non_string_input_raises(self):\n        \"\"\"s 为整数时 len(s) 抛 TypeError。\n\n        期望值来源不明，需人工确认：代码未定义异常处理，docstring 未约定，\n        此处仅验证实际行为（抛出 TypeError）。\n        \"\"\"\n        with pytest.raises(TypeError):\n            lcs_length(123, \"abc\")\n\n\n# SpecIR v2 确定性 oracle（compile_readiness=1.00）\nimport pytest\nfrom lcs_length import lcs_length\n\ndef test_specir_v2_oracle():\n    try:\n        s, t = 0, 0\n        # [未断言·无满足前件的见证] # pre: isins