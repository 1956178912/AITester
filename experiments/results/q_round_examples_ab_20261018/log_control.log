lt] == x\n\n\ndef test_find_in_sorted_miss_within_range():\n    \"\"\"x 在范围内但不存在，验证终止返回 -1。\"\"\"\n    arr = [1, 3, 5, 7, 9]\n    x = 4\n    result = find_in_sorted(arr, x)\n    assert result == -1\n\n\ndef test_find_in_sorted_duplicate_elements_any_match():\n    \"\"\"重复元素返回任一匹配下标。\n\n    期望值来源不明，需人工确认：docstring 未规定返回哪一个匹配下标，\n    仅断言返回值合法且 arr[result] == x。\n    \"\"\"\n    arr = [2, 2, 2, 2]\n    x = 2\n    result = find_in_sorted(arr, x)\n    assert -1 <= result < len(arr)\n    assert result != -1\n    assert arr[result] == x\n\n\n@pytest.mark.parametrize(\n    \"arr, x\",\n    [\n        ([3, 4, 5, 5, 5, 5, 6], 5),\n        ([1, 2, 3, 4, 5], 1),\n        ([1, 2, 3, 4, 5], 5),\n        ([], 1),\n        ([7], 7),\n        ([7], 3),\n        ([10, 20, 30], 5),\n        ([10, 20, 30], 99),\n        ([-5, -3, -1, 0, 2], -3),\n        ([1, 3, 5, 7, 9], 4),\n        ([2, 2, 2, 2], 2),\n    ],\n)\ndef test_find_in_sorted_postconditions(arr, x):\n    \"\"\"后置条件：返回值合法，且命中时 arr[result]==x，未命中时 x 不在 arr 中。\"\"\"\n    assert _is_sorted(arr)\n    result = find_in_sorted(arr, x)\n    assert -1 <= result < len(arr)\n    if result == -1:\n        assert x not in arr\n    else:\n        assert arr[result] == x\n\n\n# SpecIR v2 确定性 oracle（compile_readiness=1.00）\nimport pytest\nfrom find_in_sorted import find_in_sorted\n\ndef test_specir_v2_oracle():\n    try:\n        arr, x = 0, 0\n        # [未断言·无满足前件的见证] # pre: all(arr[i] <= arr[i + 1] for i in range(len(arr) - 1))\n        # [未断言·无满足前件的见证] assert all(arr[i] <= arr[i + 1] for i in range(len(arr) - 1))\n        r = find_in_sorted(arr, x)\n        # post: result == -1 or arr[result] == x\n        assert r == -1 or arr[r] == x\n        # post: -1 <= result < len(arr)\n        assert -1 <= r < len(arr)\n        # invariant: 0 <= result < len(arr) or result == -1\n        assert 0 <= r < len(arr) or r == -1\n    except AssertionError:\n        # 断言失败 = oracle 的语义判定信号，必须保留为 fail（不得 skip）\n        raise\n    except Exception as exc