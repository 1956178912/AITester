          "patch": "```python\n\ndef bitcount(n):\n    count = 0\n    while n:\n        n ^= n - 1\n        count += 1\n    return count\n\n\n\"\"\"\nBitcount\nbitcount\n\n\nInput:\n    n: a nonnegative int\n\nOutput:\n    The number of 1-bits in the binary encoding of n\n\nExamples:\n    >>> bitcount(127)\n    7\n    >>> bitcount(128)\n    1\n\"\"\"\n```",
          "generated_test": "import pytest\n\nfrom bitcount import bitcount\n\n\ndef test_bitcount_zero():\n    \"\"\"n=0 时循环不执行，返回 0（后置条件：n 为 0 时返回 0）。\"\"\"\n    assert bitcount(0) == 0\n\n\ndef test_bitcount_one():\n    \"\"\"n=1 是最小非零输入，二进制中 1 的个数为 1。\"\"\"\n    assert bitcount(1) == 1\n\n\ndef test_bitcount_127():\n    \"\"\"docstring 示例：bitcount(127) == 7（127 = 0b1111111）。\"\"\"\n    assert bitcount(127) == 7\n\n\ndef test_bitcount_128():\n    \"\"\"docstring 示例：bitcount(128) == 1（128 = 0b10000000）。\"\"\"\n    assert bitcount(128) == 1\n\n\ndef test_bitcount_power_of_two():\n    \"\"\"2 的幂（1024 = 2^10）只有一个 1 位，返回 1。\"\"\"\n    assert bitcount(1024) == 1\n\n\ndef test_bitcount_all_ones_byte():\n    \"\"\"255 = 2^8 - 1 全 1 位，返回 8。\"\"\"\n    assert bitcount(255) == 8\n\n\ndef test_bitcount_large_int():\n    \"\"\"2147483647 = 2^31 - 1 全 1 位，返回 31。\"\"\"\n    assert bitcount(2147483647) == 31\n\n\n@pytest.mark.parametrize(\n    \"n, expected\",\n    [\n        (0, 0),\n        (1, 1),\n        (2, 1),\n        (3, 2),\n        (4, 1),\n        (7, 3),\n        (8, 1),\n        (15, 4),\n        (16, 1),\n        (31, 5),\n        (127, 7),\n        (128, 1),\n        (255, 8),\n        (256, 1),\n        (1024, 1),\n        (2147483647, 31),\n    ],\n)\ndef test_bitcount_parametrized(n, expected):\n    \"\"\"参数化验证多个输入的汉明重量，期望值来自二进制表示中 1 的个数定义。\"\"\"\n    assert bitcount(n) == expected\n\n\ndef test_bitcount_negative_undefined():\n    \"\"\"负数违反前置条件（n 应为非负整数），行为未定义。\n\n    期望值来源不明，需人工确认：Python 中负数 while 条件恒为真，\n    直接调用可能导致无限循环，因此这里仅记录该前置条件约束，\n    不实际调用被测函数以避免测试挂起。\n    \"\"\"\n    n = -1\n    assert n < 0  # 明确该输入违反前置条件",
