          "generated_test": "import pytest\n\nfrom task_0000 import aggregate\n\n\ndef test_aggregate_positive_integers():\n    \"\"\"正常路径：正整数列表平均值应为 sum/len。\"\"\"\n    values = [1, 2, 3, 4]\n    assert aggregate(values) == 2.5\n\n\ndef test_aggregate_single_element_returns_float():\n    \"\"\"单元素列表平均值等于该元素，且类型为 float。\"\"\"\n    result = aggregate([5])\n    assert result == 5.0\n    assert isinstance(result, float)\n\n\ndef test_aggregate_floats():\n    \"\"\"浮点元素求平均。\"\"\"\n    assert aggregate([1.5, 2.5]) == 2.0\n\n\ndef test_aggregate_negative_numbers():\n    \"\"\"负数元素求平均。\"\"\"\n    assert aggregate([-1, -2, -3]) == -2.0\n\n\ndef test_aggregate_all_zeros():\n    \"\"\"全零列表返回 0.0，不触发除零。\"\"\"\n    result = aggregate([0, 0, 0])\n    assert result == 0.0\n    assert isinstance(result, float)\n\n\ndef test_aggregate_empty_list_raises_zero_division():\n    \"\"\"空列表应触发 ZeroDivisionError（历史 bug 路径）。\n\n    期望值来源：description 明确说明空列表触发 ZeroDivisionError。\n    \"\"\"\n    with pytest.raises(ZeroDivisionError):\n        aggregate([])\n\n\ndef test_aggregate_large_values():\n    \"\"\"大整数求平均不溢出（Python 任意精度整数）。\"\"\"\n    assert aggregate([10**18, 10**18]) == 1e18\n\n\ndef test_aggregate_non_numeric_raises_type_error():\n    \"\"\"字符串元素使 sum 抛 TypeError。\n\n    期望值来源：description 说明非数值元素 sum 累加失败。\n    \"\"\"\n    with pytest.raises(TypeError):\n        aggregate([\"a\", \"b\"])\n\n\ndef test_aggregate_does_not_mutate_input():\n    \"\"\"函数不应修改入参 values。\"\"\"\n    values = [1, 2, 3]\n    original = list(values)\n    aggregate(values)\n    assert values == original\n\n\ndef test_aggregate_bool_elements():\n    \"\"\"bool 元素可被 sum 累加，True=1, False=0。\n\n    期望值来源：Python 语义 True==1, False==0，平均值 = 2/4 = 0.5。\n    \"\"\"\n    assert aggregate([True, False, True, False]) == 0.5\n\n\ndef test_aggregate_mixed_int_float():\n    \"\"\"混合 int/float 元素求平均，结果应为 float。\"\"\"\n    result = aggregate([1, 2.0, 3])\n    assert result == 2.0\n    assert isinstance(result, float)",
