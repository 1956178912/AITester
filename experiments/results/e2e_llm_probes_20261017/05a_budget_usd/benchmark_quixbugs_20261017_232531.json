          "rag_stats": null,
          "patch": "```python\ndef bitcount(n):\n    count = 0\n    while n:\n        n &= n - 1\n        count += 1\n    return count\n\n\n\"\"\"\nBitcount\nbitcount\n\n\nInput:\n    n: a nonnegative int\n\nOutput:\n    The number of 1-bits in the binary encoding of n\n\nExamples:\n    >>> bitcount(127)\n    7\n    >>> bitcount(128)\n    1\n\"\"\"\n```",
          "generated_test": "import pytest\n\nfrom bitcount import bitcount\n\n\nclass TestBitcountNormal:\n    \"\"\"正常用例：覆盖 while 循环多次执行与单次执行。\"\"\"\n\n    def test_bitcount_127_all_ones(self):\n        \"\"\"docstring 示例：127 的二进制 1111111 含 7 个 1。\"\"\"\n        assert bitcount(127) == 7\n\n    def test_bitcount_128_single_high_bit(self):\n        \"\"\"docstring 示例：128 的二进制 10000000 含 1 个 1。\"\"\"\n        assert bitcount(128) == 1\n\n\nclass TestBitcountBoundary:\n    \"\"\"边界用例：0、最小非零值、2 的幂、全 1 大值。\"\"\"\n\n    def test_bitcount_zero_returns_zero(self):\n        \"\"\"边界：n=0 时 while 条件为假，循环体不执行，返回 0。\"\"\"\n        assert bitcount(0) == 0\n\n    def test_bitcount_one_min_value(self):\n        \"\"\"边界：最小非零值 1，二进制 1 含 1 个 1。\"\"\"\n        assert bitcount(1) == 1\n\n    def test_bitcount_power_of_two(self):\n        \"\"\"边界：2^10 = 1024 仅一个 1 位。\"\"\"\n        assert bitcount(1024) == 1\n\n    def test_bitcount_all_ones_large(self):\n        \"\"\"边界：2^31-1 全 1 位，循环 31 次，返回 31。\"\"\"\n        assert bitcount(2147483647) == 31\n\n\nclass TestBitcountPostconditions:\n    \"\"\"后置条件与不变式验证。\"\"\"\n\n    @pytest.mark.parametrize(\"n\", [0, 1, 2, 3, 7, 8, 127, 128, 1024, 2147483647])\n    def test_bitcount_result_nonnegative(self, n):\n        \"\"\"后置条件：返回值非负。\"\"\"\n        assert bitcount(n) >= 0\n\n    @pytest.mark.parametrize(\"n\", [0, 1, 2, 3, 7, 8, 127, 128, 1024, 2147483647])\n    def test_bitcount_result_within_bit_length(self, n):\n        \"\"\"不变式：返回值不超过 n 的二进制位数。\"\"\"\n        assert bitcount(n) <= n.bit_length()\n\n    @pytest.mark.parametrize(\"n\", [1, 2, 3, 7, 8, 127, 128, 1024, 2147483647])\n    def test_bitcount_positive_input_positive_result(self, n):\n        \"\"\"后置条件：n > 0 时返回值大于 0。\"\"\"\n        assert bitcount(n) > 0\n\n\nclass TestBitcountError:\n    \"\"\"错误用例：违反前置条件 n >= 0。\"\"\"\n\n    def test_bitcount_negative_input_undefined(self):\n        \"\"\"违反前置条件 n>=0；负数行为未定义（可能发散），\n        期望值来源不明，需人工确认。此处仅记录实际行为，\n        若实现抛出异常则接受异常，否则断言返回值非负。\n        \"\"\"\n        try:\n            result = bitcount(-1)\n        except Exception:\n            # 实现选择对负数抛异常，视为可接受行为\n            return\n        # 若未抛异常，仅做弱断言，避免恒失败\n        assert isinstance(result, int)\n\n\n# SpecIR v2 确定性 oracle（compile_readiness=1.00）\nfrom bitcount import bitcount\n\ndef test_specir_v2_oracle():\n    n = 0\n    # [未断言·无满足前件的见证] # pre: n >= 0\n    # [未断言·无满足前件的见证] assert n >= 0\n    # [未断言·无满足前件的见证] # pre: isinstance(n, int)\n    # [未断言·无满足前件的见证] assert isinstance(n, int)\n    r = bitcount(n)\n    # post: result >= 0\n    assert r >= 0\n    # post: result == 0 or n > 0\n    assert r == 0 or n > 0\n    # invariant: result <= n.bit_length()\n    assert r <= n.bit_length()",
