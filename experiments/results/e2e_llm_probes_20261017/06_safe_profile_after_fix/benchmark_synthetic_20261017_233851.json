          "generated_test": "import pytest\nfrom task_0000 import divide\n\n\ndef test_divide_basic_positive():\n    \"\"\"基本正数除法：6 / 3 应等于 2.0（数学语义）。\"\"\"\n    assert divide(6, 3) == 2.0\n\n\ndef test_divide_returns_float_type():\n    \"\"\"除法结果应为 float 类型（类型注解约定）。\"\"\"\n    result = divide(1, 2)\n    assert isinstance(result, float)\n\n\ndef test_divide_negative_operands():\n    \"\"\"负数除法：-6 / 3 应等于 -2.0（数学语义）。\"\"\"\n    assert divide(-6, 3) == -2.0\n\n\ndef test_divide_both_negative():\n    \"\"\"两个负数相除结果为正：-6 / -3 应等于 2.0（数学语义）。\"\"\"\n    assert divide(-6, -3) == 2.0\n\n\ndef test_divide_fractional_result():\n    \"\"\"小数结果：1 / 4 应等于 0.25（数学语义）。\"\"\"\n    assert divide(1, 4) == 0.25\n\n\ndef test_divide_zero_numerator():\n    \"\"\"零作被除数：0 / 5 应等于 0.0（数学语义）。\"\"\"\n    assert divide(0, 5) == 0.0\n\n\ndef test_divide_by_zero_raises():\n    \"\"\"除数为零应抛出 ZeroDivisionError（数学语义：除零未定义）。\"\"\"\n    with pytest.raises(ZeroDivisionError):\n        divide(1, 0)\n\n\ndef test_divide_zero_by_zero_raises():\n    \"\"\"0 / 0 应抛出 ZeroDivisionError（数学语义）。\"\"\"\n    with pytest.raises(ZeroDivisionError):\n        divide(0, 0)\n\n\ndef test_divide_identity():\n    \"\"\"任何非零数除以自身应等于 1.0（数学定律）。\"\"\"\n    assert divide(7, 7) == 1.0\n\n\ndef test_divide_reciprocal():\n    \"\"\"a / b 与 b / a 互为倒数（数学定律）。\"\"\"\n    a, b = 3.0, 8.0\n    assert divide(a, b) * divide(b, a) == pytest.approx(1.0)\n\n\ndef test_divide_multiplication_inverse():\n    \"\"\"(a / b) * b 应约等于 a（数学定律）。\"\"\"\n    a, b = 10.0, 4.0\n    assert divide(a, b) * b == pytest.approx(a)\n\n\ndef test_divide_large_numbers():\n    \"\"\"大数除法：1e10 / 1e5 应等于 1e5（数学语义）。\"\"\"\n    assert divide(1e10, 1e5) == pytest.approx(1e5)\n\n\ndef test_divide_small_numbers():\n    \"\"\"小数除法：1e-10 / 1e-5 应等于 1e-5（数学语义）。\"\"\"\n    assert divide(1e-10, 1e-5) == pytest.approx(1e-5)\n\n\ndef test_divide_negative_divisor():\n    \"\"\"正数除以负数结果为负：6 / -3 应等于 -2.0（数学语义）。\"\"\"\n    assert divide(6, -3) == -2.0\n\n\ndef test_divide_float_precision():\n    \"\"\"浮点除法精度：1 / 3 应约等于 0.333333...（数学语义）。\"\"\"\n    assert divide(1, 3) == pytest.approx(1.0 / 3.0)",
