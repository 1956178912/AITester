# ═══════════════════════════════════════════════════════════════════════════════
# AITester 本地敏感配置模板（LLM API Keys / Base URLs / Models）
#
# 使用方法：
#   cp config.local.example .env.local
#   然后填入真实值，或删除不需要的配置项。
#
# 命名约定（单一事实来源）：本文件的 LLM_N_* 编号格式是 config.py 运行时
# 唯一读取的密钥命名。.env.local.template 与 llm_configs.json 的
# required_api_key 字段使用 {PROVIDER}_API_KEY 格式，仅供批量生成脚本
# （scripts/tools/generate_batch_config.py）作中间变量，config.py 不读取它们。
# 手动配置一律用本文件的 LLM_N_* 格式。
#
# ⚠️  此文件绝对不要提交到 Git！已在 .gitignore 中排除。
# ═══════════════════════════════════════════════════════════════════════════════

# ─── LLM 配置（可添加多个，编号从 1 开始递增）──────────────────────────────────
# 每个 LLM Provider 需要填写以下三个字段：
#   LLM_N_API_KEY    — API Key（必填）
#   LLM_N_BASE_URL   — OpenAI 兼容接口地址（必填）
#   LLM_N_MODEL_NAME — 模型名称（必填）
#
# 至少配置一组，更多组会自动加入故障转移列表。

# ── 第 1 个 LLM（必填，推荐使用）───────────────────────────────────────────────
# 当前项目唯一配置的 LLM 端点：DeepSeek 官方 API，deepseek-flash（V4.1 Flash）
# （API Key 填入真实值；此占位符切勿随真实密钥提交）
LLM_1_API_KEY=<YOUR_DEEPSEEK_API_KEY_HERE>
LLM_1_BASE_URL=https://api.deepseek.com/v1
LLM_1_MODEL_NAME=deepseek-flash

# 其他 provider（阿里云百炼 / Agnes / 智谱 BigModel 等）已按 2026-10-09
# 配置要求移除，如需再加回：复制上方三行，改为 LLM_2_* / LLM_3_* 递增编号。


# ─── 全局温度参数（可选，未配置则默认 0.2）────────────────────────────────────
# TEMPERATURE=0.2
