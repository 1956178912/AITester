# ═══════════════════════════════════════════════════════════════════════════════
# AITester 环境变量配置模板
# 复制此文件为 .env 并填入真实值：cp .env.example .env
# 注意：.env 文件已加入 .gitignore，不会被提交到版本库
# ═══════════════════════════════════════════════════════════════════════════════

# ─── LLM 配置 ────────────────────────────────────────────────────────────────
# 【重要】LLM 密钥属于敏感信息，现行架构统一放在 .env.local（不放在 .env）：
#   cp config.local.example .env.local   # 然后填入真实的 LLM_N_* 值
#
# LLM_N_* 格式（写在 .env.local，N = 1,2,3... 可任意多组，系统自动轮询）：
#   LLM_1_API_KEY=<your-api-key>
#   LLM_1_BASE_URL=https://api.provider.com/v1
#   LLM_1_MODEL_NAME=model-name
#
# 旧变量 OPENAI_API_KEY / OPENAI_BASE_URL / MODEL_NAME 已不再被系统读取
# （config.py 中仅为从 LLM_CONFIGS 派生的向后兼容值），请勿再依赖它们配置 LLM。
#
# 本文件（.env）只承载非敏感项，LLM 温度等仍在此配置：
# 温度参数：0=完全确定性（推荐测试生成），1=高创造性
# 测试生成场景建议 0.1~0.3，保持输出稳定可复现
TEMPERATURE=0.2

# ─── 数据库配置（可选，未配置则跳过数据库记录）────────────────────────────────
# MySQL 连接参数，用于持久化实验结果（任务记录、测试运行、修复历史）
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=<MYSQL_PASSWORD>
# AITester 使用的数据库名，init_db.py 会自动创建该库及所需表
MYSQL_DATABASE=aitester
# MySQL 连接池参数（PooledDB）：默认值适合单实验串行场景；
# 跑 BENCHMARK_PARALLELISM>0 的并发实验或数据库 QPS 升高时适当调大
MYSQL_POOL_MIN_CACHED=5
MYSQL_POOL_MAX_CACHED=10
MYSQL_POOL_MAX_CONNECTIONS=20
# 从连接池获取连接的等待超时（秒）
MYSQL_POOL_TIMEOUT=30

# ─── 执行环境 ─────────────────────────────────────────────────────────────────
# Docker 隔离执行：
#   EXECUTOR_USE_DOCKER=true（4.3，需本机安装 docker 且镜像已构建）经 docker CLI
#   在容器内跑 pytest（docker run --rm -v <sandbox>:/workspace -w /workspace
#   <image> python -m pytest ...），依赖预安装缓存在镜像构建期完成（层缓存复用），
#   每任务零安装开销。docker 不可用时任务提前返回 docker_unavailable 诊断，
#   不静默降级本地执行（避免实验口径混淆）。需先构建镜像：
#       docker build -t aitester:latest .
#   默认 false 保持本地快速执行口径。
# DOCKER_IMAGE 须与锁定依赖兼容：scipy==1.18.0 要求 Python >=3.12，
# 故默认 3.12-slim（与 config.py 默认值及 Dockerfile 保持一致）。
# DOCKER_ENABLED=false
# DOCKER_IMAGE=python:3.12-slim
# 单次测试执行的最大超时时间（秒），防止被测函数死循环导致进程卡死
EXECUTION_TIMEOUT=30

# 执行隔离（P1 依赖隔离）：本地执行默认跑在系统 Python 环境，
# 被测代码的第三方 import 缺失时会测试失败且无法区分代码 bug 与环境问题。
#   EXECUTOR_USE_VENV=true：为任务建隔离 venv（按依赖组合磁盘缓存），
#     PYTHONPATH 仅指向沙箱目录，不污染系统环境
#   EXECUTOR_AUTO_INSTALL_DEPS=true：执行前自动 pip install 缺失依赖（仅装入 venv）
# 两者默认 false，保持与历史实验一致；SWE-bench 等含第三方依赖的实验建议开启
EXECUTOR_USE_VENV=false
EXECUTOR_AUTO_INSTALL_DEPS=false
# 依赖安装子进程超时（秒），防止 pip 网络卡顿拖垮实验
EXECUTOR_DEP_INSTALL_TIMEOUT=120
# 4.4 venv 缓存目录覆盖（可选）：默认 ~/.cache/aitester/venvs/
# 容器/CI 隔离场景可指向挂载卷；配合 `python main.py clean-venv-cache`
# 按时间/大小清理（--list-only 只读查看）
# AITESTER_VENV_CACHE_DIR=

# 4.3 Docker 隔离执行（默认关）：经 docker CLI 在容器内跑 pytest，
# 需本机安装 docker 且镜像已构建（docker build -t aitester:latest .）。
# 依赖预安装缓存在镜像构建期完成（层缓存复用），每任务零安装开销；
# docker 不可用时任务提前返回 docker_unavailable 诊断（不静默降级本地）。
# 配置 EXECUTOR_USE_DOCKER=true + 可选 EXECUTOR_DOCKER_IMAGE 启用。
# EXECUTOR_USE_DOCKER=false
# EXECUTOR_DOCKER_IMAGE=aitester:latest

# ─── 工作流 ───────────────────────────────────────────────────────────────────
# 最大修复迭代次数：达到此次数后无论测试是否通过都停止修复
MAX_ITERATIONS=3
# 覆盖率阈值：代码行覆盖率不低于此百分比时视为合格
COVERAGE_THRESHOLD=80.0

# W3 检出优先协议（DETECTION_FIRST_ENABLE，默认 false；ADR-0015）：
# "先红后绿"成功口径——首轮（iteration==0，被测代码未修复）测试全绿 =
# 未检出任何缺陷，不再视为成功：路由一次再生成逼 Generator 产出能让缺陷
# 代码变红的测试；再生成预算（_MAX_REGENERATIONS=1）耗尽仍全绿则终态标注
# all_green_unverified（评估层不得计为检出/修复成功）。曾红后绿标注
# red_then_green。背景：主批次实证 false_fix_rate=89.8%（自产测试在未修复
# 代码上通过的假成功通道）。默认关保持历史口径零变化（ADR-0003）。
# DETECTION_FIRST_ENABLE=false

# 2026-10-01 全面审查 P1 补全：以下 6 个 config.py 变量此前未纳入本模板
#（环境变量配置项与 .env.example 漂移），默认值均已写入 config.py，
# 此处仅作覆盖口径说明（按需取消注释 + 改值）。

# 变异评分开关（ENABLE_MUTATION_SCORING，默认 false）：
# 开启后 Generator 在常规测试生成之外追加变异体评分（MutGen 式），
# 评估测试强度。默认关保持历史口径。
# ENABLE_MUTATION_SCORING=false

# 变异体数量上限（MUTATION_MAX_MUTANTS，默认 20，下限 1，无上限）。
# T3（2026-10-05 优化批次）默认 10→20：10 个变异体下 mutation_detection_rate
# 的二值噪声区间过宽（±30pct），20 个起才有区分度；评估仍为 opt-in
# （ENABLE_MUTATION_SCORING 默认关），不影响历史批次口径。
# MUTATION_MAX_MUTANTS=20

# 仓库级执行开关（REPO_LEVEL_EXECUTION，默认 false）：
# 开启后执行链路按"仓库级"路由（SWE-bench 等含第三方依赖的实验建议
# 配合 SWE_REPO_VENV_ISOLATION=true）。默认关保持本地函数级执行口径。
# REPO_LEVEL_EXECUTION=false

# 仓库级 setup 子进程超时（秒）（SWE_REPO_SETUP_TIMEOUT，默认 600，下限 60）
# SWE_REPO_SETUP_TIMEOUT=600

# 仓库级 venv 隔离（SWE_REPO_VENV_ISOLATION，默认 false）：
# 开启后为仓库级任务建隔离 venv（按依赖组合磁盘缓存），不污染系统环境。
# 需配合 REPO_LEVEL_EXECUTION=true。
# SWE_REPO_VENV_ISOLATION=false

# 任务级 LLM 调用预算（秒）（LLM_CALL_BUDGET_SECONDS，默认 600，下限 1）：
# 单任务 LLM 累计调用时长超此值时触发 5.4 预算封顶（BudgetExceededError），
# 快速降级空测试/空补丁，不空转迭代烧 token。
# LLM_CALL_BUDGET_SECONDS=600

# LLM 文件缓存（省 token，默认启用）：跨会话复用相同 prompt 的成功输出
#   设 AITESTER_LLM_CACHE=0 关闭（测试环境默认关闭，避免缓存污染与 flaky）
# AITESTER_LLM_CACHE=1
# 缓存目录（2026-10-05 审查修复：默认值从 src/cache/ 迁出源码树，改为用户
# 缓存目录——XDG_CACHE_HOME 或 ~/.cache/aitester/llm；历史 src/cache/ 的既有
# 缓存不自动迁移，需保留历史命中时显式设 AITESTER_LLM_CACHE_DIR=<repo>/src/cache），
# 可用该变量覆盖（测试指向临时目录）
# AITESTER_LLM_CACHE_DIR=
# 缓存过期清理 TTL（天，18. 安全改进）：workflow 启动时自动清理早于该 TTL 的
# 缓存文件（防缓存目录长期积累敏感 prompt/响应）；设 0 关闭清理（历史口径）
# AITESTER_LLM_CACHE_TTL_DAYS=7

# ─── 4. 失败知识库闭环（默认全关，保持历史实验口径）────────────────────────────
# 离线积累 → 在线消费闭环（docs/design/failure_knowledge_feedback.md 落点 B）：
# FAILURE_KB_ENABLE=true 时 Debugger prompt 尾部注入失败知识库（
# experiments/results/failure_knowledge_base.json，经 analyze_failures.py -k
# 生成）中同类 error_category 案例的修复方向片段（频次 × 时间衰减排序）；
# 默认 false 时 prompt 与历史逐字节一致。
# FAILURE_KB_PATH=              # 知识库文件路径（缺省 experiments/results/）
# FAILURE_KB_DECAY_DAYS=30      # 条目衰减半衰期（天）；last_seen 越久权重越低，
#                               # 避免过时策略污染；≤0 关闭衰减（全部等权）
# FAILURE_KB_ENABLE=false
# FAILURE_KB_PATH=
# FAILURE_KB_DECAY_DAYS=30

# ─── 执行环境凭证剔除（4.1 脱敏审计扩展 + 2026-09-26 P0 补强，无开关，始终生效）──
# 三条执行链路（本地 / venv 沙箱 / Docker）统一在子进程前剔除 LLM API 凭证
# 类环境变量（credential_scrub.scrub_os_environ 动态模式，单一实现，防名单
# 漂移）：LLM_N_API_KEY / LLM_N_BASE_URL 全部编号（1-32）+ 通用 SDK 凭证
# （OPENAI_API_KEY / OPENAI_BASE_URL / ANTHROPIC_API_KEY / API_KEY /
# LLM_API_KEY / LLM_CONFIG_API_KEY）+ P0 补强（2026-09-26）：编号变体通配
# OPENAI_(API_KEY|BASE_URL)_\d+（.env 实测存在 OPENAI_API_KEY_2/3 等多端点
# 命名，旧全名锚定漏掉编号变体，凭证原样进被测代码子进程）与 provider 中间
# 变量（ALIYUN_BAILIAN_API_KEY / AGNES_{DOMESTIC|INTERNATIONAL}_API_KEY /
# BIGMODEL_API_KEY / DEEPSEEK_API_KEY，与 config_generator 的
# PROVIDER_TEMPLATES 键联动，覆盖批量脚本推导口径）。
# 设计目标：LLM 生成的测试代码在子进程中执行，子进程不得继承宿主 LLM 凭证
# （既是凭证暴露面，也是生成代码意外外传的执行向量）。非开关项，无需配置。

# ─── 消融实验开关（默认值已写入 config.py，可按需覆盖）────────────────────────
# 启用/禁用 Planner（测试规划师）节点
#   true（默认）：完整系统，先逻辑分析再生成测试
#   false：无规划基线，Generator 直接生成测试
ENABLE_PLANNER=true

# 启用/禁用 RAG 检索增强（需安装 chromadb：pip install "aitester[rag]"）
#   false（默认）：不启用，节省依赖
#   true：Generator/Debugger 会检索相似历史案例作为参考
# 也可在实验入口显式切换：experiments/run_benchmark.py --enable-rag
ENABLE_RAG=false

# RAG 持久化路径（跨实验复用的检索库）：
#   不设置（注释掉本行）= 使用项目根下 rag_data/（config.py 内置默认，推荐）
#   设为具体路径 = 自定义持久化目录；设为空字符串 = 回退内存模式（重启丢数据）
# RAG_PERSIST_PATH=
# RAG ChromaDB 集合名（同一持久化目录下按集合名区分实验）
RAG_COLLECTION_NAME=aitester_cases
# RAG 缓存 TTL（秒）：持久化场景默认 7 天，保证跨实验复用；
# 按需调小可强制检索库定期"保鲜"
RAG_TTL_SECONDS=604800

# SWE-bench 源码补充文件路径（P0，可选）：
#   官方 SWE-bench JSONL 不含被测源码字段，通过该 JSONL 按 instance_id
#   补全 instance_code/test_code（scripts/export_swe_bench_source.py 输出此格式）。
#   默认不设置 = 不补全（instance_code 兜底为 issue 文本）。
# SWE_BENCH_ENRICHMENT=./swe_bench_enrichment.jsonl

# 启用/禁用 Debugger（调试修复师）节点
#   true（默认）：完整系统，测试失败后自动修复
#   false：无修复基线，失败后直接结束
ENABLE_DEBUGGER=true

# ─── 多候选补丁（3.1 + 3.2，默认关闭）──────────────────────────────────────────
# 启用后 Debugger 一轮生成 N 个候选补丁，静态筛选（语法/函数完整性）+
# 可选执行验证（MULTI_CANDIDATE_EXEC_VALIDATE）后选最优候选应用，
# 显著提升修复成功率（无有效候选时自动回退单补丁，不引入劣化）。
# 3.2 改进：静态筛选模式改按"行级信用"排序（BOOSTAPR 式：执行验证通过率
# ×(1-修改行占比)），修改行少且静态通过的候选优先（未验证时退化为
# 简洁性代理）。
# ENABLE_MULTI_CANDIDATE_PATCH=false
# # 候选数（默认 3，上限 8）
# MULTI_CANDIDATE_COUNT=3
# # 是否启用逐候选执行验证（默认 false 仅静态筛选；true 成本更高但筛选更准）
# MULTI_CANDIDATE_EXEC_VALIDATE=false
# # 3.3 轻量奖励预测器（默认 false）：启用后 select_best_candidate 在静态
# # 筛选模式下用历史 execution_trace 的覆盖率趋势调节候选排序（覆盖率连降
# # 偏最小改动、停滞偏更大改动/换根因视角）。纯规则式、无训练、可复算。
# REWARD_PREDICTOR_ENABLE=false
# # P0 3.2 多候选自适应触发策略（默认 adaptive）：
# #   adaptive：仅当 iteration >= 1（首次修复已失败）且 error_category ∈
# #             {assertion, runtime, logic_error, index_error}（困难类别）时
# #             启用多候选；简单任务 / 早期迭代保持单候选，省 token。
# #   always：历史口径，每次失败都启用多候选（每次失败 +79% token 成本）。
# # 设 always 回退历史口径，便于 A/B 对比。
# MULTI_CANDIDATE_TRIGGER_STRATEGY=adaptive

# ─── 对抗性推理（3.1，默认关闭）───────────────────────────────────────────────
# 启用后 Debugger 在生成补丁前注入 2-3 个"击穿当前实现"的对抗性意图
# 假设（AdverIntent-Agent 式），生成针对性测试，生成后独立"批评者"LLM
# 调用尝试构造击穿用例；被击穿则重新生成一次补丁（仍失败保留当前并记录
# 风险）。默认 false 保持历史实验口径（启用会增加 2-4 次 LLM 调用/修复轮）。
# ADVERSARIAL_DEBUGGING_ENABLE=false

# ─── 3.1 双向代码-测试诊断（BiVCoder 式 Review Agent，默认关闭）────────────────
# 启用后 Debugger 在生成补丁前先由独立"审查智能体"判断失败根因是
# "实现缺陷"（修复代码）还是"测试缺陷"（重新生成测试）。判定为测试缺陷
# 时不生成补丁，返回 defect_type="test_defect" 由 workflow 路由回 generator
# 重新生成测试。默认 false 保持历史口径（未启用时 defect_type 恒为
# implementation_defect，即修复代码）。启用会每轮多 1 次 LLM 调用。
# BIDIRECTIONAL_DIAGNOSIS_ENABLE=false

# ─── 3.3 位置感知迭代修复（LoopRepair 式先定位再补丁，O1 起默认启用）────────
# 启用后 Debugger 在生成补丁前先做"修复位置定位"：把 error_classifier 已
# 提取的异常位置（traceback 行号 / 语法错误行列）经 AST 定位到所属函数，
# 生成"位置感知修复指引"注入 prompt，让 LLM 优先修定位到的位置而非全文件
# 盲搜（参考 LoopRepair 位置感知迭代修复）。定位纯静态不耗 LLM token；
# 无法定位时自动降级为常规全文件修复（保持历史口径）。
# O1（2026-09-29 审查 P1）：定位已实现且零 LLM 成本，默认值改为 true；
# 历史 OFF 组 A/B 口径需显式 POSITION_AWARE_REPAIR_ENABLE=false。
# POSITION_AWARE_REPAIR_ENABLE=true

# ─── 结构化可观测性（4.1，默认关闭；P0 4.2 批次起 run_benchmark.py 入口默认启用）───
# 设置非空路径启用 JSONL 追踪记录（未设置时全 no-op 零性能税）：
# 每任务生成 <task_uuid>.trace.jsonl，记录各智能体节点的输入输出、
# 决策路径（debug/done/regenerate）、token 消耗与墙钟耗时，供实验分析回放。
# P0 4.2：run_benchmark.py 入口在 AITESTER_TRACE_DIR 未设时自动设为
# <output_dir>/traces/（默认启用追踪层）；设空串显式关闭。
# AITESTER_TRACE_DIR=

# ─── 1.1 LLM 输出后处理层（P1 空壳检测默认启用；P2/P3 默认关闭）──────────────
# 补丁应用前自动修复常见 LLM 代码破坏模式（与 1.3 契约守卫"拒绝层"互补
# 的"修复层"，src/tools/patch_postprocess.py）：
#   P1 空壳补丁检测（默认 true）：纯空白/无有效代码的补丁打
#      "empty_patch" 标签（state.postprocess_labels），EMPTY_LLM_PATCH
#      场景可观测（不改代码，零行为变化）。
#   P2 导入断裂修复（默认 false）：补丁丢失原代码顶层 import 且正文仍
#      引用该模块时，自动把缺失 import 行回填补丁头部。
#   P3 契约符号别名回填（默认 false）：LLM 重命名模块级契约符号
#      （Rule_L001→RuleL001）时补 "Old = New" 别名，保持 import 链 /
#      插件注册不破。
# 启用 P2/P3 会改变补丁应用前的代码形态（修复后再走 1.3 契约守卫，
# 守卫仍为最终拒绝层）。
# EMPTY_PATCH_GUARD=true
# IMPORT_REPAIR_ENABLE=false
# CONTRACT_ALIAS_ENABLE=false

# ─── 5.4 任务级成本预算硬上限（默认关闭，COST_BUDGET_ENABLE）────────────────
# 单任务 LLM token/费用预算封顶（src/graph/cost_budget.py，线程局部累计，
# --parallel 每任务独立）；超限时 BaseAgent._call_llm 前置守卫抛
# BudgetExceededError，各节点降级兜底（不再空转烧 token）。
# 与 3.4 成本告警（路由侧旁路观测）独立、可叠加启用。
# COST_BUDGET_ENABLE=false
# COST_BUDGET_TOKENS=0        # 单任务 token 硬上限（0 = 不限）
# COST_BUDGET_USD=0          # 单任务费用硬上限（美元，需配 COST_USD_PER_1K）
# COST_USD_PER_1K=0          # 每 1K token 费用（美元，0 = 费用口径不生效）

# ─── 5.1 语义级 LLM 缓存（默认关闭，SEMANTIC_CACHE_ENABLE）────────────────
# 嵌入向量相似度匹配缓存（src/agents/semantic_cache.py，复用 embedding_utils
# 的 CodeBERT → sentence-transformers → chromadb 级联后端）：语义相同但
# 措辞不同的 prompt 可复用缓存响应（省 LLM 调用）。嵌入后端缺失时自动
# 降级为精确缓存口径（零行为变化）。需已安装嵌入库（transformers /
# sentence-transformers / chromadb 任一）才生效。
# SEMANTIC_CACHE_ENABLE=false
# SEMANTIC_CACHE_THRESHOLD=0.92   # 余弦相似度阈值（保守：宁可漏命中）
# SEMANTIC_CACHE_MAX_ENTRIES=256  # 索引扫描的缓存文件数上限

# ─── 3.5 跨文件修复（协调器-提议者架构，默认关闭）─────────────────────────────
# 启用后 workflow 在 executor → debugger 之间插入 cross_file_analyzer 节点，
# 分析被测代码的跨文件 import 依赖关系（AST，单入口视角），路由多文件
# 补丁应用（被调用方先改，调用方后改；任一文件失败整体回滚）。
# 单文件项目自动降级为单文件模式（依赖边为空时 cross_file_plan=None）。
# 默认 false 保持历史单文件口径；启用需显式 CROSS_FILE_ENABLE=true。
# CROSS_FILE_ENABLE=false

# ─── 三、工作流级双向诊断节点（BiVCode 式 DiagnosisNode，默认关闭）────────────
# 启用后 workflow 在 executor → debugger 之间插入显式 DiagnosisNode
# （_diagnosis_node）：先由 Review Agent 诊断"代码缺陷 vs 测试缺陷"，
# 再按判定路由（测试缺陷 → generator 重新生成测试；代码缺陷 → debugger
# 生成补丁）。与 BIDIRECTIONAL_DIAGNOSIS_ENABLE（debugger 内联诊断）
# 可叠加，二者默认都关（保持历史实验口径）。启用会每轮多 1 次 LLM 调用。
# 判定来源标记 diagnosis_source="diagnosis_node" 写入 state。
# DIAGNOSIS_NODE_ENABLE=false

# ─── 2.1 PAGENT 风格类型修复层（后处理静态疑点识别，LLM 层默认关闭）──────────
# 启用后 Debugger 在生成补丁后对"原代码 vs 补丁后代码"做静态类型疑点
# 识别（零 LLM token，纯 ast）；疑点非空时自动触发 LLM 类型推断修订 +
# 命名契约回环验证（修订破坏契约则拒绝，保留原补丁）。疑点始终写入
# state["type_repair_findings"]（LLM 层关闭时仅记录观测层，不修改补丁，
# 不影响历史实验口径）。启用会每轮修复最多 +1 次 LLM 调用（仅静态层
# 有疑点时触发）。
# TYPE_REPAIR_LLM_ENABLE=false
# # 跨文件依赖分析的最大模块数（防止 LLM 上下文爆炸，默认 5）
# CROSS_FILE_MAX_MODULES=5
# # 2.2 改进：双向依赖图开关（默认 false 保持单入口视角）。启用时额外
# # 收集"其他模块→entry"反向依赖边（被调用方视角），使修复计划能同步
# # 更新调用方模块。需配合 CROSS_FILE_ENABLE=true 生效，独立开关保证
# # "跨文件启用 ≠ 双向启用"两级保守。
# CROSS_FILE_BIDIRECTIONAL=false

# ─── API 熔断器指数退避 + Prometheus 导出（4.4，旁路开关；0.6 经 config.py
# 集中声明 API_CIRCUIT_BACKOFF / API_PROMETHEUS_EXPORT 后由 api_health /
# api_manager 读取——此前文档承诺的开关全仓无代码读取点，用户设 false 不
# 会发生任何事；0.6 轮次幽灵开关实装后下方语义生效）────────────────────────────
# 熔断器冷却期改按 base*2^open_count 指数退避（彻底死掉的 provider
# 冷却期单调增长，避免反复短冷却打同一死点；封顶 half_open_probe_
# penalty_cap_seconds）。默认 true 启用；设 false 回退 4.2 固定冷却期
# 口径（便于对比实验）。
# API_CIRCUIT_BACKOFF=true
# Prometheus 指标导出开关（默认 false）。启用后 APIManager.to_prometheus_
# text() 输出 7 类指标（health / circuit_state / open_remaining_s /
# open_count / probe_success_rate / success_rate / avg_response_ms）供
# Prometheus 抓取；false（默认）时返回空串。纯旁路，不影响既有路由行为。
# API_PROMETHEUS_EXPORT=false

# ─── 3.4 断言增强策略（AST 提取现有 assert 注入 prompt，默认关闭）─────────────
# 启用后 GeneratorAgent 在生成前先 AST 提取被测代码中已有 assert 语句
# （去重，最多 10 条），作为"锚点断言"注入 prompt，引导 LLM 避免
# 断言弱化 / 恒真断言 / 魔数未命名等异味。默认 false 保持历史生成口径。
# ASSERTION_AUGMENT_ENABLE=false

# ─── 2.3 复现测试专项生成（TDFlow 式，默认关闭）────────────────────────────────
# 启用后 GeneratorAgent 在已有缺陷描述（diagnosis / review_reason）时，
# 额外生成一个"先失败后通过"的复现测试（覆盖缺陷触发路径，跨文件修复
# 场景下覆盖跨模块调用链），写入 state["repro_test"]。默认 false 保持
# 历史生成口径。启用会额外增加 1 次 LLM 调用/任务。
# REPRO_TEST_ENABLE=false

# ─── 成本感知路由（3.4 + 3.2，可选）───────────────────────────────────────────
# APIManager 的 COST_AWARE 策略按"成功率/成本"综合排序，故障转移时避免把
# 全量流量切到昂贵 provider，超过成本阈值（默认 2.0x，经 APIManagerConfig.cost_alert_threshold
# 可配——误报多时上调如 3.0/5.0，成本敏感度高时下调，无需改代码）记 WARNING 告警
# （cost_alert_enabled 可关）。
# 各 provider 的相对成本倍数在 .env.local 中以 LLM_N_COST_WEIGHT 配置
# （对应 LLM_N_* 编号，0.1~1000；未配置默认 0.0=无信息，APIManager 回退 1.0 基准）。
# 启用方式：APIManagerConfig(rotation_strategy=RotationStrategy.COST_AWARE)。

# ─── P0 改进批次（2026-09-25 续）：13 项落地的配套开关 ─────────────────────────
# 以下为 P0 批次的可配置项，默认值保持历史实验口径（显式开启才启用新能力）。

# ── P0 1.1 分层代码压缩（函数级切片 + 调用链深度）──────────────────────────
# 代码截取的最大字符预算（默认 3000，约 100 行）；超长时按 AST 聚焦截取
# （目标函数 + 调用链依赖），仍超预算才走字符级截断兜底。
# CODE_MAX_CHARS=3000
# 调用链展开深度（P0 1.1 分层代码压缩核心）：
#   1 = 焦点函数直接调用的同文件函数（历史行为，默认）
#   2 = 再展开一层被调函数的依赖（跨文件场景的"目标函数 → 被调用函数 → 相关类"）
# 经 BaseAgent.truncate_code(focus_depth) 与 extract_function_context(depth) 消费。
# CODE_FOCUS_DEPTH=1

# ── P0 1.2 复杂度感知路由（固定 Agnes 3.0-flash 多 provider 端点）───────────
# 路由策略：
#   complexity_aware（默认）：按任务复杂度（行数/文件数/依赖数/圈复杂度归一
#     化评分 → simple/medium/complex 三档）路由到对应 cost_weight 的 LLM 端点
#     （complex → 高 cost_weight 端点在前，simple → 低成本端点在前）
#   fixed：历史口径，固定按 COST_AWARE 综合评分排序（不按复杂度分档）
# MODEL_ROUTING_STRATEGY=complexity_aware
# 复杂度评分归一化基准（各维度满分基准值，超过视为该维度满分）：
#   行数 500 / 文件数 5 / 依赖数 20 / 圈复杂度 25（均可调）
# ROUTING_COMPLEXITY_LINES_NORM=500
# ROUTING_COMPLEXITY_FILES_NORM=5
# ROUTING_COMPLEXITY_DEPS_NORM=20
# ROUTING_COMPLEXITY_CC_NORM=25

# ── P0 1.3 补丁命名契约验证（默认开启）───────────────────────────────────────
# 补丁应用前对比前后模块级符号（函数/类/__all__/注册装饰器/模块级常量），
# 缺失任何原符号则拒绝应用。防止 LLM 改写破坏 sqlfluff 等插件的命名契约。
# 设 false 回退历史口径（不做符号对比，仅做长度/路径安全检查）。
# PATCH_CONTRACT_CHECK=true

# ── P0 4.3 venv 按仓库复用（需配合 REPO_LEVEL_EXECUTION + SWE_REPO_VENV_ISOLATION）
# 同一仓库的多个 commit 共享一个仓库级 venv（<repo>/_shared_venv/），
# 仅当依赖指纹（requirements/pyproject/setup.py 的 SHA256）变更时重建；
# 源码切换不触发重装（editable install 的 .pth 自动跟随 checkout）。
# SWE-bench 同一 repo 多 commit 场景下大幅减少 venv 重建开销（10-20 倍）。
# 默认 false 保持 per-commit 独立 venv 口径（与既有缓存兼容）。
# SWE_REPO_VENV_REUSE_BY_REPO=false

# ── P0 2.1 合成数据集分层难度（仅对 synthetic 数据集生效）──────────────────
# 经 experiments/run_benchmark.py --difficulty 参数消费（混合难度默认）：
#   mixed（默认）/ level1（单函数）/ level2（多函数交互）/
#   level3（跨文件双模块）/ level4（边界+异常隐蔽缺陷）
# 无独立环境变量，CLI 参数即可；脚本内直接构造 SyntheticDataset 时传 difficulty。

# 批量基准测试并行度（0=串行）：experiments/run_benchmark.py 读取，
# 驱动多线程并行执行（也可用 --parallel 参数覆盖）
BENCHMARK_PARALLELISM=0

# 单次 LLM 调用超时时间（秒），防止 LLM 响应过慢导致任务卡死
LLM_TIMEOUT=60
# LLM 限流重试等待基准（秒）：触发 429 后等待该时长再重试
# （来源：experiments/run_benchmark.py 的限流处理，建议 10-60）
LLM_RETRY_WAIT=30

# ─── 2026-09-29 审查优化批次新增开关（M7/M10/O2/O3/O5/O8 系列，默认全关）─────
#
# M7 图内变异顾问节点（MUTATION_ADVISOR_ENABLE=true 时在 executor → generator
# 的 regenerate 路径中插入 mutation_advisor 节点，零 LLM 成本 subprocess
# 变异评估；默认 false 时图拓扑与历史完全一致）：
# MUTATION_ADVISOR_ENABLE=false

# M10 可检查规约强校验（LOGIC_SPEC_STRICT_ENABLE=true 时 Planner 输出的
# logic_analysis schema 校验失败将 raise ValueError 而非静默兜底；
# 默认 false 保持历史静默兜底口径）：
# LOGIC_SPEC_STRICT_ENABLE=false

# M10 确定性边界锚点注入（BOUNDARY_TRIPLETS_ENABLE=true 时 Generator 经
# derive_boundary_triplets 从被测代码 AST 分支条件推导边界三元组注入
# prompt；默认 false 保持历史 prompt 逐字节不变）：
# BOUNDARY_TRIPLETS_ENABLE=false

# O2 谱系故障定位（FL_SPECTRAL_ENABLE=true 时 Debugger 经 Ochiai 公式
# 对失败/通过测试的行级命中做 Top-k 可疑行定位先验注入；默认 false）：
# FL_SPECTRAL_ENABLE=false
# O2 Top-k 上限（默认 5）：
# FL_SPECTRAL_TOP_K=5
# O2 单次 subprocess 测量超时（秒，默认 60）：
# FL_SPECTRAL_TIMEOUT=60

# O3 分支覆盖率注入（BRANCH_COVERAGE_INJECT_ENABLE=true 时 Executor 经
# coverage(branch=True) subprocess 测量未覆盖分支清单注入下一轮
# Generator prompt；Docker 执行链路（EXECUTOR_USE_DOCKER=true）时
# 自动跳过（O16 验证范围）；默认 false）：
# BRANCH_COVERAGE_INJECT_ENABLE=false
# O3 单次测量超时（秒，默认 60）：
# BRANCH_COVERAGE_INJECT_TIMEOUT=60

# O8 RAG 记忆投毒过滤（RAG_POISONING_FILTER=true 时入库前对
# test_code/repair 做 10 类注入模式正则检测，命中即跳过 upsert；
# 默认 false 保持历史全量入库口径）：
# RAG_POISONING_FILTER=false

# ═══ M11 安全加固（2026-09-29 审查 P0，S1–S6）══════════════════════════

# S1 内核沙箱 fail-closed（ALLOW_UNSANDBOXED=true 时容忍无隔离降级；
# 默认 false 时平台不支持沙箱直接抛 SandboxUnavailable 拒绝执行）：
# ALLOW_UNSANDBOXED=false

# G3/P0-4 内核级沙箱开关（KERNEL_SANDBOX_ENABLE=true 时本地 + venv 沙箱执行链路
# 把 pytest 子进程包装进内核沙箱（macOS Seatbelt / Linux Landlock+bwrap），
# 提供与 Docker 同向的隔离 + 断网（Landlock 口径）。默认 false 保持历史
# 无隔离本地执行口径（ADR-0003 新能力默认关）。CI 已预装 bubblewrap
# （P0-4，2026-10-04 续四），显式启用只需设 true（一行 env，零代码变更）。
# 平台无沙箱后端且 ALLOW_UNSANDBOXED=false 时 fail-closed 拒绝执行
# （不静默降级到无隔离裸跑，避免"以为隔离了其实没有"污染实验口径）：
# KERNEL_SANDBOX_ENABLE=false

# S3 Docker 容器默认断网（DOCKER_DEFAULT_NETWORK_NONE=true 时容器
# 默认 --network=none；设 false 恢复历史 bridge 口径）：
# DOCKER_DEFAULT_NETWORK_NONE=true

# S3 Docker 资源限制（防 fork 炸弹 / 内存爆炸把宿主打死）：
# DOCKER_CPU_LIMIT=2.0
# DOCKER_MEM_LIMIT_MB=2048
# DOCKER_PIDS_LIMIT=256
# DOCKER_READ_ONLY=true

# P2 注入扫描回归基准（INJECTION_GUARD_ENABLE=true 时 _generator_node 在消费外部可控文本
# （problem_statement / diagnosis / review_reason / task_description）前做输入侧注入
# 特征扫描（4 类：directive_override / data_exfiltration / encoded_bypass /
# context_spoofing），命中时写 state["injection_findings"]（供 agent_telemetry 的
# injection_detected 模式消费 + trace 记录）并追加系统侧警示到 LLM query
# （build_injection_warning 输出，OWASP ASI "检测+隔离"口径：只警示不自动阻断）。
# experiments/injection_benchmark_samples.json + tests/test_p2_injection_benchmark.py
# （47 用例）锁定"召回率 ≥ 0.8 且误伤率 = 0"下限（启发式非形式化，基准作用是
# 防回归而非宣称完备）。默认 false 保持历史口径零变化（不扫描外部文本）：
# INJECTION_GUARD_ENABLE=false

# S4 凭证白名单最小化环境（CREDENTIAL_SCRUB_WHITELIST_ENABLE=true 时
# 子进程 env 仅保留 PATH/HOME/LANG/Python/SSL 等 13 个非敏感变量，
# 其余一律剔除——"默认拒绝"口径；D.4-3 起默认 true，
# 如需回退历史黑名单口径可显式设为 false）：
# CREDENTIAL_SCRUB_WHITELIST_ENABLE=true

# M3 官方 swebench 包验证（SWE_USE_OFFICIAL_HARNESS=true 时 verify()
# 先尝试官方 runner，成功以官方结果为准；未安装/失败降级自建 harness）：
# SWE_USE_OFFICIAL_HARNESS=false

# N 系列新能力钩子（全部默认关，保持历史口径零变化）：

# N1 属性测试钩子（HYPOTHESIS_ENABLE=true 时 Generator prompt 注入
# hypothesis 风格属性断言指令；默认 false 保持纯样本驱动口径）：
# HYPOTHESIS_ENABLE=false

# N2 蜕变关系 oracle（METAMORPHIC_ENABLE=true 时 _generator_node 经
# experiments.metamorphic_oracle.suggest_metamorphic_relations 从函数名/签名
# 启发式匹配 6 类 MR 模板（幂等/交换律/单调性/可逆性/不变量/维度保持），
# 渲染 prompt 段落注入 Generator（P2-7 接线审计，2026-10；默认 false 保持
# 历史口径零变化；无规格场景下以"输入变换后输出满足已知关系"替代精确期望值）：
# METAMORPHIC_ENABLE=false

# N4 差分测试（DIFFERENTIAL_TEST_ENABLE=true 时 _generator_node 经
# experiments.differential_test.build_differential_prompt_section 注入
# "参考实现 vs 被测实现"随机输入交叉比对指令（P2-7 接线审计，2026-10；
# 默认 false 保持历史口径零变化））：
# DIFFERENTIAL_TEST_ENABLE=false

# N5 测试套件断言去重（TEST_SUITE_DEDUP_ENABLE=true 时 _generator_node
# 对 LLM 生成的测试代码做 AST 级重复断言去除；默认 false）：
# TEST_SUITE_DEDUP_ENABLE=false

# S6 pip 包名白名单守卫（PIP_PACKAGE_WHITELIST_ENABLE=true 时
# suggest_package_names 仅返回白名单内包名，未知名默认拒绝；
# 默认 false 保持历史全量安装口径）：
# PIP_PACKAGE_WHITELIST_ENABLE=false
# PIP_PACKAGE_WHITELIST=numpy,pandas,scipy,pytest,requests  # 逗号分隔，覆盖内置清单

# P2-4 覆盖率停滞检测（COVERAGE_STALL_DETECT_ENABLE=true 时
# workflow.determine_stop_reason 的 6.5 分支：最近 COVERAGE_STALL_ROUNDS
# 轮 coverage_delta 全部 |delta| < COVERAGE_STALL_EPS 且测试仍失败 →
# 提前停止 StopReason.COVERAGE_STALL（默认 false 保持 MAX_ITERATIONS
# 自然收敛口径；COVERAGE_STALL_ROUNDS 默认 2 / COVERAGE_STALL_EPS 默认 0.5）：
# COVERAGE_STALL_DETECT_ENABLE=false
# COVERAGE_STALL_ROUNDS=2
# COVERAGE_STALL_EPS=0.5

# P2-2（2026-10 批次·续二）专家池维度按错误类别条件化
# （EXPERT_POOL_CATEGORY_CONDITIONED=true 时 _debugger_node 传 error_category
# 给 ExpertPoolAgent.generate_parallel，命中类别的关联维度排前，
# expert_count 不变；默认 false 保持 3 维固定原序历史口径）：
# EXPERT_POOL_CATEGORY_CONDITIONED=false

# ─── 2026-10-05 审查批次新增开关（R1c/R4b/R15/R16/R17 + API 健康检查，默认值见 config/源码）──
#
# R1c 确定性规约 oracle 执行（SPEC_ORACLE_EXEC_ENABLE=true 时 _generator_node
# 在 LLM 测试生成后，把 spec_ir_v2.compile_spec_oracle 产物（签名感知绑定）
# 追加到 generated_test 尾部并列执行——LLM 测试通过 ≠ 规约 oracle 通过，
# 后者失败即"逻辑驱动"通道的确定性检出；默认 false 保持历史口径零变化）：
# SPEC_ORACLE_EXEC_ENABLE=false

# R4b 补丁回滚 fail-closed 口径（PATCH_ROLLBACK_FAIL_CLOSED=true 时回归
# "无法裁决"口径（rc>=2 收集/语法错误 / 超时 / IO 异常）一律按
# regression_failed 处理并触发自动回滚——"回归无法裁决 = 不能证明补丁
# 安全 = 回滚"；默认 false 保持归 regression_error 且保留补丁的历史口径）：
# PATCH_ROLLBACK_FAIL_CLOSED=false

# R17 结构化"测试生成错误"路由信号（ROUTE_STRUCTURED_ENABLE=true 时
# error_classifier 的 error_category（保守集合，仅 logic_error）优先于中文
# 诊断关键词匹配做路由判定（关键词匹配依赖 LLM 诊断文本，M5 事故证明其
# 脆弱性）；默认 false 保持历史关键词口径逐字节不变）：
# ROUTE_STRUCTURED_ENABLE=false

# R16 流氓行为监控接线（ROGUE_MONITOR_ENABLE=true 时 BaseAgent 的 LLM 调用
# 链上报事件、_executor_node 每轮 check 写 state["rogue_findings"]（z-score /
# 动作熵 / 能力违规三类漂移信号）；默认 false 时上报与 check 均零执行，
# 历史口径零变化）：
# ROGUE_MONITOR_ENABLE=false

# 后台 API 健康检查线程开关（API_HEALTH_CHECKER_ENABLE，默认 true 保持历史
# 行为）：该线程每 60s 对所有节点发起真实 LLM 请求（消耗 API 配额）；
# 免费/低配额场景建议设 false——故障转移不受影响（调用失败时仍即时探测
# 并熔断冷却）：
# API_HEALTH_CHECKER_ENABLE=true

# R15 开关预设档（AITESTER_PROFILE，config.py，默认不设置 = 全部开关维持
# 各自默认值）：
#   safe       —— 安全敏感档：KERNEL_SANDBOX / PATCH_SNAPSHOT_ROLLBACK /
#                  PATCH_ROLLBACK_FAIL_CLOSED / INJECTION_GUARD / ROGUE_MONITOR /
#                  FLAKY_CHECK 全开（生产 / 不可信目标场景建议）；
#   scientific —— 科研评测档：SPEC_IR / SPEC_IR_DSL / SPEC_ORACLE_EXEC /
#                  ENABLE_MUTATION_SCORING / ORACLE_VALIDATE +
#                  PATCH_SNAPSHOT_ROLLBACK 全开；
#   logic      —— 逻辑链全开档（scientific 超集，2026-10-05 系统审查 O1）：
#                  另开 LOGIC_SPEC_STRICT / DETERMINISTIC_GUARD /
#                  BRANCH_COVERAGE_INJECT / ROUTE_STRUCTURED
#                  （"逻辑驱动"主张的完整链路一键可测可观测）；
#   fast       —— 历史默认档（全部维持默认关，与不设 PROFILE 等价）。
# 预设经 os.environ.setdefault 注入——显式设置的开关不被覆盖；未识别的
# profile 值记 WARNING 并忽略：
# AITESTER_PROFILE=

# ─── G4 SMT 见证层（2026-10-05 优化批次·T2，默认关）──────────────────────────
# SPEC_SMT_ENABLE=true 且 z3-solver 可导入（pip install "aitester[formal]"）时，
# SpecIR v2 的 compile_spec_oracle 在主 oracle 之外追加
# test_specir_v2_smt_witness_* 见证测试：对规约前件做 SMT 求解
# （sat 模型 + 数值边界 min/max），见证输入经 Python 语义复核后注入
# （前件断言 + 调用 + 后件断言）。z3 缺失 / 求解超时 / 不可翻译 →
# 保守无见证，产物与 SPEC_SMT_ENABLE=false 逐字节一致：
# SPEC_SMT_ENABLE=false
# 求解器超时毫秒数（SPEC_SMT_TIMEOUT_MS，默认 2000，范围 [100, 30000]）：
# SPEC_SMT_TIMEOUT_MS=2000
# 单规约最多见证数（SPEC_SMT_MAX_WITNESSES，默认 3，范围 [1, 10]）：
# SPEC_SMT_MAX_WITNESSES=3
