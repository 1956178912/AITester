# ═══════════════════════════════════════════════════════════════════════════════
# AITester 环境变量配置模板
# 复制此文件为 .env 并填入真实值：cp .env.example .env
# 注意：.env 文件已加入 .gitignore，不会被提交到版本库
# ═══════════════════════════════════════════════════════════════════════════════

# ─── LLM 配置（必填）──────────────────────────────────────────────────────────
# OpenAI API Key，用于调用 GPT 系列模型
# 获取地址：https://platform.openai.com/api-keys
OPENAI_API_KEY=<OPENAI_API_KEY>

# 若使用 DeepSeek / Qwen 等 OpenAI 兼容接口，取消下面两行注释并填入对应值
# OPENAI_BASE_URL=https://api.deepseek.com
# MODEL_NAME=deepseek-chat

# 当前使用 OpenAI 官方接口
OPENAI_BASE_URL=https://api.openai.com/v1
# gpt-4o-mini：成本较低，适合大规模实验；gpt-4o：效果更佳但成本较高
MODEL_NAME=gpt-4o-mini
# 温度参数：0=完全确定性（推荐测试生成），1=高创造性
# 测试生成场景建议 0.1~0.3，保持输出稳定可复现
TEMPERATURE=0.2

# ─── 数据库配置（可选，未配置则跳过数据库记录）────────────────────────────────
# MySQL 连接参数，用于持久化实验结果（任务记录、测试运行、修复历史）
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=<MYSQL_PASSWORD>
# AITester 使用的数据库名，init_db.py 会自动创建该库及所需表
MYSQL_DATABASE=aitester

# ─── 执行环境 ─────────────────────────────────────────────────────────────────
# 是否使用 Docker 隔离执行测试：
#   false（默认）：本地执行，速度更快，适合开发和调试
#   true：容器隔离，更安全，适合生产环境（需已安装 Docker）
DOCKER_ENABLED=false
DOCKER_IMAGE=python:3.11-slim
# 单次测试执行的最大超时时间（秒），防止被测函数死循环导致进程卡死
EXECUTION_TIMEOUT=30

# ─── 工作流 ───────────────────────────────────────────────────────────────────
# 最大修复迭代次数：达到此次数后无论测试是否通过都停止修复
MAX_ITERATIONS=3
# 覆盖率阈值：代码行覆盖率不低于此百分比时视为合格
COVERAGE_THRESHOLD=80.0

# ─── 消融实验开关（默认值已写入 config.py，可按需覆盖）────────────────────────
# 启用/禁用 Planner（测试规划师）节点
#   true（默认）：完整系统，先逻辑分析再生成测试
#   false：无规划基线，Generator 直接生成测试
ENABLE_PLANNER=true

# 启用/禁用 RAG 检索增强（需安装 chromadb：pip install "aitester[rag]"）
#   false（默认）：不启用，节省依赖
#   true：Generator/Debugger 会检索相似历史案例作为参考
ENABLE_RAG=false

# 启用/禁用 Debugger（调试修复师）节点
#   true（默认）：完整系统，测试失败后自动修复
#   false：无修复基线，失败后直接结束
ENABLE_DEBUGGER=true

# 批量基准测试并行度（0=串行，暂未实现多线程，保留接口供后续扩展）
BENCHMARK_PARALLELISM=0

# 单次 LLM 调用超时时间（秒），防止 LLM 响应过慢导致任务卡死
LLM_TIMEOUT=60

# ─── 实验配置（进阶）──────────────────────────────────────────────────────────
# 数据集开关（用于 run_benchmark.py 的加载器选择）
# DATASET_DEFAULT=examples      # 默认数据集（examples / swe_bench / defects4j_python）
