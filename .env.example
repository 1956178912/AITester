# ═══════════════════════════════════════════════════════════════════════════════
# AITester 环境变量配置模板
# 复制此文件为 .env 并填入真实值：cp .env.example .env
# 注意：.env 文件已加入 .gitignore，不会被提交到版本库
# ═══════════════════════════════════════════════════════════════════════════════

# ─── LLM 配置 ────────────────────────────────────────────────────────────────
# 【重要】LLM 密钥属于敏感信息，现行架构统一放在 .env.local（不放在 .env）：
#   cp config.local.example .env.local   # 然后填入真实的 LLM_N_* 值
#
# LLM_N_* 格式（写在 .env.local，N = 1,2,3... 可任意多组，系统自动轮询）：
#   LLM_1_API_KEY=<your-api-key>
#   LLM_1_BASE_URL=https://api.provider.com/v1
#   LLM_1_MODEL_NAME=model-name
#
# 旧变量 OPENAI_API_KEY / OPENAI_BASE_URL / MODEL_NAME 已不再被系统读取
# （config.py 中仅为从 LLM_CONFIGS 派生的向后兼容值），请勿再依赖它们配置 LLM。
#
# 本文件（.env）只承载非敏感项，LLM 温度等仍在此配置：
# 温度参数：0=完全确定性（推荐测试生成），1=高创造性
# 测试生成场景建议 0.1~0.3，保持输出稳定可复现
TEMPERATURE=0.2

# ─── 数据库配置（可选，未配置则跳过数据库记录）────────────────────────────────
# MySQL 连接参数，用于持久化实验结果（任务记录、测试运行、修复历史）
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=<MYSQL_PASSWORD>
# AITester 使用的数据库名，init_db.py 会自动创建该库及所需表
MYSQL_DATABASE=aitester
# MySQL 连接池参数（PooledDB）：默认值适合单实验串行场景；
# 跑 BENCHMARK_PARALLELISM>0 的并发实验或数据库 QPS 升高时适当调大
MYSQL_POOL_MIN_CACHED=5
MYSQL_POOL_MAX_CACHED=10
MYSQL_POOL_MAX_CONNECTIONS=20
# 从连接池获取连接的等待超时（秒）
MYSQL_POOL_TIMEOUT=30

# ─── 执行环境 ─────────────────────────────────────────────────────────────────
# Docker 隔离执行（预留接口）：
#   当前版本尚未实现容器化执行——测试始终在本地子进程运行（Executor 的
#   use_docker 仅为保留参数，config.py 读取但无消费方），设 true 不会改变行为。
#   待实现后，true 将启用容器隔离（更安全，适合生产），false 为本地快速执行。
# DOCKER_IMAGE 须与锁定依赖兼容：scipy==1.18.0 要求 Python >=3.12，
# 故默认 3.12-slim（与 config.py 默认值及 Dockerfile 保持一致）。
DOCKER_ENABLED=false
DOCKER_IMAGE=python:3.12-slim
# 单次测试执行的最大超时时间（秒），防止被测函数死循环导致进程卡死
EXECUTION_TIMEOUT=30

# 执行隔离（P1 依赖隔离）：本地执行默认跑在系统 Python 环境，
# 被测代码的第三方 import 缺失时会测试失败且无法区分代码 bug 与环境问题。
#   EXECUTOR_USE_VENV=true：为任务建隔离 venv（按依赖组合磁盘缓存），
#     PYTHONPATH 仅指向沙箱目录，不污染系统环境
#   EXECUTOR_AUTO_INSTALL_DEPS=true：执行前自动 pip install 缺失依赖（仅装入 venv）
# 两者默认 false，保持与历史实验一致；SWE-bench 等含第三方依赖的实验建议开启
EXECUTOR_USE_VENV=false
EXECUTOR_AUTO_INSTALL_DEPS=false
# 依赖安装子进程超时（秒），防止 pip 网络卡顿拖垮实验
EXECUTOR_DEP_INSTALL_TIMEOUT=120

# ─── 工作流 ───────────────────────────────────────────────────────────────────
# 最大修复迭代次数：达到此次数后无论测试是否通过都停止修复
MAX_ITERATIONS=3
# 覆盖率阈值：代码行覆盖率不低于此百分比时视为合格
COVERAGE_THRESHOLD=80.0

# ─── 消融实验开关（默认值已写入 config.py，可按需覆盖）────────────────────────
# 启用/禁用 Planner（测试规划师）节点
#   true（默认）：完整系统，先逻辑分析再生成测试
#   false：无规划基线，Generator 直接生成测试
ENABLE_PLANNER=true

# 启用/禁用 RAG 检索增强（需安装 chromadb：pip install "aitester[rag]"）
#   false（默认）：不启用，节省依赖
#   true：Generator/Debugger 会检索相似历史案例作为参考
# 也可在实验入口显式切换：experiments/run_benchmark.py --enable-rag
ENABLE_RAG=false

# RAG 持久化路径（跨实验复用的检索库）：
#   不设置（注释掉本行）= 使用项目根下 rag_data/（config.py 内置默认，推荐）
#   设为具体路径 = 自定义持久化目录；设为空字符串 = 回退内存模式（重启丢数据）
# RAG_PERSIST_PATH=
# RAG ChromaDB 集合名（同一持久化目录下按集合名区分实验）
RAG_COLLECTION_NAME=aitester_cases
# RAG 缓存 TTL（秒）：持久化场景默认 7 天，保证跨实验复用；
# 按需调小可强制检索库定期"保鲜"
RAG_TTL_SECONDS=604800

# 启用/禁用 Debugger（调试修复师）节点
#   true（默认）：完整系统，测试失败后自动修复
#   false：无修复基线，失败后直接结束
ENABLE_DEBUGGER=true

# ─── 多候选补丁（3.1，默认关闭）─────────────────────────────────────────────────
# 启用后 Debugger 一轮生成 N 个候选补丁，静态筛选（语法/函数完整性）+
# 可选执行验证（MULTI_CANDIDATE_EXEC_VALIDATE）后选最优候选应用，
# 显著提升修复成功率（无有效候选时自动回退单补丁，不引入劣化）。
# ENABLE_MULTI_CANDIDATE_PATCH=false
# # 候选数（默认 3，上限 8）
# MULTI_CANDIDATE_COUNT=3
# # 是否启用逐候选执行验证（默认 false 仅静态筛选；true 成本更高但筛选更准）
# MULTI_CANDIDATE_EXEC_VALIDATE=false

# ─── 结构化可观测性（4.1，默认关闭）─────────────────────────────────────────────
# 设置非空路径启用 JSONL 追踪记录（未设置时全 no-op 零性能税）：
# 每任务生成 <task_uuid>.trace.jsonl，记录各智能体节点的输入输出、
# 决策路径（debug/done/regenerate）、token 消耗与墙钟耗时，供实验分析回放。
# AITESTER_TRACE_DIR=

# ─── 成本感知路由（3.4 + 3.2，可选）───────────────────────────────────────────
# APIManager 的 COST_AWARE 策略按"成功率/成本"综合排序，故障转移时避免把
# 全量流量切到昂贵 provider，超过成本阈值（默认 2.0x，经 APIManagerConfig.cost_alert_threshold
# 可配——误报多时上调如 3.0/5.0，成本敏感度高时下调，无需改代码）记 WARNING 告警
# （cost_alert_enabled 可关）。
# 各 provider 的相对成本倍数在 .env.local 中以 LLM_N_COST_WEIGHT 配置
# （对应 LLM_N_* 编号，0.1~1000；未配置默认 0.0=无信息，APIManager 回退 1.0 基准）。
# 启用方式：APIManagerConfig(rotation_strategy=RotationStrategy.COST_AWARE)。

# 批量基准测试并行度（0=串行）：experiments/run_benchmark.py 读取，
# 驱动多线程并行执行（也可用 --parallel 参数覆盖）
BENCHMARK_PARALLELISM=0

# 单次 LLM 调用超时时间（秒），防止 LLM 响应过慢导致任务卡死
LLM_TIMEOUT=60
# LLM 限流重试等待基准（秒）：触发 429 后等待该时长再重试
# （来源：experiments/run_benchmark.py 的限流处理，建议 10-60）
LLM_RETRY_WAIT=30
