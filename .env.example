# ═══════════════════════════════════════════════════════════════════════════════
# AITester 环境变量配置模板
# 复制此文件为 .env 并填入真实值：cp .env.example .env
# 注意：.env 文件已加入 .gitignore，不会被提交到版本库
# ═══════════════════════════════════════════════════════════════════════════════

# ─── LLM 配置 ────────────────────────────────────────────────────────────────
# 【重要】LLM 密钥属于敏感信息，现行架构统一放在 .env.local（不放在 .env）：
#   cp config.local.example .env.local   # 然后填入真实的 LLM_N_* 值
#
# LLM_N_* 格式（写在 .env.local，N = 1,2,3... 可任意多组，系统自动轮询）：
#   LLM_1_API_KEY=<your-api-key>
#   LLM_1_BASE_URL=https://api.provider.com/v1
#   LLM_1_MODEL_NAME=model-name
#
# 旧变量 OPENAI_API_KEY / OPENAI_BASE_URL / MODEL_NAME 已不再被系统读取
# （config.py 中仅为从 LLM_CONFIGS 派生的向后兼容值），请勿再依赖它们配置 LLM。
#
# 本文件（.env）只承载非敏感项，LLM 温度等仍在此配置：
# 温度参数：0=完全确定性（推荐测试生成），1=高创造性
# 测试生成场景建议 0.1~0.3，保持输出稳定可复现
TEMPERATURE=0.2

# ─── 数据库配置（可选，未配置则跳过数据库记录）────────────────────────────────
# MySQL 连接参数，用于持久化实验结果（任务记录、测试运行、修复历史）
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=<MYSQL_PASSWORD>
# AITester 使用的数据库名，init_db.py 会自动创建该库及所需表
MYSQL_DATABASE=aitester
# MySQL 连接池参数（PooledDB）：默认值适合单实验串行场景；
# 跑 BENCHMARK_PARALLELISM>0 的并发实验或数据库 QPS 升高时适当调大
MYSQL_POOL_MIN_CACHED=5
MYSQL_POOL_MAX_CACHED=10
MYSQL_POOL_MAX_CONNECTIONS=20
# 从连接池获取连接的等待超时（秒）
MYSQL_POOL_TIMEOUT=30

# ─── 执行环境 ─────────────────────────────────────────────────────────────────
# Docker 隔离执行：
#   EXECUTOR_USE_DOCKER=true（4.3，需本机安装 docker 且镜像已构建）经 docker CLI
#   在容器内跑 pytest（docker run --rm -v <sandbox>:/workspace -w /workspace
#   <image> python -m pytest ...），依赖预安装缓存在镜像构建期完成（层缓存复用），
#   每任务零安装开销。docker 不可用时任务提前返回 docker_unavailable 诊断，
#   不静默降级本地执行（避免实验口径混淆）。需先构建镜像：
#       docker build -t aitester:latest .
#   默认 false 保持本地快速执行口径。
# DOCKER_IMAGE 须与锁定依赖兼容：scipy==1.18.0 要求 Python >=3.12，
# 故默认 3.12-slim（与 config.py 默认值及 Dockerfile 保持一致）。
# DOCKER_ENABLED=false
# DOCKER_IMAGE=python:3.12-slim
# 单次测试执行的最大超时时间（秒），防止被测函数死循环导致进程卡死
EXECUTION_TIMEOUT=30

# 执行隔离（P1 依赖隔离）：本地执行默认跑在系统 Python 环境，
# 被测代码的第三方 import 缺失时会测试失败且无法区分代码 bug 与环境问题。
#   EXECUTOR_USE_VENV=true：为任务建隔离 venv（按依赖组合磁盘缓存），
#     PYTHONPATH 仅指向沙箱目录，不污染系统环境
#   EXECUTOR_AUTO_INSTALL_DEPS=true：执行前自动 pip install 缺失依赖（仅装入 venv）
# 两者默认 false，保持与历史实验一致；SWE-bench 等含第三方依赖的实验建议开启
EXECUTOR_USE_VENV=false
EXECUTOR_AUTO_INSTALL_DEPS=false
# 依赖安装子进程超时（秒），防止 pip 网络卡顿拖垮实验
EXECUTOR_DEP_INSTALL_TIMEOUT=120
# 4.4 venv 缓存目录覆盖（可选）：默认 ~/.cache/aitester/venvs/
# 容器/CI 隔离场景可指向挂载卷；配合 `python main.py clean-venv-cache`
# 按时间/大小清理（--list-only 只读查看）
# AITESTER_VENV_CACHE_DIR=

# 4.3 Docker 隔离执行（默认关）：经 docker CLI 在容器内跑 pytest，
# 需本机安装 docker 且镜像已构建（docker build -t aitester:latest .）。
# 依赖预安装缓存在镜像构建期完成（层缓存复用），每任务零安装开销；
# docker 不可用时任务提前返回 docker_unavailable 诊断（不静默降级本地）。
# 配置 EXECUTOR_USE_DOCKER=true + 可选 EXECUTOR_DOCKER_IMAGE 启用。
# EXECUTOR_USE_DOCKER=false
# EXECUTOR_DOCKER_IMAGE=aitester:latest

# ─── 工作流 ───────────────────────────────────────────────────────────────────
# 最大修复迭代次数：达到此次数后无论测试是否通过都停止修复
MAX_ITERATIONS=3
# 覆盖率阈值：代码行覆盖率不低于此百分比时视为合格
COVERAGE_THRESHOLD=80.0

# LLM 文件缓存（省 token，默认启用）：跨会话复用相同 prompt 的成功输出
#   设 AITESTER_LLM_CACHE=0 关闭（测试环境默认关闭，避免缓存污染与 flaky）
# AITESTER_LLM_CACHE=1
# 缓存目录：默认 src/cache/，可用 AITESTER_LLM_CACHE_DIR 覆盖（测试指向临时目录）
# AITESTER_LLM_CACHE_DIR=

# ─── 执行环境凭证剔除（4.1 脱敏审计扩展 + 2026-09-26 P0 补强，无开关，始终生效）──
# 三条执行链路（本地 / venv 沙箱 / Docker）统一在子进程前剔除 LLM API 凭证
# 类环境变量（credential_scrub.scrub_os_environ 动态模式，单一实现，防名单
# 漂移）：LLM_N_API_KEY / LLM_N_BASE_URL 全部编号（1-32）+ 通用 SDK 凭证
# （OPENAI_API_KEY / OPENAI_BASE_URL / ANTHROPIC_API_KEY / API_KEY /
# LLM_API_KEY / LLM_CONFIG_API_KEY）+ P0 补强（2026-09-26）：编号变体通配
# OPENAI_(API_KEY|BASE_URL)_\d+（.env 实测存在 OPENAI_API_KEY_2/3 等多端点
# 命名，旧全名锚定漏掉编号变体，凭证原样进被测代码子进程）与 provider 中间
# 变量（ALIYUN_BAILIAN_API_KEY / AGNES_{DOMESTIC|INTERNATIONAL}_API_KEY /
# BIGMODEL_API_KEY / DEEPSEEK_API_KEY，与 config_generator 的
# PROVIDER_TEMPLATES 键联动，覆盖批量脚本推导口径）。
# 设计目标：LLM 生成的测试代码在子进程中执行，子进程不得继承宿主 LLM 凭证
# （既是凭证暴露面，也是生成代码意外外传的执行向量）。非开关项，无需配置。

# ─── 消融实验开关（默认值已写入 config.py，可按需覆盖）────────────────────────
# 启用/禁用 Planner（测试规划师）节点
#   true（默认）：完整系统，先逻辑分析再生成测试
#   false：无规划基线，Generator 直接生成测试
ENABLE_PLANNER=true

# 启用/禁用 RAG 检索增强（需安装 chromadb：pip install "aitester[rag]"）
#   false（默认）：不启用，节省依赖
#   true：Generator/Debugger 会检索相似历史案例作为参考
# 也可在实验入口显式切换：experiments/run_benchmark.py --enable-rag
ENABLE_RAG=false

# RAG 持久化路径（跨实验复用的检索库）：
#   不设置（注释掉本行）= 使用项目根下 rag_data/（config.py 内置默认，推荐）
#   设为具体路径 = 自定义持久化目录；设为空字符串 = 回退内存模式（重启丢数据）
# RAG_PERSIST_PATH=
# RAG ChromaDB 集合名（同一持久化目录下按集合名区分实验）
RAG_COLLECTION_NAME=aitester_cases
# RAG 缓存 TTL（秒）：持久化场景默认 7 天，保证跨实验复用；
# 按需调小可强制检索库定期"保鲜"
RAG_TTL_SECONDS=604800

# SWE-bench 源码补充文件路径（P0，可选）：
#   官方 SWE-bench JSONL 不含被测源码字段，通过该 JSONL 按 instance_id
#   补全 instance_code/test_code（scripts/export_swe_bench_source.py 输出此格式）。
#   默认不设置 = 不补全（instance_code 兜底为 issue 文本）。
# SWE_BENCH_ENRICHMENT=./swe_bench_enrichment.jsonl

# 启用/禁用 Debugger（调试修复师）节点
#   true（默认）：完整系统，测试失败后自动修复
#   false：无修复基线，失败后直接结束
ENABLE_DEBUGGER=true

# ─── 多候选补丁（3.1 + 3.2，默认关闭）──────────────────────────────────────────
# 启用后 Debugger 一轮生成 N 个候选补丁，静态筛选（语法/函数完整性）+
# 可选执行验证（MULTI_CANDIDATE_EXEC_VALIDATE）后选最优候选应用，
# 显著提升修复成功率（无有效候选时自动回退单补丁，不引入劣化）。
# 3.2 改进：静态筛选模式改按"行级信用"排序（BOOSTAPR 式：执行验证通过率
# ×(1-修改行占比)），修改行少且静态通过的候选优先（未验证时退化为
# 简洁性代理）。
# ENABLE_MULTI_CANDIDATE_PATCH=false
# # 候选数（默认 3，上限 8）
# MULTI_CANDIDATE_COUNT=3
# # 是否启用逐候选执行验证（默认 false 仅静态筛选；true 成本更高但筛选更准）
# MULTI_CANDIDATE_EXEC_VALIDATE=false
# # 3.3 轻量奖励预测器（默认 false）：启用后 select_best_candidate 在静态
# # 筛选模式下用历史 execution_trace 的覆盖率趋势调节候选排序（覆盖率连降
# # 偏最小改动、停滞偏更大改动/换根因视角）。纯规则式、无训练、可复算。
# REWARD_PREDICTOR_ENABLE=false
# # P0 3.2 多候选自适应触发策略（默认 adaptive）：
# #   adaptive：仅当 iteration >= 1（首次修复已失败）且 error_category ∈
# #             {assertion, runtime, logic_error, index_error}（困难类别）时
# #             启用多候选；简单任务 / 早期迭代保持单候选，省 token。
# #   always：历史口径，每次失败都启用多候选（每次失败 +79% token 成本）。
# # 设 always 回退历史口径，便于 A/B 对比。
# MULTI_CANDIDATE_TRIGGER_STRATEGY=adaptive

# ─── 对抗性推理（3.1，默认关闭）───────────────────────────────────────────────
# 启用后 Debugger 在生成补丁前注入 2-3 个"击穿当前实现"的对抗性意图
# 假设（AdverIntent-Agent 式），生成针对性测试，生成后独立"批评者"LLM
# 调用尝试构造击穿用例；被击穿则重新生成一次补丁（仍失败保留当前并记录
# 风险）。默认 false 保持历史实验口径（启用会增加 2-4 次 LLM 调用/修复轮）。
# ADVERSARIAL_DEBUGGING_ENABLE=false

# ─── 3.1 双向代码-测试诊断（BiVCoder 式 Review Agent，默认关闭）────────────────
# 启用后 Debugger 在生成补丁前先由独立"审查智能体"判断失败根因是
# "实现缺陷"（修复代码）还是"测试缺陷"（重新生成测试）。判定为测试缺陷
# 时不生成补丁，返回 defect_type="test_defect" 由 workflow 路由回 generator
# 重新生成测试。默认 false 保持历史口径（未启用时 defect_type 恒为
# implementation_defect，即修复代码）。启用会每轮多 1 次 LLM 调用。
# BIDIRECTIONAL_DIAGNOSIS_ENABLE=false

# ─── 3.3 位置感知迭代修复（LoopRepair 式先定位再补丁，默认关闭）──────────────
# 启用后 Debugger 在生成补丁前先做"修复位置定位"：把 error_classifier 已
# 提取的异常位置（traceback 行号 / 语法错误行列）经 AST 定位到所属函数，
# 生成"位置感知修复指引"注入 prompt，让 LLM 优先修定位到的位置而非全文件
# 盲搜（参考 LoopRepair 位置感知迭代修复）。定位纯静态不耗 LLM token；
# 无法定位时自动降级为常规全文件修复（保持历史口径）。默认 false 保持
# 历史实验口径；启用需显式 POSITION_AWARE_REPAIR_ENABLE=true。
# POSITION_AWARE_REPAIR_ENABLE=false

# ─── 结构化可观测性（4.1，默认关闭；P0 4.2 批次起 run_benchmark.py 入口默认启用）───
# 设置非空路径启用 JSONL 追踪记录（未设置时全 no-op 零性能税）：
# 每任务生成 <task_uuid>.trace.jsonl，记录各智能体节点的输入输出、
# 决策路径（debug/done/regenerate）、token 消耗与墙钟耗时，供实验分析回放。
# P0 4.2：run_benchmark.py 入口在 AITESTER_TRACE_DIR 未设时自动设为
# <output_dir>/traces/（默认启用追踪层）；设空串显式关闭。
# AITESTER_TRACE_DIR=

# ─── 3.5 跨文件修复（协调器-提议者架构，默认关闭）─────────────────────────────
# 启用后 workflow 在 executor → debugger 之间插入 cross_file_analyzer 节点，
# 分析被测代码的跨文件 import 依赖关系（AST，单入口视角），路由多文件
# 补丁应用（被调用方先改，调用方后改；任一文件失败整体回滚）。
# 单文件项目自动降级为单文件模式（依赖边为空时 cross_file_plan=None）。
# 默认 false 保持历史单文件口径；启用需显式 CROSS_FILE_ENABLE=true。
# CROSS_FILE_ENABLE=false
# # 跨文件依赖分析的最大模块数（防止 LLM 上下文爆炸，默认 5）
# CROSS_FILE_MAX_MODULES=5
# # 2.2 改进：双向依赖图开关（默认 false 保持单入口视角）。启用时额外
# # 收集"其他模块→entry"反向依赖边（被调用方视角），使修复计划能同步
# # 更新调用方模块。需配合 CROSS_FILE_ENABLE=true 生效，独立开关保证
# # "跨文件启用 ≠ 双向启用"两级保守。
# CROSS_FILE_BIDIRECTIONAL=false

# ─── API 熔断器指数退避 + Prometheus 导出（4.4，旁路开关；0.6 经 config.py
# 集中声明 API_CIRCUIT_BACKOFF / API_PROMETHEUS_EXPORT 后由 api_health /
# api_manager 读取——此前文档承诺的开关全仓无代码读取点，用户设 false 不
# 会发生任何事；0.6 轮次幽灵开关实装后下方语义生效）────────────────────────────
# 熔断器冷却期改按 base*2^open_count 指数退避（彻底死掉的 provider
# 冷却期单调增长，避免反复短冷却打同一死点；封顶 half_open_probe_
# penalty_cap_seconds）。默认 true 启用；设 false 回退 4.2 固定冷却期
# 口径（便于对比实验）。
# API_CIRCUIT_BACKOFF=true
# Prometheus 指标导出开关（默认 false）。启用后 APIManager.to_prometheus_
# text() 输出 7 类指标（health / circuit_state / open_remaining_s /
# open_count / probe_success_rate / success_rate / avg_response_ms）供
# Prometheus 抓取；false（默认）时返回空串。纯旁路，不影响既有路由行为。
# API_PROMETHEUS_EXPORT=false

# ─── 3.4 断言增强策略（AST 提取现有 assert 注入 prompt，默认关闭）─────────────
# 启用后 GeneratorAgent 在生成前先 AST 提取被测代码中已有 assert 语句
# （去重，最多 10 条），作为"锚点断言"注入 prompt，引导 LLM 避免
# 断言弱化 / 恒真断言 / 魔数未命名等异味。默认 false 保持历史生成口径。
# ASSERTION_AUGMENT_ENABLE=false

# ─── 2.3 复现测试专项生成（TDFlow 式，默认关闭）────────────────────────────────
# 启用后 GeneratorAgent 在已有缺陷描述（diagnosis / review_reason）时，
# 额外生成一个"先失败后通过"的复现测试（覆盖缺陷触发路径，跨文件修复
# 场景下覆盖跨模块调用链），写入 state["repro_test"]。默认 false 保持
# 历史生成口径。启用会额外增加 1 次 LLM 调用/任务。
# REPRO_TEST_ENABLE=false

# ─── 成本感知路由（3.4 + 3.2，可选）───────────────────────────────────────────
# APIManager 的 COST_AWARE 策略按"成功率/成本"综合排序，故障转移时避免把
# 全量流量切到昂贵 provider，超过成本阈值（默认 2.0x，经 APIManagerConfig.cost_alert_threshold
# 可配——误报多时上调如 3.0/5.0，成本敏感度高时下调，无需改代码）记 WARNING 告警
# （cost_alert_enabled 可关）。
# 各 provider 的相对成本倍数在 .env.local 中以 LLM_N_COST_WEIGHT 配置
# （对应 LLM_N_* 编号，0.1~1000；未配置默认 0.0=无信息，APIManager 回退 1.0 基准）。
# 启用方式：APIManagerConfig(rotation_strategy=RotationStrategy.COST_AWARE)。

# ─── P0 改进批次（2026-09-25 续）：13 项落地的配套开关 ─────────────────────────
# 以下为 P0 批次的可配置项，默认值保持历史实验口径（显式开启才启用新能力）。

# ── P0 1.1 分层代码压缩（函数级切片 + 调用链深度）──────────────────────────
# 代码截取的最大字符预算（默认 3000，约 100 行）；超长时按 AST 聚焦截取
# （目标函数 + 调用链依赖），仍超预算才走字符级截断兜底。
# CODE_MAX_CHARS=3000
# 调用链展开深度（P0 1.1 分层代码压缩核心）：
#   1 = 焦点函数直接调用的同文件函数（历史行为，默认）
#   2 = 再展开一层被调函数的依赖（跨文件场景的"目标函数 → 被调用函数 → 相关类"）
# 经 BaseAgent.truncate_code(focus_depth) 与 extract_function_context(depth) 消费。
# CODE_FOCUS_DEPTH=1

# ── P0 1.2 复杂度感知路由（固定 Agnes 3.0-flash 多 provider 端点）───────────
# 路由策略：
#   complexity_aware（默认）：按任务复杂度（行数/文件数/依赖数/圈复杂度归一
#     化评分 → simple/medium/complex 三档）路由到对应 cost_weight 的 LLM 端点
#     （complex → 高 cost_weight 端点在前，simple → 低成本端点在前）
#   fixed：历史口径，固定按 COST_AWARE 综合评分排序（不按复杂度分档）
# MODEL_ROUTING_STRATEGY=complexity_aware
# 复杂度评分归一化基准（各维度满分基准值，超过视为该维度满分）：
#   行数 500 / 文件数 5 / 依赖数 20 / 圈复杂度 25（均可调）
# ROUTING_COMPLEXITY_LINES_NORM=500
# ROUTING_COMPLEXITY_FILES_NORM=5
# ROUTING_COMPLEXITY_DEPS_NORM=20
# ROUTING_COMPLEXITY_CC_NORM=25

# ── P0 1.3 补丁命名契约验证（默认开启）───────────────────────────────────────
# 补丁应用前对比前后模块级符号（函数/类/__all__/注册装饰器/模块级常量），
# 缺失任何原符号则拒绝应用。防止 LLM 改写破坏 sqlfluff 等插件的命名契约。
# 设 false 回退历史口径（不做符号对比，仅做长度/路径安全检查）。
# PATCH_CONTRACT_CHECK=true

# ── P0 4.3 venv 按仓库复用（需配合 REPO_LEVEL_EXECUTION + SWE_REPO_VENV_ISOLATION）
# 同一仓库的多个 commit 共享一个仓库级 venv（<repo>/_shared_venv/），
# 仅当依赖指纹（requirements/pyproject/setup.py 的 SHA256）变更时重建；
# 源码切换不触发重装（editable install 的 .pth 自动跟随 checkout）。
# SWE-bench 同一 repo 多 commit 场景下大幅减少 venv 重建开销（10-20 倍）。
# 默认 false 保持 per-commit 独立 venv 口径（与既有缓存兼容）。
# SWE_REPO_VENV_REUSE_BY_REPO=false

# ── P0 2.1 合成数据集分层难度（仅对 synthetic 数据集生效）──────────────────
# 经 experiments/run_benchmark.py --difficulty 参数消费（混合难度默认）：
#   mixed（默认）/ level1（单函数）/ level2（多函数交互）/
#   level3（跨文件双模块）/ level4（边界+异常隐蔽缺陷）
# 无独立环境变量，CLI 参数即可；脚本内直接构造 SyntheticDataset 时传 difficulty。

# 批量基准测试并行度（0=串行）：experiments/run_benchmark.py 读取，
# 驱动多线程并行执行（也可用 --parallel 参数覆盖）
BENCHMARK_PARALLELISM=0

# 单次 LLM 调用超时时间（秒），防止 LLM 响应过慢导致任务卡死
LLM_TIMEOUT=60
# LLM 限流重试等待基准（秒）：触发 429 后等待该时长再重试
# （来源：experiments/run_benchmark.py 的限流处理，建议 10-60）
LLM_RETRY_WAIT=30
